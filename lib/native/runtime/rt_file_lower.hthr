// `rt`'s computations over a written span, lowered to FunctionIR
// (docs/native/native-one-compiler-design.md §2.6, U4 step 4c): `FTm::lower`, and
// the theorem that the code it builds **runs** to the computation's
// meaning, the file threaded (`StructuredRegion::run`): the value at the
// result port, and the file the meaning's span over the rest.
//
// - A pure term (`Pure`, `Let`'s bound term) is `Tm::lower`'s region, which
//   stores nothing: it runs as it evaluates over the file as it is then
//   (`StructuredRegion::run_quiet_among`), and `Tm::lower_sound` at that
//   file's world is what it leaves. The lowering checks the two facts the
//   bridge reads, that the region stores nothing and calls only the
//   program's pure functions, by evaluation (`FTm::value_checked`); they
//   hold of every region `Tm::lower` builds, and a theorem saying so would
//   retire the check.
// - `Put` is the test of the index against the length word, and under it
//   one `BufferStore` of buffer 0, a leaf of its own as the function
//   compiler reads one; the byte is widened to the word a store sends.
// - `Call` is FunctionIR's `Call` of the computation's function, which
//   sits above the program's pure functions: computation `f` is function
//   `base + f`.
// - `Lend` is FunctionIR's `Lend` of that function over views of the
//   file: the first view written and of the written span, the ones after
//   it read.
//
// What the calls are answered with is one hypothesis (`FTm::CallsAgree`):
// the pure functions answer with their meanings over each file and leave
// it, and each computation answers with its meaning's value and leaves its
// meaning's span.
import logic;
import bool;
import nat;
import list;
import option;
import pair;
import bitvec;
import bitvec_ring;
import bitvec_signed;
import nat_map;
import list_window;
import rt;
import rt_lower;
import rt_file;
import function_ir;
import function_ir_eval;
import function_ir_state;
import function_ir_writes;
import function_ir_run;

// ---------------------------------------------------------------------------
// What the calls are answered with

// The program's pure functions: those below `base`.
fn FTm::pure(base: Nat) → Nat → Bool { λ f => (f + 1).leb(base) }

// What a computation's code answers when its meaning ends in `m`: the
// value as a word, and the file with the span the meaning left.
fn FTm::ended(tys: Nat → RecInfo, r: Ty, rest: List<List<BitVec(8)>>, m: Mutated<List<BitVec(8)>, r.sem(tys)>) → Ending {
    Ending(Ty::cast(tys, r, Word(64), m.value), Cons(m.after, rest))
}

// A function on words that may write answers like a curried computation:
// on every word list, what the meaning applied to the words ends in.
fn FTm::Answers(tys: Nat → RecInfo, ps: List<Ty>, r: Ty, rest: List<List<BitVec(8)>>)
    → Ty::ArrowsTo(tys, ps, Mutated<List<BitVec(8)>, r.sem(tys)>) → (List<BitVec(64)> → Ending) → Type {
    match ps {
        Nil => λ m ans => ans(Nil) = FTm::ended(tys, r, rest, m),
        Cons(p, more) => λ v ans => (x: BitVec(64)) →
            FTm::Answers(tys, more, r, rest, v(Ty::cast(tys, Word(64), p, x)), λ ws => ans(Cons(x, ws))),
    }
}

// `call` answers the program: over every file `Cons(own, rest)`, the pure
// functions with their meanings there, leaving it, and each computation of
// a word signature with its meaning from `own`, at every rest of a file
// (a computation called over windows runs on a file of the windows).
fn FTm::CallsAgree(fw: FWorld, base: Nat, call: Writers()) → Type {
    ((own: List<BitVec(8)>) → Tm::CallsAgree(fw.at(own), Writers::words(call, Cons(own, fw.rest)))) ∧
    (((f: Nat) → FTm::pure(base, f).IsTrue() → (own: List<BitVec(8)>) → (words: List<BitVec(64)>) →
        call(Cons(own, fw.rest), f, words).buffers = Cons(own, fw.rest)) ∧
    ((f: Nat) → Sig::at(fw.fsigs, f).Words(fw.w.tys) → (rest: List<List<BitVec(8)>>) → (own: List<BitVec(8)>) →
        FTm::Answers(fw.w.tys, Sig::at(fw.fsigs, f).params, Sig::at(fw.fsigs, f).result, rest,
            FTm::get(fw.w.tys, fw.fsigs, fw.writers(rest), f, own), λ ws => call(Cons(own, rest), base + f, ws))))
}

// A program with no functions has nothing to answer.
theorem FTm::calls_agree_none(tys: Nat → RecInfo, rest: List<List<BitVec(8)>>, call: Writers()): FTm::CallsAgree(FWorld::alone(tys, rest), 0, call) {
    ⟨λ own => Tm::calls_agree_none_over(tys, Cons(own, rest), Writers::words(call, Cons(own, rest))),
        ⟨λ f among => false_elim(among), λ f ok => false_elim(ok.right)⟩⟩
}

// ---------------------------------------------------------------------------
// What a run leaves

// A run from `before` ended in `end`: every id below `next` kept, the
// value at `result`, the file the span `m` left over the rest.
fn FTm::Ran(t: Ty, tys: Nat → RecInfo, before: Valuation(), end: State, next, result: Nat, rest: List<List<BitVec(8)>>,
    m: Mutated<List<BitVec(8)>, t.sem(tys)>) → Type {
    Keeps(before, end.values, next) ∧ (t.Holds(tys, end.values, result, m.value) ∧ (end.buffers = Cons(m.after, rest)))
}

// A region that ran to `mid`, then one that ran on from there.
theorem FTm::ran_after(t: Ty, tys: Nat → RecInfo, pre, post: StructuredRegion, call: Writers(), values: Valuation(), file: Buffers(), mid: State,
    next, mid_next, result: Nat, rest: List<List<BitVec(8)>>, m: Mutated<List<BitVec(8)>, t.sem(tys)>,
    at: pre.run(call, values, file) = mid, kept: Keeps(values, mid.values, next), le: next <= mid_next,
    then: FTm::Ran(t, tys, mid.values, post.run(call, mid.values, mid.buffers), mid_next, result, rest, m)):
    FTm::Ran(t, tys, values, Compose(pre, post).run(call, values, file), next, result, rest, m) {
    j(sym(at), λ s _ => FTm::Ran(t, tys, values, post.run(call, s.values, s.buffers), next, result, rest, m),
        ⟨λ wd id lt => trans(then.left(wd, id, Nat::lt_of_lt_of_le(id, next, mid_next, lt, le)), kept(wd, id, lt)), then.right⟩)
}

// The same value read at an equal code.
theorem FTm::ran_cast(tys: Nat → RecInfo, a, b: Ty, e: a = b, before: Valuation(), end: State, next, result: Nat, rest: List<List<BitVec(8)>>,
    m: Mutated<List<BitVec(8)>, a.sem(tys)>, ran: FTm::Ran(a, tys, before, end, next, result, rest, m)):
    FTm::Ran(b, tys, before, end, next, result, rest, FTm::recast(tys, a, b, m)) {
    ⟨ran.left, ⟨Ty::cast_holds(tys, end.values, result, a, b, e, m.value, ran.right.left), ran.right.right⟩⟩
}

// ---------------------------------------------------------------------------
// A pure term beside functions that write

// A call's answer that left the file is its word and the file.
theorem Ending::still(self e: Ending, file: Buffers(), left: e.buffers = file): e = Ending(e.word, file) {
    match e { Ending(word, buffers) => λ (same: buffers = file) => cong_fn<Buffers(), Ending>(λ held => Ending(word, held), same) }(left)
}

fn FTm::value_checked(base: Nat, l: Lowered) → Option<Lowered> {
    Tm::check_true(l.region.quiet() && l.region.calls_among(FTm::pure(base))).and_then(λ _ => Some(l))
}

// A pure term's region, checked to store nothing and to call only pure
// functions.
fn FTm::lower_value(v: Tm, w: World, base: Nat, g: List<Ty>, ports: List<Nat>, next: Nat) → Option<Lowered> {
    Tm::lower(v, w, g, ports, next).and_then(λ l => FTm::value_checked(base, l))
}

// What it promises: run over the file `Cons(own, rest)`, it leaves the
// file, keeps every id below `next`, and holds the term's value there.
fn FTm::ValueHolds(v: Tm, fw: FWorld, base: Nat, g: List<Ty>, ports: List<Nat>, next: Nat, r: Option<Lowered>) → Type {
    match r {
        None => True,
        Some(c) => (call: Writers()) → FTm::CallsAgree(fw, base, call) → (values: Valuation()) → (env: Env(fw.w.tys, g)) →
            (own: List<BitVec(8)>) → EnvHolds(fw.w.tys, values, g, ports, env) → Below(fw.w.tys, g, ports, next) →
            (next <= c.next) ∧ (v.ty(fw.w, g).Below(fw.w.tys, c.result, c.next) ∧
                FTm::Ran(v.ty(fw.w, g), fw.w.tys, values, c.region.run(call, values, Cons(own, fw.rest)), next, c.result, fw.rest,
                    Mutated(own, FTm::value(fw, own, v, g, env)))),
    }
}

theorem FTm::value_sound(v: Tm, fw: FWorld, base: Nat, g: List<Ty>, ports: List<Nat>, next: Nat):
    FTm::ValueHolds(v, fw, base, g, ports, next, FTm::lower_value(v, fw.w, base, g, ports, next)) {
    let P = λ (r: Option<Lowered>) => FTm::ValueHolds(v, fw, base, g, ports, next, r);
    Option::and_then_elim(P, trivial, Tm::lower(v, fw.w, g, ports, next), λ l => FTm::value_checked(base, l), λ c lowered =>
    Option::and_then_elim(P, trivial, Tm::check_true(c.region.quiet() && c.region.calls_among(FTm::pure(base))), λ _ => Some(c), λ ok _ =>
        λ call agree values env own held below => {
            let file: Buffers() = Cons(own, fw.rest);
            let words = Writers::words(call, file);
            let parts = Bool::is_true_and(c.region.quiet(), c.region.calls_among(FTm::pure(base)), ok);
            let at_own: (Tm::lower(v, fw.at(own), g, ports, next) = Some(c)) =
                trans(Tm::lower_static(v, fw.w, fw.callees(file), file, g, ports, next), lowered);
            let sound = j(at_own, λ r _ => Tm::LowerHolds(v, fw.at(own), g, ports, next, r),
                Tm::lower_sound(v, fw.at(own), g, ports, next))(words, agree.left(own), values, env, held, below);
            let same_ty: (v.ty(fw.at(own), g) = v.ty(fw.w, g)) = Tm::ty_static(v, fw.w, fw.callees(file), file, g);
            let ran: (c.region.run(call, values, file) = State(c.region.eval_over(file, words, values), file)) =
                c.region.run_quiet_among(call, words, file, FTm::pure(base),
                    λ f among ws => call(file, f, ws).still(file, agree.right.left(f, among, own, ws)), parts.left, parts.right, values);
            ⟨sound.left, ⟨Ty::below_cast(fw.w.tys, v.ty(fw.at(own), g), v.ty(fw.w, g), same_ty, c.result, c.next, sound.right.left),
                j(sym(ran), λ s _ => FTm::Ran(v.ty(fw.w, g), fw.w.tys, values, s, next, c.result, fw.rest, Mutated(own, FTm::value(fw, own, v, g, env))),
                    ⟨sound.right.right.left, ⟨Ty::cast_holds(fw.w.tys, c.region.eval_over(file, words, values), c.result, v.ty(fw.at(own), g),
                        v.ty(fw.w, g), same_ty, v.sem(fw.at(own), g, env), sound.right.right.right), refl⟩⟩)⟩⟩
        }))
}

// ---------------------------------------------------------------------------
// Steps: a region that leaves a value and a span

// What a lowered step promises, whatever it is a step of: over any file
// `Cons(own, rest)`, from any valuation where the environment holds and
// the ports are below `next`, with calls answered by the program, the
// region's run moves `next` up, writes only at or above it, leaves the
// value of `m` at its result and the span of `m` in the file.
fn FTm::StepHolds(fw: FWorld, base: Nat, g: List<Ty>, ports: List<Nat>, next: Nat, t: Ty,
    m: Env(fw.w.tys, g) → List<BitVec(8)> → Mutated<List<BitVec(8)>, t.sem(fw.w.tys)>, r: Option<Lowered>) → Type {
    match r {
        None => True,
        Some(c) => (call: Writers()) → FTm::CallsAgree(fw, base, call) → (values: Valuation()) → (env: Env(fw.w.tys, g)) →
            (own: List<BitVec(8)>) → EnvHolds(fw.w.tys, values, g, ports, env) → Below(fw.w.tys, g, ports, next) →
            (next <= c.next) ∧ (t.Below(fw.w.tys, c.result, c.next) ∧
                FTm::Ran(t, fw.w.tys, values, c.region.run(call, values, Cons(own, fw.rest)), next, c.result, fw.rest, m(env, own))),
    }
}

// A state whose file is known is its values and that file.
theorem State::left(self s: State, file: Buffers(), left: s.buffers = file): s = State(s.values, file) {
    match s { State(values, buffers) => λ (same: buffers = file) => cong_fn<Buffers(), State>(λ held => State(values, held), same) }(left)
}

// A step whose value the next step binds: the second runs from the span
// the first left.
theorem FTm::bind_sound(fw: FWorld, base: Nat, g: List<Ty>, ports: List<Nat>, next: Nat, a: Ty,
    ma: Env(fw.w.tys, g) → List<BitVec(8)> → Mutated<List<BitVec(8)>, a.sem(fw.w.tys)>, b: Ty,
    mb: Env(fw.w.tys, Cons(a, g)) → List<BitVec(8)> → Mutated<List<BitVec(8)>, b.sem(fw.w.tys)>, lc, lb: Lowered,
    first: FTm::StepHolds(fw, base, g, ports, next, a, ma, Some(lc)),
    then: FTm::StepHolds(fw, base, Cons(a, g), Cons(lc.result, ports), lc.next, b, mb, Some(lb))):
    FTm::StepHolds(fw, base, g, ports, next, b, λ env own => mb(Pair(ma(env, own).value, env), ma(env, own).after), Tm::compose(lc, lb)) {
    λ call agree values env own held below => {
        let file: Buffers() = Cons(own, fw.rest);
        let one = first(call, agree, values, env, own, held, below);
        let mid = lc.region.run(call, values, file);
        let m = ma(env, own);
        let two = then(call, agree, mid.values, Pair(m.value, env), m.after,
            ⟨one.right.right.right.left, env_holds_keeps(fw.w.tys, g, values, mid.values, next, one.right.right.left, ports, env, below, held)⟩,
            ⟨one.right.left, below_mono(fw.w.tys, g, next, lc.next, one.left, ports, below)⟩);
        ⟨Nat::le_trans(next, lc.next, lb.next, one.left, two.left), ⟨two.right.left,
            FTm::ran_after(b, fw.w.tys, lc.region, lb.region, call, values, file, State(mid.values, Cons(m.after, fw.rest)), next, lc.next, lb.result,
                fw.rest, mb(Pair(m.value, env), m.after), mid.left(Cons(m.after, fw.rest), one.right.right.right.right), one.right.right.left,
                one.left, two.right.right)⟩⟩
    }
}

// `FTm::bind_sound` with the binding read through `FTm::rest_of`.
theorem FTm::bind_sound_of(fw: FWorld, base: Nat, g: List<Ty>, ports: List<Nat>, next: Nat, a: Ty,
    ma: Env(fw.w.tys, g) → List<BitVec(8)> → Mutated<List<BitVec(8)>, a.sem(fw.w.tys)>, b: Ty,
    mb: Env(fw.w.tys, Cons(a, g)) → List<BitVec(8)> → Mutated<List<BitVec(8)>, b.sem(fw.w.tys)>, lc, lb: Lowered,
    first: FTm::StepHolds(fw, base, g, ports, next, a, ma, Some(lc)),
    then: FTm::StepHolds(fw, base, Cons(a, g), Cons(lc.result, ports), lc.next, b, mb, Some(lb))):
    FTm::StepHolds(fw, base, g, ports, next, b, λ env own => FTm::rest_of(fw, g, a, b, mb, ma(env, own), env), Tm::compose(lc, lb)) {
    FTm::bind_sound(fw, base, g, ports, next, a, ma, b, mb, lc, lb, first, then)
}

// ---------------------------------------------------------------------------
// The branch

theorem Ty::field_moves_quiet(fs: List<Ty>): (out, src: Nat) → nodes_quiet(Ty::field_moves(fs, out, src)).IsTrue() {
    match fs { Nil => λ out src => trivial, Cons(_, rest) => λ out src => Ty::field_moves_quiet(rest, out + 1, src + 1) }
}

// Moves store nothing.
theorem Ty::moves_quiet(self t: Ty, tys: Nat → RecInfo, out, src: Nat): nodes_quiet(t.moves(tys, out, src)).IsTrue() {
    match t {
        Word(_) => trivial,
        Bit => trivial,
        ByteList(_) => trivial,
        Lines => trivial,
        Named(i) => Ty::field_moves_quiet(tys(i).fields, out, src),
        Count => trivial,
        Enum(i) => Ty::field_moves_quiet(Cons(Word(64), tys(i).alts.slots), out, src),
    }
}

// An arm, then its value moved to fresh ports from `out`: the same run, the
// value there.
theorem FTm::moved_ran(t: Ty, tys: Nat → RecInfo, region: StructuredRegion, call: Writers(), values: Valuation(), file: Buffers(),
    next, src, out: Nat, rest: List<List<BitVec(8)>>, m: Mutated<List<BitVec(8)>, t.sem(tys)>, below: t.Below(tys, src, out), le: next <= out,
    ran: FTm::Ran(t, tys, values, region.run(call, values, file), next, src, rest, m)):
    (out <= t.past(tys, out)) ∧ (t.Below(tys, out, t.past(tys, out)) ∧
        FTm::Ran(t, tys, values, Compose(region, nodes_region(t.moves(tys, out, src))).run(call, values, file), next, out, rest, m)) {
    let end = region.run(call, values, file);
    let moved = t.moves_sound(tys, end.buffers, end.values, out, src, below, m.value, ran.right.left);
    let quiet = run_nodes_quiet(t.moves(tys, out, src), t.moves_quiet(tys, out, src), end.values, end.buffers);
    ⟨moved.right.right.right, ⟨moved.right.right.left,
        j(sym(quiet), λ s _ => FTm::Ran(t, tys, values, s, next, out, rest, m),
            ⟨λ wd id lt => trans(moved.right.left(wd, id, Nat::lt_of_lt_of_le(id, next, out, lt, le)), ran.left(wd, id, lt)),
                ⟨moved.left, ran.right.right⟩⟩)⟩⟩
}

// A branch on a bit ran as the arm the bit chooses.
theorem FTm::branch_ran(t: Ty, tys: Nat → RecInfo, values: Valuation(), condition: Nat, outputs: Ports, when_true, when_false: StructuredRegion,
    call: Writers(), file: Buffers(), next, out: Nat, rest: List<List<BitVec(8)>>, b: Bool, yes, no: Mutated<List<BitVec(8)>, t.sem(tys)>,
    h: values(1, condition).head_bit() = b, ran_true: FTm::Ran(t, tys, values, when_true.run(call, values, file), next, out, rest, yes),
    ran_false: FTm::Ran(t, tys, values, when_false.run(call, values, file), next, out, rest, no)):
    FTm::Ran(t, tys, values, branch(condition, outputs, when_true, when_false).run(call, values, file), next, out, rest,
        match b { False => no, True => yes }) {
    let on = when_true.run(call, values, file);
    let off = when_false.run(call, values, file);
    let chosen = λ (x: Bool) => State(λ w id => match x { False => off.values(w, id), True => on.values(w, id) },
        match x { False => off.buffers, True => on.buffers });
    j(sym(h), λ x _ => FTm::Ran(t, tys, values, chosen(x), next, out, rest, match b { False => no, True => yes }),
        match b as λ x => FTm::Ran(t, tys, values, chosen(x), next, out, rest, match x { False => no, True => yes }) {
            False => ran_false,
            True => ran_true,
        })
}

// The `If` case, from what each arm's lowering promises.
theorem FTm::if_sound(fw: FWorld, base: Nat, g: List<Ty>, ports: List<Nat>, next, c: Nat, ty_yes, ty_no: Ty,
    my: Env(fw.w.tys, g) → List<BitVec(8)> → Mutated<List<BitVec(8)>, ty_yes.sem(fw.w.tys)>,
    mn: Env(fw.w.tys, g) → List<BitVec(8)> → Mutated<List<BitVec(8)>, ty_no.sem(fw.w.tys)>, ly, ln: Lowered,
    first: FTm::StepHolds(fw, base, g, ports, next, ty_yes, my, Some(ly)),
    second: FTm::StepHolds(fw, base, g, ports, ly.next, ty_no, mn, Some(ln))):
    FTm::StepHolds(fw, base, g, ports, next, ty_yes, λ env own => match Ty::cast(fw.w.tys, Ty::at(g, c), Bit, Env::get(fw.w.tys, g, env, c)) {
            False => FTm::recast(fw.w.tys, ty_no, ty_yes, mn(env, own)),
            True => my(env, own),
        }, Tm::lower_branch(fw.w.tys, g, ports, c, ty_yes, ty_no, ly, ln)) {
    let tys = fw.w.tys;
    let P = λ (r: Option<Lowered>) => FTm::StepHolds(fw, base, g, ports, next, ty_yes,
        λ env own => match Ty::cast(tys, Ty::at(g, c), Bit, Env::get(tys, g, env, c)) {
            False => FTm::recast(tys, ty_no, ty_yes, mn(env, own)),
            True => my(env, own),
        }, r);
    Option::and_then_elim(P, trivial, port_at(ports, c), λ pc => Tm::branch_checked(tys, g, c, ty_yes, ty_no, pc, ly, ln), λ pc at_c =>
    Option::and_then_elim(P, trivial, Ty::at(g, c).check(Bit), λ _ => Tm::branch_typed(tys, ty_yes, ty_no, pc, ly, ln), λ ec _ =>
    Option::and_then_elim(P, trivial, ty_no.check(ty_yes), λ _ => Some(Tm::branch_lowered(tys, ty_yes, pc, ly, ln)), λ en _ =>
        λ call agree values env own held below => {
            let file: Buffers() = Cons(own, fw.rest);
            let out = ln.next;
            let one = first(call, agree, values, env, own, held, below);
            let two = second(call, agree, values, env, own, held, below_mono(tys, g, next, ly.next, one.left, ports, below));
            let reaches: (next <= out) = Nat::le_trans(next, ly.next, out, one.left, two.left);
            let scrutinee = Ty::cast(tys, Ty::at(g, c), Bit, Env::get(tys, g, env, c));
            let bit = Tm::operand(fw.w, g, ports, values, env, held, c, pc, at_c, Bit, ec);
            let chosen = trans(cong_fn(λ (x: BitVec(1)) => x.head_bit(), bit), BitVec::head_bit_ofBool(scrutinee));
            let no_cast = FTm::recast(tys, ty_no, ty_yes, mn(env, own));
            let moved_yes = FTm::moved_ran(ty_yes, tys, ly.region, call, values, file, next, ly.result, out, fw.rest, my(env, own),
                ty_yes.below_mono(tys, ly.result, ly.next, out, two.left, one.right.left), reaches, one.right.right);
            let cast_no = FTm::ran_cast(tys, ty_no, ty_yes, en, values, ln.region.run(call, values, file), ly.next, ln.result, fw.rest, mn(env, own),
                two.right.right);
            let moved_no = FTm::moved_ran(ty_yes, tys, ln.region, call, values, file, next, ln.result, out, fw.rest, no_cast,
                Ty::below_cast(tys, ty_no, ty_yes, en, ln.result, out, two.right.left), reaches,
                ⟨λ wd id lt => cast_no.left(wd, id, Nat::lt_of_lt_of_le(id, next, ly.next, lt, one.left)), cast_no.right⟩);
            let when_true = Compose(ly.region, nodes_region(ty_yes.moves(tys, out, ly.result)));
            let when_false = Compose(ln.region, nodes_region(ty_yes.moves(tys, out, ln.result)));
            ⟨Nat::le_trans(next, out, ty_yes.past(tys, out), reaches, moved_yes.left), ⟨moved_yes.right.left,
                FTm::branch_ran(ty_yes, tys, values, pc, moved_ports(ty_yes.moves(tys, out, ly.result)), when_true, when_false, call, file, next, out,
                    fw.rest, scrutinee, my(env, own), no_cast, chosen, moved_yes.right.right, moved_no.right.right)⟩⟩
        })))
}

// ---------------------------------------------------------------------------
// The store

// The test of the index against the length word, and in the arm it guards
// the byte widened to a word and stored: the store a leaf of its own, as
// the function compiler reads one (`leaf_store`), which accepts it where
// the path knows the index below the buffer's length home. That `pl` is
// span 0's length home is that compiler's to check, as it is for a load
// (`Tm::byte_lowered`).
fn FTm::put_region(pi, pl, pv, next: Nat) → StructuredRegion {
    Compose(nodes_region([UnsignedLessThan(64, next, pi, pl)]),
        branch(next, no_ports(),
            Compose(nodes_region([Resize(8, 64, next + 1, pv)]), nodes_region([BufferStore(next + 2, 0, pi, next + 1)])),
            nodes_region(Nil)))
}

// A byte widened to a word is that word's low byte.
theorem FTm::low_byte_back(v: BitVec(8)): low_byte(BitVec::ofNat(v.toNat())) = v {
    trans(cong_fn(low_byte, BitVec::ofNat_toNat_zero_extend(8, 56, v)), BitVec::truncate_zero_extend(8, 56, v))
}

// The store's run: every id below `next` kept, and span 0 the write under
// the length word.
theorem FTm::put_runs(call: Writers(), values: Valuation(), own: List<BitVec(8)>, rest: List<List<BitVec(8)>>, pi, pl, pv, next: Nat,
    index, bound: BitVec(64), byte: BitVec(8), at_i: values(64, pi) = index, at_l: values(64, pl) = bound, at_v: values(8, pv) = byte,
    under_i: pi < next, under_v: pv < next):
    Keeps(values, FTm::put_region(pi, pl, pv, next).run(call, values, Cons(own, rest)).values, next) ∧
        (FTm::put_region(pi, pl, pv, next).run(call, values, Cons(own, rest)).buffers = Cons(own.with_byte_within(bound, index, byte), rest)) {
    let file: Buffers() = Cons(own, rest);
    let wide = next + 1;
    let out = next + 2;
    let tested = Valuation::set(values, next, bit_value(values(64, pi).unsigned_lt_bit(values(64, pl))));
    let widened = Valuation::set(tested, wide, λ wd => BitVec::ofNat(tested(8, pv).toNat()));
    let sent = low_byte(widened(64, wide));
    let after: Buffers() = Cons(own.update(widened(64, pi).toNat(), λ _ => sent), rest);
    let stored = Valuation::set(widened, out, load_value(after, 0, pi, widened));
    let kept_test: Keeps(values, tested, next) = λ wd id lt =>
        Valuation::set_other(values, next, bit_value(values(64, pi).unsigned_lt_bit(values(64, pl))), wd, id, Nat::ne_of_lt(id, next, lt));
    let kept_wide: Keeps(values, widened, next) = λ wd id lt =>
        trans(Valuation::set_other(tested, wide, λ x => BitVec::ofNat(tested(8, pv).toNat()), wd, id,
                Nat::ne_of_lt(id, wide, Nat::lt_trans(id, next, wide, lt, next.lt_succ_self()))), kept_test(wd, id, lt));
    let kept_store: Keeps(values, stored, next) = λ wd id lt =>
        trans(Valuation::set_other(widened, out, load_value(after, 0, pi, widened), wd, id,
                Nat::ne_of_lt(id, out, Nat::lt_trans(id, wide, out, Nat::lt_trans(id, next, wide, lt, next.lt_succ_self()), wide.lt_succ_self()))),
            kept_wide(wd, id, lt));
    let bit = Tm::cmp_op_holds(values, next, pi, pl, 64, λ (x: BitVec(64)) (y: BitVec(64)) => x.unsigned_lt_bit(y), index, bound, at_i, at_l);
    let under = index.unsigned_lt_bit(bound);
    let chosen: (tested(1, next).head_bit() = under) = trans(cong_fn(λ (x: BitVec(1)) => x.head_bit(), bit), BitVec::head_bit_ofBool(under));
    let index_kept: (widened(64, pi) = index) = trans(kept_wide(64, pi, under_i), at_i);
    let byte_sent: (sent = byte) = trans(cong_fn(low_byte, trans(Valuation::set_here(tested, wide, λ wd => BitVec::ofNat(tested(8, pv).toNat()), 64),
            cong_fn(λ (x: BitVec(8)) => BitVec::ofNat(x.toNat(), n := 64), trans(kept_test(8, pv, under_v), at_v)))), FTm::low_byte_back(byte));
    let left = λ (c: Bool) (x: BitVec(64)) (y: BitVec(8)) => match c as λ _ => Buffers() { False => file, True => Cons(own.update(x.toNat(), λ _ => y), rest) };
    ⟨λ wd id lt => match tested(1, next).head_bit() as λ x => (match x { False => tested(wd, id), True => stored(wd, id) }) = values(wd, id) {
            False => kept_test(wd, id, lt),
            True => kept_store(wd, id, lt),
        },
        trans(trans(cong_fn(λ (c: Bool) => left(c, widened(64, pi), sent), chosen), eq2(λ (x: BitVec(64)) (y: BitVec(8)) => left(under, x, y), index_kept, byte_sent)),
            match under as λ c => left(c, index, byte) = Cons(match c { False => own, True => own.with_byte(index, byte) }, rest) {
                False => refl,
                True => refl,
            })⟩
}

// A `Put`'s variables: their ports, the index and the length words, the
// value a byte.
record PutAt { index: Nat, length: Nat, value: Nat }

fn FTm::put_typed(g: List<Ty>, i, length, v: Nat, at: PutAt) → Option<PutAt> {
    Ty::at(g, i).check(Word(64)).and_then(λ _ => Ty::at(g, length).check(Word(64)).and_then(λ _ => Ty::at(g, v).check(Word(8)).and_then(λ _ => Some(at))))
}

fn FTm::put_ports(g: List<Ty>, ports: List<Nat>, i, length, v: Nat) → Option<PutAt> {
    port_at(ports, i).and_then(λ pi => port_at(ports, length).and_then(λ pl => port_at(ports, v).and_then(λ pv =>
        FTm::put_typed(g, i, length, v, PutAt(pi, pl, pv)))))
}

fn FTm::PutAtHolds(g: List<Ty>, ports: List<Nat>, i, length, v: Nat, r: Option<PutAt>) → Type {
    match r {
        None => True,
        Some(at) => ((port_at(ports, i) = Some(at.index)) ∧ (Ty::at(g, i) = Word(64))) ∧
            (((port_at(ports, length) = Some(at.length)) ∧ (Ty::at(g, length) = Word(64))) ∧
                ((port_at(ports, v) = Some(at.value)) ∧ (Ty::at(g, v) = Word(8)))),
    }
}

theorem FTm::put_ports_sound(g: List<Ty>, ports: List<Nat>, i, length, v: Nat): FTm::PutAtHolds(g, ports, i, length, v, FTm::put_ports(g, ports, i, length, v)) {
    let P = λ (r: Option<PutAt>) => FTm::PutAtHolds(g, ports, i, length, v, r);
    Option::and_then_elim(P, trivial, port_at(ports, i), λ pi => port_at(ports, length).and_then(λ pl => port_at(ports, v).and_then(λ pv =>
        FTm::put_typed(g, i, length, v, PutAt(pi, pl, pv)))), λ pi at_i =>
    Option::and_then_elim(P, trivial, port_at(ports, length), λ pl => port_at(ports, v).and_then(λ pv => FTm::put_typed(g, i, length, v, PutAt(pi, pl, pv))),
        λ pl at_l =>
    Option::and_then_elim(P, trivial, port_at(ports, v), λ pv => FTm::put_typed(g, i, length, v, PutAt(pi, pl, pv)), λ pv at_v =>
    Option::and_then_elim(P, trivial, Ty::at(g, i).check(Word(64)),
        λ _ => Ty::at(g, length).check(Word(64)).and_then(λ _ => Ty::at(g, v).check(Word(8)).and_then(λ _ => Some(PutAt(pi, pl, pv)))), λ ei _ =>
    Option::and_then_elim(P, trivial, Ty::at(g, length).check(Word(64)), λ _ => Ty::at(g, v).check(Word(8)).and_then(λ _ => Some(PutAt(pi, pl, pv))),
        λ el _ =>
    Option::and_then_elim(P, trivial, Ty::at(g, v).check(Word(8)), λ _ => Some(PutAt(pi, pl, pv)), λ ev _ =>
        ⟨⟨at_i, ei⟩, ⟨⟨at_l, el⟩, ⟨at_v, ev⟩⟩⟩))))))
}

// The store, then the rest, which takes fresh ids above the store's three.
fn FTm::put_then(at: PutAt, next: Nat, lb: Lowered) → Option<Lowered> {
    Some(Lowered(Compose(FTm::put_region(at.index, at.length, at.value, next), lb.region), lb.result, lb.next))
}

// The `Put` case, from what the rest's lowering promises.
theorem FTm::put_sound(fw: FWorld, base: Nat, g: List<Ty>, ports: List<Nat>, next, i, length, v: Nat, at: PutAt,
    found: FTm::PutAtHolds(g, ports, i, length, v, Some(at)), b: Ty,
    mb: Env(fw.w.tys, g) → List<BitVec(8)> → Mutated<List<BitVec(8)>, b.sem(fw.w.tys)>, lb: Lowered,
    then: FTm::StepHolds(fw, base, g, ports, next + 3, b, mb, Some(lb))):
    FTm::StepHolds(fw, base, g, ports, next, b, λ env own => mb(env, FTm::put(fw.w.tys, g, env, i, length, v, own)), FTm::put_then(at, next, lb)) {
    λ call agree values env own held below => {
        let tys = fw.w.tys;
        let file: Buffers() = Cons(own, fw.rest);
        let index = Ty::cast(tys, Ty::at(g, i), Word(64), Env::get(tys, g, env, i));
        let bound = Ty::cast(tys, Ty::at(g, length), Word(64), Env::get(tys, g, env, length));
        let byte = Ty::cast(tys, Ty::at(g, v), Word(8), Env::get(tys, g, env, v));
        let region = FTm::put_region(at.index, at.length, at.value, next);
        let put = region.run(call, values, file);
        let ran = FTm::put_runs(call, values, own, fw.rest, at.index, at.length, at.value, next, index, bound, byte,
            Tm::operand(fw.w, g, ports, values, env, held, i, at.index, found.left.left, Word(64), found.left.right),
            Tm::operand(fw.w, g, ports, values, env, held, length, at.length, found.right.left.left, Word(64), found.right.left.right),
            Tm::operand(fw.w, g, ports, values, env, held, v, at.value, found.right.right.left, Word(8), found.right.right.right),
            Ty::below_cast(tys, Ty::at(g, i), Word(64), found.left.right, at.index, next, below_at(tys, g, ports, next, below, i, at.index, found.left.left)),
            Ty::below_cast(tys, Ty::at(g, v), Word(8), found.right.right.right, at.value, next,
                below_at(tys, g, ports, next, below, v, at.value, found.right.right.left)));
        let later = next + 3;
        let step: (next <= later) = Nat::le_succ_r(next, next + 2, Nat::le_succ_r(next, next + 1, Nat::le_succ_r(next, next, next.le_refl())));
        let written = own.with_byte_within(bound, index, byte);
        let two = then(call, agree, put.values, env, written, env_holds_keeps(tys, g, values, put.values, next, ran.left, ports, env, below, held),
            below_mono(tys, g, next, later, step, ports, below));
        ⟨Nat::le_trans(next, later, lb.next, step, two.left), ⟨two.right.left,
            FTm::ran_after(b, tys, region, lb.region, call, values, file, State(put.values, Cons(written, fw.rest)), next, later, lb.result, fw.rest,
                mb(env, written), put.left(Cons(written, fw.rest), ran.right), ran.left, step, two.right.right)⟩⟩
    }
}

// ---------------------------------------------------------------------------
// The call of a computation

// A call's argument ports hold words on which the callee's code ends as
// its meaning does on the meaning's arguments.
theorem FTm::call_args_sound(w: World, g: List<Ty>, ports: List<Nat>, values: Valuation(), env: Env(w.tys, g),
    held: EnvHolds(w.tys, values, g, ports, env), r: Ty, rest: List<List<BitVec(8)>>, d: Mutated<List<BitVec(8)>, r.sem(w.tys)>, ps: List<Ty>):
    (args: List<Nat>) → (F: Ty::ArrowsTo(w.tys, ps, Mutated<List<BitVec(8)>, r.sem(w.tys)>)) → (ans: List<BitVec(64)> → Ending) →
    FTm::Answers(w.tys, ps, r, rest, F, ans) → (qs: List<Nat>) → Tm::call_args(w.tys, g, ports, ps, args) = Some(qs) →
    ans(words_of(values, qs)) = FTm::ended(w.tys, r, rest, FTm::apply(w.tys, g, env, Mutated<List<BitVec(8)>, r.sem(w.tys)>, d, ps, F, args)) {
    let R = Mutated<List<BitVec(8)>, r.sem(w.tys)>;
    match ps {
        Nil => λ args => match args {
            Nil => λ F ans answers qs e => j(Option::some_inj(Nil, qs, e), λ z _ => ans(words_of(values, z)) = FTm::ended(w.tys, r, rest, F), answers),
            Cons(a, more) => λ F ans answers qs e => Option::none_ne_some(qs, e,
                ans(words_of(values, qs)) = FTm::ended(w.tys, r, rest, FTm::apply(w.tys, g, env, R, d, Nil, F, Cons(a, more)))),
        },
        Cons(p, later) => λ args => match args {
            Nil => λ F ans answers qs e => Option::none_ne_some(qs, e,
                ans(words_of(values, qs)) = FTm::ended(w.tys, r, rest, FTm::apply(w.tys, g, env, R, d, Cons(p, later), F, Nil))),
            Cons(a, more) => λ F ans answers => {
                let Goal = λ (qs: List<Nat>) => ans(words_of(values, qs)) =
                    FTm::ended(w.tys, r, rest, FTm::apply(w.tys, g, env, R, d, Cons(p, later), F, Cons(a, more)));
                let P = λ (o: Option<List<Nat>>) => (qs: List<Nat>) → o = Some(qs) → Goal(qs);
                let none: P(None) = λ qs e => Option::none_ne_some(qs, e, Goal(qs));
                let after = λ (q: Nat) => p.check_held(w.tys).and_then(λ _ => Tm::call_args(w.tys, g, ports, later, more).and_then(λ qs => Some(Cons(q, qs))));
                Option::and_then_elim(P, none, port_at(ports, a), λ q => Ty::at(g, a).check(p).and_then(λ _ => after(q)), λ q at_q =>
                Option::and_then_elim(P, none, Ty::at(g, a).check(p), λ _ => after(q), λ ea _ =>
                Option::and_then_elim(P, none, p.check_held(w.tys), λ _ => Tm::call_args(w.tys, g, ports, later, more).and_then(λ qs => Some(Cons(q, qs))), λ hp _ =>
                Option::and_then_elim(P, none, Tm::call_args(w.tys, g, ports, later, more), λ qs => Some(Cons(q, qs)), λ found e_rest =>
                    λ qs e => j(Option::some_inj(Cons(q, found), qs, e), λ z _ => Goal(z), {
                        let x = values(64, q);
                        let arg_eq: (Ty::cast(w.tys, Word(64), p, x) = Ty::cast(w.tys, Ty::at(g, a), p, Env::get(w.tys, g, env, a))) =
                            Ty::held_reads(w.tys, p, values, q, hp, Ty::cast(w.tys, Ty::at(g, a), p, Env::get(w.tys, g, env, a)),
                                Tm::operand(w, g, ports, values, env, held, a, q, at_q, p, ea));
                        trans(FTm::call_args_sound(w, g, ports, values, env, held, r, rest, d, later, more, F(Ty::cast(w.tys, Word(64), p, x)),
                                λ ws => ans(Cons(x, ws)), answers(x), found, e_rest),
                            cong_fn(λ (u: p.sem(w.tys)) => FTm::ended(w.tys, r, rest, FTm::apply(w.tys, g, env, R, d, later, F(u), more)), arg_eq))
                    })))))
            },
        },
    }
}

fn FTm::call_args(w: World, fsigs: List<Sig>, base: Nat, g: List<Ty>, ports: List<Nat>, next, f: Nat, args: List<Nat>) → Option<Lowered> {
    Tm::call_args(w.tys, g, ports, Sig::at(fsigs, f).params, args).and_then(λ qs => Some(Tm::called(base + f, qs, next)))
}

fn FTm::call_result(w: World, fsigs: List<Sig>, base: Nat, g: List<Ty>, ports: List<Nat>, next, f: Nat, args: List<Nat>) → Option<Lowered> {
    Sig::at(fsigs, f).result.check_returned(w.tys).and_then(λ _ => FTm::call_args(w, fsigs, base, g, ports, next, f, args))
}

// A call of the program's computation `f`: FunctionIR's `Call` of function
// `base + f`, at a signature of words, its result moved off the port the
// call writes (`Tm::called`).
fn FTm::lower_call(w: World, fsigs: List<Sig>, base: Nat, g: List<Ty>, ports: List<Nat>, next, f: Nat, args: List<Nat>) → Option<Lowered> {
    Ty::check_helds(w.tys, Sig::at(fsigs, f).params).and_then(λ _ => FTm::call_result(w, fsigs, base, g, ports, next, f, args))
}

theorem FTm::call_sound(fw: FWorld, base: Nat, g: List<Ty>, ports: List<Nat>, next, f: Nat, args: List<Nat>):
    FTm::StepHolds(fw, base, g, ports, next, Sig::at(fw.fsigs, f).result, λ env own => FTm::called(fw, g, env, f, args, own),
        FTm::lower_call(fw.w, fw.fsigs, base, g, ports, next, f, args)) {
    let tys = fw.w.tys;
    let r = Sig::at(fw.fsigs, f).result;
    let ps = Sig::at(fw.fsigs, f).params;
    let P = λ (o: Option<Lowered>) => FTm::StepHolds(fw, base, g, ports, next, r, λ env own => FTm::called(fw, g, env, f, args, own), o);
    Option::and_then_elim(P, trivial, Ty::check_helds(tys, ps), λ _ => FTm::call_result(fw.w, fw.fsigs, base, g, ports, next, f, args), λ ok _ =>
    Option::and_then_elim(P, trivial, r.check_returned(tys), λ _ => FTm::call_args(fw.w, fw.fsigs, base, g, ports, next, f, args), λ er _ =>
    Option::and_then_elim(P, trivial, Tm::call_args(tys, g, ports, ps, args), λ qs => Some(Tm::called(base + f, qs, next)), λ qs e_qs =>
        λ call agree values env own held below => {
            let file: Buffers() = Cons(own, fw.rest);
            let m = FTm::called(fw, g, env, f, args, own);
            let answered: (call(file, base + f, words_of(values, qs)) = FTm::ended(tys, r, fw.rest, m)) =
                FTm::call_args_sound(fw.w, g, ports, values, env, held, r, fw.rest, Mutated(own, r.default(tys)), ps, args,
                    FTm::get(tys, fw.fsigs, fw.writers(fw.rest), f, own), λ ws => call(file, base + f, ws), agree.right.right(f, ⟨ok, er⟩, fw.rest, own), qs, e_qs);
            let word = Ty::cast(tys, r, Word(64), m.value);
            let called = Valuation::set(values, next, word_value(word));
            let moved = λ (wd: Nat) => called(wd, next);
            let after = Valuation::set(called, next + 1, moved);
            let ran: (Tm::called(base + f, qs, next).region.run(call, values, file) = State(after, Cons(m.after, fw.rest))) =
                cong_fn<Ending, State>(λ answer => State(Valuation::set(Valuation::set(values, next, word_value(answer.word)), next + 1,
                    λ wd => Valuation::set(values, next, word_value(answer.word), wd, next)), answer.buffers), answered);
            let word_moved: (after(64, next + 1) = word) =
                trans(Valuation::set_here(called, next + 1, moved, 64), Valuation::set_here(values, next, word_value(word), 64));
            let holds: r.Holds(tys, after, next + 1, m.value) = Ty::returned_holds(tys, after, next + 1, r, er, m.value, word_moved);
            let kept: Keeps(values, after, next) = λ wd id lt =>
                trans(Valuation::set_other(called, next + 1, moved, wd, id,
                        Nat::ne_of_lt(id, next + 1, Nat::lt_trans(id, next, next + 1, lt, next.lt_succ_self()))),
                    Valuation::set_other(values, next, word_value(word), wd, id, Nat::ne_of_lt(id, next, lt)));
            ⟨Nat::le_succ_r(next, next + 1, Nat::le_succ_r(next, next, next.le_refl())), ⟨Ty::returned_below(tys, r, er, next + 1),
                j(sym(ran), λ s _ => FTm::Ran(r, tys, values, s, next, next + 1, fw.rest, m), ⟨kept, ⟨holds, refl⟩⟩)⟩⟩
        })))
}

// ---------------------------------------------------------------------------
// The call over views
//
// A `Lend` lowers to FunctionIR's `Lend`, which binds each view's home
// itself: where it lies (`home + start`) and how long it is (`end -
// start`). A view from the span's first byte starts at a port the lowering
// binds to zero first, so its home is the span's place and its length its
// end (`FView::place_at`, `FView::size_at`). The ids are taken in two runs
// above `next`: one per view for the zeros, then two per view for the
// homes, so each stage keeps every id below its own.

// A view's variables as ports: the buffer it is of, its home, where it
// starts and where it ends.
record ViewPorts { buffer: Nat, home: Nat, start: Nat, end: Nat }

// The port of a 64-bit word variable.
fn FTm::word_port(g: List<Ty>, ports: List<Nat>, v: Nat) → Option<Nat> {
    port_at(ports, v).and_then(λ p => Ty::at(g, v).check(Word(64)).and_then(λ _ => Some(p)))
}

fn FTm::WordPort(tys: Nat → RecInfo, g: List<Ty>, env: Env(tys, g), values: Valuation(), next, v: Nat, r: Option<Nat>) → Type {
    match r { None => True, Some(p) => (values(64, p) = FTm::word(tys, g, env, v)) ∧ (p < next) }
}

theorem FTm::word_port_sound(w: World, g: List<Ty>, ports: List<Nat>, values: Valuation(), env: Env(w.tys, g),
    held: EnvHolds(w.tys, values, g, ports, env), next: Nat, below: Below(w.tys, g, ports, next), v: Nat):
    FTm::WordPort(w.tys, g, env, values, next, v, FTm::word_port(g, ports, v)) {
    let P = λ (r: Option<Nat>) => FTm::WordPort(w.tys, g, env, values, next, v, r);
    Option::and_then_elim(P, trivial, port_at(ports, v), λ p => Ty::at(g, v).check(Word(64)).and_then(λ _ => Some(p)), λ p at_p =>
    Option::and_then_elim(P, trivial, Ty::at(g, v).check(Word(64)), λ _ => Some(p), λ e _ =>
        ⟨Tm::operand(w, g, ports, values, env, held, v, p, at_p, Word(64), e),
            Ty::below_cast(w.tys, Ty::at(g, v), Word(64), e, p, next, below_at(w.tys, g, ports, next, below, v, p, at_p))⟩))
}

// The word a view starts at, and the valuation after the node that binds a
// zero for a view from the first byte.
fn FTm::start_word(tys: Nat → RecInfo, g: List<Ty>, env: Env(tys, g), start: Option<Nat>) → BitVec(64) {
    match start { None => BitVec::ofNat(0), Some(s) => FTm::word(tys, g, env, s) }
}

fn FTm::zeroed(start: Option<Nat>, zero: Nat, values: Valuation()) → Valuation() {
    match start { None => Valuation::set(values, zero, λ wd => BitVec::ofNat(0)), Some(_) => values }
}

theorem FTm::zeroed_keeps(start: Option<Nat>, zero: Nat, values: Valuation()): Keeps(values, FTm::zeroed(start, zero, values), zero) {
    match start as λ s => Keeps(values, FTm::zeroed(s, zero, values), zero) {
        None => λ wd id lt => Valuation::set_other(values, zero, λ x => BitVec::ofNat(0), wd, id, Nat::ne_of_lt(id, zero, lt)),
        Some(_) => λ wd id lt => refl,
    }
}

// The port a view starts at: the zero's, or its variable's.
fn FTm::start_port(g: List<Ty>, ports: List<Nat>, start: Option<Nat>, zero: Nat) → Option<Nat> {
    match start { None => Some(zero), Some(s) => FTm::word_port(g, ports, s) }
}

fn FTm::StartPort(tys: Nat → RecInfo, g: List<Ty>, env: Env(tys, g), values: Valuation(), zero: Nat, start: Option<Nat>, r: Option<Nat>) → Type {
    match r {
        None => True,
        Some(p) => (FTm::zeroed(start, zero, values, 64, p) = FTm::start_word(tys, g, env, start)) ∧ (p < zero + 1),
    }
}

theorem FTm::start_port_sound(w: World, g: List<Ty>, ports: List<Nat>, values: Valuation(), env: Env(w.tys, g),
    held: EnvHolds(w.tys, values, g, ports, env), zero: Nat, below: Below(w.tys, g, ports, zero), start: Option<Nat>):
    FTm::StartPort(w.tys, g, env, values, zero, start, FTm::start_port(g, ports, start, zero)) {
    match start as λ s => FTm::StartPort(w.tys, g, env, values, zero, s, FTm::start_port(g, ports, s, zero)) {
        None => ⟨Valuation::set_here(values, zero, λ wd => BitVec::ofNat(0), 64), zero.lt_succ_self()⟩,
        Some(s) => (match FTm::word_port(g, ports, s) as λ r => FTm::WordPort(w.tys, g, env, values, zero, s, r) →
            FTm::StartPort(w.tys, g, env, values, zero, Some(s), r) {
            None => λ _ => trivial,
            Some(p) => λ h => ⟨h.left, Nat::lt_trans(p, zero, zero + 1, h.right, zero.lt_succ_self())⟩,
        })(FTm::word_port_sound(w, g, ports, values, env, held, zero, below, s)),
    }
}

// What the lowered lend computes from a view's start is what the view
// means: its place, its length, its first index.
theorem FView::place_at(tys: Nat → RecInfo, g: List<Ty>, env: Env(tys, g), home: Nat, start: Option<Nat>):
    FTm::word(tys, g, env, home).add(FTm::start_word(tys, g, env, start)) = FView::place(tys, g, env, home, start) {
    match start as λ s => FTm::word(tys, g, env, home).add(FTm::start_word(tys, g, env, s)) = FView::place(tys, g, env, home, s) {
        None => BitVec::add_zero(64, FTm::word(tys, g, env, home)),
        Some(_) => refl,
    }
}

theorem FView::size_at(tys: Nat → RecInfo, g: List<Ty>, env: Env(tys, g), start: Option<Nat>, end: Nat):
    FTm::word(tys, g, env, end).sub(FTm::start_word(tys, g, env, start)) = FView::size(tys, g, env, start, end) {
    match start as λ s => FTm::word(tys, g, env, end).sub(FTm::start_word(tys, g, env, s)) = FView::size(tys, g, env, s, end) {
        None => j(sym(BitVec::ofNat_zero(64)), λ z _ => FTm::word(tys, g, env, end).sub(z) = FTm::word(tys, g, env, end),
            BitVec::sub_zero(64, FTm::word(tys, g, env, end))),
        Some(_) => refl,
    }
}

theorem FView::first_at(tys: Nat → RecInfo, g: List<Ty>, env: Env(tys, g), start: Option<Nat>):
    FTm::start_word(tys, g, env, start).toNat() = FView::first(tys, g, env, start) {
    match start as λ s => FTm::start_word(tys, g, env, s).toNat() = FView::first(tys, g, env, s) {
        None => trans(cong_fn(λ (x: BitVec(64)) => x.toNat(), BitVec::ofNat_zero(64)), BitVec::zero_toNat(64)),
        Some(_) => refl,
    }
}

// A view's ports, the zero's id `zero` its start where it has no variable.
fn FView::ports(self view: FView, g: List<Ty>, ports: List<Nat>, zero: Nat) → Option<ViewPorts> {
    FTm::word_port(g, ports, view.home).and_then(λ ph => FTm::word_port(g, ports, view.end).and_then(λ pe =>
        FTm::start_port(g, ports, view.start, zero).and_then(λ ps => Some(ViewPorts(view.span, ph, ps, pe)))))
}

fn FView::PortsHold(self view: FView, tys: Nat → RecInfo, g: List<Ty>, env: Env(tys, g), values: Valuation(), zero: Nat, r: Option<ViewPorts>) → Type {
    match r {
        None => True,
        Some(at) => ((at.buffer = view.span) ∧ ((values(64, at.home) = FTm::word(tys, g, env, view.home)) ∧ (at.home < zero))) ∧
            (((FTm::zeroed(view.start, zero, values, 64, at.start) = FTm::start_word(tys, g, env, view.start)) ∧ (at.start < zero + 1)) ∧
                ((values(64, at.end) = FTm::word(tys, g, env, view.end)) ∧ (at.end < zero))),
    }
}

theorem FView::ports_sound(self view: FView, w: World, g: List<Ty>, ports: List<Nat>, values: Valuation(), env: Env(w.tys, g),
    held: EnvHolds(w.tys, values, g, ports, env), zero: Nat, below: Below(w.tys, g, ports, zero)):
    view.PortsHold(w.tys, g, env, values, zero, view.ports(g, ports, zero)) {
    let P = λ (r: Option<ViewPorts>) => view.PortsHold(w.tys, g, env, values, zero, r);
    Option::and_then_elim(P, trivial, FTm::word_port(g, ports, view.home), λ ph => FTm::word_port(g, ports, view.end).and_then(λ pe =>
        FTm::start_port(g, ports, view.start, zero).and_then(λ ps => Some(ViewPorts(view.span, ph, ps, pe)))), λ ph at_h =>
    Option::and_then_elim(P, trivial, FTm::word_port(g, ports, view.end),
        λ pe => FTm::start_port(g, ports, view.start, zero).and_then(λ ps => Some(ViewPorts(view.span, ph, ps, pe))), λ pe at_e =>
    Option::and_then_elim(P, trivial, FTm::start_port(g, ports, view.start, zero), λ ps => Some(ViewPorts(view.span, ph, ps, pe)), λ ps at_s =>
        ⟨⟨refl, j(at_h, λ r _ => FTm::WordPort(w.tys, g, env, values, zero, view.home, r),
                FTm::word_port_sound(w, g, ports, values, env, held, zero, below, view.home))⟩,
            ⟨j(at_s, λ r _ => FTm::StartPort(w.tys, g, env, values, zero, view.start, r),
                    FTm::start_port_sound(w, g, ports, values, env, held, zero, below, view.start)),
                j(at_e, λ r _ => FTm::WordPort(w.tys, g, env, values, zero, view.end, r),
                    FTm::word_port_sound(w, g, ports, values, env, held, zero, below, view.end))⟩⟩)))
}

// The views' ports, a zero's id for each from `zero`.
fn FTm::views_ports(g: List<Ty>, ports: List<Nat>, views: List<FView>, zero: Nat) → Option<List<ViewPorts>> {
    match views {
        Nil => Some(Nil),
        Cons(view, rest) => view.ports(g, ports, zero).and_then(λ at =>
            FTm::views_ports(g, ports, rest, zero + 1).and_then(λ more => Some(Cons(at, more)))),
    }
}

// The nodes that bind the zeros, and the first id past them.
fn FTm::zero_node(start: Option<Nat>, zero: Nat, rest: List<Node>) → List<Node> {
    match start { None => Cons(Const(64, zero, 0), rest), Some(_) => rest }
}

fn FTm::zeros(views: List<FView>, zero: Nat) → List<Node> {
    match views { Nil => Nil, Cons(view, rest) => FTm::zero_node(view.start, zero, FTm::zeros(rest, zero + 1)) }
}

fn FTm::zeros_past(views: List<FView>, zero: Nat) → Nat {
    match views { Nil => zero, Cons(_, rest) => FTm::zeros_past(rest, zero + 1) }
}

theorem FTm::zeros_past_le(views: List<FView>): (zero: Nat) → zero <= FTm::zeros_past(views, zero) {
    match views {
        Nil => λ zero => zero.le_refl(),
        Cons(_, rest) => λ zero => Nat::le_trans(zero, zero + 1, FTm::zeros_past(rest, zero + 1), Nat::le_succ_r(zero, zero, zero.le_refl()),
            FTm::zeros_past_le(rest, zero + 1)),
    }
}

theorem FTm::zero_node_quiet(start: Option<Nat>, zero: Nat, rest: List<Node>, quiet: nodes_quiet(rest).IsTrue()):
    nodes_quiet(FTm::zero_node(start, zero, rest)).IsTrue() {
    match start as λ s => nodes_quiet(FTm::zero_node(s, zero, rest)).IsTrue() { None => quiet, Some(_) => quiet }
}

theorem FTm::zeros_quiet(views: List<FView>): (zero: Nat) → nodes_quiet(FTm::zeros(views, zero)).IsTrue() {
    match views {
        Nil => λ zero => trivial,
        Cons(view, rest) => λ zero => FTm::zero_node_quiet(view.start, zero, FTm::zeros(rest, zero + 1), FTm::zeros_quiet(rest, zero + 1)),
    }
}

theorem FTm::zero_node_eval(file: Buffers(), start: Option<Nat>, zero: Nat, rest: List<Node>, values: Valuation()):
    eval_nodes_over(file, FTm::zero_node(start, zero, rest), values) = eval_nodes_over(file, rest, FTm::zeroed(start, zero, values)) {
    match start as λ s => eval_nodes_over(file, FTm::zero_node(s, zero, rest), values) = eval_nodes_over(file, rest, FTm::zeroed(s, zero, values)) {
        None => refl,
        Some(_) => refl,
    }
}

// Each view's ports hold what the view reads: its buffer is its span, and
// its home, start and end hold the words.
fn FTm::ViewsRead(tys: Nat → RecInfo, g: List<Ty>, env: Env(tys, g), values: Valuation(), views: List<FView>) → List<ViewPorts> → Type {
    match views {
        Nil => λ ats => match ats { Nil => True, Cons(_, _) => False },
        Cons(view, rest) => λ ats => match ats {
            Nil => False,
            Cons(at, more) => ((at.buffer = view.span) ∧ (values(64, at.home) = FTm::word(tys, g, env, view.home))) ∧
                (((values(64, at.start) = FTm::start_word(tys, g, env, view.start)) ∧ (values(64, at.end) = FTm::word(tys, g, env, view.end))) ∧
                    FTm::ViewsRead(tys, g, env, values, rest, more)),
        },
    }
}

// What the ports promise: the zeros' nodes keep every id below `zero`, and
// after them the ports hold what the views read, in every valuation that
// keeps the ids below the zeros' end.
fn FTm::PortsHold(tys: Nat → RecInfo, g: List<Ty>, env: Env(tys, g), file: Buffers(), views: List<FView>, zero: Nat, values: Valuation(),
    r: Option<List<ViewPorts>>) → Type {
    match r {
        None => True,
        Some(ats) => Keeps(values, eval_nodes_over(file, FTm::zeros(views, zero), values), zero) ∧
            ((val: Valuation()) → Keeps(eval_nodes_over(file, FTm::zeros(views, zero), values), val, FTm::zeros_past(views, zero)) →
                FTm::ViewsRead(tys, g, env, val, views, ats)),
    }
}

theorem FTm::views_ports_sound(w: World, g: List<Ty>, ports: List<Nat>, env: Env(w.tys, g), file: Buffers(), views: List<FView>): (zero: Nat) →
    (values: Valuation()) → EnvHolds(w.tys, values, g, ports, env) → Below(w.tys, g, ports, zero) →
    FTm::PortsHold(w.tys, g, env, file, views, zero, values, FTm::views_ports(g, ports, views, zero)) {
    match views {
        Nil => λ zero values held below => ⟨λ wd id lt => refl, λ val keeps => trivial⟩,
        Cons(view, rest) => λ zero values held below => {
            let tys = w.tys;
            let P = λ (r: Option<List<ViewPorts>>) => FTm::PortsHold(tys, g, env, file, Cons(view, rest), zero, values, r);
            let first = FTm::zeroed(view.start, zero, values);
            let z = eval_nodes_over(file, FTm::zeros(rest, zero + 1), first);
            let past = FTm::zeros_past(rest, zero + 1);
            Option::and_then_elim(P, trivial, view.ports(g, ports, zero),
                λ at => FTm::views_ports(g, ports, rest, zero + 1).and_then(λ more => Some(Cons(at, more))), λ at found =>
            Option::and_then_elim(P, trivial, FTm::views_ports(g, ports, rest, zero + 1), λ more => Some(Cons(at, more)), λ more found_rest => {
                let here = j(found, λ r _ => view.PortsHold(tys, g, env, values, zero, r), view.ports_sound(w, g, ports, values, env, held, zero, below));
                let kept_first: Keeps(values, first, zero) = FTm::zeroed_keeps(view.start, zero, values);
                let step: (zero < zero + 1) = zero.lt_succ_self();
                let ih = j(found_rest, λ r _ => FTm::PortsHold(tys, g, env, file, rest, zero + 1, first, r),
                    FTm::views_ports_sound(w, g, ports, env, file, rest, zero + 1, first,
                        env_holds_keeps(tys, g, values, first, zero, kept_first, ports, env, below, held),
                        below_mono(tys, g, zero, zero + 1, Nat::le_succ_r(zero, zero, zero.le_refl()), ports, below)));
                let le_past: (zero + 1 <= past) = FTm::zeros_past_le(rest, zero + 1);
                let kept: Keeps(values, z, zero) = λ wd id lt =>
                    trans(ih.left(wd, id, Nat::lt_trans(id, zero, zero + 1, lt, step)), kept_first(wd, id, lt));
                j(sym(FTm::zero_node_eval(file, view.start, zero, FTm::zeros(rest, zero + 1), values)),
                    λ x _ => Keeps(values, x, zero) ∧ ((val: Valuation()) → Keeps(x, val, past) → FTm::ViewsRead(tys, g, env, val, Cons(view, rest), Cons(at, more))),
                    ⟨kept, λ val keeps => {
                        let low = λ (p: Nat) (lt: p < zero) => trans(keeps(64, p, Nat::lt_of_lt_of_le(p, zero + 1, past,
                            Nat::lt_trans(p, zero, zero + 1, lt, step), le_past)), kept(64, p, lt));
                        let start: (val(64, at.start) = FTm::start_word(tys, g, env, view.start)) =
                            trans(keeps(64, at.start, Nat::lt_of_lt_of_le(at.start, zero + 1, past, here.right.left.right, le_past)),
                                trans(ih.left(64, at.start, here.right.left.right), here.right.left.left));
                        ⟨⟨here.left.left, trans(low(at.home, here.left.right.right), here.left.right.left)⟩,
                            ⟨⟨start, trans(low(at.end, here.right.right.right), here.right.right.left)⟩, ih.right(val, keeps)⟩⟩
                    }⟩)
            }))
        },
    }
}

// The IR's views: view `k`'s home the two ids from `home + 2k`, the first
// written where `written`, the ones after it read.
fn FTm::views_built(ats: List<ViewPorts>, written: Bool, home: Nat) → List<View> {
    match ats {
        Nil => Nil,
        Cons(at, rest) => Cons(View(at.buffer, at.home, at.start, at.end, written, home, home + 1), FTm::views_built(rest, False, home + 2)),
    }
}

fn FTm::homes_past(ats: List<ViewPorts>, home: Nat) → Nat {
    match ats { Nil => home, Cons(_, rest) => FTm::homes_past(rest, home + 2) }
}

theorem FTm::homes_past_le(ats: List<ViewPorts>): (home: Nat) → home <= FTm::homes_past(ats, home) {
    match ats {
        Nil => λ home => home.le_refl(),
        Cons(_, rest) => λ home => Nat::le_trans(home, home + 2, FTm::homes_past(rest, home + 2),
            Nat::le_succ_r(home, home + 1, Nat::le_succ_r(home, home, home.le_refl())), FTm::homes_past_le(rest, home + 2)),
    }
}

theorem FTm::views_built_quiet(ats: List<ViewPorts>): (written: Bool) → (home: Nat) → nodes_quiet(views_nodes(FTm::views_built(ats, written, home))).IsTrue() {
    match ats {
        Nil => λ written home => trivial,
        Cons(_, rest) => λ written home => FTm::views_built_quiet(rest, False, home + 2),
    }
}

// Views that are only read put nothing back.
theorem FTm::unwritten_put(values: Valuation(), ats: List<ViewPorts>): (home: Nat) → (after, held: Buffers()) →
    put_views(FTm::views_built(ats, False, home), values, after, held) = held {
    match ats {
        Nil => λ home after held => refl,
        Cons(_, rest) => λ home after held => FTm::unwritten_put(values, rest, home + 2, match after { Nil => Nil, Cons(_, later) => later }, held),
    }
}

// The homes the IR binds: from a valuation whose ports hold what the views
// read, wherever the ids below `top` are kept, the views' nodes keep every
// id below `home`, the homes hold the words the callee takes, and the
// views are the windows.
theorem FTm::views_bound(tys: Nat → RecInfo, g: List<Ty>, env: Env(tys, g), file: Buffers(), top: Nat, views: List<FView>): (ats: List<ViewPorts>) →
    (written: Bool) → (home: Nat) → top <= home → (z: Valuation()) →
    ((val: Valuation()) → Keeps(z, val, top) → FTm::ViewsRead(tys, g, env, val, views, ats)) →
    Keeps(z, eval_nodes_over(file, views_nodes(FTm::views_built(ats, written, home)), z), home) ∧
        ((words_of(eval_nodes_over(file, views_nodes(FTm::views_built(ats, written, home)), z), views_homes(FTm::views_built(ats, written, home))) =
            FTm::lent_words(tys, g, env, views)) ∧
        (viewed(FTm::views_built(ats, written, home), eval_nodes_over(file, views_nodes(FTm::views_built(ats, written, home)), z), file) =
            FTm::lent_file(tys, g, env, views, file))) {
    match views {
        Nil => λ ats => match ats {
            Nil => λ written home le z read => ⟨λ wd id lt => refl, ⟨refl, refl⟩⟩,
            Cons(_, _) => λ written home le z read => false_elim(read(z, λ wd id lt => refl)),
        },
        Cons(view, rest) => λ ats => match ats {
            Nil => λ written home le z read => false_elim(read(z, λ wd id lt => refl)),
            Cons(at, more) => λ written home le z read => {
                let length = home + 1;
                let later = home + 2;
                let z1 = Valuation::set(z, home, λ wd => z(wd, at.home).add(z(wd, at.start)));
                let z2 = Valuation::set(z1, length, λ wd => z1(wd, at.end).sub(z1(wd, at.start)));
                let b = eval_nodes_over(file, views_nodes(FTm::views_built(more, False, later)), z2);
                let kept_1: Keeps(z, z1, home) = λ wd id lt =>
                    Valuation::set_other(z, home, λ x => z(x, at.home).add(z(x, at.start)), wd, id, Nat::ne_of_lt(id, home, lt));
                let kept_2: Keeps(z, z2, home) = λ wd id lt =>
                    trans(Valuation::set_other(z1, length, λ x => z1(x, at.end).sub(z1(x, at.start)), wd, id,
                            Nat::ne_of_lt(id, length, Nat::lt_trans(id, home, length, lt, home.lt_succ_self()))), kept_1(wd, id, lt));
                let ih = FTm::views_bound(tys, g, env, file, top, rest, more, False, later,
                    Nat::le_succ_r(top, length, Nat::le_succ_r(top, home, le)), z2,
                    λ val keeps => read(val, λ wd id lt => trans(keeps(wd, id, lt), kept_2(wd, id, Nat::lt_of_lt_of_le(id, top, home, lt, le)))).right.right);
                let under: (home < later) = Nat::lt_trans(home, length, later, home.lt_succ_self(), length.lt_succ_self());
                let kept_b: Keeps(z, b, home) = λ wd id lt => trans(ih.left(wd, id, Nat::lt_trans(id, home, later, lt, under)), kept_2(wd, id, lt));
                let at_z = read(z, λ wd id lt => refl);
                let at_1 = read(z1, λ wd id lt => kept_1(wd, id, Nat::lt_of_lt_of_le(id, top, home, lt, le)));
                let at_b = read(b, λ wd id lt => kept_b(wd, id, Nat::lt_of_lt_of_le(id, top, home, lt, le)));
                let base_b: (b(64, home) = view.base(tys, g, env)) =
                    trans(ih.left(64, home, under),
                        trans(Valuation::set_other(z1, length, λ x => z1(x, at.end).sub(z1(x, at.start)), 64, home, Nat::ne_of_lt(home, length, home.lt_succ_self())),
                            trans(Valuation::set_here(z, home, λ x => z(x, at.home).add(z(x, at.start)), 64),
                                trans(eq2(λ (x: BitVec(64)) (y: BitVec(64)) => x.add(y), at_z.left.right, at_z.right.left.left),
                                    FView::place_at(tys, g, env, view.home, view.start)))));
                let length_b: (b(64, length) = view.length(tys, g, env)) =
                    trans(ih.left(64, length, length.lt_succ_self()),
                        trans(Valuation::set_here(z1, length, λ x => z1(x, at.end).sub(z1(x, at.start)), 64),
                            trans(eq2(λ (x: BitVec(64)) (y: BitVec(64)) => x.sub(y), at_1.right.left.right, at_1.right.left.left),
                                FView::size_at(tys, g, env, view.start, view.end))));
                let window = λ (k: Nat) (s: BitVec(64)) (e: BitVec(64)) => buffer_bytes(file, k).window(s.toNat(), e.toNat());
                let bytes_b: (window(at.buffer, b(64, at.start), b(64, at.end)) = view.bytes(tys, g, env, file)) =
                    trans(cong_fn(λ (k: Nat) => window(k, b(64, at.start), b(64, at.end)), at_b.left.left),
                        trans(eq2(λ (s: BitVec(64)) (e: BitVec(64)) => window(view.span, s, e), at_b.right.left.left, at_b.right.left.right),
                            cong_fn(λ (n: Nat) => buffer_bytes(file, view.span).window(n, FTm::word(tys, g, env, view.end).toNat()),
                                FView::first_at(tys, g, env, view.start))));
                ⟨kept_b, ⟨trans(eq2(λ (x: BitVec(64)) (y: BitVec(64)) => Cons(x, Cons(y, words_of(b, views_homes(FTm::views_built(more, False, later))))),
                            base_b, length_b),
                        cong_fn(λ (ws: List<BitVec(64)>) => Cons(view.base(tys, g, env), Cons(view.length(tys, g, env), ws)), ih.right.left)),
                    eq2(λ (h: List<BitVec(8)>) (t: Buffers()) => Cons(h, t), bytes_b, ih.right.right)⟩⟩
            },
        },
    }
}

// The ports of a lend's arguments: the callee's operands past the homes'
// words, on the variables.
fn FTm::lent_args(tys: Nat → RecInfo, g: List<Ty>, ports: List<Nat>, homes: List<Nat>, ps: List<Ty>, args: List<Nat>) → Option<List<Nat>> {
    match homes {
        Nil => Tm::call_args(tys, g, ports, ps, args),
        Cons(_, more) => match ps { Nil => None, Cons(_, later) => FTm::lent_args(tys, g, ports, more, later, args) },
    }
}

// The callee's code ends on the homes' words and the arguments' as its
// meaning does on them.
theorem FTm::lent_args_sound(w: World, g: List<Ty>, ports: List<Nat>, values: Valuation(), env: Env(w.tys, g),
    held: EnvHolds(w.tys, values, g, ports, env), r: Ty, rest: List<List<BitVec(8)>>, d: Mutated<List<BitVec(8)>, r.sem(w.tys)>, args: List<Nat>,
    homes: List<Nat>): (ps: List<Ty>) → (F: Ty::ArrowsTo(w.tys, ps, Mutated<List<BitVec(8)>, r.sem(w.tys)>)) → (ans: List<BitVec(64)> → Ending) →
    FTm::Answers(w.tys, ps, r, rest, F, ans) → (qs: List<Nat>) → FTm::lent_args(w.tys, g, ports, homes, ps, args) = Some(qs) →
    ans(words_of(values, homes ++ qs)) =
        FTm::ended(w.tys, r, rest, FTm::apply_lent(w.tys, g, env, Mutated<List<BitVec(8)>, r.sem(w.tys)>, d, words_of(values, homes), ps, F, args)) {
    let R = Mutated<List<BitVec(8)>, r.sem(w.tys)>;
    match homes {
        Nil => λ ps F ans answers qs e => FTm::call_args_sound(w, g, ports, values, env, held, r, rest, d, ps, args, F, ans, answers, qs, e),
        Cons(h, more) => λ ps => match ps {
            Nil => λ F ans answers qs e => Option::none_ne_some(qs, e, ans(words_of(values, Cons(h, more) ++ qs)) =
                FTm::ended(w.tys, r, rest, FTm::apply_lent(w.tys, g, env, R, d, words_of(values, Cons(h, more)), Nil, F, args))),
            Cons(p, later) => λ F ans answers qs e => FTm::lent_args_sound(w, g, ports, values, env, held, r, rest, d, args, more, later,
                F(Ty::cast(w.tys, Word(64), p, values(64, h))), λ ws => ans(Cons(values(64, h), ws)), answers(values(64, h)), qs, e),
        },
    }
}

// The first view is of the written span.
fn FTm::own_first(views: List<FView>) → Bool {
    match views { Nil => False, Cons(view, _) => match view.span { Zero => True, Succ(_) => False } }
}

// The zeros, the lend, and its result moved off the port the call writes
// (`Tm::called`).
fn FTm::lent_lowered(base, f: Nat, zeros: List<Node>, views: List<View>, qs: List<Nat>, out: Nat) → Lowered {
    Lowered(Compose(nodes_region(zeros), Compose(Lend(views, base + f, qs, out), nodes_region([Move(64, out + 1, out)]))), out + 1, out + 2)
}

fn FTm::lend_args(w: World, fsigs: List<Sig>, base: Nat, g: List<Ty>, ports: List<Nat>, next, f: Nat, views: List<FView>, args: List<Nat>,
    ats: List<ViewPorts>) → Option<Lowered> {
    FTm::lent_args(w.tys, g, ports, views_homes(FTm::views_built(ats, True, FTm::zeros_past(views, next))), Sig::at(fsigs, f).params, args).and_then(λ qs =>
        Some(FTm::lent_lowered(base, f, FTm::zeros(views, next), FTm::views_built(ats, True, FTm::zeros_past(views, next)), qs,
            FTm::homes_past(ats, FTm::zeros_past(views, next)))))
}

fn FTm::lend_views(w: World, fsigs: List<Sig>, base: Nat, g: List<Ty>, ports: List<Nat>, next, f: Nat, views: List<FView>, args: List<Nat>) → Option<Lowered> {
    FTm::views_ports(g, ports, views, next).and_then(λ ats => FTm::lend_args(w, fsigs, base, g, ports, next, f, views, args, ats))
}

fn FTm::lend_result(w: World, fsigs: List<Sig>, base: Nat, g: List<Ty>, ports: List<Nat>, next, f: Nat, views: List<FView>, args: List<Nat>) → Option<Lowered> {
    Sig::at(fsigs, f).result.check_returned(w.tys).and_then(λ _ => FTm::lend_views(w, fsigs, base, g, ports, next, f, views, args))
}

fn FTm::lend_helds(w: World, fsigs: List<Sig>, base: Nat, g: List<Ty>, ports: List<Nat>, next, f: Nat, views: List<FView>, args: List<Nat>) → Option<Lowered> {
    Ty::check_helds(w.tys, Sig::at(fsigs, f).params).and_then(λ _ => FTm::lend_result(w, fsigs, base, g, ports, next, f, views, args))
}

// A call of the program's computation `f` over views: FunctionIR's `Lend`
// of function `base + f`, at a signature of words, the first view written
// and of the written span.
fn FTm::lower_lend(w: World, fsigs: List<Sig>, base: Nat, g: List<Ty>, ports: List<Nat>, next, f: Nat, views: List<FView>, args: List<Nat>) → Option<Lowered> {
    Tm::check_true(FTm::own_first(views)).and_then(λ _ => FTm::lend_helds(w, fsigs, base, g, ports, next, f, views, args))
}

// The run of a lowered lend, from the ports found.
theorem FTm::lend_ran(fw: FWorld, base: Nat, g: List<Ty>, ports: List<Nat>, next, f: Nat, view: FView, reads: List<FView>, args: List<Nat>,
    at_own: view.span = 0, ok: Ty::Helds(fw.w.tys, Sig::at(fw.fsigs, f).params), er: Sig::at(fw.fsigs, f).result.Returned(fw.w.tys),
    call: Writers(), agree: FTm::CallsAgree(fw, base, call), values: Valuation(), env: Env(fw.w.tys, g), own: List<BitVec(8)>,
    held: EnvHolds(fw.w.tys, values, g, ports, env), below: Below(fw.w.tys, g, ports, next), ats: List<ViewPorts>):
    FTm::PortsHold(fw.w.tys, g, env, Cons(own, fw.rest), Cons(view, reads), next, values, Some(ats)) → (qs: List<Nat>) →
    FTm::lent_args(fw.w.tys, g, ports, views_homes(FTm::views_built(ats, True, FTm::zeros_past(Cons(view, reads), next))),
        Sig::at(fw.fsigs, f).params, args) = Some(qs) →
    (next <= FTm::homes_past(ats, FTm::zeros_past(Cons(view, reads), next)) + 2) ∧
        (Sig::at(fw.fsigs, f).result.Below(fw.w.tys, FTm::homes_past(ats, FTm::zeros_past(Cons(view, reads), next)) + 1,
                FTm::homes_past(ats, FTm::zeros_past(Cons(view, reads), next)) + 2) ∧
            FTm::Ran(Sig::at(fw.fsigs, f).result, fw.w.tys, values,
                FTm::lent_lowered(base, f, FTm::zeros(Cons(view, reads), next), FTm::views_built(ats, True, FTm::zeros_past(Cons(view, reads), next)), qs,
                    FTm::homes_past(ats, FTm::zeros_past(Cons(view, reads), next))).region.run(call, values, Cons(own, fw.rest)),
                next, FTm::homes_past(ats, FTm::zeros_past(Cons(view, reads), next)) + 1, fw.rest,
                FTm::lent(fw, g, env, f, Cons(view, reads), args, own))) {
    let tys = fw.w.tys;
    let r = Sig::at(fw.fsigs, f).result;
    let ps = Sig::at(fw.fsigs, f).params;
    let file: Buffers() = Cons(own, fw.rest);
    let vs = Cons(view, reads);
    let top = FTm::zeros_past(vs, next);
    let zeros = FTm::zeros(vs, next);
    let z = eval_nodes_over(file, zeros, values);
    match ats {
        Nil => λ ported qs e_qs => false_elim(ported.right(z, λ wd id lt => refl)),
        Cons(at, more) => λ ported qs e_qs => {
            let all = Cons(at, more);
            let views = FTm::views_built(all, True, top);
            let homes = views_homes(views);
            let out = FTm::homes_past(all, top);
            let b = eval_nodes_over(file, views_nodes(views), z);
            let le_top: (next <= top) = FTm::zeros_past_le(vs, next);
            let le_out: (next <= out) = Nat::le_trans(next, top, out, le_top, FTm::homes_past_le(all, top));
            let bound = FTm::views_bound(tys, g, env, file, top, vs, all, True, top, top.le_refl(), z, ported.right);
            let kept_b: Keeps(values, b, next) = λ wd id lt =>
                trans(bound.left(wd, id, Nat::lt_of_lt_of_le(id, next, top, lt, le_top)), ported.left(wd, id, lt));
            let read_b = ported.right(b, bound.left);
            let R = Mutated<List<BitVec(8)>, r.sem(tys)>;
            let d: R = Mutated(own, r.default(tys));
            let window = view.bytes(tys, g, env, file);
            let rest2 = FTm::lent_file(tys, g, env, reads, file);
            let F = FTm::get(tys, fw.fsigs, fw.writers(rest2), f, window);
            let m1 = FTm::apply_lent(tys, g, env, R, d, FTm::lent_words(tys, g, env, vs), ps, F, args);
            let answered: (call(viewed(views, b, file), base + f, words_of(b, homes ++ qs)) = FTm::ended(tys, r, rest2, m1)) =
                trans(cong_fn(λ (lent: Buffers()) => call(lent, base + f, words_of(b, homes ++ qs)), bound.right.right),
                    trans(FTm::lent_args_sound(fw.w, g, ports, b, env, env_holds_keeps(tys, g, values, b, next, kept_b, ports, env, below, held), r, rest2, d,
                            args, homes, ps, F, λ ws => call(Cons(window, rest2), base + f, ws), agree.right.right(f, ⟨ok, er⟩, rest2, window), qs, e_qs),
                        cong_fn(λ (ws: List<BitVec(64)>) => FTm::ended(tys, r, rest2, FTm::apply_lent(tys, g, env, R, d, ws, ps, F, args)), bound.right.left)));
            let word = Ty::cast(tys, r, Word(64), m1.value);
            let called = Valuation::set(b, out, word_value(word));
            let moved = λ (wd: Nat) => called(wd, out);
            let after = Valuation::set(called, out + 1, moved);
            let from = view.from(tys, g, env);
            let from_b: (b(64, at.start).toNat() = from) =
                trans(cong_fn(λ (x: BitVec(64)) => x.toNat(), read_b.right.left.left), FView::first_at(tys, g, env, view.start));
            let put_back: (put_views(views, b, Cons(m1.after, rest2), file) = Cons(own.put_window(from, m1.after), fw.rest)) =
                trans(FTm::unwritten_put(b, more, top + 2, rest2,
                        file.update(at.buffer, λ (was: List<BitVec(8)>) => was.put_window(b(64, at.start).toNat(), m1.after))),
                    eq2(λ (k: Nat) (n: Nat) => file.update(k, λ (was: List<BitVec(8)>) => was.put_window(n, m1.after)), trans(read_b.left.left, at_own), from_b));
            let finish = λ (bound: State) (answer: Ending) => State(
                Valuation::set(Valuation::set(bound.values, out, word_value(answer.word)), out + 1,
                    λ wd => Valuation::set(bound.values, out, word_value(answer.word), wd, out)),
                put_views(views, bound.values, answer.buffers, bound.buffers));
            let lend_at = λ (bound: State) => finish(bound, call(viewed(views, bound.values, bound.buffers), base + f, words_of(bound.values, homes ++ qs)));
            let lend_from = λ (s: State) => lend_at(run_nodes(views_nodes(views), s.values, s.buffers));
            let ran: (FTm::lent_lowered(base, f, zeros, views, qs, out).region.run(call, values, file) =
                State(after, Cons(own.put_window(from, m1.after), fw.rest))) =
                trans(cong_fn(lend_from, run_nodes_quiet(zeros, FTm::zeros_quiet(vs, next), values, file)),
                    trans(cong_fn(lend_at, run_nodes_quiet(views_nodes(views), FTm::views_built_quiet(all, True, top), z, file)),
                        trans(cong_fn(λ (answer: Ending) => finish(State(b, file), answer), answered),
                            cong_fn(λ (left: Buffers()) => State(after, left), put_back))));
            let m = FTm::lent(fw, g, env, f, vs, args, own);
            let word_moved: (after(64, out + 1) = word) =
                trans(Valuation::set_here(called, out + 1, moved, 64), Valuation::set_here(b, out, word_value(word), 64));
            let holds: r.Holds(tys, after, out + 1, m.value) = Ty::returned_holds(tys, after, out + 1, r, er, m1.value, word_moved);
            let kept: Keeps(values, after, next) = λ wd id lt =>
                trans(Valuation::set_other(called, out + 1, moved, wd, id,
                        Nat::ne_of_lt(id, out + 1, Nat::lt_trans(id, out, out + 1, Nat::lt_of_lt_of_le(id, next, out, lt, le_out), out.lt_succ_self()))),
                    trans(Valuation::set_other(b, out, word_value(word), wd, id, Nat::ne_of_lt(id, out, Nat::lt_of_lt_of_le(id, next, out, lt, le_out))),
                        kept_b(wd, id, lt)));
            ⟨Nat::le_succ_r(next, out + 1, Nat::le_succ_r(next, out, le_out)), ⟨Ty::returned_below(tys, r, er, out + 1),
                j(sym(ran), λ s _ => FTm::Ran(r, tys, values, s, next, out + 1, fw.rest, m), ⟨kept, ⟨holds, refl⟩⟩)⟩⟩
        },
    }
}

theorem FTm::lend_sound_at(fw: FWorld, base: Nat, g: List<Ty>, ports: List<Nat>, next, f: Nat, view: FView, reads: List<FView>, args: List<Nat>):
    FTm::StepHolds(fw, base, g, ports, next, Sig::at(fw.fsigs, f).result, λ env own => FTm::lent(fw, g, env, f, Cons(view, reads), args, own),
        FTm::lower_lend(fw.w, fw.fsigs, base, g, ports, next, f, Cons(view, reads), args)) {
    let tys = fw.w.tys;
    let r = Sig::at(fw.fsigs, f).result;
    let ps = Sig::at(fw.fsigs, f).params;
    let vs = Cons(view, reads);
    let top = FTm::zeros_past(vs, next);
    let P = λ (o: Option<Lowered>) => FTm::StepHolds(fw, base, g, ports, next, r, λ env own => FTm::lent(fw, g, env, f, vs, args, own), o);
    Option::and_then_elim(P, trivial, Tm::check_true(FTm::own_first(vs)), λ _ => FTm::lend_helds(fw.w, fw.fsigs, base, g, ports, next, f, vs, args),
        λ first _ =>
    Option::and_then_elim(P, trivial, Ty::check_helds(tys, ps), λ _ => FTm::lend_result(fw.w, fw.fsigs, base, g, ports, next, f, vs, args), λ ok _ =>
    Option::and_then_elim(P, trivial, r.check_returned(tys), λ _ => FTm::lend_views(fw.w, fw.fsigs, base, g, ports, next, f, vs, args), λ er _ =>
    Option::and_then_elim(P, trivial, FTm::views_ports(g, ports, vs, next), λ ats => FTm::lend_args(fw.w, fw.fsigs, base, g, ports, next, f, vs, args, ats),
        λ ats found =>
    Option::and_then_elim(P, trivial, FTm::lent_args(tys, g, ports, views_homes(FTm::views_built(ats, True, top)), ps, args),
        λ qs => Some(FTm::lent_lowered(base, f, FTm::zeros(vs, next), FTm::views_built(ats, True, top), qs, FTm::homes_past(ats, top))), λ qs e_qs =>
        λ call agree values env own held below => {
            let at_own: (view.span = 0) = (match view.span as λ n => (match n { Zero => True, Succ(_) => False }).IsTrue() → n = 0 {
                Zero => λ _ => refl,
                Succ(_) => λ no => false_elim(no),
            })(first);
            FTm::lend_ran(fw, base, g, ports, next, f, view, reads, args, at_own, ok, er, call, agree, values, env, own, held, below, ats,
                j(found, λ o _ => FTm::PortsHold(tys, g, env, Cons(own, fw.rest), vs, next, values, o),
                    FTm::views_ports_sound(fw.w, g, ports, env, Cons(own, fw.rest), vs, next, values, held, below)), qs, e_qs)
        })))))
}

theorem FTm::lend_sound(fw: FWorld, base: Nat, g: List<Ty>, ports: List<Nat>, next, f: Nat, views: List<FView>, args: List<Nat>):
    FTm::StepHolds(fw, base, g, ports, next, Sig::at(fw.fsigs, f).result, λ env own => FTm::lent(fw, g, env, f, views, args, own),
        FTm::lower_lend(fw.w, fw.fsigs, base, g, ports, next, f, views, args)) {
    match views {
        Nil => trivial,
        Cons(view, reads) => FTm::lend_sound_at(fw, base, g, ports, next, f, view, reads, args),
    }
}

// ---------------------------------------------------------------------------
// What a computation reads: as for a pure term (`Tm::Within`, rt_lower), a
// loop carries the variables its test and body read, and a computation's
// meaning is the same at two environments that agree on those
// (`FTm::sem_kept`). A lend is not read inside a loop yet.

fn FTm::Within(self t: FTm, keep: Nat → Bool) → Type {
    match t {
        Pure(v) => v.Within(keep),
        Let(e, body) => e.Within(keep) ∧ body.Within(Tm::under(keep)),
        If(c, yes, no) => (keep(c) = True) ∧ (yes.Within(keep) ∧ no.Within(keep)),
        IfEq(c, yes, no) => (keep(c) = True) ∧ (yes.Within(keep) ∧ no.Within(keep)),
        Put(i, length, v, body) => Tm::AllKept([i, length, v], keep) ∧ body.Within(keep),
        Call(_, args, body) => Tm::AllKept(args, keep) ∧ body.Within(Tm::under(keep)),
        Again(args) => Tm::AllKept(args, keep),
        Lend(_, _, _, _) => False,
        Loop(init, test, body, rest) => (keep(init) = True) ∧
            (test.Within(Tm::under(keep)) ∧ (body.Within(Tm::under(keep)) ∧ rest.Within(Tm::under(keep)))),
    }
}

fn FTm::check_within(self t: FTm) → (keep: Nat → Bool) → Option<t.Within(keep)> {
    match t as λ u => (keep: Nat → Bool) → Option<u.Within(keep)> {
        Pure(v) => λ keep => v.check_within(keep),
        Let(e, body) => λ keep => Tm::both(e.check_within(keep), body.check_within(Tm::under(keep))),
        If(c, yes, no) => λ keep => Tm::both(Tm::kept_at(keep, c), Tm::both(yes.check_within(keep), no.check_within(keep))),
        IfEq(c, yes, no) => λ keep => Tm::both(Tm::kept_at(keep, c), Tm::both(yes.check_within(keep), no.check_within(keep))),
        Put(i, length, v, body) => λ keep => Tm::both(Tm::check_all_kept([i, length, v], keep), body.check_within(keep)),
        Call(_, args, body) => λ keep => Tm::both(Tm::check_all_kept(args, keep), body.check_within(Tm::under(keep))),
        Again(args) => λ keep => Tm::check_all_kept(args, keep),
        Lend(_, _, _, _) => λ keep => None,
        Loop(init, test, body, rest) => λ keep => Tm::both(Tm::kept_at(keep, init),
            Tm::both(test.check_within(Tm::under(keep)), Tm::both(body.check_within(Tm::under(keep)), rest.check_within(Tm::under(keep))))),
    }
}

// The variables a computation reads, a guess `check_within` checks.
fn FTm::vars(self t: FTm) → List<Nat> {
    match t {
        Pure(v) => v.vars(),
        Let(e, body) => e.vars() ++ Tm::unbind(body.vars()),
        If(c, yes, no) => Cons(c, yes.vars() ++ no.vars()),
        IfEq(c, yes, no) => Cons(c, yes.vars() ++ no.vars()),
        Put(i, length, v, body) => Cons(i, Cons(length, Cons(v, body.vars()))),
        Call(_, args, body) => args ++ Tm::unbind(body.vars()),
        Again(args) => args,
        Lend(_, _, _, _) => Nil,
        Loop(init, test, body, rest) => Cons(init, Tm::unbind(test.vars()) ++ (Tm::unbind(body.vars()) ++ Tm::unbind(rest.vars()))),
    }
}

theorem FTm::apply_kept(tys: Nat → RecInfo, g: List<Ty>, keep: Nat → Bool, e1, e2: Env(tys, g), a: Env::Agree(tys, g, keep, e1, e2), R: Type, d: R,
    ps: List<Ty>): (f: Ty::ArrowsTo(tys, ps, R)) → (vs: List<Nat>) → Tm::AllKept(vs, keep) →
    FTm::apply(tys, g, e1, R, d, ps, f, vs) = FTm::apply(tys, g, e2, R, d, ps, f, vs) {
    match ps {
        Nil => λ f vs _ => refl,
        Cons(p, rest) => λ f vs => match vs as λ l => Tm::AllKept(l, keep) → FTm::apply(tys, g, e1, R, d, Cons(p, rest), f, l) = FTm::apply(tys, g, e2, R, d, Cons(p, rest), f, l) {
            Nil => λ _ => refl,
            Cons(v, more) => λ h => trans(
                cong_fn(λ (x: Ty::at(g, v).sem(tys)) => FTm::apply(tys, g, e1, R, d, rest, f(Ty::cast(tys, Ty::at(g, v), p, x)), more), a(v, h.left)),
                FTm::apply_kept(tys, g, keep, e1, e2, a, R, d, rest, f(Ty::cast(tys, Ty::at(g, v), p, Env::get(tys, g, e2, v))), more, h.right)),
        },
    }
}

// A pure term's value at the span as it is reads only what the term reads.
theorem FTm::value_kept(fw: FWorld, own: List<BitVec(8)>, t: Tm, keep: Nat → Bool, g: List<Ty>, e1, e2: Env(fw.w.tys, g), h: t.Within(keep),
    a: Env::Agree(fw.w.tys, g, keep, e1, e2)): FTm::value(fw, own, t, g, e1) = FTm::value(fw, own, t, g, e2) {
    cong_fn(λ (x: t.ty(fw.at(own), g).sem(fw.w.tys)) => Ty::cast(fw.w.tys, t.ty(fw.at(own), g), t.ty(fw.w, g), x),
        Tm::sem_kept(t, fw.at(own), keep, g, e1, e2, h, a))
}

// A loop's turns at two environments that agree, with bodies that agree,
// are one.
theorem FTm::turn_kept(fw: FWorld, g: List<Ty>, keep: Nat → Bool, e1, e2: Env(fw.w.tys, g), a: Env::Agree(fw.w.tys, g, keep, e1, e2), st: Ty, test: Tm,
    h: test.Within(Tm::under(keep)), bt: Ty, run1, run2: Env(fw.w.tys, Cons(st, g)) → List<BitVec(8)> → Mutated<List<BitVec(8)>, bt.sem(fw.w.tys)>,
    same: (s: st.sem(fw.w.tys)) → (own: List<BitVec(8)>) → run1(Pair(s, e1), own) = run2(Pair(s, e2), own),
    p: Mutated<List<BitVec(8)>, st.sem(fw.w.tys)>): FTm::turn(fw, g, e1, st, test, bt, run1, p) = FTm::turn(fw, g, e2, st, test, bt, run2, p) {
    let tys = fw.w.tys;
    let inner = Cons(st, g);
    eq2(λ (b: Bool) (y: Mutated<List<BitVec(8)>, st.sem(tys)>) => loop::Step::turn(b, λ _ => y, p),
        cong_fn(λ (x: test.ty(fw.w, inner).sem(tys)) => Ty::cast(tys, test.ty(fw.w, inner), Bit, x),
            FTm::value_kept(fw, p.after, test, Tm::under(keep), inner, Pair(p.value, e1), Pair(p.value, e2), h,
                Env::agree_under(tys, g, st, keep, p.value, p.value, refl, e1, e2, a))),
        cong_fn(λ (m: Mutated<List<BitVec(8)>, bt.sem(tys)>) => FTm::recast(tys, bt, st, m), same(p.value, p.after)))
}

// A computation's meaning reads only the variables it reads.
theorem FTm::sem_kept(self t: FTm, fw: FWorld): (keep: Nat → Bool) → (g: List<Ty>) → (e1, e2: Env(fw.w.tys, g)) → (own: List<BitVec(8)>) →
    t.Within(keep) → Env::Agree(fw.w.tys, g, keep, e1, e2) → t.sem(fw, g, e1, own) = t.sem(fw, g, e2, own) {
    let tys = fw.w.tys;
    match t {
        Pure(v) => λ keep g e1 e2 own h a => cong_fn(λ (x: v.ty(fw.w, g).sem(tys)) => Mutated(own, x), FTm::value_kept(fw, own, v, keep, g, e1, e2, h, a)),
        Let(e, body) => λ keep g e1 e2 own h a => {
            let same_e = FTm::value_kept(fw, own, e, keep, g, e1, e2, h.left, a);
            FTm::sem_kept(body, fw, Tm::under(keep), Cons(e.ty(fw.w, g), g), Pair(FTm::value(fw, own, e, g, e1), e1), Pair(FTm::value(fw, own, e, g, e2), e2), own,
                h.right, Env::agree_under(tys, g, e.ty(fw.w, g), keep, FTm::value(fw, own, e, g, e1), FTm::value(fw, own, e, g, e2), same_e, e1, e2, a))
        },
        If(c, yes, no) => λ keep g e1 e2 own h a => {
            let T = Mutated<List<BitVec(8)>, yes.ty(fw.w, fw.fsigs, g).sem(tys)>;
            let N = Mutated<List<BitVec(8)>, no.ty(fw.w, fw.fsigs, g).sem(tys)>;
            let pick = λ (b: Bool) (y: T) (n: N) => match b as λ _ => T {
                False => FTm::recast(tys, no.ty(fw.w, fw.fsigs, g), yes.ty(fw.w, fw.fsigs, g), n), True => y };
            trans(cong_fn(λ (x: Ty::at(g, c).sem(tys)) => pick(Ty::cast(tys, Ty::at(g, c), Bit, x), yes.sem(fw, g, e1, own), no.sem(fw, g, e1, own)), a(c, h.left)),
                eq2(λ (y: T) (n: N) => pick(Ty::cast(tys, Ty::at(g, c), Bit, Env::get(tys, g, e2, c)), y, n),
                    FTm::sem_kept(yes, fw, keep, g, e1, e2, own, h.right.left, a), FTm::sem_kept(no, fw, keep, g, e1, e2, own, h.right.right, a)))
        },
        IfEq(c, yes, no) => λ keep g e1 e2 own h a => {
            let T = Mutated<List<BitVec(8)>, yes.ty(fw.w, fw.fsigs, g).sem(tys)>;
            let N = Mutated<List<BitVec(8)>, no.ty(fw.w, fw.fsigs, g).sem(tys)>;
            let pick = λ (b: Bool) (y: T) (n: N) => Tm::convoy(T, b, y, FTm::recast(tys, no.ty(fw.w, fw.fsigs, g), yes.ty(fw.w, fw.fsigs, g), n));
            trans(cong_fn(λ (x: Ty::at(g, c).sem(tys)) => pick(Ty::cast(tys, Ty::at(g, c), Bit, x), yes.sem(fw, g, e1, own), no.sem(fw, g, e1, own)), a(c, h.left)),
                eq2(λ (y: T) (n: N) => pick(Ty::cast(tys, Ty::at(g, c), Bit, Env::get(tys, g, e2, c)), y, n),
                    FTm::sem_kept(yes, fw, keep, g, e1, e2, own, h.right.left, a), FTm::sem_kept(no, fw, keep, g, e1, e2, own, h.right.right, a)))
        },
        Put(i, length, v, body) => λ keep g e1 e2 own h a => {
            let put = λ (e: Env(tys, g)) => FTm::put(tys, g, e, i, length, v, own);
            let stored = λ (x: Ty::at(g, i).sem(tys)) (y: Ty::at(g, length).sem(tys)) (z: Ty::at(g, v).sem(tys)) =>
                own.with_byte_within(Ty::cast(tys, Ty::at(g, length), Word(64), y), Ty::cast(tys, Ty::at(g, i), Word(64), x), Ty::cast(tys, Ty::at(g, v), Word(8), z));
            let same_put: (put(e1) = put(e2)) = trans(
                eq2(λ (x: Ty::at(g, i).sem(tys)) (y: Ty::at(g, length).sem(tys)) => stored(x, y, Env::get(tys, g, e1, v)), a(i, h.left.left), a(length, h.left.right.left)),
                cong_fn(λ (z: Ty::at(g, v).sem(tys)) => stored(Env::get(tys, g, e2, i), Env::get(tys, g, e2, length), z), a(v, h.left.right.right.left)));
            trans(cong_fn(λ (o: List<BitVec(8)>) => body.sem(fw, g, e1, o), same_put), FTm::sem_kept(body, fw, keep, g, e1, e2, put(e2), h.right, a))
        },
        Call(f, args, body) => λ keep g e1 e2 own h a => {
            let r = Sig::at(fw.fsigs, f).result;
            let M = Mutated<List<BitVec(8)>, r.sem(tys)>;
            let same_call: (FTm::called(fw, g, e1, f, args, own) = FTm::called(fw, g, e2, f, args, own)) =
                FTm::apply_kept(tys, g, keep, e1, e2, a, M, Mutated(own, r.default(tys)), Sig::at(fw.fsigs, f).params,
                    FTm::get(tys, fw.fsigs, fw.writers(fw.rest), f, own), args, h.left);
            trans(cong_fn(λ (m: M) => body.sem(fw, Cons(r, g), Pair(m.value, e1), m.after), same_call),
                FTm::sem_kept(body, fw, Tm::under(keep), Cons(r, g), Pair(FTm::called(fw, g, e2, f, args, own).value, e1),
                    Pair(FTm::called(fw, g, e2, f, args, own).value, e2), FTm::called(fw, g, e2, f, args, own).after, h.right,
                    Env::agree_under(tys, g, r, keep, FTm::called(fw, g, e2, f, args, own).value, FTm::called(fw, g, e2, f, args, own).value, refl, e1, e2, a)))
        },
        Again(args) => λ keep g e1 e2 own h a => {
            let r = Sig::at(fw.fsigs, 0).result;
            FTm::apply_kept(tys, g, keep, e1, e2, a, Mutated<List<BitVec(8)>, r.sem(tys)>, Mutated(own, r.default(tys)), Sig::at(fw.fsigs, 0).params,
                FTm::get(tys, fw.fsigs, fw.writers(fw.rest), 0, own), args, h)
        },
        Lend(_, _, _, _) => λ keep g e1 e2 own h a => false_elim(h),
        Loop(init, test, body, rest) => λ keep g e1 e2 own h a => {
            let st = Ty::at(g, init);
            let inner = Cons(st, g);
            let bt = body.ty(fw.w, fw.fsigs, inner);
            let M = Mutated<List<BitVec(8)>, st.sem(tys)>;
            let run = λ (e: Env(tys, inner)) (o: List<BitVec(8)>) => body.sem(fw, inner, e, o);
            let turn = λ (e: Env(tys, g)) => FTm::turn(fw, g, e, st, test, bt, run);
            let under = λ (s: st.sem(tys)) => Env::agree_under(tys, g, st, keep, s, s, refl, e1, e2, a);
            let ended = λ (e: Env(tys, g)) (x: st.sem(tys)) => loop::Loop::steps(loop::Loop::passes(), turn(e), Mutated(own, x));
            let same_end: (ended(e1, Env::get(tys, g, e1, init)) = ended(e2, Env::get(tys, g, e2, init))) =
                trans(cong_fn(λ (x: st.sem(tys)) => ended(e1, x), a(init, h.left)),
                    loop::Loop::steps_ext(turn(e1), turn(e2), λ p => FTm::turn_kept(fw, g, keep, e1, e2, a, st, test, h.right.left, bt, run, run,
                        λ s o => FTm::sem_kept(body, fw, Tm::under(keep), inner, Pair(s, e1), Pair(s, e2), o, h.right.right.left, under(s)), p),
                        loop::Loop::passes(), Mutated(own, Env::get(tys, g, e2, init))));
            let m2 = ended(e2, Env::get(tys, g, e2, init));
            trans(cong_fn(λ (m: M) => rest.sem(fw, inner, Pair(m.value, e1), m.after), same_end),
                FTm::sem_kept(rest, fw, Tm::under(keep), inner, Pair(m2.value, e1), Pair(m2.value, e2), m2.after, h.right.right.right, under(m2.value)))
        },
    }
}

// ---------------------------------------------------------------------------
// A loop: `Tm`'s `Iterate` lowering (`Tm::iter_region`, rt_lower) with the
// span threaded. The region is the same FunctionIR `Loop`: the state and
// the variables the test and body read carried as its parameters, a pass
// the test, the body's branch and the exit bit. A pass may store, so its
// relation to the meaning's state holds the file as well as the words: the
// state's words, the context's, and the file with the state's span first
// (`FTm::LoopWords`).

fn FTm::loop_keeps(g: List<Ty>, st: Ty, test: Tm, body: FTm) → List<Bool> { Tm::keeps(g, st, Tm::unbind(test.vars()) ++ Tm::unbind(body.vars()), 0) }

fn FTm::loop_keep(g: List<Ty>, st: Ty, test: Tm, body: FTm) → Nat → Bool { Tm::under(λ i => Tm::flag(FTm::loop_keeps(g, st, test, body), i)) }

fn FTm::loop_checked(w: World, fsigs: List<Sig>, st: Ty, inner: List<Ty>, test: Tm, body: FTm, pi, next: Nat, c: Carry, lt, lb: Lowered) → Option<Lowered> {
    Tm::ty(test, w, inner).check(Bit).and_then(λ _ => body.ty(w, fsigs, inner).check(st).and_then(λ _ =>
        Some(Tm::iter_region(w.tys, st, pi, next, c, lt, lb))))
}

fn FTm::lower_loop(w: World, fsigs: List<Sig>, base: Nat, g: List<Ty>, ports: List<Nat>, next, init, pi: Nat, test: Tm, body: FTm,
    lower_body: List<Nat> → Nat → Option<Lowered>) → Option<Lowered> {
    Ty::at(g, init).check_carries(w.tys).and_then(λ _ =>
    Tm::both(test.check_within(FTm::loop_keep(g, Ty::at(g, init), test, body)), body.check_within(FTm::loop_keep(g, Ty::at(g, init), test, body))).and_then(λ _ =>
    Tm::carry(w.tys, Ty::at(g, init), next + 1, g, FTm::loop_keeps(g, Ty::at(g, init), test, body), ports, Tm::iter_at(w.tys, Ty::at(g, init), next)).and_then(λ c =>
    FTm::lower_value(test, w, base, Cons(Ty::at(g, init), g), Cons(next + 1, c.inner), Fun::past(c.cells, Tm::iter_at(w.tys, Ty::at(g, init), next)) + 1).and_then(λ lt =>
    lower_body(Cons(next + 1, c.inner), lt.next).and_then(λ lb =>
        FTm::loop_checked(w, fsigs, Ty::at(g, init), Cons(Ty::at(g, init), g), test, body, pi, next, c, lt, lb))))))
}

// The loop's relation of words and a file to a state: the state's words
// and the context's `ctx`, and the file the state's span over `rest`.
fn FTm::LoopWords(tys: Nat → RecInfo, st: Ty, ctx: List<BitVec(64)>, rest: List<List<BitVec(8)>>)
    → List<BitVec(64)> → Buffers() → Mutated<List<BitVec(8)>, st.sem(tys)> → Type {
    λ ws file p => Tm::IterWords(tys, st, ctx, ws, p.value) ∧ (file = Cons(p.after, rest))
}

// What a pass promises the loop of a step `q`, the file with the words.
fn FTm::Passes<S>(after: State, exit: Nat, next: List<Nat>, R: List<BitVec(64)> → Buffers() → S → Type, q: loop::Step<S>) → Type {
    match q {
        Next(t) => (after.values(1, exit).head_bit() = False) ∧ R(words_of(after.values, next), after.buffers, t),
        Stop(t) => (after.values(1, exit).head_bit() = True) ∧ R(words_of(after.values, next), after.buffers, t),
    }
}

// `Tm::loop_steps` with the file threaded: a loop whose passes each take
// words and a file related to a state to those of its step runs the
// iteration.
theorem FTm::loop_runs<S>(step: Valuation() → Buffers() → State, parameters: List<Nat>, count, exit: Nat, next: List<Nat>,
    R: List<BitVec(64)> → Buffers() → S → Type, turn: S → loop::Step<S>,
    pass: (r: Nat) → (ws: List<BitVec(64)>) → (file: Buffers()) → (s: S) → R(ws, file, s) →
        FTm::Passes(step(pass_valuation(parameters, count, r + 1, ws), file), exit, next, R, turn(s)), k: Nat):
    (ws: List<BitVec(64)>) → (file: Buffers()) → (s: S) → R(ws, file, s) →
    R(loop_run(step, parameters, count, exit, next, k, ws, file).end.state, loop_run(step, parameters, count, exit, next, k, ws, file).buffers,
        loop::Loop::steps(k, turn, s)) {
    match k {
        Zero => λ ws file s h => h,
        Succ(r) => λ ws file s h => {
            let after = step(pass_valuation(parameters, count, r + 1, ws), file);
            let ends = λ (b: Bool) => match b {
                False => loop_run(step, parameters, count, exit, next, r, words_of(after.values, next), after.buffers),
                True => LoopState(LoopEnd(words_of(after.values, next), False), after.buffers),
            };
            (match turn(s) as λ q => FTm::Passes(after, exit, next, R, q) →
                R(ends(after.values(1, exit).head_bit()).end.state, ends(after.values(1, exit).head_bit()).buffers,
                    match q { Next(t) => loop::Loop::steps(r, turn, t), Stop(t) => t }) {
                Next(t) => λ p => j(sym(p.left), λ b _ => R(ends(b).end.state, ends(b).buffers, loop::Loop::steps(r, turn, t)),
                    FTm::loop_runs(step, parameters, count, exit, next, R, turn, pass, r, words_of(after.values, next), after.buffers, t, p.right)),
                Stop(t) => λ p => j(sym(p.left), λ b _ => R(ends(b).end.state, ends(b).buffers, t), p.right),
            })(pass(r, ws, file, s, h))
        },
    }
}

// One pass: from words related to a state `p` and the file holding its
// span, the test and body read the state at its parameters and the
// context at theirs; the exit bit is set where the test failed, and the
// next words and file are related to the step's state.
theorem FTm::loop_pass(fw: FWorld, base: Nat, g: List<Ty>, init: Nat, test: Tm, body: FTm, next: Nat, ok: Ty::at(g, init).Carries(fw.w.tys), c: Carry,
    lt, lb: Lowered,
    c_below: Below(fw.w.tys, g, c.inner, Fun::past(c.cells, Tm::iter_at(fw.w.tys, Ty::at(g, init), next)) + 1),
    t_holds: FTm::ValueHolds(test, fw, base, Cons(Ty::at(g, init), g), Cons(next + 1, c.inner),
        Fun::past(c.cells, Tm::iter_at(fw.w.tys, Ty::at(g, init), next)) + 1, Some(lt)),
    b_holds: FTm::StepHolds(fw, base, Cons(Ty::at(g, init), g), Cons(next + 1, c.inner), lt.next, body.ty(fw.w, fw.fsigs, Cons(Ty::at(g, init), g)),
        λ env own => body.sem(fw, Cons(Ty::at(g, init), g), env, own), Some(lb)),
    e_t: Tm::ty(test, fw.w, Cons(Ty::at(g, init), g)) = Bit, e_b: body.ty(fw.w, fw.fsigs, Cons(Ty::at(g, init), g)) = Ty::at(g, init),
    call: Writers(), agree: FTm::CallsAgree(fw, base, call), env: Env(fw.w.tys, g), ctx: List<BitVec(64)>, ctx_len: ctx.len() = c.cells.len(),
    carried: (b: Valuation()) → words_of(b, Fun::param_ids(c.cells, Tm::iter_at(fw.w.tys, Ty::at(g, init), next))) = ctx →
        EnvHolds(fw.w.tys, b, g, c.inner, Env::refill(fw.w.tys, g, FTm::loop_keeps(g, Ty::at(g, init), test, body), c.inner, b, env)),
    wi: test.Within(FTm::loop_keep(g, Ty::at(g, init), test, body)) ∧ body.Within(FTm::loop_keep(g, Ty::at(g, init), test, body)),
    r: Nat, ws: List<BitVec(64)>, p: Mutated<List<BitVec(8)>, Ty::at(g, init).sem(fw.w.tys)>, h: Tm::IterWords(fw.w.tys, Ty::at(g, init), ctx, ws, p.value)):
    (Fun::past(c.cells, Tm::iter_at(fw.w.tys, Ty::at(g, init), next)) + 1 <= lt.next) ∧ ((lt.next <= lb.next) ∧
    FTm::Passes(Tm::iter_pass(fw.w.tys, Ty::at(g, init), next, lt, lb).run(call,
            pass_valuation(Fun::param_ids(Ty::at(g, init).cells(fw.w.tys) ++ c.cells, next + 1),
                Fun::past(c.cells, Tm::iter_at(fw.w.tys, Ty::at(g, init), next)), r + 1, ws), Cons(p.after, fw.rest)),
        Tm::iter_branch(fw.w.tys, Ty::at(g, init), next, lt, lb).next + 1,
        Fun::param_ids(Ty::at(g, init).cells(fw.w.tys), lb.next) ++ Fun::param_ids(c.cells, Tm::iter_at(fw.w.tys, Ty::at(g, init), next)),
        FTm::LoopWords(fw.w.tys, Ty::at(g, init), ctx, fw.rest),
        FTm::turn(fw, g, env, Ty::at(g, init), test, body.ty(fw.w, fw.fsigs, Cons(Ty::at(g, init), g)),
            λ e o => body.sem(fw, Cons(Ty::at(g, init), g), e, o), p))) {
    let tys = fw.w.tys;
    let st = Ty::at(g, init);
    let inner = Cons(st, g);
    let bt = body.ty(fw.w, fw.fsigs, inner);
    let cs = st.cells(tys);
    let n = cs.len();
    let at = Tm::iter_at(tys, st, next);
    let c0 = Fun::past(c.cells, at);
    let all = cs ++ c.cells;
    let params = Fun::param_ids(all, next + 1);
    let sids = Fun::param_ids(cs, next + 1);
    let cids = Fun::param_ids(c.cells, at);
    let ports2 = Cons(next + 1, c.inner);
    let br = Tm::iter_branch(tys, st, next, lt, lb);
    let file: Buffers() = Cons(p.after, fw.rest);
    let s = p.value;
    let counted = Valuation::set(Valuation::zero(), c0, word_value(BitVec::ofNat(r + 1)));
    let pv = pass_valuation(params, c0, r + 1, ws);
    let ws_len: (params.len() = ws.len()) = trans(Fun::ids_len(all, next + 1),
        trans(List::len_append(cs, c.cells), sym(trans(Tm::iter_words_len(tys, st, ctx, ws, s, h), cong_fn(λ (k: Nat) => n + k, ctx_len)))));
    let bound: (words_of(pv, params) = ws) = words_of_bind(counted, params, Fun::ids_distinct(all, next + 1), ws, ws_len);
    let halves = Tm::split_eq(words_of(pv, sids), words_of(pv, cids), ws.take(n), ctx,
        trans(sym(Fun::words_append(pv, sids, cids)), trans(cong_fn(λ (l: List<Nat>) => words_of(pv, l), sym(Fun::ids_append(cs, c.cells, next + 1))),
            trans(bound, sym(h.left)))),
        trans(words_of_len(pv, sids), trans(Fun::ids_len(cs, next + 1), sym(h.right.left))));
    let held_s: st.Holds(tys, pv, next + 1, s) = st.words_hold_in(tys, ok, pv, next + 1, ws.take(n), s, halves.left, h.right.left, h.right.right);
    let c1: (c0 <= c0 + 1) = Nat::le_succ_r(c0, c0, c0.le_refl());
    let below2: Below(tys, inner, ports2, c0 + 1) =
        ⟨st.below_cells(tys, next + 1, c0 + 1, Nat::le_trans(at, c0, c0 + 1, Fun::past_ge(c.cells, at), c1)), c_below⟩;
    let env2 = Pair(s, env);
    let ks = FTm::loop_keeps(g, st, test, body);
    let refilled = Env::refill(tys, g, ks, c.inner, pv, env);
    let env2x = Pair(s, refilled);
    let ag = Env::agree_under(tys, g, st, λ i => Tm::flag(ks, i), s, s, refl, env, refilled, Env::refill_agree(tys, g, ks, c.inner, pv, env));
    let same_t: (FTm::value(fw, p.after, test, inner, env2) = FTm::value(fw, p.after, test, inner, env2x)) =
        FTm::value_kept(fw, p.after, test, FTm::loop_keep(g, st, test, body), inner, env2, env2x, wi.left, ag);
    let same_b: (body.sem(fw, inner, env2, p.after) = body.sem(fw, inner, env2x, p.after)) =
        FTm::sem_kept(body, fw, FTm::loop_keep(g, st, test, body), inner, env2, env2x, p.after, wi.right, ag);
    let held2: EnvHolds(tys, pv, inner, ports2, env2x) = ⟨held_s, carried(pv, halves.right)⟩;
    // The test: it leaves the file, its bit at `lt.result`.
    let ran_t = t_holds(call, agree, pv, env2x, p.after, held2, below2);
    let mid_t = lt.region.run(call, pv, file);
    let pvt = mid_t.values;
    let tv = Ty::cast(tys, Tm::ty(test, fw.w, inner), Bit, FTm::value(fw, p.after, test, inner, env2));
    let bit_t: (pvt(1, lt.result) = BitVec::ofBool(tv)) =
        trans(Ty::cast_holds(tys, pvt, lt.result, Tm::ty(test, fw.w, inner), Bit, e_t, FTm::value(fw, p.after, test, inner, env2x), ran_t.right.right.right.left),
            cong_fn(λ (x: Tm::ty(test, fw.w, inner).sem(tys)) => BitVec::ofBool(Ty::cast(tys, Tm::ty(test, fw.w, inner), Bit, x)), sym(same_t)));
    let tr_lt: (lt.result < lt.next) = Ty::below_cast(tys, Tm::ty(test, fw.w, inner), Bit, e_t, lt.result, lt.next, ran_t.right.left);
    let mid_is: (mid_t = State(pvt, file)) = mid_t.left(file, ran_t.right.right.right.right);
    let held_t: EnvHolds(tys, pvt, inner, ports2, env2x) = env_holds_keeps(tys, inner, pv, pvt, c0 + 1, ran_t.right.right.left, ports2, env2x, below2, held2);
    // The body: from the file as the test left it.
    let ran_b = b_holds(call, agree, pvt, env2x, p.after, held_t, below_mono(tys, inner, c0 + 1, lt.next, ran_t.left, ports2, below2));
    let bm = FTm::recast(tys, bt, st, body.sem(fw, inner, env2, p.after));
    let bmx = FTm::recast(tys, bt, st, body.sem(fw, inner, env2x, p.after));
    let out = lb.next;
    let cast_b = FTm::ran_cast(tys, bt, st, e_b, pvt, lb.region.run(call, pvt, file), lt.next, lb.result, fw.rest, body.sem(fw, inner, env2x, p.after),
        ran_b.right.right);
    let below_b = Ty::below_cast(tys, bt, st, e_b, lb.result, lb.next, ran_b.right.left);
    let le_out: (lt.next <= out) = ran_b.left;
    let moved_t = FTm::moved_ran(st, tys, lb.region, call, pvt, file, lt.next, lb.result, out, fw.rest, bmx, below_b, le_out, cast_b);
    let below_s: st.Below(tys, next + 1, out) = st.below_mono(tys, next + 1, c0 + 1, out, Nat::le_trans(c0 + 1, lt.next, out, ran_t.left, le_out), below2.left);
    let ran_none: FTm::Ran(st, tys, pvt, nodes_region(Nil).run(call, pvt, file), lt.next, next + 1, fw.rest, p) = ⟨λ wd id _ => refl, ⟨held_t.left, refl⟩⟩;
    let moved_f = FTm::moved_ran(st, tys, nodes_region(Nil), call, pvt, file, lt.next, next + 1, out, fw.rest, p, below_s, le_out, ran_none);
    let outs = moved_ports(st.moves(tys, out, lb.result));
    let when_true = Compose(lb.region, nodes_region(st.moves(tys, out, lb.result)));
    let when_false = Compose(nodes_region(Nil), nodes_region(st.moves(tys, out, next + 1)));
    let chosen: (pvt(1, lt.result).head_bit() = tv) = trans(cong_fn(λ (x: BitVec(1)) => x.head_bit(), bit_t), BitVec::head_bit_ofBool(tv));
    let fin = match tv { False => p, True => bmx };
    let ran_br: FTm::Ran(st, tys, pvt, br.region.run(call, pvt, file), lt.next, out, fw.rest, fin) =
        FTm::branch_ran(st, tys, pvt, lt.result, outs, when_true, when_false, call, file, lt.next, out, fw.rest, tv, bmx, p, chosen,
            moved_t.right.right, moved_f.right.right);
    let mid_b = br.region.run(call, pvt, file);
    let pvbr = mid_b.values;
    let z = br.next;
    let z_past: (z = Fun::past(cs, out)) = st.past_cells(tys, out);
    let out_z: (out <= z) = j(sym(z_past), λ y _ => out <= y, Fun::past_ge(cs, out));
    let q = Valuation::set(pvbr, z, λ wd => BitVec::ofNat(1));
    let exit_value = λ (w: Nat) => q(w, lt.result).bxor(q(w, z));
    let after = Valuation::set(q, z + 1, exit_value);
    let lt_z: (lt.result < z) = Nat::lt_of_lt_of_le(lt.result, lt.next, z, tr_lt, Nat::le_trans(lt.next, out, z, le_out, out_z));
    let at_tr: (q(1, lt.result) = BitVec::ofBool(tv)) =
        trans(Valuation::set_other(pvbr, z, λ wd => BitVec::ofNat(1), 1, lt.result, Nat::ne_of_lt(lt.result, z, lt_z)),
            trans(ran_br.left(1, lt.result, tr_lt), bit_t));
    let at_z: (q(1, z) = BitVec::ofNat(1)) = Valuation::set_here(pvbr, z, λ wd => BitVec::ofNat(1), 1);
    let exit: (after(1, z + 1).head_bit() = tv.not()) =
        trans(cong_fn(λ (x: BitVec(1)) => x.head_bit(), Valuation::set_here(q, z + 1, exit_value, 1)),
            trans(eq2(λ (a: BitVec(1)) (b: BitVec(1)) => a.bxor(b).head_bit(), at_tr, at_z), Tm::exit_bit(tv)));
    let keeps_end: Keeps(pvbr, after, z) = λ wd id below_id =>
        trans(Valuation::set_other(q, z + 1, exit_value, wd, id, Nat::ne_of_lt(id, z + 1, Nat::lt_of_lt_of_le(id, z, z + 1, below_id, Nat::le_succ_r(z, z, z.le_refl())))),
            Valuation::set_other(pvbr, z, λ x => BitVec::ofNat(1), wd, id, Nat::ne_of_lt(id, z, below_id)));
    let below_out: st.Below(tys, out, z) = st.below_cells(tys, out, z, j(sym(z_past), λ y _ => Fun::past(cs, out) <= y, Fun::past(cs, out).le_refl()));
    let held_end: st.Holds(tys, after, out, fin.value) = st.holds_at(tys, pvbr, after, out, out, st.same_kept(tys, pvbr, after, z, keeps_end, out, below_out),
        fin.value, ran_br.right.left);
    let sw = words_of(after, Fun::param_ids(cs, out));
    let sw_len: (sw.len() = n) = trans(words_of_len(after, Fun::param_ids(cs, out)), Fun::ids_len(cs, out));
    let keeps_all: Keeps(pv, after, c0 + 1) = λ wd id below_id => {
        let lt1 = Nat::lt_of_lt_of_le(id, c0 + 1, lt.next, below_id, ran_t.left);
        trans(keeps_end(wd, id, Nat::lt_of_lt_of_le(id, lt.next, z, lt1, Nat::le_trans(lt.next, out, z, le_out, out_z))),
            trans(ran_br.left(wd, id, lt1), ran_t.right.right.left(wd, id, below_id)))
    };
    let ctx_same: (words_of(after, cids) = ctx) =
        trans(Tm::words_kept(pv, after, c0 + 1, keeps_all, cids, Tm::ids_below(c.cells, at, c0 + 1, c1)), halves.right);
    let next_words: (words_of(after, Fun::param_ids(cs, out) ++ cids) = sw ++ ctx) =
        trans(Fun::words_append(after, Fun::param_ids(cs, out), cids), cong_fn(λ (l: List<BitVec(64)>) => sw ++ l, ctx_same));
    let related = λ (t: Mutated<List<BitVec(8)>, st.sem(tys)>) (hw: st.WordsHold(tys, sw, t.value)) (left: mid_b.buffers = Cons(t.after, fw.rest)) =>
        And(j(sym(next_words), λ l _ => Tm::IterWords(tys, st, ctx, l, t.value), Tm::iter_words(tys, st, ctx, sw, t.value, sw_len, hw)), left);
    let words_end = st.words_hold_out(tys, ok, after, out, fin.value, held_end);
    // The pass's run: the test left the file, so the branch runs from it.
    let ran_pass: (Tm::iter_pass(tys, st, next, lt, lb).run(call, pv, file) = State(after, mid_b.buffers)) =
        cong_fn(λ (m: State) => Compose(br.region, nodes_region([Const(1, z, 1), BitXor(1, z + 1, lt.result, z)])).run(call, m.values, m.buffers), mid_is);
    let turn_is: (FTm::turn(fw, g, env, st, test, bt, λ e o => body.sem(fw, inner, e, o), p) = loop::Step::turn(tv, λ _ => bm, p)) = refl;
    let same_bm: (bm = bmx) = cong_fn(λ (m: Mutated<List<BitVec(8)>, bt.sem(tys)>) => FTm::recast(tys, bt, st, m), same_b);
    ⟨ran_t.left, ⟨le_out,
        j(sym(ran_pass), λ e _ => FTm::Passes(e, z + 1, Fun::param_ids(cs, out) ++ cids, FTm::LoopWords(tys, st, ctx, fw.rest), loop::Step::turn(tv, λ _ => bm, p)),
            j(sym(same_bm), λ y _ => FTm::Passes(State(after, mid_b.buffers), z + 1, Fun::param_ids(cs, out) ++ cids, FTm::LoopWords(tys, st, ctx, fw.rest),
                    loop::Step::turn(tv, λ _ => y, p)),
                (match tv as λ b => (after(1, z + 1).head_bit() = b.not()) → st.WordsHold(tys, sw, (match b { False => p, True => bmx }).value) →
                    (mid_b.buffers = Cons((match b { False => p, True => bmx }).after, fw.rest)) →
                    FTm::Passes(State(after, mid_b.buffers), z + 1, Fun::param_ids(cs, out) ++ cids, FTm::LoopWords(tys, st, ctx, fw.rest), loop::Step::turn(b, λ _ => bmx, p)) {
                    True => λ ex hw left => ⟨ex, related(bmx, hw, left)⟩,
                    False => λ ex hw left => ⟨ex, related(p, hw, left)⟩,
                })(exit, words_end, ran_br.right.right)))⟩⟩
}

// The loop: its words start related to the state the variable holds and
// the span as it is, the passes keep them related, and its outputs hold
// the state it ends at, the file holding the span it leaves.
theorem FTm::loop_holds(fw: FWorld, base: Nat, g: List<Ty>, ports: List<Nat>, next, init, pi: Nat, test: Tm, body: FTm, at_pi: port_at(ports, init) = Some(pi),
    ok: Ty::at(g, init).Carries(fw.w.tys),
    wi: test.Within(FTm::loop_keep(g, Ty::at(g, init), test, body)) ∧ body.Within(FTm::loop_keep(g, Ty::at(g, init), test, body)), c: Carry,
    ch: Tm::CarryHolds(fw.w.tys, g, FTm::loop_keeps(g, Ty::at(g, init), test, body), ports, Tm::iter_at(fw.w.tys, Ty::at(g, init), next), Some(c)),
    lt, lb: Lowered,
    t_holds: FTm::ValueHolds(test, fw, base, Cons(Ty::at(g, init), g), Cons(next + 1, c.inner),
        Fun::past(c.cells, Tm::iter_at(fw.w.tys, Ty::at(g, init), next)) + 1, Some(lt)),
    b_holds: FTm::StepHolds(fw, base, Cons(Ty::at(g, init), g), Cons(next + 1, c.inner), lt.next, body.ty(fw.w, fw.fsigs, Cons(Ty::at(g, init), g)),
        λ env own => body.sem(fw, Cons(Ty::at(g, init), g), env, own), Some(lb)),
    e_t: Tm::ty(test, fw.w, Cons(Ty::at(g, init), g)) = Bit, e_b: body.ty(fw.w, fw.fsigs, Cons(Ty::at(g, init), g)) = Ty::at(g, init)):
    FTm::StepHolds(fw, base, g, ports, next, Ty::at(g, init), FTm::iterated(fw, g, init, test, body.ty(fw.w, fw.fsigs, Cons(Ty::at(g, init), g)), λ e o => body.sem(fw, Cons(Ty::at(g, init), g), e, o)),
        Some(Tm::iter_region(fw.w.tys, Ty::at(g, init), pi, next, c, lt, lb))) {
    λ call agree values env own held below => {
        let tys = fw.w.tys;
        let st = Ty::at(g, init);
        let inner = Cons(st, g);
        let bt = body.ty(fw.w, fw.fsigs, inner);
        let cs = st.cells(tys);
        let n = cs.len();
        let at = Tm::iter_at(tys, st, next);
        let c0 = Fun::past(c.cells, at);
        let all = cs ++ c.cells;
        let params = Fun::param_ids(all, next + 1);
        let cids = Fun::param_ids(c.cells, at);
        let br = Tm::iter_branch(tys, st, next, lt, lb);
        let z = br.next;
        let o = z + 2;
        let outs = Fun::param_ids(all, o);
        let x = Fun::past(all, o);
        let loopnext = Fun::param_ids(cs, lb.next) ++ cids;
        let file: Buffers() = Cons(own, fw.rest);
        let values1 = Valuation::set(values, next, λ wd => BitVec::ofNat(Tm::passes()));
        let inputs = Fun::param_ids(cs, pi) ++ c.src;
        let ctx = words_of(values, c.src);
        let v0 = Env::get(tys, g, env, init);
        let held0: st.Holds(tys, values, pi, v0) = env_holds_at(tys, values, g, ports, env, held, init, pi, at_pi);
        let below0: st.Below(tys, pi, next) = below_at(tys, g, ports, next, below, init, pi, at_pi);
        let keeps1: Keeps(values, values1, next) = λ wd id below_id =>
            Valuation::set_other(values, next, λ y => BitVec::ofNat(Tm::passes()), wd, id, Nat::ne_of_lt(id, next, below_id));
        let in_below: Tm::AllBelow(inputs, next) =
            Tm::all_below_append(next, c.src, ch.right.left(next, below), Fun::param_ids(cs, pi), st.cell_ids_below(tys, pi, next, below0));
        let sw0 = words_of(values, Fun::param_ids(cs, pi));
        let ws0: (words_of(values1, inputs) = sw0 ++ ctx) =
            trans(Tm::words_kept(values, values1, next, keeps1, inputs, in_below), Fun::words_append(values, Fun::param_ids(cs, pi), c.src));
        let sw0_len: (sw0.len() = n) = trans(words_of_len(values, Fun::param_ids(cs, pi)), Fun::ids_len(cs, pi));
        let p0 = Mutated(own, v0);
        let r0: FTm::LoopWords(tys, st, ctx, fw.rest, words_of(values1, inputs), file, p0) =
            ⟨j(sym(ws0), λ l _ => Tm::IterWords(tys, st, ctx, l, v0),
                Tm::iter_words(tys, st, ctx, sw0, v0, sw0_len, st.words_hold_out(tys, ok, values, pi, v0, held0))), refl⟩;
        let ctx_len: (ctx.len() = c.cells.len()) = trans(words_of_len(values, c.src), ch.left);
        let c_below: Below(tys, g, c.inner, c0 + 1) = ch.right.right.left(c0 + 1, c0.lt_succ_self());
        let carried = λ (b: Valuation()) (same: words_of(b, cids) = ctx) => ch.right.right.right(values, b, env, same, held);
        let turn = FTm::turn(fw, g, env, st, test, bt, λ e o => body.sem(fw, inner, e, o));
        let pass_region = Tm::iter_pass(tys, st, next, lt, lb);
        let stepf = λ (pv: Valuation()) (held: Buffers()) => pass_region.run(call, pv, held);
        let pass = λ (r: Nat) (ws: List<BitVec(64)>) (f: Buffers()) (p: Mutated<List<BitVec(8)>, st.sem(tys)>)
            (h: FTm::LoopWords(tys, st, ctx, fw.rest, ws, f, p)) =>
            j(sym(h.right), λ f2 _ => FTm::Passes(stepf(pass_valuation(params, c0, r + 1, ws), f2), z + 1, loopnext, FTm::LoopWords(tys, st, ctx, fw.rest), turn(p)),
                (FTm::loop_pass(fw, base, g, init, test, body, next, ok, c, lt, lb, c_below, t_holds, b_holds, e_t, e_b, call, agree, env, ctx, ctx_len,
                    carried, wi, r, ws, p, h.left)).right.right);
        let first = FTm::loop_pass(fw, base, g, init, test, body, next, ok, c, lt, lb, c_below, t_holds, b_holds, e_t, e_b, call, agree, env, ctx, ctx_len,
            carried, wi, 0, words_of(values1, inputs), p0, r0.left);
        let ran = FTm::loop_runs(stepf, params, c0, z + 1, loopnext, FTm::LoopWords(tys, st, ctx, fw.rest), turn, pass,
            values1(64, next).toNat(), words_of(values1, inputs), file, p0, r0);
        let at_bound: (values1(64, next).toNat() = Tm::passes()) = trans(
            cong_fn(λ (v: BitVec(64)) => v.toNat(), Valuation::set_here(values, next, λ wd => BitVec::ofNat(Tm::passes()), 64)),
            BitVec::toNat_ofNat(64, Tm::passes(), trivial));
        let end = loop_run(stepf, params, c0, z + 1, loopnext, values1(64, next).toNat(), words_of(values1, inputs), file);
        let fin = loop::Loop::steps(Tm::passes(), turn, p0);
        let rel: FTm::LoopWords(tys, st, ctx, fw.rest, end.end.state, end.buffers, fin) =
            j(at_bound, λ k _ => FTm::LoopWords(tys, st, ctx, fw.rest, end.end.state, end.buffers, loop::Loop::steps(k, turn, p0)), ran);
        let bv1 = Valuation::bind(values1, outs, end.end.state);
        let after = Valuation::set(bv1, x, bit_value(end.end.exhausted));
        let end_len: (outs.len() = end.end.state.len()) = trans(Fun::ids_len(all, o),
            trans(List::len_append(cs, c.cells), sym(trans(Tm::iter_words_len(tys, st, ctx, end.end.state, fin.value, rel.left), cong_fn(λ (k: Nat) => n + k, ctx_len)))));
        let bound_out: (words_of(bv1, outs) = end.end.state) = words_of_bind(values1, outs, Fun::ids_distinct(all, o), end.end.state, end_len);
        let ids_o = Fun::param_ids(cs, o);
        let rest_o = Fun::param_ids(c.cells, Fun::past(cs, o));
        let a_words = words_of(bv1, ids_o);
        let a_len: (a_words.len() = n) = trans(words_of_len(bv1, ids_o), Fun::ids_len(cs, o));
        let a_is: (a_words = end.end.state.take(n)) = trans(sym(Tm::take_front(a_words, words_of(bv1, rest_o), n, a_len)),
            cong_fn(λ (l: List<BitVec(64)>) => l.take(n), trans(sym(Fun::words_append(bv1, ids_o, rest_o)),
                trans(cong_fn(λ (l: List<Nat>) => words_of(bv1, l), sym(Fun::ids_append(cs, c.cells, o))), bound_out))));
        let keeps_x: Keeps(bv1, after, x) = λ wd id below_id => Valuation::set_other(bv1, x, bit_value(end.end.exhausted), wd, id, Nat::ne_of_lt(id, x, below_id));
        let o_past: (Fun::past(cs, o) <= x) = Fun::past_first(cs, c.cells, o);
        let read: (words_of(after, ids_o) = end.end.state.take(n)) =
            trans(Tm::words_kept(bv1, after, x, keeps_x, ids_o, Tm::ids_below(cs, o, x, o_past)), a_is);
        let held_fin: st.Holds(tys, after, o, fin.value) =
            st.words_hold_in(tys, ok, after, o, end.end.state.take(n), fin.value, read, rel.left.right.left, rel.left.right.right);
        let le_at: (next + 1 <= at) = Fun::past_ge(cs, next + 1);
        let le_c0: (at <= c0) = Fun::past_ge(c.cells, at);
        let le_lb: (c0 + 1 <= lb.next) = Nat::le_trans(c0 + 1, lt.next, lb.next, first.left, first.right.left);
        let le_z: (lb.next <= z) = j(sym(st.past_cells(tys, lb.next)), λ y _ => lb.next <= y, Fun::past_ge(cs, lb.next));
        let next_z: (next < z) = Nat::le_trans(next + 1, at, z, le_at, Nat::le_trans(at, c0 + 1, z, Nat::le_succ_r(at, c0, le_c0),
            Nat::le_trans(c0 + 1, lb.next, z, le_lb, le_z)));
        let next_o: (next < o) = Nat::lt_of_lt_of_le(next, z, o, next_z, Nat::le_succ_r(z, z + 1, Nat::le_succ_r(z, z, z.le_refl())));
        let o_x: (o <= x) = Fun::past_ge(all, o);
        ⟨Nat::le_succ_r(next, x, Nat::le_of_lt(next, x, Nat::lt_of_lt_of_le(next, o, x, next_o, o_x))),
            ⟨st.below_cells(tys, o, x + 1, Nat::le_succ_r(Fun::past(cs, o), x, o_past)),
                ⟨λ wd id below_id => {
                    let id_o: (id < o) = Nat::lt_trans(id, next, o, below_id, next_o);
                    trans(keeps_x(wd, id, Nat::lt_of_lt_of_le(id, o, x, id_o, o_x)),
                        trans(Valuation::bind_frame(values1, outs, end.end.state, wd, id, Fun::absent_ids(all, o, id, Inl(id_o))), keeps1(wd, id, below_id)))
                }, ⟨held_fin, rel.right⟩⟩⟩⟩
    }
}

// ---------------------------------------------------------------------------
// The lowering

fn FTm::lower(self t: FTm, w: World, fsigs: List<Sig>, base: Nat, g: List<Ty>, ports: List<Nat>, next: Nat) → Option<Lowered> {
    match t {
        Pure(v) => FTm::lower_value(v, w, base, g, ports, next),
        // The body sees the term's port as variable 0.
        Let(e, body) => FTm::lower_value(e, w, base, g, ports, next).and_then(λ le =>
            FTm::lower(body, w, fsigs, base, Cons(e.ty(w, g), g), Cons(le.result, ports), le.next).and_then(λ lb => Tm::compose(le, lb))),
        // Each arm from the same context and the same span; the second's
        // fresh ids above the first's.
        If(c, yes, no) => FTm::lower(yes, w, fsigs, base, g, ports, next).and_then(λ ly =>
            FTm::lower(no, w, fsigs, base, g, ports, ly.next).and_then(λ ln =>
                Tm::lower_branch(w.tys, g, ports, c, yes.ty(w, fsigs, g), no.ty(w, fsigs, g), ly, ln))),
        IfEq(c, yes, no) => FTm::lower(yes, w, fsigs, base, g, ports, next).and_then(λ ly =>
            FTm::lower(no, w, fsigs, base, g, ports, ly.next).and_then(λ ln =>
                Tm::lower_branch(w.tys, g, ports, c, yes.ty(w, fsigs, g), no.ty(w, fsigs, g), ly, ln))),
        Put(i, length, v, body) => FTm::put_ports(g, ports, i, length, v).and_then(λ at =>
            FTm::lower(body, w, fsigs, base, g, ports, next + 3).and_then(λ lb => FTm::put_then(at, next, lb))),
        // The body sees the callee's value, at the port it was moved to,
        // as variable 0.
        Call(f, args, body) => FTm::lower_call(w, fsigs, base, g, ports, next, f, args).and_then(λ lc =>
            FTm::lower(body, w, fsigs, base, Cons(Sig::at(fsigs, f).result, g), Cons(lc.result, ports), lc.next).and_then(λ lb => Tm::compose(lc, lb))),
        // Outside a loop, a self-call is a call of computation 0.
        Again(args) => FTm::lower_call(w, fsigs, base, g, ports, next, 0, args),
        // As a call: the body sees the callee's value as variable 0.
        Lend(f, views, args, body) => FTm::lower_lend(w, fsigs, base, g, ports, next, f, views, args).and_then(λ lc =>
            FTm::lower(body, w, fsigs, base, Cons(Sig::at(fsigs, f).result, g), Cons(lc.result, ports), lc.next).and_then(λ lb => Tm::compose(lc, lb))),
        // The loop (`FTm::lower_loop`), then the rest from its outputs.
        Loop(init, test, body, rest) => port_at(ports, init).and_then(λ pi =>
            FTm::lower_loop(w, fsigs, base, g, ports, next, init, pi, test, body, λ ps k => FTm::lower(body, w, fsigs, base, Cons(Ty::at(g, init), g), ps, k)).and_then(λ ll =>
            FTm::lower(rest, w, fsigs, base, Cons(Ty::at(g, init), g), Cons(ll.result, ports), ll.next).and_then(λ lr => Tm::compose(ll, lr)))),
    }
}

theorem FTm::pure_lowers(v: Tm, w: World, fsigs: List<Sig>, base: Nat, g: List<Ty>, ports: List<Nat>, next: Nat):
    FTm::lower(Pure(v), w, fsigs, base, g, ports, next) = FTm::lower_value(v, w, base, g, ports, next) { refl }

theorem FTm::pure_steps(v: Tm, fw: FWorld, base: Nat, g: List<Ty>, ports: List<Nat>, next: Nat, r: Option<Lowered>, h: FTm::ValueHolds(v, fw, base, g, ports, next, r)):
    FTm::StepHolds(fw, base, g, ports, next, v.ty(fw.w, g), λ env own => Mutated(own, FTm::value(fw, own, v, g, env)), r) { h }

// What a lowering promises: the step of the computation's meaning.
fn FTm::LowerHolds(self t: FTm, fw: FWorld, base: Nat, g: List<Ty>, ports: List<Nat>, next: Nat, r: Option<Lowered>) → Type {
    FTm::StepHolds(fw, base, g, ports, next, t.ty(fw.w, fw.fsigs, g), λ env own => t.sem(fw, g, env, own), r)
}

// `IfEq` lowers as `If` does, and means what `If` means.
theorem FTm::ifeq_of_if(c: Nat, yes, no: FTm, fw: FWorld, base: Nat, g: List<Ty>, ports: List<Nat>, next: Nat):
    (r: Option<Lowered>) → FTm::LowerHolds(If(c, yes, no), fw, base, g, ports, next, r) → FTm::LowerHolds(IfEq(c, yes, no), fw, base, g, ports, next, r) {
    λ r => match r as λ q => FTm::LowerHolds(If(c, yes, no), fw, base, g, ports, next, q) → FTm::LowerHolds(IfEq(c, yes, no), fw, base, g, ports, next, q) {
        None => λ _ => trivial,
        Some(l) => λ h call agree values env own held below => {
            let tys = fw.w.tys;
            let held_if = h(call, agree, values, env, own, held, below);
            let scrutinee = Ty::cast(tys, Ty::at(g, c), Bit, Env::get(tys, g, env, c));
            let ty_yes = yes.ty(fw.w, fw.fsigs, g);
            ⟨held_if.left, ⟨held_if.right.left,
                j(sym(Tm::convoy_match(Mutated<List<BitVec(8)>, ty_yes.sem(tys)>, scrutinee, yes.sem(fw, g, env, own),
                        FTm::recast(tys, no.ty(fw.w, fw.fsigs, g), ty_yes, no.sem(fw, g, env, own)))),
                    λ m _ => FTm::Ran(ty_yes, tys, values, l.region.run(call, values, Cons(own, fw.rest)), next, l.result, fw.rest, m),
                    held_if.right.right)⟩⟩
        },
    }
}

// A branch's two arms lowered, then the branch.
theorem FTm::arms_sound(c: Nat, yes, no: FTm, fw: FWorld, base: Nat,
    ih_yes: (g: List<Ty>) → (ports: List<Nat>) → (next: Nat) →
        FTm::LowerHolds(yes, fw, base, g, ports, next, FTm::lower(yes, fw.w, fw.fsigs, base, g, ports, next)),
    ih_no: (g: List<Ty>) → (ports: List<Nat>) → (next: Nat) →
        FTm::LowerHolds(no, fw, base, g, ports, next, FTm::lower(no, fw.w, fw.fsigs, base, g, ports, next)),
    g: List<Ty>, ports: List<Nat>, next: Nat):
    FTm::LowerHolds(If(c, yes, no), fw, base, g, ports, next, FTm::lower(If(c, yes, no), fw.w, fw.fsigs, base, g, ports, next)) {
    let P = λ (r: Option<Lowered>) => FTm::LowerHolds(If(c, yes, no), fw, base, g, ports, next, r);
    let ty_yes = yes.ty(fw.w, fw.fsigs, g);
    let ty_no = no.ty(fw.w, fw.fsigs, g);
    Option::and_then_elim(P, trivial, FTm::lower(yes, fw.w, fw.fsigs, base, g, ports, next),
        λ ly => FTm::lower(no, fw.w, fw.fsigs, base, g, ports, ly.next).and_then(λ ln => Tm::lower_branch(fw.w.tys, g, ports, c, ty_yes, ty_no, ly, ln)),
        λ ly lowered_yes =>
    Option::and_then_elim(P, trivial, FTm::lower(no, fw.w, fw.fsigs, base, g, ports, ly.next),
        λ ln => Tm::lower_branch(fw.w.tys, g, ports, c, ty_yes, ty_no, ly, ln), λ ln lowered_no =>
        FTm::if_sound(fw, base, g, ports, next, c, ty_yes, ty_no, λ env own => yes.sem(fw, g, env, own), λ env own => no.sem(fw, g, env, own), ly, ln,
            j(lowered_yes, λ r _ => FTm::LowerHolds(yes, fw, base, g, ports, next, r), ih_yes(g, ports, next)),
            j(lowered_no, λ r _ => FTm::LowerHolds(no, fw, base, g, ports, ly.next, r), ih_no(g, ports, ly.next)))))
}

// The theorem: the code a computation lowers to runs to its meaning.
// The `Loop` case before `rest`, from what the test's and body's lowerings
// promise.
theorem FTm::loop_sound(fw: FWorld, base: Nat, g: List<Ty>, ports: List<Nat>, next, init, pi: Nat, test: Tm, body: FTm, at_pi: port_at(ports, init) = Some(pi),
    ih_body: (ps: List<Nat>) → (k: Nat) → FTm::LowerHolds(body, fw, base, Cons(Ty::at(g, init), g), ps, k, FTm::lower(body, fw.w, fw.fsigs, base, Cons(Ty::at(g, init), g), ps, k))):
    FTm::StepHolds(fw, base, g, ports, next, Ty::at(g, init), FTm::iterated(fw, g, init, test, body.ty(fw.w, fw.fsigs, Cons(Ty::at(g, init), g)), λ e o => body.sem(fw, Cons(Ty::at(g, init), g), e, o)),
        FTm::lower_loop(fw.w, fw.fsigs, base, g, ports, next, init, pi, test, body, λ ps k => FTm::lower(body, fw.w, fw.fsigs, base, Cons(Ty::at(g, init), g), ps, k))) {
    let tys = fw.w.tys;
    let st = Ty::at(g, init);
    let inner = Cons(st, g);
    let K = FTm::loop_keep(g, st, test, body);
    let ks = FTm::loop_keeps(g, st, test, body);
    let at = Tm::iter_at(tys, st, next);
    let P = λ (r: Option<Lowered>) => FTm::StepHolds(fw, base, g, ports, next, st, FTm::iterated(fw, g, init, test, body.ty(fw.w, fw.fsigs, Cons(Ty::at(g, init), g)), λ e o => body.sem(fw, Cons(Ty::at(g, init), g), e, o)), r);
    Option::and_then_elim(P, trivial, st.check_carries(tys), λ _ =>
        Tm::both(test.check_within(K), body.check_within(K)).and_then(λ _ =>
        Tm::carry(tys, st, next + 1, g, ks, ports, at).and_then(λ c =>
        FTm::lower_value(test, fw.w, base, inner, Cons(next + 1, c.inner), Fun::past(c.cells, at) + 1).and_then(λ lt =>
        FTm::lower(body, fw.w, fw.fsigs, base, inner, Cons(next + 1, c.inner), lt.next).and_then(λ lb =>
            FTm::loop_checked(fw.w, fw.fsigs, st, inner, test, body, pi, next, c, lt, lb))))), λ ok _ =>
    Option::and_then_elim(P, trivial, Tm::both(test.check_within(K), body.check_within(K)), λ _ =>
        Tm::carry(tys, st, next + 1, g, ks, ports, at).and_then(λ c =>
        FTm::lower_value(test, fw.w, base, inner, Cons(next + 1, c.inner), Fun::past(c.cells, at) + 1).and_then(λ lt =>
        FTm::lower(body, fw.w, fw.fsigs, base, inner, Cons(next + 1, c.inner), lt.next).and_then(λ lb =>
            FTm::loop_checked(fw.w, fw.fsigs, st, inner, test, body, pi, next, c, lt, lb)))), λ wi _ =>
    Option::and_then_elim(P, trivial, Tm::carry(tys, st, next + 1, g, ks, ports, at), λ c =>
        FTm::lower_value(test, fw.w, base, inner, Cons(next + 1, c.inner), Fun::past(c.cells, at) + 1).and_then(λ lt =>
        FTm::lower(body, fw.w, fw.fsigs, base, inner, Cons(next + 1, c.inner), lt.next).and_then(λ lb =>
            FTm::loop_checked(fw.w, fw.fsigs, st, inner, test, body, pi, next, c, lt, lb))), λ c carried =>
    Option::and_then_elim(P, trivial, FTm::lower_value(test, fw.w, base, inner, Cons(next + 1, c.inner), Fun::past(c.cells, at) + 1), λ lt =>
        FTm::lower(body, fw.w, fw.fsigs, base, inner, Cons(next + 1, c.inner), lt.next).and_then(λ lb =>
            FTm::loop_checked(fw.w, fw.fsigs, st, inner, test, body, pi, next, c, lt, lb)), λ lt lowered_t =>
    Option::and_then_elim(P, trivial, FTm::lower(body, fw.w, fw.fsigs, base, inner, Cons(next + 1, c.inner), lt.next), λ lb =>
        FTm::loop_checked(fw.w, fw.fsigs, st, inner, test, body, pi, next, c, lt, lb), λ lb lowered_b =>
    Option::and_then_elim(P, trivial, Tm::ty(test, fw.w, inner).check(Bit), λ _ => body.ty(fw.w, fw.fsigs, inner).check(st).and_then(λ _ =>
        Some(Tm::iter_region(tys, st, pi, next, c, lt, lb))), λ e_t _ =>
    Option::and_then_elim(P, trivial, body.ty(fw.w, fw.fsigs, inner).check(st), λ _ => Some(Tm::iter_region(tys, st, pi, next, c, lt, lb)), λ e_b _ =>
        FTm::loop_holds(fw, base, g, ports, next, init, pi, test, body, at_pi, ok, wi, c,
            j(carried, λ r _ => Tm::CarryHolds(tys, g, ks, ports, at, r),
                Tm::carry_sound(tys, st, next + 1, g, ks, ports, at, (Fun::past(st.cells(tys), next + 1)).le_refl())),
            lt, lb,
            j(lowered_t, λ r _ => FTm::ValueHolds(test, fw, base, inner, Cons(next + 1, c.inner), Fun::past(c.cells, at) + 1, r),
                FTm::value_sound(test, fw, base, inner, Cons(next + 1, c.inner), Fun::past(c.cells, at) + 1)),
            j(lowered_b, λ r _ => FTm::LowerHolds(body, fw, base, inner, Cons(next + 1, c.inner), lt.next, r), ih_body(Cons(next + 1, c.inner), lt.next)),
            e_t, e_b))))))))
}

// The `Loop` arm of `FTm::lower`, as an equation: the kernel compares
// `lower` of a `Loop` with its unfolding cheaply alone, not under
// `LowerHolds`.
theorem FTm::lower_loop_eq(init: Nat, test: Tm, body, rest: FTm, w: World, fsigs: List<Sig>, base: Nat, g: List<Ty>, ports: List<Nat>, next: Nat):
    FTm::lower(Loop(init, test, body, rest), w, fsigs, base, g, ports, next) = port_at(ports, init).and_then(λ pi =>
        FTm::lower_loop(w, fsigs, base, g, ports, next, init, pi, test, body, λ ps k => FTm::lower(body, w, fsigs, base, Cons(Ty::at(g, init), g), ps, k)).and_then(λ ll =>
        FTm::lower(rest, w, fsigs, base, Cons(Ty::at(g, init), g), Cons(ll.result, ports), ll.next).and_then(λ lr => Tm::compose(ll, lr)))) { refl }

// The loop's promise, at the loop's lowering found.
theorem FTm::loop_first(fw: FWorld, base: Nat, g: List<Ty>, ports: List<Nat>, next, init, pi: Nat, test: Tm, body: FTm,
    at_pi: port_at(ports, init) = Some(pi), ll: Lowered,
    lowered_loop: FTm::lower_loop(fw.w, fw.fsigs, base, g, ports, next, init, pi, test, body, λ ps k => FTm::lower(body, fw.w, fw.fsigs, base, Cons(Ty::at(g, init), g), ps, k)) = Some(ll),
    ih_body: (ps: List<Nat>) → (k: Nat) → FTm::LowerHolds(body, fw, base, Cons(Ty::at(g, init), g), ps, k, FTm::lower(body, fw.w, fw.fsigs, base, Cons(Ty::at(g, init), g), ps, k))):
    FTm::StepHolds(fw, base, g, ports, next, Ty::at(g, init), FTm::iterated(fw, g, init, test, body.ty(fw.w, fw.fsigs, Cons(Ty::at(g, init), g)), λ e o => body.sem(fw, Cons(Ty::at(g, init), g), e, o)), Some(ll)) {
    j(lowered_loop, λ r _ => FTm::StepHolds(fw, base, g, ports, next, Ty::at(g, init),
            FTm::iterated(fw, g, init, test, body.ty(fw.w, fw.fsigs, Cons(Ty::at(g, init), g)), λ e o => body.sem(fw, Cons(Ty::at(g, init), g), e, o)), r),
        FTm::loop_sound(fw, base, g, ports, next, init, pi, test, body, at_pi, ih_body))
}

// The `Loop` case once the loop and the rest have lowered.
theorem FTm::loop_bound(fw: FWorld, base: Nat, g: List<Ty>, ports: List<Nat>, next, init, pi: Nat, test: Tm, body, rest: FTm,
    at_pi: port_at(ports, init) = Some(pi), ll, lr: Lowered,
    lowered_loop: FTm::lower_loop(fw.w, fw.fsigs, base, g, ports, next, init, pi, test, body, λ ps k => FTm::lower(body, fw.w, fw.fsigs, base, Cons(Ty::at(g, init), g), ps, k)) = Some(ll),
    lowered_rest: FTm::lower(rest, fw.w, fw.fsigs, base, Cons(Ty::at(g, init), g), Cons(ll.result, ports), ll.next) = Some(lr),
    ih_body: (ps: List<Nat>) → (k: Nat) → FTm::LowerHolds(body, fw, base, Cons(Ty::at(g, init), g), ps, k, FTm::lower(body, fw.w, fw.fsigs, base, Cons(Ty::at(g, init), g), ps, k)),
    ih_rest: (ps: List<Nat>) → (k: Nat) → FTm::LowerHolds(rest, fw, base, Cons(Ty::at(g, init), g), ps, k, FTm::lower(rest, fw.w, fw.fsigs, base, Cons(Ty::at(g, init), g), ps, k))):
    FTm::LowerHolds(Loop(init, test, body, rest), fw, base, g, ports, next, Tm::compose(ll, lr)) {
    FTm::bind_sound_of(fw, base, g, ports, next, Ty::at(g, init),
        FTm::iterated(fw, g, init, test, body.ty(fw.w, fw.fsigs, Cons(Ty::at(g, init), g)), λ e o => body.sem(fw, Cons(Ty::at(g, init), g), e, o)),
        rest.ty(fw.w, fw.fsigs, Cons(Ty::at(g, init), g)), λ e o => rest.sem(fw, Cons(Ty::at(g, init), g), e, o), ll, lr,
        FTm::loop_first(fw, base, g, ports, next, init, pi, test, body, at_pi, ll, lowered_loop, ih_body),
        j(lowered_rest, λ r _ => FTm::LowerHolds(rest, fw, base, Cons(Ty::at(g, init), g), Cons(ll.result, ports), ll.next, r),
            ih_rest(Cons(ll.result, ports), ll.next)))
}



// The `Loop` case: the loop (`FTm::loop_sound`), then the rest from its
// outputs, bound as a call's result is.
theorem FTm::loop_case_sound(fw: FWorld, base: Nat, g: List<Ty>, ports: List<Nat>, next, init: Nat, test: Tm, body, rest: FTm,
    ih_body: (ps: List<Nat>) → (k: Nat) → FTm::LowerHolds(body, fw, base, Cons(Ty::at(g, init), g), ps, k, FTm::lower(body, fw.w, fw.fsigs, base, Cons(Ty::at(g, init), g), ps, k)),
    ih_rest: (ps: List<Nat>) → (k: Nat) → FTm::LowerHolds(rest, fw, base, Cons(Ty::at(g, init), g), ps, k, FTm::lower(rest, fw.w, fw.fsigs, base, Cons(Ty::at(g, init), g), ps, k))):
    FTm::LowerHolds(Loop(init, test, body, rest), fw, base, g, ports, next, FTm::lower(Loop(init, test, body, rest), fw.w, fw.fsigs, base, g, ports, next)) {
    let P = λ (r: Option<Lowered>) => FTm::LowerHolds(Loop(init, test, body, rest), fw, base, g, ports, next, r);
    let st = Ty::at(g, init);
    let inner = Cons(st, g);
    let lower_body = λ (ps: List<Nat>) (k: Nat) => FTm::lower(body, fw.w, fw.fsigs, base, inner, ps, k);
    let looped = FTm::iterated(fw, g, init, test, body.ty(fw.w, fw.fsigs, inner), λ e o => body.sem(fw, inner, e, o));
    let unfolded: P(port_at(ports, init).and_then(λ pi =>
        FTm::lower_loop(fw.w, fw.fsigs, base, g, ports, next, init, pi, test, body, lower_body).and_then(λ ll =>
        FTm::lower(rest, fw.w, fw.fsigs, base, inner, Cons(ll.result, ports), ll.next).and_then(λ lr => Tm::compose(ll, lr))))) =
    Option::and_then_elim(P, trivial, port_at(ports, init), λ pi =>
        FTm::lower_loop(fw.w, fw.fsigs, base, g, ports, next, init, pi, test, body, lower_body).and_then(λ ll =>
        FTm::lower(rest, fw.w, fw.fsigs, base, inner, Cons(ll.result, ports), ll.next).and_then(λ lr => Tm::compose(ll, lr))), λ pi at_pi =>
    Option::and_then_elim(P, trivial, FTm::lower_loop(fw.w, fw.fsigs, base, g, ports, next, init, pi, test, body, lower_body), λ ll =>
        FTm::lower(rest, fw.w, fw.fsigs, base, inner, Cons(ll.result, ports), ll.next).and_then(λ lr => Tm::compose(ll, lr)), λ ll lowered_loop =>
    Option::and_then_elim(P, trivial, FTm::lower(rest, fw.w, fw.fsigs, base, inner, Cons(ll.result, ports), ll.next), λ lr => Tm::compose(ll, lr),
        λ lr lowered_rest => FTm::loop_bound(fw, base, g, ports, next, init, pi, test, body, rest, at_pi, ll, lr, lowered_loop, lowered_rest, ih_body, ih_rest))));
    j(sym(FTm::lower_loop_eq(init, test, body, rest, fw.w, fw.fsigs, base, g, ports, next)), λ r _ => P(r), unfolded)
}

theorem FTm::lower_sound(self t: FTm, fw: FWorld, base: Nat): (g: List<Ty>) → (ports: List<Nat>) → (next: Nat) →
    FTm::LowerHolds(t, fw, base, g, ports, next, FTm::lower(t, fw.w, fw.fsigs, base, g, ports, next)) {
    match t {
        Pure(v) => λ g ports next => FTm::pure_steps(v, fw, base, g, ports, next, FTm::lower(Pure(v), fw.w, fw.fsigs, base, g, ports, next),
            j(sym(FTm::pure_lowers(v, fw.w, fw.fsigs, base, g, ports, next)), λ r _ => FTm::ValueHolds(v, fw, base, g, ports, next, r),
                FTm::value_sound(v, fw, base, g, ports, next))),
        Let(e, body) => λ g ports next => {
            let P = λ (r: Option<Lowered>) => FTm::LowerHolds(Let(e, body), fw, base, g, ports, next, r);
            let inner = Cons(e.ty(fw.w, g), g);
            Option::and_then_elim(P, trivial, FTm::lower_value(e, fw.w, base, g, ports, next),
                λ le => FTm::lower(body, fw.w, fw.fsigs, base, inner, Cons(le.result, ports), le.next).and_then(λ lb => Tm::compose(le, lb)),
                λ le lowered_e =>
            Option::and_then_elim(P, trivial, FTm::lower(body, fw.w, fw.fsigs, base, inner, Cons(le.result, ports), le.next), λ lb => Tm::compose(le, lb),
                λ lb lowered_body =>
                FTm::bind_sound(fw, base, g, ports, next, e.ty(fw.w, g), λ env own => Mutated(own, FTm::value(fw, own, e, g, env)),
                    body.ty(fw.w, fw.fsigs, inner), λ env own => body.sem(fw, inner, env, own), le, lb,
                    j(lowered_e, λ r _ => FTm::ValueHolds(e, fw, base, g, ports, next, r), FTm::value_sound(e, fw, base, g, ports, next)),
                    j(lowered_body, λ r _ => FTm::LowerHolds(body, fw, base, inner, Cons(le.result, ports), le.next, r),
                        FTm::lower_sound(body, fw, base, inner, Cons(le.result, ports), le.next)))))
        },
        If(c, yes, no) => λ g ports next => FTm::arms_sound(c, yes, no, fw, base,
            λ g2 ports2 next2 => FTm::lower_sound(yes, fw, base, g2, ports2, next2), λ g2 ports2 next2 => FTm::lower_sound(no, fw, base, g2, ports2, next2),
            g, ports, next),
        IfEq(c, yes, no) => λ g ports next => FTm::ifeq_of_if(c, yes, no, fw, base, g, ports, next,
            FTm::lower(If(c, yes, no), fw.w, fw.fsigs, base, g, ports, next),
            FTm::arms_sound(c, yes, no, fw, base,
                λ g2 ports2 next2 => FTm::lower_sound(yes, fw, base, g2, ports2, next2), λ g2 ports2 next2 => FTm::lower_sound(no, fw, base, g2, ports2, next2),
                g, ports, next)),
        Put(i, length, v, body) => λ g ports next => {
            let P = λ (r: Option<Lowered>) => FTm::LowerHolds(Put(i, length, v, body), fw, base, g, ports, next, r);
            let later = next + 3;
            Option::and_then_elim(P, trivial, FTm::put_ports(g, ports, i, length, v),
                λ at => FTm::lower(body, fw.w, fw.fsigs, base, g, ports, later).and_then(λ lb => FTm::put_then(at, next, lb)), λ at found =>
            Option::and_then_elim(P, trivial, FTm::lower(body, fw.w, fw.fsigs, base, g, ports, later), λ lb => FTm::put_then(at, next, lb),
                λ lb lowered_body =>
                FTm::put_sound(fw, base, g, ports, next, i, length, v, at,
                    j(found, λ r _ => FTm::PutAtHolds(g, ports, i, length, v, r), FTm::put_ports_sound(g, ports, i, length, v)),
                    body.ty(fw.w, fw.fsigs, g), λ env own => body.sem(fw, g, env, own), lb,
                    j(lowered_body, λ r _ => FTm::LowerHolds(body, fw, base, g, ports, later, r), FTm::lower_sound(body, fw, base, g, ports, later)))))
        },
        Call(f, args, body) => λ g ports next => {
            let P = λ (r: Option<Lowered>) => FTm::LowerHolds(Call(f, args, body), fw, base, g, ports, next, r);
            let result = Sig::at(fw.fsigs, f).result;
            let inner = Cons(result, g);
            Option::and_then_elim(P, trivial, FTm::lower_call(fw.w, fw.fsigs, base, g, ports, next, f, args),
                λ lc => FTm::lower(body, fw.w, fw.fsigs, base, inner, Cons(lc.result, ports), lc.next).and_then(λ lb => Tm::compose(lc, lb)),
                λ lc lowered_call =>
            Option::and_then_elim(P, trivial, FTm::lower(body, fw.w, fw.fsigs, base, inner, Cons(lc.result, ports), lc.next), λ lb => Tm::compose(lc, lb),
                λ lb lowered_body =>
                FTm::bind_sound(fw, base, g, ports, next, result, λ env own => FTm::called(fw, g, env, f, args, own),
                    body.ty(fw.w, fw.fsigs, inner), λ env own => body.sem(fw, inner, env, own), lc, lb,
                    j(lowered_call, λ r _ => FTm::StepHolds(fw, base, g, ports, next, result, λ env own => FTm::called(fw, g, env, f, args, own), r),
                        FTm::call_sound(fw, base, g, ports, next, f, args)),
                    j(lowered_body, λ r _ => FTm::LowerHolds(body, fw, base, inner, Cons(lc.result, ports), lc.next, r),
                        FTm::lower_sound(body, fw, base, inner, Cons(lc.result, ports), lc.next)))))
        },
        Again(args) => λ g ports next => FTm::call_sound(fw, base, g, ports, next, 0, args),
        Lend(f, views, args, body) => λ g ports next => {
            let P = λ (r: Option<Lowered>) => FTm::LowerHolds(Lend(f, views, args, body), fw, base, g, ports, next, r);
            let result = Sig::at(fw.fsigs, f).result;
            let inner = Cons(result, g);
            Option::and_then_elim(P, trivial, FTm::lower_lend(fw.w, fw.fsigs, base, g, ports, next, f, views, args),
                λ lc => FTm::lower(body, fw.w, fw.fsigs, base, inner, Cons(lc.result, ports), lc.next).and_then(λ lb => Tm::compose(lc, lb)),
                λ lc lowered_lend =>
            Option::and_then_elim(P, trivial, FTm::lower(body, fw.w, fw.fsigs, base, inner, Cons(lc.result, ports), lc.next), λ lb => Tm::compose(lc, lb),
                λ lb lowered_body =>
                FTm::bind_sound(fw, base, g, ports, next, result, λ env own => FTm::lent(fw, g, env, f, views, args, own),
                    body.ty(fw.w, fw.fsigs, inner), λ env own => body.sem(fw, inner, env, own), lc, lb,
                    j(lowered_lend, λ r _ => FTm::StepHolds(fw, base, g, ports, next, result, λ env own => FTm::lent(fw, g, env, f, views, args, own), r),
                        FTm::lend_sound(fw, base, g, ports, next, f, views, args)),
                    j(lowered_body, λ r _ => FTm::LowerHolds(body, fw, base, inner, Cons(lc.result, ports), lc.next, r),
                        FTm::lower_sound(body, fw, base, inner, Cons(lc.result, ports), lc.next)))))
        },
        Loop(init, test, body, rest) => λ g ports next => FTm::loop_case_sound(fw, base, g, ports, next, init, test, body, rest,
            λ ps k => FTm::lower_sound(body, fw, base, Cons(Ty::at(g, init), g), ps, k),
            λ ps k => FTm::lower_sound(rest, fw, base, Cons(Ty::at(g, init), g), ps, k)),
    }
}

// ---------------------------------------------------------------------------
// Functions: the wrapper from FunctionIR's `Function::run`, which binds its
// parameters and answers with its result word and the file its body left,
// to the computation function's curried meaning (`FFun::meaning`). The
// parameters are words as a pure function's are (`Fun::lower`), the span's
// place and length among them.

fn FFun::context(self f: FFun) → List<Ty> { Ty::bind_onto(f.params, Nil) }

fn FFun::lower_typed(self f: FFun, w: World, fsigs: List<Sig>, c: Lowered) → Option<Function> {
    f.body.ty(w, fsigs, f.context()).check(f.result).and_then(λ _ => Some(Function(Fun::param_ids(f.params, 0), c.region, c.result, lent := f.lent)))
}

fn FFun::lower_body(self f: FFun, w: World, fsigs: List<Sig>, base: Nat) → Option<Function> {
    f.body.lower(w, fsigs, base, f.context(), Fun::ports_onto(f.params, 0, Nil), Fun::past(f.params, 0)).and_then(λ c => f.lower_typed(w, fsigs, c))
}

fn FFun::lower_distinct(self f: FFun, w: World, fsigs: List<Sig>, base: Nat) → Option<Function> {
    Tm::check_true(distinct(Fun::param_ids(f.params, 0))).and_then(λ _ => f.lower_body(w, fsigs, base))
}

fn FFun::lower_result(self f: FFun, w: World, fsigs: List<Sig>, base: Nat) → Option<Function> {
    f.result.check_one_word(w.tys).and_then(λ _ => f.lower_distinct(w, fsigs, base))
}

// A computation function of words to a word, lowered to a FunctionIR
// function that writes its first lent buffer.
fn FFun::lower(self f: FFun, w: World, fsigs: List<Sig>, base: Nat) → Option<Function> {
    Ty::check_one_words(w.tys, f.params).and_then(λ _ => f.lower_result(w, fsigs, base))
}

// A curried computation answers like a function on words that ends, on
// every word list, as its uncurried form does.
theorem FFun::curry_answers(tys: Nat → RecInfo, r: Ty, rest: List<List<BitVec(8)>>, ps: List<Ty>): (g: List<Ty>) → (env: Env(tys, g)) →
    (k: Env(tys, Ty::bind_onto(ps, g)) → Mutated<List<BitVec(8)>, r.sem(tys)>) → (ans: List<BitVec(64)> → Ending) →
    ((xs: List<BitVec(64)>) → ans(xs) = FTm::ended(tys, r, rest, k(Ty::extend(tys, ps, g, env, xs)))) →
    FTm::Answers(tys, ps, r, rest, FFun::curry(tys, r, ps, g, env, k), ans) {
    match ps {
        Nil => λ g env k ans h => h(Nil),
        Cons(p, later) => λ g env k ans h => λ x =>
            FFun::curry_answers(tys, r, rest, later, Cons(p, g), Pair(Ty::cast(tys, Word(64), p, x), env), k, λ ws => ans(Cons(x, ws)),
                λ ws => h(Cons(x, ws))),
    }
}

// What a function's lowering promises: run on any words over any file
// `Cons(own, rest)`, with calls answered by the program, it answers with
// its meaning's value and leaves its meaning's span over the rest. As for
// a pure function lent spans (`Fun::LowerHolds`), nothing is asked of the
// words that are the span's place and length: the meaning writes under the
// length word it is handed, as the code does.
fn FFun::LowerHolds(self f: FFun, fw: FWorld, base: Nat, r: Option<Function>) → Type {
    match r {
        None => True,
        Some(code) => (call: Writers()) → FTm::CallsAgree(fw, base, call) → (own: List<BitVec(8)>) →
            FTm::Answers(fw.w.tys, f.params, f.result, fw.rest, f.meaning(fw, own), λ xs => code.run(call, xs, Cons(own, fw.rest))),
    }
}

theorem FFun::lower_sound(self f: FFun, fw: FWorld, base: Nat): f.LowerHolds(fw, base, f.lower(fw.w, fw.fsigs, base)) {
    let tys = fw.w.tys;
    let P = λ (r: Option<Function>) => f.LowerHolds(fw, base, r);
    let ids = Fun::param_ids(f.params, 0);
    let ports = Fun::ports_onto(f.params, 0, Nil);
    let next = Fun::past(f.params, 0);
    let body_ty = f.body.ty(fw.w, fw.fsigs, f.context());
    Option::and_then_elim(P, trivial, Ty::check_one_words(tys, f.params), λ _ => f.lower_result(fw.w, fw.fsigs, base), λ ok _ =>
    Option::and_then_elim(P, trivial, f.result.check_one_word(tys), λ _ => f.lower_distinct(fw.w, fw.fsigs, base), λ er _ =>
    Option::and_then_elim(P, trivial, Tm::check_true(distinct(ids)), λ _ => f.lower_body(fw.w, fw.fsigs, base), λ apart _ =>
    Option::and_then_elim(P, trivial, f.body.lower(fw.w, fw.fsigs, base, f.context(), ports, next), λ c => f.lower_typed(fw.w, fw.fsigs, c), λ c lowered =>
    Option::and_then_elim(P, trivial, body_ty.check(f.result), λ _ => Some(Function(ids, c.region, c.result, lent := f.lent)), λ eb _ =>
        λ call agree own => FFun::curry_answers(tys, f.result, fw.rest, f.params, Nil, trivial,
            λ env => FTm::recast(tys, body_ty, f.result, f.body.sem(fw, f.context(), env, own)),
            λ xs => Function(ids, c.region, c.result, lent := f.lent).run(call, xs, Cons(own, fw.rest)), λ xs => {
                let values = Valuation::bind(Valuation::zero(), ids, xs);
                let env = Ty::extend(tys, f.params, Nil, trivial, xs);
                let end = c.region.run(call, values, Cons(own, fw.rest));
                let m = f.body.sem(fw, f.context(), env, own);
                let ran = j(lowered, λ r _ => FTm::LowerHolds(f.body, fw, base, f.context(), ports, next, r),
                    FTm::lower_sound(f.body, fw, base, f.context(), ports, next))(call, agree, values, env, own,
                    Fun::env_extend_holds(tys, values, f.params, Nil, Nil, trivial, 0, xs, ok, trivial, Fun::bind_bound(ids, xs, apart)),
                    Fun::below_onto(tys, f.params, Nil, 0, Nil, ok, trivial));
                eq2(λ (word: BitVec(64)) (left: Buffers()) => Ending(word, left),
                    Ty::one_word_reads(tys, end.values, c.result, f.result, er, Ty::cast(tys, body_ty, f.result, m.value),
                        Ty::cast_holds(tys, end.values, c.result, body_ty, f.result, eb, m.value, ran.right.right.right.left)),
                    ran.right.right.right.right)
            }))))))
}

// The arena's windows as typed handles (docs/language/ownership-design.md
// §10.7 and §13.4, issues/ownership-stores-and-keys.md): a window is a key
// into a store of claims kept beside the arena, and its validity is a
// proposition about that store and the key. The arena's functions and laws
// (`arena.hthr`, `arena_laws.hthr`) are unchanged; this module reads them
// through the handles.
//
// - **A heap** is the laid `Arena` and, beside it, erased state: the claims
//   (a `Store<Claim>` of the windows handed out and not yet reset away)
//   and the invariant tying them to the arena (`HeapInv`: every claim below
//   the top, the top within the limit and the heap, two claims of different
//   slots apart). The erased part has no run-time presence: it is what a
//   proof about the arena reads, never what compiled code does.
// - **A window** is its two words and a key. It is valid where the key's
//   partial read answers the window it says (`Heap::Valid`), the store's
//   validity with the words agreeing.
// - `read` and `store` take a proof of validity (found by `known`) where
//   `Arena::read` and `Arena::store` took a proof that the window is inside
//   the heap, which validity gives (`Heap::fits`). Two valid windows of
//   different keys are apart (`valid_apart`), so `store_apart` needs no
//   `Apart` premise: a store through one changes no read of the other.
// - `alloc` answers a valid window (`alloc_valid`) and keeps every valid
//   window valid and reading what it read (`alloc_keeps`, `alloc_reads_kept`).
// - `reset` ends every window above its mark (`reset_ends`) and keeps those
//   below it (`reset_keeps`). A window kept past the reset that ended it
//   has no proof of validity, so its use is a refused obligation: the
//   negative control (lib/_tests/native/runtime/arena_handles_tests.hthr)
//   that `stale_windows_meet` was as an `Apart` theorem only.
//
// Why the erased state is a field beside the laid record, not a parameter
// of its type (design note §13.4): a `mut self` method answers
// `Mutated<Self, R>`, whose `after` has the receiver's own type, so a
// parameter the method changes (a generation, the set of claims) cannot be
// said; and the claims record history (which allocation a window came from),
// which no function of the arena's words recovers.
import logic;
import bool;
import nat;
import list;
import option;
import pair;
import vector;
import algebra;
import omega;
import bitvec_nat;
import bitvec_omega;
import runtime_data;
import arena;
import arena_laws;
import store;

// The words a window claims: `count` from `base`.
record Claim { base: Nat, count: Nat }

fn Claim::below(self c: Claim, mark: Nat) → Bool { (c.base + c.count).leb(mark) }

// The claims agree with the arena: each below the top, the top within the
// limit and the heap, and two of different slots apart.
record HeapInv(a: Arena, claims: Store<Claim>) {
    limit: a.limit.toNat() <= 16,
    top: a.top.toNat() <= a.limit.toNat(),
    below: (k: Key) → (c: Claim) → claims.get(k) = Some(c) → c.base + c.count <= a.top.toNat(),
    apart: (k1, k2: Key) → (c1, c2: Claim) → claims.get(k1) = Some(c1) → claims.get(k2) = Some(c2) → ¬(k1.index = k2.index) →
        Arena::Apart(c1.base, c1.count, c2.base, c2.count),
}

// The arena and its claims; `claims` and `ok` are erased.
record Heap { arena: Arena, claims: Store<Claim>, ok: HeapInv(arena, claims) }

// A window: its two words, and the key it was handed out under (erased).
record Window { base: u64, count: u64, key: Key }

fn Window::claim(self w: Window) → Claim { Claim(w.base.toNat(), w.count.toNat()) }

// A window is valid where its key's partial read answers the window.
fn Heap::Valid(self h: Heap, w: Window) → Type { h.claims.get(w.key) = Some(w.claim()) }

theorem Heap::key_valid(self h: Heap, w: Window, valid: h.Valid(w)): h.claims.Valid(w.key) {
    j(sym(valid), λ o _ => o.is_some().IsTrue(), trivial)
}

theorem Heap::inside(self h: Heap, w: Window, valid: h.Valid(w)): w.base.toNat() + w.count.toNat() <= h.arena.top.toNat() {
    h.ok.below(w.key, w.claim(), valid)
}

theorem Heap::fits(self h: Heap, w: Window, valid: h.Valid(w)): w.base.toNat() + w.count.toNat() <= 16 {
    let i = h.inside(w, valid);
    let t = h.ok.top;
    let l = h.ok.limit;
    omega(i, t, l)
}

// Two valid windows of different keys share no word.
theorem Heap::valid_apart(self h: Heap, w1, w2: Window, valid1: h.Valid(w1), valid2: h.Valid(w2), other: ¬(w1.key.index = w2.key.index)):
    Arena::Apart(w1.base.toNat(), w1.count.toNat(), w2.base.toNat(), w2.count.toNat())
{
    h.ok.apart(w1.key, w2.key, w1.claim(), w2.claim(), valid1, valid2, other)
}

// ---------------------------------------------------------------------------
// Reading and storing through a valid window

fn Heap::read(self h: Heap, w: Window, i: u64, valid: h.Valid(w) := known, inside: ∥i.toNat() < w.count.toNat()∥ := bv_omega) → u64 {
    Arena::read(h.arena, w.base, w.count, i, inside := inside, fits := squash(h.fits(w, valid)))
}

fn Heap::store(self h: Heap, w: Window, i, x: u64, valid: h.Valid(w) := known, inside: ∥i.toNat() < w.count.toNat()∥ := bv_omega) → Heap {
    Heap(Arena::store(h.arena, w.base, w.count, i, x, inside := inside, fits := squash(h.fits(w, valid))), h.claims,
        HeapInv(h.ok.limit, h.ok.top, h.ok.below, h.ok.apart))
}

// A store keeps every window's validity: the claims are as they were.
theorem Heap::store_keeps<V>(self h: Heap, w: Window, i, x: u64, valid: h.Valid(w), li: i.toNat() < w.count.toNat(), w2: Window, valid2: h.Valid(w2)):
    h.store(w, i, x, valid := valid).Valid(w2)
{
    valid2
}

// `store_apart` over handles: a store through one valid window changes no
// read through a valid window of another key.
theorem Heap::store_apart(self h: Heap, w: Window, i, x: u64, w2: Window, k: u64, valid: h.Valid(w), valid2: h.Valid(w2),
    li: i.toNat() < w.count.toNat(), lk: k.toNat() < w2.count.toNat(), other: ¬(w.key.index = w2.key.index)):
    h.store(w, i, x, valid := valid).read(w2, k, valid := valid2) = h.read(w2, k, valid := valid2)
{
    Arena::store_apart(h.arena, w.base, w.count, i, x, w2.base, w2.count, k, li, h.fits(w, valid), lk, h.fits(w2, valid2),
        h.valid_apart(w, w2, valid, valid2, other))
}

// The window stored through reads back what was stored.
theorem Heap::read_store_same(self h: Heap, w: Window, i, x: u64, valid: h.Valid(w), li: i.toNat() < w.count.toNat()):
    h.store(w, i, x, valid := valid).read(w, i, valid := valid) = x
{
    Arena::read_store_same(h.arena, w.base, w.count, i, x, li, h.fits(w, valid))
}

// ---------------------------------------------------------------------------
// Allocation

// What an allocation answers: a window, or that there is no room.
inductive Grant { Granted(window: Window), NoRoom }

fn Grant::window_or(self g: Grant, d: Window) → Window { match g { Granted(w) => w, NoRoom => d } }

fn Heap::claimed(self h: Heap, base, size: u64) → Mutated<Store<Claim>, Key> { Store::alloc(h.claims, Claim(base.toNat(), size.toNat())) }

theorem Heap::alloc_inv(self h: Heap, size, base: u64, got: Arena::alloc(h.arena, size).value = Got(base)):
    HeapInv(Arena::alloc(h.arena, size).after, Heap::claimed(h, base, size).after)
{
    let a = h.arena;
    let fresh = Arena::alloc_fresh(a, size, base, got);
    let at: (base.toNat() = a.top.toNat()) = cong_fn(λ (x: u64) => x.toNat(), fresh.left);
    let room: (a.top.toNat() + size.toNat() <= a.limit.toNat()) = fresh.right.left;
    let moved: (Arena::alloc(a, size).after.top.toNat() = a.top.toNat() + size.toNat()) = fresh.right.right.right;
    let lim: (Arena::alloc(a, size).after.limit.toNat() = a.limit.toNat()) = cong_fn(λ (x: u64) => x.toNat(), Arena::alloc_limit(a, size));
    let fresh_c = Claim(base.toNat(), size.toNat());
    let below: ((k: Key) → (c: Claim) → Heap::claimed(h, base, size).after.get(k) = Some(c) → c.base + c.count <= Arena::alloc(a, size).after.top.toNat()) =
        λ k c e => match Store::alloc_get_cases(h.claims, fresh_c, k, c, e) {
            Inl(new) => {
                let cb: (c.base = base.toNat()) = cong_fn(λ (d: Claim) => d.base, new.right);
                let cc: (c.count = size.toNat()) = cong_fn(λ (d: Claim) => d.count, new.right);
                omega(cb, cc, at, moved)
            },
            Inr(old) => { let o = h.ok.below(k, c, old); omega(o, moved) },
        };
    HeapInv(omega(lim, h.ok.limit), omega(lim, moved, room), below, λ k1 k2 c1 c2 e1 e2 ne =>
        match Store::alloc_get_cases(h.claims, fresh_c, k1, c1, e1) {
            Inl(new1) => match Store::alloc_get_cases(h.claims, fresh_c, k2, c2, e2) {
                Inl(new2) => false_elim(ne(trans(new1.left, sym(new2.left)))),
                Inr(old2) => {
                    let o = h.ok.below(k2, c2, old2);
                    let cb: (c1.base = base.toNat()) = cong_fn(λ (d: Claim) => d.base, new1.right);
                    Inr(omega(o, cb, at))
                },
            },
            Inr(old1) => match Store::alloc_get_cases(h.claims, fresh_c, k2, c2, e2) {
                Inl(new2) => {
                    let o = h.ok.below(k1, c1, old1);
                    let cb: (c2.base = base.toNat()) = cong_fn(λ (d: Claim) => d.base, new2.right);
                    Inl(omega(o, cb, at))
                },
                Inr(old2) => h.ok.apart(k1, k2, c1, c2, old1, old2, ne),
            },
        })
}

theorem Heap::full_inv(self h: Heap, size: u64, full: Arena::alloc(h.arena, size).value = Full): HeapInv(Arena::alloc(h.arena, size).after, h.claims) {
    j(sym(Arena::alloc_full_same(h.arena, size, full)), λ b _ => HeapInv(b, h.claims), h.ok)
}

// The allocation with the arena's answer and its equation as parameters, so
// a proof about it cases on the answer (`When::of_bit`'s reason).
fn Heap::alloc_by(self h: Heap, size: u64, r: Alloc, e: Arena::alloc(h.arena, size).value = r) → Mutated<Heap, Grant> {
    match r as λ q => (Arena::alloc(h.arena, size).value = q → Mutated<Heap, Grant>) {
        Got(base) => λ e => Mutated(Heap(Arena::alloc(h.arena, size).after, Heap::claimed(h, base, size).after, h.alloc_inv(size, base, e)),
            Granted(Window(base, size, Heap::claimed(h, base, size).value))),
        Full => λ e => Mutated(Heap(Arena::alloc(h.arena, size).after, h.claims, h.full_inv(size, e)), NoRoom),
    }(e)
}

fn Heap::alloc(self h: Heap, size: u64) → Mutated<Heap, Grant> { Heap::alloc_by(h, size, Arena::alloc(h.arena, size).value, refl) }

// A statement of every allocation's two outcomes holds of the allocation.
theorem Heap::alloc_cases(self h: Heap, size: u64, M: Mutated<Heap, Grant> → Type,
    got: (base: u64) → (e: Arena::alloc(h.arena, size).value = Got(base)) →
        M(Mutated(Heap(Arena::alloc(h.arena, size).after, Heap::claimed(h, base, size).after, h.alloc_inv(size, base, e)), Granted(Window(base, size, Heap::claimed(h, base, size).value)))),
    full: (e: Arena::alloc(h.arena, size).value = Full) → M(Mutated(Heap(Arena::alloc(h.arena, size).after, h.claims, h.full_inv(size, e)), NoRoom))):
    M(Heap::alloc(h, size))
{
    match Arena::alloc(h.arena, size).value as λ q => ((e: Arena::alloc(h.arena, size).value = q) → M(Heap::alloc_by(h, size, q, e))) {
        Got(base) => λ e => got(base, e),
        Full => λ e => full(e),
    }(refl)
}

// `alloc_valid`: a window granted is valid.
theorem Heap::alloc_valid(self h: Heap, size: u64, w: Window, granted: Heap::alloc(h, size).value = Granted(w)): Heap::alloc(h, size).after.Valid(w) {
    h.alloc_cases(size, λ m => m.value = Granted(w) → m.after.Valid(w),
        λ base e g => {
            let at: (Window(base, size, Heap::claimed(h, base, size).value) = w) = cong_fn(λ (x: Grant) => x.window_or(w), g);
            j(at, λ v _ => Heap::claimed(h, base, size).after.get(v.key) = Some(v.claim()), Store::alloc_reads(h.claims, Claim(base.toNat(), size.toNat())))
        },
        λ e g => absurd(g))(granted)
}

// Every window valid before an allocation is valid after it.
theorem Heap::alloc_keeps(self h: Heap, size: u64, w: Window, valid: h.Valid(w)): Heap::alloc(h, size).after.Valid(w) {
    h.alloc_cases(size, λ m => m.after.Valid(w),
        λ base e => trans(Store::alloc_keeps(h.claims, Claim(base.toNat(), size.toNat()), w.key, h.key_valid(w, valid)), valid),
        λ e => valid)
}

// The window granted has a key of its own: no window valid before shares
// its slot.
theorem Heap::alloc_other_key(self h: Heap, size: u64, w: Window, granted: Heap::alloc(h, size).value = Granted(w), w2: Window, valid2: h.Valid(w2)):
    ¬(w2.key.index = w.key.index)
{
    Heap::alloc_cases(h, size, λ m => m.value = Granted(w) → ¬(w2.key.index = w.key.index),
        λ base e g => {
            let at: (Window(base, size, Heap::claimed(h, base, size).value) = w) = cong_fn(λ (x: Grant) => x.window_or(w), g);
            j(at, λ v _ => ¬(w2.key.index = v.key.index), Store::alloc_index_fresh(h.claims, Claim(base.toNat(), size.toNat()), w2.key, h.key_valid(w2, valid2)))
        },
        λ e g => absurd(g))(granted)
}

// And reads what it read: an allocation changes no word of the heap.
theorem Heap::alloc_heap(self h: Heap, size: u64): Heap::alloc(h, size).after.arena.heap = h.arena.heap {
    h.alloc_cases(size, λ m => m.after.arena.heap = h.arena.heap, λ base e => Arena::alloc_below(h.arena, size), λ e => Arena::alloc_below(h.arena, size))
}

theorem Heap::alloc_reads_kept(self h: Heap, size: u64, w: Window, k: u64, valid: h.Valid(w), lk: k.toNat() < w.count.toNat()):
    Heap::alloc(h, size).after.read(w, k, valid := h.alloc_keeps(size, w, valid)) = h.read(w, k, valid := valid)
{
    Arena::read_same(Heap::alloc(h, size).after.arena, h.arena, w.base, w.count, k, lk, h.fits(w, valid),
        λ q _ _ => cong_fn(λ (v: [u64; 16]) => vector_get(v, q, BitVec::ofNat(0)), h.alloc_heap(size)))
}

// ---------------------------------------------------------------------------
// Reset

fn Heap::kept(mark: u64) → Claim → Bool { λ (c: Claim) => c.below(mark.toNat()) }

theorem Heap::reset_inv(self h: Heap, mark: u64): HeapInv(Arena::reset(h.arena, mark).after, h.claims.retain(Heap::kept(mark))) {
    let a = h.arena;
    let lim: (Arena::reset(a, mark).after.limit.toNat() = a.limit.toNat()) = cong_fn(λ (x: u64) => x.toNat(), Arena::reset_limit(a, mark));
    let top: (Arena::reset(a, mark).after.top.toNat() <= a.top.toNat()) = match Arena::reset_top_cases(a, mark) {
        Inl(at) => { let m: (Arena::reset(a, mark).after.top.toNat() = mark.toNat()) = cong_fn(λ (x: u64) => x.toNat(), at.left); let ok: (mark.toNat() <= a.top.toNat()) = at.right; omega(m, ok) },
        Inr(same) => { let m: (Arena::reset(a, mark).after.top.toNat() = a.top.toNat()) = cong_fn(λ (x: u64) => x.toNat(), same); omega(m) },
    };
    HeapInv(omega(lim, h.ok.limit), { let t = h.ok.top; omega(lim, top, t) },
        λ k c e => {
            let kept = h.claims.retain_some(Heap::kept(mark), k, c, e);
            let o = h.ok.below(k, c, kept.left);
            let under: (c.base + c.count <= mark.toNat()) = (c.base + c.count).leb_sound(mark.toNat(), Bool::is_true_of_eq(kept.right));
            match Arena::reset_top_cases(a, mark) {
                Inl(at) => { let m: (Arena::reset(a, mark).after.top.toNat() = mark.toNat()) = cong_fn(λ (x: u64) => x.toNat(), at.left); omega(m, under) },
                Inr(same) => { let m: (Arena::reset(a, mark).after.top.toNat() = a.top.toNat()) = cong_fn(λ (x: u64) => x.toNat(), same); omega(m, o) },
            }
        },
        λ k1 k2 c1 c2 e1 e2 ne => h.ok.apart(k1, k2, c1, c2, h.claims.retain_some(Heap::kept(mark), k1, c1, e1).left, h.claims.retain_some(Heap::kept(mark), k2, c2, e2).left, ne))
}

// Back to a mark: the arena's top moved there (where the mark is at most
// the top), and every claim that ends past the mark released.
fn Heap::reset(self h: Heap, mark: u64) → Mutated<Heap, u64> {
    Mutated(Heap(Arena::reset(h.arena, mark).after, h.claims.retain(Heap::kept(mark)), h.reset_inv(mark)), Arena::reset(h.arena, mark).value)
}

// `reset_ends`: a window that ends past the mark is not valid after it.
theorem Heap::reset_ends(self h: Heap, mark: u64, w: Window, above: mark.toNat() < w.base.toNat() + w.count.toNat()): ¬Heap::reset(h, mark).after.Valid(w) {
    λ valid => {
        let kept = h.claims.retain_some(Heap::kept(mark), w.key, w.claim(), valid);
        let under: (w.base.toNat() + w.count.toNat() <= mark.toNat()) = (w.base.toNat() + w.count.toNat()).leb_sound(mark.toNat(), Bool::is_true_of_eq(kept.right));
        omega(under, above)
    }
}

// `reset_keeps`: a valid window that ends at or below the mark stays valid,
// and reads what it read (a reset changes no word of the heap).
theorem Heap::reset_keeps(self h: Heap, mark: u64, w: Window, valid: h.Valid(w), under: w.base.toNat() + w.count.toNat() <= mark.toNat()): Heap::reset(h, mark).after.Valid(w) {
    let keep: (w.claim().below(mark.toNat()) = True) = (w.base.toNat() + w.count.toNat()).leb_true(mark.toNat(), under);
    trans(h.claims.retain_get(Heap::kept(mark), w.key),
        trans(cong_fn(λ (o: Option<Claim>) => o.and_then(λ (u: Claim) => u.below(mark.toNat()).then(Some(u))), valid),
            cong_fn(λ (b: Bool) => b.then(Some(w.claim())), keep)))
}

theorem Heap::reset_reads_kept(self h: Heap, mark: u64, w: Window, k: u64, valid: h.Valid(w), under: w.base.toNat() + w.count.toNat() <= mark.toNat(),
    lk: k.toNat() < w.count.toNat()):
    Heap::reset(h, mark).after.read(w, k, valid := h.reset_keeps(mark, w, valid, under)) = h.read(w, k, valid := valid)
{
    Arena::read_same(Heap::reset(h, mark).after.arena, h.arena, w.base, w.count, k, lk, h.fits(w, valid),
        λ q _ _ => cong_fn(λ (v: [u64; 16]) => vector_get(v, q, BitVec::ofNat(0)), Arena::reset_heap(h.arena, mark)))
}

// The reflector for functions of a laid record: a function from a record
// `T` laid over bytes (`laid record T`, lib/std/machine/laid.hthr) to
// `Mutated<T, R>`, read from its elaborated body as the `FFun` of the
// function over the span that holds the record
// (docs/layout-design.md §9.2, §9.5 round 3).
//
// The source is the kernel type a `mut self` method on the record has,
// `fn T::m(mut self t: T, x: u64, …) → R`, or the same function written
// out, returning `Mutated(t, value)` itself. The code takes the span's
// place and its 64-bit length word, then the words, as every function
// over a span does (`rt_file_reflect`).
//
// The body is read as the elaborator built it, under the record's own
// local `t`. A read of a field, `t.f`, stands for its accessor's read of
// the span at the field's offset (`Known.named`): the accessor is the one
// of the field's codec, found by resolution (`Accessor(codec)`,
// `stored_accessor.hthr`), and nothing is compiled per field. The pure
// walk reflects a field's read where the field is first read, so a field
// the function does not read is not read. A body ends in
// `Mutated(T(e₁, …, eₙ), value)`, in `Mutated(t, value)`, or in a `match`
// on a `Bool` whose arms do. At such an end the reflector:
//
// 1. reflects each field's new value that is not the field itself, and
//    the value, as pure `rt` over the span as it came in;
// 2. emits one call of the field's accessor's writer for each field that
//    changed, in the record's order, the offset a literal bound just
//    before it;
// 3. answers the value.
//
// So the code reads the fields it needs, computes, and stores the fields
// that changed. Whether a field changed is read off the term: a field
// whose new value is the read of that field is not stored.
//
// Untrusted like every producer: what a `runtime fn` of a record
// publishes is the pin of this reflection's held meaning
// (`FTm::held`, rt_held.hthr) to the function, by conversion, and a wrong
// reflection fails it.
import logic;
import bool;
import nat;
import list;
import list_window;
import option;
import pair;
import char;
import string;
import tactic;
import derive;
import bitvec;
import rt;
import rt_file;
import rt_reflect;
import rt_file_reflect;

// A field's accessor as the walk carries it: the globals of the reader
// and the writer its codec's `Accessor` names, and the terms a
// generator states the field's promises with (its type, its part, its
// codec and the instance).
record HeldAccess { reader: Nat, writer: GlobalRef, writer_name: String, wide: Expr, ty: Expr, part: Expr, codec: Expr, instance: Expr }

// An array field whose elements' codec has an accessor: what its
// elements stand for where they are read (`ElementTerm`), the accessor's
// globals and terms, its element's type and count, the field as a term
// of the record's local, and the terms an element's part and an entry of
// a vector are built by (each applied to an index and `trivial`).
record HeldEach { term: ElementTerm, reader: Nat, writer: GlobalRef, writer_name: String, wide: Expr, ty: Expr, codec: Expr, instance: Expr,
    own: Expr, then_of: Expr, element_of: Expr, index_of: Expr, inside: Expr }

// A field: its name, where it lies (the word `T::f_at`), its accessor,
// if its codec has one, and its elements' if it is an array of words.
record HeldField { name: String, at: Handle, access: Option<HeldAccess>, each: Option<HeldEach> }

// The part of element `i`, and its accessor.
fn HeldEach::part(self e: HeldEach, i: Nat) → Expr { App(e.then_of, App(App(e.element_of, NatLit(i)), e.inside)) }

fn HeldEach::access(self e: HeldEach, i: Nat) → HeldAccess { HeldAccess(e.reader, e.writer, e.writer_name, e.wide, e.ty, e.part(i), e.codec, e.instance) }

// Entry `i` of a vector of the field's type.
fn HeldEach::entry(self e: HeldEach, v: Expr, i: Nat) → Expr { App(App(App(e.index_of, v), NatLit(i)), e.inside) }

// A function of a laid record after it was walked: its reflection, the
// program's pure functions and computations, the record and its fields,
// how many words it takes beside the record, and whether it changes the
// record or only reads it.
record HeldReflected { reflected: FFun, funs: List<Nat>, cfuns: List<Nat>, record: Handle, record_name: String, stored: GlobalRef, fields: List<HeldField>,
    operands: Nat, changes: Bool }

// A term applied to arguments.
fn rt_ap(f: Expr, args: List<Expr>) → Expr { args.foldl(λ acc a => App(acc, a), f) }

fn rt_held_ends<A>() → Tac<A> {
    rt_refuse("a function of a laid record ends in `Mutated(record, value)`, or in a `match` on a `Bool` whose arms do")
}

// The accessor of a field's codec: the instance `Accessor<B>(codec)`, by
// the search an instance argument runs, and the functions it names, read
// at the span, its length word and the field's offset; and beside it
// what a read of the field stands for, the accessor's read there at the
// field's own width. `None` where the codec has no instance (an array, a
// record inside the record).
// The accessor of the codec a part stores by, if it has one: the
// accessor's globals and terms, its read and its narrowing as terms to
// apply (to an offset, and to the word read), and the part's value read
// at `at`.
record HeldCodec { reader: Nat, writer: GlobalRef, writer_name: String, wide: Expr, codec: Expr, instance: Expr, read: Expr, narrow: Expr, value: Handle }

fn rt_held_codec(what: String, ty: Handle, part: Expr, span, length: Expr, at: Expr) → Tac<Option<HeldCodec>> {
    let stores <- lookup("Part::stores").bind(λ c => rt_accepted("a part's codec (import `part`)", c));
    let codec = rt_ap(Global(stores), [Blank, Hd(ty), Blank, part]);
    let class <- lookup("Accessor").bind(λ c => rt_accepted("the class of a codec's accessor (import `stored_accessor`)", c));
    let goal <- as_type(rt_ap(Global(class), [Hd(ty), codec])).bind(λ c => rt_accepted("the accessor of " ++ what ++ "'s codec", c));
    let found <- synth(goal);
    match found {
        Refused(_) => pure(None),
        Accepted(inst) => {
            let read <- lookup("Stored::word_read").bind(λ c => rt_accepted("an accessor's read", c));
            let write <- lookup("Stored::word_write").bind(λ c => rt_accepted("an accessor's store", c));
            let wide <- lookup("Stored::word_of").bind(λ c => rt_accepted("an accessor's word of a value", c));
            let narrow <- lookup("Stored::of_word").bind(λ c => rt_accepted("an accessor's value of a word", c));
            let of: List<Expr> = [Hd(ty), codec, Hd(inst)];
            let reads = rt_ap(Global(read), of ++ [span, length]);
            let narrows = rt_ap(Global(narrow), of);
            let rd <- next_spelling(App(reads, at)).bind(λ c => rt_accepted("an accessor's read", c));
            let wr <- next_spelling(rt_ap(Global(write), of ++ [span, length, at, length])).bind(λ c => rt_accepted("an accessor's store", c));
            let value <- next_spelling(App(narrows, Hd(rd))).bind(λ c => rt_accepted("an accessor's read at its field's width", c));
            let rv <- view(rd);
            let wv <- view(wr);
            match rv {
                HGlobal(rg, _, _) => match wv {
                    HGlobal(wg, wname, _) => pure(Some(HeldCodec(rg.id, wg, wname, rt_ap(Global(wide), of), codec, Hd(inst), reads, narrows, value))),
                    _ => rt_refuse("the accessor of " ++ what ++ "'s codec does not store by a function of the program"),
                },
                _ => rt_refuse("the accessor of " ++ what ++ "'s codec does not read by a function of the program"),
            }
        },
    }
}

// An array's element type and its length, where a field's type is one.
fn rt_held_array(ty: Handle) → Tac<Option<Pair<Handle, Handle>>> {
    let v <- view(ty);
    let found: Option<Pair<Handle, Handle>> = match v {
        HGlobal(_, name, args) => match Known::str_same(rt_base_name(name), "Vec") {
            False => None,
            True => args.nth(0).and_then(λ element => args.nth(1).map(λ length => Pair(element, length))),
        },
        _ => None,
    };
    pure(found)
}

// A field of a term, among its projections.
fn rt_held_projection(fname: String, ps: List<FieldProj>) → Tac<Handle> {
    match ps {
        Nil => rt_refuse("the field `" ++ fname ++ "` is not a projection of its record"),
        Cons(p, rest) => match Known::str_same(p.name, fname) { True => pure(p.term), False => rt_held_projection(fname, rest) },
    }
}

// The codec of an array field's elements: the field's codec read through
// its definitions to `Stored::array` of it.
fn rt_held_element_codec(fuel: Nat, fname: String, e: Expr) → Tac<Handle> {
    let no = "the codec of the array field `" ++ fname ++ "` is not `Stored::array` of its element's";
    match fuel {
        Zero => rt_refuse(no),
        Succ(f) => {
            let h <- next_spelling(e).bind(λ c => rt_accepted(no, c));
            let v <- view(h);
            let found: Option<Handle> = match v {
                HGlobal(_, name, args) => match Known::str_same(rt_base_name(name), "array") { True => args.nth(0), False => None },
                _ => None,
            };
            match found { Some(c) => pure(c), None => rt_held_element_codec(f, fname, Hd(h)) }
        },
    }
}

// The elements of an array field, where their codec has an accessor.
// Where element `i` lies is the place of its part: the field's, then the
// element's in the array.
fn rt_held_each(tname: String, fname: String, record: LocalInfo, stored: GlobalRef, part: Expr, element: Handle, length: Handle, span, len: Expr) → Tac<Option<HeldEach>> {
    let count <- rt_literal(length);
    let then_g <- lookup("Part::then").bind(λ c => rt_accepted("a part of a part (import `part`)", c));
    let element_g <- lookup("Part::element").bind(λ c => rt_accepted("an array's element as a part (import `part`)", c));
    let place_g <- lookup("Part::place").bind(λ c => rt_accepted("where a part lies (import `part`)", c));
    let index_g <- lookup("vector_index").bind(λ c => rt_accepted("an entry of a vector (import `vector`)", c));
    let projected <- fields(Local(record.ref)).bind(λ c => rt_accepted("the fields of `" ++ tname ++ "`", c));
    let own <- rt_held_projection(fname, projected.fields);
    let inside <- resolve("trivial").bind(λ c => rt_accepted("`trivial`", c));
    let stores <- lookup("Part::stores").bind(λ c => rt_accepted("a part's codec (import `part`)", c));
    let codec <- rt_held_element_codec(8, fname, rt_ap(Global(stores), [Blank, Blank, Blank, part]));
    let then_of = rt_ap(Global(then_g), [Hd(record.ty), Blank, Hd(element), Global(stored), part]);
    let element_of = rt_ap(Global(element_g), [Hd(element), Hd(codec), Hd(length)]);
    let part_of: Nat → Expr = λ i => App(then_of, App(App(element_of, NatLit(i)), Hd(inside)));
    let place_of: Nat → Expr = λ i => rt_ap(Global(place_g), [Hd(record.ty), Hd(element), Global(stored), part_of(i)]);
    match count {
        Zero => pure(None),
        Succ(more) => {
            let base <- numeral(place_of(0)).bind(λ c => rt_accepted("where the array field `" ++ fname ++ "` begins", c));
            let next: Tac<Nat> = match more { Zero => pure(base), Succ(_) => numeral(place_of(1)).bind(λ c => rt_accepted("where the second element of `" ++ fname ++ "` lies", c)) };
            let second <- next;
            let of_nat <- lookup("BitVec::ofNat").bind(λ c => rt_accepted("`BitVec::ofNat`", c));
            let found <- rt_held_codec("an element of field `" ++ fname ++ "`", element, part_of(0), span, len, rt_ap(Global(of_nat), [NatLit(64), NatLit(base)]));
            pure(found.map(λ c => HeldEach(ElementTerm(count, base, second - base, c.read, c.narrow), c.reader, c.writer, c.writer_name, c.wide, Hd(element), c.codec, c.instance,
                Hd(own), then_of, element_of, rt_ap(Global(index_g), [Hd(element), Hd(length)]), Hd(inside))))
        },
    }
}

// The fields of the record, and what a read of each stands for.
record HeldFields { fields: List<HeldField>, named: List<FieldTerm> }

fn rt_held_fields(tname: String, record: LocalInfo, stored: GlobalRef, fs: List<FieldInfo>, span, length: Expr) → Tac<HeldFields> {
    match fs {
        Nil => pure(HeldFields([], [])),
        Cons(f, rest) => match f.ty {
            None => rt_refuse("a field of `" ++ tname ++ "` whose type mentions an earlier field"),
            Some(ty) => {
                let at_g <- lookup(tname ++ "::" ++ f.name ++ "_at").bind(λ c => rt_accepted("where field `" ++ f.name ++ "` lies", c));
                let at <- resolve(tname ++ "::" ++ f.name ++ "_at").bind(λ c => rt_accepted("where field `" ++ f.name ++ "` lies", c));
                let part_g <- lookup(tname ++ "::" ++ f.name ++ "_part").bind(λ c => rt_accepted("the part of field `" ++ f.name ++ "`", c));
                let array <- rt_held_array(ty);
                let more <- rt_held_fields(tname, record, stored, rest, span, length);
                match array {
                    Some(a) => {
                        let each <- rt_held_each(tname, f.name, record, stored, Global(part_g), a.fst, a.snd, span, length);
                        let named = match each { None => more.named, Some(e) => Cons(FieldEach(record.ref.id, f.name, e.term), more.named) };
                        pure(HeldFields(Cons(HeldField(f.name, at, None, each), more.fields), named))
                    },
                    None => {
                        let found <- rt_held_codec("field `" ++ f.name ++ "`", ty, Global(part_g), span, length, Global(at_g));
                        let access = found.map(λ c => HeldAccess(c.reader, c.writer, c.writer_name, c.wide, Hd(ty), Global(part_g), c.codec, c.instance));
                        let named = match found { None => more.named, Some(c) => Cons(FieldWhole(record.ref.id, f.name, c.value), more.named) };
                        pure(HeldFields(Cons(HeldField(f.name, at, access, None), more.fields), named))
                    },
                }
            },
        },
    }
}

// Whether a term is the field `field` of the record's local, read through
// the fields of records just built.
fn rt_held_is(fuel: Nat, k: Known, h: Handle, record: Nat, field: String) → Tac<Bool> {
    match fuel {
        Zero => pure(False),
        Succ(f) => view(h).bind(λ v => {
            let read: Option<Pair<Handle, String>> = match v {
                HGlobal(_, name, args) => match args {
                    Nil => None,
                    Cons(r, more) => match more { Nil => Some(Pair(r, name)), Cons(_, _) => None },
                },
                HField(r, name, args) => match args { Nil => Some(Pair(r, name)), Cons(_, _) => None },
                _ => None,
            };
            match read {
                Some(p) => view(p.fst).bind(λ rv => {
                    let own: Bool = match rv {
                        HLocal(y, args) => match args { Nil => y.id.same(record) && Known::str_same(rt_base_name(p.snd), field), Cons(_, _) => False },
                        _ => False,
                    };
                    match own {
                        True => pure(True),
                        False => rt_field_of_value(k, p.fst, p.snd).bind(λ e => match e { Some(u) => rt_held_is(f, k, u, record, field), None => pure(False) }),
                    }
                }),
                None => match v {
                    HOther => next_spelling(Hd(h)).bind(λ c => match c { Accepted(u) => rt_held_is(f, k, u, record, field), Refused(_) => pure(False) }),
                    _ => pure(False),
                },
            }
        }),
    }
}

// The fields of the record a function leaves: the constructor's, where
// the term is one, and `None` where it is the record as it came in.
fn rt_held_left(fuel: Nat, ty: Nat, record: Nat, h: Handle) → Tac<Option<List<Handle>>> {
    match fuel {
        Zero => rt_refuse("the record a function leaves is deeper than the reflector's fuel"),
        Succ(f) => view(h).bind(λ v => match v {
            HCtor(cty, _, _, values) => match cty.id.same(ty) {
                True => pure(Some(values)),
                False => rt_refuse("a function of a laid record leaves a record of its own type"),
            },
            HLocal(y, _) => match y.id.same(record) {
                True => pure(None),
                False => rt_refuse("a function of a laid record leaves its own record"),
            },
            HMatch(_) => rt_refuse("the record a function leaves is chosen by a branch inside `Mutated`: write the branch around the whole result, each arm its own end"),
            HOther => next_spelling(Hd(h)).bind(λ c => match c {
                Accepted(u) => rt_held_left(f, ty, record, u),
                Refused(_) => rt_refuse("the record a function leaves is not built from its fields"),
            }),
            _ => rt_refuse("the record a function leaves is not built from its fields (a call of another function of the record is not reflected yet)"),
        }),
    }
}

// A field that changed: its accessor, where it lies, and the variable
// its new value's word is.
record HeldSet { access: HeldAccess, at: Handle, level: Nat }

// An entry of a vector as the term that is there: `vector_index` read
// through its definition, one entry of the vector at a step.
fn rt_held_entry(fuel: Nat, what: String, e: Expr) → Tac<Handle> {
    match fuel {
        Zero => rt_refuse("the new value of " ++ what ++ " is not an entry the vector's term gives"),
        Succ(f) => {
            let h <- next_spelling(e).bind(λ c => rt_accepted("the new value of " ++ what, c));
            let v <- view(h);
            let again: Bool = match v { HGlobal(_, name, _) => Known::str_same(rt_base_name(name), "vector_index"), _ => False };
            match again { True => rt_held_entry(f, what, Hd(h)), False => pure(h) }
        },
    }
}

// The elements of an array field's new value that are not the element
// itself, each as a variable: whether one changed is a comparison of the
// two entries, and a changed one is read one definition on (an entry of
// a vector written out is the term written there).
fn rt_held_elements(fuel: Nat, k: Known, st: RSt, fname: String, e: HeldEach, value: Handle, is: List<Nat>) → Tac<Pair<RSt, List<HeldSet>>> {
    match is {
        Nil => pure(Pair(st, [])),
        Cons(i, rest) => {
            let new = e.entry(Hd(value), i);
            let same <- defeq(new, e.entry(e.own, i));
            match same {
                True => rt_held_elements(fuel, k, st, fname, e, value, rest),
                False => {
                    let what = "element " ++ decimal_name(Succ(i), i) ++ " of field `" ++ fname ++ "`";
                    let entry <- rt_held_entry(Succ(Succ(i)), what, new);
                    let word <- next_spelling(App(e.wide, Hd(entry))).bind(λ c => rt_accepted("the new value of " ++ what ++ " as a word", c));
                    let r <- rt_go(fuel, k, st, word, True);
                    let reads <- e.term.reads(i);
                    let rv <- view(reads.fst);
                    let at: Tac<Handle> = match rv {
                        HGlobal(_, _, args) => match args.nth(2) {
                            Some(at) => pure(at),
                            None => rt_refuse("the accessor of " ++ what ++ " does not read by a span, its length word and an offset"),
                        },
                        _ => rt_refuse("the accessor of " ++ what ++ " does not read by a function of the program"),
                    };
                    let at_h <- at;
                    let later <- rt_held_elements(fuel, k, r.fst, fname, e, value, rest);
                    pure(Pair(later.fst, Cons(HeldSet(e.access(i), at_h, RSt::level(r.snd)), later.snd)))
                },
            }
        },
    }
}

// Each field's new value that is not the field itself, as a variable.
fn rt_held_sets(fuel: Nat, k: Known, st: RSt, record: Nat, fs: List<HeldField>, values: List<Handle>) → Tac<Pair<RSt, List<HeldSet>>> {
    match fs {
        Nil => pure(Pair(st, [])),
        Cons(field, rest) => match values {
            Nil => rt_refuse("a record built from fewer fields than it has"),
            Cons(value, more) => rt_held_is(fuel, k, value, record, field.name).bind(λ same => match same {
                True => rt_held_sets(fuel, k, st, record, rest, more),
                False => match field.access {
                    None => match field.each {
                        None => rt_refuse("it changes the field `" ++ field.name ++ "`, whose codec has no accessor: only a field stored as a word, or an array of them, is written for now"),
                        Some(e) => {
                            let own <- rt_held_elements(fuel, k, st, field.name, e, value, List::range(e.term.count));
                            let later <- rt_held_sets(fuel, k, own.fst, record, rest, more);
                            pure(Pair(later.fst, own.snd ++ later.snd))
                        },
                    },
                    Some(a) => {
                        let word <- next_spelling(rt_ap(a.wide, [Hd(value)])).bind(λ c => rt_accepted("a field's new value as a word", c));
                        let r <- rt_go(fuel, k, st, word, True);
                        let later <- rt_held_sets(fuel, k, r.fst, record, rest, more);
                        pure(Pair(later.fst, Cons(HeldSet(a, field.at, RSt::level(r.snd)), later.snd)))
                    },
                },
            }),
        },
    }
}

// The stores, in order: each a call of the accessor's writer on the
// span's place, its length word, the field's offset and the word.
record HeldStored { st: RSt, segs: List<FSeg>, cfuns: List<Nat> }

fn rt_held_stores(fuel: Nat, k: Known, w: HeldStored, sets: List<HeldSet>) → Tac<HeldStored> {
    match sets {
        Nil => pure(w),
        Cons(s, rest) => {
            let found <- rt_file_callee(k, w.cfuns, s.access.writer, s.access.writer_name);
            let ra <- rt_go(fuel, k, w.st, s.at, True);
            let st = ra.fst;
            rt_held_stores(fuel, k,
                HeldStored(st.written(Succ(st.depth)),
                    Cons(FCall(found.snd, [st.index(0), st.index(1), st.index(RSt::level(ra.snd)), st.index(s.level)]), FSeg::lets(st.lets) ++ w.segs), found.fst),
                rest)
        },
    }
}

// A body in tail position. `k` reads pure code at the span as it came in;
// `ty` is the record's type and `record` the local the body takes it as.
fn rt_held_tail(fuel: Nat, k: Known, names: FileNames, ty: Nat, record: Nat, fs: List<HeldField>, st: RSt, cfuns: List<Nat>, h: Handle) → Tac<FileEnd> {
    match fuel {
        Zero => rt_refuse("the body is deeper than the reflector's fuel"),
        Succ(f) => view(h).bind(λ v => match v {
            HCtor(cty, _, _, values) => match cty.id.same(names.mutated) {
                False => rt_held_ends(),
                True => match values.rev() {
                    Cons(value, Cons(after, _)) => {
                        let left <- rt_held_left(f, ty, record, after);
                        let changed: Tac<Pair<RSt, List<HeldSet>>> = match left { None => pure(Pair(st, [])), Some(vs) => rt_held_sets(f, k, st, record, fs, vs) };
                        let sets <- changed;
                        let rv <- rt_go(f, k, sets.fst, value, True);
                        let done <- rt_held_stores(f, k, HeldStored(rv.fst, [], cfuns), sets.snd);
                        pure(FileEnd(FSeg::close(FSeg::lets(done.st.lets) ++ done.segs, FTm::Pure(Var(done.st.index(RSt::level(rv.snd))))), done.st.funs, done.cfuns))
                    },
                    _ => rt_refuse("`Mutated` without its record and value"),
                },
            },
            HMatch(_) => {
                let m <- arms(h).bind(λ c => rt_accepted("a `match`", c));
                let t <- k.ty_of(m.scrut);
                match t {
                    Bit => {
                        let rc <- rt_go(f, k, st, m.scrut, True);
                        let yes_h <- rt_arm(m, 1);
                        let no_h <- rt_arm(m, 0);
                        let base = RSt(rc.fst.depth, [], rc.fst.memo, rc.fst.handles, rc.fst.locals, rc.fst.funs);
                        let ry <- rt_held_tail(f, k, names, ty, record, fs, base, cfuns, yes_h);
                        let rn <- rt_held_tail(f, k, names, ty, record, fs, base.with_funs(ry.funs), ry.cfuns, no_h);
                        let c = rc.fst.index(RSt::level(rc.snd));
                        let node: FTm = match m.args { Nil => FTm::If(c, ry.term, rn.term), Cons(_, _) => FTm::IfEq(c, ry.term, rn.term) };
                        pure(FileEnd(FSeg::close(FSeg::lets(rc.fst.lets), node), rn.funs, rn.cfuns))
                    },
                    _ => rt_refuse("a `match` on something other than a `Bool` (enums are not reflected yet)"),
                }
            },
            HGlobal(_, name, _) => rt_refuse("it ends in a call of `" ++ name ++ "`: a call of another function of the record is not reflected yet"),
            _ => rt_held_ends(),
        }),
    }
}

// The words a function takes after its record: the body's `λ`s opened,
// each local at levels 2 on (the span's place and its length word are 0
// and 1), and the body under them.
record HeldWords { locals: List<LocalRef>, bound: List<Pair<Nat, Nat>>, body: Handle, last: LocalRef }

fn rt_held_words(fuel: Nat, k: Known, h: Handle, level: Nat, under: LocalRef) → Tac<HeldWords> {
    match fuel {
        Zero => rt_refuse("more parameters than the reflector's fuel"),
        Succ(f) => view(h).bind(λ v => match v {
            HLam(dom) => k.ty(dom).bind(λ at => match (match at { Word(w) => w.same(64), _ => False }) {
                False => rt_refuse("a function of a laid record takes 64-bit words after its record, for now"),
                True => {
                    let o <- open(h, "x").bind(λ c => rt_accepted("a parameter", c));
                    let more <- rt_held_words(f, k, o.body, Succ(level), o.local.ref);
                    pure(HeldWords(Cons(o.local.ref, more.locals), Cons(Pair(o.local.ref.id, level), more.bound), more.body, more.last))
                },
            }),
            _ => pure(HeldWords([], [], h, under)),
        }),
    }
}

// The code of the value a body answers, and whether it answers it beside
// its record: its type is `Mutated<T, R>` at the record's type `T` where
// the function changes the record, and `R` where it only reads it.
fn rt_held_result(k: Known, names: FileNames, record: Handle, b: Handle) → Tac<Pair<Bool, Ty>> {
    let t <- infer(Hd(b)).bind(λ c => rt_accepted("its body's type", c));
    let v <- view(t);
    let read: Tac<Pair<Bool, Ty>> = k.ty(t).bind(λ r => pure(Pair(False, r)));
    match v {
        HGlobal(g, _, args) => match g.id.same(names.mutated) {
            True => match args {
                Cons(left, Cons(r, Nil)) => defeq(Hd(left), Hd(record)).bind(λ same => match same {
                    True => k.ty(r).bind(λ code => pure(Pair(True, code))),
                    False => rt_refuse("a function of a laid record that returns `Mutated` returns it of that record"),
                }),
                _ => rt_refuse("`Mutated` without its two types"),
            },
            False => read,
        },
        _ => read,
    }
}

// The only constructor of a record.
fn rt_held_ctor(tname: String, cs: List<CtorInfo>) → Tac<CtorInfo> {
    match cs {
        Nil => rt_refuse("`" ++ tname ++ "` has no constructor"),
        Cons(c, more) => match more { Nil => pure(c), Cons(_, _) => rt_refuse("`" ++ tname ++ "` is not a record: it has more than one constructor") },
    }
}

// The offsets a function's accessors are called at, where they are
// literals: a call's third operand, after the span's place and its
// length word. `known` is the literal that bound each variable, the most
// recent first.
fn rt_held_third(args: List<Nat>, known: List<Option<Nat>>) → List<Nat> {
    match args.nth(2) {
        None => [],
        Some(i) => match known.nth(i) { Some(lit) => match lit { Some(n) => [n], None => [] }, None => [] },
    }
}

fn rt_held_offsets(t: FTm, known: List<Option<Nat>>) → List<Nat> {
    match t {
        Pure(_) => [],
        Let(e, body) => match e {
            Call(_, args) => rt_held_third(args, known) ++ rt_held_offsets(body, Cons(None, known)),
            Lit(_, n) => rt_held_offsets(body, Cons(Some(n), known)),
            _ => rt_held_offsets(body, Cons(None, known)),
        },
        If(_, yes, no) => rt_held_offsets(yes, known) ++ rt_held_offsets(no, known),
        IfEq(_, yes, no) => rt_held_offsets(yes, known) ++ rt_held_offsets(no, known),
        Put(_, _, _, body) => rt_held_offsets(body, known),
        Call(_, args, body) => rt_held_third(args, known) ++ rt_held_offsets(body, Cons(None, known)),
        Again(_) => [],
        Lend(_, _, _, _) => [],
    }
}

fn rt_held_has(ns: List<Nat>, n: Nat) → Bool { match ns { Nil => False, Cons(m, rest) => match m.same(n) { True => True, False => rt_held_has(rest, n) } } }

// The elements a function reaches, each as a field of its own: the marks
// name an element's part where an accessor is called at its offset, and
// an array's other elements are not in them.
fn rt_held_reached(fs: List<HeldField>, offsets: List<Nat>) → List<HeldField> {
    match fs {
        Nil => [],
        Cons(f, rest) => match f.each {
            None => rt_held_reached(rest, offsets),
            Some(e) => List::range(e.term.count).filter(λ i => rt_held_has(offsets, e.term.base + i * e.term.stride))
                .map(λ i => HeldField(f.name ++ "[" ++ decimal_name(Succ(i), i) ++ "]", f.at, Some(e.access(i)), None)) ++ rt_held_reached(rest, offsets),
        },
    }
}

// The function `g`, whose first parameter is the record.
fn rt_held_reflect_one(k: Known, names: FileNames, g: GlobalRef) → Tac<HeldReflected> {
    let fuel = 4096;
    let b0 <- body(g).bind(λ c => rt_accepted("its body", c));
    let o <- open(b0, "record").bind(λ c => rt_accepted("its record parameter", c));
    let record = o.local.ty;
    let rv <- view(record);
    let found: Tac<Pair<GlobalRef, String>> = match rv {
        HGlobal(rg, tname, args) => match args { Nil => pure(Pair(rg, tname)), Cons(_, _) => rt_refuse("a laid record has no type parameters") },
        _ => rt_refuse("its first parameter is not a record"),
    };
    let rg <- found;
    let tname = rg.snd;
    let stored <- lookup(tname ++ "::stored").bind(λ c => match c {
        Accepted(s) => pure(s),
        Refused(_) => rt_refuse("`" ++ tname ++ "` is not laid over bytes: declare it `laid record " ++ tname ++ "`"),
    });
    let cs <- ctors(record).bind(λ c => rt_accepted("its record's constructor", c));
    let ctor <- rt_held_ctor(tname, cs);
    let ws <- rt_held_words(fuel, k, o.body, 2, o.local.ref);
    let result <- rt_held_result(k, names, record, ws.body);
    let word <- as_type(rt_ap(Global(GlobalRef(k.bitvec)), [NatLit(64)])).bind(λ c => rt_accepted("a word's type", c));
    let bytes <- as_type(rt_ap(Global(GlobalRef(k.list)), [rt_ap(Global(GlobalRef(k.bitvec)), [NatLit(8)])])).bind(λ c => rt_accepted("a span's type", c));
    let span <- assume(Hd(bytes), "span", Some(ws.last)).bind(λ c => rt_accepted("a span's local", c));
    let length <- assume(Hd(word), "length", Some(span.ref)).bind(λ c => rt_accepted("a length word's local", c));
    let hf <- rt_held_fields(tname, o.local, stored, ctor.fields, Local(span.ref), Local(length.ref));
    let kk = k.lending(1).naming(hf.named).at_file(FileKnown(span.ref.id, None, []));
    let st = RSt(2 + ws.locals.len(), [], [], [], Cons(Pair(span.ref.id, 0), Cons(Pair(length.ref.id, 1), ws.bound)), k.funs);
    // A function that only reads the record is one value, its branches
    // values too: the function of the record is its value beside the
    // record as it was, and a branch around that is not a branch inside it.
    let walked: Tac<FileEnd> = match result.fst {
        True => rt_held_tail(fuel, kk, names, rg.fst.id, o.local.ref.id, hf.fields, st, [], ws.body),
        False => rt_go(fuel, kk, st, ws.body, True).bind(λ rv =>
            pure(FileEnd(FSeg::close(FSeg::lets(rv.fst.lets), FTm::Pure(Var(rv.fst.index(RSt::level(rv.snd))))), rv.fst.funs, []))),
    };
    let r <- walked;
    let params: List<Ty> = Cons(Word(64), Cons(Word(64), ws.locals.map(λ _ => Word(64))));
    pure(HeldReflected(FFun(params, result.snd, r.term, 1), r.funs, r.cfuns, record, tname, stored, hf.fields ++ rt_held_reached(hf.fields, rt_held_offsets(r.term, [])),
        ws.locals.len(), result.fst))
}

// The reflector for functions of a laid record: a function from a record
// `T` laid over bytes (`laid record T`, lib/std/machine/laid.hthr) to
// `Mutated<T, R>`, read from its elaborated body as the `FFun` of the
// function over the span that holds the record
// (docs/layout-design.md §9.2, §9.5 round 3).
//
// The source is the kernel type a `mut self` method on the record has,
// `fn T::m(mut self t: T, x: u64, …) → R`, or the same function written
// out, returning `Mutated(t, value)` itself. The code takes the span's
// place and its 64-bit length word, then the words, as every function
// over a span does (`rt_file_reflect`).
//
// The body is read as the elaborator built it, under the record's own
// local `t`. A read of a field, `t.f`, stands for its accessor's read of
// the span at the field's offset (`Known.named`): the accessor is the one
// of the field's codec, found by resolution (`Accessor(codec)`,
// `stored_accessor.hthr`), and nothing is compiled per field. The pure
// walk reflects a field's read where the field is first read, so a field
// the function does not read is not read. A body ends in
// `Mutated(T(e₁, …, eₙ), value)`, in `Mutated(t, value)`, or in a `match`
// on a `Bool` whose arms do. At such an end the reflector:
//
// 1. reflects each field's new value that is not the field itself, and
//    the value, as pure `rt` over the span as it came in;
// 2. emits one call of the field's accessor's writer for each field that
//    changed, in the record's order, the offset a literal bound just
//    before it;
// 3. answers the value.
//
// So the code reads the fields it needs, computes, and stores the fields
// that changed. Whether a field changed is read off the term: a field
// whose new value is the read of that field is not stored.
//
// An array field whose elements' codec has an accessor is its elements,
// each a part of the record (the field's part, then the element's in the
// array). `vector_index(t.f, i, _)` at a literal `i` stands for the
// accessor's read where element `i` lies, and a field whose new value is
// not the field stores the entries that differ from the field's own,
// which a comparison of the two entries decides. What the walk hands the
// generator names the elements the function reached, each as a field,
// and no others: the offsets its accessors are called at are read off
// the reflection.
//
// At an index that is a word, `vector_get(t.f, i.toNat(), 0)` stands for
// the accessor's checked read of the array (the word it begins at, its
// count and the index; 0 past the count), and a field whose new value is
// the field under `vector_update`s at words is one checked store for
// each. The array is then marked whole, by its part.
//
// A function may call another function of the record that was compiled
// as one (`t.m(x)` at a `runtime fn T::m(mut self t: T, …)` declared
// before it): the call is the callee's code over the span, on the span's
// place, its length word and the operands, made where the body makes it,
// after the stores of what the body changed before it ("The walk",
// below). The walk hands the generator the functions called.
//
// Untrusted like every producer: what a `runtime fn` of a record
// publishes is the pin of this reflection's held meaning
// (`FTm::held`, rt_held.hthr) to the function, by conversion, and a wrong
// reflection fails it.
import logic;
import bool;
import nat;
import list;
import list_window;
import option;
import pair;
import char;
import string;
import tactic;
import derive;
import bitvec;
import rt;
import rt_file;
import rt_reflect;
import rt_file_reflect;

// A field's accessor as the walk carries it: the globals of the reader
// and the writer its codec's `Accessor` names, and the terms a
// generator states the field's promises with (its type, its part, its
// codec and the instance).
record HeldAccess { reader: Nat, writer: GlobalRef, writer_name: String, wide: Expr, ty: Expr, part: Expr, codec: Expr, instance: Expr }

// An array field by an index that is a word: the globals of its codec's
// checked reader and writer of an element, the array's part of the
// record, and the words it begins at and its count is, as the accessor's
// call has them.
record HeldAt { reader: Nat, writer: GlobalRef, writer_name: String, part: Expr, base: Handle, count: Handle }

// An array field whose elements' codec has an accessor: what its
// elements stand for where they are read (`ElementTerm`), the accessor's
// globals and terms, its element's type and count, the field as a term
// of the record's local, and the terms an element's part and an entry of
// a vector are built by (each applied to an index and `trivial`).
record HeldEach { term: ElementTerm, reader: Nat, writer: GlobalRef, writer_name: String, wide: Expr, ty: Expr, codec: Expr, instance: Expr,
    own: Expr, then_of: Expr, element_of: Expr, index_of: Expr, inside: Expr, at: HeldAt }

// A field: its name, where it lies (the word `T::f_at`), its accessor,
// if its codec has one, and its elements' if it is an array of words.
record HeldField { name: String, at: Handle, access: Option<HeldAccess>, each: Option<HeldEach> }

// The part of element `i`, and its accessor.
fn HeldEach::part(self e: HeldEach, i: Nat) → Expr { App(e.then_of, App(App(e.element_of, NatLit(i)), e.inside)) }

fn HeldEach::access(self e: HeldEach, i: Nat) → HeldAccess { HeldAccess(e.reader, e.writer, e.writer_name, e.wide, e.ty, e.part(i), e.codec, e.instance) }

// Entry `i` of a vector of the field's type.
fn HeldEach::entry(self e: HeldEach, v: Expr, i: Nat) → Expr { App(App(App(e.index_of, v), NatLit(i)), e.inside) }

// A function of the record a function calls: the function over the span
// the code calls (`T::m::bytes`), the function of the record, its name
// and how many words it takes after its record.
record HeldCall { bytes: Nat, run: GlobalRef, name: String, operands: Nat }

fn HeldCall::of(cs: List<HeldCall>, g: Nat) → Option<HeldCall> {
    match cs { Nil => None, Cons(c, rest) => match c.run.id.same(g) { True => Some(c), False => HeldCall::of(rest, g) } }
}

fn HeldCall::add(cs: List<HeldCall>, c: HeldCall) → List<HeldCall> {
    match HeldCall::of(cs, c.run.id) { Some(_) => cs, None => cs ++ [c] }
}

// A function of a laid record after it was walked: its reflection, the
// program's pure functions and computations, the record and its fields,
// how many words it takes beside the record, whether it changes the
// record or only reads it, the functions of the record it calls, and
// whether it is a loop (a function that `decreases`, its body ending in
// its own call).
record HeldReflected { reflected: FFun, funs: List<Nat>, cfuns: List<Nat>, record: Handle, record_name: String, stored: GlobalRef, fields: List<HeldField>,
    operands: Nat, changes: Bool, calls: List<HeldCall>, measured: Bool }

// A term applied to arguments.
fn rt_ap(f: Expr, args: List<Expr>) → Expr { args.foldl(λ acc a => App(acc, a), f) }

fn rt_held_ends<A>() → Tac<A> {
    rt_refuse("a function of a laid record ends in `Mutated(record, value)`, in a `match` on a `Bool` whose arms do, or (where it `decreases`) in its own call")
}

// The accessor of a field's codec: the instance `Accessor<B>(codec)`, by
// the search an instance argument runs, and the functions it names, read
// at the span, its length word and the field's offset; and beside it
// what a read of the field stands for, the accessor's read there at the
// field's own width. `None` where the codec has no instance (an array, a
// record inside the record).
// The accessor of the codec a part stores by, if it has one: the
// accessor's globals and terms, its read and its narrowing as terms to
// apply (to an offset, and to the word read), and the part's value read
// at `at`.
record HeldCodec { reader: Nat, writer: GlobalRef, writer_name: String, wide: Expr, codec: Expr, instance: Expr, read: Expr, narrow: Expr, value: Handle,
    read_at: Expr, reader_at: Nat, writer_at: GlobalRef, writer_at_name: String }

fn rt_held_codec(what: String, ty: Handle, part: Expr, span, length: Expr, at: Expr) → Tac<Option<HeldCodec>> {
    let stores <- lookup("Part::stores").bind(λ c => rt_accepted("a part's codec (import `part`)", c));
    let codec = rt_ap(Global(stores), [Blank, Hd(ty), Blank, part]);
    let class <- lookup("Accessor").bind(λ c => rt_accepted("the class of a codec's accessor (import `stored_accessor`)", c));
    let goal <- as_type(rt_ap(Global(class), [Hd(ty), codec])).bind(λ c => rt_accepted("the accessor of " ++ what ++ "'s codec", c));
    let found <- synth(goal);
    match found {
        Refused(_) => pure(None),
        Accepted(inst) => {
            let read <- lookup("Stored::word_read").bind(λ c => rt_accepted("an accessor's read", c));
            let write <- lookup("Stored::word_write").bind(λ c => rt_accepted("an accessor's store", c));
            let wide <- lookup("Stored::word_of").bind(λ c => rt_accepted("an accessor's word of a value", c));
            let narrow <- lookup("Stored::of_word").bind(λ c => rt_accepted("an accessor's value of a word", c));
            let of: List<Expr> = [Hd(ty), codec, Hd(inst)];
            let reads = rt_ap(Global(read), of ++ [span, length]);
            let narrows = rt_ap(Global(narrow), of);
            let rd <- next_spelling(App(reads, at)).bind(λ c => rt_accepted("an accessor's read", c));
            let wr <- next_spelling(rt_ap(Global(write), of ++ [span, length, at, length])).bind(λ c => rt_accepted("an accessor's store", c));
            let value <- next_spelling(App(narrows, Hd(rd))).bind(λ c => rt_accepted("an accessor's read at its field's width", c));
            let rv <- view(rd);
            let wv <- view(wr);
            // The checked reader and writer of an element at a word.
            let read_at <- lookup("Stored::word_read_at").bind(λ c => rt_accepted("an accessor's read of an element", c));
            let write_at <- lookup("Stored::word_write_at").bind(λ c => rt_accepted("an accessor's store of an element", c));
            let reads_at = rt_ap(Global(read_at), of ++ [span, length]);
            let rda <- next_spelling(rt_ap(reads_at, [at, at, at])).bind(λ c => rt_accepted("an accessor's read of an element", c));
            let wra <- next_spelling(rt_ap(Global(write_at), of ++ [span, length, at, at, at, length])).bind(λ c => rt_accepted("an accessor's store of an element", c));
            let rav <- view(rda);
            let wav <- view(wra);
            match rv {
                HGlobal(rg, _, _) => match wv {
                    HGlobal(wg, wname, _) => match rav {
                        HGlobal(rag, _, _) => match wav {
                            HGlobal(wag, waname, _) => pure(Some(HeldCodec(rg.id, wg, wname, rt_ap(Global(wide), of), codec, Hd(inst), reads, narrows, value,
                                reads_at, rag.id, wag, waname))),
                            _ => rt_refuse("the accessor of " ++ what ++ "'s codec does not store an element by a function of the program"),
                        },
                        _ => rt_refuse("the accessor of " ++ what ++ "'s codec does not read an element by a function of the program"),
                    },
                    _ => rt_refuse("the accessor of " ++ what ++ "'s codec does not store by a function of the program"),
                },
                _ => rt_refuse("the accessor of " ++ what ++ "'s codec does not read by a function of the program"),
            }
        },
    }
}

// An array's element type and its length, where a field's type is one.
fn rt_held_array(ty: Handle) → Tac<Option<Pair<Handle, Handle>>> {
    let v <- view(ty);
    let found: Option<Pair<Handle, Handle>> = match v {
        HGlobal(_, name, args) => match Known::str_same(rt_base_name(name), "Vec") {
            False => None,
            True => args.nth(0).and_then(λ element => args.nth(1).map(λ length => Pair(element, length))),
        },
        _ => None,
    };
    pure(found)
}

// A field of a term, among its projections.
fn rt_held_projection(fname: String, ps: List<FieldProj>) → Tac<Handle> {
    match ps {
        Nil => rt_refuse("the field `" ++ fname ++ "` is not a projection of its record"),
        Cons(p, rest) => match Known::str_same(p.name, fname) { True => pure(p.term), False => rt_held_projection(fname, rest) },
    }
}

// The codec of an array field's elements: the field's codec read through
// its definitions to `Stored::array` of it.
fn rt_held_element_codec(fuel: Nat, fname: String, e: Expr) → Tac<Handle> {
    let no = "the codec of the array field `" ++ fname ++ "` is not `Stored::array` of its element's";
    match fuel {
        Zero => rt_refuse(no),
        Succ(f) => {
            let h <- next_spelling(e).bind(λ c => rt_accepted(no, c));
            let v <- view(h);
            let found: Option<Handle> = match v {
                HGlobal(_, name, args) => match Known::str_same(rt_base_name(name), "array") { True => args.nth(0), False => None },
                _ => None,
            };
            match found { Some(c) => pure(c), None => rt_held_element_codec(f, fname, Hd(h)) }
        },
    }
}

// The elements of an array field, where their codec has an accessor.
// Where element `i` lies is the place of its part: the field's, then the
// element's in the array.
fn rt_held_each(tname: String, fname: String, record: LocalInfo, stored: GlobalRef, part: Expr, element: Handle, length: Handle, span, len: Expr, under: LocalRef) → Tac<Option<HeldEach>> {
    let count <- rt_literal(length);
    let then_g <- lookup("Part::then").bind(λ c => rt_accepted("a part of a part (import `part`)", c));
    let element_g <- lookup("Part::element").bind(λ c => rt_accepted("an array's element as a part (import `part`)", c));
    let place_g <- lookup("Part::place").bind(λ c => rt_accepted("where a part lies (import `part`)", c));
    let index_g <- lookup("vector_index").bind(λ c => rt_accepted("an entry of a vector (import `vector`)", c));
    let projected <- fields(Local(record.ref)).bind(λ c => rt_accepted("the fields of `" ++ tname ++ "`", c));
    let own <- rt_held_projection(fname, projected.fields);
    let inside <- resolve("trivial").bind(λ c => rt_accepted("`trivial`", c));
    let stores <- lookup("Part::stores").bind(λ c => rt_accepted("a part's codec (import `part`)", c));
    let codec <- rt_held_element_codec(8, fname, rt_ap(Global(stores), [Blank, Blank, Blank, part]));
    let then_of = rt_ap(Global(then_g), [Hd(record.ty), Blank, Hd(element), Global(stored), part]);
    let element_of = rt_ap(Global(element_g), [Hd(element), Hd(codec), Hd(length)]);
    let part_of: Nat → Expr = λ i => App(then_of, App(App(element_of, NatLit(i)), Hd(inside)));
    let place_of: Nat → Expr = λ i => rt_ap(Global(place_g), [Hd(record.ty), Hd(element), Global(stored), part_of(i)]);
    match count {
        Zero => pure(None),
        Succ(more) => {
            let base <- numeral(place_of(0)).bind(λ c => rt_accepted("where the array field `" ++ fname ++ "` begins", c));
            let next: Tac<Nat> = match more { Zero => pure(base), Succ(_) => numeral(place_of(1)).bind(λ c => rt_accepted("where the second element of `" ++ fname ++ "` lies", c)) };
            let second <- next;
            let of_nat <- lookup("BitVec::ofNat").bind(λ c => rt_accepted("`BitVec::ofNat`", c));
            let word: Nat → Expr = λ n => rt_ap(Global(of_nat), [NatLit(64), NatLit(n)]);
            let found <- rt_held_codec("an element of field `" ++ fname ++ "`", element, part_of(0), span, len, word(base));
            match found {
                None => pure(None),
                Some(c) => {
                    // The words the array begins at and its count is, as a
                    // call of the checked reader has them.
                    let spelled <- next_spelling(rt_ap(c.read_at, [word(base), word(count), len])).bind(λ s => rt_accepted("an accessor's read of an element of `" ++ fname ++ "`", s));
                    let sv <- view(spelled);
                    let ends: Option<Pair<Handle, Handle>> = match sv {
                        HGlobal(_, _, args) => args.nth(2).and_then(λ b => args.nth(3).map(λ n => Pair(b, n))),
                        _ => None,
                    };
                    match ends {
                        None => rt_refuse("the accessor of an element of field `" ++ fname ++ "` does not read by a span, its length word, an array's offset, its count and an index"),
                        Some(be) => pure(Some(HeldEach(ElementTerm(count, base, second - base, c.read, c.narrow, c.read_at, under), c.reader, c.writer, c.writer_name, c.wide, Hd(element),
                            c.codec, c.instance, Hd(own), then_of, element_of, rt_ap(Global(index_g), [Hd(element), Hd(length)]), Hd(inside),
                            HeldAt(c.reader_at, c.writer_at, c.writer_at_name, part, be.fst, be.snd)))),
                    }
                },
            }
        },
    }
}

// The fields of the record, and what a read of each stands for.
record HeldFields { fields: List<HeldField>, named: List<FieldTerm> }

fn rt_held_fields(tname: String, record: LocalInfo, stored: GlobalRef, fs: List<FieldInfo>, span, length: Expr, under: LocalRef) → Tac<HeldFields> {
    match fs {
        Nil => pure(HeldFields([], [])),
        Cons(f, rest) => match f.ty {
            None => rt_refuse("a field of `" ++ tname ++ "` whose type mentions an earlier field"),
            Some(ty) => {
                let at_g <- lookup(tname ++ "::" ++ f.name ++ "_at").bind(λ c => rt_accepted("where field `" ++ f.name ++ "` lies", c));
                let at <- resolve(tname ++ "::" ++ f.name ++ "_at").bind(λ c => rt_accepted("where field `" ++ f.name ++ "` lies", c));
                let part_g <- lookup(tname ++ "::" ++ f.name ++ "_part").bind(λ c => rt_accepted("the part of field `" ++ f.name ++ "`", c));
                let array <- rt_held_array(ty);
                let more <- rt_held_fields(tname, record, stored, rest, span, length, under);
                match array {
                    Some(a) => {
                        let each <- rt_held_each(tname, f.name, record, stored, Global(part_g), a.fst, a.snd, span, length, under);
                        let named = match each { None => more.named, Some(e) => Cons(FieldEach(record.ref.id, f.name, e.term), more.named) };
                        pure(HeldFields(Cons(HeldField(f.name, at, None, each), more.fields), named))
                    },
                    None => {
                        let found <- rt_held_codec("field `" ++ f.name ++ "`", ty, Global(part_g), span, length, Global(at_g));
                        let access = found.map(λ c => HeldAccess(c.reader, c.writer, c.writer_name, c.wide, Hd(ty), Global(part_g), c.codec, c.instance));
                        let named = match found { None => more.named, Some(c) => Cons(FieldWhole(record.ref.id, f.name, c.value), more.named) };
                        pure(HeldFields(Cons(HeldField(f.name, at, access, None), more.fields), named))
                    },
                }
            },
        },
    }
}

// Whether a term is the field `field` of the record `base`, read through
// the fields of records just built.
fn rt_held_kept(fuel: Nat, k: Known, h: Handle, base: Option<Handle>, field: String) → Tac<Bool> {
    match base {
        None => pure(False),
        Some(b) => match fuel {
            Zero => pure(False),
            Succ(f) => rt_field_read(h).bind(λ read => match read {
                Some(p) => {
                    let own: Tac<Bool> = match Known::str_same(rt_base_name(p.snd), field) {
                        False => pure(False),
                        True => match p.fst.id.same(b.id) { True => pure(True), False => defeq(Hd(p.fst), Hd(b)) },
                    };
                    own.bind(λ is => match is {
                        True => pure(True),
                        False => rt_field_of_value(k, p.fst, p.snd).bind(λ e => match e { Some(u) => rt_held_kept(f, k, u, base, field), None => pure(False) }),
                    })
                },
                None => view(h).bind(λ v => match v {
                    HOther => next_spelling(Hd(h)).bind(λ c => match c { Accepted(u) => rt_held_kept(f, k, u, base, field), Refused(_) => pure(False) }),
                    _ => pure(False),
                }),
            }),
        },
    }
}

// Whether a term is a record a function has: its own local, or what a
// call left.
fn rt_held_state(record: Nat, r: Handle) → Tac<Bool> {
    view(r).bind(λ v => match v {
        HLocal(y, args) => pure(match args { Nil => y.id.same(record), Cons(_, _) => False }),
        _ => rt_field_read(r).bind(λ read => pure(match read { Some(p) => Known::str_same(rt_base_name(p.snd), "after"), None => False })),
    })
}

// The record a record built from fields is built on: the one a field the
// function left alone is read off. `None` where every field is new.
fn rt_held_base(record: Nat, fs: List<HeldField>, values: List<Handle>) → Tac<Option<Handle>> {
    match fs {
        Nil => pure(None),
        Cons(field, rest) => match values {
            Nil => pure(None),
            Cons(value, more) => rt_field_read(value).bind(λ read => {
                let here: Tac<Option<Handle>> = match read {
                    None => pure(None),
                    Some(p) => match Known::str_same(rt_base_name(p.snd), field.name) {
                        False => pure(None),
                        True => rt_held_state(record, p.fst).bind(λ is => pure(match is { True => Some(p.fst), False => None })),
                    },
                };
                here.bind(λ found => match found { Some(b) => pure(Some(b)), None => rt_held_base(record, rest, more) })
            }),
        },
    }
}

// An element of an array stored at an index that is a word: the
// accessor's checked writer, the words the array begins at and its count
// is, and the variable the index is.
record HeldIndexed { writer: GlobalRef, writer_name: String, base: Handle, count: Handle, level: Nat }

// A field that changed: its accessor, where it lies, and the variable
// its new value's word is; and for an element at a word, how it is
// stored (`index`).
record HeldSet { access: HeldAccess, at: Handle, level: Nat, index: Option<HeldIndexed> }

// An entry of a vector as the term that is there: `vector_index` read
// through its definition, one entry of the vector at a step.
fn rt_held_entry(fuel: Nat, what: String, e: Expr) → Tac<Handle> {
    match fuel {
        Zero => rt_refuse("the new value of " ++ what ++ " is not an entry the vector's term gives"),
        Succ(f) => {
            let h <- next_spelling(e).bind(λ c => rt_accepted("the new value of " ++ what, c));
            let v <- view(h);
            let again: Bool = match v { HGlobal(_, name, _) => Known::str_same(rt_base_name(name), "vector_index"), _ => False };
            match again { True => rt_held_entry(f, what, Hd(h)), False => pure(h) }
        },
    }
}

// The elements of an array field's new value that are not the element
// itself, each as a variable: whether one changed is a comparison of the
// two entries, and a changed one is read one definition on (an entry of
// a vector written out is the term written there).
fn rt_held_elements(fuel: Nat, k: Known, st: RSt, fname: String, e: HeldEach, value: Handle, is: List<Nat>) → Tac<Pair<RSt, List<HeldSet>>> {
    match is {
        Nil => pure(Pair(st, [])),
        Cons(i, rest) => {
            let new = e.entry(Hd(value), i);
            let same <- defeq(new, e.entry(e.own, i));
            match same {
                True => rt_held_elements(fuel, k, st, fname, e, value, rest),
                False => {
                    let what = "element " ++ decimal_name(Succ(i), i) ++ " of field `" ++ fname ++ "`";
                    let entry <- rt_held_entry(Succ(Succ(i)), what, new);
                    let word <- next_spelling(App(e.wide, Hd(entry))).bind(λ c => rt_accepted("the new value of " ++ what ++ " as a word", c));
                    let r <- rt_go(fuel, k, st, word, True);
                    let reads <- e.term.reads(i);
                    let rv <- view(reads.fst);
                    let at: Tac<Handle> = match rv {
                        HGlobal(_, _, args) => match args.nth(2) {
                            Some(at) => pure(at),
                            None => rt_refuse("the accessor of " ++ what ++ " does not read by a span, its length word and an offset"),
                        },
                        _ => rt_refuse("the accessor of " ++ what ++ " does not read by a function of the program"),
                    };
                    let at_h <- at;
                    let later <- rt_held_elements(fuel, k, r.fst, fname, e, value, rest);
                    pure(Pair(later.fst, Cons(HeldSet(e.access(i), at_h, RSt::level(r.snd), None), later.snd)))
                },
            }
        },
    }
}

// The stores, in order: each a call of the accessor's writer on the
// span's place, its length word, the field's offset and the word.
record HeldStored { st: RSt, segs: List<FSeg>, cfuns: List<Nat> }

fn rt_held_stores(fuel: Nat, k: Known, w: HeldStored, sets: List<HeldSet>) → Tac<HeldStored> {
    match sets {
        Nil => pure(w),
        Cons(s, rest) => match s.index {
            None => {
                let found <- rt_file_callee(k, w.cfuns, s.access.writer, s.access.writer_name);
                let ra <- rt_go(fuel, k, w.st, s.at, True);
                let st = ra.fst;
                rt_held_stores(fuel, k,
                    HeldStored(st.written(Succ(st.depth)),
                        Cons(FCall(found.snd, [st.index(0), st.index(1), st.index(RSt::level(ra.snd)), st.index(s.level)]), FSeg::lets(st.lets) ++ w.segs), found.fst),
                    rest)
            },
            Some(x) => {
                let found <- rt_file_callee(k, w.cfuns, x.writer, x.writer_name);
                let rb <- rt_go(fuel, k, w.st, x.base, True);
                let rc <- rt_go(fuel, k, rb.fst, x.count, True);
                let st = rc.fst;
                rt_held_stores(fuel, k,
                    HeldStored(st.written(Succ(st.depth)),
                        Cons(FCall(found.snd, [st.index(0), st.index(1), st.index(RSt::level(rb.snd)), st.index(RSt::level(rc.snd)), st.index(x.level), st.index(s.level)]),
                            FSeg::lets(st.lets) ++ w.segs), found.fst),
                    rest)
            },
        },
    }
}

// Whether a term is the array field `fname` of the record a store is
// made onto: the field of the record a built record is built on, or,
// where every field of the built record is new, of the record the span
// holds.
fn rt_held_own(fuel: Nat, k: Known, record: Nat, settled: Bool, h: Handle, base: Option<Handle>, fname: String) → Tac<Bool> {
    match base {
        Some(_) => rt_held_kept(fuel, k, h, base, fname),
        None => match settled {
            False => pure(False),
            True => rt_field_read(h).bind(λ read => match read {
                None => pure(False),
                Some(p) => match Known::str_same(rt_base_name(p.snd), fname) {
                    False => pure(False),
                    True => view(p.fst).bind(λ v => pure(match v { HLocal(y, args) => match args { Nil => y.id.same(record), Cons(_, _) => False }, _ => False })),
                },
            }),
        },
    }
}

// The element at a numeral inside the count: the accessor's own store
// where that element lies, with no test, as an element of an array
// written out is stored.
fn rt_held_at_numeral(fuel: Nat, k: Known, under: LocalRef, fname: String, e: HeldEach, o: Pair<RSt, List<HeldSet>>, i: Nat, x: Handle) → Tac<Option<Pair<RSt, List<HeldSet>>>> {
    let what = "element " ++ decimal_name(Succ(i), i) ++ " of field `" ++ fname ++ "`";
    let rv <- rt_go(fuel, k, o.fst, x, True);
    let v <- assume(e.ty, "value", Some(under)).bind(λ c => rt_accepted("an element's new value's local", c));
    let as_word <- next_spelling(rt_ap(e.wide, [Local(v.ref)])).bind(λ c => rt_accepted("an element's new value as a word", c));
    let rr <- rt_go(fuel, k, rv.fst.with_local(v.ref.id, RSt::level(rv.snd)), as_word, True);
    let reads <- e.term.reads(i);
    let rd <- view(reads.fst);
    let at: Tac<Handle> = match rd {
        HGlobal(_, _, args) => match args.nth(2) {
            Some(at) => pure(at),
            None => rt_refuse("the accessor of " ++ what ++ " does not read by a span, its length word and an offset"),
        },
        _ => rt_refuse("the accessor of " ++ what ++ " does not read by a function of the program"),
    };
    let at_h <- at;
    pure(Some(Pair(rr.fst, o.snd ++ [HeldSet(e.access(i), at_h, RSt::level(rr.snd), None)])))
}

// An array field's new value that is the field updated at indices that
// are words, `vector_update(… vector_update(t.f, i.toNat(), x) …,
// j.toNat(), y)`: each update a store by the accessor's checked writer,
// the innermost first, every word computed before the first store. An
// index that is a numeral inside the count is the accessor's own store
// where that element lies (`rt_held_at_numeral`), which is how an element
// is stored after a call: there the field is not the record's local's,
// and what changed cannot be told by comparing entries. `None`
// where the value is not that. `settled` says the span holds the
// function's own record (no call has changed it).
fn rt_held_indexed(fuel: Nat, k: Known, st: RSt, record: Nat, settled: Bool, under: LocalRef, base: Option<Handle>, fname: String, e: HeldEach, value: Handle)
    → Tac<Option<Pair<RSt, List<HeldSet>>>> {
    match fuel {
        Zero => pure(None),
        Succ(f) => rt_held_own(f, k, record, settled, value, base, fname).bind(λ same => match same {
            True => pure(Some(Pair(st, []))),
            False => view(value).bind(λ v => {
                let update: Option<Pair<Handle, Pair<Handle, Handle>>> = match v {
                    HGlobal(_, name, args) => match Known::str_same(rt_base_name(name), "vector_update") {
                        False => None,
                        True => args.nth(0).and_then(λ inner => args.nth(1).and_then(λ i => args.nth(2).map(λ x => Pair(inner, Pair(i, x))))),
                    },
                    _ => None,
                };
                match update {
                    // Read through a record just built (a statement before
                    // this one rebuilt the record) and through a name.
                    None => rt_field_read(value).bind(λ read => match read {
                        Some(p) => rt_field_of_value(k, p.fst, p.snd).bind(λ built => match built {
                            Some(u) => rt_held_indexed(f, k, st, record, settled, under, base, fname, e, u),
                            None => pure(None),
                        }),
                        None => match v {
                            HOther => next_spelling(Hd(value)).bind(λ c => match c {
                                Accepted(u) => rt_held_indexed(f, k, st, record, settled, under, base, fname, e, u),
                                Refused(_) => pure(None),
                            }),
                            _ => pure(None),
                        },
                    }),
                    Some(u) => rt_to_nat_of(u.snd.fst).bind(λ word => match word {
                        // A numeral index inside the count is the element's
                        // own store.
                        None => view(u.snd.fst).bind(λ iv => match iv {
                            HLit(n) => match Succ(n).leb(e.term.count) {
                                False => pure(None),
                                True => rt_held_indexed(f, k, st, record, settled, under, base, fname, e, u.fst).bind(λ inner => match inner {
                                    None => pure(None),
                                    Some(o) => rt_held_at_numeral(f, k, under, fname, e, o, n, u.snd.snd),
                                }),
                            },
                            _ => pure(None),
                        }),
                        Some(i) => rt_held_indexed(f, k, st, record, settled, under, base, fname, e, u.fst).bind(λ inner => match inner {
                            None => pure(None),
                            Some(o) => {
                                let ri <- rt_go(f, k, o.fst, i, True);
                                let rv <- rt_go(f, k, ri.fst, u.snd.snd, True);
                                let x <- assume(e.ty, "value", Some(under)).bind(λ c => rt_accepted("an element's new value's local", c));
                                let as_word <- next_spelling(rt_ap(e.wide, [Local(x.ref)])).bind(λ c => rt_accepted("an element's new value as a word", c));
                                let rr <- rt_go(f, k, rv.fst.with_local(x.ref.id, RSt::level(rv.snd)), as_word, True);
                                pure(Some(Pair(rr.fst, o.snd ++ [HeldSet(e.access(0), e.at.base, RSt::level(rr.snd),
                                    Some(HeldIndexed(e.at.writer, e.at.writer_name, e.at.base, e.at.count, RSt::level(ri.snd))))])))
                            },
                        }),
                    }),
                }
            }),
        }),
    }
}

// ---------------------------------------------------------------------------
// The walk
//
// The elaborator hands a body over with every binding substituted, so a
// function that calls another function of the record `m` and goes on is
// one term in which the call stands wherever its record or its word is
// read: `m(S, x).after.count`, `m(S, x).value`, with `S` the record the
// call was handed, itself the record's local, a record built from fields,
// or what an earlier call left. The walk reads the order back. A record
// is *settled* when the span holds it: the local at the start; what a
// call left once the call is made, which first settles the record the
// call takes; a record built from fields once the record it is built on
// is settled and each field that is not that record's own is stored. The
// stores of a record are made last before what needs it (the call it is
// handed to, or the end), after every value that call or end reads is
// computed: the code reads the span as it is.
//
// Between calls, a field is read off the record as the last call left it
// (`FieldNow`), a call's word is the variable its call bound, and a value
// computed before a call keeps its variable after it. A body may use
// after a call what it read of the record before it (`let old = t.count;
// t.bump(x); old`), and in the term that is a read of the record's local
// standing after the call: so before each call the walk makes every read
// of the record the span then holds that the body has outside that call
// (`rt_held_hoist`), and a later use finds it by its handle.
//
// A call of a function that only reads the record is not reflected yet
// (its term is the call itself, a value among values, where a call that
// changes the record stands under `.after` and `.value`), nor is an
// array field written out anew after a call (one under `vector_update`s
// is its stores, `rt_held_indexed`).

// What the walk reads by: pure code's table, the record's type, its
// local and the span's, the fields and what each stands for, and the
// local a new one is assumed under, and the terms the body being walked
// is (a branch's scrutinee and arms, or an end). `ih` is the local a
// function that `decreases` calls itself through, in its step.
record HeldCx { k: Known, names: FileNames, ty: Nat, record: Nat, span: Nat, fs: List<HeldField>, named: List<FieldTerm>, under: LocalRef, roots: List<Handle>,
    ih: Option<Nat> }

// The walk of the body `roots` are: what a call's reads are looked for in.
fn HeldCx::rooted(self cx: HeldCx, roots: List<Handle>) → HeldCx { HeldCx(cx.k, cx.names, cx.ty, cx.record, cx.span, cx.fs, cx.named, cx.under, roots, cx.ih) }

// Where the walk is: the pure walk's state, the stores and calls so far
// (the last first), the program's computations, the calls made, the call
// that left the record the span holds (`None` before any), and the
// functions of the record called.
record HeldWalk { st: RSt, segs: List<FSeg>, cfuns: List<Nat>, calls: List<CallRes>, now: Option<Handle>, held: List<HeldCall> }

fn HeldWalk::with_st(self w: HeldWalk, st: RSt) → HeldWalk { HeldWalk(st, w.segs, w.cfuns, w.calls, w.now, w.held) }

// The handles of the terms the fields stand for.
fn HeldCx::terms(self cx: HeldCx) → List<Nat> {
    cx.named.foldr(λ n acc => match n { FieldWhole(_, _, term) => Cons(term.id, acc), _ => acc }, [])
}

// Pure code read where the walk is.
fn HeldCx::known(self cx: HeldCx, w: HeldWalk) → Known {
    cx.k.naming(match w.now { None => cx.named, Some(c) => Cons(FieldNow(cx.record, c), cx.named) }).at_file(FileKnown(cx.span, None, w.calls))
}

// The function of the record a call is of, if it is one: a function that
// published `runs_held`.
fn rt_held_callee(k: Known, held: List<HeldCall>, g: GlobalRef, name: String, args: List<Handle>) → Tac<Option<HeldCall>> {
    match args {
        Nil => pure(None),
        Cons(_, operands) => match HeldCall::of(held, g.id) {
            Some(c) => pure(Some(c)),
            None => match Known::prim(k.prims, g.id) {
                Some(_) => pure(None),
                None => rt_name_of(g, name).bind(λ n => lookup(n ++ "::runs_held").bind(λ c => match c {
                    Refused(_) => pure(None),
                    Accepted(_) => lookup(n ++ "::bytes").bind(λ b => match b {
                        Accepted(bytes) => pure(Some(HeldCall(bytes.id, g, n, operands.len()))),
                        Refused(_) => pure(None),
                    }),
                })),
            },
        },
    }
}

// The call made that `h` is, or is a copy of.
fn rt_held_made(cs: List<CallRes>, g: Nat, h: Handle) → Tac<Option<CallRes>> {
    match rt_call_by_handle(cs, h.id) { Some(a) => pure(Some(a)), None => rt_file_answer_in(cs, g, h) }
}

// The first call of a function of the record in `hs` that is not made
// yet. A call made is not read into: what it took was settled before it.
fn rt_held_pending(fuel: Nat, k: Known, w: HeldWalk, hs: List<Handle>) → Tac<Option<Handle>> {
    match fuel {
        Zero => rt_refuse("a value is deeper than the reflector's fuel"),
        Succ(f) => match hs {
            Nil => pure(None),
            Cons(h, rest) => view(h).bind(λ v => {
                let inside: Tac<Option<Handle>> = match v {
                    HGlobal(g, name, args) => rt_held_callee(k, w.held, g, name, args).bind(λ c => match c {
                        None => rt_held_pending(f, k, w, args),
                        Some(_) => rt_held_made(w.calls, g.id, h).bind(λ made => pure(match made { Some(_) => None, None => Some(h) })),
                    }),
                    HField(r, _, args) => rt_held_pending(f, k, w, Cons(r, args)),
                    HCtor(_, _, _, fields) => rt_held_pending(f, k, w, fields),
                    HLocal(_, args) => rt_held_pending(f, k, w, args),
                    HMatch(scrut) => rt_held_pending(f, k, w, [scrut]),
                    _ => pure(None),
                };
                inside.bind(λ found => match found { Some(x) => pure(Some(x)), None => rt_held_pending(f, k, w, rest) })
            }),
        },
    }
}

// Each operand as a variable.
fn rt_held_operands(fuel: Nat, k: Known, st: RSt, hs: List<Handle>) → Tac<Pair<RSt, List<Nat>>> {
    match hs {
        Nil => pure(Pair(st, [])),
        Cons(h, rest) => rt_go(fuel, k, st, h, True).bind(λ r =>
            rt_held_operands(fuel, k, r.fst, rest).bind(λ more => pure(Pair(more.fst, Cons(RSt::level(r.snd), more.snd))))),
    }
}

// Whether a call answers `Mutated`: a function that only reads the
// record answers its word alone.
fn rt_held_changes(names: FileNames, x: Handle) → Tac<Bool> {
    let t <- infer(Hd(x)).bind(λ c => rt_accepted("a call's type", c));
    let v <- view(t);
    pure(match v { HGlobal(g, _, _) => g.id.same(names.mutated), _ => False })
}

// Whether `r` is the record the span holds: the function's own local
// before any call, and what the last call left after one.
fn rt_held_current(cx: HeldCx, w: HeldWalk, r: Handle) → Tac<Bool> {
    match w.now {
        None => view(r).bind(λ v => {
            let own: Bool = match v { HLocal(y, args) => match args { Nil => y.id.same(cx.record), Cons(_, _) => False }, _ => False };
            pure(own)
        }),
        Some(c) => rt_after_of(r, c),
    }
}

// Whether `h` is a read of the record the span holds that code makes: a
// field stored as a word, or an element of an array of them.
fn rt_held_reads(cx: HeldCx, w: HeldWalk, h: Handle, v: Head) → Tac<Bool> {
    let element: Option<Handle> = match v {
        HGlobal(_, name, args) => match Known::str_same(rt_base_name(name), "vector_index") || Known::str_same(rt_base_name(name), "vector_get") {
            True => args.nth(0),
            False => None,
        },
        _ => None,
    };
    match element {
        Some(vector) => rt_field_read(vector).bind(λ read => match read {
            None => pure(False),
            Some(p) => match Known::elements_at(cx.named, cx.record, rt_base_name(p.snd)) { None => pure(False), Some(_) => rt_held_current(cx, w, p.fst) },
        }),
        None => rt_field_read(h).bind(λ read => match read {
            None => pure(False),
            Some(p) => match Known::named_at(cx.named, cx.record, rt_base_name(p.snd)) { None => pure(False), Some(_) => rt_held_current(cx, w, p.fst) },
        }),
    }
}

// Every read of the record the span holds that the body makes outside
// the calls in `made`, each made now and bound to its handle: a call is
// about to change the record, and what the body reads of the record as
// it is, wherever it uses it, is read before the call. `seen` are the
// handles walked.
fn rt_held_hoist(fuel: Nat, cx: HeldCx, w: HeldWalk, k: Known, made: List<CallRes>, st: RSt, hs: List<Handle>, seen: List<Nat>) → Tac<Pair<RSt, List<Nat>>> {
    match fuel {
        Zero => rt_refuse("the body is deeper than the reflector's fuel"),
        Succ(f) => match hs {
            Nil => pure(Pair(st, seen)),
            Cons(h, rest) => {
                let skip: Bool = match Known::index(seen, h.id, 0) { Some(_) => True, None => match rt_assoc(st.handles, h.id) { Some(_) => True, None => False } };
                match skip {
                    True => rt_held_hoist(f, cx, w, k, made, st, rest, seen),
                    False => view(h).bind(λ v => rt_held_reads(cx, w, h, v).bind(λ read => match read {
                        True => rt_go(f, k, st, h, True).bind(λ r => rt_held_hoist(f, cx, w, k, made, r.fst, rest, Cons(h.id, seen))),
                        False => {
                            let inside: Tac<List<Handle>> = match v {
                                HGlobal(g, name, args) => rt_held_callee(k, w.held, g, name, args).bind(λ c => match c {
                                    None => pure(args),
                                    Some(_) => rt_held_made(made, g.id, h).bind(λ m => {
                                        let into: List<Handle> = match m { Some(_) => [], None => args };
                                        pure(into)
                                    }),
                                }),
                                HField(r, _, args) => pure(Cons(r, args)),
                                HCtor(_, _, _, fields) => pure(fields),
                                HLocal(_, args) => pure(args),
                                HMatch(scrut) => pure([scrut]),
                                _ => pure([]),
                            };
                            inside.bind(λ kids => rt_held_hoist(f, cx, w, k, made, st, kids, Cons(h.id, seen)).bind(λ done =>
                                rt_held_hoist(f, cx, w, k, made, done.fst, rest, done.snd)))
                        },
                    })),
                }
            },
        },
    }
}

fn rt_held_earlier<A>() → Tac<A> {
    rt_refuse("a record a function left behind is built on again: the record as it was before a call of another function of the record, or what an earlier call left, where a later call has changed it since (the span holds one record)")
}

// A record was settled and a value read after it made a call: the span
// no longer holds that record.
fn rt_held_still(before: HeldWalk, after: HeldWalk) → Tac<True> {
    match before.calls.len().same(after.calls.len()) { True => pure(trivial), False => rt_held_earlier() }
}

fn rt_held_uncompiled<A>(name: String) → Tac<A> {
    rt_refuse("a call of `" ++ name ++ "`, which is not a function of the record compiled as one (a `runtime fn` of the record, declared before this one)")
}

fn rt_held_built<A>() → Tac<A> {
    rt_refuse("the record a function leaves is not built from its fields, or left by a call of a function of the record")
}

// What the walk does, one function over its fuel: settle a record (and
// answer the stores it still needs), make a call, make every call some
// values read, and compute the fields of a record built on `base` that
// are not that record's own.
inductive HeldJob {
    Settle(s: Handle),
    Make(x: Handle),
    Ready(es: List<Handle>),
    Sets(base: Option<Handle>, fs: List<HeldField>, values: List<Handle>),
}

record HeldOut { w: HeldWalk, sets: List<HeldSet> }

fn rt_held_do(fuel: Nat, cx: HeldCx, w: HeldWalk, job: HeldJob) → Tac<HeldOut> {
    match fuel {
        Zero => rt_refuse("the body is deeper than the reflector's fuel"),
        Succ(f) => match job {
            Ready(es) => rt_held_pending(4096, cx.known(w), w, es).bind(λ p => match p {
                None => pure(HeldOut(w, [])),
                Some(x) => rt_held_do(f, cx, w, Make(x)).bind(λ made => rt_held_do(f, cx, made.w, Ready(es))),
            }),
            Make(x) => view(x).bind(λ v => match v {
                HGlobal(g, name, args) => rt_held_callee(cx.known(w), w.held, g, name, args).bind(λ c => match c {
                    None => rt_held_uncompiled(name),
                    Some(callee) => match args {
                        Nil => rt_held_built(),
                        Cons(s, operands) => rt_held_changes(cx.names, x).bind(λ changes => match changes {
                            False => rt_refuse("a call of `" ++ callee.name ++ "`, which only reads the record, is not reflected yet: a function of the record another one calls takes `mut self`"),
                            True => {
                                let settled <- rt_held_do(f, cx, w, Settle(s));
                                let ready <- rt_held_do(f, cx, settled.w, Ready(operands));
                                let still <- rt_held_still(settled.w, ready.w);
                                let k = cx.known(ready.w);
                                let ops <- rt_held_operands(f, k, ready.w.st, operands);
                                let read <- rt_held_hoist(4096, cx, ready.w, k, ready.w.calls ++ [CallRes(ready.w.calls.len(), g.id, x, None, [])], ops.fst, cx.roots, []);
                                let stored <- rt_held_stores(f, k, HeldStored(read.fst, ready.w.segs, ready.w.cfuns), settled.sets);
                                let found: Pair<List<Nat>, Nat> = match Known::index(stored.cfuns, callee.bytes, 0) {
                                    Some(i) => Pair(stored.cfuns, i),
                                    None => Pair(stored.cfuns ++ [callee.bytes], stored.cfuns.len()),
                                };
                                let st = stored.st;
                                pure(HeldOut(HeldWalk(st.written(Succ(st.depth)).forgetting(cx.terms()),
                                    Cons(FCall(found.snd, Cons(st.index(0), Cons(st.index(1), st.indices(ops.snd)))), FSeg::lets(st.lets) ++ stored.segs),
                                    found.fst, ready.w.calls ++ [CallRes(ready.w.calls.len(), g.id, x, Some(st.depth), [])], Some(x), HeldCall::add(ready.w.held, callee)), []))
                            },
                        }),
                    },
                }),
                _ => rt_held_built(),
            }),
            Settle(s) => view(s).bind(λ v => match v {
                HLocal(y, _) => match y.id.same(cx.record) {
                    False => rt_refuse("a function of a laid record leaves its own record"),
                    True => match w.now { None => pure(HeldOut(w, [])), Some(_) => rt_held_earlier() },
                },
                HCtor(cty, _, _, values) => match cty.id.same(cx.ty) {
                    False => rt_refuse("a function of a laid record leaves a record of its own type"),
                    True => rt_held_base(cx.record, cx.fs, values).bind(λ base => {
                        let under: Tac<HeldOut> = match base { None => pure(HeldOut(w, [])), Some(b) => rt_held_do(f, cx, w, Settle(b)) };
                        under.bind(λ o => rt_held_do(f, cx, o.w, Sets(base, cx.fs, values)))
                    }),
                },
                HMatch(_) => rt_refuse("the record a function leaves is chosen by a branch inside `Mutated`: write the branch around the whole result, each arm its own end"),
                _ => rt_field_read(s).bind(λ read => match read {
                    Some(p) => match Known::str_same(rt_base_name(p.snd), "after") {
                        False => rt_held_built(),
                        True => view(p.fst).bind(λ cv => match cv {
                            HGlobal(g, _, _) => rt_held_made(w.calls, g.id, p.fst).bind(λ made => match made {
                                None => rt_held_do(f, cx, w, Make(p.fst)),
                                Some(c) => match Succ(c.pos).same(w.calls.len()) { True => pure(HeldOut(w, [])), False => rt_held_earlier() },
                            }),
                            _ => rt_held_built(),
                        }),
                    },
                    None => match v {
                        HOther => next_spelling(Hd(s)).bind(λ c => match c { Accepted(u) => rt_held_do(f, cx, w, Settle(u)), Refused(_) => rt_held_built() }),
                        _ => rt_held_built(),
                    },
                }),
            }),
            Sets(base, fs, values) => match fs {
                Nil => pure(HeldOut(w, [])),
                Cons(field, rest) => match values {
                    Nil => rt_refuse("a record built from fewer fields than it has"),
                    Cons(value, more) => rt_held_kept(f, cx.known(w), value, base, field.name).bind(λ same => match same {
                        True => rt_held_do(f, cx, w, Sets(base, rest, more)),
                        False => rt_held_do(f, cx, w, Ready([value])).bind(λ r => {
                            let k = cx.known(r.w);
                            let still: Tac<True> = match base { None => pure(trivial), Some(_) => rt_held_still(w, r.w) };
                            still.bind(λ _ => match field.access {
                                None => match field.each {
                                    None => rt_refuse("it changes the field `" ++ field.name ++ "`, whose codec has no accessor: only a field stored as a word, or an array of them, is written for now"),
                                    Some(e) => {
                                        let settled: Bool = match r.w.now { None => True, Some(_) => False };
                                        let indexed <- rt_held_indexed(f, k, r.w.st, cx.record, settled, cx.under, base, field.name, e, value);
                                        match indexed {
                                            Some(own) => {
                                                let later <- rt_held_do(f, cx, r.w.with_st(own.fst), Sets(base, rest, more));
                                                pure(HeldOut(later.w, own.snd ++ later.sets))
                                            },
                                            None => match r.w.now {
                                                Some(_) => rt_refuse("it writes the array field `" ++ field.name ++ "` out anew after a call of another function of the record: store its elements with `vector_update`"),
                                                None => {
                                                    let own <- rt_held_elements(f, k, r.w.st, field.name, e, value, List::range(e.term.count));
                                                    let later <- rt_held_do(f, cx, r.w.with_st(own.fst), Sets(base, rest, more));
                                                    pure(HeldOut(later.w, own.snd ++ later.sets))
                                                },
                                            },
                                        }
                                    },
                                },
                                // The value at its own width, and then the
                                // word of a local that stands for it: read
                                // as the word of the value itself, a value
                                // that is a call's answer would be spelled
                                // on into the callee's body.
                                Some(a) => {
                                                                        let rv <- rt_go(f, k, r.w.st, value, True);
                                    let v <- assume(a.ty, "value", Some(cx.under)).bind(λ c => rt_accepted("a field's new value's local", c));
                                    let word <- next_spelling(rt_ap(a.wide, [Local(v.ref)])).bind(λ c => rt_accepted("a field's new value as a word", c));
                                    let rr <- rt_go(f, k, rv.fst.with_local(v.ref.id, RSt::level(rv.snd)), word, True);
                                    let later <- rt_held_do(f, cx, r.w.with_st(rr.fst), Sets(base, rest, more));
                                    pure(HeldOut(later.w, Cons(HeldSet(a, field.at, RSt::level(rr.snd), None), later.sets)))
                                },
                            })
                        }),
                    }),
                },
            },
        },
    }
}

// A body's end, as the walk leaves it: its term, the program's functions
// and computations, and the functions of the record it calls.
record HeldEnd { term: FTm, funs: List<Nat>, cfuns: List<Nat>, held: List<HeldCall> }

// The end of a walk that answers the variable at `level`.
fn rt_held_answer(w: HeldWalk, st: RSt, segs: List<FSeg>, cfuns: List<Nat>, level: Nat) → HeldEnd {
    HeldEnd(FSeg::close(FSeg::lets(st.lets) ++ segs, FTm::Pure(Var(st.index(level)))), st.funs, cfuns, w.held)
}

// A body in tail position.
fn rt_held_tail(fuel: Nat, cx: HeldCx, w: HeldWalk, h: Handle) → Tac<HeldEnd> {
    match fuel {
        Zero => rt_refuse("the body is deeper than the reflector's fuel"),
        Succ(f) => view(h).bind(λ v => match v {
            HCtor(cty, _, _, values) => match cty.id.same(cx.names.mutated) {
                False => rt_held_ends(),
                True => match values.rev() {
                    Cons(value, Cons(after, _)) => {
                        let at = cx.rooted([h]);
                        let settled <- rt_held_do(f, at, w, Settle(after));
                        let ready <- rt_held_do(f, at, settled.w, Ready([value]));
                        let still <- rt_held_still(settled.w, ready.w);
                        let k = cx.known(ready.w);
                        let rv <- rt_go(f, k, ready.w.st, value, True);
                        let done <- rt_held_stores(f, k, HeldStored(rv.fst, ready.w.segs, ready.w.cfuns), settled.sets);
                        pure(rt_held_answer(ready.w, done.st, done.segs, done.cfuns, RSt::level(rv.snd)))
                    },
                    _ => rt_refuse("`Mutated` without its record and value"),
                },
            },
            HMatch(_) => {
                let m <- arms(h).bind(λ c => rt_accepted("a `match`", c));
                let t <- cx.known(w).ty_of(m.scrut);
                match t {
                    Bit => {
                        let yes_h <- rt_arm(m, 1);
                        let no_h <- rt_arm(m, 0);
                        let ready <- rt_held_do(f, cx.rooted([m.scrut, yes_h, no_h]), w, Ready([m.scrut]));
                        let rc <- rt_go(f, cx.known(ready.w), ready.w.st, m.scrut, True);
                        let base = RSt(rc.fst.depth, [], rc.fst.memo, rc.fst.handles, rc.fst.locals, rc.fst.funs);
                        let ry <- rt_held_tail(f, cx, HeldWalk(base, [], ready.w.cfuns, ready.w.calls, ready.w.now, ready.w.held), yes_h);
                        let rn <- rt_held_tail(f, cx, HeldWalk(base.with_funs(ry.funs), [], ry.cfuns, ready.w.calls, ready.w.now, ry.held), no_h);
                        let c = rc.fst.index(RSt::level(rc.snd));
                        let node: FTm = match m.args { Nil => FTm::If(c, ry.term, rn.term), Cons(_, _) => FTm::IfEq(c, ry.term, rn.term) };
                        pure(HeldEnd(FSeg::close(FSeg::lets(rc.fst.lets) ++ ready.w.segs, node), rn.funs, rn.cfuns, rn.held))
                    },
                    _ => rt_refuse("a `match` on something other than a `Bool` (enums are not reflected yet)"),
                }
            },
            // A call of a function of the record that the body ends in:
            // what it leaves and its word are the body's.
            HGlobal(g, name, _) => {
                let made <- rt_held_do(f, cx.rooted([h]), w, Ready([h]));
                let call <- rt_held_made(made.w.calls, g.id, h);
                match call {
                    None => rt_held_uncompiled(name),
                    Some(c) => match Succ(c.pos).same(made.w.calls.len()) {
                        False => rt_held_earlier(),
                        True => pure(rt_held_answer(made.w, made.w.st, made.w.segs, made.w.cfuns, c.value.unwrap_or(0))),
                    },
                }
            },
            // The function's own call, in its step: the record it is made
            // on is stored, and the loop goes round on the span's place,
            // its length word and the call's words.
            HLocal(x, args) => match cx.ih.map(λ i => i.same(x.id)).unwrap_or(False) {
                False => rt_held_ends(),
                True => match args {
                    Nil => rt_refuse("a loop's own call without its record"),
                    Cons(after, more) => {
                        let operands = more.take(more.len().pred());
                        let at = cx.rooted(Cons(after, operands));
                        let settled <- rt_held_do(f, at, w, Settle(after));
                        let ready <- rt_held_do(f, at, settled.w, Ready(operands));
                        let still <- rt_held_still(settled.w, ready.w);
                        let k = cx.known(ready.w);
                        let ro <- rt_held_operands(f, k, ready.w.st, operands);
                        let done <- rt_held_stores(f, k, HeldStored(ro.fst, ready.w.segs, ready.w.cfuns), settled.sets);
                        let st = done.st;
                        pure(HeldEnd(FSeg::close(FSeg::lets(st.lets) ++ done.segs,
                            FTm::Again(Cons(st.index(0), Cons(st.index(1), ro.snd.map(λ l => st.index(l)))))), st.funs, done.cfuns, ready.w.held))
                    },
                },
            },
            _ => rt_held_ends(),
        }),
    }
}

// The words a function takes after its record: the body's `λ`s opened,
// each local at levels 2 on (the span's place and its length word are 0
// and 1), and the body under them.
record HeldWords { locals: List<LocalRef>, bound: List<Pair<Nat, Nat>>, body: Handle, last: LocalRef }

fn rt_held_words(fuel: Nat, k: Known, h: Handle, level: Nat, under: LocalRef) → Tac<HeldWords> {
    match fuel {
        Zero => pure(HeldWords([], [], h, under)),
        Succ(f) => view(h).bind(λ v => match v {
            HLam(dom) => k.ty(dom).bind(λ at => match (match at { Word(w) => w.same(64), _ => False }) {
                False => rt_refuse("a function of a laid record takes 64-bit words after its record, for now"),
                True => {
                    let o <- open(h, "x").bind(λ c => rt_accepted("a parameter", c));
                    let more <- rt_held_words(f, k, o.body, Succ(level), o.local.ref);
                    pure(HeldWords(Cons(o.local.ref, more.locals), Cons(Pair(o.local.ref.id, level), more.bound), more.body, more.last))
                },
            }),
            _ => pure(HeldWords([], [], h, under)),
        }),
    }
}

// The code of the value a body answers, and whether it answers it beside
// its record: its type is `Mutated<T, R>` at the record's type `T` where
// the function changes the record, and `R` where it only reads it.
fn rt_held_result(k: Known, names: FileNames, record: Handle, b: Handle) → Tac<Pair<Bool, Ty>> {
    let t <- infer(Hd(b)).bind(λ c => rt_accepted("its body's type", c));
    let v <- view(t);
    let read: Tac<Pair<Bool, Ty>> = k.ty(t).bind(λ r => pure(Pair(False, r)));
    match v {
        HGlobal(g, _, args) => match g.id.same(names.mutated) {
            True => match args {
                Cons(left, Cons(r, Nil)) => defeq(Hd(left), Hd(record)).bind(λ same => match same {
                    True => k.ty(r).bind(λ code => pure(Pair(True, code))),
                    False => rt_refuse("a function of a laid record that returns `Mutated` returns it of that record"),
                }),
                _ => rt_refuse("`Mutated` without its two types"),
            },
            False => read,
        },
        _ => read,
    }
}

// The only constructor of a record.
fn rt_held_ctor(tname: String, cs: List<CtorInfo>) → Tac<CtorInfo> {
    match cs {
        Nil => rt_refuse("`" ++ tname ++ "` has no constructor"),
        Cons(c, more) => match more { Nil => pure(c), Cons(_, _) => rt_refuse("`" ++ tname ++ "` is not a record: it has more than one constructor") },
    }
}

// The offsets a function's accessors are called at, where they are
// literals: the third operand, after the span's place and its length
// word, of a call of as many operands as a field's accessor takes (an
// element's checked accessor takes more, and its third is its array's). `known` is the literal that bound each variable, the most
// recent first.
fn rt_held_third(args: List<Nat>, operands: Nat, known: List<Option<Nat>>) → List<Nat> {
    match args.len().same(operands) {
        False => [],
        True => match args.nth(2) {
            None => [],
            Some(i) => match known.nth(i) { Some(lit) => match lit { Some(n) => [n], None => [] }, None => [] },
        },
    }
}

fn rt_held_has(ns: List<Nat>, n: Nat) → Bool { match ns { Nil => False, Cons(m, rest) => match m.same(n) { True => True, False => rt_held_has(rest, n) } } }

fn rt_held_offsets(t: FTm, known: List<Option<Nat>>, held: List<Nat>) → List<Nat> {
    match t {
        Pure(_) => [],
        Let(e, body) => match e {
            Call(_, args) => rt_held_third(args, 3, known) ++ rt_held_offsets(body, Cons(None, known), held),
            Lit(_, n) => rt_held_offsets(body, Cons(Some(n), known), held),
            _ => rt_held_offsets(body, Cons(None, known), held),
        },
        If(_, yes, no) => rt_held_offsets(yes, known, held) ++ rt_held_offsets(no, known, held),
        IfEq(_, yes, no) => rt_held_offsets(yes, known, held) ++ rt_held_offsets(no, known, held),
        Put(_, _, _, body) => rt_held_offsets(body, known, held),
        Call(f, args, body) => (match rt_held_has(held, f) { True => [], False => rt_held_third(args, 4, known) }) ++ rt_held_offsets(body, Cons(None, known), held),
        Again(_) => [],
        Lend(_, _, _, _) => [],
    }
}

// The elements a function reaches, each as a field of its own: the marks
// name an element's part where an accessor is called at its offset, and
// an array's other elements are not in them.
fn rt_held_reached(fs: List<HeldField>, offsets: List<Nat>) → List<HeldField> {
    match fs {
        Nil => [],
        Cons(f, rest) => match f.each {
            None => rt_held_reached(rest, offsets),
            Some(e) => List::range(e.term.count).filter(λ i => rt_held_has(offsets, e.term.base + i * e.term.stride))
                .map(λ i => HeldField(f.name ++ "[" ++ decimal_name(Succ(i), i) ++ "]", f.at, Some(e.access(i)), None)) ++ rt_held_reached(rest, offsets),
        },
    }
}

// The function `g`, whose first parameter is the record.
// A function that `decreases` is read from its step `g::body`, `λ k again
// record x… h => …`, its recursion `again(record′, y…, p)`.
fn rt_held_reflect_one(k: Known, names: FileNames, g: GlobalRef, name: String) → Tac<HeldReflected> {
    let fuel = 4096;
    let step <- lookup(name ++ "::body");
    let entered: Tac<Pair<Handle, Option<Pair<Nat, Nat>>>> = match step {
        Refused(_) => body(g).bind(λ c => rt_accepted("its body", c)).bind(λ b => pure(Pair(b, None))),
        Accepted(s) => {
            let t <- infer(Global(g)).bind(λ c => rt_accepted("its type", c));
            let n <- rt_arity(fuel, t);
            let sb <- body(s).bind(λ c => rt_accepted("its step's body", c));
            let o1 <- open(sb, "k").bind(λ c => rt_accepted("its step's bound", c));
            let o2 <- open(o1.body, "again").bind(λ c => rt_accepted("its step's recursion", c));
            pure(Pair(o2.body, Some(Pair(o2.local.ref.id, n.pred()))))
        },
    };
    let en <- entered;
    let b0 = en.fst;
    let o <- open(b0, "record").bind(λ c => rt_accepted("its record parameter", c));
    let record = o.local.ty;
    let rv <- view(record);
    let found: Tac<Pair<GlobalRef, String>> = match rv {
        HGlobal(rg, tname, args) => match args { Nil => pure(Pair(rg, tname)), Cons(_, _) => rt_refuse("a laid record has no type parameters") },
        _ => rt_refuse("its first parameter is not a record"),
    };
    let rg <- found;
    let tname = rg.snd;
    let stored <- lookup(tname ++ "::stored").bind(λ c => match c {
        Accepted(s) => pure(s),
        Refused(_) => rt_refuse("`" ++ tname ++ "` is not laid over bytes: declare it `laid record " ++ tname ++ "`"),
    });
    let cs <- ctors(record).bind(λ c => rt_accepted("its record's constructor", c));
    let ctor <- rt_held_ctor(tname, cs);
    let ws0 <- rt_held_words(match en.snd { None => fuel, Some(p) => p.snd }, k, o.body, 2, o.local.ref);
    // A step takes its measure's proof after its words.
    let opened: Tac<HeldWords> = match en.snd {
        None => pure(ws0),
        Some(_) => open(ws0.body, "h").bind(λ c => rt_accepted("its step's measure proof", c)).bind(λ oh =>
            pure(HeldWords(ws0.locals, ws0.bound, oh.body, oh.local.ref))),
    };
    let ws <- opened;
    let result <- rt_held_result(k, names, record, ws.body);
    let word <- as_type(rt_ap(Global(GlobalRef(k.bitvec)), [NatLit(64)])).bind(λ c => rt_accepted("a word's type", c));
    let bytes <- as_type(rt_ap(Global(GlobalRef(k.list)), [rt_ap(Global(GlobalRef(k.bitvec)), [NatLit(8)])])).bind(λ c => rt_accepted("a span's type", c));
    let span <- assume(Hd(bytes), "span", Some(ws.last)).bind(λ c => rt_accepted("a span's local", c));
    let length <- assume(Hd(word), "length", Some(span.ref)).bind(λ c => rt_accepted("a length word's local", c));
    let hf <- rt_held_fields(tname, o.local, stored, ctor.fields, Local(span.ref), Local(length.ref), length.ref);
    let cx = HeldCx(k.lending(1), names, rg.fst.id, o.local.ref.id, span.ref.id, hf.fields, hf.named, length.ref, [ws.body], en.snd.map(λ p => p.fst));
    let st = RSt(2 + ws.locals.len(), [], [], [], Cons(Pair(span.ref.id, 0), Cons(Pair(length.ref.id, 1), ws.bound)), k.funs);
    let w = HeldWalk(st, [], [], [], None, []);
    // A function that only reads the record is one value, its branches
    // values too: the function of the record is its value beside the
    // record as it was, and a branch around that is not a branch inside it.
    let walked: Tac<HeldEnd> = match result.fst {
        True => rt_held_tail(fuel, cx, w, ws.body),
        False => match en.snd {
            Some(_) => rt_refuse("a loop that only reads the record is not taken yet: give it `mut self`"),
            None => rt_go(fuel, cx.known(w), st, ws.body, True).bind(λ rv =>
                pure(HeldEnd(FSeg::close(FSeg::lets(rv.fst.lets), FTm::Pure(Var(rv.fst.index(RSt::level(rv.snd))))), rv.fst.funs, [], []))),
        },
    };
    let r <- walked;
    let params: List<Ty> = Cons(Word(64), Cons(Word(64), ws.locals.map(λ _ => Word(64))));
    let called: List<Nat> = List::range(r.cfuns.len()).filter(λ i => match r.cfuns.nth(i) {
        Some(g) => match r.held.filter(λ c => c.bytes.same(g)) { Nil => False, Cons(_, _) => True },
        None => False,
    });
    // The record's type as a handle under no binder: `record` lives under
    // a step's.
    let record_t <- as_type(Global(rg.fst)).bind(λ c => rt_accepted("its record's type", c));
    // And its fields' terms likewise, read again at a record under none.
    let fields: Tac<List<HeldField>> = match en.snd {
        None => pure(hf.fields),
        Some(_) => {
            let cs1 <- ctors(record_t).bind(λ c => rt_accepted("its record's constructor", c));
            let ctor1 <- rt_held_ctor(tname, cs1);
            let record1 <- assume(Hd(record_t), "record", None).bind(λ c => rt_accepted("a record's local", c));
            let span1 <- assume(Hd(bytes), "span", Some(record1.ref)).bind(λ c => rt_accepted("a span's local", c));
            let length1 <- assume(Hd(word), "length", Some(span1.ref)).bind(λ c => rt_accepted("a length word's local", c));
            rt_held_fields(tname, record1, stored, ctor1.fields, Local(span1.ref), Local(length1.ref), length1.ref).bind(λ h => pure(h.fields))
        },
    };
    let fs <- fields;
    pure(HeldReflected(FFun(params, result.snd, r.term, 1), r.funs, r.cfuns, record_t, tname, stored,
        fs ++ rt_held_reached(fs, rt_held_offsets(r.term, [], called)), ws.locals.len(), result.fst, r.held, match en.snd { None => False, Some(_) => True }))
}

// `tac` and `sort` as ordinary Heather over the `Io` capability: the first
// customers whose data is recursive, a list of the input's lines
// (issues/runtime-fn-arena-lists.md; docs/native-heap-arena-design.md §7).
//
// They are written in the shapes the default `runtime fn` setup lowers
// (docs/runtime-fn-setups-design.md §7.4): `for` over a list, `let mut`
// locals, statement `if` and `match`, and `mut self` calls on the world
// (docs/effects-capabilities-design.md). The calls are the word-level ones
// `rt_io` reflects (`Io::read_into` into a buffer the program keeps,
// `Io::write_from` of a span), so the reads and writes here are the
// machine's, results and errnos as words. No function here recurses, so
// nothing needs procedures. A line is a `List<BitVec(8)>` and the input a
// `List<List<BitVec(8)>>`, which the setup will lay out as arena cells
// (`native_arena`): `Cons` is a cell written at the arena's top, `Nil` the
// name 0, and a `for` over the list a walk down its cells. Every list here is
// built by consing and never changed, which is the arena's write-once
// discipline, so no lowering of these programs needs to update a cell.
//
// Until `runtime fn` lowers them (R6, then the arena cases of
// `Tm::lower_sound`), the builder tools in `native_heap_tools` are what
// `write-elf` compiles. `lib/_tests/native/runtime/line_tools_tests.hthr`
// states what these write on GNU's test cases (lines across reads, blank
// lines, a last line without a newline, lines alike, prefixes, bytes
// compared unsigned, failing reads and writes), and reads the builder `tac`
// against the same worlds where its source fits the kernel's fuel.
//
// What the meaning here leaves out is the arena's capacity. Running out of
// arena is a defined exit of the lowered program ("memory exhausted", GNU's
// failing status), not a value of the function: the lowering's theorem is
// partial correctness with that exit as one of the outcomes
// (docs/native-heap-arena-design.md §2), so the function is what the
// program does whenever the input fits.

import logic;
import nat;
import list;
import option;
import pair;
import bool;
import algebra;
import bitvec;
import linux_calls;
import linux_world;
import native_source;
import rt_io;

fn newline() → BitVec(8) { 10 }

// ---------------------------------------------------------------------------
// Reading lines

// The input read so far: the lines finished, the last first, and the line
// still open. Each finished line is consed onto the ones before it, so the
// list is the input's lines last first, which is the order an arena holds
// them in (each cell names the one before it).
record LineReader { done: List<List<BitVec(8)>>, open: List<BitVec(8)> }

fn LineReader::empty() → LineReader { LineReader([], []) }

// The reader after the bytes: each newline finishes the open line (with
// the newline kept when `keep_newline`), every other byte joins it.
fn LineReader::feed(self r: LineReader, bytes: List<BitVec(8)>, keep_newline: Bool) → LineReader {
    let mut done = r.done;
    let mut open = r.open;
    for c in bytes {
        if c.eq_bit(newline()) {
            if keep_newline { open := open ++ [c] }
            done := List::Cons(open, done);
            open := []
        } else {
            open := open ++ [c]
        }
    }
    LineReader(done, open)
}

// The lines, last first, once the input has ended: a last line with no
// newline is a line too.
fn LineReader::lines(self r: LineReader) → List<List<BitVec(8)>> {
    match r.open { Nil => r.done, Cons(_, _) => List::Cons(r.open, r.done) }
}

// The lines of the bytes, last first: what reading them in any chunks gives.
fn List::lines_last_first(self bytes: List<BitVec(8)>, keep_newline: Bool) → List<List<BitVec(8)>> {
    LineReader::empty().feed(bytes, keep_newline).lines()
}

// Standard input read to its end into `buf`, at most `capacity` bytes at a
// time, as lines, the last first; `None` if a read fails. `passes` bounds
// the reads, as a source's `Repeat` is bounded by its fuel. A failed read
// returns at once, with the world as that read left it.
fn Io::read_lines(mut self io: Io, buf: List<BitVec(8)>, capacity: BitVec(64), keep_newline: Bool, passes: List<Nat>)
    → Option<List<List<BitVec(8)>>>
{
    let mut r = LineReader::empty();
    let mut held = buf;
    for _ in passes {
        let got = io.read_into(Io::stdin(), held, capacity);
        if got.result.signed_lt_bit(0) { return None }
        if got.result.eq_bit(0) { break }
        held := got.buf;
        r := r.feed(span(got.buf, 0, got.result.toNat()), keep_newline)
    }
    Some(r.lines())
}

// ---------------------------------------------------------------------------
// Writing lines

// The bytes written to stdout, a write at a time, again for what is left
// until all are sent: whether all of it went. A failed write, or running out
// of passes, is `False`. The length is the buffer's length word.
fn Io::write_bytes(mut self io: Io, bytes: List<BitVec(8)>, passes: List<Nat>) → Bool {
    let len: BitVec(64) = BitVec::ofNat(bytes.len());
    let mut sent: BitVec(64) = 0;
    for _ in passes {
        if sent.eq_bit(len) { break }
        let wrote = io.write_from(Io::stdout(), bytes, sent, len.sub(sent));
        if wrote.signed_lt_bit(0) { return False }
        sent := sent.add(wrote)
    }
    sent.eq_bit(len)
}

// Each line written to stdout in the list's order: whether every write went.
fn Io::write_lines(mut self io: Io, lines: List<List<BitVec(8)>>, passes: List<Nat>) → Bool {
    for line in lines {
        let wrote = io.write_bytes(line, passes);
        if !wrote { return False }
    }
    True
}

// ---------------------------------------------------------------------------
// tac

// GNU's `tac` over stdin: its lines, each with its newline, written last
// first, and a last line without a newline written first and as it is
// ("a\nb" gives "ba\n"). A failed read or write exits 1. Reading conses
// each line onto the ones before it, so the list read is already the
// output's order. `buf` is the read buffer, `capacity` the most one read
// asks for.
fn Io::tac(mut self io: Io, buf: List<BitVec(8)>, capacity: BitVec(64), passes: List<Nat>) → BitVec(64) {
    let mut status: BitVec(64) = 0;
    let read = io.read_lines(buf, capacity, True, passes);
    match read {
        None => { status := 1 },
        Some(lines) => {
            let ok = io.write_lines(lines, passes);
            if !ok { status := 1 }
        },
    }
    status
}

// ---------------------------------------------------------------------------
// sort

// Whether one line comes before another in the C locale: its bytes,
// compared unsigned, are less at the first place they differ, or it is a
// proper prefix of the other.
fn List::bytes_before(self a: List<BitVec(8)>, b: List<BitVec(8)>) → Bool {
    let mut rest = b;
    for x in a {
        match rest {
            Nil => { return False },
            Cons(y, more) => {
                if x.unsigned_lt_bit(y) { return True }
                if y.unsigned_lt_bit(x) { return False }
                rest := more
            },
        }
    }
    match rest { Nil => False, Cons(_, _) => True }
}

// A line and its place in the list (counted from 1), or the place 0 for
// none. Lines alike are told apart by their places, so each is written once.
record LinePick { at: Nat, line: List<BitVec(8)> }

fn LinePick::none() → LinePick { LinePick(0, []) }

// Whether `a` comes before `b`: by bytes, then by place.
fn LinePick::before(self a: LinePick, b: LinePick) → Bool {
    a.line.bytes_before(b.line).or(b.line.bytes_before(a.line).not().and(Succ(a.at).leb(b.at)))
}

// The line of `lines` that comes next after this one in the order (the
// least of all, from none), or none after the last. One walk down the list,
// keeping the best so far beside its place.
fn LinePick::next_in(self last: LinePick, lines: List<List<BitVec(8)>>) → LinePick {
    let mut best = LinePick::none();
    let mut at = 0;
    for line in lines {
        at := at + 1;
        let here = LinePick(at, line);
        let later = last.at.same(0).or(last.before(here));
        let better = best.at.same(0).or(here.before(best));
        if later && better { best := here }
    }
    best
}

// The lines written to stdout in order, each with a newline: as many walks
// as there are lines, each writing the line next after the one written
// before it. The list is only read, so sorting allocates nothing, which
// keeps the arena write-once. Whether every write went.
fn Io::write_sorted(mut self io: Io, lines: List<List<BitVec(8)>>, passes: List<Nat>) → Bool {
    let mut ok = True;
    let mut last = LinePick::none();
    for _ in lines {
        let next = last.next_in(lines);
        let wrote = io.write_bytes(next.line, passes);
        if !wrote { ok := False; break }
        let ended = io.write_bytes([newline()], passes);
        if !ended { ok := False; break }
        last := next
    }
    ok
}

// GNU's `sort` over stdin in the C locale (`LC_ALL=C`): its lines, each
// written with a newline (a last line without one gets one), in byte
// order. A failed read or write exits 2, as GNU's does.
fn Io::sort(mut self io: Io, buf: List<BitVec(8)>, capacity: BitVec(64), passes: List<Nat>) → BitVec(64) {
    let mut status: BitVec(64) = 0;
    let read = io.read_lines(buf, capacity, False, passes);
    match read {
        None => { status := 2 },
        Some(lines) => {
            let ok = io.write_sorted(lines, passes);
            if !ok { status := 2 }
        },
    }
    status
}

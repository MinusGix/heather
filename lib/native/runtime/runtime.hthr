// `runtime fn`: the default setup, the `Compile` class, and the generator
// that marks a function for the machine (docs/native/runtime-fn-setups-design.md
// §2, §9; issues/runtime-fn-default-setup.md).
//
// An ordinary `fn` is kerneltime mathematics. Writing `runtime fn f` runs
// the generator `runtime` over the elaborated `f` (a declaration prefix,
// docs/metaprogramming/value-definitions-design.md §3), which
//
// - reflects `f`'s body into `rt` (`rt_reflect.hthr`), finding the other
//   runtime fns it calls;
// - judges it under the default setup, refusing with the reason;
// - and publishes, beside `f`, one group (all of it or none):
//
//   | `f::rt`       | the reflection, a `Fun`                                  |
//   | `f::world`    | what its meaning reads: no records, the program's        |
//   |               | signatures (`f` is entry 0, its callees after), and      |
//   |               | their meanings, which are the Heather functions          |
//   | `f::judged`   | `Fun::judge(f::rt, f::world) = Ok`, by evaluation         |
//   | `f::reflects` | `f::rt.meaning(f::world)(xs…) = f(xs…)`, by conversion    |
//   | `f::code`     | the FunctionIR function the default setup lowers it to   |
//   | `f::compile`  | the `Compile(f)` instance: the code, and its agreement   |
//   |               | with `f` wherever the table's functions are answered     |
//   |               | with their meanings                                      |
//   | `f::program`  | the FunctionIR program of `f` and every runtime fn it    |
//   |               | reaches, callees first, `f` last, each from its instance |
//   | `f::arities`  | how many words each function of the program takes, the   |
//   |               | last function's first                                    |
//   | `f::sources`  | the Heather function each function of the program is, at |
//   |               | each file                                                |
//   | `f::sourced`  | every function of the program evaluates to its own of    |
//   |               | `f::sources` (`program_linked_files`): what a caller of  |
//   |               | a function other than the last cites                     |
//   | `f::names`    | which function is where: each function's name as its     |
//   |               | characters' codes, a zero after each, the first's first  |
//   | `f::agrees`   | `program_eval(f::program, last, [xs…]) = f(xs…)`          |
//
// Nothing in the group is a proof about `f` written for `f`. The instance's
// agreement is `Fun::lower_sound` (`rt_lower.hthr`, proved once over `rt`)
// read at the reflection, and it lands on `f` because the reflection's
// meaning converts to `f` (the pin). A wrong reflection is refused by the
// kernel as a failed conversion, never compiled to a wrong program.
// `f::agrees` links the instances (design §16.9, §16.14): `Compile::part`
// for each, then `program_linked_sources`.
//
// A group's members cannot cite each other yet
// (issues/generate-group-internal-references.md), so each spells the
// reflection and the table out again; they are data, and small.
// `f::agrees` is `f::sourced` read at the last function, and for the same
// reason carries that proof again.

import logic;
import bool;
import nat;
import list;
import option;
import pair;
import char;
import string;
import tactic;
import derive;
import bitvec;
import rt;
import rt_reflect;
import rt_lower;
import function_ir;
import function_ir_eval;
import rt_loop;
import rt_file;
import rt_file_reflect;
import rt_held_reflect;

// ---------------------------------------------------------------------------
// The judgment: what the default setup compiles today, with the reason for
// what it does not. The lowering refuses everything the judgment refuses
// (it returns `None`), so soundness does not assume the judgment
// (design §16.5); the judgment is what turns a refusal into a reason.

inductive Verdict { Ok, Refused(why: String) }

fn Verdict::and(self a: Verdict, b: Verdict) → Verdict { match a { Ok => b, Refused(why) => Refused(why) } }

fn Ty::is_word64(self t: Ty) → Bool { match t { Word(w) => w.same(64), _ => False } }

fn Ty::all_word64(ts: List<Ty>) → Bool {
    match ts { Nil => True, Cons(t, rest) => t.is_word64().and(Ty::all_word64(rest)) }
}

// A code a call passes in one word: a 64-bit word, or a count (a loop's
// fuel, as `w.toNat()`).
fn Ty::is_held(self t: Ty) → Bool { match t { Word(w) => w.same(64), Count => True, _ => False } }

fn Ty::all_held(ts: List<Ty>) → Bool {
    match ts { Nil => True, Cons(t, rest) => t.is_held().and(Ty::all_held(rest)) }
}

fn Sig::is_words(self s: Sig) → Bool { Ty::all_held(s.params).and(s.result.is_word64()) }

// A code a function's boundary passes in one 64-bit word: the word, or a
// record of one such field (a type held by its repr, design §16.13). What
// `Ty::check_one_word` (`rt_lower.hthr`) accepts, as `Bool`.
fn Ty::is_one_word(self t: Ty, tys: Nat → RecInfo) → Bool {
    match t {
        Word(w) => w.same(64),
        Named(i) => match tys(i).fields { Cons(f, rest) => f.is_word64().and(match rest { Nil => True, Cons(_, _) => False }), Nil => False },
        _ => False,
    }
}

fn Ty::all_one_word(ts: List<Ty>, tys: Nat → RecInfo) → Bool {
    match ts { Nil => True, Cons(t, rest) => t.is_one_word(tys).and(Ty::all_one_word(rest, tys)) }
}

fn Ty::all_held_at(ts: List<Ty>, tys: Nat → RecInfo) → Bool {
    match ts { Nil => True, Cons(t, rest) => match t { Count => True, _ => t.is_one_word(tys) }.and(Ty::all_held_at(rest, tys)) }
}

// A signature a call passes and returns in words, a type held by its repr
// among them (what `Tm::lower_call` checks, as `Bool`).
fn Sig::is_held_at(self s: Sig, tys: Nat → RecInfo) → Bool {
    Ty::all_held_at(s.params, tys).and(s.result.is_one_word(tys))
}

fn Op::judge(self o: Op) → Verdict {
    match o {
        Get(_) => Refused("a byte read: byte buffers are not lowered yet (docs/native/runtime-fn-setups-design.md §16.6)"),
        Set(_) => Refused("a byte write: byte buffers are not lowered yet (docs/native/runtime-fn-setups-design.md §16.6)"),
        ConsLine(_) => Refused("a list of lines: arena lists are not lowered by the default setup yet"),
        _ => Ok,
    }
}

// A term of the function at entry 0 of `sigs`.
fn Tm::judge(self t: Tm, sigs: List<Sig>, tys: Nat → RecInfo) → Verdict {
    match t {
        Var(_) => Ok,
        Lit(c, _) => match c {
            Word(_) => Ok,
            Bit => Ok,
            _ => Refused("a literal that is not a word or a `Bool`: byte buffers and lists are not lowered yet"),
        },
        Prim(op, _) => op.judge(),
        Let(e, body) => e.judge(sigs, tys).and(body.judge(sigs, tys)),
        If(_, yes, no) => yes.judge(sigs, tys).and(no.judge(sigs, tys)),
        IfEq(_, yes, no) => yes.judge(sigs, tys).and(no.judge(sigs, tys)),
        Make(_, _) => Ok,
        Field(_, _, _) => Ok,
        Call(f, _) => match f {
            Zero => Refused("a call of itself that is not the last thing it does: a recursion is lowered as a loop, its calls of itself in tail position (docs/native/runtime-fn-setups-design.md §16.11)"),
            Succ(_) => match Sig::at(sigs, f).is_held_at(tys) {
                True => Ok,
                False => Refused("a call of a function that does not take and return 64-bit words (issues/function-ir-multi-word-calls.md)"),
            },
        },
        Fold(_, _, _) => Refused("a `foldl`: loops over buffers are not lowered yet (docs/native/runtime-fn-setups-design.md §16.6)"),
        Case(_, _, _) => Refused("a `match` on a `Nat` that is not a loop's fuel: only a fuel recursion's top `match` is lowered"),
        Byte(_, _, _) => Ok,
    }
}

// A loop's pass: calls of itself only in tail position.
fn Tm::judge_tail(self t: Tm, sigs: List<Sig>, tys: Nat → RecInfo) → Verdict {
    match t {
        Let(e, body) => e.judge(sigs, tys).and(body.judge_tail(sigs, tys)),
        If(_, yes, no) => yes.judge_tail(sigs, tys).and(no.judge_tail(sigs, tys)),
        IfEq(_, yes, no) => yes.judge_tail(sigs, tys).and(no.judge_tail(sigs, tys)),
        Call(f, args) => match f { Zero => Ok, Succ(g) => Call(Succ(g), args).judge(sigs, tys) },
        Var(i) => Var(i).judge(sigs, tys),
        Lit(c, n) => Lit(c, n).judge(sigs, tys),
        Prim(op, args) => Prim(op, args).judge(sigs, tys),
        Make(i, args) => Make(i, args).judge(sigs, tys),
        Field(i, k, of) => Field(i, k, of).judge(sigs, tys),
        Fold(over, init, step) => Fold(over, init, step).judge(sigs, tys),
        Case(c, zero, succ) => Case(c, zero, succ).judge(sigs, tys),
        Byte(k, i, length) => Byte(k, i, length).judge(sigs, tys),
    }
}

fn Fun::words_reason() → String {
    "a parameter that is not a 64-bit word: the default setup compiles functions from 64-bit words (and a loop's `Nat` fuel, first) to a 64-bit word (issues/function-ir-multi-word-calls.md)"
}

fn Fun::loop_words_reason() → String {
    "a loop over something other than 64-bit words: a loop's state is words, or types held by their repr in one"
}

// The function at entry 0 of its world's table: 64-bit words in and out
// (FunctionIR's calling convention today), and a body of what the lowering
// covers; a fuel recursion and a measured one are loops (design §16.11).
fn Fun::judge(self f: Fun, w: World) → Verdict {
    match f.result.is_one_word(w.tys) {
        False => Refused("a result that is not a 64-bit word: the default setup compiles functions from 64-bit words to a 64-bit word (issues/function-ir-multi-word-calls.md)"),
        True => match f.shape() {
            // The boundary passes a type held by its repr in one word
            // (`SInt(64)`, design §16.13), a loop's state among them.
            Plain => match Ty::all_one_word(f.params, w.tys) {
                False => Refused(Fun::words_reason()),
                True => f.body.judge(w.sigs, w.tys),
            },
            Fuel(w0, wrest, zero, succ) => match Ty::all_one_word(Cons(w0, wrest), w.tys) {
                False => Refused(Fun::loop_words_reason()),
                True => match f.body {
                    Case(c, _, _) => match c.same(Succ(wrest.len())) {
                        False => Refused("a `match` on a `Nat` that is not the fuel, its first parameter"),
                        True => zero.judge(w.sigs, w.tys).and(succ.judge_tail(w.sigs, w.tys)),
                    },
                    _ => Refused("a fuel recursion's body is its fuel's `match`"),
                },
            },
            Measured(ks, w0, wrest, body) => match Ty::all_one_word(ks ++ Cons(w0, wrest), w.tys) {
                False => Refused(Fun::loop_words_reason()),
                True => body.judge_tail(w.sigs, w.tys),
            },
        },
    }
}

// ---------------------------------------------------------------------------
// A setup (design §2.1): a judgment, a lowering, and the lowering's
// soundness, proved once. Every setup reads the same `rt`.

record Setup {
    name: String,
    judge: Fun → World → Verdict,
    lower: Fun → World → Option<Function>,
    sound: (f: Fun) → (w: World) → f.Holds(w, lower(f, w)),
    // The lowering reads the world's type table and signatures, never its
    // callees' meanings or its file, so one code serves a function at every
    // file (docs/native/native-one-compiler-design.md §2.3).
    static: (f: Fun) → (w: World) → (cs: Sig::Sems(w.tys, w.sigs)) → (spans: List<List<BitVec(8)>>) → lower(f, w.over(cs, spans)) = lower(f, w),
}

// The default setup: abstract programming over words and `Bool`, lowered
// to FunctionIR (design §7, `rt_lower.hthr`), a fuel recursion and a
// measured one as loops (`rt_loop.hthr`).
fn Setup::default() → Setup {
    Setup("default", Fun::judge, Fun::lower_any, λ f w => Fun::lower_any_sound(f, w), λ f w cs spans => Fun::lower_any_static(f, w, cs, spans))
}

fn Setup::lowers(r: Option<Function>) → Bool { match r { None => False, Some(_) => True } }

// The lowered function, or an empty one where the lowering refused (which
// the generator never publishes: it checks `Setup::lowered` first).
fn Setup::code_of(r: Option<Function>) → Function { match r { None => Function([], nodes_region(Nil), 0), Some(c) => c } }

fn Setup::code(self s: Setup, f: Fun, w: World) → Function { Setup::code_of(s.lower(f, w)) }

fn Setup::lowered(self s: Setup, f: Fun, w: World) → Bool { Setup::lowers(s.lower(f, w)) }

// How many words a table's entry takes.
fn Sig::arity(sigs: List<Sig>, k: Nat) → Option<Nat> {
    match sigs { Nil => None, Cons(s, rest) => match k { Zero => Some(s.params.len()), Succ(i) => Sig::arity(rest, i) } }
}

// How many words a table's callee takes: an entry after the first, which
// is the function itself and is never called by its index (a recursion is
// a loop in the code).
fn Sig::callee_arity(sigs: List<Sig>) → Nat → Option<Nat> {
    λ k => match k { Zero => None, Succ(i) => Sig::arity(sigs, Succ(i)) }
}

fn World::callee_arity(self w: World) → Nat → Option<Nat> { Sig::callee_arity(w.sigs) }

// What an instance checks of its lowering, in one evaluation of it: that it
// produced code, and that the code's calls fit the world's table at its
// callees (`World::callee_arity`). The second is what a program that links
// the code cites instead of reading the code again (`Compile::part`).
fn Setup::passes(r: Option<Function>, w: World) → Bool {
    match r { None => False, Some(c) => c.calls_fit(w.callee_arity()) }
}

fn Setup::checked(self s: Setup, f: Fun, w: World) → Bool { Setup::passes(s.lower(f, w), w) }

theorem Setup::passes_lowers(r: Option<Function>, w: World): Setup::passes(r, w).IsTrue() → Setup::lowers(r).IsTrue() {
    match r { None => λ never => never, Some(_) => λ _ => trivial }
}

theorem Setup::passes_fits(r: Option<Function>, w: World): Setup::passes(r, w).IsTrue() →
    Setup::code_of(r).calls_fit(w.callee_arity()).IsTrue() {
    match r { None => λ never => false_elim(never), Some(_) => λ ok => ok }
}

theorem Setup::checked_lowered(s: Setup, f: Fun, w: World, ok: s.checked(f, w) = True): s.lowered(f, w).IsTrue() {
    Setup::passes_lowers(s.lower(f, w), w, Bool::is_true_of_eq(ok))
}

theorem Setup::checked_fits(s: Setup, f: Fun, w: World, ok: s.checked(f, w) = True): s.code(f, w).calls_fit(w.callee_arity()).IsTrue() {
    Setup::passes_fits(s.lower(f, w), w, Bool::is_true_of_eq(ok))
}

// Read at an abstract lowering (docs/proof-patterns.md §1): a lowering that
// produced code answers with the function's meaning.
theorem Setup::of_lowered(f: Fun, w: World, r: Option<Function>): Setup::lowers(r).IsTrue() → f.LowerHolds(w, r) →
    (call: Answers()) → Tm::CallsAgree(w, call) →
    Ty::Answers(w.tys, f.params, f.result, f.meaning(w), λ xs => Setup::code_of(r).eval(call, xs, buffers := w.spans)) {
    match r {
        None => λ never _ => false_elim(never),
        Some(_) => λ _ holds => holds,
    }
}

// What a setup promises at a shape the function has: `f.Holds` read there.
theorem Setup::holds_at(s: Setup, f: Fun, w: World, shape: RtShape, shaped: f.shape() = shape): f.HoldsAt(w, shape, s.lower(f, w)) {
    j(shaped, λ x _ => f.HoldsAt(w, x, s.lower(f, w)), s.sound(f, w))
}

// What a setup's code means, wherever the setup lowered a plain function:
// the agreement every loop-free `runtime fn` reads off, with `ok` checked by
// evaluation and `plain` by evaluation too.
theorem Setup::code_answers(s: Setup, f: Fun, w: World, ok: s.lowered(f, w).IsTrue(), plain: f.shape() = Plain):
    (call: Answers()) → Tm::CallsAgree(w, call) →
    Ty::Answers(w.tys, f.params, f.result, f.meaning(w), λ xs => s.code(f, w).eval(call, xs, buffers := w.spans)) {
    Setup::of_lowered(f, w, s.lower(f, w), ok, Setup::holds_at(s, f, w, Plain, plain))
}

// What a setup lowered at one world it lowered at every file and every
// table of meanings, and to the same code.
theorem Setup::lowered_over(s: Setup, f: Fun, w: World, cs: Sig::Sems(w.tys, w.sigs), spans: List<List<BitVec(8)>>,
    ok: s.lowered(f, w).IsTrue()): s.lowered(f, w.over(cs, spans)).IsTrue() {
    j(sym(s.static(f, w, cs, spans)), λ r _ => Setup::lowers(r).IsTrue(), ok)
}

// A world at a file: its table of meanings there, and the file. Every
// statement below names the world at a file by this one spelling, its type
// table included (`w.at(callees, b).tys`, never `w.tys`): the two convert,
// but a generated instance is checked at a reflection spelled out in full,
// and where two spellings of one world meet the kernel compares that
// reflection instead of passing over it.
fn World::at(self w: World, callees: (b: Buffers()) → Sig::Sems(w.tys, w.sigs), b: Buffers()) → World { w.over(callees(b), b) }

// ---------------------------------------------------------------------------
// A function at a file (docs/native/native-one-compiler-design.md §2.3, U3c). A
// function lent spans takes, in Heather, each span's bytes and then its
// length word: `f(span, length, words…)`. Its code takes the span's home
// instead, two words (where the bytes are, how many), and reads the bytes
// from the file it runs over. So the code is one, and what it computes is
// the function at that file's spans: `Ty::lend`. With no span lent the two
// are the same type and `Ty::lend` changes nothing.

// The type of a function lent `lent` spans, whose code takes `ps`.
fn Ty::Lent(tys: Nat → RecInfo, lent: Nat, ps: List<Ty>, r: Ty) → Type {
    match lent {
        Zero => Ty::Arrows(tys, ps, r),
        Succ(n) => match ps {
            Nil => Ty::Arrows(tys, Nil, r),
            Cons(place, more) => match more {
                Nil => Ty::Arrows(tys, [place], r),
                Cons(length, rest) => List<BitVec(8)> → length.sem(tys) → Ty::Lent(tys, n, rest, r),
            },
        },
    }
}

// Such a function at the file `b`: span `k` is `b`'s, and the word where
// its bytes are is not read.
fn Ty::lend(tys: Nat → RecInfo, r: Ty, b: Buffers(), lent: Nat) → (k: Nat) → (ps: List<Ty>) → Ty::Lent(tys, lent, ps, r) → Ty::Arrows(tys, ps, r) {
    match lent {
        Zero => λ k ps v => v,
        Succ(n) => λ k ps => match ps as λ qs => Ty::Lent(tys, Succ(n), qs, r) → Ty::Arrows(tys, qs, r) {
            Nil => λ v => v,
            Cons(place, more) => match more as λ qs => Ty::Lent(tys, Succ(n), Cons(place, qs), r) → Ty::Arrows(tys, Cons(place, qs), r) {
                Nil => λ v => v,
                Cons(_, rest) => λ v => λ _ len => Ty::lend(tys, r, b, n, Succ(k), rest, v(List::span(b, k), len)),
            },
        },
    }
}

// A type as a term of `Type`: a bare variable in a motive's body reads as
// a type name, and a class field that names its carrier as a term in an
// equation (`F = T`) is refused at a generic use of the class
// (issues/class-carrier-as-term.md); through `Itself` both work.
fn Itself(T: Type) → Type { T }

// A value read at a type it is equal to: itself, at `refl`.
fn retype<F>(T: Type, e: Itself(F) = Itself(T), f: F) → T { j(e, λ x _ => Itself(x), f) }

// A function of any type `F` that is a lent function's, at the file `b`.
fn Ty::lent_at<F>(tys: Nat → RecInfo, lent: Nat, ps: List<Ty>, r: Ty, typed: Itself(F) = Itself(Ty::Lent(tys, lent, ps, r)), f: F, b: Buffers())
    → Ty::Arrows(tys, ps, r) {
    Ty::lend(tys, r, b, lent, 0, ps, retype(Ty::Lent(tys, lent, ps, r), typed, f))
}

// The `Compile` class (design §9.3): a function's code and the code's
// agreement with the function, keyed on the function itself (an
// operation-indexed class, docs/language/classes/operation-indexed-classes-design.md). The
// `runtime` generator publishes an instance per runtime fn; a hand-written
// instance (tuned FunctionIR and its proof) is one too.
//
// The agreement is stated at every file `b`: run over `b`, the code returns
// what the function does at `b`'s spans (`Ty::lent_at`). The code answers
// its calls by index into `world`'s table, so the agreement assumes every
// function of the table is answered with its meaning at that file
// (`callees(b)`, `Tm::CallsAgree`): a program built from the callees' own
// instances discharges that (`Compile::part`, below). A function lent
// nothing has one table, `world.callees`, at every file (`World::fixed`).
// `typed` is `refl` at every instance and every file: it is what lets the
// class state the agreement about `f` itself while `f`'s type is any `F`.
class Compile<F>(f: F) {
    reflected: Fun,
    world: World,
    callees: (b: Buffers()) → Sig::Sems(world.tys, world.sigs),
    typed: (b: Buffers()) → Itself(F) = Itself(Ty::Lent(world.at(callees, b).tys, reflected.lent, reflected.params, reflected.result)),
    code: Function,
    agrees: (b: Buffers()) → (call: Answers()) → Tm::CallsAgree(world.at(callees, b), call) →
        Ty::Answers(world.at(callees, b).tys, reflected.params, reflected.result,
            Ty::lent_at(world.at(callees, b).tys, reflected.lent, reflected.params, reflected.result, typed(b), f, b),
            λ xs => code.eval(call, xs, buffers := b)),
    // The code's calls name callees of the table at their arity: checked
    // once, here, by evaluation, and cited by every program the code is
    // linked into (`Compile::part`).
    fits: code.calls_fit(world.callee_arity()).IsTrue(),
}

// A world's own table, at every file: the table of a function lent nothing.
fn World::fixed(self w: World) → (b: Buffers()) → Sig::Sems(w.tys, w.sigs) { λ _ => w.callees }

// `Itself(F) = Itself(F)` with `F` read off `f`: what the generator passes
// for `typed`, `F` being a type it cannot spell as a term. A definition, not
// a theorem: `retype` along it must compute.
fn Setup::typed_refl<F>(f: F) → (b: Buffers()) → Itself(F) = Itself(F) { λ _ => refl }

// `x = x` at every file: the pin of a function lent nothing, spelled with
// no binder.
theorem Setup::at_every<A>(x: A): (b: Buffers()) → x = x { λ _ => refl }

// The same for a function lent spans: it at each file, spelled with no
// binder.
theorem Setup::lent_every<F>(f: F, w: World, callees: (b: Buffers()) → Sig::Sems(w.tys, w.sigs), lent: Nat, ps: List<Ty>, r: Ty,
    typed: (b: Buffers()) → Itself(F) = Itself(Ty::Lent(w.at(callees, b).tys, lent, ps, r))):
    (b: Buffers()) → Ty::lent_at(w.at(callees, b).tys, lent, ps, r, typed(b), f, b) = Ty::lent_at(w.at(callees, b).tys, lent, ps, r, typed(b), f, b) {
    λ _ => refl
}

// `Itself(F) = Itself(F)` at no file: `typed` for a table's entry, which
// is stated before its world is.
fn Setup::typed_once<F>(f: F) → Itself(F) = Itself(F) { refl }

// The table of a function lent spans, an entry at a time: each function at
// each file's spans. The function itself is entry 0 (one that calls itself
// over a span is in its own table at that span), the functions it calls
// come after it, and one lent nothing is itself at every file.
fn Setup::callees_nil(tys: Nat → RecInfo) → (b: Buffers()) → Sig::Sems(tys, Nil) { λ _ => trivial }

fn Setup::lent_callees<F>(f: F, tys: Nat → RecInfo, lent: Nat, ps: List<Ty>, r: Ty, typed: Itself(F) = Itself(Ty::Lent(tys, lent, ps, r)),
    sigs: List<Sig>, rest: (b: Buffers()) → Sig::Sems(tys, sigs)) → (b: Buffers()) → Sig::Sems(tys, Cons(Sig(ps, r), sigs)) {
    λ b => Pair(Ty::lent_at(tys, lent, ps, r, typed, f, b), rest(b))
}

// A runtime fn's instance, from its reflection: the default setup's code
// and the agreement `Setup::code_answers` gives at each file, carried to
// `f` along the pin and to the one code along `static`. At a runtime fn
// `typed` and `pinned` are both `refl`, which the kernel checks by
// conversion (the reflection's meaning unfolds to `f`'s body node for node,
// docs/native/runtime-fn-setups-design.md §4.3), and `ok` and `plain` are
// evaluation, once, at `w`.
//
// The agreement is a theorem of its own, stated as the class states it: a
// generated instance is checked with `Setup::compile` unfolded at the
// function's reflection, and what stands there is then one opaque
// application whose statement is the field's type letter for letter, where
// the proof spelled in place would have the kernel compare the reflection's
// code at two spellings of one world.
theorem Setup::plain_agrees<F>(f: F, s: Setup, rt: Fun, w: World, callees: (b: Buffers()) → Sig::Sems(w.tys, w.sigs),
    typed: (b: Buffers()) → Itself(F) = Itself(Ty::Lent(w.at(callees, b).tys, rt.lent, rt.params, rt.result)),
    pinned: (b: Buffers()) → Ty::lent_at(w.at(callees, b).tys, rt.lent, rt.params, rt.result, typed(b), f, b) = rt.meaning(w.at(callees, b)),
    ok: s.checked(rt, w) = True, plain: rt.shape() = Plain):
    (b: Buffers()) → (call: Answers()) → Tm::CallsAgree(w.at(callees, b), call) →
    Ty::Answers(w.at(callees, b).tys, rt.params, rt.result, Ty::lent_at(w.at(callees, b).tys, rt.lent, rt.params, rt.result, typed(b), f, b),
        λ xs => s.code(rt, w).eval(call, xs, buffers := b)) {
    λ b call agree =>
        j(sym(pinned(b)), λ g _ => Ty::Answers(w.at(callees, b).tys, rt.params, rt.result, g, λ xs => s.code(rt, w).eval(call, xs, buffers := b)),
            j(s.static(rt, w, callees(b), b), λ r _ => Ty::Answers(w.at(callees, b).tys, rt.params, rt.result, rt.meaning(w.at(callees, b)),
                    λ xs => Setup::code_of(r).eval(call, xs, buffers := b)),
                Setup::code_answers(s, rt, w.at(callees, b),
                    Setup::lowered_over(s, rt, w, callees(b), b, Setup::checked_lowered(s, rt, w, ok)), plain, call, agree)))
}

// `f` comes after the reflection and the table. Two instances met in a link
// are two applications of this function, which the kernel compares argument
// by argument before it unfolds either: two different functions are then
// told apart at their reflections, which are data, and the functions
// themselves are never compared (issues/runtime-link-compares-functions.md).
fn Setup::compile<F>(s: Setup, rt: Fun, w: World, callees: (b: Buffers()) → Sig::Sems(w.tys, w.sigs), f: F,
    typed: (b: Buffers()) → Itself(F) = Itself(Ty::Lent(w.at(callees, b).tys, rt.lent, rt.params, rt.result)),
    pinned: (b: Buffers()) → Ty::lent_at(w.at(callees, b).tys, rt.lent, rt.params, rt.result, typed(b), f, b) = rt.meaning(w.at(callees, b)),
    ok: s.checked(rt, w) = True, plain: rt.shape() = Plain) → Compile<F>(f)
{
    Compile(rt, w, callees, typed, s.code(rt, w), Setup::plain_agrees(f, s, rt, w, callees, typed, pinned, ok, plain), Setup::checked_fits(s, rt, w, ok))
}

// A fuel recursion's instance (design §16.11): no pin (the function at an
// open fuel is stuck on it), but its two equations, `zero` and `step`,
// each `refl` per word at the function itself, and the loop's soundness
// read at the function. The reflection is the function of the pieces. A
// fuel loop is lent nothing.
fn Setup::fuel_fun(w0: Ty, wrest: List<Ty>, res: Ty, c: Nat, zero, succ: Tm) → Fun { Fun(Cons(Count, Cons(w0, wrest)), res, Case(c, zero, succ)) }

theorem Setup::fuel_agrees<F>(f: F, s: Setup, w0: Ty, wrest: List<Ty>, res: Ty, c: Nat, zero, succ: Tm, w: World,
    callees: (b: Buffers()) → Sig::Sems(w.tys, w.sigs),
    typed: (b: Buffers()) → Itself(F) = Itself(Ty::Arrows(w.at(callees, b).tys, Cons(Count, Cons(w0, wrest)), res)),
    shaped: Setup::fuel_fun(w0, wrest, res, c, zero, succ).shape() = Fuel(w0, wrest, zero, succ),
    zero_eq: (b: Buffers()) → Fun::FuelZero(Cons(w0, wrest), res, zero, w.at(callees, b),
        retype(Ty::Arrows(w.at(callees, b).tys, Cons(Count, Cons(w0, wrest)), res), typed(b), f)),
    step_eq: (b: Buffers()) → (n: Nat) → Fun::FuelStep(Cons(w0, wrest), res, succ, w.at(callees, b),
        retype(Ty::Arrows(w.at(callees, b).tys, Cons(Count, Cons(w0, wrest)), res), typed(b), f), n),
    ok: s.checked(Setup::fuel_fun(w0, wrest, res, c, zero, succ), w) = True):
    (b: Buffers()) → (call: Answers()) → Tm::CallsAgree(w.at(callees, b), call) →
    Ty::Answers(w.at(callees, b).tys, Cons(Count, Cons(w0, wrest)), res,
        Ty::lent_at(w.at(callees, b).tys, 0, Cons(Count, Cons(w0, wrest)), res, typed(b), f, b),
        λ xs => s.code(Setup::fuel_fun(w0, wrest, res, c, zero, succ), w).eval(call, xs, buffers := b)) {
    let rt = Setup::fuel_fun(w0, wrest, res, c, zero, succ);
    λ b call agree => {
        let h = retype(Ty::Arrows(w.at(callees, b).tys, Cons(Count, Cons(w0, wrest)), res), typed(b), f);
        j(s.static(rt, w, callees(b), b), λ r _ => Ty::Answers(w.at(callees, b).tys, Cons(Count, Cons(w0, wrest)), res, h,
                λ xs => Setup::code_of(r).eval(call, xs, buffers := b)),
            Fun::fuel_answers(Cons(w0, wrest), res, w.at(callees, b), h, s.lower(rt, w.at(callees, b)),
                Setup::lowered_over(s, rt, w, callees(b), b, Setup::checked_lowered(s, rt, w, ok)),
                Setup::holds_at(s, rt, w.at(callees, b), Fuel(w0, wrest, zero, succ), shaped, h, zero_eq(b), step_eq(b)), call, agree))
    }
}

// `f` after the reflection and the table, as in `Setup::compile`.
fn Setup::compile_fuel<F>(s: Setup, w0: Ty, wrest: List<Ty>, res: Ty, c: Nat, zero, succ: Tm, w: World,
    callees: (b: Buffers()) → Sig::Sems(w.tys, w.sigs), f: F,
    typed: (b: Buffers()) → Itself(F) = Itself(Ty::Arrows(w.at(callees, b).tys, Cons(Count, Cons(w0, wrest)), res)),
    shaped: Setup::fuel_fun(w0, wrest, res, c, zero, succ).shape() = Fuel(w0, wrest, zero, succ),
    zero_eq: (b: Buffers()) → Fun::FuelZero(Cons(w0, wrest), res, zero, w.at(callees, b),
        retype(Ty::Arrows(w.at(callees, b).tys, Cons(Count, Cons(w0, wrest)), res), typed(b), f)),
    step_eq: (b: Buffers()) → (n: Nat) → Fun::FuelStep(Cons(w0, wrest), res, succ, w.at(callees, b),
        retype(Ty::Arrows(w.at(callees, b).tys, Cons(Count, Cons(w0, wrest)), res), typed(b), f), n),
    ok: s.checked(Setup::fuel_fun(w0, wrest, res, c, zero, succ), w) = True) → Compile<F>(f)
{
    Compile(Setup::fuel_fun(w0, wrest, res, c, zero, succ), w, callees, typed, s.code(Setup::fuel_fun(w0, wrest, res, c, zero, succ), w),
        Setup::fuel_agrees(f, s, w0, wrest, res, c, zero, succ, w, callees, typed, shaped, zero_eq, step_eq, ok),
        Setup::checked_fits(s, Setup::fuel_fun(w0, wrest, res, c, zero, succ), w, ok))
}

// A measured recursion's instance: its measure `m` below `2^64` and
// `Guarded` at every file, which the generator proves from the function's
// own `f::ext` and `f::irrel`, and the loop's soundness read at the
// function. `ks` are the words the loop keeps in place, the homes of the
// `lent` spans.
fn Setup::measured_fun(ks: List<Ty>, w0: Ty, wrest: List<Ty>, res: Ty, body: Tm, lent: Nat) → Fun { Fun(ks ++ Cons(w0, wrest), res, body, lent) }

// A measured function's `Guarded` at every file: what the generator proves,
// named here so that a module marking a runtime fn needs only
// `import runtime;` and its listed imports
// (issues/runtime-generator-imports.md), not `rt_loop`, `nat` or `logic`.
fn Setup::Guarded<F>(f: F, lent: Nat, ws: List<Ty>, res: Ty, body: Tm, w: World, callees: (b: Buffers()) → Sig::Sems(w.tys, w.sigs),
    typed: (b: Buffers()) → Itself(F) = Itself(Ty::Lent(w.at(callees, b).tys, lent, ws, res)), m: List<BitVec(64)> → Nat) → Type {
    (b: Buffers()) → Fun::Guarded(ws, res, body, w.at(callees, b), Ty::lent_at(w.at(callees, b).tys, lent, ws, res, typed(b), f, b), m)
}

// The spans a function lent `lent` of them reads at a file, as a file of
// their own: the file's first `lent`.
fn Setup::span_at(b: Buffers(), k: Nat) → List<BitVec(8)> { b.span(k) }

fn Setup::spans_from(lent: Nat, k: Nat, b: Buffers()) → Buffers() {
    match lent { Zero => Nil, Succ(n) => Cons(Setup::span_at(b, k), Setup::spans_from(n, Succ(k), b)) }
}

fn Setup::spans_of(lent: Nat, b: Buffers()) → Buffers() { Setup::spans_from(lent, 0, b) }

// A function lent spans, at the file that is just those spans, in words:
// the function at those spans, which is what its recursion is.
fn Setup::at_spans<F>(f: F, lent: Nat, ws: List<Ty>, res: Ty, w: World, callees: (b: Buffers()) → Sig::Sems(w.tys, w.sigs),
    typed: (b: Buffers()) → Itself(F) = Itself(Ty::Lent(w.at(callees, b).tys, lent, ws, res)), spans: Buffers()) → Ty::Arrows(w.tys, ws, res) {
    Ty::lent_at(w.at(callees, spans).tys, lent, ws, res, typed(spans), f, spans)
}

// The same for a function lent spans, as its generator proves it
// (`Fun::GuardedBy`): at every file, with the recursion answered at every
// list of spans, which is what the function's own `f::ext` can use (it asks
// its recursions to agree at every span, of each it is lent). The worlds
// are the files as they stand, so the body's meaning is spelled once; the
// function is spelled at the file of the file's first `lent` spans, where
// the hypothesis has it.
fn Setup::GuardedSpans<F>(f: F, lent: Nat, ws: List<Ty>, res: Ty, body: Tm, w: World, callees: (b: Buffers()) → Sig::Sems(w.tys, w.sigs),
    typed: (b: Buffers()) → Itself(F) = Itself(Ty::Lent(w.at(callees, b).tys, lent, ws, res)), m: List<BitVec(64)> → Nat) → Type {
    Fun::GuardedBy(ws, res, body, λ (b: Buffers()) => w.at(callees, b),
        λ (b: Buffers()) => Setup::at_spans(f, lent, ws, res, w, callees, typed, Setup::spans_of(lent, b)), λ (b: Buffers()) => Setup::spans_of(lent, b),
        λ (spans: Buffers()) (ys: List<BitVec(64)>) => Ty::uncurry(w.tys, ws, res, Setup::at_spans(f, lent, ws, res, w, callees, typed, spans), ys),
        λ (_: Buffers()) => m)
}

// `Guarded` at each file, of the function at the file of the file's first
// `lent` spans. At a function whose table reads a file only through those
// spans, that function is the one `Setup::Guarded` names (the function at
// the file) by conversion, which is how the generator hands this on: the
// two spellings of the function are compared, and the body's meaning, the
// same term at the same world on both sides, is not unfolded
// (issues/runtime-measured-instance-conversion-budget.md).
theorem Setup::guarded_spans<F>(f: F, lent: Nat, ws: List<Ty>, res: Ty, body: Tm, w: World, callees: (b: Buffers()) → Sig::Sems(w.tys, w.sigs),
    typed: (b: Buffers()) → Itself(F) = Itself(Ty::Lent(w.at(callees, b).tys, lent, ws, res)), m: List<BitVec(64)> → Nat,
    guarded: Setup::GuardedSpans(f, lent, ws, res, body, w, callees, typed, m)):
    (b: Buffers()) → Fun::Guarded(ws, res, body, w.at(callees, b), Setup::at_spans(f, lent, ws, res, w, callees, typed, Setup::spans_of(lent, b)), m) {
    λ b => Fun::guarded_by(ws, res, body, λ (c: Buffers()) => w.at(callees, c),
        λ (c: Buffers()) => Setup::at_spans(f, lent, ws, res, w, callees, typed, Setup::spans_of(lent, c)), λ (c: Buffers()) => Setup::spans_of(lent, c),
        λ (spans: Buffers()) (ys: List<BitVec(64)>) => Ty::uncurry(w.tys, ws, res, Setup::at_spans(f, lent, ws, res, w, callees, typed, spans), ys),
        λ (_: Buffers()) => m, λ c ys => refl, guarded, b)
}

theorem Setup::measured_agrees<F>(f: F, s: Setup, ks: List<Ty>, w0: Ty, wrest: List<Ty>, res: Ty, body: Tm, lent: Nat, w: World,
    callees: (b: Buffers()) → Sig::Sems(w.tys, w.sigs),
    typed: (b: Buffers()) → Itself(F) = Itself(Ty::Lent(w.at(callees, b).tys, lent, ks ++ Cons(w0, wrest), res)),
    shaped: Setup::measured_fun(ks, w0, wrest, res, body, lent).shape() = Measured(ks, w0, wrest, body),
    m: List<BitVec(64)> → Nat, bounded: Fun::Bounded(ks ++ Cons(w0, wrest), m),
    guarded: Setup::Guarded(f, lent, ks ++ Cons(w0, wrest), res, body, w, callees, typed, m),
    ok: s.checked(Setup::measured_fun(ks, w0, wrest, res, body, lent), w) = True):
    (b: Buffers()) → (call: Answers()) → Tm::CallsAgree(w.at(callees, b), call) →
    Ty::Answers(w.at(callees, b).tys, ks ++ Cons(w0, wrest), res, Ty::lent_at(w.at(callees, b).tys, lent, ks ++ Cons(w0, wrest), res, typed(b), f, b),
        λ xs => s.code(Setup::measured_fun(ks, w0, wrest, res, body, lent), w).eval(call, xs, buffers := b)) {
    let rt = Setup::measured_fun(ks, w0, wrest, res, body, lent);
    λ b call agree => {
        let h = Ty::lent_at(w.at(callees, b).tys, lent, ks ++ Cons(w0, wrest), res, typed(b), f, b);
        j(s.static(rt, w, callees(b), b), λ r _ => Ty::Answers(w.at(callees, b).tys, ks ++ Cons(w0, wrest), res, h,
                λ xs => Setup::code_of(r).eval(call, xs, buffers := b)),
            Fun::measured_answers(ks ++ Cons(w0, wrest), res, w.at(callees, b), h, s.lower(rt, w.at(callees, b)),
                Setup::lowered_over(s, rt, w, callees(b), b, Setup::checked_lowered(s, rt, w, ok)),
                Setup::holds_at(s, rt, w.at(callees, b), Measured(ks, w0, wrest, body), shaped, h, m, bounded, guarded(b)), call, agree))
    }
}

// `f` after the reflection and the table, as in `Setup::compile`.
fn Setup::compile_measured<F>(s: Setup, ks: List<Ty>, w0: Ty, wrest: List<Ty>, res: Ty, body: Tm, lent: Nat, w: World,
    callees: (b: Buffers()) → Sig::Sems(w.tys, w.sigs), f: F,
    typed: (b: Buffers()) → Itself(F) = Itself(Ty::Lent(w.at(callees, b).tys, lent, ks ++ Cons(w0, wrest), res)),
    shaped: Setup::measured_fun(ks, w0, wrest, res, body, lent).shape() = Measured(ks, w0, wrest, body),
    m: List<BitVec(64)> → Nat, bounded: Fun::Bounded(ks ++ Cons(w0, wrest), m),
    guarded: Setup::Guarded(f, lent, ks ++ Cons(w0, wrest), res, body, w, callees, typed, m),
    ok: s.checked(Setup::measured_fun(ks, w0, wrest, res, body, lent), w) = True) → Compile<F>(f)
{
    Compile(Setup::measured_fun(ks, w0, wrest, res, body, lent), w, callees, typed, s.code(Setup::measured_fun(ks, w0, wrest, res, body, lent), w),
        Setup::measured_agrees(f, s, ks, w0, wrest, res, body, lent, w, callees, typed, shaped, m, bounded, guarded, ok),
        Setup::checked_fits(s, Setup::measured_fun(ks, w0, wrest, res, body, lent), w, ok))
}

// What else the generator cites for a measured instance, named here for the
// same reason.

// Transparent, and `Nat::lt_succ_self` itself: a `decreases` function's
// body passes that proof to its recursor, and the instance's statements
// meet it by conversion.
fn Setup::lt_succ(n: Nat) → n < Succ(n) { Nat::lt_succ_self(n) }

theorem Setup::below_pow(x: BitVec(64)): x.toNat() < Nat::pow(2, 64) { BitVec::toNat_lt_pow(64, x) }

theorem Setup::eq_sym<A>(a, b: A, p: a = b): b = a { sym(p) }

theorem Setup::eq_trans<A>(a, b, c: A, p: a = b, q: b = c): a = c { trans(p, q) }

theorem Setup::eq_cong<A, B>(g: A → B, a, b: A, p: a = b): g(a) = g(b) { cong_fn(g, p) }

// ---------------------------------------------------------------------------
// Linking (design §16.9): one FunctionIR program from instances. An
// instance's code answers its calls by index into its own table, and its
// agreement assumes each entry answered with its meaning
// (`Tm::CallsAgree`). A program numbers the functions its own way, callees
// first: each instance's code is put in with its calls renamed to the
// program's numbering (`Function::relabel`), and every call of the program
// is answered by the uncurried meaning of the function it names, which is
// what each function, so renamed, returns (`Compile::part`). Then
// `program_linked_sources` makes the program's evaluation those meanings,
// so the agreement assumes nothing. A function is answered only by
// functions below it at their arity. That its calls fit is a fact its
// instance carries (`fits`, checked once where the function is declared),
// and renaming keeps it wherever the table's arities are the program's at
// the new names (`Function::relabel_calls_fit`, `Sig::links_fit`: a check
// of two short lists). The program's arities are a list published beside
// it (`f::arities`). So a link evaluates no function's code, and a
// program's agreement costs its function count, not the sum of its
// functions (design §16.14). Only that the calls fit is needed, never
// `evaluable`'s quadratic disjointness
// (issues/runtime-fn-caller-agreement-fuel.md).

// A function of words to a count, curried (a measure, spelled by the
// generator as a `λ` per word), and the same on a word list.
fn Ty::WordsToNat(ps: List<Ty>) → Type { match ps { Nil => Nat, Cons(_, rest) => BitVec(64) → Ty::WordsToNat(rest) } }

fn Ty::on_words(ps: List<Ty>) → Ty::WordsToNat(ps) → List<BitVec(64)> → Nat {
    match ps {
        Nil => λ v _ => v,
        Cons(_, rest) => λ v ws => match ws {
            Nil => Ty::on_words(rest, v(BitVec::zero()), Nil),
            Cons(x, more) => Ty::on_words(rest, v(x), more),
        },
    }
}

// A curried meaning answers like its uncurried form.
theorem Ty::answers_uncurry(tys: Nat → RecInfo, ps: List<Ty>, r: Ty): (v: Ty::Arrows(tys, ps, r)) →
    Ty::Answers(tys, ps, r, v, λ ws => Ty::uncurry(tys, ps, r, v, ws)) {
    match ps {
        Nil => λ v => refl,
        Cons(p, rest) => λ v => λ x => Ty::answers_uncurry(tys, rest, r, v(Ty::cast(tys, Word(64), p, x))),
    }
}

// What answers like a meaning is its uncurried form, on as many words as
// parameters.
theorem Ty::answers_at(tys: Nat → RecInfo, ps: List<Ty>, r: Ty): (v: Ty::Arrows(tys, ps, r)) → (ans: List<BitVec(64)> → BitVec(64)) →
    Ty::Answers(tys, ps, r, v, ans) → (words: List<BitVec(64)>) → words.len() = ps.len() → ans(words) = Ty::uncurry(tys, ps, r, v, words) {
    match ps {
        Nil => λ v ans held words => match words as λ ws => ws.len() = 0 → ans(ws) = Ty::uncurry(tys, Nil, r, v, ws) {
            Nil => λ _ => held,
            Cons(_, more) => λ (bad: Succ(more.len()) = 0) => false_elim(more.len().succ_ne_zero(bad)),
        },
        Cons(p, rest) => λ v ans held words => match words as λ ws => ws.len() = Succ(rest.len()) → ans(ws) = Ty::uncurry(tys, Cons(p, rest), r, v, ws) {
            Nil => λ (bad: 0 = Succ(rest.len())) => false_elim(rest.len().zero_ne_succ(bad)),
            Cons(x, more) => λ (same: Succ(more.len()) = Succ(rest.len())) =>
                Ty::answers_at(tys, rest, r, v(Ty::cast(tys, Word(64), p, x)), λ ws => ans(Cons(x, ws)), held(x), more,
                    Nat::succ_inj(more.len(), rest.len(), same)),
        },
    }
}

// The word function at index `k` of a list of them, zero past its end.
fn link_source(srcs: List<List<BitVec(64)> → BitVec(64)>, k: Nat) → List<BitVec(64)> → BitVec(64) {
    match srcs.nth(k) { None => λ _ => BitVec::zero(), Some(s) => s }
}

// Calls answered by a list of word functions.
fn link_sources(srcs: List<List<BitVec(64)> → BitVec(64)>) → Answers() { λ k words => link_source(srcs, k, words) }

// A table's renaming: entry `k` is the program's `links[k]`.
fn link_at(links: List<Nat>) → Nat → Nat { λ k => match links.nth(k) { None => 0, Some(n) => n } }

fn link_both<P, Q>(p: P, q: Q) → P ∧ Q { ⟨p, q⟩ }

// Each entry of a table is named, by `links`, a function `arity` gives the
// entry's parameter count: a walk of two short lists of numbers, which is
// all a link evaluates (issues/runtime-generator-program-size.md).
fn Sig::links_fit(sigs: List<Sig>, links: List<Nat>, arity: Nat → Option<Nat>) → Bool {
    match sigs {
        Nil => True,
        Cons(s, rest) => match links {
            Nil => False,
            Cons(l, ls) => arity_fits(arity(l), s.params.len()) && Sig::links_fit(rest, ls, arity),
        },
    }
}

theorem Sig::links_fit_at(sigs: List<Sig>, arity: Nat → Option<Nat>): (links: List<Nat>) → Sig::links_fit(sigs, links, arity).IsTrue() →
    (k: Nat) → (n: Nat) → arity_fits(Sig::arity(sigs, k), n).IsTrue() → arity_fits(arity(link_at(links, k)), n).IsTrue() {
    match sigs {
        Nil => λ links ok k n never => false_elim(never),
        Cons(s, rest) => λ links => match links as λ ls => Sig::links_fit(Cons(s, rest), ls, arity).IsTrue() →
            (k: Nat) → (n: Nat) → arity_fits(Sig::arity(Cons(s, rest), k), n).IsTrue() → arity_fits(arity(link_at(ls, k)), n).IsTrue() {
            Nil => λ never k n _ => false_elim(never),
            Cons(l, ls) => λ ok k => {
                let parts = Bool::is_true_and(arity_fits(arity(l), s.params.len()), Sig::links_fit(rest, ls, arity), ok);
                match k as λ i => (n: Nat) → arity_fits(Sig::arity(Cons(s, rest), i), n).IsTrue() →
                    arity_fits(arity(link_at(Cons(l, ls), i)), n).IsTrue() {
                    Zero => λ n fits => j(s.params.len().matches_eq(n, fits), λ m _ => arity_fits(arity(l), m).IsTrue(), parts.left),
                    Succ(i) => λ n fits => Sig::links_fit_at(rest, arity, ls, parts.right, i, n, fits),
                }
            },
        },
    }
}

// The same for a table's callees, its entries after the first.
theorem Sig::callee_links_fit_at(arity: Nat → Option<Nat>, sigs: List<Sig>): (links: List<Nat>) →
    Sig::links_fit(sigs.tail(), links.tail(), arity).IsTrue() →
    (k: Nat) → (n: Nat) → arity_fits(Sig::callee_arity(sigs, k), n).IsTrue() → arity_fits(arity(link_at(links, k)), n).IsTrue() {
    match sigs {
        Nil => λ links ok k => match k as λ i => (n: Nat) → arity_fits(Sig::callee_arity(Nil, i), n).IsTrue() →
            arity_fits(arity(link_at(links, i)), n).IsTrue() {
            Zero => λ n never => false_elim(never),
            Succ(_) => λ n never => false_elim(never),
        },
        Cons(s, rest) => λ links => match links as λ ls => Sig::links_fit(rest, ls.tail(), arity).IsTrue() →
            (k: Nat) → (n: Nat) → arity_fits(Sig::callee_arity(Cons(s, rest), k), n).IsTrue() → arity_fits(arity(link_at(ls, k)), n).IsTrue() {
            Nil => λ ok k => match k as λ i => (n: Nat) → arity_fits(Sig::callee_arity(Cons(s, rest), i), n).IsTrue() →
                arity_fits(arity(link_at(Nil, i)), n).IsTrue() {
                Zero => λ n never => false_elim(never),
                Succ(i) => λ n fits => Sig::links_fit_at(rest, arity, Nil, ok, i, n, fits),
            },
            Cons(l, ls) => λ ok k => match k as λ i => (n: Nat) → arity_fits(Sig::callee_arity(Cons(s, rest), i), n).IsTrue() →
                arity_fits(arity(link_at(Cons(l, ls), i)), n).IsTrue() {
                Zero => λ n never => false_elim(never),
                Succ(i) => λ n fits => Sig::links_fit_at(rest, arity, ls, ok, i, n, fits),
            },
        },
    }
}

// A table's meanings, uncurried.
fn Sig::uncurried(tys: Nat → RecInfo, sigs: List<Sig>) → Sig::Sems(tys, sigs) → List<List<BitVec(64)> → BitVec(64)> {
    match sigs {
        Nil => λ _ => Nil,
        Cons(s, rest) => λ cs => Cons(λ ws => Ty::uncurry(tys, s.params, s.result, cs.fst, ws), Sig::uncurried(tys, rest, cs.snd)),
    }
}

fn World::uncurried(self w: World) → List<List<BitVec(64)> → BitVec(64)> { Sig::uncurried(w.tys, w.sigs, w.callees) }

fn World::arity(self w: World) → Nat → Option<Nat> { λ k => Sig::arity(w.sigs, k) }

theorem Sig::callee_fits(sigs: List<Sig>, k, n: Nat): arity_fits(Sig::callee_arity(sigs, k), n).IsTrue() →
    arity_fits(Sig::arity(sigs, k), n).IsTrue() {
    match k as λ i => arity_fits(Sig::callee_arity(sigs, i), n).IsTrue() → arity_fits(Sig::arity(sigs, i), n).IsTrue() {
        Zero => λ never => false_elim(never),
        Succ(_) => λ fits => fits,
    }
}

theorem Sig::uncurried_answers(tys: Nat → RecInfo, sigs: List<Sig>): (cs: Sig::Sems(tys, sigs)) → (f: Nat) → Sig::at(sigs, f).Words(tys) →
    Ty::Answers(tys, Sig::at(sigs, f).params, Sig::at(sigs, f).result, Sig::get(tys, sigs, cs, f), λ ws => link_sources(Sig::uncurried(tys, sigs, cs), f, ws)) {
    match sigs {
        Nil => λ cs f ok => false_elim(ok.right),
        Cons(s, rest) => λ cs f => match f as λ g => Sig::at(Cons(s, rest), g).Words(tys) →
            Ty::Answers(tys, Sig::at(Cons(s, rest), g).params, Sig::at(Cons(s, rest), g).result, Sig::get(tys, Cons(s, rest), cs, g),
                λ ws => link_sources(Sig::uncurried(tys, Cons(s, rest), cs), g, ws)) {
            Zero => λ _ => Ty::answers_uncurry(tys, s.params, s.result, cs.fst),
            Succ(k) => λ ok => Sig::uncurried_answers(tys, rest, cs.snd, k, ok),
        },
    }
}

// A world's calls are answered by its own meanings, uncurried: what an
// instance's agreement is read at when its code is linked.
theorem World::calls_agree_own(self w: World): Tm::CallsAgree(w, link_sources(w.uncurried())) {
    λ f ok => Sig::uncurried_answers(w.tys, w.sigs, w.callees, f, ok)
}

// Where the program's word functions, read through a table's renaming, are
// the table's own meanings (checked once per function, by conversion), the
// renamed calls are answered alike wherever a call fits the table.
theorem Sig::links_agree(tys: Nat → RecInfo, srcs: List<List<BitVec(64)> → BitVec(64)>, sigs: List<Sig>): (cs: Sig::Sems(tys, sigs)) →
    (links: List<Nat>) → links.map(λ (n: Nat) => link_source(srcs, n)) = Sig::uncurried(tys, sigs, cs) →
    (k: Nat) → (words: List<BitVec(64)>) → arity_fits(Sig::arity(sigs, k), words.len()).IsTrue() →
    Answers::relabel(link_sources(srcs), link_at(links), k, words) = link_sources(Sig::uncurried(tys, sigs, cs), k, words) {
    match sigs {
        Nil => λ cs links linked k words never => false_elim(never),
        Cons(s, rest) => λ cs links => match links as λ ls => ls.map(λ (n: Nat) => link_source(srcs, n)) = Sig::uncurried(tys, Cons(s, rest), cs) →
            (k: Nat) → (words: List<BitVec(64)>) → arity_fits(Sig::arity(Cons(s, rest), k), words.len()).IsTrue() →
            Answers::relabel(link_sources(srcs), link_at(ls), k, words) = link_sources(Sig::uncurried(tys, Cons(s, rest), cs), k, words) {
            Nil => λ linked => false_elim(List::nil_ne_cons(Sig::uncurried(tys, rest, cs.snd),
                λ (ws: List<BitVec(64)>) => Ty::uncurry(tys, s.params, s.result, cs.fst, ws), linked)),
            Cons(l, ls) => λ linked k => {
                let heads = cong_fn(λ (fs: List<List<BitVec(64)> → BitVec(64)>) => fs.head_or(λ (_: List<BitVec(64)>) => BitVec::zero()), linked);
                let tails = cong_fn(λ (fs: List<List<BitVec(64)> → BitVec(64)>) => fs.tail(), linked);
                match k as λ i => (words: List<BitVec(64)>) → arity_fits(Sig::arity(Cons(s, rest), i), words.len()).IsTrue() →
                    Answers::relabel(link_sources(srcs), link_at(Cons(l, ls)), i, words) = link_sources(Sig::uncurried(tys, Cons(s, rest), cs), i, words) {
                    Zero => λ words _ => cong_fn(λ (g: List<BitVec(64)> → BitVec(64)) => g(words), heads),
                    Succ(i) => λ words fits => Sig::links_agree(tys, srcs, rest, cs.snd, ls, tails, i, words, fits),
                }
            },
        },
    }
}

// An instance's function as a word function at a file: its meaning there,
// uncurried. A program is linked at every file at once
// (docs/native/native-one-compiler-design.md §2.3): a function lent spans reads
// the file's, and a function lent nothing is the same at each.
//
// The instance is read by pattern and not through the class's members. A
// member is a function of `F`, `f` and the instance, and where a caller's
// table meets a callee's source the kernel compares two applications of
// one member argument by argument before it unfolds either: `f` against
// the callee, which for two functions of one type it settles only by
// evaluating both bodies (issues/runtime-link-compares-functions.md). The
// world's types are read by pattern too, and not as `c.world.tys`: a
// caller's world and a callee's are two applications of `World::tys`,
// which the kernel would compare world by world, callee tables and all.
fn Compile::uncurried<F>(f: F, c: Compile<F>(f), b: Buffers()) → List<BitVec(64)> → BitVec(64) {
    match c {
        Compile(reflected, World(tys, _, _, _), _, typed, _, _, _) => λ ws => Ty::uncurry(tys, reflected.params,
            reflected.result, Ty::lent_at(tys, reflected.lent, reflected.params, reflected.result, typed(b), f, b), ws),
    }
}

// A program's word functions at each file, spelled with no binder: the
// generator applies `Compile::uncurried` to a function and its instance
// and leaves the file.
fn link_files_nil() → Buffers() → List<List<BitVec(64)> → BitVec(64)> { λ _ => [] }

fn link_files_cons(s: Buffers() → List<BitVec(64)> → BitVec(64), rest: Buffers() → List<List<BitVec(64)> → BitVec(64)>)
    → Buffers() → List<List<BitVec(64)> → BitVec(64)> {
    λ b => Cons(s(b), rest(b))
}

// Calls answered by a program's word functions at each file.
fn link_sources_at(srcs: Buffers() → List<List<BitVec(64)> → BitVec(64)>) → Buffers() → Answers() { λ b => link_sources(srcs(b)) }

// `x(b) = x(b)` at every file, spelled with no binder.
theorem link_every<A>(x: Buffers() → A): (b: Buffers()) → x(b) = x(b) { λ _ => refl }

// The same at a table of meanings, with no type left to inference: what the
// generator applies (`runtime_types`).
theorem link_every_table(x: Buffers() → List<List<BitVec(64)> → BitVec(64)>): (b: Buffers()) → x(b) = x(b) { λ _ => refl }

// An instance's code in a program: its calls renamed by `links`.
fn Compile::linked<F>(f: F, c: Compile<F>(f), links: List<Nat>) → Function { c.code.relabel(link_at(links)) }

// An instance's table of meanings at a file, uncurried: what `links` must
// name. Read off the world at the file, as `Compile::uncurried` reads the
// function's meaning (`World::at`'s one spelling). Spelled at `c.world`,
// the table of a function lent a span met the function's own source one
// world apart, at no file against at the file, and the kernel told the two
// worlds apart by evaluating the function at both
// (issues/runtime-link-compares-functions.md).
fn Compile::table<F>(f: F, c: Compile<F>(f), b: Buffers()) → List<List<BitVec(64)> → BitVec(64)> {
    c.world.at(c.callees, b).uncurried()
}

// How many words an instance's function takes.
fn Compile::arity<F>(f: F, c: Compile<F>(f)) → Nat { c.reflected.params.len() }

// The arities function `k` of a program is linked against (`k` counted
// from the last): those of the functions before it.
fn link_arity(functions: List<Function>, arities: List<Nat>, k: Nat) → Nat → Option<Nat> {
    linked_arity(functions.drop(k), arities.drop(k))
}

// An instance's code, linked into a program whose calls `srcs` answers at
// each file and whose functions take `arity` words: its calls fit the
// program, and over every file it returns its function's meaning there.
// `links` names, for each entry of its table, a function of the program
// answered by that entry's meaning (`linked`, by conversion, at every file)
// and taking that entry's words (`named`, by evaluating the two lists).
// That the code's calls fit its own table is the instance's `fits`, so no
// link reads the code. This is one conjunct of `program_linked_files`.
theorem Compile::part<F>(f: F, c: Compile<F>(f), srcs: Buffers() → List<List<BitVec(64)> → BitVec(64)>, links: List<Nat>, arity: Nat → Option<Nat>,
    linked: (b: Buffers()) → links.map(λ (n: Nat) => link_source(srcs(b), n)) = Compile::table(f, c, b),
    named: Sig::links_fit(c.world.sigs.tail(), links.tail(), arity).IsTrue()):
    Compile::linked(f, c, links).calls_fit(arity).IsTrue()
    ∧ ((b: Buffers()) → (words: List<BitVec(64)>) → arity_fits(Some(Compile::arity(f, c)), words.len()).IsTrue() →
        Compile::linked(f, c, links).eval(link_sources(srcs(b)), words, buffers := b) = Compile::uncurried(f, c, b, words)) {
    ⟨c.code.relabel_calls_fit(link_at(links), c.world.callee_arity(), arity,
        Sig::callee_links_fit_at(arity, c.world.sigs, links, named), c.fits),
    λ b words n => {
        let at = c.world.at(c.callees, b);
        let own = link_sources(Compile::table(f, c, b));
        let meaning = Ty::lent_at(at.tys, c.reflected.lent, c.reflected.params, c.reflected.result, c.typed(b), f, b);
        let answered = Ty::answers_at(at.tys, c.reflected.params, c.reflected.result, meaning, λ xs => c.code.eval(own, xs, buffers := b),
            c.agrees(b, own, at.calls_agree_own()), words, sym(c.reflected.params.len().matches_eq(words.len(), n)));
        trans(c.code.relabel_eval_over(b, link_sources(srcs(b)), link_at(links), words),
            trans(c.code.eval_answers_over(b, own, Answers::relabel(link_sources(srcs(b)), link_at(links)), c.world.callee_arity(),
                λ k ws fits => Sig::links_agree(c.world.tys, srcs(b), c.world.sigs, c.callees(b), links, linked(b), k, ws,
                    Sig::callee_fits(c.world.sigs, k, ws.len(), fits)), c.fits, words),
                answered))
    }⟩
}

// A table of meanings that answers every call with a default: what the
// generator's own run judges and lowers against (neither reads the
// meanings).
fn Sig::sems_default(tys: Nat → RecInfo, sigs: List<Sig>) → Sig::Sems(tys, sigs) {
    match sigs { Nil => trivial, Cons(s, rest) => Pair(Ty::arrows_default(tys, s.params, s.result), Sig::sems_default(tys, rest)) }
}

// A world from its parts: what the generator spells (`World`'s constructor
// has a field whose type mentions the ones before it, so `Ctors` gives it no
// function).
fn World::of(tys: Nat → RecInfo, sigs: List<Sig>, callees: Sig::Sems(tys, sigs)) → World { World(tys, sigs, callees) }

// ---------------------------------------------------------------------------
// The generator's plumbing: names it reads, and reflected code quoted back
// into terms.

fn runtime_fail<A>(why: String) → Tac<A> { fail("runtime: " ++ why, []) }

// A name the generator reads, where the `runtime fn` is: one of this
// module's own is reached by its module's key even where `runtime` is not
// imported, as in a module of programs, which imports `runtime_program`
// in its place (its `runtime` and this one would clash).
fn runtime_ref(name: String) → Tac<GlobalRef> {
    lookup(name).bind(λ c => match c {
        Accepted(g) => pure(g),
        Refused(_) => lookup("runtime::" ++ name).or_fail("runtime: `" ++ name ++ "` is not in scope (`import runtime;` and the modules `runtime` imports): "),
    })
}

fn runtime_global(name: String) → Tac<Expr> { runtime_ref(name).bind(λ g => pure(Global(g))) }

fn ap(f: Expr, args: List<Expr>) → Expr { args.foldl(λ acc a => App(acc, a), f) }

fn runtime_ctor_exprs(cs: List<CtorInfo>) → Tac<List<Expr>> {
    match cs {
        Nil => pure([]),
        Cons(c, rest) => match c.ctor {
            None => runtime_fail("`" ++ c.name ++ "` has no constructor function"),
            Some(h) => runtime_ctor_exprs(rest).bind(λ es => pure(Cons(Hd(h), es))),
        },
    }
}

// The constructors of the type `h`, as terms, in declaration order.
fn runtime_ctors_at(h: Handle) → Tac<List<Expr>> { ctors(h).or_fail("runtime: ").bind(λ cs => runtime_ctor_exprs(cs)) }

// The types the generator names, as the types of values: a type former is
// not a term, so an `Expr` cannot spell `Ty` or `List<Ty>`, and a type read
// off a function type below its first binder lives under that binder. A
// value's type is read at the root.
def runtime_w_ty: Ty = Bit;
def runtime_w_tm: Tm = Var(0);
def runtime_w_op: Op = Neg;
def runtime_w_fun: Fun = Fun([], Bit, Var(0));
def runtime_w_sig: Sig = Sig([], Bit);
def runtime_w_world: World = World(RecInfo::none, [], trivial);
def runtime_w_verdict: Verdict = Ok;
def runtime_w_function: Function = Setup::code_of(None);
def runtime_w_tys: List<Ty> = [];
def runtime_w_nats: List<Nat> = [];
def runtime_w_sigs: List<Sig> = [];
def runtime_w_words: List<BitVec(64)> = [];
def runtime_w_word: BitVec(64) = BitVec::ofNat(0);
def runtime_w_srcs: List<List<BitVec(64)> → BitVec(64)> = [];
def runtime_w_functions: List<Function> = [];
def runtime_w_shape: RtShape = Plain;
def runtime_w_nat: Nat = 0;
def runtime_w_buffers: List<List<BitVec(8)>> = [];
def runtime_w_bytes: List<BitVec(8)> = [];

record RtTypes { ty: Handle, tm: Handle, op: Handle, fun_t: Handle, sig: Handle, world: Handle, verdict: Handle, function: Handle,
    tys: Handle, nats: Handle, sigs: Handle, words: Handle, word: Handle, srcs: Handle, functions: Handle }

fn runtime_type_of(name: String) → Tac<Handle> {
    runtime_ref(name).bind(λ g => infer(Global(g)).or_fail("runtime: `" ++ name ++ "`: "))
}

fn runtime_type_handles() → Tac<RtTypes> {
    pure(RtTypes(<- runtime_type_of(name_of(runtime_w_ty)), <- runtime_type_of(name_of(runtime_w_tm)), <- runtime_type_of(name_of(runtime_w_op)),
        <- runtime_type_of(name_of(runtime_w_fun)), <- runtime_type_of(name_of(runtime_w_sig)), <- runtime_type_of(name_of(runtime_w_world)),
        <- runtime_type_of(name_of(runtime_w_verdict)), <- runtime_type_of(name_of(runtime_w_function)), <- runtime_type_of(name_of(runtime_w_tys)),
        <- runtime_type_of(name_of(runtime_w_nats)), <- runtime_type_of(name_of(runtime_w_sigs)), <- runtime_type_of(name_of(runtime_w_words)),
        <- runtime_type_of(name_of(runtime_w_word)), <- runtime_type_of(name_of(runtime_w_srcs)), <- runtime_type_of(name_of(runtime_w_functions))))
}

fn runtime_at(es: List<Expr>, i: Nat) → Expr { es.nth(i).unwrap_or(Blank) }

// The constructors quoting reads: `Ty`, `Tm`, `Op`, `Fun`, `Sig`, and the
// lists of codes, indices and signatures.
record RtQ { ty: List<Expr>, tm: List<Expr>, op: List<Expr>, tys: List<Expr>, nats: List<Expr>, sigs: List<Expr>, mk_fun: Expr, mk_sig: Expr }

fn RtQ::seq(nil_cons: List<Expr>, xs: List<Expr>) → Expr {
    match xs { Nil => runtime_at(nil_cons, 0), Cons(x, rest) => ap(runtime_at(nil_cons, 1), [x, RtQ::seq(nil_cons, rest)]) }
}

fn Ty::quote(self t: Ty, q: RtQ) → Expr {
    match t {
        Word(w) => ap(runtime_at(q.ty, 0), [NatLit(w)]),
        Bit => runtime_at(q.ty, 1),
        Bytes(c) => ap(runtime_at(q.ty, 2), [NatLit(c)]),
        Lines => runtime_at(q.ty, 3),
        Named(i) => ap(runtime_at(q.ty, 4), [NatLit(i)]),
        Count => runtime_at(q.ty, 5),
    }
}

fn Ty::quotes(ts: List<Ty>, q: RtQ) → Expr { RtQ::seq(q.tys, ts.map(λ t => Ty::quote(t, q))) }

fn RtQ::nat_list(self q: RtQ, ns: List<Nat>) → Expr { RtQ::seq(q.nats, ns.map(λ n => NatLit(n))) }

fn Op::quote(self o: Op, q: RtQ) → Expr {
    let c = runtime_at(q.op, o.code().fst);
    match o {
        Conj => c, Disj => c, Neg => c, ToNat => c,
        Zext(w, extra) => ap(c, [NatLit(w), NatLit(extra)]),
        Trunc(n, extra) => ap(c, [NatLit(n), NatLit(extra)]),
        Shl(w, k) => ap(c, [NatLit(w), NatLit(k)]),
        Lshr(w, k) => ap(c, [NatLit(w), NatLit(k)]),
        Ashr(w, k) => ap(c, [NatLit(w), NatLit(k)]),
        Sext(n, extra) => ap(c, [NatLit(n), NatLit(extra)]),
        _ => ap(c, [NatLit(o.code().snd.fst)]),
    }
}

fn Tm::quote(self t: Tm, q: RtQ) → Expr {
    match t {
        Var(i) => ap(runtime_at(q.tm, 0), [NatLit(i)]),
        Lit(c, n) => ap(runtime_at(q.tm, 1), [Ty::quote(c, q), NatLit(n)]),
        Prim(op, args) => ap(runtime_at(q.tm, 2), [Op::quote(op, q), q.nat_list(args)]),
        Let(e, body) => ap(runtime_at(q.tm, 3), [e.quote(q), body.quote(q)]),
        If(c, yes, no) => ap(runtime_at(q.tm, 4), [NatLit(c), yes.quote(q), no.quote(q)]),
        IfEq(c, yes, no) => ap(runtime_at(q.tm, 5), [NatLit(c), yes.quote(q), no.quote(q)]),
        Make(i, args) => ap(runtime_at(q.tm, 6), [NatLit(i), q.nat_list(args)]),
        Field(i, k, of) => ap(runtime_at(q.tm, 7), [NatLit(i), NatLit(k), NatLit(of)]),
        Call(f, args) => ap(runtime_at(q.tm, 8), [NatLit(f), q.nat_list(args)]),
        Fold(over, init, step) => ap(runtime_at(q.tm, 9), [NatLit(over), NatLit(init), NatLit(step)]),
        Case(c, zero, succ) => ap(runtime_at(q.tm, 10), [NatLit(c), zero.quote(q), succ.quote(q)]),
        Byte(k, i, length) => ap(runtime_at(q.tm, 11), [NatLit(k), NatLit(i), NatLit(length)]),
    }
}

fn Fun::quote(self f: Fun, q: RtQ) → Expr {
    ap(q.mk_fun, [Ty::quotes(f.params, q), Ty::quote(f.result, q), Tm::quote(f.body, q), NatLit(f.lent)])
}

fn Sig::quote(self s: Sig, q: RtQ) → Expr { ap(q.mk_sig, [Ty::quotes(s.params, q), Ty::quote(s.result, q)]) }

fn runtime_quoting(ts: RtTypes) → Tac<RtQ> {
    let tys <- runtime_ctors_at(ts.ty);
    let tms <- runtime_ctors_at(ts.tm);
    let ops <- runtime_ctors_at(ts.op);
    let ty_list <- runtime_ctors_at(ts.tys);
    let nat_list <- runtime_ctors_at(ts.nats);
    let sig_list <- runtime_ctors_at(ts.sigs);
    let funs <- runtime_ctors_at(ts.fun_t);
    let sigs <- runtime_ctors_at(ts.sig);
    pure(RtQ(tys, tms, ops, ty_list, nat_list, sig_list, runtime_at(funs, 0), runtime_at(sigs, 0)))
}

// A pair, its types left to the elaborator: what the generator spells a
// table of meanings with.
fn Pair::of<A, B>(a: A, b: B) → Pair<A, B> { Pair(a, b) }

// The table of the program's meanings, `Pair(g₀, Pair(g₁, … trivial))`.
fn runtime_callees(pair: Expr, unit: Expr, gs: List<Nat>) → Expr {
    match gs { Nil => unit, Cons(g, rest) => ap(pair, [Blank, Blank, Global(GlobalRef(g)), runtime_callees(pair, unit, rest)]) }
}

// A callee's signature, read off its type: the words its code takes (two
// for each span it is lent, `rt_lent`), and how many spans it is lent.
fn runtime_sig_from(fuel: Nat, k: Known, t: Handle, ps: List<Ty>) → Tac<Pair<Nat, Sig>> {
    match fuel {
        Zero => runtime_fail("a callee with more parameters than the generator reads"),
        Succ(f) => view(t).bind(λ v => match v {
            HPi(dom) => k.ty(dom).bind(λ p => open(t, "x").or_fail("runtime: a callee's type: ").bind(λ o =>
                runtime_sig_from(f, k, o.body, ps ++ [p]))),
            _ => k.ty(t).bind(λ r => { let lent = rt_lent(ps); pure(Pair(lent.fst, Sig(lent.snd, r))) }),
        }),
    }
}

fn runtime_sigs(k: Known, gs: List<Nat>) → Tac<List<Pair<Nat, Sig>>> {
    match gs {
        Nil => pure([]),
        Cons(g, rest) => infer(Global(GlobalRef(g))).or_fail("runtime: a callee's type: ").bind(λ t =>
            runtime_sig_from(64, k, t, []).bind(λ s => runtime_sigs(k, rest).bind(λ ss => pure(Cons(s, ss))))),
    }
}

// The function's parameters as locals for a declaration's telescope, each
// under the one before: words, as the judgment checked.
fn runtime_params(word: Handle, ps: List<Ty>, under: Option<LocalRef>, i: Nat) → Tac<List<LocalRef>> {
    match ps {
        Nil => pure([]),
        Cons(_, rest) => assume(Hd(word), "x" ++ decimal_name(2, i), under).or_fail("runtime: a parameter: ").bind(λ x =>
            runtime_params(word, rest, Some(x.ref), Succ(i)).bind(λ more => pure(Cons(x.ref, more)))),
    }
}

fn runtime_locals(xs: List<LocalRef>) → List<Expr> { xs.map(λ x => Local(x)) }

// Whether word `i` after a written span's place is the place of a span
// that is only read, of a function lent `lent` spans: the words are the
// written span's length word, then each read span's place and its length
// word, then the function's own.
fn runtime_read_place(lent: Nat, i: Nat) → Bool { i.mod(2).same(1).and(Succ(Succ(i)).leb(lent + lent)) }

// The parameters of a function over its span after the span, `n` of them,
// each under the one before: a read span's bytes where the code takes
// their place, and words.
fn runtime_own_params(word, bytes: Handle, lent: Nat, n: Nat, under: Option<LocalRef>, i: Nat) → Tac<List<LocalRef>> {
    match n {
        Zero => pure([]),
        Succ(m) => assume(Hd(match runtime_read_place(lent, i) { True => bytes, False => word }), "x" ++ decimal_name(2, i), under).or_fail("runtime: a parameter: ").bind(λ x =>
            runtime_own_params(word, bytes, lent, m, Some(x.ref), Succ(i)).bind(λ more => pure(Cons(x.ref, more)))),
    }
}

// Each of those that is a read span's place, in order.
fn runtime_read_spans<A>(lent: Nat, xs: List<A>, i: Nat) → List<A> {
    match xs {
        Nil => xs,
        Cons(x, rest) => match runtime_read_place(lent, i) { True => Cons(x, runtime_read_spans(lent, rest, Succ(i))), False => runtime_read_spans(lent, rest, Succ(i)) },
    }
}

// Those parameters with each read span's place replaced: `at(j)` for the
// `j`th span read.
fn runtime_at_places<A>(lent: Nat, xs: List<A>, i: Nat, at: Nat → A) → List<A> {
    match xs {
        Nil => xs,
        Cons(x, rest) => Cons(match runtime_read_place(lent, i) { True => at(i.div(2)), False => x }, runtime_at_places(lent, rest, Succ(i), at)),
    }
}

fn runtime_params_of(xs: List<LocalRef>) → List<Param> { xs.map(λ x => Param(x, False)) }

// ---------------------------------------------------------------------------
// The program a runtime fn is compiled in: it and every runtime fn it calls,
// directly or not, callees first (a depth-first walk of the tables, each
// function once), each with its table as its own generator read it.

//
// `reads` says which functions write a span: `None` for one that only
// reads, whose table is itself and then its callees, and `Some(n)` for one
// that writes, whose table is its `n` callees that only read and then the
// ones that write (it is not in its own table).
record Linking { order: List<Nat>, names: List<String>, tables: List<List<Nat>>, reads: List<Option<Nat>> }

// A function whose callees are still being placed.
record LinkFrame { g: Nat, name: String, table: List<Nat>, pending: List<Nat>, reads: Option<Nat> }

// A runtime fn reflected: a function that `decreases` from its step
// `f::body` (`rt_reflect_measured`), any other from its body.
fn runtime_reflect(k: Known, g: Nat, name: String) → Tac<Pair<Fun, List<Nat>>> {
    lookup(name ++ "::body").bind(λ c => match c {
        Accepted(step) => rt_reflect_measured(4096, k, g, step.id),
        Refused(_) => rt_reflect_one(4096, k, g),
    })
}

// The globals a table of meanings lists: `Pair::of(g₀, Pair::of(g₁, …
// trivial))`, or the table of a function lent spans,
// `Setup::lent_callees(g₀, …, Setup::lent_callees(g₁, …))`, whose entry is
// its first argument and whose rest its eighth (applied to a file or not).
// `cons` is that entry's global and `rest_at` where its rest is; `nil` is
// the global that ends such a table (which, at a file, has two arguments
// and is no pair). The table of the functions a function over a span calls
// that write is read the same way (`FTm::sems_cons`, its rest its eighth).
fn runtime_entries(fuel: Nat, cons, rest_at, nil: Nat, h: Handle) → Tac<List<Nat>> {
    match fuel {
        Zero => runtime_fail("a table longer than the linker reads"),
        Succ(more) => view(h).bind(λ v => {
            let at_file: Bool = match v { HGlobal(g, _, _) => g.id.same(cons), _ => False };
            let ended: Bool = match v { HGlobal(g, _, _) => g.id.same(nil), _ => False };
            let parts: List<Handle> = match v { HGlobal(_, _, args) => args, HCtor(_, _, _, fields) => fields, _ => [] };
            let pair: List<Handle> = match ended {
                True => [],
                False => match at_file {
                    True => match parts.nth(0) { Some(a) => match parts.nth(rest_at) { Some(b) => [a, b], None => [] }, None => [] },
                    False => parts,
                },
            };
            match pair {
                Cons(a, Cons(b, Nil)) => view(a).bind(λ entry => match entry {
                    HGlobal(g, _, _) => runtime_entries(more, cons, rest_at, nil, b).bind(λ rest => pure(Cons(g.id, rest))),
                    _ => runtime_fail("a table entry that is not a function"),
                }),
                _ => pure([]),
            }
        }),
    }
}

// A published runtime fn's table: itself, then the runtime fns it calls, as
// its own generator numbered them. Read off the meanings its `g::world`
// lists, a few requests an entry, where reflecting its body again cost as
// many as the body has nodes (issues/runtime-generator-link-cost.md).
fn runtime_table(name: String) → Tac<List<Nat>> {
    let world <- lookup(name ++ "::world").or_fail("runtime: the callee `" ++ name ++ "`'s table: ");
    let value <- body(world).or_fail("runtime: the callee `" ++ name ++ "`'s table: ");
    let v <- view(value);
    let parts: List<Handle> = match v { HGlobal(_, _, args) => args, HCtor(_, _, _, fields) => fields, _ => [] };
    let lent_callees <- runtime_ref(name_of(Setup::lent_callees));
    let callees_nil <- runtime_ref(name_of(Setup::callees_nil));
    match parts.nth(2) {
        Some(callees) => runtime_entries(4096, lent_callees.id, 7, callees_nil.id, callees),
        None => runtime_fail("the callee `" ++ name ++ "`'s `world` is not a table"),
    }
}

// A callee about to be placed. One that writes a span publishes
// `g::writes`, the functions it calls that write; its `g::world` lists the
// ones that only read, and not itself.
fn runtime_frame(c: Nat, n: String) → Tac<LinkFrame> {
    lookup(n ++ "::writes").bind(λ found => match found {
        Refused(_) => runtime_table(n).bind(λ t => pure(LinkFrame(c, n, t, t.drop(1), None))),
        Accepted(ws) => {
            let reads <- runtime_table(n);
            let value <- body(ws).or_fail("runtime: the callee `" ++ n ++ "`'s writing callees: ");
            let cons <- runtime_ref("runtime_file::FTm::sems_cons");
            let nil <- runtime_ref("runtime_file::FTm::sems_nil");
            let writes <- runtime_entries(4096, cons.id, 7, nil.id, value);
            pure(LinkFrame(c, n, reads ++ writes, reads ++ writes, Some(reads.len())))
        },
    })
}

fn runtime_self<A>(a: A) → a = a { refl }

// A global's name, spelled as the elaborator spells a call of it.
fn runtime_name_of(g: Nat) → Tac<String> {
    let same <- runtime_global(name_of(runtime_self));
    let t <- infer(ap(same, [Blank, Global(GlobalRef(g))])).or_fail("runtime: a callee: ");
    let v <- view(t);
    match v {
        HEq(lhs, _) => view(lhs).bind(λ h => match h {
            HGlobal(_, n, _) => match Known::str_same(rt_base_name(n), "bytes") {
                False => rt_name_of(GlobalRef(g), n),
                True => rt_record_of(GlobalRef(g)).bind(λ source => match source { Some(name) => pure(name), None => rt_name_of(GlobalRef(g), n) }),
            },
            _ => runtime_fail("a callee that is not a global"),
        }),
        _ => runtime_fail("a callee's name"),
    }
}

fn runtime_link(fuel: Nat, k: Known, stack: List<LinkFrame>, l: Linking) → Tac<Linking> {
    match fuel {
        Zero => runtime_fail("a program of more functions than the linker places"),
        Succ(more) => match stack {
            Nil => pure(l),
            Cons(fr, rest) => match fr.pending {
                Nil => runtime_link(more, k, rest, Linking(l.order ++ [fr.g], l.names ++ [fr.name], l.tables ++ [fr.table], l.reads ++ [fr.reads])),
                Cons(c, cs) => {
                    let later = Cons(LinkFrame(fr.g, fr.name, fr.table, cs, fr.reads), rest);
                    match Known::index(l.order, c, 0) {
                        Some(_) => runtime_link(more, k, later, l),
                        None => runtime_name_of(c).bind(λ n => runtime_frame(c, n).bind(λ frame =>
                            runtime_link(more, k, Cons(frame, later), l))),
                    }
                },
            },
        },
    }
}

// Each function of the program as `(f, its instance)`: a callee's is its
// published `g::compile`, the function's own is `own`, which is being
// published beside it.
fn runtime_instances(order: List<Nat>, names: List<String>, root: Nat, own_fn: Expr, own: Expr) → Tac<List<Pair<Expr, Expr>>> {
    match order {
        Nil => pure([]),
        Cons(g, rest) => {
            let name = names.head_or("");
            let here: Tac<Expr> = match g.same(root) { True => pure(own), False => runtime_global(name ++ "::compile") };
            let of = match g.same(root) { True => own_fn, False => Global(GlobalRef(g)) };
            here.bind(λ c => runtime_instances(rest, names.drop(1), root, own_fn, own).bind(λ ps => pure(Cons(Pair(of, c), ps))))
        },
    }
}

fn runtime_links(order: List<Nat>, table: List<Nat>) → List<Nat> { table.map(λ h => Known::index(order, h, 0).unwrap_or(0)) }

// An expression held as a hole it solves, so that every later mention of it
// is one node. The program and its sources are each named once per function
// of the program in what follows: spelled out, the reply would grow with the
// square of the program, and a program of a few dozen functions would be
// past what the host reads (issues/runtime-generator-program-size.md).
fn runtime_held(e: Expr, what: String) → Tac<Expr> {
    let t <- infer(e).or_fail("runtime: " ++ what ++ ": ");
    let held <- hole(t).or_fail("runtime: " ++ what ++ ": ");
    let solved <- defeq(Hd(held), e);
    match solved { True => pure(Hd(held)), False => runtime_fail(what ++ " does not solve its hole") }
}

// The program (the last function first, as `program_eval` reads it), the
// word functions answering its calls at each file, and the proof each
// function returns its own over every file (`program_linked_files`), with
// that statement.
record Linked { program: Expr, srcs: Expr, arities: Expr, sourced: Expr, statement: Expr }

// Each function's type, read once: what `Compile`'s members take first.
// Spelled, not left to inference (`Blank`), in everything the link applies:
// an application with nothing left to inference is read once however often
// it is spelled, and makes no hole, where each hole of a run is a term the
// host carries through every later reading
// (issues/runtime-generator-link-cost.md).
fn runtime_types(insts: List<Pair<Expr, Expr>>) → Tac<List<Expr>> {
    match insts {
        Nil => pure([]),
        Cons(p, rest) => infer(p.fst).or_fail("runtime: a function's type: ").bind(λ t => runtime_types(rest).bind(λ ts => pure(Cons(Hd(t), ts)))),
    }
}

// The parts' conjunction, ending in `last`, each `link_both` at its two
// statements (`runtime_types`' reason).
fn runtime_conjoined(both: Expr, parts: List<Expr>, last: Expr) → Tac<Expr> {
    match parts {
        Nil => pure(last),
        Cons(p, rest) => runtime_conjoined(both, rest, last).bind(λ acc =>
            infer(p).or_fail("runtime: a function's link: ").bind(λ tp =>
            infer(acc).or_fail("runtime: the program's linking: ").bind(λ tq => pure(ap(both, [Hd(tp), Hd(tq), p, acc]))))),
    }
}

fn runtime_linked(q: RtQ, ts: RtTypes, l: Linking, insts: List<Pair<Expr, Expr>>) → Tac<Linked> {
    let fn_ctors <- runtime_ctors_at(ts.functions);
    let uncurried <- runtime_global(name_of(Compile::uncurried));
    let linked <- runtime_global(name_of(Compile::linked));
    let table <- runtime_global(name_of(Compile::table));
    let part <- runtime_global(name_of(Compile::part));
    let arity_of <- runtime_global(name_of(Compile::arity));
    let arity_at <- runtime_global(name_of(link_arity));
    let both <- runtime_global(name_of(link_both));
    let every <- runtime_global(name_of(link_every_table));
    let files_nil <- runtime_global(name_of(link_files_nil));
    let files_cons <- runtime_global(name_of(link_files_cons));
    let sources <- runtime_global(name_of(link_sources_at));
    let linked_files <- runtime_global(name_of(program_linked_files));
    let trivial_h <- resolve("trivial").or_fail("runtime: `trivial`: ");
    let links = l.tables.map(λ t => q.nat_list(runtime_links(l.order, t)));
    let types <- runtime_types(insts);
    // Function `i` with its type before it, as `Compile`'s members take it.
    let of: Nat → List<Expr> = λ i => match insts.nth(i) { None => [], Some(p) => [runtime_at(types, i), p.fst, p.snd] };
    let indices = List::range(insts.len());
    // Each function at each file: `Compile::uncurried` short of its file.
    let srcs <- runtime_held(indices.foldr(λ i acc => ap(files_cons, [ap(uncurried, of(i)), acc]), files_nil), "the program's sources");
    let last_first = indices.rev();
    let program <- runtime_held(RtQ::seq(fn_ctors, last_first.map(λ i => ap(linked, of(i) ++ [runtime_at(links, i)]))), "the program");
    let arities <- runtime_held(RtQ::seq(q.nats, last_first.map(λ i => ap(arity_of, of(i)))), "the program's arities");
    // Function `i` is `insts.len() - 1 - i` from the last, and is linked
    // against the functions before it.
    let parts = last_first.map(λ i => ap(part, of(i) ++ [srcs, runtime_at(links, i),
        ap(arity_at, [program, arities, NatLit(insts.len() - i)]), ap(every, [ap(table, of(i))]), Hd(trivial_h)]));
    let proof <- runtime_conjoined(both, parts, Hd(trivial_h));
    // The proof is cited by two members of the group (`f::sourced`, and
    // `f::agrees` at the last function). Held at its statement, each
    // mention is one node.
    let statement <- as_type(ap(linked_files, [program, arities, ap(sources, [srcs])])).or_fail("runtime: the program's linking: ");
    let held <- hole(statement).or_fail("runtime: the program's linking: ");
    let solved <- defeq(Hd(held), proof);
    match solved {
        True => pure(Linked(program, srcs, arities, Hd(held), Hd(statement))),
        False => runtime_fail("the program's linking does not prove its statement"),
    }
}

// A program's function names as numbers a tool reads: each name's
// characters' codes, then a zero.
fn runtime_name_codes(names: List<String>) → List<Nat> {
    match names { Nil => [], Cons(name, rest) => name.chars.map(λ (c: Char) => c.toNat()) ++ Cons(0, runtime_name_codes(rest)) }
}

// ---------------------------------------------------------------------------
// The generator: `runtime fn f(…) → … { … }`.

// Abstractions over locals, the first outermost.
fn runtime_lams(xs: List<LocalRef>, body: Expr) → Expr { xs.foldr(λ x acc => Lam(x, acc), body) }

// `Succ(n)` and `w.toNat()` as functions a generator can apply.
fn runtime_succ(n: Nat) → Nat { Succ(n) }

fn runtime_count(w: BitVec(64)) → Nat { w.toNat() }

// Binders of a statement opened in turn, each read in weak head normal form
// first (`ForWords` unfolds to one binder per word).
fn runtime_open_n(fuel: Nat, h: Handle, names: List<String>) → Tac<Pair<List<LocalRef>, Handle>> {
    match names {
        Nil => pure(Pair([], h)),
        Cons(n, rest) => match fuel {
            Zero => runtime_fail("a statement with more binders than the generator opens"),
            Succ(f) => whnf_or(h).bind(λ w => open(w, n).or_fail("runtime: a binder of a loop's statement: ").bind(λ o =>
                runtime_open_n(f, o.body, rest).bind(λ r => pure(Pair(Cons(o.local.ref, r.fst), r.snd))))),
        },
    }
}

// A measured function's measure at the words `xs`, and the domain of its
// recursor's bound proof at the bound `z`: `f::rec(z, xs…, h)` takes
// `h: μ(xs…) < z`.
fn runtime_bound_dom(rec: Expr, z: Expr, xs: List<Expr>) → Tac<Handle> {
    let t <- infer(ap(rec, Cons(z, xs))).or_fail("runtime: a measured function's recursor: ");
    let w <- whnf_or(t);
    let v <- view(w);
    match v { HPi(dom) => pure(dom), _ => runtime_fail("a measured function's recursor does not take its bound's proof") }
}

fn runtime_measure_of(dom: Handle) → Tac<Handle> {
    let v <- view(dom);
    match v {
        HGlobal(_, _, args) => match args {
            Cons(mu, _) => pure(mu),
            Nil => runtime_fail("a measured function's bound proof is not `μ < z`"),
        },
        _ => runtime_fail("a measured function's bound proof is not `μ < z`"),
    }
}

fn runtime_measure_at(rec: Expr, xs: List<Expr>) → Tac<Handle> {
    runtime_bound_dom(rec, NatLit(0), xs).bind(λ d => runtime_measure_of(d))
}

// The word a measure is the `toNat` of: a measured runtime fn's loop is
// given `2^64 - 1` passes, so its measure must be a 64-bit word's `toNat`.
fn runtime_measured_word(mu: Handle) → Tac<Handle> {
    let v <- view(mu);
    let refused = "a measured runtime fn must `decreases` a 64-bit word's `toNat` (its loop is given `2^64 - 1` passes)";
    match v {
        HGlobal(g, _, args) => runtime_ref(name_of(BitVec::toNat)).bind(λ (to_nat: GlobalRef) => match g.id.same(to_nat.id) {
            True => match args.rev() { Cons(x, _) => pure(x), Nil => runtime_fail(refused) },
            False => runtime_fail(refused),
        }),
        _ => runtime_fail(refused),
    }
}

// A word read at a parameter's code: a count as the word's `toNat`, a type
// held by its repr as the repr's `abs` of the word.
fn runtime_args(count: Expr, reprs: List<ReprEntry>, ps: List<Ty>, ys: List<Expr>) → List<Expr> {
    match ps {
        Nil => ys,
        Cons(p, rest) => match ys {
            Nil => Nil,
            Cons(y, more) => Cons(match p {
                Count => ap(count, [y]),
                Named(i) => match reprs.nth(i) { Some(e) => ap(Global(GlobalRef(e.abs)), [y]), None => y },
                _ => y,
            }, runtime_args(count, reprs, rest, more)),
        },
    }
}

// The function's result as the word it returns: a type held by its repr
// read back by the repr's `emb`.
fn runtime_result(reprs: List<ReprEntry>, r: Ty, e: Expr) → Expr {
    match r { Named(i) => match reprs.nth(i) { Some(en) => ap(Global(GlobalRef(en.emb)), [e]), None => e }, _ => e }
}

// The function's own values as the words a call passes them in: a type held
// by its repr read by the repr's `emb`.
fn runtime_embs(reprs: List<ReprEntry>, ps: List<Ty>, ys: List<Expr>) → List<Expr> {
    match ps {
        Nil => ys,
        Cons(p, rest) => match ys {
            Nil => Nil,
            Cons(y, more) => Cons(runtime_result(reprs, p, y), runtime_embs(reprs, rest, more)),
        },
    }
}

// A word read at the result's code: a type held by its repr as the repr's
// `abs` of it.
fn runtime_into(reprs: List<ReprEntry>, r: Ty, e: Expr) → Expr {
    match r { Named(i) => match reprs.nth(i) { Some(en) => ap(Global(GlobalRef(en.abs)), [e]), None => e }, _ => e }
}

// An equation of words read at the result's code (`abs` on both sides), and
// an equation at the result's code read as words (`emb`): itself at a word.
fn runtime_cong_into(cong: Expr, reprs: List<ReprEntry>, r: Ty, p: Expr) → Expr {
    match r { Named(i) => match reprs.nth(i) { Some(en) => ap(cong, [Blank, Blank, Global(GlobalRef(en.abs)), Blank, Blank, p]), None => p }, _ => p }
}

fn runtime_cong_out(cong: Expr, reprs: List<ReprEntry>, r: Ty, p: Expr) → Expr {
    match r { Named(i) => match reprs.nth(i) { Some(en) => ap(cong, [Blank, Blank, Global(GlobalRef(en.emb)), Blank, Blank, p]), None => p }, _ => p }
}

// The parameters' types, for the pin: a word, or the type a repr holds.
fn runtime_param_types(word: Handle, reprs: List<ReprEntry>, ps: List<Ty>) → List<Handle> {
    ps.map(λ p => match p { Named(i) => match reprs.nth(i) { Some(e) => e.ty, None => word }, _ => word })
}

fn runtime_params_at(ts: List<Handle>, under: Option<LocalRef>, i: Nat) → Tac<List<LocalRef>> {
    match ts {
        Nil => pure([]),
        Cons(t, rest) => assume(Hd(t), "x" ++ decimal_name(2, i), under).or_fail("runtime: a parameter: ").bind(λ x =>
            runtime_params_at(rest, Some(x.ref), Succ(i)).bind(λ more => pure(Cons(x.ref, more)))),
    }
}

// A check's verdict as an instance takes it: the equation of the check
// with `True`. An instance is compared with itself wherever a link names
// it twice, argument by argument at each argument's type, and a proof of
// `check.IsTrue()` is compared at a type the kernel must first compute:
// the whole lowering, again, each time. An equation's type is an equation
// whatever its sides.
fn runtime_verdict() → Tac<Expr> {
    let rfl <- runtime_global("tactic::rfl");
    let yes <- runtime_global("runtime::runtime_w_true");
    pure(ap(rfl, [Blank, yes]))
}

// A fuel recursion's instance: its two equations, `refl` per word at the
// function itself (design §16.11).
fn runtime_fuel_instance(f: GlobalRef, q: RtQ, ts: RtTypes, shapes: List<Expr>, setup, world_e, table_e, typed, count: Expr, reprs: List<ReprEntry>,
    w0: Ty, wrest: List<Ty>, res: Ty, c: Nat, zero, succ: Tm) → Tac<Expr> {
    let compile <- runtime_global(name_of(Setup::compile_fuel));
    let rfl <- runtime_global("tactic::rfl");
    let succ_g <- runtime_global(name_of(runtime_succ));
    let nat_h <- runtime_type_of(name_of(runtime_w_nat));
    let trivial_h <- resolve("trivial").or_fail("runtime: `trivial`: ");
    let verdict <- runtime_verdict();
    let ws = Cons(w0, wrest);
    let shaped = ap(rfl, [Blank, ap(runtime_at(shapes, 1), [Ty::quote(w0, q), Ty::quotes(wrest, q), Tm::quote(zero, q), Tm::quote(succ, q)])]);
    // Both equations hold at every file (the function reads none).
    let buffers_h <- runtime_type_of(name_of(runtime_w_buffers));
    let b0 <- assume(Hd(buffers_h), "b", None).or_fail("runtime: a file: ");
    let xs <- runtime_params(ts.word, ws, Some(b0.ref), 0);
    // Each word is read at its parameter's code (a repr's `abs`), as the
    // statements read it.
    let zero_eq = Lam(b0.ref, runtime_lams(xs, ap(rfl, [Blank, ap(Global(f), Cons(NatLit(0), runtime_args(count, reprs, ws, runtime_locals(xs))))])));
    let b1 <- assume(Hd(buffers_h), "b", None).or_fail("runtime: a file: ");
    let r <- assume(Hd(nat_h), "r", Some(b1.ref)).or_fail("runtime: a fuel: ");
    let ys <- runtime_params(ts.word, ws, Some(r.ref), 0);
    let step_eq = Lam(b1.ref, Lam(r.ref, runtime_lams(ys, ap(rfl, [Blank, ap(Global(f), Cons(ap(succ_g, [Local(r.ref)]),
        runtime_args(count, reprs, ws, runtime_locals(ys))))]))));
    pure(ap(compile, [Blank, setup, Ty::quote(w0, q), Ty::quotes(wrest, q), Ty::quote(res, q), NatLit(c), Tm::quote(zero, q), Tm::quote(succ, q),
        world_e, table_e, Global(f), typed, shaped, zero_eq, step_eq, verdict]))
}

// A function's words with the place of each span it is lent (word `2j` for
// span `j`) replaced by `spans`' `j`th: the function's own values, where it
// takes a span's bytes and its code takes their place.
fn runtime_spanned<A>(lent: Nat, spans, words: List<A>) → List<A> {
    match lent {
        Zero => words,
        Succ(n) => match spans {
            Nil => words,
            Cons(span, others) => match words {
                Nil => words,
                Cons(_, more) => match more {
                    Nil => Cons(span, more),
                    Cons(length, rest) => Cons(span, Cons(length, runtime_spanned(n, others, rest))),
                },
            },
        },
    }
}

// The places of the lent spans among a function's words.
fn runtime_places<A>(lent: Nat, words: List<A>) → List<A> {
    match lent {
        Zero => words.take(0),
        Succ(n) => match words { Nil => words, Cons(place, more) => Cons(place, runtime_places(n, more.drop(1))) },
    }
}

// A measured recursion's instance: its measure, the measure below `2^64`,
// and `Fun::Guarded` from the function's own `f::ext` and `f::irrel`
// (`lib/_tests/native/runtime/rt_loop_tests.hthr`'s `count_down_guarded`,
// spelled for any arity).
//
// A function lent spans takes each span's bytes where its code takes their
// place (`runtime_spanned`); its recursion is answered at every list of
// spans (`Setup::GuardedSpans`: the statement's first binder is the file,
// the pass is at the file's first spans, and each ih's spans are its own),
// each call handed the places the loop was entered with
// (`lib/_tests/native/runtime/runtime_spans_tests.hthr`'s `count_guarded`).
fn runtime_measured_instance(name: String, f: GlobalRef, q: RtQ, ts: RtTypes, shapes: List<Expr>, setup, world_e, table_e, typed, count: Expr,
    reprs: List<ReprEntry>, lent: Nat, ws: List<Ty>, res: Ty, body: Tm) → Tac<Expr> {
    let compile <- runtime_global(name_of(Setup::compile_measured));
    let rfl <- runtime_global("tactic::rfl");
    let sym_g <- runtime_global(name_of(Setup::eq_sym));
    let trans_g <- runtime_global(name_of(Setup::eq_trans));
    let cong_g <- runtime_global(name_of(Setup::eq_cong));
    let lt_succ <- runtime_global(name_of(Setup::lt_succ));
    let lt_pow <- runtime_global(name_of(Setup::below_pow));
    let on_words <- runtime_global(name_of(Ty::on_words));
    let guarded_g <- runtime_global(name_of(Setup::Guarded));
    let spans_g <- runtime_global(name_of(Setup::GuardedSpans));
    let span_g <- runtime_global(name_of(Setup::guarded_spans));
    let span_at <- runtime_global(name_of(Setup::span_at));
    let no_span <- runtime_global(name_of(runtime_w_bytes));
    let bytes_h <- runtime_type_of(name_of(runtime_w_bytes));
    let buffers_h <- runtime_type_of(name_of(runtime_w_buffers));
    let buffers <- runtime_ctors_at(buffers_h);
    let rec <- runtime_global(name ++ "::rec");
    let ext <- runtime_global(name ++ "::ext");
    let irrel <- runtime_global(name ++ "::irrel");
    let trivial_h <- resolve("trivial").or_fail("runtime: `trivial`: ");
    let verdict <- runtime_verdict();
    let word_list <- runtime_ctors_at(ts.words);
    let ks = ws.take(lent + lent);
    let moved = ws.drop(lent + lent);
    let ws_e = Ty::quotes(ws, q);
    let body_e = Tm::quote(body, q);
    let res_e = Ty::quote(res, q);
    let each: List<Nat> = List::range(lent);
    // The function's arguments from the code's words `xs` (each read at its
    // parameter's code, `abs`), each span in its place's stead.
    let at_codes: List<Expr> → List<LocalRef> → List<Expr> = λ spans xs => runtime_spanned(lent, spans, runtime_args(count, reprs, ws, runtime_locals(xs)));
    // The function's own values `ys` passed as the words a call passes
    // (`emb`), each place where its span is; and the spans they are at,
    // where the statements are indexed by them.
    let list: List<Expr> → List<LocalRef> → Expr = λ places ys => RtQ::seq(word_list, runtime_spanned(lent, places, runtime_embs(reprs, ws, runtime_locals(ys))));
    let index: List<LocalRef> → List<Expr> = λ ys => match lent { Zero => Nil, Succ(_) => [RtQ::seq(buffers, runtime_places(lent, runtime_locals(ys)))] };
    let typed_params: List<Handle> = runtime_spanned(lent, each.map(λ _ => bytes_h), runtime_param_types(ts.word, reprs, ws));
    let no_spans: List<Expr> = each.map(λ _ => no_span);
    let shaped = ap(rfl, [Blank, ap(runtime_at(shapes, 2), [Ty::quotes(ks, q), Ty::quote(moved.head_or(Bit), q), Ty::quotes(moved.drop(1), q), body_e])]);
    // The measure, as a function of the words: it reads no span (one that
    // did would not be this function's, and the instance would not check).
    let zs <- runtime_params(ts.word, ws, None, 0);
    let mu_z <- runtime_measure_at(rec, at_codes(no_spans, zs));
    let m_e = ap(on_words, [ws_e, runtime_lams(zs, Hd(mu_z))]);
    // Below `2^64`: the measure is a word's `toNat`.
    let bs <- runtime_params(ts.word, ws, None, 0);
    let mu_b <- runtime_measure_at(rec, at_codes(no_spans, bs));
    let word_b <- runtime_measured_word(mu_b);
    let bounded = runtime_lams(bs, ap(lt_pow, [Hd(word_b)]));
    // `Guarded`: its binders opened off its statement (the file; the words;
    // the recursion `again`, keyed by the spans where the function is lent
    // any; and what `again` agrees with below the measure).
    let stated: Expr = match lent {
        Zero => ap(guarded_g, [Blank, Global(f), NatLit(0), ws_e, res_e, body_e, world_e, table_e, typed, m_e]),
        Succ(_) => ap(spans_g, [Blank, Global(f), NatLit(lent), ws_e, res_e, body_e, world_e, table_e, typed, m_e]),
    };
    let g_t <- as_type(stated).or_fail("runtime: a measured function's `Guarded`: ");
    let words: List<String> = List::range(ws.len()).map(λ i => "x".append(decimal_name(2, i)));
    let names = Cons("b", words.append(["again", "hyp"]));
    let opened <- runtime_open_n(64, g_t, names);
    let first = opened.fst.head_or(LocalRef(0));
    // The spans this pass is at: the file's first, as the statement's key
    // spells them.
    let here: List<Expr> = each.map(λ k => ap(span_at, [Local(first), NatLit(k)]));
    let xs = opened.fst.drop(1).take(ws.len());
    let place: List<Expr> = runtime_places(lent, runtime_locals(xs));
    let again = opened.fst.nth(Succ(ws.len())).unwrap_or(LocalRef(0));
    let hyp = opened.fst.nth(Succ(Succ(ws.len()))).unwrap_or(LocalRef(0));
    let mu_x <- runtime_measure_at(rec, at_codes(here, xs));
    let n_e = Hd(mu_x);
    // `g1 = λ y… p => f::rec(N, y…, p)`.
    let ys1 <- runtime_params_at(typed_params, Some(hyp), 0);
    let d1 <- runtime_bound_dom(rec, n_e, runtime_locals(ys1));
    let p1 <- assume(Hd(d1), "p", Some(ys1.rev().head_or(hyp))).or_fail("runtime: a bound proof: ");
    let g1 = runtime_lams(ys1.append([p1.ref]), ap(rec, Cons(n_e, runtime_locals(ys1).append([Local(p1.ref)]))));
    // `g2 = λ y… _ => again([y…])`, the words read back at the result's code.
    let ys2 <- runtime_params_at(typed_params, Some(hyp), 0);
    let d2 <- runtime_bound_dom(rec, n_e, runtime_locals(ys2));
    let p2 <- assume(Hd(d2), "q", Some(ys2.rev().head_or(hyp))).or_fail("runtime: a bound proof: ");
    let g2 = runtime_lams(ys2.append([p2.ref]), runtime_into(reprs, res, ap(Local(again), index(ys2).append([list(place, ys2)]))));
    // They agree: `f::irrel` on the left, the hypothesis on the right.
    let ys3 <- runtime_params_at(typed_params, Some(hyp), 0);
    let d3 <- runtime_bound_dom(rec, n_e, runtime_locals(ys3));
    let mu_y <- runtime_measure_of(d3);
    let p3 <- assume(Hd(d3), "p", Some(ys3.rev().head_or(hyp))).or_fail("runtime: a bound proof: ");
    let q3 <- assume(Hd(d3), "q", Some(p3.ref)).or_fail("runtime: a bound proof: ");
    let irr = ap(irrel, Cons(n_e, Cons(Blank, runtime_locals(ys3).append([Local(p3.ref), ap(lt_succ, [Hd(mu_y)])]))));
    let hy = runtime_cong_into(cong_g, reprs, res, ap(Local(hyp), index(ys3).append([list(place, ys3), ap(rfl, [Blank, NatLit(ws.len())]), Local(p3.ref)])));
    let hg = runtime_lams(ys3.append([p3.ref, q3.ref]), ap(trans_g, [Blank, Blank, Blank, Blank, irr, ap(sym_g, [Blank, Blank, Blank, hy])]));
    let lt_n = ap(lt_succ, [n_e]);
    let proved = runtime_lams(Cons(first, xs.append([again, hyp])),
        ap(sym_g, [Blank, Blank, Blank, runtime_cong_out(cong_g, reprs, res, ap(ext, Cons(n_e, Cons(n_e, Cons(g1, Cons(g2, Cons(hg, at_codes(here, xs).append([lt_n, lt_n]))))))))]));
    // At a span, the family gives `Guarded` at each file through the file's
    // span 0.
    let guarded: Expr = match lent {
        Zero => proved,
        Succ(_) => ap(span_g, [Blank, Global(f), NatLit(lent), ws_e, res_e, body_e, world_e, table_e, typed, m_e, proved]),
    };
    pure(ap(compile, [Blank, setup, Ty::quotes(ks, q), Ty::quote(moved.head_or(Bit), q), Ty::quotes(moved.drop(1), q), res_e, body_e, NatLit(lent),
        world_e, table_e, Global(f), typed, shaped, m_e, bounded, guarded, verdict]))
}

// The `Compile(f)` instance, by the reflection's shape. `table_e` is the
// function's table at each file: its world's own for a function lent
// nothing, `Setup::lent_callees` for one lent spans.
fn runtime_instance(name: String, f: GlobalRef, rfun: Fun, q: RtQ, ts: RtTypes, setup, world_e, table_e, rt_e, count: Expr, reprs: List<ReprEntry>) → Tac<Expr> {
    let rfl <- runtime_global("tactic::rfl");
    let typed_refl <- runtime_global(name_of(Setup::typed_refl));
    let trivial_h <- resolve("trivial").or_fail("runtime: `trivial`: ");
    let verdict <- runtime_verdict();
    let shapes <- runtime_type_of(name_of(runtime_w_shape)).bind(λ h => runtime_ctors_at(h));
    let typed = ap(typed_refl, [Blank, Global(f)]);
    let at_every <- runtime_global(name_of(Setup::at_every));
    let lent_every <- runtime_global(name_of(Setup::lent_every));
    match rfun.shape() {
        Plain => runtime_global(name_of(Setup::compile)).bind(λ compile => {
            // The pin: the function itself at every file, or it at each
            // file's spans.
            let pinned: Expr = match rfun.lent {
                Zero => ap(at_every, [Blank, Global(f)]),
                Succ(_) => ap(lent_every, [Blank, Global(f), world_e, table_e, NatLit(rfun.lent), Ty::quotes(rfun.params, q), Ty::quote(rfun.result, q), typed]),
            };
            pure(ap(compile, [Blank, setup, rt_e, world_e, table_e, Global(f), typed, pinned, verdict, ap(rfl, [Blank, runtime_at(shapes, 0)])]))
        }),
        Fuel(w0, wrest, zero, succ) => match rfun.body {
            Case(c, _, _) => runtime_fuel_instance(f, q, ts, shapes, setup, world_e, table_e, typed, count, reprs, w0, wrest, rfun.result, c, zero, succ),
            _ => runtime_fail("a fuel recursion whose body is not its fuel's `match`"),
        },
        Measured(ks, w0, wrest, body) =>
            runtime_measured_instance(name, f, q, ts, shapes, setup, world_e, table_e, typed, count, reprs, rfun.lent, ks ++ Cons(w0, wrest), rfun.result, body),
    }
}

fn runtime_repr_infos(word: Handle, word_repr, rfl: Expr, reprs: List<ReprEntry>) → Tac<List<Expr>> {
    match reprs {
        Nil => pure([]),
        Cons(e, rest) => {
            let x <- assume(Hd(word), "w", None).or_fail("runtime: a repr's word: ");
            let round = Lam(x.ref, ap(rfl, [Blank, Local(x.ref)]));
            let s <- assume(Hd(e.ty), "s", None).or_fail("runtime: a repr's value: ");
            let back = Lam(s.ref, ap(rfl, [Blank, Local(s.ref)]));
            let more <- runtime_repr_infos(word, word_repr, rfl, rest);
            pure(Cons(ap(word_repr, [Blank, Global(GlobalRef(e.abs)), Global(GlobalRef(e.emb)), round, back]), more))
        },
    }
}

// The world's type table: none without reprs, else each repr's
// `RecInfo::word_repr`, its round trips `refl` at each word and each value.
fn runtime_tys(word: Handle, reprs: List<ReprEntry>) → Tac<Expr> {
    match reprs {
        Nil => runtime_global(name_of(RecInfo::none)),
        Cons(_, _) => {
            let cons <- runtime_global(name_of(RecInfo::cons));
            let none <- runtime_global(name_of(RecInfo::none));
            let word_repr <- runtime_global(name_of(RecInfo::word_repr));
            let rfl <- runtime_global("tactic::rfl");
            let entries <- runtime_repr_infos(word, word_repr, rfl, reprs);
            let table = entries.foldr(λ e acc => ap(cons, [e, acc]), none);
            // Held as a hole solved by it: a repr's round trip abstracts a
            // local opened here, and a `Lam` reifies only where its local
            // was opened, while a handle stands anywhere.
            let t <- infer(table).or_fail("runtime: the type table: ");
            let held <- hole(t).or_fail("runtime: the type table: ");
            let solved <- defeq(Hd(held), table);
            match solved { True => pure(Hd(held)), False => runtime_fail("the type table does not solve its hole") }
        },
    }
}

// A repr's carrier, read off its `emb`'s type.
fn runtime_carrier(k: Known, rname: String, et: Handle) → Tac<Ty> {
    let ev <- view(et);
    match ev {
        HPi(_) => open(et, "s").or_fail("runtime: `" ++ rname ++ "::emb`: ").bind(λ o => k.ty(o.body)),
        _ => runtime_fail("`" ++ rname ++ "::emb` is not a function"),
    }
}

// Every repr the program reads holds its type in one 64-bit word (the
// boundary passes one).
fn runtime_check_carriers(k: Known, rs: List<ReprEntry>) → Tac<True> {
    match rs {
        Nil => pure(trivial),
        Cons(e, rest) => {
            let rname = e.name;
            let et <- infer(Global(GlobalRef(e.emb))).or_fail("runtime: `" ++ rname ++ "::emb`: ");
            let carrier <- runtime_carrier(k, rname, et);
            match carrier.is_word64() {
                True => runtime_check_carriers(k, rest),
                False => runtime_fail("the datarepr `" ++ rname ++ "` holds its type in something other than one 64-bit word: a repr'd type crosses a function's boundary in one (issues/runtime-repr-narrow-words.md)"),
            }
        },
    }
}

// A lent function's arguments at a file, from its code's words: span `j`
// of the file where the code takes that span's place, the words as they
// are.
fn runtime_lent_args(span, file: Expr, j: Nat, lent: Nat, xs: List<Expr>) → List<Expr> {
    match lent {
        Zero => xs,
        Succ(n) => match xs {
            Nil => Nil,
            Cons(_, more) => match more {
                Nil => Nil,
                Cons(length, rest) => Cons(ap(span, [file, NatLit(j)]), Cons(length, runtime_lent_args(span, file, Succ(j), n, rest))),
            },
        },
    }
}

// A table at each file, an entry at a time (`Setup::lent_callees`): each
// function with its signature and the spans it is lent.
fn runtime_file_callees_of(entry, typed_once, nil, tys_e: Expr, q: RtQ, funs: List<Expr>, sigs: List<Sig>, lents: List<Nat>) → Expr {
    match funs {
        Nil => ap(nil, [tys_e]),
        Cons(g, rest) => {
            let s = sigs.head_or(Sig([], Bit));
            ap(entry, [Blank, g, tys_e, NatLit(lents.head_or(0)), Ty::quotes(s.params, q), Ty::quote(s.result, q),
                ap(typed_once, [Blank, g]), RtQ::seq(q.sigs, sigs.drop(1).map(λ t => Sig::quote(t, q))),
                runtime_file_callees_of(entry, typed_once, nil, tys_e, q, rest, sigs.drop(1), lents.drop(1))])
        },
    }
}

fn runtime_file_callees(entry, typed_once, nil, tys_e: Expr, q: RtQ, funs: List<Nat>, sigs: List<Sig>, lents: List<Nat>) → Expr {
    runtime_file_callees_of(entry, typed_once, nil, tys_e, q, funs.map(λ g => Global(GlobalRef(g))), sigs, lents)
}

// `lents` says how many spans each function of `funs` is lent (the function
// itself first).
fn runtime_publish(name: String, f: GlobalRef, rfun: Fun, sigs: List<Sig>, funs: List<Nat>, lents: List<Nat>, l: Linking, reprs: List<ReprEntry>) → Tac<List<Decl>> {
    let ts <- runtime_type_handles();
    let q <- runtime_quoting(ts);
    // `refl` at a closed term, its type given: checked against a statement
    // by conversion (the kernel's), where a hole would be left to the
    // unifier, which does not unfold the reflection's meaning.
    let rfl <- runtime_global("tactic::rfl");
    let trivial_h <- resolve("trivial").or_fail("runtime: `trivial`: ");
    let pair <- runtime_global(name_of(Pair::of));
    let callees = runtime_callees(pair, Hd(trivial_h), funs);
    let world_of <- runtime_global(name_of(World::of));
    let tys_e <- runtime_tys(ts.word, reprs);
    let setup <- runtime_global(name_of(Setup::default));
    let verdicts <- runtime_ctors_at(ts.verdict);
    let judge <- runtime_global(name_of(Fun::judge));
    let meaning <- runtime_global(name_of(Fun::meaning));
    let code_of <- runtime_global(name_of(Setup::code));
    let program_eval <- runtime_global(name_of(program_eval));
    let program_eval_over <- runtime_global(name_of(program_eval_over));
    let eval_sources <- runtime_global(name_of(program_linked_files_sources));
    let sources <- runtime_global(name_of(link_sources_at));
    let count <- runtime_global(name_of(runtime_count));
    let word_list <- runtime_ctors_at(ts.words);
    let ft <- infer(Global(f)).or_fail("runtime: `" ++ name ++ "`'s type: ");
    let rt_e = Fun::quote(rfun, q);
    let sigs_e = RtQ::seq(q.sigs, sigs.map(λ s => Sig::quote(s, q)));
    // The table at each file. A function lent nothing has its world's own;
    // one lent spans has each of its functions at each file's spans, and
    // its world is that table at the empty file.
    let fixed <- runtime_global(name_of(World::fixed));
    let lent_callees <- runtime_global(name_of(Setup::lent_callees));
    let callees_nil <- runtime_global(name_of(Setup::callees_nil));
    let typed_once <- runtime_global(name_of(Setup::typed_once));
    let no_file <- runtime_global(name_of(runtime_w_buffers));
    let lent_table = runtime_file_callees(lent_callees, typed_once, callees_nil, tys_e, q, funs, sigs, lents);
    let world_e: Expr = match rfun.lent {
        Zero => ap(world_of, [tys_e, sigs_e, callees]),
        Succ(_) => ap(world_of, [tys_e, sigs_e, ap(lent_table, [no_file])]),
    };
    let table_e: Expr = match rfun.lent { Zero => ap(fixed, [world_e]), Succ(_) => lent_table };
    let code_e = ap(code_of, [setup, rt_e, world_e]);
    let built <- runtime_instance(name, f, rfun, q, ts, setup, world_e, table_e, rt_e, count, reprs);
    let instance_t <- infer(built).or_fail("runtime: `" ++ name ++ "`'s instance: ");
    // Held as a hole solved by it: a loop's instance abstracts locals opened
    // here, and a `Lam` reifies only where its local was opened, while a
    // handle stands anywhere (`f::agrees` reads it under its parameters).
    let held <- hole(instance_t).or_fail("runtime: `" ++ name ++ "`'s instance: ");
    let solved <- defeq(Hd(held), built);
    let instance_e <- match solved { True => pure(Hd(held)), False => runtime_fail("`" ++ name ++ "`'s instance does not solve its hole") };
    let head: List<Decl> = [
        Decl(AsValue, name ++ "::rt", [], Hd(ts.fun_t), rt_e),
        Decl(AsValue, name ++ "::world", [], Hd(ts.world), world_e),
        Decl(AsTheorem, name ++ "::judged", [], Equation(ap(judge, [rt_e, world_e]), runtime_at(verdicts, 0)),
            ap(rfl, [Blank, runtime_at(verdicts, 0)]))];
    let made: List<Decl> = [
        Decl(AsValue, name ++ "::code", [], Hd(ts.function), code_e),
        Decl(AsInstance("runtime::Compile", [Hd(ft)], [name]), name ++ "::compile", [], Hd(instance_t), instance_e)];
    let own_types = runtime_param_types(ts.word, reprs, rfun.params);
    // The program: this function and every runtime fn it reaches, each
    // callee's code from its own instance, linked at every file.
    let insts <- runtime_instances(l.order, l.names, f.id, Global(f), instance_e);
    let linked <- runtime_linked(q, ts, l, insts);
    let root = NatLit(l.order.len() - 1);
    let srcs_t <- infer(linked.srcs).or_fail("runtime: `" ++ name ++ "`'s sources: ");
    let linked_decls: List<Decl> = [
        Decl(AsValue, name ++ "::program", [], Hd(ts.functions), linked.program),
        // How many words each function of the program takes, as the
        // program lists them: what a certificate checks each function's
        // calls against without reading its callees' code.
        Decl(AsValue, name ++ "::arities", [], Hd(ts.nats), linked.arities),
        // Every function of the program against its source, and not the
        // last alone: what a caller of another of its functions cites (an
        // export with several entries, docs/native/native-library-exports-design.md
        // §6.3). `f::names` is which function is where: each function's
        // name as its characters' codes, a zero after each, the first
        // function's first.
        Decl(AsValue, name ++ "::sources", [], Hd(srcs_t), linked.srcs),
        Decl(AsTheorem, name ++ "::sourced", [], linked.statement, linked.sourced),
        Decl(AsValue, name ++ "::names", [], Hd(ts.nats), q.nat_list(runtime_name_codes(l.names)))];
    match rfun.lent {
        Zero => {
            // `f::reflects` and `f::agrees` quantify over the parameters (`f::agrees`
            // reads a count off its word, as a call passes it).
            let xs <- runtime_params_at(own_types, None, 0);
            let ys <- runtime_params(ts.word, rfun.params, None, 0);
            let at_ys = runtime_locals(ys);
            let words_e = RtQ::seq(word_list, at_ys);
            // The pin, for a function its reflection's meaning converts to: a loop's
            // meaning is one step of it, which is the function only at a
            // constructor fuel (or a measure's bound), so its instance rests on its
            // equations instead.
            let pin: List<Decl> = match rfun.shape() {
                Plain => [Decl(AsTheorem, name ++ "::reflects", runtime_params_of(xs),
                    Equation(ap(ap(meaning, [rt_e, world_e]), runtime_locals(xs)), ap(Global(f), runtime_locals(xs))),
                    ap(rfl, [Blank, ap(Global(f), runtime_locals(xs))]))],
                _ => [],
            };
            // A function lent nothing: its program at the empty file, which
            // is `program_eval`.
            let tail: List<Decl> = [
                Decl(AsTheorem, name ++ "::agrees", runtime_params_of(ys),
                    Equation(ap(program_eval, [linked.program, root, words_e]), runtime_result(reprs, rfun.result, ap(Global(f), runtime_args(count, reprs, rfun.params, at_ys)))),
                    ap(eval_sources, [linked.program, linked.arities, ap(sources, [linked.srcs]), linked.sourced, no_file, root, words_e, Hd(trivial_h)])),
            ];
            pure(head.append(pin).append(made).append(linked_decls).append(tail))
        },
        // A function lent spans: its pin and its program's agreement are at
        // every file (the reflection's meaning in the world there, and the
        // program evaluated over the file, against the function at the
        // file's spans).
        Succ(_) => {
            let buffers_h <- runtime_type_of(name_of(runtime_w_buffers));
            let world_at <- runtime_global(name_of(World::at));
            let span <- runtime_global(name_of(List::span));
            let b <- assume(Hd(buffers_h), "b", None).or_fail("runtime: a file: ");
            let xs <- runtime_params_at(own_types, Some(b.ref), 0);
            let own = runtime_lent_args(span, Local(b.ref), 0, rfun.lent, runtime_locals(xs));
            let pin: List<Decl> = match rfun.shape() {
                Plain => [Decl(AsTheorem, name ++ "::reflects", runtime_params_of(Cons(b.ref, xs)),
                    Equation(ap(ap(meaning, [rt_e, ap(world_at, [world_e, table_e, Local(b.ref)])]), runtime_locals(xs)), ap(Global(f), own)),
                    ap(rfl, [Blank, ap(Global(f), own)]))],
                _ => [],
            };
            let c <- assume(Hd(buffers_h), "b", None).or_fail("runtime: a file: ");
            let ys <- runtime_params(ts.word, rfun.params, Some(c.ref), 0);
            let at_ys = runtime_locals(ys);
            let words_e = RtQ::seq(word_list, at_ys);
            let at_file = runtime_lent_args(span, Local(c.ref), 0, rfun.lent, runtime_args(count, reprs, rfun.params, at_ys));
            let tail: List<Decl> = [
                Decl(AsTheorem, name ++ "::agrees_over", runtime_params_of(Cons(c.ref, ys)),
                    Equation(ap(program_eval_over, [Local(c.ref), linked.program, root, words_e]), runtime_result(reprs, rfun.result, ap(Global(f), at_file))),
                    ap(eval_sources, [linked.program, linked.arities, ap(sources, [linked.srcs]), linked.sourced, Local(c.ref), root, words_e, Hd(trivial_h)])),
            ];
            pure(head.append(pin).append(made).append(linked_decls).append(tail))
        },
    }
}

// The type table the generator judges and lowers against: each repr's
// shape, one 64-bit word (a `RecInfo` is too large for `foldr`'s result).
fn runtime_shapes(reprs: List<ReprEntry>) → Nat → RecInfo {
    match reprs { Nil => RecInfo::none, Cons(_, rest) => RecInfo::cons(RecInfo::shape([Word(64)]), runtime_shapes(rest)) }
}

// ---------------------------------------------------------------------------
// A runtime fn that writes a span (docs/native/native-one-compiler-design.md §2.6,
// U4 step 4c-3c): a function from a span's bytes to `Mutated`, a `mut self`
// method's kernel type. The generator reads it as a computation over the
// file (`rt_file_reflect.hthr`), builds its `CompileSpan` instance
// (`runtime_file.hthr`) from the once-proved lowering, and links it with
// every runtime fn it reaches, of either kind, over the run
// (`function_ir_link.hthr`).
//
// What it publishes names `runtime_file` and the modules that imports, by
// name, at the function: a module that declares such a function imports
// them, and one whose runtime fns only read does not.
//
//   | `f::rt`        | the reflection, an `FFun`                             |
//   | `f::world`     | the functions it calls that only read, at no file     |
//   | `f::writes`    | the functions it calls that write, each as a meaning  |
//   | `f::reflects`  | the reflection's meaning is `f` at every rest of the  |
//   |                | file, by conversion (a function with no recursion)    |
//   | `f::code`      | the FunctionIR function it lowers to                  |
//   | `f::compile`   | the `CompileSpan(f)` instance                         |
//   | `f::program`   | the program of `f` and every runtime fn it reaches    |
//   | `f::arities`   | how many words each takes, the last function's first  |
//   | `f::stills`    | which of them leave the file (the ones that only      |
//   |                | read), likewise                                       |
//   | `f::runs_over` | the program run on `[place, length, xs…]` over any    |
//   |                | file `Cons(span, rest)` ends in `f(span, length,      |
//   |                | xs…)`'s word and its span over `rest`                 |

def runtime_w_ftm: FTm = FTm::Pure(Var(0));
def runtime_w_ffun: FFun = FFun([], Bit, FTm::Pure(Var(0)));
def runtime_w_bools: List<Bool> = [];
def runtime_w_true: Bool = True;

fn runtime_span_ref(name: String) → Tac<Expr> {
    lookup(name).or_fail("runtime: `" ++ name ++ "` is not in scope (a runtime fn that writes a span needs `import runtime_file;` and the modules `runtime_file` imports): ")
        .bind(λ g => pure(Global(g)))
}

fn runtime_span_refused<A>(name: String, why: String) → Tac<A> {
    fail("`" ++ name ++ "` cannot be a runtime fn that writes a span: " ++ why, [])
}

// Whether a function's type ends in `Mutated`: the type of a function that
// threads something it changes, which for a runtime fn is a span.
fn runtime_ends_in(fuel: Nat, mutated: Nat, t: Handle) → Tac<Bool> {
    match fuel {
        Zero => pure(False),
        Succ(more) => view(t).bind(λ v => match v {
            HPi(_) => open(t, "x").bind(λ c => match c { Accepted(o) => runtime_ends_in(more, mutated, o.body), Refused(_) => pure(False) }),
            HGlobal(g, _, _) => pure(g.id.same(mutated)),
            _ => pure(False),
        }),
    }
}

fn runtime_writes(f: GlobalRef) → Tac<Bool> {
    lookup("Mutated").bind(λ c => match c {
        Refused(_) => pure(False),
        Accepted(m) => infer(Global(f)).bind(λ t => match t { Accepted(h) => runtime_ends_in(64, m.id, h), Refused(_) => pure(False) }),
    })
}

// The constructors quoting a computation reads: `FTm`'s, the list of
// views', a view's, and those of where a view starts.
def runtime_w_views: List<FView> = [];
def runtime_w_view: FView = FView(0, 0, None, 0);
def runtime_w_start: Option<Nat> = None;

record FtQ { tm: List<Expr>, views: List<Expr>, view: List<Expr>, start: List<Expr> }

fn runtime_file_quoting() → Tac<FtQ> {
    let tms <- runtime_type_of(name_of(runtime_w_ftm)).bind(λ h => runtime_ctors_at(h));
    let views <- runtime_type_of(name_of(runtime_w_views)).bind(λ h => runtime_ctors_at(h));
    let view <- runtime_type_of(name_of(runtime_w_view)).bind(λ h => runtime_ctors_at(h));
    let start <- runtime_type_of(name_of(runtime_w_start)).bind(λ h => runtime_ctors_at(h));
    pure(FtQ(tms, views, view, start))
}

fn FView::quote(self view: FView, cs: FtQ) → Expr {
    let start: Expr = match view.start { None => runtime_at(cs.start, 0), Some(s) => ap(runtime_at(cs.start, 1), [NatLit(s)]) };
    ap(runtime_at(cs.view, 0), [NatLit(view.span), NatLit(view.home), start, NatLit(view.end)])
}

fn FTm::quote(self t: FTm, q: RtQ, cs: FtQ) → Expr {
    match t {
        Pure(v) => ap(runtime_at(cs.tm, 0), [v.quote(q)]),
        Let(e, body) => ap(runtime_at(cs.tm, 1), [e.quote(q), body.quote(q, cs)]),
        If(c, yes, no) => ap(runtime_at(cs.tm, 2), [NatLit(c), yes.quote(q, cs), no.quote(q, cs)]),
        IfEq(c, yes, no) => ap(runtime_at(cs.tm, 3), [NatLit(c), yes.quote(q, cs), no.quote(q, cs)]),
        Put(i, length, v, body) => ap(runtime_at(cs.tm, 4), [NatLit(i), NatLit(length), NatLit(v), body.quote(q, cs)]),
        Call(f, args, body) => ap(runtime_at(cs.tm, 5), [NatLit(f), q.nat_list(args), body.quote(q, cs)]),
        Again(args) => ap(runtime_at(cs.tm, 6), [q.nat_list(args)]),
        Lend(f, views, args, body) => ap(runtime_at(cs.tm, 7),
            [NatLit(f), RtQ::seq(cs.views, views.map(λ view => view.quote(cs))), q.nat_list(args), body.quote(q, cs)]),
    }
}

// The signature of a callee that writes, read off its type: how many
// spans it is lent, the words its code takes (two for each span) and the
// code of the word it returns beside the span.
fn runtime_span_sig_from(fuel: Nat, k: Known, names: FileNames, t: Handle, ps: List<Ty>) → Tac<Pair<Nat, Sig>> {
    match fuel {
        Zero => runtime_fail("a callee with more parameters than the generator reads"),
        Succ(f) => view(t).bind(λ v => match v {
            HPi(dom) => k.ty(dom).bind(λ p => open(t, "x").or_fail("runtime: a callee's type: ").bind(λ o =>
                runtime_span_sig_from(f, k, names, o.body, ps ++ [p]))),
            _ => rt_file_result(4, k, names, t).bind(λ r => rt_file_codes(ps).bind(λ codes => pure(Pair(codes.fst, Sig(codes.snd, r))))),
        }),
    }
}

fn runtime_span_sigs(k: Known, names: FileNames, gs: List<Nat>) → Tac<List<Pair<Nat, Sig>>> {
    match gs {
        Nil => pure([]),
        Cons(g, rest) => infer(Global(GlobalRef(g))).or_fail("runtime: a callee's type: ").bind(λ t =>
            runtime_span_sig_from(64, k, names, t, []).bind(λ s => runtime_span_sigs(k, names, rest).bind(λ ss => pure(Cons(s, ss))))),
    }
}

// The table of the functions that write, an entry at a time
// (`FTm::sems_cons`): a function of the spans the file has after the
// written one, since a function that writes may read them.
fn runtime_span_writers_of(cons, nil, typed_once, tys_e: Expr, q: RtQ, gs: List<Expr>, sigs: List<Pair<Nat, Sig>>) → Expr {
    match gs {
        Nil => ap(nil, [tys_e]),
        Cons(g, rest) => {
            let s = sigs.head_or(Pair(1, Sig([], Bit)));
            ap(cons, [Blank, g, tys_e, NatLit(s.fst), Ty::quotes(s.snd.params, q), Ty::quote(s.snd.result, q),
                ap(typed_once, [Blank, g]), RtQ::seq(q.sigs, sigs.drop(1).map(λ t => Sig::quote(t.snd, q))),
                runtime_span_writers_of(cons, nil, typed_once, tys_e, q, rest, sigs.drop(1))])
        },
    }
}

fn runtime_span_writers(cons, nil, typed_once, tys_e: Expr, q: RtQ, gs: List<Nat>, sigs: List<Pair<Nat, Sig>>) → Expr {
    runtime_span_writers_of(cons, nil, typed_once, tys_e, q, gs.map(λ g => Global(GlobalRef(g))), sigs)
}

// What a function that writes is stated against, as terms: the types, the
// reading callees' signatures, world and table at each file, the writing
// callees' signatures and table, and `typed`.
record SpanE { tys: Expr, sigs: Expr, world: Expr, reads: Expr, fsigs: Expr, writes: Expr, typed: Expr }

// A measured recursion's instance: its measure (which may read the spans),
// the measure below `2^64`, and the function's own equation from its
// `f::ext` and `f::irrel`, at every rest of the file with the recursion
// answered at every list of the spans read (`FFun::GuardedSpans`;
// `lib/_tests/native/runtime/runtime_file_tests.hthr`'s `raise_guarded` is
// the proof at one span, by hand). The function's own values are its spans
// and the words that are not a span's place; a recursion is handed the
// places the loop was entered with, and is keyed by the spans it is at.
fn runtime_span_measured(name: String, f: GlobalRef, q: RtQ, ts: RtTypes, e: SpanE, body_e: Expr, ws: List<Ty>, res: Ty, lent: Nat) → Tac<Expr> {
    let compile <- runtime_span_ref("runtime_file::FFun::compile_measured");
    let family <- runtime_span_ref("runtime_file::FFun::GuardedSpans");
    let from_family <- runtime_span_ref("runtime_file::FFun::guarded_spans");
    let measure_at <- runtime_span_ref("runtime_file::FFun::measure_at");
    let on_words <- runtime_span_ref("runtime_file::FFun::on_words");
    let recast <- runtime_span_ref(name_of(FTm::recast));
    let rfl <- runtime_global("tactic::rfl");
    let sym_g <- runtime_global(name_of(Setup::eq_sym));
    let trans_g <- runtime_global(name_of(Setup::eq_trans));
    let cong_g <- runtime_global(name_of(Setup::eq_cong));
    let lt_succ <- runtime_global(name_of(Setup::lt_succ));
    let lt_pow <- runtime_global(name_of(Setup::below_pow));
    let span_at <- runtime_global(name_of(Setup::span_at));
    let bytes_h <- runtime_type_of(name_of(runtime_w_bytes));
    let buffers_h <- runtime_type_of(name_of(runtime_w_buffers));
    let buffers <- runtime_ctors_at(buffers_h);
    let rec <- runtime_global(name ++ "::rec");
    let companion <- lookup(name ++ "::ext");
    let found: Tac<Expr> = match companion {
        Accepted(g) => pure(Global(g)),
        Refused(_) => runtime_span_refused(name, "it has no `ext` companion, which a loop's instance is built from: the function's own call is where a `decreases` function's companions do not follow it (docs/language/recursion/decreases-unfolding-design.md)"),
    };
    let ext <- found;
    let irrel <- runtime_global(name ++ "::irrel");
    let trivial_h <- resolve("trivial").or_fail("runtime: `trivial`: ");
    let verdict <- runtime_verdict();
    let word_list <- runtime_ctors_at(ts.words);
    let ks = ws.take(lent + lent);
    let moved = ws.drop(lent + lent);
    let ws_e = Ty::quotes(ws, q);
    let res_e = Ty::quote(res, q);
    let w64 = Ty::quote(Word(64), q);
    let lead = λ (xs: List<LocalRef>) => xs.head_or(LocalRef(0));
    let each: List<Nat> = List::range(lent.pred());
    // The spans read at a rest of the file: its first.
    let reads_at: Expr → List<Expr> = λ rest => each.map(λ k => ap(span_at, [rest, NatLit(k)]));
    // The function's arguments from the written span, the spans read and
    // the code's words `xs`: each span in its place's stead.
    let at_f: Expr → List<Expr> → List<LocalRef> → List<Expr> = λ span reads xs => runtime_spanned(lent, Cons(span, reads), runtime_locals(xs));
    // The function's own values `ys` as the words a call passes, each place
    // where its span is, and the spans read among them, which a recursion
    // is keyed by.
    let list: List<Expr> → List<LocalRef> → Expr = λ places ys => RtQ::seq(word_list, runtime_spanned(lent, places, runtime_locals(ys)));
    let key: List<LocalRef> → Expr = λ ys => RtQ::seq(buffers, runtime_places(lent, runtime_locals(ys)).drop(1));
    let own_types: List<Handle> = runtime_spanned(lent, Cons(bytes_h, each.map(λ _ => bytes_h)), ws.map(λ _ => ts.word));
    // The measure, as a function of the spans read, the written span and
    // the words.
    let reads_z <- assume(Hd(buffers_h), "reads", None).or_fail("runtime: the spans a loop reads: ");
    let own_z <- assume(Hd(bytes_h), "own", Some(reads_z.ref)).or_fail("runtime: a span: ");
    let zs <- runtime_params(ts.word, ws, Some(own_z.ref), 0);
    let mu_z <- runtime_measure_at(rec, at_f(Local(own_z.ref), reads_at(Local(reads_z.ref)), zs));
    // Held, as the statement below names it beside locals of its own, where
    // its `Lam`s would not reify.
    let m_e <- runtime_held(Lam(reads_z.ref, ap(on_words, [ws_e, Lam(own_z.ref, runtime_lams(zs, Hd(mu_z)))])), "a loop's measure");
    // Below `2^64`: the measure is a word's `toNat`.
    let rest_b <- assume(Hd(buffers_h), "rest", None).or_fail("runtime: the rest of a file: ");
    let own_b <- assume(Hd(bytes_h), "own", Some(rest_b.ref)).or_fail("runtime: a span: ");
    let bs <- runtime_params(ts.word, ws, Some(own_b.ref), 0);
    let mu_b <- runtime_measure_at(rec, at_f(Local(own_b.ref), reads_at(Local(rest_b.ref)), bs));
    let word_b <- runtime_measured_word(mu_b);
    let bounded = Lam(rest_b.ref, Lam(own_b.ref, runtime_lams(bs, ap(lt_pow, [Hd(word_b)]))));
    // The family: its binders opened off its statement (the rest of the
    // file, the words, the span, the recursion `again` keyed by the spans
    // read, and what `again` agrees with below the measure).
    let stated = ap(family, [Blank, Global(f), ws_e, res_e, body_e, NatLit(lent), e.world, e.reads, e.fsigs, e.writes, e.typed, m_e]);
    let g_t <- as_type(stated).or_fail("runtime: a measured function's `Guarded`: ");
    let words: List<String> = List::range(ws.len()).map(λ i => "x".append(decimal_name(2, i)));
    let opened <- runtime_open_n(64, g_t, Cons("rest", words.append(["own", "again", "hyp"])));
    let rest = opened.fst.head_or(LocalRef(0));
    let xs = opened.fst.drop(1).take(ws.len());
    let places: List<Expr> = runtime_places(lent, runtime_locals(xs));
    let here: List<Expr> = reads_at(Local(rest));
    let own = opened.fst.nth(Succ(ws.len())).unwrap_or(LocalRef(0));
    let again = opened.fst.nth(Succ(Succ(ws.len()))).unwrap_or(LocalRef(0));
    let hyp = opened.fst.nth(Succ(Succ(Succ(ws.len())))).unwrap_or(LocalRef(0));
    let mu_x <- runtime_measure_at(rec, at_f(Local(own), here, xs));
    let n_e = Hd(mu_x);
    // `g1 = λ s y… p => f::rec(N, s, y…, p)`.
    let ys1 <- runtime_params_at(own_types, Some(hyp), 0);
    let d1 <- runtime_bound_dom(rec, n_e, runtime_locals(ys1));
    let p1 <- assume(Hd(d1), "p", Some(ys1.rev().head_or(hyp))).or_fail("runtime: a bound proof: ");
    let g1 = runtime_lams(ys1.append([p1.ref]), ap(rec, Cons(n_e, runtime_locals(ys1).append([Local(p1.ref)]))));
    // `g2 = λ s y… _ => again([reads…], [place, y…], s)`, read at the
    // result's code.
    let ys2 <- runtime_params_at(own_types, Some(hyp), 0);
    let d2 <- runtime_bound_dom(rec, n_e, runtime_locals(ys2));
    let p2 <- assume(Hd(d2), "q", Some(ys2.rev().head_or(hyp))).or_fail("runtime: a bound proof: ");
    let g2 = runtime_lams(ys2.append([p2.ref]), ap(recast, [e.tys, w64, res_e, ap(Local(again), [key(ys2), list(places, ys2), Local(lead(ys2))])]));
    // They agree: `f::irrel` on the left, the hypothesis on the right.
    let ys3 <- runtime_params_at(own_types, Some(hyp), 0);
    let d3 <- runtime_bound_dom(rec, n_e, runtime_locals(ys3));
    let mu_y <- runtime_measure_of(d3);
    let p3 <- assume(Hd(d3), "p", Some(ys3.rev().head_or(hyp))).or_fail("runtime: a bound proof: ");
    let q3 <- assume(Hd(d3), "q", Some(p3.ref)).or_fail("runtime: a bound proof: ");
    let irr = ap(irrel, Cons(n_e, Cons(Blank, runtime_locals(ys3).append([Local(p3.ref), ap(lt_succ, [Hd(mu_y)])]))));
    let hy = ap(cong_g, [Blank, Blank, ap(recast, [e.tys, w64, res_e]), Blank, Blank,
        ap(Local(hyp), [key(ys3), list(places, ys3), Local(lead(ys3)), ap(rfl, [Blank, NatLit(ws.len())]), Local(p3.ref)])]);
    let hg = runtime_lams(ys3.append([p3.ref, q3.ref]), ap(trans_g, [Blank, Blank, Blank, Blank, irr, ap(sym_g, [Blank, Blank, Blank, hy])]));
    let lt_n = ap(lt_succ, [n_e]);
    let proved = runtime_lams(Cons(rest, xs.append([own, again, hyp])), ap(cong_g, [Blank, Blank, ap(recast, [e.tys, res_e, w64]), Blank, Blank,
        ap(sym_g, [Blank, Blank, Blank, ap(ext, Cons(n_e, Cons(n_e, Cons(g1, Cons(g2, Cons(hg, at_f(Local(own), here, xs).append([lt_n, lt_n])))))))])]));
    // `Guarded` at each rest of the file, through the spans read there.
    let guarded = ap(from_family, [Blank, Global(f), ws_e, res_e, body_e, NatLit(lent), e.world, e.reads, e.fsigs, e.writes, e.typed, m_e, proved]);
    pure(ap(compile, [Blank, Ty::quotes(ks, q), Ty::quote(moved.head_or(Bit), q), Ty::quotes(moved.drop(1), q), res_e, body_e, NatLit(lent),
        e.world, e.reads, e.fsigs, e.writes, Global(f), e.typed, ap(measure_at, [NatLit(lent), m_e]), bounded, guarded, verdict]))
}

// The program's parts, held once each (`runtime_held`): the functions (the
// last first), their sources at every rest of the file and every span,
// their arities, and which of them leave the file.
record SpanLinked { program: Expr, srcs: Expr, arities: Expr, stills: Expr }

fn runtime_span_linked(q: RtQ, ts: RtTypes, l: Linking, insts: List<Pair<Expr, Expr>>) → Tac<SpanLinked> {
    let fn_ctors <- runtime_ctors_at(ts.functions);
    let bool_list <- runtime_type_of(name_of(runtime_w_bools)).bind(λ h => runtime_ctors_at(h));
    let bools <- runtime_type_of(name_of(runtime_w_true)).bind(λ h => runtime_ctors_at(h));
    let linked <- runtime_global(name_of(Compile::linked));
    let arity_of <- runtime_global(name_of(Compile::arity));
    let source <- runtime_span_ref("runtime_file::Compile::span_source");
    let s_linked <- runtime_span_ref("runtime_file::CompileSpan::linked");
    let s_arity <- runtime_span_ref("runtime_file::CompileSpan::arity");
    let s_source <- runtime_span_ref("runtime_file::CompileSpan::source");
    let all_nil <- runtime_span_ref("runtime_file::span_all_nil");
    let all_cons <- runtime_span_ref("runtime_file::span_all_cons");
    let n = insts.len();
    let at = λ (i: Nat) => insts.nth(i).unwrap_or(Pair(Blank, Blank));
    let writes: Nat → Bool = λ i => match l.reads.nth(i).unwrap_or(None) { Some(_) => True, None => False };
    let pick: Nat → Expr → Expr → Expr = λ i a b => match writes(i) { True => b, False => a };
    let links = λ (i: Nat) => q.nat_list(runtime_links(l.order, l.tables.nth(i).unwrap_or([])));
    let indices = List::range(n).rev();
    let srcs <- runtime_held(List::range(n).foldr(λ i acc => ap(all_cons, [ap(pick(i, source, s_source), [Blank, (at(i)).fst, (at(i)).snd]), acc]), all_nil),
        "the program's sources");
    let program <- runtime_held(RtQ::seq(fn_ctors, indices.map(λ i => ap(pick(i, linked, s_linked), [Blank, (at(i)).fst, (at(i)).snd, links(i)]))),
        "the program");
    let arities <- runtime_held(RtQ::seq(q.nats, indices.map(λ i => ap(pick(i, arity_of, s_arity), [Blank, (at(i)).fst, (at(i)).snd]))),
        "the program's arities");
    let stills <- runtime_held(RtQ::seq(bool_list, indices.map(λ i => pick(i, runtime_at(bools, 1), runtime_at(bools, 0)))),
        "which functions leave the file");
    pure(SpanLinked(program, srcs, arities, stills))
}

// The link, a function at a time, over every span and every rest of a
// file: each function's instance and its two lists (`Compile::spanned` for
// one that only reads, `CompileSpan::spanned` for one that writes), the
// last function's first, as `program_spanned` reads them.
fn runtime_span_parts(q: RtQ, l: Linking, insts: List<Pair<Expr, Expr>>, sl: SpanLinked) → Tac<Expr> {
    let c_spanned <- runtime_span_ref("runtime_file::Compile::spanned");
    let s_spanned <- runtime_span_ref("runtime_file::CompileSpan::spanned");
    let c_table <- runtime_span_ref("runtime_file::Compile::span_table");
    let reads_table <- runtime_span_ref("runtime_file::CompileSpan::reads_table");
    let writes_table <- runtime_span_ref("runtime_file::CompileSpan::writes_table");
    let every <- runtime_span_ref("runtime_file::span_every");
    let still_at <- runtime_span_ref("runtime_file::link_still");
    let arity_at <- runtime_global(name_of(link_arity));
    let both <- runtime_global(name_of(link_both));
    let rfl <- runtime_global("tactic::rfl");
    let trivial_h <- resolve("trivial").or_fail("runtime: `trivial`: ");
    let n = insts.len();
    let part: Nat → Expr = λ i => {
        let p = insts.nth(i).unwrap_or(Pair(Blank, Blank));
        let links = runtime_links(l.order, l.tables.nth(i).unwrap_or([]));
        let arity = ap(arity_at, [sl.program, sl.arities, NatLit(n - i)]);
        let still = ap(still_at, [sl.program, sl.stills, NatLit(n - i)]);
        match l.reads.nth(i).unwrap_or(None) {
            None => ap(c_spanned, [Blank, p.fst, p.snd, Hd(trivial_h), sl.srcs, q.nat_list(links), arity, still,
                ap(every, [Blank, ap(c_table, [Blank, p.fst, p.snd])]), Hd(trivial_h)]),
            Some(k) => ap(s_spanned, [Blank, p.fst, p.snd, sl.srcs, q.nat_list(links.take(k)), q.nat_list(links.drop(k)), arity, still,
                ap(rfl, [Blank, NatLit(k)]), ap(every, [Blank, ap(reads_table, [Blank, p.fst, p.snd])]), Hd(trivial_h),
                ap(every, [Blank, ap(writes_table, [Blank, p.fst, p.snd])]), Hd(trivial_h)]),
        }
    };
    pure(List::range(n).rev().map(part).foldr(λ p acc => ap(both, [Blank, Blank, p, acc]), Hd(trivial_h)))
}

// ---------------------------------------------------------------------------
// A reflection written out
//
// The function over a span that a reflection is of, as a term: each value
// bound once (`HWorld::once`), each read its reader at the span as it then
// stands, each store its writer there with what follows at the span it
// leaves and the word it answers (`HWorld::after`), each branch
// `HWorld::either`. A function of a laid record is compiled from this
// term, which nobody wrote.
//
// It is written as a function of its callees, and what is proved of it
// by conversion (that the reflection's meaning is it, at every file) is
// proved at every callee and then read at the program's own
// (`HWorld::at`). At the program's own, the kernel meets a reader's call
// on one side before the other has computed down to it, unfolds it, and
// compares the two bodies: a reader built from two calls of another
// costs a quarter of a comparison's budget each time it is read. A
// parameter has no body. (Nor is the function stated as the reflection's
// meaning at no other span: a meaning compared with a meaning at another
// file is compared environment by environment, twice per value bound.)

fn runtime_held_ref(name: String) → Tac<Expr> {
    lookup(name).or_fail("runtime: `" ++ name ++ "` is not in scope (a runtime fn of a laid record needs `import rt_held; import rt_held_fields; import stored_accessor;` and the modules they import): ")
        .bind(λ g => pure(Global(g)))
}

fn runtime_held_refused<A>(name: String, why: String) → Tac<A> {
    fail("`" ++ name ++ "` cannot be a runtime fn of a laid record: " ++ why, [])
}

// What the writing reads: the callees by their numbers (each a term: the
// function itself, or a parameter standing for it), each reader with how
// many spans it is lent, and the names it applies.
record SpanWriting { name: String, q: RtQ, tys: Expr, world: World, reads: List<Expr>, read_lents: List<Nat>, writes: List<Expr>, write_sigs: List<Pair<Nat, Sig>>,
    word: Handle, bytes: Handle, ty_sem: Expr, lit: Expr, op_sem: Expr, once: Expr, answer: Expr, after: Expr, either: Expr, again: Option<Expr>,
    byte_within: Option<Expr> }

// A code's type: a 64-bit word's by its name, any other as the code's
// meaning.
fn SpanWriting::sem(self cx: SpanWriting, t: Ty) → Expr {
    match t.is_word64() { True => Hd(cx.word), False => ap(cx.ty_sem, [Ty::quote(t, cx.q), cx.tys]) }
}

// A variable's term. The outermost variable is the span's place, which a
// function over the span's bytes does not read.
fn SpanWriting::var(self cx: SpanWriting, env: List<Expr>, i: Nat) → Tac<Expr> {
    match Succ(i).same(env.len()) {
        True => runtime_held_refused(cx.name, "it reads where its span lies as a value"),
        False => match env.nth(i) {
            Some(e) => pure(e),
            None => runtime_fail("`" ++ cx.name ++ "`'s reflection reads a variable it does not bind"),
        },
    }
}

fn SpanWriting::vars(self cx: SpanWriting, env: List<Expr>, is: List<Nat>) → Tac<List<Expr>> {
    match is {
        Nil => pure([]),
        Cons(i, rest) => cx.var(env, i).bind(λ e => cx.vars(env, rest).bind(λ es => pure(Cons(e, es)))),
    }
}

// The operands of a callee lent the span: the first is the span's place,
// where the callee is at the span itself.
fn SpanWriting::lent(self cx: SpanWriting, span: Expr, env: List<Expr>, args: List<Nat>) → Tac<List<Expr>> {
    match args {
        Nil => runtime_fail("`" ++ cx.name ++ "`'s reflection lends a span to a callee it passes nothing"),
        Cons(place, rest) => match Succ(place).same(env.len()) {
            True => cx.vars(env, rest).bind(λ es => pure(Cons(span, es))),
            False => runtime_held_refused(cx.name, "it lends a callee a span that is not its own"),
        },
    }
}

// A value under the local `under`: a literal at its code, an operator's
// own function on its operands, a reader on its, a value bound once and a
// branch between two. `env` has each variable's term, the most recent
// first, and `g` their codes.
fn SpanWriting::value(self cx: SpanWriting, span: Expr, env: List<Expr>, g: List<Ty>, under: LocalRef, t: Tm) → Tac<Expr> {
    match t {
        Var(i) => cx.var(env, i),
        Lit(c, n) => pure(ap(cx.lit, [Ty::quote(c, cx.q), NatLit(n), cx.tys])),
        Prim(op, args) => cx.vars(env, args).bind(λ es => pure(ap(ap(cx.op_sem, [Op::quote(op, cx.q), cx.tys]), es))),
        Call(f, args) => match cx.reads.nth(f) {
            None => runtime_fail("`" ++ cx.name ++ "`'s reflection calls a reader it does not list"),
            Some(r) => match cx.read_lents.nth(f).unwrap_or(0) {
                Zero => cx.vars(env, args).bind(λ es => pure(ap(r, es))),
                Succ(more) => match more {
                    Zero => cx.lent(span, env, args).bind(λ es => pure(ap(r, es))),
                    Succ(_) => runtime_held_refused(cx.name, "it calls a function lent more than one span"),
                },
            },
        },
        Let(e, body) => {
            let value <- cx.value(span, env, g, under, e);
            let ty = e.ty(cx.world, g);
            let x <- assume(cx.sem(ty), "x", Some(under)).or_fail("runtime: a value bound: ");
            let rest <- cx.value(span, Cons(Local(x.ref), env), Cons(ty, g), x.ref, body);
            pure(ap(cx.once, [Blank, Blank, value, Lam(x.ref, rest)]))
        },
        If(c, yes, no) => {
            let c_e <- cx.var(env, c);
            let yes_e <- cx.value(span, env, g, under, yes);
            let no_e <- cx.value(span, env, g, under, no);
            pure(ap(cx.either, [Blank, c_e, yes_e, no_e]))
        },
        // A byte of a span that is only read, under the span's own length
        // word: the span is the variable its place is, the outermost but
        // `2j`.
        Byte(j, i, length) => match j {
            Zero => runtime_held_refused(cx.name, "it reads a byte of the span that holds its record"),
            Succ(_) => match env.nth(env.len() - Succ(j + j)) {
                None => runtime_fail("`" ++ cx.name ++ "`'s reflection reads a span it is not lent"),
                Some(s) => match cx.byte_within {
                    None => runtime_held_refused(cx.name, "`List::byte_within` is not in scope (import `rt`)"),
                    Some(within) => cx.vars(env, [length, i]).bind(λ es => pure(ap(within, Cons(s, es)))),
                },
            },
        },
        _ => runtime_held_refused(cx.name, "a value of its reflection is of a form that is not written out yet (a branch on an equation, a record, a fold)"),
    }
}

// A computation at a span, likewise.
fn SpanWriting::written(self cx: SpanWriting, span: Expr, env: List<Expr>, g: List<Ty>, under: LocalRef, t: FTm) → Tac<Expr> {
    match t {
        Pure(v) => cx.value(span, env, g, under, v).bind(λ e => pure(ap(cx.answer, [Blank, span, e]))),
        Let(e, body) => {
            let value <- cx.value(span, env, g, under, e);
            let ty = e.ty(cx.world, g);
            let x <- assume(cx.sem(ty), "x", Some(under)).or_fail("runtime: a value bound: ");
            let rest <- cx.written(span, Cons(Local(x.ref), env), Cons(ty, g), x.ref, body);
            pure(ap(cx.once, [Blank, Blank, value, Lam(x.ref, rest)]))
        },
        If(c, yes, no) => {
            let c_e <- cx.var(env, c);
            let yes_e <- cx.written(span, env, g, under, yes);
            let no_e <- cx.written(span, env, g, under, no);
            pure(ap(cx.either, [Blank, c_e, yes_e, no_e]))
        },
        // A branch that names its condition's equation: the equation is
        // erased, and the meaning is the convoyed `match`.
        IfEq(c, yes, no) => {
            let convoy <- runtime_global(name_of(Tm::convoy));
            let c_e <- cx.var(env, c);
            let yes_e <- cx.written(span, env, g, under, yes);
            let no_e <- cx.written(span, env, g, under, no);
            pure(ap(convoy, [Blank, c_e, yes_e, no_e]))
        },
        Call(f, args, body) => match cx.writes.nth(f) {
            None => runtime_fail("`" ++ cx.name ++ "`'s reflection calls a writer it does not list"),
            Some(w) => {
                let sig = cx.write_sigs.nth(f).unwrap_or(Pair(1, Sig([], Bit)));
                // A callee lent spans it only reads is passed each as the
                // function took it: the variable in a place is the span.
                let es <- cx.lent(span, env, args);
                let left <- assume(Hd(cx.bytes), "span", Some(under)).or_fail("runtime: a span: ");
                let x <- assume(cx.sem(sig.snd.result), "x", Some(left.ref)).or_fail("runtime: a word answered: ");
                let rest <- cx.written(Local(left.ref), Cons(Local(x.ref), env), Cons(sig.snd.result, g), x.ref, body);
                pure(ap(cx.after, [Blank, Blank, Blank, ap(w, es), Lam(left.ref, Lam(x.ref, rest))]))
            },
        },
        // A loop's next pass: what the passes after this one are, at the
        // span as it stands and the call's words.
        Again(args) => match cx.again {
            None => runtime_fail("`" ++ cx.name ++ "`'s reflection calls itself and is not written out as a loop"),
            Some(later) => cx.lent(span, env, args).bind(λ es => pure(ap(later, es))),
        },
        _ => runtime_held_refused(cx.name, "its reflection has a form that is not written out yet (a byte stored by itself, a callee lent a part of the span)"),
    }
}

// A callee as what a function of a laid record is proved over: its type,
// and the function itself.
record SpanCallee { ty: Handle, global: Expr }

fn runtime_callees_of(gs: List<Nat>) → Tac<List<SpanCallee>> {
    match gs {
        Nil => pure([]),
        Cons(g, rest) => infer(Global(GlobalRef(g))).or_fail("runtime: a callee's type: ").bind(λ t =>
            runtime_callees_of(rest).bind(λ more => pure(Cons(SpanCallee(t, Global(GlobalRef(g))), more)))),
    }
}

// Each callee as a local, under the one before.
fn runtime_callee_locals(cs: List<SpanCallee>, under: Option<LocalRef>, i: Nat) → Tac<List<LocalRef>> {
    match cs {
        Nil => pure([]),
        Cons(c, rest) => assume(Hd(c.ty), "callee" ++ decimal_name(2, i), under).or_fail("runtime: a callee as a parameter: ").bind(λ x =>
            runtime_callee_locals(rest, Some(x.ref), Succ(i)).bind(λ more => pure(Cons(x.ref, more)))),
    }
}

// A function of the callees, held as a hole it solves: one term wherever
// it is applied.
fn runtime_over_callees(cs: List<SpanCallee>, what: String, body: List<Expr> → Option<LocalRef> → Tac<Expr>) → Tac<Expr> {
    let xs <- runtime_callee_locals(cs, None, 0);
    let b <- body(runtime_locals(xs), xs.rev().head());
    runtime_held(runtime_lams(xs, b), what)
}

// What holds at every callee, read at the program's own (`HWorld::at`, a
// callee at a time): `stmt` is the statement at a list of callees, under
// a local, and `leaf` its proof where each is a parameter. `done` are the
// parameters so far.
fn runtime_at_each(at: Expr, cs: List<SpanCallee>, done: List<Expr>, under: Option<LocalRef>, stmt: List<Expr> → LocalRef → Tac<Expr>, leaf: List<Expr> → Expr) → Tac<Expr> {
    match cs {
        Nil => pure(leaf(done)),
        Cons(c, rest) => {
            let x <- assume(Hd(c.ty), "callee", under).or_fail("runtime: a callee as a parameter: ");
            let here = done ++ [Local(x.ref)];
            let b <- stmt(here ++ rest.map(λ r => r.global), x.ref);
            let inner <- runtime_at_each(at, rest, here, Some(x.ref), stmt, leaf);
            pure(ap(at, [Hd(c.ty), Lam(x.ref, b), c.global, Lam(x.ref, inner)]))
        },
    }
}

fn runtime_held_vars(var_t: Expr, n: Nat, under: LocalRef) → Tac<List<LocalRef>> {
    match n {
        Zero => pure([]),
        Succ(m) => assume(var_t, "x", Some(under)).or_fail("runtime: an operand's variable: ").bind(λ x =>
            runtime_held_vars(var_t, m, x.ref).bind(λ more => pure(Cons(x.ref, more)))),
    }
}

// What holds at every callee, as `runtime_at_each`, with a leaf that
// binds locals of its own.
fn runtime_at_each_under(at: Expr, cs: List<SpanCallee>, done: List<Expr>, under: Option<LocalRef>, stmt: List<Expr> → LocalRef → Tac<Expr>,
    leaf: List<Expr> → Option<LocalRef> → Tac<Expr>) → Tac<Expr> {
    match cs {
        Nil => leaf(done, under),
        Cons(c, rest) => {
            let x <- assume(Hd(c.ty), "callee", under).or_fail("runtime: a callee as a parameter: ");
            let here = done ++ [Local(x.ref)];
            let b <- stmt(here ++ rest.map(λ r => r.global), x.ref);
            let inner <- runtime_at_each_under(at, rest, here, Some(x.ref), stmt, leaf);
            pure(ap(at, [Hd(c.ty), Lam(x.ref, b), c.global, Lam(x.ref, inner)]))
        },
    }
}

// A loop written out (`FFun::rounds`): the function's type over its span,
// the table of types, how to read such a function as a meaning at the
// rest of a file, the pass and what answers with the count spent, each at
// the program's own callees, and that the pass is the body at every rest
// of a file.
record SpanCounted { ty: Expr, tys: Expr, at: Expr, pass: Expr, stop: Expr, passes: Expr }

// What a publication hands on to what is published beside it: the
// reflection, its parameters' codes and its body, the empty list of
// codes, the world at a rest of a file and the function compiled, and,
// for a function written out, its callees, with that world and that
// function at any list of them.
record SpanParts { rt: Expr, params: Expr, body: Expr, no_tys: Expr, world: Expr → Expr, compiled: Expr, callees: List<SpanCallee>, world_of: List<Expr> → Expr → Expr,
    compiled_of: List<Expr> → Expr, counted: Option<SpanCounted> }

// What a function written out is published from: its callees' tables, its
// world and itself, each a function of the callees, its type, and the
// proof that the reflection's meaning is it.
record SpanWritten { reads: Expr, world: Expr, writes: Expr, compiled: List<Expr> → Expr, ty: Handle, pinned: Expr, callees: List<SpanCallee>,
    pass: List<Expr> → Expr, stop: Expr }

// `reads` and `writes` are the runtime fns the function calls, the ones
// that only read (each with how many spans it is lent) and the ones that
// write, as its reflection numbers them.
fn runtime_span_publish(name: String, f: GlobalRef, rfun: FFun, measured: Bool, reads: List<Nat>, read_sigs: List<Pair<Nat, Sig>>, writes: List<Nat>,
    write_sigs: List<Pair<Nat, Sig>>, l: Linking, meant: Bool, more: SpanParts → Tac<List<Decl>>) → Tac<List<Decl>> {
    let ts <- runtime_type_handles();
    let q <- runtime_quoting(ts);
    let ftms <- runtime_file_quoting();
    let ffun_h <- runtime_type_of(name_of(runtime_w_ffun));
    let ffuns <- runtime_ctors_at(ffun_h);
    let bools_h <- runtime_type_of(name_of(runtime_w_bools));
    let bytes_h <- runtime_type_of(name_of(runtime_w_bytes));
    let buffers_h <- runtime_type_of(name_of(runtime_w_buffers));
    let buffers <- runtime_ctors_at(buffers_h);
    let word_list <- runtime_ctors_at(ts.words);
    let rfl <- runtime_global("tactic::rfl");
    let trivial_h <- resolve("trivial").or_fail("runtime: `trivial`: ");
    let verdict <- runtime_verdict();
    let yes <- runtime_global(name_of(runtime_w_true));
    let lowers <- runtime_global(name_of(Setup::lowers));
    let world_of <- runtime_global(name_of(World::of));
    let tys_e <- runtime_global(name_of(RecInfo::none));
    let lent_callees <- runtime_global(name_of(Setup::lent_callees));
    let callees_nil <- runtime_global(name_of(Setup::callees_nil));
    let typed_once <- runtime_global(name_of(Setup::typed_once));
    let no_file <- runtime_global(name_of(runtime_w_buffers));
    let span_at <- runtime_global(name_of(Setup::span_at));
    let sems_cons <- runtime_span_ref("runtime_file::FTm::sems_cons");
    let sems_nil <- runtime_span_ref("runtime_file::FTm::sems_nil");
    let fworld <- runtime_span_ref("runtime_file::FWorld::of");
    let meaning <- runtime_span_ref(name_of(FFun::meaning));
    let end_of <- runtime_span_ref("rt_file_loop::FTm::end_of");
    let program_run <- runtime_span_ref("function_ir_run::program_run");
    let answers <- runtime_span_ref("function_ir_link::program_spanned_answers");
    let span_file <- runtime_span_ref("runtime_file::span_file");
    let span_sources <- runtime_span_ref("runtime_file::span_sources");
    let span_pair <- runtime_span_ref("runtime_file::span_pair");
    let ty_sem <- runtime_global(name_of(Ty::sem));
    let lit <- runtime_global(name_of(Tm::lit));
    let op_sem <- runtime_global(name_of(Op::sem));
    // What a function written out is spelled with, looked up only where
    // one is (`rt_held` is then in scope).
    let held_name: String → Tac<Expr> = λ n => match meant { True => runtime_held_ref(n), False => pure(Blank) };
    let byte_within <- lookup(name_of(List::byte_within)).bind(λ c => pure(match c { Accepted(g) => Some(Global(g)), Refused(_) => None }));
    let once <- held_name("rt_held::HWorld::once");
    let answer <- held_name("rt_held::HWorld::answer");
    let after <- held_name("rt_held::HWorld::after");
    let either <- held_name("rt_held::HWorld::either");
    let params_e = Ty::quotes(rfun.params, q);
    let res_e = Ty::quote(rfun.result, q);
    let body_e = FTm::quote(rfun.body, q, ftms);
    let lent = rfun.lent;
    // Where more is published beside the span's (a function of a laid
    // record), the reflection and its world are each one term wherever
    // they stand: each is named again by the marks, what the marks owe
    // and the record's theorem.
    let shared: Expr → Tac<Expr> = λ x => match meant { True => runtime_held(x, "`" ++ name ++ "`'s reflection"), False => pure(x) };
    let rt_e <- shared(ap(runtime_at(ffuns, 0), [params_e, res_e, body_e, NatLit(lent)]));
    let sigs: List<Sig> = read_sigs.map(λ p => p.snd);
    let sigs_e = RtQ::seq(q.sigs, sigs.map(λ s => Sig::quote(s, q)));
    let fsigs_e <- shared(RtQ::seq(q.sigs, write_sigs.map(λ s => Sig::quote(s.snd, q))));
    let own_words = rfun.params.drop(1);
    let every <- runtime_span_ref("runtime_file::FFun::source_every");
    // A function written out, each part a function of the callees (the
    // readers, then the writers).
    let written_out: Tac<Option<SpanWritten>> = match meant {
        False => pure(None),
        True => {
            let cs <- runtime_callees_of(reads ++ writes);
            let n = reads.len();
            let at <- runtime_held_ref("rt_held::HWorld::at");
            let cx: Option<Expr> → List<Expr> → SpanWriting = λ again es => SpanWriting(name, q, tys_e, World(RecInfo::none, sigs, Sig::sems_default(RecInfo::none, sigs)), es.take(n),
                read_sigs.map(λ p => p.fst), es.drop(n), write_sigs, ts.word, bytes_h, ty_sem, lit, op_sem, once, answer, after, either, again, byte_within);
            let reads_of: List<Expr> → Expr = λ es => runtime_file_callees_of(lent_callees, typed_once, callees_nil, tys_e, q, es.take(n), sigs, read_sigs.map(λ p => p.fst));
            let reads_t <- runtime_over_callees(cs, "`" ++ name ++ "`'s reading callees", λ es _ => pure(reads_of(es)));
            let world_t <- runtime_over_callees(cs, "`" ++ name ++ "`'s world", λ es _ => pure(ap(world_of, [tys_e, sigs_e, ap(reads_of(es), [no_file])])));
            let writes_t <- runtime_over_callees(cs, "`" ++ name ++ "`'s writing callees", λ es _ =>
                pure(runtime_span_writers_of(sems_cons, sems_nil, typed_once, tys_e, q, es.drop(n), write_sigs)));
            let zero <- runtime_global(name_of(runtime_w_word));
            let mutated <- runtime_global("Mutated");
            let span_c <- assume(Hd(bytes_h), "span", None).or_fail("runtime: a span: ");
            let xs_c <- runtime_own_params(ts.word, bytes_h, lent, own_words.len(), Some(span_c.ref), 0);
            let t <- as_type(Pi(span_c.ref, xs_c.foldr(λ x acc => Pi(x, acc), ap(mutated, [Hd(bytes_h), Hd(ts.word)])))).or_fail("runtime: `" ++ name ++ "`'s type over its span: ");
            let named <- runtime_held_ref("rt_held::HWorld::written");
            // A loop is written a pass at a time: the body as a function
            // of the passes after it (`FFun::rounds`).
            let fe_h <- runtime_over_callees(cs, "`" ++ name ++ "` written out over its span", λ es under => {
                let later: Tac<Option<LocalRef>> = match measured {
                    False => pure(None),
                    True => assume(Hd(t), "later", under).or_fail("runtime: a loop's later passes: ").bind(λ x => pure(Some(x.ref))),
                };
                let lt <- later;
                let span_b <- assume(Hd(bytes_h), "span", match lt { None => under, Some(x) => Some(x) }).or_fail("runtime: a span: ");
                let xs_b <- runtime_own_params(ts.word, bytes_h, lent, own_words.len(), Some(span_b.ref), 0);
                let body <- SpanWriting::written(cx(lt.map(λ x => Local(x)), es), Local(span_b.ref), runtime_locals(xs_b).rev().append([zero]), Ty::bind_onto(rfun.params, []), xs_b.rev().head_or(span_b.ref), rfun.body);
                let one = Lam(span_b.ref, runtime_lams(xs_b, body));
                pure(match lt { None => one, Some(x) => Lam(x, one) })
            });
            // With the count spent the code answers the first word it
            // would have moved (`FFun::spent`).
            let stopped: Tac<Expr> = match measured {
                False => pure(Blank),
                True => {
                    let span_s <- assume(Hd(bytes_h), "span", None).or_fail("runtime: a span: ");
                    let xs_s <- runtime_own_params(ts.word, bytes_h, lent, own_words.len(), Some(span_s.ref), 0);
                    runtime_held(Lam(span_s.ref, runtime_lams(xs_s, ap(answer, [Blank, Local(span_s.ref), runtime_locals(xs_s).nth(lent + lent - 1).unwrap_or(zero)]))),
                        "what `" ++ name ++ "` answers with its passes spent")
                },
            };
            let stop_e <- stopped;
            let rounds <- match measured { True => runtime_span_ref("rt_file_loop::FFun::rounds"), False => pure(Blank) };
            let passes_n <- match measured { True => runtime_global(name_of(Fun::meas_passes)), False => pure(Blank) };
            // Under a name, at its type: where the function meets itself
            // through other definitions, the kernel meets at the name. A
            // loop's name is `FFun::rounds`, as its instance spells it.
            let fe_of: List<Expr> → Expr = λ es => match measured {
                False => ap(named, [Hd(t), ap(fe_h, es)]),
                True => ap(rounds, [Hd(t), passes_n, ap(fe_h, es), stop_e]),
            };
            let source_at <- runtime_span_ref("runtime_file::FTm::source_at");
            // The pin, at every callee: the reflection's meaning in the
            // world of those callees is the function written out at them.
            let stmt: List<Expr> → LocalRef → Tac<Expr> = λ es under => {
                let rest <- assume(Hd(buffers_h), "rest", Some(under)).or_fail("runtime: the rest of a file: ");
                let own <- assume(Hd(bytes_h), "own", Some(rest.ref)).or_fail("runtime: a span: ");
                as_type(Pi(rest.ref, Pi(own.ref, Equation(
                    ap(source_at, [Hd(t), tys_e, NatLit(lent), params_e, res_e, ap(typed_once, [Hd(t), fe_of(es)]), fe_of(es), Local(rest.ref), Local(own.ref)]),
                    ap(meaning, [rt_e, ap(fworld, [ap(world_t, es), ap(reads_t, es), fsigs_e, ap(writes_t, es), Local(rest.ref)]), Local(own.ref)])))))
                    .or_fail("runtime: `" ++ name ++ "`'s pin at its callees: ").bind(λ h => pure(Hd(h)))
            };
            // A loop has no pin: that its pass is the body, at every
            // callee and every rest of a file (`FFun::Passes`), each side
            // computed with the later passes a parameter.
            let pinned: Tac<Expr> = match measured {
                False => runtime_at_each(at, cs, [], None, stmt, λ es =>
                    ap(every, [Hd(t), fe_of(es), tys_e, NatLit(lent), params_e, res_e, ap(typed_once, [Hd(t), fe_of(es)])])),
                True => {
                    let passes_t <- runtime_span_ref("rt_file_loop::FFun::Passes");
                    let uncurry <- runtime_span_ref("rt_file_loop::FFun::uncurry");
                    let read_at: List<Expr> → Expr → Expr → Expr = λ es g rest =>
                        ap(source_at, [Hd(t), tys_e, NatLit(lent), params_e, res_e, ap(typed_once, [Hd(t), fe_of(es)]), g, rest]);
                    let stated: List<Expr> → Option<LocalRef> → Tac<Pair<LocalRef, Expr>> = λ es under => {
                        let rest <- assume(Hd(buffers_h), "rest", under).or_fail("runtime: the rest of a file: ");
                        let g <- assume(Hd(t), "g", Some(rest.ref)).or_fail("runtime: a function over a span: ");
                        pure(Pair(rest.ref, ap(passes_t, [Hd(t), params_e, res_e, body_e,
                            ap(fworld, [ap(world_t, es), ap(reads_t, es), fsigs_e, ap(writes_t, es), Local(rest.ref)]),
                            Lam(g.ref, read_at(es, Local(g.ref), Local(rest.ref))), ap(fe_h, es)])))
                    };
                    runtime_at_each_under(at, cs, [], None,
                        λ es under => stated(es, Some(under)).bind(λ p =>
                            as_type(Pi(p.fst, p.snd)).or_fail("runtime: `" ++ name ++ "`'s pass at its callees: ").bind(λ h => pure(Hd(h)))),
                        λ es under => {
                            let p <- stated(es, under);
                            let p_t <- as_type(p.snd).or_fail("runtime: `" ++ name ++ "`'s pass at its callees: ");
                            let opened <- runtime_open_n(64, p_t, Cons("later", List::range(rfun.params.len()).map(λ i => "x".append(decimal_name(2, i))).append(["own", "again"])));
                            let later = opened.fst.head_or(p.fst);
                            let xs = opened.fst.drop(1).take(rfun.params.len());
                            let own = opened.fst.nth(Succ(rfun.params.len())).unwrap_or(p.fst);
                            pure(Lam(p.fst, runtime_lams(opened.fst, ap(rfl, [Blank, ap(uncurry, [tys_e, params_e, res_e,
                                read_at(es, ap(ap(fe_h, es), [Local(later)]), Local(p.fst)), RtQ::seq(word_list, runtime_locals(xs)), Local(own)])]))))
                        })
                },
            };
            let pinned_e <- pinned;
            pure(Some(SpanWritten(reads_t, world_t, writes_t, fe_of, t, pinned_e, cs, λ es => ap(fe_h, es), stop_e)))
        },
    };
    let out <- written_out;
    let own_callees: List<Expr> = match out { None => [], Some(o) => o.callees.map(λ c => c.global) };
    let reads_e: Expr = match out {
        None => runtime_file_callees(lent_callees, typed_once, callees_nil, tys_e, q, reads, sigs, read_sigs.map(λ p => p.fst)),
        Some(o) => ap(o.reads, own_callees),
    };
    let world_e: Expr = match out { None => ap(world_of, [tys_e, sigs_e, ap(reads_e, [no_file])]), Some(o) => ap(o.world, own_callees) };
    let writes_e: Expr = match out { None => runtime_span_writers(sems_cons, sems_nil, typed_once, tys_e, q, writes, write_sigs), Some(o) => ap(o.writes, own_callees) };
    // The function the code is compiled from: the one written, or the
    // reflection written out, at the program's own callees.
    let compiled: Tac<Pair<Expr, Handle>> = match out {
        None => infer(Global(f)).or_fail("runtime: `" ++ name ++ "`'s type: ").bind(λ t => pure(Pair(Global(f), t))),
        Some(o) => pure(Pair(o.compiled(own_callees), o.ty)),
    };
    let made_of <- compiled;
    let fe = made_of.fst;
    let ft = made_of.snd;
    let ft_e = match meant { False => Blank, True => Hd(ft) };
    let own = match meant { False => name, True => name ++ "::bytes" };
    let e = SpanE(tys_e, sigs_e, world_e, reads_e, fsigs_e, writes_e, ap(typed_once, [ft_e, fe]));
    let base = NatLit(reads.len());
    let ks_e = Ty::quotes(rfun.params.take(lent + lent), q);
    let w0_e = Ty::quote(rfun.params.drop(lent + lent).head_or(Bit), q);
    let wrest_e = Ty::quotes(rfun.params.drop(Succ(lent + lent)), q);
    // The lowering, checked here so that a refusal names the function: the
    // instance checks it again, by the kernel.
    let lowered: Tac<Expr> = match measured {
        False => runtime_span_ref("rt_file_lower::FFun::lower").bind(λ g => pure(ap(g, [rt_e, world_e, fsigs_e, base]))),
        True => runtime_span_ref("rt_file_loop::FFun::lower_measured").bind(λ g => pure(ap(g, [ks_e, w0_e, wrest_e, body_e, res_e, world_e, fsigs_e, base, NatLit(lent)]))),
    };
    let lowered_e <- lowered;
    let accepted <- defeq(ap(lowers, [lowered_e]), yes);
    let checked <- match accepted {
        True => pure(trivial),
        False => runtime_span_refused(name, "its lowering refused it (the stores of a function over a span are bytes under its length word, and its calls pass each callee its words)"),
    };
    let code: Tac<Expr> = match measured {
        False => runtime_span_ref("runtime_file::FFun::code").bind(λ g => pure(ap(g, [rt_e, world_e, fsigs_e]))),
        True => runtime_span_ref("runtime_file::FFun::measured_code").bind(λ g => pure(ap(g, [ks_e, w0_e, wrest_e, res_e, body_e, NatLit(lent), world_e, fsigs_e]))),
    };
    let code_e <- code;
    let instance: Tac<Expr> = match measured {
        False => runtime_span_ref("runtime_file::FFun::compile").bind(λ compile =>
            pure(ap(compile, [ft_e, rt_e, world_e, reads_e, fsigs_e, writes_e, fe, e.typed,
                match out { None => ap(every, [ft_e, fe, tys_e, NatLit(lent), params_e, res_e, e.typed]), Some(o) => o.pinned }, verdict]))),
        True => match out {
            None => runtime_span_measured(name, f, q, ts, e, body_e, rfun.params, rfun.result, lent),
            // A loop written out: the passes its code counts.
            Some(o) => {
                let compile <- runtime_span_ref("runtime_file::FFun::compile_counted");
                let stops_t <- runtime_span_ref("rt_file_loop::FFun::Stops");
                let spent <- runtime_span_ref("rt_file_loop::FFun::spent");
                let source_at <- runtime_span_ref("runtime_file::FTm::source_at");
                let rest_s <- assume(Hd(buffers_h), "rest", None).or_fail("runtime: the rest of a file: ");
                let g_s <- assume(Hd(ft), "g", Some(rest_s.ref)).or_fail("runtime: a function over a span: ");
                let stops_h <- as_type(ap(stops_t, [Hd(ft), NatLit(lent + lent), params_e, res_e, tys_e,
                    Lam(g_s.ref, ap(source_at, [Hd(ft), tys_e, NatLit(lent), params_e, res_e, e.typed, Local(g_s.ref), Local(rest_s.ref)])), o.stop]))
                    .or_fail("runtime: what `" ++ name ++ "` answers with its passes spent: ");
                let opened <- runtime_open_n(64, stops_h, List::range(rfun.params.len()).map(λ i => "x".append(decimal_name(2, i))).append(["own"]));
                let xs = opened.fst.take(rfun.params.len());
                let own = opened.fst.nth(rfun.params.len()).unwrap_or(rest_s.ref);
                let stops = Lam(rest_s.ref, runtime_lams(opened.fst, ap(rfl, [Blank, ap(spent, [NatLit(lent + lent), RtQ::seq(word_list, runtime_locals(xs)), Local(own)])])));
                pure(ap(compile, [Hd(ft), ks_e, w0_e, wrest_e, res_e, body_e, NatLit(lent), world_e, reads_e, fsigs_e, writes_e, e.typed,
                    o.pass(own_callees), o.stop, o.pinned, stops, verdict]))
            },
        },
    };
    let built <- instance;
    let instance_t <- infer(built).or_fail("runtime: `" ++ name ++ "`'s instance: ");
    // Held as a hole solved by it, as a reading function's is.
    let held <- hole(instance_t).or_fail("runtime: `" ++ name ++ "`'s instance: ");
    let solved <- defeq(Hd(held), built);
    let instance_e <- match solved { True => pure(Hd(held)), False => runtime_fail("`" ++ name ++ "`'s instance does not solve its hole") };
    let writes_t <- infer(writes_e).or_fail("runtime: `" ++ name ++ "`'s writing callees: ");
    // Published with the function of the record beside it
    // (`HWorld::of_record`): the linker finds a callee's tables by that.
    let of_record <- held_name("rt_held::HWorld::of_record");
    let written: List<Decl> = match meant { False => [], True => [Decl(AsValue, own, [], Hd(ft), ap(of_record, [Hd(ft), Blank, Global(f), fe]))] };
    let head: List<Decl> = [
        Decl(AsValue, name ++ "::rt", [], Hd(ffun_h), rt_e),
        Decl(AsValue, name ++ "::world", [], Hd(ts.world), world_e),
        Decl(AsValue, name ++ "::writes", [], Hd(writes_t), writes_e)];
    // The pin, for a function its reflection's meaning converts to (a
    // function written out has it inside its instance, at every callee).
    let rest0 <- assume(Hd(buffers_h), "rest", None).or_fail("runtime: the rest of a file: ");
    let span0 <- assume(Hd(bytes_h), "span", Some(rest0.ref)).or_fail("runtime: a span: ");
    let place0 <- assume(Hd(ts.word), "place", Some(span0.ref)).or_fail("runtime: a span's place: ");
    let xs0 <- runtime_params(ts.word, own_words, Some(place0.ref), 0);
    // The function's own values from a span, the rest of the file and the
    // code's words: the written span and then each span it only reads, the
    // rest's, in its place's stead.
    let own_at: Expr → Expr → List<LocalRef> → List<Expr> = λ span rest words =>
        runtime_spanned(lent, Cons(span, List::range(lent.pred()).map(λ k => ap(span_at, [rest, NatLit(k)]))), runtime_locals(words));
    let at0 = ap(fe, own_at(Local(span0.ref), Local(rest0.ref), Cons(place0.ref, xs0)));
    let pin: List<Decl> = match measured || meant {
        True => [],
        False => [Decl(AsTheorem, name ++ "::reflects", runtime_params_of(Cons(rest0.ref, Cons(span0.ref, Cons(place0.ref, xs0)))),
            Equation(ap(ap(meaning, [rt_e, ap(fworld, [world_e, reads_e, fsigs_e, writes_e, Local(rest0.ref)])]),
                Cons(Local(span0.ref), Cons(Local(place0.ref), runtime_locals(xs0)))), at0),
            ap(rfl, [Blank, at0]))],
    };
    let made: List<Decl> = [
        Decl(AsValue, name ++ "::code", [], Hd(ts.function), code_e),
        Decl(AsInstance("runtime_file::CompileSpan", [Hd(ft)], [own]), name ++ "::compile", [], Hd(instance_t), instance_e)];
    // The program: this function and every runtime fn it reaches, each from
    // its own instance, linked over the run at every file.
    let insts <- runtime_instances(l.order, l.names, f.id, fe, instance_e);
    let sl <- runtime_span_linked(q, ts, l, insts);
    let root = NatLit(l.order.len() - 1);
    let span1 <- assume(Hd(bytes_h), "span", None).or_fail("runtime: a span: ");
    let rest1 <- assume(Hd(buffers_h), "rest", Some(span1.ref)).or_fail("runtime: the rest of a file: ");
    let place1 <- assume(Hd(ts.word), "place", Some(rest1.ref)).or_fail("runtime: a span's place: ");
    let xs1 <- runtime_params(ts.word, own_words, Some(place1.ref), 0);
    let parts <- runtime_span_parts(q, l, insts, sl);
    let words_e = RtQ::seq(word_list, Cons(Local(place1.ref), runtime_locals(xs1)));
    let file_e = ap(runtime_at(buffers, 1), [Local(span1.ref), Local(rest1.ref)]);
    let ran = ap(program_run, [sl.program, file_e, root, words_e]);
    let ended: Expr → Expr = λ g => ap(end_of, [Local(rest1.ref), ap(g, own_at(Local(span1.ref), Local(rest1.ref), Cons(place1.ref, xs1)))]);
    let answered = ap(answers, [Blank, sl.program, sl.arities, sl.stills, span_file, ap(span_sources, [sl.srcs]), parts,
        ap(span_pair, [Local(span1.ref), Local(rest1.ref)]), root, words_e, Hd(trivial_h)]);
    // What the link answers with is the function through its instance
    // (`CompileSpan::source`), on the code's words. For a function written
    // out that is the function on its own values at every callee, and so
    // at the program's: compared at the program's own callees, the two
    // would be unfolded through every accessor's body.
    let runs: Tac<Expr> = match out {
        None => pure(answered),
        Some(o) => {
            let at <- runtime_held_ref("rt_held::HWorld::at");
            let uncurry <- runtime_span_ref("rt_file_loop::FFun::uncurry");
            let source_at <- runtime_span_ref("runtime_file::FTm::source_at");
            let trans <- runtime_global("trans");
            let sourced: List<Expr> → Expr = λ es => ap(end_of, [Local(rest1.ref), ap(uncurry, [tys_e, params_e, res_e,
                ap(source_at, [Hd(o.ty), tys_e, NatLit(lent), params_e, res_e, ap(typed_once, [Hd(o.ty), o.compiled(es)]), o.compiled(es), Local(rest1.ref)]),
                words_e, Local(span1.ref)])]);
            // A loop's is the function on its own values with the
            // function a parameter, and so at the iteration: compared at
            // the iteration, a pass is unfolded on one side before the
            // other arrives at it (`Passed::KEPT`).
            let found: Tac<Expr> = match measured {
                False => runtime_at_each(at, o.callees, [], Some(xs1.rev().head_or(place1.ref)),
                    λ es _ => as_type(Equation(sourced(es), ended(o.compiled(es)))).or_fail("runtime: `" ++ name ++ "`'s answer at its callees: ").bind(λ h => pure(Hd(h))),
                    λ es => ap(rfl, [Blank, ended(o.compiled(es))])),
                True => {
                    let g <- assume(Hd(o.ty), "g", Some(xs1.rev().head_or(place1.ref))).or_fail("runtime: a function over a span: ");
                    let sourced_g = ap(end_of, [Local(rest1.ref), ap(uncurry, [tys_e, params_e, res_e,
                        ap(source_at, [Hd(o.ty), tys_e, NatLit(lent), params_e, res_e, ap(typed_once, [Hd(o.ty), Local(g.ref)]), Local(g.ref), Local(rest1.ref)]),
                        words_e, Local(span1.ref)])]);
                    let st <- as_type(Equation(sourced_g, ended(Local(g.ref)))).or_fail("runtime: `" ++ name ++ "`'s answer at a function: ");
                    pure(ap(at, [Hd(o.ty), Lam(g.ref, Hd(st)), fe, Lam(g.ref, ap(rfl, [Blank, ended(Local(g.ref))]))]))
                },
            };
            let each <- found;
            pure(ap(trans, [Blank, ran, sourced(own_callees), ended(fe), answered, each]))
        },
    };
    let run_proof <- runs;
    let tail: List<Decl> = [
        Decl(AsValue, name ++ "::program", [], Hd(ts.functions), sl.program),
        Decl(AsValue, name ++ "::arities", [], Hd(ts.nats), sl.arities),
        Decl(AsValue, name ++ "::stills", [], Hd(bools_h), sl.stills),
        Decl(AsTheorem, name ++ "::runs_over", runtime_params_of(Cons(span1.ref, Cons(rest1.ref, Cons(place1.ref, xs1)))),
            Equation(ran, ended(fe)), run_proof)];
    let counted: Tac<Option<SpanCounted>> = match out {
        None => pure(None),
        Some(o) => match measured {
            False => pure(None),
            True => {
                let source_at <- runtime_span_ref("runtime_file::FTm::source_at");
                let rest_c <- assume(Hd(buffers_h), "rest", None).or_fail("runtime: the rest of a file: ");
                let g_c <- assume(Hd(ft), "g", Some(rest_c.ref)).or_fail("runtime: a function over a span: ");
                let at_c <- runtime_held(Lam(rest_c.ref, Lam(g_c.ref, ap(source_at, [Hd(ft), tys_e, NatLit(lent), params_e, res_e, e.typed, Local(g_c.ref), Local(rest_c.ref)]))),
                    "`" ++ name ++ "` read as a meaning");
                // Held: it is read again under the record theorem's
                // binders. The pass and the stop are spelled as the
                // compiled function spells them.
                let passes_c <- runtime_held(o.pinned, "`" ++ name ++ "`'s pass as its body");
                pure(Some(SpanCounted(Hd(ft), tys_e, at_c, o.pass(own_callees), o.stop, passes_c)))
            },
        },
    };
    let counted_e <- counted;
    let beside <- more(SpanParts(rt_e, params_e, body_e, Ty::quotes([], q), λ rest => ap(fworld, [world_e, reads_e, fsigs_e, writes_e, rest]), fe,
        match out { None => [], Some(o) => o.callees },
        λ es rest => match out { None => Blank, Some(o) => ap(fworld, [ap(o.world, es), ap(o.reads, es), fsigs_e, ap(o.writes, es), rest]) },
        λ es => match out { None => fe, Some(o) => o.compiled(es) }, counted_e));
    pure(written.append(head).append(pin).append(made).append(tail).append(beside))
}

// A function that writes a span: its code takes and returns 64-bit words
// for now (a count or a type held by its repr across such a function's
// boundary is not generated yet).
fn runtime_span(name: String, f: GlobalRef) → Tac<List<Decl>> {
    let k <- rt_known_in([], [], True);
    let names <- rt_file_names();
    let r <- rt_file_reflect_one(k, names, [], f.id, name);
    let rfun = r.reflected;
    let read_sigs <- runtime_sigs(k, r.funs);
    let write_sigs <- runtime_span_sigs(k, names, r.cfuns);
    let step <- lookup(name ++ "::body");
    let measured: Bool = match step { Accepted(_) => True, Refused(_) => False };
    let table = r.funs ++ r.cfuns;
    match Ty::all_word64(rfun.params).and(rfun.result.is_word64()) {
        False => runtime_span_refused(name, "it takes and returns 64-bit words for now, beside its span"),
        True => match measured.and(rfun.params.len().leb(rfun.lent + rfun.lent)) {
            True => runtime_span_refused(name, "a loop over a span moves at least one word from pass to pass"),
            False => runtime_link(4096, k, [LinkFrame(f.id, name, table, table, Some(r.funs.len()))], Linking([], [], [], [])).bind(λ l =>
                runtime_span_publish(name, f, rfun, measured, r.funs, read_sigs, r.cfuns, write_sigs, l, False, λ _ => pure([]))),
        },
    }
}

// A function that only reads.
fn runtime_reads(name: String, f: GlobalRef) → Tac<List<Decl>> {
    let k0 <- rt_known_in([name], [], True);
    // The reflection and its callees' signatures, the types held by their
    // reprs added to the table as the walk meets them (design §16.13).
    let found <- rt_with_reprs(16, k0, λ k1 => runtime_reflect(k1, f.id, name).bind(λ r =>
        runtime_sigs(k1, r.snd.drop(1)).bind(λ ss => pure(Pair(r, ss)))));
    let callee_sigs: List<Sig> = found.snd.snd.map(λ p => p.snd);
    let lents: List<Nat> = Cons(found.snd.fst.fst.lent, found.snd.snd.map(λ p => p.fst));
    let k = found.fst;
    let reprs = k.reprs;
    let reflected = found.snd.fst;
    let rfun = reflected.fst;
    let checked <- runtime_check_carriers(k, reprs);
    let sigs = Cons(rfun.sig(), callee_sigs);
    let tys = match reprs { Nil => RecInfo::none, Cons(_, _) => runtime_shapes(reprs) };
    let world = World(tys, sigs, Sig::sems_default(tys, sigs));
    match Fun::judge(rfun, world) {
        Refused(why) => fail("`" ++ name ++ "` cannot be a runtime fn under the default setup: " ++ why, []),
        Ok => match Setup::lowers(Fun::lower_any(rfun, world)) {
            False => fail("`" ++ name ++ "`: the default setup's lowering refused it though its judgment accepted it (a gap in `Fun::judge`)", []),
            True => runtime_link(4096, k, [LinkFrame(f.id, name, reflected.snd, reflected.snd.drop(1), None)], Linking([], [], [], [])).bind(λ l =>
                runtime_publish(name, f, rfun, sigs, reflected.snd, lents, l, reprs)),
        },
    }
}

// ---------------------------------------------------------------------------
// A function of a laid record (docs/native/layout-design.md §9)
//
// `runtime fn T::m(mut self t: T, x: u64, …) → R` at a record `T` laid
// over bytes is compiled as a function over the span that holds the
// record: each field it reads is its codec's accessor's read at the
// field's offset, each field it changes the accessor's store
// (`rt_held_reflect`). What is published is what a function that writes
// a span publishes, for the function `T::m::bytes` over the span (the
// reflection written out, above), and beside it:
//
// - `T::m::held`, the program's world with each accessor marked with the
//   fields it reaches, and `T::m::sound`, what the marks owe, one
//   application of a field lemma per field;
// - `T::m::runs_held`: where the span, lent under its length word, holds
//   a record `t`, `T::m::bytes` answers what `T::m(t, …)` answers and
//   leaves the span holding the record it leaves.
//
// Nothing is proved about `T::m`: the theorem is `FFun::held_agrees`
// (rt_held.hthr) at the pin of the reflection's meaning over the record
// to `T::m`, by conversion, and the verdict that its terms are a held
// function's, by evaluation. Both are checked here first, so that a
// refusal names the function.
//
// A function that calls another function of the record `T::n` calls
// `T::n::bytes`, a computation of its program like an accessor's writer,
// and that computation's mark is `T::n` itself (`Writer::runs`): the
// held meaning of the caller names the callee's function of the record,
// so the pin is still a conversion that enters no code. What the mark
// owes is `T::n::runs_held`, the callee's own theorem, read along the
// call as the caller's world makes it; that the world's call is the
// callee applied is proved with the callee a parameter
// (`runtime_held_bridge`), since at the callee itself the kernel runs its
// body before the world's table arrives at its name. `T::n::bytes` is
// published as `HWorld::of_record(T::n, …)`, where the linker reads whose
// tables and instance a callee's are (`rt_record_of`).
//
// A function may also take spans it only reads, after its record and
// before its words, each a `List<u8>` and its length word
// (`T::m(mut self t: T, src: List<u8>, sn: u64, …)`): its code takes the
// record's span first and the read span's place and length word after it,
// and `T::m::bytes(span, length, src, sn, …)` is the code's function at a
// file whose spans after the first are those. So the marks, what they owe
// and everything said of the function of the record are functions of the
// rest of the file (`T::m::held(rest)`, `T::m::sound(rest)`), and the
// theorem reads them at the function's own spans. A byte of a read span
// is `src.byte_within(sn, i)`; a span is handed to a callee, or to a
// loop's next pass, as it came, so a callee's function of the record is
// read at the same file. A loop's recursion takes the span's bytes like
// any parameter, and the two recursions its equation compares
// (`T::m::ext`) are each read at the file's spans whatever they are
// handed, which the body never varies.
//
// A function that changes no field (`self t: T`, answering a word) is
// compiled the same way and its record-level answer is `t` unchanged
// beside the word (`HWorld::unchanged`). What is by conversion over the
// span (the instance's pin, the bytes' meaning, the program's answer) is
// proved at every callee and read at the program's own (`HWorld::at`).

// A list by `HWorld::more` and `HWorld::none`, and a tuple by
// `HWorld::owed` ending in `trivial`.
fn runtime_held_list(more, none: Expr, items: List<Expr>) → Expr {
    match items { Nil => ap(none, [Blank]), Cons(x, rest) => ap(more, [Blank, x, runtime_held_list(more, none, rest)]) }
}

fn runtime_held_tuple(owed, end: Expr, items: List<Expr>) → Expr {
    match items { Nil => end, Cons(x, rest) => ap(owed, [Blank, Blank, x, runtime_held_tuple(owed, end, rest)]) }
}

// The fields whose accessor a function of the program is.
fn runtime_held_reached(fs: List<HeldField>, pick: HeldAccess → Bool) → List<HeldAccess> {
    match fs {
        Nil => [],
        Cons(f, rest) => match f.access {
            None => runtime_held_reached(rest, pick),
            Some(a) => match pick(a) { True => Cons(a, runtime_held_reached(rest, pick)), False => runtime_held_reached(rest, pick) },
        },
    }
}

// The array fields whose checked element accessor a function of the
// program is.
fn runtime_held_arrays(fs: List<HeldField>, pick: HeldEach → Bool) → List<HeldEach> {
    match fs {
        Nil => [],
        Cons(f, rest) => match f.each {
            None => runtime_held_arrays(rest, pick),
            Some(e) => match pick(e) { True => Cons(e, runtime_held_arrays(rest, pick)), False => runtime_held_arrays(rest, pick) },
        },
    }
}

// The names the publication applies, each looked up where the `runtime
// fn` is.
record HeldNames { plain: Expr, reader_of: Expr, apart: Expr, writer_of: Expr, marked: Expr, none: Expr, more: Expr, bound: Expr, owed: Expr, sound_of: Expr,
    agrees: Expr, read_entry: Expr, write_entry: Expr, reads_field: Expr, writes_field: Expr, held: Expr, kept: Expr, bind_onto: Expr, holds: Expr, agreement: Expr,
    reader_at: Expr, writer_at: Expr, index_entry: Expr, store_entry: Expr, indexes_array: Expr, stores_array: Expr, byte_entry: Expr, stores_bytes_array: Expr }

fn runtime_held_names() → Tac<HeldNames> {
    pure(HeldNames(<- runtime_held_ref("rt_held::Reader::plain"), <- runtime_held_ref("rt_held::Reader::of"), <- runtime_held_ref("rt_held::Writer::apart"), <- runtime_held_ref("rt_held::Writer::of"),
        <- runtime_held_ref("rt_held::HWorld::marked"), <- runtime_held_ref("rt_held::HWorld::none"), <- runtime_held_ref("rt_held::HWorld::more"), <- runtime_held_ref("rt_held::HWorld::bound"),
        <- runtime_held_ref("rt_held::HWorld::owed"), <- runtime_held_ref("rt_held::Sound::of"), <- runtime_held_ref("rt_held::FFun::held_agrees"), <- runtime_held_ref("rt_held_fields::Stored::read_entry"),
        <- runtime_held_ref("rt_held_fields::Stored::write_entry"), <- runtime_held_ref("rt_held_fields::HWorld::reads_field"), <- runtime_held_ref("rt_held_fields::HWorld::writes_field"), <- runtime_held_ref("rt_held::FTm::held"),
        <- runtime_held_ref("rt_held::FTm::kept"), <- runtime_held_ref(name_of(Ty::bind_onto)), <- runtime_held_ref("rt_held::Stored::Holds"), <- runtime_held_ref("Agrees"),
        <- runtime_held_ref("rt_held::Reader::indexed"), <- runtime_held_ref("rt_held::Writer::indexed"), <- runtime_held_ref("rt_held_fields::Stored::index_entry"), <- runtime_held_ref("rt_held_fields::Stored::store_entry"),
        <- runtime_held_ref("rt_held_fields::HWorld::indexes_array"), <- runtime_held_ref("rt_held_fields::HWorld::stores_array"), <- runtime_held_ref("rt_held_fields::Part::byte_entry"),
        <- runtime_held_ref("rt_held_fields::HWorld::stores_bytes_array")))
}

// A function of the record that the function calls, as its mark: how
// many words it takes, and the function of the record at them.
// A span the callee only reads is the file's, in the place the caller
// took it (`span_of(j)`), and the word in its place is not read.
fn runtime_held_run(record, words_t: Expr, c: HeldCall, rest: LocalRef, span_of: Nat → Expr) → Tac<Expr> {
    let runs <- runtime_held_ref("rt_held::Writer::runs");
    let operand <- runtime_held_ref("rt_held::FTm::operand");
    let a <- assume(record, "held", Some(rest)).or_fail("runtime: a record: ");
    let ws <- assume(words_t, "words", Some(a.ref)).or_fail("runtime: a call's words: ");
    pure(ap(runs, [record, NatLit(c.operands), Lam(a.ref, Lam(ws.ref,
        ap(Global(c.run), Cons(Local(a.ref), runtime_at_places(Succ(c.spans), List::range(c.operands).map(λ i => ap(operand, [Local(ws.ref), NatLit(i)])), 1, span_of)))))]))
}

// The names a held callee's promise is stated with.
record HeldRan { var_t: Expr, scope_t: Expr, env_at: Expr, word_at: Expr, called_at: Expr, ran: Expr, bytes_t: Expr, nats: List<Expr>, rfl: Expr, at: Expr }

// A call of computation `j` on a place, a length word and `k` operands,
// at a span, a scope and an environment of the marked world `hw`: the
// locals, the call as the world makes it, and the words the operands are.
// `held` is a record's local between the span and the scope, where one
// is asked for (`HWorld::Runs` takes its record there).
record HeldCalled { locals: List<LocalRef>, own: LocalRef, held: Option<LocalRef>, scope: LocalRef, env: LocalRef, called: Expr, length: Expr, words: List<Expr> }

fn runtime_held_called(h: HeldRan, record, hw: Expr, j, k: Nat, with_record: Bool, under: Option<LocalRef>) → Tac<HeldCalled> {
    let place <- assume(h.var_t, "place", under).or_fail("runtime: a place's variable: ");
    let length <- assume(h.var_t, "length", Some(place.ref)).or_fail("runtime: a length word's variable: ");
    let xs <- runtime_held_vars(h.var_t, k, length.ref);
    let own <- assume(h.bytes_t, "own", Some(xs.rev().head_or(length.ref))).or_fail("runtime: a span: ");
    let held: Tac<Option<LocalRef>> = match with_record {
        False => pure(None),
        True => assume(record, "held", Some(own.ref)).or_fail("runtime: a record: ").bind(λ a => pure(Some(a.ref))),
    };
    let a <- held;
    let g <- assume(h.scope_t, "scope", Some(a.unwrap_or(own.ref))).or_fail("runtime: a scope: ");
    let env <- assume(ap(h.env_at, [record, hw, Local(g.ref)]), "env", Some(g.ref)).or_fail("runtime: an environment: ");
    let word: LocalRef → Expr = λ v => ap(h.word_at, [record, hw, Local(g.ref), Local(env.ref), Local(v)]);
    let vars = Cons(place.ref, Cons(length.ref, xs));
    pure(HeldCalled(vars ++ [own.ref, g.ref, env.ref], own.ref, a, g.ref, env.ref,
        ap(h.called_at, [record, hw, Local(g.ref), Local(env.ref), NatLit(j), RtQ::seq(h.nats, runtime_locals(vars)), Local(own.ref)]),
        word(length.ref), xs.map(word)))
}

// The call as the world makes it is the callee applied: at every callee,
// each a parameter, by computation, and so at the program's own.
fn runtime_held_bridge(h: HeldRan, record: Expr, hw_of: List<Expr> → Expr, callees: List<SpanCallee>, at_callee: Nat, j, k: Nat, spans: Nat, rest: LocalRef,
    span_of: Nat → Expr) → Tac<Expr> {
    let applied: List<Expr> → HeldCalled → Expr = λ es c => ap(runtime_at(es, at_callee), Cons(Local(c.own), Cons(c.length, runtime_at_places(Succ(spans), c.words, 1, span_of))));
    runtime_at_each_under(h.at, callees, [], Some(rest),
        λ es under => runtime_held_called(h, record, hw_of(es), j, k, False, Some(under)).bind(λ c =>
            as_type(c.locals.foldr(λ x acc => Pi(x, acc), Equation(c.called, applied(es, c)))).or_fail("runtime: a held callee's call at its callees: ").bind(λ t => pure(Hd(t)))),
        λ es under => runtime_held_called(h, record, hw_of(es), j, k, False, under).bind(λ c =>
            pure(runtime_lams(c.locals, ap(h.rfl, [Blank, applied(es, c)])))))
}

// What that mark owes (`HWorld::Runs`): the callee's own published
// agreement, `m::runs_held`, at the words its operands are, read along
// the call as the world makes it (`bridge`). Nothing is proved here
// about the callee.
fn runtime_held_ran(h: HeldRan, record, whole, hw, holds_of, bridge: Expr, j: Nat, c: HeldCall, rest: LocalRef, span_of: Nat → Expr) → Tac<Expr> {
    let agreed <- runtime_global(c.name ++ "::runs_held");
    let call <- runtime_held_called(h, record, hw, j, c.operands, True, Some(rest));
    let a = call.held.unwrap_or(call.own);
    let holds <- assume(ap(holds_of, [record, whole, Local(call.own), call.length, Local(a)]), "holds", Some(call.env)).or_fail("runtime: a span that holds a record: ");
    // The callee's own values: a span it only reads where its code takes
    // the span's place.
    let words = runtime_at_places(Succ(c.spans), call.words, 1, span_of);
    let spec = ap(Global(c.run), Cons(Local(a), words));
    let code = ap(Global(GlobalRef(c.bytes)), Cons(Local(call.own), Cons(call.length, words)));
    let got = ap(agreed, Cons(Local(call.own), Cons(Local(a), Cons(call.length, words ++ [Local(holds.ref)]))));
    let k = c.operands;
    // `HWorld::Runs` takes the span and the record before the scope.
    let order = call.locals.take(Succ(Succ(Succ(k)))) ++ [a, call.scope, call.env, holds.ref];
    pure(runtime_lams(order, ap(h.ran, [record, whole, call.length, spec, code, got, call.called, ap(bridge, runtime_locals(call.locals))])))
}

// Each of a list, in order.
fn runtime_held_each<A, B>(xs: List<A>, f: A → Tac<B>) → Tac<List<B>> {
    match xs { Nil => pure([]), Cons(x, rest) => f(x).bind(λ y => runtime_held_each(rest, f).bind(λ ys => pure(Cons(y, ys)))) }
}

// What a publication beside the span's has in hand once the marks are
// made: the names, the record and how it is stored, the marked world and
// what its marks owe.
// The marked world and what it owes are each a function of the rest of
// the file, the spans the function only reads: `files` are that list's
// constructors, and `no_file` the empty one.
record HeldSaid { n: HeldNames, ts: RtTypes, bytes: Handle, rfl: Expr, yes: Expr, zero: Expr, end: Expr, record: Expr, whole: Expr, hw: Expr,
    marked_t: Handle, sound_t: Handle, sound: Expr, files: List<Expr>, no_file: Expr, buffers: Handle, span_at: Expr }

// A statement with every mention of each function of the record a
// function calls a parameter, the first callee the innermost.
fn runtime_held_reverted(name: String, stmt: Handle, cs: List<HeldCall>) → Tac<Handle> {
    match cs {
        Nil => pure(stmt),
        Cons(c, rest) => revert_into(stmt, Global(c.run)).or_fail("runtime: `" ++ name ++ "`'s pin at `" ++ c.name ++ "` as a parameter: ").bind(λ h =>
            runtime_held_reverted(name, h, rest)),
    }
}

// A statement that is one under `n` parameters, proved by `refl` under
// them: each parameter opened, and the proof stated at what is under it.
fn runtime_held_under(stated, rfl: Expr, stmt: Handle, n: Nat) → Tac<Expr> {
    match n {
        Zero => pure(ap(stated, [Hd(stmt), ap(rfl, [Blank, Blank])])),
        Succ(m) => {
            let o <- open(stmt, "callee").or_fail("runtime: a pin's parameter: ");
            let inner <- runtime_held_under(stated, rfl, o.body, m);
            pure(Lam(o.local.ref, inner))
        },
    }
}

// The record-level theorem of a function that does not go round.
fn runtime_held_straight(name: String, f: GlobalRef, r: HeldReflected, parts: SpanParts, s: HeldSaid) → Tac<List<Decl>> {
    let n = s.n;
    let ts = s.ts;
    let bytes_h = s.bytes;
    let rfl = s.rfl;
    let yes = s.yes;
    let zero = s.zero;
    let end = s.end;
    let record = s.record;
    let whole = s.whole;
    let marked_t = s.marked_t;
    let sound_t = s.sound_t;
    let lent = Succ(r.spans);
    // The verdict, by evaluation: the length word is the variable under
    // the function's operands.
    let len = NatLit(r.operands);
    let kept <- defeq(ap(n.kept, [record, parts.body, ap(s.hw, [s.no_file]), len, ap(n.none, [Blank])]), yes);
    let kept_checked <- match kept {
        True => pure(trivial),
        False => runtime_held_refused(name, "its reads and stores are not a held function's (an accessor is called on the span's own length word, and a store's offset is a literal a field lies at)"),
    };
    // The theorem, at a span that holds a record under its length word.
    let own0 <- assume(Hd(bytes_h), "own", None).or_fail("runtime: a span: ");
    let t0 <- assume(record, "held", Some(own0.ref)).or_fail("runtime: a record: ");
    // After the record's span and its length word, each span the function
    // only reads, its bytes, with its length word, and then the words. The
    // file is those spans, and the word in a read span's place is not read.
    let all0 <- runtime_own_params(ts.word, bytes_h, lent, Succ(r.operands), Some(t0.ref), 0);
    let length0 = all0.head_or(t0.ref);
    let xs0 = all0.drop(1);
    let last0 = all0.rev().head_or(t0.ref);
    let holds0 <- assume(ap(n.holds, [record, whole, Local(own0.ref), Local(length0), Local(t0.ref)]), "holds", Some(last0)).or_fail("runtime: a span that holds a record: ");
    let file = RtQ::seq(s.files, runtime_read_spans(lent, runtime_locals(all0), 0));
    let hw = ap(s.hw, [file]);
    let sound_e = ap(s.sound, [file]);
    let env = runtime_at_places(lent, runtime_locals(all0), 0, λ _ => zero).foldl(λ acc x => ap(n.bound, [Blank, Blank, x, acc]), ap(n.bound, [Blank, Blank, zero, end]));
    // The function of the record: one that only reads it answers its
    // value beside the record as it was.
    let unchanged <- runtime_held_ref("rt_held::HWorld::unchanged");
    let applied = ap(Global(f), Cons(Local(t0.ref), runtime_locals(xs0)));
    let spec = match r.changes { True => applied, False => ap(unchanged, [Blank, Blank, Local(t0.ref), applied]) };
    let code = ap(parts.compiled, Cons(Local(own0.ref), Cons(Local(length0), runtime_locals(xs0))));
    let g_e = ap(n.bind_onto, [parts.params, parts.no_tys]);
    // The body's code is its result's by a proof that computes: the pin
    // is read along it.
    let same <- runtime_global(name_of(runtime_self));
    // The pin, by conversion, and where that runs out with each function
    // of the record it calls a parameter. At the callees themselves the comparison reaches the
    // function's side first, and a loop called at a numeral is unfolded
    // there pass by pass before the reads and stores arrive at its name
    // (`issues/conversion-callee-unfolded-before-the-meet.md`). So the
    // function is written as its body at its operands, every mention of a callee in
    // the statement is made a parameter (`revert_into` at a global), the
    // statement is proved there by `refl`, and it is read at the callees.
    let written <- body(f).or_fail("runtime: `" ++ name ++ "`'s body: ");
    let unfolded = ap(Hd(written), Cons(Local(t0.ref), runtime_locals(xs0)));
    let spelled = match r.changes { True => unfolded, False => ap(unchanged, [Blank, Blank, Local(t0.ref), unfolded]) };
    // Stated beside the hypothesis the theorem ends in, so that the
    // statement lives under the theorem's last binder and a parameter
    // opened from it is bound where the proof stands.
    let beside <- runtime_held_ref("rt_held::HWorld::beside");
    let pin0 <- as_type(Equation(ap(beside, [Blank, Blank, Local(holds0.ref), ap(n.held, [record, parts.body, hw, g_e, env, Local(own0.ref), Local(t0.ref)])]), spelled))
        .or_fail("runtime: `" ++ name ++ "`'s pin: ");
    let pin_all <- runtime_held_reverted(name, pin0, r.calls);
    let stated <- runtime_held_ref("rt_held::HWorld::stated");
    let pin_leaf <- runtime_held_under(stated, rfl, pin_all, r.calls.len());
    let pin = ap(stated, Cons(Hd(pin_all), Cons(pin_leaf, r.calls.rev().map(λ c => Global(c.run)))));
    // The pin at the callees themselves is tried first: it is the cheaper
    // of the two where it is found (at parameters the comparison makes many
    // times the queries), and a function whose record after a call is built
    // whole from that call's word pins there and not at parameters
    // (`issues/runtime-record-function-limits.md`).
    let direct <- defeq(ap(n.held, [record, parts.body, hw, g_e, env, Local(own0.ref), Local(t0.ref)]), spec);
    let by_pin: Tac<Expr> = match direct {
        True => pure(ap(rfl, [Blank, Blank])),
        False => infer(pin).bind(λ at_parameters => match at_parameters {
            Accepted(_) => pure(pin),
            Refused(_) => runtime_held_refused(name, "its reads and stores were not found to compute to the function of the record within a comparison's budget"),
        }),
    };
    let pin_proof <- by_pin;
    // The byte meaning is the function written out, at every callee and
    // so at the program's own.
    let at <- runtime_held_ref("rt_held::HWorld::at");
    let bytes_of <- runtime_held_ref("rt_held::FFun::bytes");
    let reflects <- runtime_at_each(at, parts.callees, [], Some(holds0.ref), λ es _ =>
        as_type(Equation(ap(bytes_of, [parts.rt, parts.world_of(es, file), env, Local(own0.ref)]),
            ap(parts.compiled_of(es), Cons(Local(own0.ref), Cons(Local(length0), runtime_locals(xs0))))))
            .or_fail("runtime: `" ++ name ++ "`'s byte meaning at its callees: ").bind(λ h => pure(Hd(h))),
        λ es => ap(rfl, [Blank, ap(parts.compiled_of(es), Cons(Local(own0.ref), Cons(Local(length0), runtime_locals(xs0))))]));
    let proof = ap(n.agrees, [record, parts.rt, hw, whole, sound_e, len, end, ap(same, [Blank, Blank]), env, Local(own0.ref), Local(t0.ref), Local(holds0.ref), spec, pin_proof, code, reflects]);
    pure([
        Decl(AsValue, name ++ "::held", [], Hd(marked_t), s.hw),
        Decl(AsTheorem, name ++ "::sound", [], Hd(sound_t), s.sound),
        Decl(AsTheorem, name ++ "::runs_held", runtime_params_of(Cons(own0.ref, Cons(t0.ref, all0.append([holds0.ref])))),
            ap(n.agreement, [record, Hd(ts.word), whole, Local(length0), spec, code]), proof)])
}

// The record-level theorem of a loop. Its bytes are the pass iterated as
// often as the code counts (`parts.counted`); that this is the function of
// the record is `FFun::counted_held`, from the function's own equation at
// records: the body with any recursion that agrees with the function
// below the measure is the function (`FFun::HeldGuarded`), read off the
// function's companions `ext` and `irrel`.
fn runtime_held_counted(name: String, f: GlobalRef, r: HeldReflected, parts: SpanParts, c: SpanCounted, s: HeldSaid) → Tac<List<Decl>> {
    let n = s.n;
    let ts = s.ts;
    let k = r.operands;
    let tail_kept <- runtime_held_ref("rt_held_loop::FTm::tail_kept");
    let guarded_t <- runtime_held_ref("rt_held_loop::FFun::HeldGuarded");
    let counted <- runtime_held_ref("rt_held_loop::FFun::counted_held");
    let bare <- runtime_held_ref("rt_held_loop::Agrees::bare");
    let operand <- runtime_held_ref("rt_held::FTm::operand");
    let sym_g <- runtime_global(name_of(Setup::eq_sym));
    let trans_g <- runtime_global(name_of(Setup::eq_trans));
    let lt_succ <- runtime_global(name_of(Setup::lt_succ));
    let lt_pow <- runtime_global(name_of(Setup::below_pow));
    let rec <- runtime_global(name ++ "::rec");
    let companion <- lookup(name ++ "::ext");
    let found: Tac<Expr> = match companion {
        Accepted(g) => pure(Global(g)),
        Refused(_) => runtime_held_refused(name, "it has no `ext` companion, which a loop's theorem is built from (a `decreases` function whose ending arm stores into the record gets none yet: store before the test, or in a caller)"),
    };
    let ext <- found;
    let irrel <- runtime_global(name ++ "::irrel");
    let word_list <- runtime_ctors_at(ts.words);
    let len = NatLit(k);
    let arity = NatLit(Succ(Succ(k)));
    let changes_checked <- match r.changes {
        True => pure(trivial),
        False => runtime_held_refused(name, "a loop that only reads the record is not taken yet (give it `mut self`)"),
    };
    let kept <- defeq(ap(tail_kept, [s.record, parts.body, ap(s.hw, [s.no_file]), NatLit(k), len, ap(n.none, [Blank])]), s.yes);
    let kept_checked <- match kept {
        True => pure(trivial),
        False => runtime_held_refused(name, "its reads and stores are not a held function's, or its own call is not on the record with the span's own length word"),
    };
    // Everything said of the function of the record is said at a rest of
    // a file, the spans the function only reads: the function's own value
    // for a read span is the file's span, and the word its code takes in
    // that span's place is not read.
    let lent = Succ(r.spans);
    let rest_r <- assume(Hd(s.buffers), "rest", None).or_fail("runtime: the rest of a file: ");
    let span_of: Nat → Expr = λ j => ap(s.span_at, [Local(rest_r.ref), NatLit(j)]);
    let own_values: List<Expr> → List<Expr> = λ es => runtime_at_places(lent, es, 1, span_of);
    let hw_r = ap(s.hw, [Local(rest_r.ref)]);
    let at_rest: Expr → String → Tac<Expr> = λ e what => runtime_held(Lam(rest_r.ref, e), what);
    // The function of the record and its measure, each at a record and
    // the list of its operands' words. Held: they are read under the
    // binders of several statements.
    let a_r <- assume(s.record, "held", Some(rest_r.ref)).or_fail("runtime: a record: ");
    let ws_r <- assume(Hd(ts.words), "words", Some(a_r.ref)).or_fail("runtime: a loop's words: ");
    let at_words: List<Expr> = Cons(Local(a_r.ref), own_values(List::range(k).map(λ i => ap(operand, [Local(ws_r.ref), NatLit(i)]))));
    let run_of <- at_rest(Lam(a_r.ref, Lam(ws_r.ref, ap(Global(f), at_words))), "`" ++ name ++ "` at a list of words");
    let run_e = ap(run_of, [Local(rest_r.ref)]);
    let mu_r <- runtime_measure_at(rec, at_words);
    let m_of <- at_rest(Lam(a_r.ref, Lam(ws_r.ref, Hd(mu_r))), "`" ++ name ++ "`'s measure");
    let m_e = ap(m_of, [Local(rest_r.ref)]);
    // Below `2^64`: the measure is a word's `toNat`.
    let a_b <- assume(s.record, "held", Some(rest_r.ref)).or_fail("runtime: a record: ");
    let ws_b <- assume(Hd(ts.words), "words", Some(a_b.ref)).or_fail("runtime: a loop's words: ");
    let mu_b <- runtime_measure_at(rec, Cons(Local(a_b.ref), own_values(List::range(k).map(λ i => ap(operand, [Local(ws_b.ref), NatLit(i)])))));
    let word_b <- runtime_measured_word(mu_b);
    let bounded_of <- at_rest(Lam(a_b.ref, Lam(ws_b.ref, ap(lt_pow, [Hd(word_b)]))), "`" ++ name ++ "`'s measure below `2^64`");
    // The length word is the second of the code's words.
    let ls <- runtime_params(ts.word, List::range(Succ(Succ(k))).map(λ _ => Word(64)), None, 0);
    let lengthy <- runtime_held(runtime_lams(ls, ap(s.rfl, [Blank, Local(ls.nth(1).unwrap_or(LocalRef(0)))])), "a loop's length word");
    // The function's equation: its binders opened off its statement (the
    // code's words, the span, the record, the recursion `again` and what
    // `again` agrees with below the measure).
    let g_t <- as_type(ap(guarded_t, [s.record, hw_r, parts.params, parts.body, run_e, m_e])).or_fail("runtime: `" ++ name ++ "`'s equation at records: ");
    let words: List<String> = List::range(Succ(Succ(k))).map(λ i => "x".append(decimal_name(2, i)));
    let opened <- runtime_open_n(64, g_t, words.append(["own", "held", "again", "hyp"]));
    let xs = opened.fst.take(Succ(Succ(k))).drop(2);
    let a = opened.fst.nth(k + 3).unwrap_or(LocalRef(0));
    let again = opened.fst.nth(k + 4).unwrap_or(LocalRef(0));
    let hyp = opened.fst.nth(k + 5).unwrap_or(LocalRef(0));
    // The recursion takes each read span's bytes. The body hands on the
    // spans it was given, so the recursions compared are each read at the
    // file's spans whatever they are handed: `g1` is the function there,
    // and `g2` the answer at the words, the word in a span's place the
    // one the pass was entered with.
    let own_types: List<Handle> = Cons(r.record, runtime_at_places(lent, xs.map(λ _ => ts.word), 1, λ _ => s.bytes));
    let lead = λ (ys: List<LocalRef>) => ys.head_or(LocalRef(0));
    let places: List<Expr> = runtime_read_spans(lent, runtime_locals(xs), 1);
    let at_file = λ (ys: List<LocalRef>) => Cons(Local(lead(ys)), own_values(runtime_locals(ys.drop(1))));
    let list = λ (ys: List<LocalRef>) => RtQ::seq(word_list, runtime_at_places(lent, runtime_locals(ys.drop(1)), 1, λ j => places.nth(j).unwrap_or(s.zero)));
    let mu_x <- runtime_measure_at(rec, Cons(Local(a), own_values(runtime_locals(xs))));
    let n_e = Hd(mu_x);
    // `g1 = λ t y… p => f::rec(N, t, y…, p)`.
    let ys1 <- runtime_params_at(own_types, Some(hyp), 0);
    let d1 <- runtime_bound_dom(rec, n_e, runtime_locals(ys1));
    let p1 <- assume(Hd(d1), "p", Some(ys1.rev().head_or(hyp))).or_fail("runtime: a bound proof: ");
    let g1 = runtime_lams(ys1.append([p1.ref]), ap(rec, Cons(n_e, at_file(ys1).append([Local(p1.ref)]))));
    // `g2 = λ t y… _ => again(t, [y…])`.
    let ys2 <- runtime_params_at(own_types, Some(hyp), 0);
    let d2 <- runtime_bound_dom(rec, n_e, runtime_locals(ys2));
    let p2 <- assume(Hd(d2), "q", Some(ys2.rev().head_or(hyp))).or_fail("runtime: a bound proof: ");
    let g2 = runtime_lams(ys2.append([p2.ref]), ap(Local(again), [Local(lead(ys2)), list(ys2)]));
    // They agree: `f::irrel` on the left, the hypothesis on the right.
    let ys3 <- runtime_params_at(own_types, Some(hyp), 0);
    let d3 <- runtime_bound_dom(rec, n_e, runtime_locals(ys3));
    let mu_y <- runtime_measure_of(d3);
    let p3 <- assume(Hd(d3), "p", Some(ys3.rev().head_or(hyp))).or_fail("runtime: a bound proof: ");
    let q3 <- assume(Hd(d3), "q", Some(p3.ref)).or_fail("runtime: a bound proof: ");
    let irr = ap(irrel, Cons(n_e, Cons(Blank, at_file(ys3).append([Local(p3.ref), ap(lt_succ, [Hd(mu_y)])]))));
    let hy = ap(Local(hyp), [Local(lead(ys3)), list(ys3), Local(p3.ref)]);
    let hg = runtime_lams(ys3.append([p3.ref, q3.ref]), ap(trans_g, [Blank, Blank, Blank, Blank, irr, ap(sym_g, [Blank, Blank, Blank, hy])]));
    let lt_n = ap(lt_succ, [n_e]);
    let guarded_of <- at_rest(runtime_lams(opened.fst, ap(sym_g, [Blank, Blank, Blank,
        ap(ext, Cons(n_e, Cons(n_e, Cons(g1, Cons(g2, Cons(hg, Cons(Local(a), own_values(runtime_locals(xs)).append([lt_n, lt_n]))))))))])),
        "`" ++ name ++ "`'s equation at records");
    // The theorem, at a span that holds a record under its length word:
    // after them each span the function only reads, its bytes, with its
    // length word, and then the words. The file is those spans.
    let own0 <- assume(Hd(s.bytes), "own", None).or_fail("runtime: a span: ");
    let t0 <- assume(s.record, "held", Some(own0.ref)).or_fail("runtime: a record: ");
    let all0 <- runtime_own_params(ts.word, s.bytes, lent, Succ(k), Some(t0.ref), 0);
    let length0 = all0.head_or(t0.ref);
    let xs0 = all0.drop(1);
    let last0 = all0.rev().head_or(t0.ref);
    let holds0 <- assume(ap(n.holds, [s.record, s.whole, Local(own0.ref), Local(length0), Local(t0.ref)]), "holds", Some(last0)).or_fail("runtime: a span that holds a record: ");
    let file = RtQ::seq(s.files, runtime_read_spans(lent, runtime_locals(all0), 0));
    let spec = ap(Global(f), Cons(Local(t0.ref), runtime_locals(xs0)));
    let code = ap(parts.compiled, Cons(Local(own0.ref), Cons(Local(length0), runtime_locals(xs0))));
    let at_code = RtQ::seq(word_list, Cons(s.zero, runtime_at_places(lent, runtime_locals(all0), 0, λ _ => s.zero)));
    let agreed = ap(counted, [s.record, c.ty, ap(s.hw, [file]), s.whole, ap(s.sound, [file]), parts.params, parts.body, NatLit(k), len, ap(s.rfl, [Blank, arity]), s.end,
        ap(c.at, [file]), c.pass, c.stop, ap(c.passes, [file]), lengthy, ap(run_of, [file]), ap(m_of, [file]), ap(guarded_of, [file]), ap(bounded_of, [file]), at_code,
        ap(s.rfl, [Blank, arity]), Local(own0.ref), Local(t0.ref), Local(holds0.ref)]);
    // The iteration read as a meaning is the iteration applied: by
    // computation with the iteration a parameter, and so at it
    // (`HWorld::at`). Compared at the iteration itself, the kernel unfolds
    // a pass on one side before the other arrives at the iteration, and
    // past the few spines it keeps (`Passed::KEPT`) the two meet only at
    // the count's end.
    let at <- runtime_held_ref("rt_held::HWorld::at");
    let uncurry <- runtime_held_ref("rt_file_loop::FFun::uncurry");
    let recast <- runtime_held_ref(name_of(FTm::recast));
    let rounds <- runtime_held_ref("rt_file_loop::FFun::rounds");
    let along <- runtime_held_ref("rt_held::Agrees::along");
    let passes_n <- runtime_global(name_of(Fun::meas_passes));
    let q <- runtime_quoting(ts);
    let w64 = Ty::quote(Word(64), q);
    let g <- assume(c.ty, "g", Some(holds0.ref)).or_fail("runtime: a function over a span: ");
    let coded_g = ap(recast, [c.tys, w64, w64, ap(Local(g.ref), Cons(Local(own0.ref), Cons(Local(length0), runtime_locals(xs0))))]);
    let read_t <- as_type(Equation(ap(uncurry, [c.tys, parts.params, w64, ap(c.at, [file, Local(g.ref)]), at_code, Local(own0.ref)]), coded_g))
        .or_fail("runtime: `" ++ name ++ "`'s passes read as a meaning: ");
    let reflects = ap(at, [c.ty, Lam(g.ref, Hd(read_t)), ap(rounds, [c.ty, passes_n, c.pass, c.stop]), Lam(g.ref, ap(s.rfl, [Blank, coded_g]))]);
    let proof = ap(bare, [s.record, s.whole, Local(length0), c.tys, spec, code,
        ap(along, [s.record, Hd(ts.word), s.whole, Local(length0), Blank, spec, Blank, ap(recast, [c.tys, w64, w64, code]), ap(s.rfl, [Blank, spec]), reflects, agreed])]);
    pure([
        Decl(AsValue, name ++ "::held", [], Hd(s.marked_t), s.hw),
        Decl(AsTheorem, name ++ "::sound", [], Hd(s.sound_t), s.sound),
        Decl(AsTheorem, name ++ "::runs_held", runtime_params_of(Cons(own0.ref, Cons(t0.ref, all0.append([holds0.ref])))),
            ap(n.agreement, [s.record, Hd(ts.word), s.whole, Local(length0), spec, code]), proof)])
}

// What is published beside the span's: the marks, what they owe, and the
// record-level theorem.
fn runtime_held_more(name: String, f: GlobalRef, r: HeldReflected, parts: SpanParts) → Tac<List<Decl>> {
    let n <- runtime_held_names();
    let ts <- runtime_type_handles();
    let bytes_h <- runtime_type_of(name_of(runtime_w_bytes));
    let rfl <- runtime_global("tactic::rfl");
    let yes <- runtime_global(name_of(runtime_w_true));
    let zero <- runtime_global(name_of(runtime_w_word));
    let trivial_h <- resolve("trivial").or_fail("runtime: `trivial`: ");
    let end = Hd(trivial_h);
    let by_refl = ap(rfl, [Blank, Blank]);
    let record = Hd(r.record);
    let whole = Global(r.stored);
    // The marks and what they owe are at a rest of a file, the spans the
    // function only reads: a callee that reads spans reads the same ones.
    let buffers_h <- runtime_type_of(name_of(runtime_w_buffers));
    let files <- runtime_ctors_at(buffers_h);
    let no_file <- runtime_global(name_of(runtime_w_buffers));
    let span_at <- runtime_global(name_of(Setup::span_at));
    let rest0 <- assume(Hd(buffers_h), "rest", None).or_fail("runtime: the rest of a file: ");
    let span_of: Nat → Expr = λ j => ap(span_at, [Local(rest0.ref), NatLit(j)]);
    let entry: Expr → HeldAccess → Expr = λ of a => ap(of, [record, a.ty, whole, a.codec, a.instance, a.part]);
    // Each function's mark: the fields whose accessor it is.
    let readers: List<List<HeldAccess>> = r.funs.map(λ g => runtime_held_reached(r.fields, λ a => a.reader.same(g)));
    let writers: List<List<HeldAccess>> = r.cfuns.map(λ g => runtime_held_reached(r.fields, λ a => a.writer.id.same(g)));
    // And the arrays whose checked element accessor it is: an array is
    // marked whole, by where it begins and its count.
    let readers_at: List<List<HeldEach>> = r.funs.map(λ g => runtime_held_arrays(r.fields, λ e => e.at.reader.same(g)));
    let writers_at: List<List<HeldEach>> = r.cfuns.map(λ g => runtime_held_arrays(r.fields, λ e => e.at.writer.id.same(g)));
    // And the arrays of words whose checked byte store it is, each by
    // where it begins and its count in bytes.
    let writers_bytes: List<List<HeldEach>> = r.cfuns.map(λ g => runtime_held_arrays(r.fields, λ e => match e.at.bytes { None => False, Some(by) => by.writer.id.same(g) }));
    let byte_array: HeldEach → Expr = λ e => ap(n.byte_entry, [record, whole, NatLit(e.term.count), e.at.part]);
    let array: Expr → HeldEach → Expr = λ of e => ap(of, [record, e.ty, whole, e.codec, e.instance, NatLit(e.term.count), e.at.part]);
    let readers_e = runtime_held_list(n.more, n.none, List::range(readers.len()).map(λ j => match readers.nth(j).unwrap_or([]) {
        Nil => match readers_at.nth(j).unwrap_or([]) {
            Nil => ap(n.plain, [record]),
            Cons(e, more) => ap(n.reader_at, [record, runtime_held_list(n.more, n.none, Cons(e, more).map(λ e => array(n.index_entry, e)))]),
        },
        Cons(a, more) => ap(n.reader_of, [record, runtime_held_list(n.more, n.none, Cons(a, more).map(λ a => entry(n.read_entry, a)))]),
    }));
    // A computation that is a function of the record is marked with that
    // function.
    let called: List<Option<HeldCall>> = r.cfuns.map(λ g => r.calls.filter(λ c => c.bytes.same(g)).head());
    let word_list <- runtime_type_of(name_of(runtime_w_words));
    let runs <- runtime_held_each(called, λ c => match c {
        None => pure(None),
        // Held, a closed term: the marks are read again under each
        // callee's binder.
        Some(call) => runtime_held_run(record, Hd(word_list), call, rest0.ref, span_of).bind(λ e =>
            runtime_held(Lam(rest0.ref, e), "`" ++ name ++ "`'s mark for `" ++ call.name ++ "`").bind(λ held => pure(Some(ap(held, [Local(rest0.ref)]))))),
    });
    let writers_e = runtime_held_list(n.more, n.none, List::range(writers.len()).map(λ j => match runs.nth(j).unwrap_or(None) {
        Some(run) => run,
        None => match writers.nth(j).unwrap_or([]) {
            Nil => match writers_at.nth(j).unwrap_or([]) {
                Nil => match writers_bytes.nth(j).unwrap_or([]) {
                    Nil => ap(n.apart, [record]),
                    Cons(e, more) => ap(n.writer_at, [record, runtime_held_list(n.more, n.none, Cons(e, more).map(byte_array))]),
                },
                Cons(e, more) => ap(n.writer_at, [record, runtime_held_list(n.more, n.none, Cons(e, more).map(λ e => array(n.store_entry, e)))]),
            },
            Cons(a, more) => ap(n.writer_of, [record, runtime_held_list(n.more, n.none, Cons(a, more).map(λ a => entry(n.write_entry, a)))]),
        },
    }));
    let marked = Lam(rest0.ref, ap(n.marked, [record, parts.world(Local(rest0.ref)), readers_e, writers_e]));
    let marked_t <- infer(marked).or_fail("runtime: `" ++ name ++ "`'s marks: ");
    // Held as holes solved by them, so that each is one term wherever it
    // stands.
    let hw_of_rest <- runtime_held(marked, "`" ++ name ++ "`'s marks");
    let hw = ap(hw_of_rest, [Local(rest0.ref)]);
    // What an array's checked accessor owes: one application of the
    // array's lemma, at the array's part and the function's place.
    let owes_at: Expr → Nat → List<HeldEach> → Expr = λ lemma j es =>
        runtime_held_tuple(n.owed, end, es.map(λ e => ap(lemma, [record, e.ty, hw, whole, e.codec, e.instance, NatLit(e.term.count), e.at.part, by_refl, NatLit(j), by_refl])));
    let owes: Expr → List<List<HeldAccess>> → Expr = λ field fss =>
        runtime_held_tuple(n.owed, end, List::range(fss.len()).map(λ j => match fss.nth(j).unwrap_or([]) {
            Nil => owes_at(n.indexes_array, j, readers_at.nth(j).unwrap_or([])),
            Cons(a, more) => runtime_held_tuple(n.owed, end, Cons(a, more).map(λ a => ap(field, [record, a.ty, hw, whole, a.codec, a.instance, a.part, by_refl, NatLit(j), by_refl]))),
        }));
    let q <- runtime_quoting(ts);
    let at_all <- runtime_held_ref("rt_held::HWorld::at");
    let ran_names = HeldRan(<- runtime_held_ref("rt_held::HWorld::Var"), <- runtime_held_ref("rt_held::HWorld::Scope"), <- runtime_held_ref("rt_held::HWorld::EnvAt"),
        <- runtime_held_ref("rt_held::HWorld::word_at"), <- runtime_held_ref("rt_held::HWorld::called_at"), <- runtime_held_ref("rt_held::HWorld::ran"), Hd(bytes_h), q.nats, rfl, at_all);
    let hw_of: List<Expr> → Expr = λ es => ap(n.marked, [record, parts.world_of(es, Local(rest0.ref)), readers_e, writers_e]);
    let rans <- runtime_held_each(List::range(called.len()), λ j => match called.nth(j).unwrap_or(None) {
        None => pure(None),
        // The bridge is held, a closed term: it is read under the
        // promise's own binders.
        Some(call) => runtime_held_bridge(ran_names, record, hw_of, parts.callees, r.funs.len() + j, j, call.operands, call.spans, rest0.ref, span_of).bind(λ bridge =>
            runtime_held(Lam(rest0.ref, bridge), "`" ++ name ++ "`'s call of `" ++ call.name ++ "` at its callees").bind(λ held =>
            runtime_held_ran(ran_names, record, whole, hw, n.holds, ap(held, [Local(rest0.ref)]), j, call, rest0.ref, span_of).bind(λ e => pure(Some(e))))),
    });
    let owes_writers = runtime_held_tuple(n.owed, end, List::range(writers.len()).map(λ j => match rans.nth(j).unwrap_or(None) {
        Some(ran) => ran,
        None => match writers.nth(j).unwrap_or([]) {
            Nil => match writers_at.nth(j).unwrap_or([]) {
                Nil => runtime_held_tuple(n.owed, end, writers_bytes.nth(j).unwrap_or([]).map(λ e =>
                    ap(n.stores_bytes_array, [record, hw, whole, NatLit(e.term.count), e.at.part, by_refl, NatLit(j), by_refl]))),
                Cons(e, more) => owes_at(n.stores_array, j, Cons(e, more)),
            },
            Cons(a, more) => runtime_held_tuple(n.owed, end, Cons(a, more).map(λ a => ap(n.writes_field, [record, a.ty, hw, whole, a.codec, a.instance, a.part, by_refl, NatLit(j), by_refl]))),
        },
    }));
    let sound = Lam(rest0.ref, ap(n.sound_of, [record, hw, whole, owes(n.reads_field, readers), owes_writers]));
    let sound_t <- infer(sound).or_fail("runtime: `" ++ name ++ "`: what its accessors owe at the record's fields (a field's accessor is a function of the program that reads or stores its codec's word): ");
    let sound_e <- runtime_held(sound, "what `" ++ name ++ "`'s marks owe");
    let said = HeldSaid(n, ts, bytes_h, rfl, yes, zero, end, record, whole, hw_of_rest, marked_t, sound_t, sound_e, files, no_file, buffers_h, span_at);
    match r.measured {
        False => runtime_held_straight(name, f, r, parts, said),
        True => match parts.counted {
            Some(c) => runtime_held_counted(name, f, r, parts, c, said),
            None => runtime_held_refused(name, "its loop was not written out as the passes its code counts"),
        },
    }
}

// A function of a laid record: its code takes the span's place and its
// length word, then 64-bit words, and answers one.
fn runtime_record(name: String, f: GlobalRef) → Tac<List<Decl>> {
    let k <- rt_known_in([], [], True);
    let names <- rt_file_names();
    let r <- rt_held_reflect_one(k, names, f, name);
    let rfun = r.reflected;
    let read_sigs <- runtime_sigs(k, r.funs);
    let write_sigs <- runtime_span_sigs(k, names, r.cfuns);
    let table = r.funs ++ r.cfuns;
    match rfun.result.is_word64() {
        False => runtime_held_refused(name, "it answers a 64-bit word for now, beside its record"),
        True => match r.measured.and(r.operands.leb(r.spans + r.spans)) {
            True => runtime_held_refused(name, "a loop moves at least one word from pass to pass"),
            False => runtime_link(4096, k, [LinkFrame(f.id, name, table, table, Some(r.funs.len()))], Linking([], [], [], [])).bind(λ l =>
                runtime_span_publish(name, f, rfun, r.measured, r.funs, read_sigs, r.cfuns, write_sigs, l, True, λ parts => runtime_held_more(name, f, r, parts))),
        },
    }
}

// Whether a function's first parameter is a record laid over bytes: a
// type with no arguments that has a `T::stored`.
fn runtime_of_laid(f: GlobalRef) → Tac<Bool> {
    infer(Global(f)).bind(λ c => match c {
        Refused(_) => pure(False),
        Accepted(t) => view(t).bind(λ v => match v {
            HPi(dom) => view(dom).bind(λ dv => match dv {
                HGlobal(_, tname, args) => match args {
                    Nil => lookup(tname ++ "::stored").bind(λ s => pure(match s { Accepted(_) => True, Refused(_) => False })),
                    Cons(_, _) => pure(False),
                },
                _ => pure(False),
            }),
            _ => pure(False),
        }),
    })
}

// `runtime fn f`: a function whose first parameter is a record laid over
// bytes is over the span that holds the record; of the others, one whose
// type ends in `Mutated` writes a span, and any other only reads.
fn runtime(name: String) → Tac<List<Decl>> {
    let f <- runtime_ref(name);
    let writes <- runtime_writes(f);
    let laid <- runtime_of_laid(f);
    match laid { True => runtime_record(name, f), False => match writes { True => runtime_span(name, f), False => runtime_reads(name, f) } }
}

import logic;
import bool;
import nat;
import list;
import option;
import pair;
import vector;
import assoc;
import omega;
import bitvec_omega;
import bitvec_shift_nat;
import runtime_data;
import word_map;

// ---------------------------------------------------------------------------
// The slots as numbers.

fn WordMap::key(self m: WordMap, s: Nat) → u64 { vector_get(m.keys, s, BitVec::ofNat(0)) }

fn WordMap::val(self m: WordMap, s: Nat) → u64 { vector_get(m.vals, s, BitVec::ofNat(0)) }

// The rows of the `n` slots from `s` that hold a key, in slot order.
fn WordMap::rows(self m: WordMap, s, n: Nat) → List<Pair<u64, u64>> {
    match n {
        Zero => Nil,
        Succ(r) => match BitVec::eq_dec(m.key(s), BitVec::ofNat(0)) {
            Inl(_) => m.rows(s + 1, r),
            Inr(_) => Cons(Pair(m.key(s), m.val(s)), m.rows(s + 1, r)),
        },
    }
}

// What the table stands for: the association list of its occupied slots.
fn WordMap::abs(self m: WordMap) → List<Pair<u64, u64>> { m.rows(0, 4) }

// Key `x` stored at slot `t` with value `w`.
record RowAt(m: WordMap, x, w: u64, t: Nat) { at: m.key(t) = x, nz: ¬(x = 0), val: m.val(t) = w }

// A key no slot of `s .. s + n` holds is not in their rows.
theorem WordMap::rows_none(self m: WordMap, x: u64, n: Nat): (s: Nat) → ((t: Nat) → s <= t → t < s + n → m.key(t) = x → x = 0) → m.rows(s, n).assoc_get(x) = None {
    match n {
        Zero => λ s none => refl,
        Succ(r, ih) => λ s none => match BitVec::eq_dec(m.key(s), BitVec::ofNat(0)) as λ d =>
            (match d { Inl(_) => m.rows(s + 1, r), Inr(_) => Cons(Pair(m.key(s), m.val(s)), m.rows(s + 1, r)) }).assoc_get(x) = None
        {
            Inl(_) => ih(s + 1, λ t lo hi at => none(t, omega, omega, at)),
            Inr(nz) => {
                let miss: (¬(x = m.key(s))) = λ e => nz(trans(sym(e), none(s, omega, omega, sym(e))));
                trans(m.rows(s + 1, r).assoc_get_miss(Pair(m.key(s), m.val(s)), x, miss), ih(s + 1, λ t lo hi at => none(t, omega, omega, at)))
            },
        },
    }
}

// A key one slot of `s .. s + n` holds, and no other, is that slot's value.
theorem WordMap::rows_some(self m: WordMap, x: u64, t0: Nat, nz: ¬(x = 0), at: m.key(t0) = x, n: Nat):
    (s: Nat) → s <= t0 → t0 < s + n → ((t: Nat) → s <= t → t < s + n → m.key(t) = x → t = t0) → m.rows(s, n).assoc_get(x) = Some(m.val(t0))
{
    match n {
        Zero => λ s lo hi only => false_elim(omega),
        Succ(r, ih) => λ s lo hi only => match BitVec::eq_dec(m.key(s), BitVec::ofNat(0)) as λ d =>
            (match d { Inl(_) => m.rows(s + 1, r), Inr(_) => Cons(Pair(m.key(s), m.val(s)), m.rows(s + 1, r)) }).assoc_get(x) = Some(m.val(t0))
        {
            Inl(z) => {
                let other: (¬(s = t0)) = λ e => nz(trans(sym(at), trans(cong_fn(λ (q: Nat) => m.key(q), sym(e)), z)));
                ih(s + 1, omega, omega, λ t lo2 hi2 a => only(t, omega, omega, a))
            },
            Inr(occupied) => match BitVec::eq_dec(x, m.key(s)) {
                Inl(e) => {
                    let here: (s = t0) = only(s, omega, omega, sym(e));
                    cong_fn(λ (q: Nat) => Some(m.val(q)), here)
                },
                Inr(miss) => {
                    let other: (¬(s = t0)) = λ e => miss(trans(sym(at), cong_fn(λ (q: Nat) => m.key(q), sym(e))));
                    ih(s + 1, omega, omega, λ t lo2 hi2 a => only(t, omega, omega, a))
                },
            },
        },
    }
}

// A row of the rows is a slot's.
theorem WordMap::rows_row(self m: WordMap, x, w: u64, n: Nat): (s: Nat) → Mem(Pair(x, w), m.rows(s, n)) →
    Exists(λ (t: Nat) => And<And<s <= t, t < s + n>, RowAt(m, x, w, t)>)
{
    match n {
        Zero => λ s none => false_elim(none),
        Succ(r, ih) => λ s => match BitVec::eq_dec(m.key(s), BitVec::ofNat(0)) as λ d =>
            Mem(Pair(x, w), match d { Inl(_) => m.rows(s + 1, r), Inr(_) => Cons(Pair(m.key(s), m.val(s)), m.rows(s + 1, r)) }) →
            Exists(λ (t: Nat) => And<And<s <= t, t < s + Succ(r)>, RowAt(m, x, w, t)>)
        {
            Inl(_) => λ later => {
                let found = ih(s + 1, later);
                Exists(found.witness, And(And(omega(found.proof.left.left), omega(found.proof.left.right)), found.proof.right))
            },
            Inr(occupied) => λ mem => match mem {
                Inl(e) => {
                    let k: (x = m.key(s)) = cong_fn(λ (p: Pair<u64, u64>) => p.fst, e);
                    let v: (w = m.val(s)) = cong_fn(λ (p: Pair<u64, u64>) => p.snd, e);
                    Exists(s, And(And(omega, omega), RowAt(sym(k), λ z => occupied(trans(sym(k), z)), sym(v))))
                },
                Inr(later) => {
                    let found = ih(s + 1, later);
                    Exists(found.witness, And(And(omega(found.proof.left.left), omega(found.proof.left.right)), found.proof.right))
                },
            },
        },
    }
}

// ---------------------------------------------------------------------------
// Slots as words: the next slot, and the home slot's range.

theorem WordMap::band_three(x: u64): x.band(3).toNat() = x.toNat() % 4 {
    let mask: (BitVec::ofNat(3, n := 64) = BitVec::low_mask(2)) = refl;
    trans(cong_fn(λ (y: u64) => x.band(y).toNat(), mask), BitVec::toNat_band_low_mask(64, 2, x))
}

theorem WordMap::next_slot(j: u64, inside: j.toNat() < 4): ((j + 1).band(3)).toNat() = (j.toNat() + 1) % 4 {
    let up: ((j + 1).toNat() = j.toNat() + 1) = bv_omega;
    trans(WordMap::band_three(j + 1), cong_fn(λ (q: Nat) => q % 4, up))
}

theorem word_map_home_below(k: u64): word_map_home(k).toNat() < 4 {
    let is: (word_map_home(k) = (k * 11400714819323198485).shift_right(62)) = refl;
    let below: ((k * 11400714819323198485).shift_right(62).toNat() < 4) = bv_omega;
    rewrite(sym(is), in := below)
}

// ---------------------------------------------------------------------------
// One probe step in distances: from `j` to `jn`, the next slot.

theorem WordMap::not_before_self(t, s, h: Nat, same: t = s, before: ((t + 4 - h) % 4) < ((s + 4 - h) % 4)): False { omega }

theorem WordMap::step_budget(j, s, jn, l, ln: Nat, j4: j < 4, s4: s < 4, nj: jn = (j + 1) % 4, dl: ln = l - 1, other: ¬(j = s),
    budget: ((s + 4 - j) % 4) < l): ((s + 4 - jn) % 4) < ln { omega }

theorem WordMap::step_before(j, s, t, jn: Nat, j4: j < 4, s4: s < 4, t4: t < 4, nj: jn = (j + 1) % 4, other: ¬(j = s),
    before: ((t + 4 - jn) % 4) < ((s + 4 - jn) % 4)): ((t + 4 - j) % 4) < ((s + 4 - j) % 4) { omega }

theorem WordMap::step_before_back(j, s, t, jn: Nat, j4: j < 4, s4: s < 4, t4: t < 4, nj: jn = (j + 1) % 4, other: ¬(j = s), away: ¬(t = j),
    before: ((t + 4 - j) % 4) < ((s + 4 - j) % 4)): ((t + 4 - jn) % 4) < ((s + 4 - jn) % 4) { omega }

// ---------------------------------------------------------------------------
// The table's lookups, read off its slots.

fn WordMap::Distinct(self m: WordMap) → Type { (s, t: Nat) → s < 4 → t < 4 → ¬(m.key(s) = 0) → m.key(s) = m.key(t) → s = t }

theorem WordMap::abs_get_at(self m: WordMap, distinct: m.Distinct(), x, w: u64, t: Nat, inside: t < 4, row: RowAt(m, x, w, t)): m.abs().assoc_get(x) = Some(w) {
    let only = λ (u: Nat) (lo: 0 <= u) (hi: u < 0 + 4) (a: m.key(u) = x) =>
        distinct(u, t, omega, inside, λ z => row.nz(trans(sym(a), z)), trans(a, sym(row.at)));
    trans(m.rows_some(x, t, row.nz, row.at, 4, 0, omega, omega, only), cong_fn(λ (v: u64) => Some(v), row.val))
}

theorem WordMap::abs_get_none(self m: WordMap, x: u64, none: (t: Nat) → t < 4 → m.key(t) = x → x = 0): m.abs().assoc_get(x) = None {
    m.rows_none(x, 4, 0, λ t lo hi a => none(t, omega, a))
}

theorem WordMap::abs_get_row(self m: WordMap, x, w: u64, h: m.abs().assoc_get(x) = Some(w)): Exists(λ (t: Nat) => And<t < 4, RowAt(m, x, w, t)>) {
    let found = m.rows_row(x, w, 4, 0, m.abs().assoc_get_row(x, w, h));
    Exists(found.witness, And(omega(found.proof.left.right), found.proof.right))
}

// Two tables whose slots hold the key `x` with the same values agree at
// `x`, wherever the slots are.
fn WordMap::Moves(m, n: WordMap, x: u64) → Type {
    (w: u64) → (t: Nat) → t < 4 → RowAt(m, x, w, t) → Exists(λ (u: Nat) => And<u < 4, RowAt(n, x, w, u)>)
}

theorem WordMap::abs_get_same(m, n: WordMap, dm: m.Distinct(), dn: n.Distinct(), x: u64, there: WordMap::Moves(m, n, x), back: WordMap::Moves(n, m, x)):
    n.abs().assoc_get(x) = m.abs().assoc_get(x)
{
    match h: m.abs().assoc_get(x) {
        Some(w) => {
            let row = m.abs_get_row(x, w, h);
            let moved = there(w, row.witness, row.proof.left, row.proof.right);
            n.abs_get_at(dn, x, w, moved.witness, moved.proof.left, moved.proof.right)
        },
        None => n.abs_get_none(x, λ t inside a => match BitVec::eq_dec(x, BitVec::ofNat(0)) {
            Inl(z) => z,
            Inr(nz) => {
                let moved = back(n.val(t), t, inside, RowAt(a, nz, refl));
                let some = m.abs_get_at(dm, x, n.val(t), moved.witness, moved.proof.left, moved.proof.right);
                Option::none_ne_some(n.val(t), trans(sym(h), some), x = BitVec::ofNat(0))
            },
        }),
    }
}

// ---------------------------------------------------------------------------
// The probing invariant.

// The number of the `n` slots from `s` that hold a key.
fn WordMap::used(self m: WordMap, s, n: Nat) → Nat {
    match n {
        Zero => 0,
        Succ(r) => match BitVec::eq_dec(m.key(s), BitVec::ofNat(0)) {
            Inl(_) => m.used(s + 1, r),
            Inr(_) => m.used(s + 1, r) + 1,
        },
    }
}

record WordMapInv(m: WordMap) {
    // Every stored key is reached from its home without passing an empty slot.
    reach: (s, t: Nat, x: u64) → s < 4 → t < 4 → m.key(s) = x → ¬(x = 0) → ((t + 4 - word_map_home(x).toNat()) % 4) < ((s + 4 - word_map_home(x).toNat()) % 4) → ¬(m.key(t) = 0),
    // No key is stored twice.
    distinct: m.Distinct(),
    // The count is the number of occupied slots, and one slot is empty.
    count: m.count.toNat() = m.used(0, 4),
    room: m.count.toNat() < 4,
}

// ---------------------------------------------------------------------------
// Lookup.

// A probe from `j` that passes only occupied slots of other keys before the
// key's slot `s`, within its budget, answers the slot's value.
fn WordMap::Finds(m: WordMap, k: u64, s: Nat, j, left: u64) → Type {
    j.toNat() < 4 → ((s + 4 - j.toNat()) % 4) < left.toNat() →
    ((t: Nat) → t < 4 → ((t + 4 - j.toNat()) % 4) < ((s + 4 - j.toNat()) % 4) → And<¬(m.key(t) = 0), ¬(m.key(t) = k)>) →
    m.find_at(k, j, left) = m.val(s)
}

theorem WordMap::finds_empty(m: WordMap, k: u64, s: Nat, s4: s < 4, at: m.key(s) = k, nz: ¬(k = 0), j, left: u64, empty: m.key(j.toNat()) = 0):
    WordMap::Finds(m, k, s, j, left)
{
    λ j4 budget clear => {
        match Nat::eq_dec(j.toNat(), s) {
            Inl(same) => false_elim(nz(trans(sym(at), trans(cong_fn(λ (q: Nat) => m.key(q), sym(same)), empty)))),
            Inr(other) => match clear(j.toNat(), j4, omega) { And(occupied, _) => false_elim(occupied(empty)) },
        }
    }
}

theorem WordMap::finds_hit(m: WordMap, k: u64, s: Nat, s4: s < 4, j, left: u64, hit: m.key(j.toNat()) = k, eq: m.find_at(k, j, left) = m.val(j.toNat())):
    WordMap::Finds(m, k, s, j, left)
{
    λ j4 budget clear => trans(eq, match Nat::eq_dec(j.toNat(), s) {
        Inl(same) => cong_fn(λ (q: Nat) => m.val(q), same),
        Inr(other) => match clear(j.toNat(), j4, omega) { And(_, other) => false_elim(other(hit)) },
    })
}

theorem WordMap::finds_next(m: WordMap, k: u64, s: Nat, s4: s < 4, at: m.key(s) = k, j, left: u64, more: 0 < left, hit: ¬(m.key(j.toNat()) = k),
    eq: m.find_at(k, j, left) = m.find_at(k, (j + 1).band(3), left - 1), ih: WordMap::Finds(m, k, s, (j + 1).band(3), left - 1)):
    WordMap::Finds(m, k, s, j, left)
{
    λ j4 budget clear => {
        let nj = WordMap::next_slot(j, j4);
        let dl: ((left - 1).toNat() = left.toNat() - 1) = bv_omega;
        let other: (¬(j.toNat() = s)) = λ e => hit(trans(cong_fn(λ (q: Nat) => m.key(q), e), at));
        trans(eq, ih(omega(nj), WordMap::step_budget(j.toNat(), s, ((j + 1).band(3)).toNat(), left.toNat(), (left - 1).toNat(), j4, s4, nj, dl, other, budget),
            λ t t4 before => clear(t, t4, WordMap::step_before(j.toNat(), s, t, ((j + 1).band(3)).toNat(), j4, s4, t4, nj, other, before))))
    }
}

theorem WordMap::find_found(m: WordMap, k: u64, s: Nat, s4: s < 4, at: m.key(s) = k, nz: ¬(k = 0), j, left: u64): WordMap::Finds(m, k, s, j, left) {
    WordMap::find_at::induct(m, k, λ (j: u64) (left: u64) => WordMap::Finds(m, k, s, j, left),
        λ j left more lt empty eq => WordMap::finds_empty(m, k, s, s4, at, nz, j, left, empty),
        λ j left more lt empty hit eq => WordMap::finds_hit(m, k, s, s4, j, left, hit, eq),
        λ j left more lt empty hit eq ih => WordMap::finds_next(m, k, s, s4, at, j, left, more, hit, eq, ih),
        λ j left more lt eq => λ j4 budget clear => false_elim(lt(j4)),
        λ j left more eq => λ j4 budget clear => false_elim(omega(more, budget)),
        j, left)
}

// A probe for a key no slot holds answers 0.
fn WordMap::Misses(m: WordMap, k: u64, j, left: u64) → Type { j.toNat() < 4 → m.find_at(k, j, left) = 0 }

theorem WordMap::misses_hit(m: WordMap, k: u64, none: (t: Nat) → t < 4 → m.key(t) = k → m.key(t) = 0, j, left: u64,
    empty: ¬(m.key(j.toNat()) = 0), hit: m.key(j.toNat()) = k): WordMap::Misses(m, k, j, left)
{
    λ j4 => false_elim(empty(none(j.toNat(), j4, hit)))
}

theorem WordMap::misses_next(m: WordMap, k: u64, j, left: u64, eq: m.find_at(k, j, left) = m.find_at(k, (j + 1).band(3), left - 1),
    ih: WordMap::Misses(m, k, (j + 1).band(3), left - 1)): WordMap::Misses(m, k, j, left)
{
    λ j4 => trans(eq, ih(omega(WordMap::next_slot(j, j4))))
}

theorem WordMap::find_absent(m: WordMap, k: u64, none: (t: Nat) → t < 4 → m.key(t) = k → m.key(t) = 0, j, left: u64): WordMap::Misses(m, k, j, left) {
    WordMap::find_at::induct(m, k, λ (j: u64) (left: u64) => WordMap::Misses(m, k, j, left),
        λ j left more lt empty eq => λ j4 => eq,
        λ j left more lt empty hit eq => WordMap::misses_hit(m, k, none, j, left, empty, hit),
        λ j left more lt empty hit eq ih => WordMap::misses_next(m, k, j, left, eq, ih),
        λ j left more lt eq => λ j4 => eq,
        λ j left more eq => λ j4 => eq,
        j, left)
}

// Where a key is: at a slot, or at none.
theorem WordMap::past_slots(q: Nat, big: q + 4 < 4): False { omega }

theorem WordMap::locate(self m: WordMap, k: u64): Or<Exists(λ (t: Nat) => And<t < 4, m.key(t) = k>), (t: Nat) → t < 4 → ¬(m.key(t) = k)> {
    match BitVec::eq_dec(m.key(0), k) {
        Inl(e0) => Inl(Exists(0, And(omega, e0))),
        Inr(n0) => match BitVec::eq_dec(m.key(1), k) {
            Inl(e1) => Inl(Exists(1, And(omega, e1))),
            Inr(n1) => match BitVec::eq_dec(m.key(2), k) {
                Inl(e2) => Inl(Exists(2, And(omega, e2))),
                Inr(n2) => match BitVec::eq_dec(m.key(3), k) {
                    Inl(e3) => Inl(Exists(3, And(omega, e3))),
                    Inr(n3) => Inr(λ t t4 => match t as λ u => u < 4 → ¬(m.key(u) = k) {
                        Zero => λ _ => n0,
                        Succ(Zero) => λ _ => n1,
                        Succ(Succ(Zero)) => λ _ => n2,
                        Succ(Succ(Succ(Zero))) => λ _ => n3,
                        Succ(Succ(Succ(Succ(q)))) => λ (big: q + 4 < 4) => false_elim(WordMap::past_slots(q, big)),
                    }(t4)),
                },
            },
        },
    }
}

// ---------------------------------------------------------------------------
// `get` is `assoc_get` of the table's rows, 0 where it has none.

theorem WordMap::get_stored(m: WordMap, inv: WordMapInv(m), k: u64, s: Nat, s4: s < 4, at: m.key(s) = k, nz: ¬(k = 0)): m.get(k) = m.val(s) {
    let h = word_map_home(k);
    let h4: (h.toNat() < 4) = word_map_home_below(k);
    WordMap::find_found(m, k, s, s4, at, nz, h, 4, h4, omega(s4, h4), λ t t4 before => And(
        inv.reach(s, t, k, s4, t4, at, nz, before),
        λ again => WordMap::not_before_self(t, s, h.toNat(), inv.distinct(t, s, t4, s4, λ z => nz(trans(sym(again), z)), trans(again, sym(at))), before)))
}

theorem WordMap::get_is(m: WordMap, inv: WordMapInv(m), k: u64): m.get(k) = m.abs().assoc_get(k).unwrap_or(0) {
    match m.locate(k) {
        Inl(found) => match BitVec::eq_dec(k, BitVec::ofNat(0)) {
            Inl(z) => {
                let none: ((t: Nat) → t < 4 → m.key(t) = k → m.key(t) = 0) = λ t t4 a => trans(a, z);
                let absent = m.abs_get_none(k, λ t t4 a => z);
                trans(WordMap::find_absent(m, k, none, word_map_home(k), 4, word_map_home_below(k)), sym(cong_fn(λ (o: Option<u64>) => o.unwrap_or(0), absent)))
            },
            Inr(nz) => {
                let s = found.witness;
                let row: (RowAt(m, k, m.val(s), s)) = RowAt(found.proof.right, nz, refl);
                let some = m.abs_get_at(inv.distinct, k, m.val(s), s, found.proof.left, row);
                trans(WordMap::get_stored(m, inv, k, s, found.proof.left, found.proof.right, nz), sym(cong_fn(λ (o: Option<u64>) => o.unwrap_or(0), some)))
            },
        },
        Inr(nowhere) => {
            let none: ((t: Nat) → t < 4 → m.key(t) = k → m.key(t) = 0) = λ t t4 a => false_elim(nowhere(t, t4, a));
            let absent = m.abs_get_none(k, λ t t4 a => false_elim(nowhere(t, t4, a)));
            trans(WordMap::find_absent(m, k, none, word_map_home(k), 4, word_map_home_below(k)), sym(cong_fn(λ (o: Option<u64>) => o.unwrap_or(0), absent)))
        },
    }
}
// ---------------------------------------------------------------------------
// Counting occupied slots.

// Slot `t` is empty in `m` exactly where it is in `n`.
fn WordMap::SameUse(m, n: WordMap, t: Nat) → Type { And<m.key(t) = 0 → n.key(t) = 0, n.key(t) = 0 → m.key(t) = 0> }

theorem WordMap::used_same(m, n: WordMap, cnt: Nat): (s: Nat) → ((t: Nat) → s <= t → t < s + cnt → WordMap::SameUse(m, n, t)) → n.used(s, cnt) = m.used(s, cnt) {
    match cnt {
        Zero => λ s same => refl,
        Succ(r, ih) => λ s same => {
            let rest = ih(s + 1, λ t lo hi => same(t, omega, omega));
            let here = same(s, omega, omega);
            match BitVec::eq_dec(m.key(s), BitVec::ofNat(0)) as λ d =>
                n.used(s, Succ(r)) = (match d { Inl(_) => m.used(s + 1, r), Inr(_) => m.used(s + 1, r) + 1 })
            {
                Inl(mz) => match BitVec::eq_dec(n.key(s), BitVec::ofNat(0)) as λ d =>
                    (match d { Inl(_) => n.used(s + 1, r), Inr(_) => n.used(s + 1, r) + 1 }) = m.used(s + 1, r)
                {
                    Inl(_) => rest,
                    Inr(nz) => false_elim(nz(here.left(mz))),
                },
                Inr(mnz) => match BitVec::eq_dec(n.key(s), BitVec::ofNat(0)) as λ d =>
                    (match d { Inl(_) => n.used(s + 1, r), Inr(_) => n.used(s + 1, r) + 1 }) = m.used(s + 1, r) + 1
                {
                    Inl(nzero) => false_elim(mnz(here.right(nzero))),
                    Inr(_) => cong_fn(λ (q: Nat) => q + 1, rest),
                },
            }
        },
    }
}

// Filling one empty slot uses one slot more.
theorem WordMap::used_fill(m, n: WordMap, e: Nat, me: m.key(e) = 0, ne: ¬(n.key(e) = 0), cnt: Nat): (s: Nat) → s <= e → e < s + cnt →
    ((t: Nat) → s <= t → t < s + cnt → ¬(t = e) → WordMap::SameUse(m, n, t)) → n.used(s, cnt) = m.used(s, cnt) + 1
{
    match cnt {
        Zero => λ s lo hi same => false_elim(omega),
        Succ(r, ih) => λ s lo hi same => match Nat::eq_dec(s, e) {
            Inl(at) => {
                let rest = WordMap::used_same(m, n, r, s + 1, λ t lo2 hi2 => same(t, omega, omega, λ te => omega(te, lo2, at)));
                let mz: (m.key(s) = 0) = trans(cong_fn(λ (q: Nat) => m.key(q), at), me);
                let nnz: (¬(n.key(s) = 0)) = λ z => ne(trans(cong_fn(λ (q: Nat) => n.key(q), sym(at)), z));
                match BitVec::eq_dec(m.key(s), BitVec::ofNat(0)) as λ d =>
                    n.used(s, Succ(r)) = (match d { Inl(_) => m.used(s + 1, r), Inr(_) => m.used(s + 1, r) + 1 }) + 1
                {
                    Inl(_) => match BitVec::eq_dec(n.key(s), BitVec::ofNat(0)) as λ d =>
                        (match d { Inl(_) => n.used(s + 1, r), Inr(_) => n.used(s + 1, r) + 1 }) = m.used(s + 1, r) + 1
                    {
                        Inl(z) => false_elim(nnz(z)),
                        Inr(_) => cong_fn(λ (q: Nat) => q + 1, rest),
                    },
                    Inr(mnz) => false_elim(mnz(mz)),
                }
            },
            Inr(other) => {
                let rest = ih(s + 1, omega, omega, λ t lo2 hi2 te => same(t, omega, omega, te));
                let here = same(s, omega, omega, other);
                match BitVec::eq_dec(m.key(s), BitVec::ofNat(0)) as λ d =>
                    n.used(s, Succ(r)) = (match d { Inl(_) => m.used(s + 1, r), Inr(_) => m.used(s + 1, r) + 1 }) + 1
                {
                    Inl(mz) => match BitVec::eq_dec(n.key(s), BitVec::ofNat(0)) as λ d =>
                        (match d { Inl(_) => n.used(s + 1, r), Inr(_) => n.used(s + 1, r) + 1 }) = m.used(s + 1, r) + 1
                    {
                        Inl(_) => rest,
                        Inr(nz) => false_elim(nz(here.left(mz))),
                    },
                    Inr(mnz) => match BitVec::eq_dec(n.key(s), BitVec::ofNat(0)) as λ d =>
                        (match d { Inl(_) => n.used(s + 1, r), Inr(_) => n.used(s + 1, r) + 1 }) = m.used(s + 1, r) + 1 + 1
                    {
                        Inl(nzero) => false_elim(mnz(here.right(nzero))),
                        Inr(_) => cong_fn(λ (q: Nat) => q + 1, rest),
                    },
                }
            },
        },
    }
}

// Every slot taken: all are used.
theorem WordMap::used_full(self m: WordMap, cnt: Nat): (s: Nat) → ((t: Nat) → s <= t → t < s + cnt → ¬(m.key(t) = 0)) → m.used(s, cnt) = cnt {
    match cnt {
        Zero => λ s full => refl,
        Succ(r, ih) => λ s full => match BitVec::eq_dec(m.key(s), BitVec::ofNat(0)) as λ d =>
            (match d { Inl(_) => m.used(s + 1, r), Inr(_) => m.used(s + 1, r) + 1 }) = Succ(r)
        {
            Inl(z) => false_elim(full(s, omega, omega, z)),
            Inr(_) => cong_fn(λ (q: Nat) => q + 1, ih(s + 1, λ t lo hi => full(t, omega, omega))),
        },
    }
}

// ---------------------------------------------------------------------------
// Insert, along its probe.

// The table with `k` and `v` put in slot `e`, one more counted.
fn WordMap::filled(self m: WordMap, e: Nat, k, v: u64) → WordMap {
    m with { keys = vector_update(m.keys, e, k), vals = vector_update(m.vals, e, v), count = m.count + 1 }
}

// The table with slot `s`'s value replaced.
fn WordMap::replaced(self m: WordMap, s: Nat, v: u64) → WordMap { m with { vals = vector_update(m.vals, s, v) } }

fn WordMap::Replaces(m: WordMap, k, v: u64, s: Nat, j, left: u64) → Type {
    j.toNat() < 4 → ((s + 4 - j.toNat()) % 4) < left.toNat() →
    ((t: Nat) → t < 4 → ((t + 4 - j.toNat()) % 4) < ((s + 4 - j.toNat()) % 4) → And<¬(m.key(t) = 0), ¬(m.key(t) = k)>) →
    WordMap::insert_at(m, k, v, j, left) = Mutated(m.replaced(s, v), 0)
}

theorem WordMap::replaces_empty(m: WordMap, k, v: u64, s: Nat, s4: s < 4, at: m.key(s) = k, nz: ¬(k = 0), j, left: u64, empty: m.key(j.toNat()) = 0):
    WordMap::Replaces(m, k, v, s, j, left)
{
    λ j4 budget clear => match Nat::eq_dec(j.toNat(), s) {
        Inl(same) => false_elim(nz(trans(sym(at), trans(cong_fn(λ (q: Nat) => m.key(q), sym(same)), empty)))),
        Inr(other) => match clear(j.toNat(), j4, omega) { And(occupied, _) => false_elim(occupied(empty)) },
    }
}

theorem WordMap::replaces_hit(m: WordMap, k, v: u64, s: Nat, s4: s < 4, j, left: u64, hit: m.key(j.toNat()) = k,
    eq: WordMap::insert_at(m, k, v, j, left) = Mutated(m.replaced(j.toNat(), v), 0)): WordMap::Replaces(m, k, v, s, j, left)
{
    λ j4 budget clear => trans(eq, match Nat::eq_dec(j.toNat(), s) {
        Inl(same) => cong_fn(λ (q: Nat) => Mutated(m.replaced(q, v), 0), same),
        Inr(other) => match clear(j.toNat(), j4, omega) { And(_, other) => false_elim(other(hit)) },
    })
}

theorem WordMap::replaces_next(m: WordMap, k, v: u64, s: Nat, s4: s < 4, at: m.key(s) = k, j, left: u64, more: 0 < left, hit: ¬(m.key(j.toNat()) = k),
    eq: WordMap::insert_at(m, k, v, j, left) = WordMap::insert_at(m, k, v, (j + 1).band(3), left - 1), ih: WordMap::Replaces(m, k, v, s, (j + 1).band(3), left - 1)):
    WordMap::Replaces(m, k, v, s, j, left)
{
    λ j4 budget clear => {
        let nj = WordMap::next_slot(j, j4);
        let dl: ((left - 1).toNat() = left.toNat() - 1) = bv_omega;
        let other: (¬(j.toNat() = s)) = λ e => hit(trans(cong_fn(λ (q: Nat) => m.key(q), e), at));
        trans(eq, ih(omega(nj), WordMap::step_budget(j.toNat(), s, ((j + 1).band(3)).toNat(), left.toNat(), (left - 1).toNat(), j4, s4, nj, dl, other, budget),
            λ t t4 before => clear(t, t4, WordMap::step_before(j.toNat(), s, t, ((j + 1).band(3)).toNat(), j4, s4, t4, nj, other, before))))
    }
}

// An insert of a stored key replaces its value where it is.
theorem WordMap::insert_replaces(m: WordMap, k, v: u64, s: Nat, s4: s < 4, at: m.key(s) = k, nz: ¬(k = 0), j, left: u64): WordMap::Replaces(m, k, v, s, j, left) {
    WordMap::insert_at::induct(m, k, v, λ (j: u64) (left: u64) => WordMap::Replaces(m, k, v, s, j, left),
        λ j left more lt empty room eq => WordMap::replaces_empty(m, k, v, s, s4, at, nz, j, left, empty),
        λ j left more lt empty room eq => WordMap::replaces_empty(m, k, v, s, s4, at, nz, j, left, empty),
        λ j left more lt empty hit eq => WordMap::replaces_hit(m, k, v, s, s4, j, left, hit, eq),
        λ j left more lt empty hit eq ih => WordMap::replaces_next(m, k, v, s, s4, at, j, left, more, hit, eq, ih),
        λ j left more lt eq => λ j4 budget clear => false_elim(lt(j4)),
        λ j left more eq => λ j4 budget clear => false_elim(omega(more, budget)),
        j, left)
}

// Slot `e`, empty, is the first empty one a probe from `j0` meets.
record FirstEmpty(m: WordMap, j0, e: Nat) {
    inside: e < 4,
    empty: m.key(e) = 0,
    path: (t: Nat) → t < 4 → ((t + 4 - j0) % 4) < ((e + 4 - j0) % 4) → ¬(m.key(t) = 0),
}

fn WordMap::Adds(m: WordMap, k, v: u64, j, left: u64) → Type {
    j.toNat() < 4 → Exists(λ (e: Nat) => And<e < 4, And<m.key(e) = 0, ((e + 4 - j.toNat()) % 4) < left.toNat()>>) →
    Or<Exists<Nat>(λ (e: Nat) => And<FirstEmpty(m, j.toNat(), e), And<m.count.toNat() < 3, WordMap::insert_at(m, k, v, j, left) = Mutated(m.filled(e, k, v), 1)>>),
       And<¬(m.count.toNat() < 3), WordMap::insert_at(m, k, v, j, left) = Mutated(m, 2)>>
}

theorem WordMap::adds_room(m: WordMap, k, v: u64, j, left: u64, empty: m.key(j.toNat()) = 0, room: m.count.toNat() < 3,
    eq: WordMap::insert_at(m, k, v, j, left) = Mutated(m.filled(j.toNat(), k, v), 1)): WordMap::Adds(m, k, v, j, left)
{
    λ j4 spare => Inl(Exists(j.toNat(), And(FirstEmpty(j4, empty, λ t t4 before => false_elim(omega(before, j4))), And(room, eq))))
}

theorem WordMap::adds_next(m: WordMap, k, v: u64, j, left: u64, more: 0 < left, empty: ¬(m.key(j.toNat()) = 0),
    eq: WordMap::insert_at(m, k, v, j, left) = WordMap::insert_at(m, k, v, (j + 1).band(3), left - 1), ih: WordMap::Adds(m, k, v, (j + 1).band(3), left - 1)):
    WordMap::Adds(m, k, v, j, left)
{
    λ j4 spare => {
        let nj = WordMap::next_slot(j, j4);
        let dl: ((left - 1).toNat() = left.toNat() - 1) = bv_omega;
        let e = spare.witness;
        let other: (¬(j.toNat() = e)) = λ same => empty(trans(cong_fn(λ (q: Nat) => m.key(q), same), spare.proof.right.left));
        let closer = WordMap::step_budget(j.toNat(), e, ((j + 1).band(3)).toNat(), left.toNat(), (left - 1).toNat(), j4, spare.proof.left, nj, dl, other, spare.proof.right.right);
        match ih(omega(nj), Exists(e, And(spare.proof.left, And(spare.proof.right.left, closer)))) {
            Inl(found) => {
                let f = found.proof.left;
                let further: (¬(j.toNat() = found.witness)) = λ same => empty(trans(cong_fn(λ (q: Nat) => m.key(q), same), f.empty));
                Inl(Exists(found.witness, And(FirstEmpty(f.inside, f.empty, λ t t4 before => match Nat::eq_dec(t, j.toNat()) {
                    Inl(here) => λ z => empty(trans(cong_fn(λ (q: Nat) => m.key(q), sym(here)), z)),
                    Inr(away) => f.path(t, t4, WordMap::step_before_back(j.toNat(), found.witness, t, ((j + 1).band(3)).toNat(), j4, f.inside, t4, nj, further, away, before)),
                }), And(found.proof.right.left, trans(eq, found.proof.right.right)))))
            },
            Inr(full) => Inr(And(full.left, trans(eq, full.right))),
        }
    }
}

// An insert of a key no slot holds fills the first empty slot of its probe,
// or answers full and leaves the table.
theorem WordMap::insert_adds(m: WordMap, k, v: u64, none: (t: Nat) → t < 4 → ¬(m.key(t) = k), j, left: u64): WordMap::Adds(m, k, v, j, left) {
    WordMap::insert_at::induct(m, k, v, λ (j: u64) (left: u64) => WordMap::Adds(m, k, v, j, left),
        λ j left more lt empty room eq => WordMap::adds_room(m, k, v, j, left, empty, room, eq),
        λ j left more lt empty room eq => λ j4 spare => Inr(And(room, eq)),
        λ j left more lt empty hit eq => λ j4 spare => false_elim(none(j.toNat(), j4, hit)),
        λ j left more lt empty hit eq ih => WordMap::adds_next(m, k, v, j, left, more, empty, eq, ih),
        λ j left more lt eq => λ j4 spare => false_elim(lt(j4)),
        λ j left more eq => λ j4 spare => false_elim(omega(more, spare.proof.right.right)),
        j, left)
}

// Reads of the slots after an insert.
theorem WordMap::filled_key_same(m: WordMap, e: Nat, k, v: u64, inside: e < 4): m.filled(e, k, v).key(e) = k {
    vector_get_update_same(4, m.keys, e, k, BitVec::ofNat(0), inside)
}

theorem WordMap::filled_key_other(m: WordMap, e: Nat, k, v: u64, t: Nat, other: ¬(t = e)): m.filled(e, k, v).key(t) = m.key(t) {
    vector_get_update_other(4, m.keys, e, t, k, BitVec::ofNat(0), other)
}

theorem WordMap::filled_val_same(m: WordMap, e: Nat, k, v: u64, inside: e < 4): m.filled(e, k, v).val(e) = v {
    vector_get_update_same(4, m.vals, e, v, BitVec::ofNat(0), inside)
}

theorem WordMap::filled_val_other(m: WordMap, e: Nat, k, v: u64, t: Nat, other: ¬(t = e)): m.filled(e, k, v).val(t) = m.val(t) {
    vector_get_update_other(4, m.vals, e, t, v, BitVec::ofNat(0), other)
}

theorem WordMap::replaced_val_same(m: WordMap, s: Nat, v: u64, inside: s < 4): m.replaced(s, v).val(s) = v {
    vector_get_update_same(4, m.vals, s, v, BitVec::ofNat(0), inside)
}

theorem WordMap::replaced_val_other(m: WordMap, s: Nat, v: u64, t: Nat, other: ¬(t = s)): m.replaced(s, v).val(t) = m.val(t) {
    vector_get_update_other(4, m.vals, s, t, v, BitVec::ofNat(0), other)
}

// A table that keeps the invariant has an empty slot.
theorem WordMap::spare(m: WordMap, inv: WordMapInv(m)): Exists(λ (e: Nat) => And<e < 4, m.key(e) = 0>) {
    match m.locate(BitVec::ofNat(0)) {
        Inl(found) => found,
        Inr(none) => {
            let all = m.used_full(4, 0, λ t lo hi => none(t, omega));
            false_elim(omega(inv.count, inv.room, all))
        },
    }
}

// An insert is the probe from the key's home slot.
theorem WordMap::mutated_eta(r: Mutated<WordMap, u64>): Mutated(r.after, r.value) = r { refl }

theorem WordMap::insert_is(m: WordMap, k, v: u64): WordMap::insert(m, k, v) = WordMap::insert_at(m, k, v, word_map_home(k), 4) {
    WordMap::mutated_eta(WordMap::insert_at(m, k, v, word_map_home(k), 4))
}

// What an insert did.
inductive Inserted(m: WordMap, k, v: u64) {
    Replaced(s: Nat, inside: s < 4, at: m.key(s) = k, eq: WordMap::insert(m, k, v) = Mutated(m.replaced(s, v), 0)),
    Added(e: Nat, first: FirstEmpty(m, word_map_home(k).toNat(), e), room: m.count.toNat() < 3, none: (t: Nat) → t < 4 → ¬(m.key(t) = k),
        eq: WordMap::insert(m, k, v) = Mutated(m.filled(e, k, v), 1)),
    Full(full: ¬(m.count.toNat() < 3), eq: WordMap::insert(m, k, v) = Mutated(m, 2)),
}

theorem WordMap::insert_cases(m: WordMap, inv: WordMapInv(m), k, v: u64, nz: ¬(k = 0)): Inserted(m, k, v) {
    let h = word_map_home(k);
    let h4: (h.toNat() < 4) = word_map_home_below(k);
    match m.locate(k) {
        Inl(found) => {
            let s = found.witness;
            let s4 = found.proof.left;
            let at = found.proof.right;
            let clear: ((t: Nat) → t < 4 → ((t + 4 - h.toNat()) % 4) < ((s + 4 - h.toNat()) % 4) → And<¬(m.key(t) = 0), ¬(m.key(t) = k)>) =
                λ t t4 before => And(inv.reach(s, t, k, s4, t4, at, nz, before), λ again =>
                    WordMap::not_before_self(t, s, h.toNat(), inv.distinct(t, s, t4, s4, λ z => nz(trans(sym(again), z)), trans(again, sym(at))), before));
            Replaced(s, s4, at, trans(WordMap::insert_is(m, k, v), WordMap::insert_replaces(m, k, v, s, s4, at, nz, h, 4, h4, omega(s4, h4), clear)))
        },
        Inr(none) => {
            let spare = WordMap::spare(m, inv);
            let close: (((spare.witness + 4 - h.toNat()) % 4) < (4: u64).toNat()) = omega(spare.proof.left, h4);
            match WordMap::insert_adds(m, k, v, none, h, 4, h4, Exists(spare.witness, And(spare.proof.left, And(spare.proof.right, close)))) {
                Inl(added) => Added(added.witness, added.proof.left, added.proof.right.left, none, trans(WordMap::insert_is(m, k, v), added.proof.right.right)),
                Inr(full) => Full(full.left, trans(WordMap::insert_is(m, k, v), full.right)),
            }
        },
    }
}

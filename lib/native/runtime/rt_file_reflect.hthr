// The reflector for functions that write a span: a function from a span's
// bytes to `Mutated<List<BitVec(8)>, R>`, read from its elaborated body as
// an `FFun` (docs/native/native-one-compiler-design.md §2.6, U4 step 4c-3).
//
// The source is the kernel type a `mut self` method on the bytes has:
// `fn List::m(mut self span: List<BitVec(8)>, length: BitVec(64), …) → R`,
// or the same function written out, returning `Mutated(span, value)`
// itself (a loop is written that way: `decreases` does not cover a `self`
// parameter yet, issues/decreases-self-parameter.md). The span comes
// first, then its 64-bit length word, as a lent span does; the code takes
// two words for the pair.
//
// A body threads its span through stores (`span.put_within(length, i, v)`
// or `span.with_byte_within(length, i, v)`) and through calls of other
// such functions, whose `.after` is the span the next step takes and whose
// `.value` is the word the call returned. A call may also be over windows:
// `callee(span.window(a.toNat(), b.toNat()), b.sub(a), …)`, each span of
// the callee a window of one of this function's and the word after it the
// window's length, with what the callee wrote put back
// (`span.put_window(a.toNat(), r.after)`); a window from the span's first
// byte is `span.window(0, n.toNat())` with `n` after it, put back at 0. It
// ends in `Mutated(span,
// value)`, in a `match` on a `Bool` whose arms end so, or, in a function
// that `decreases`, in its own call. The reflector:
//
// 1. reads the chain of stores and calls from an end's span back to the
//    parameter, which gives their order (`rt_file_chain`);
// 2. reflects each one's operands as pure `rt` at the span as it is then
//    (`rt_go`, the pure walk, with the span now for `byte_within`), binds
//    them with `Let`s, and emits the `Put` or the `Call`;
// 3. reads a later `.value` of a call as the variable its `Call` or its
//    `Lend` bound;
// 4. reads a byte of the span as it was before a link, used after it, as
//    the variable it was bound to before that link: the path's later
//    steps are scanned for such reads first, and each is bound where its
//    state ends (`rt_file_plan`, `rt_file_hoist`);
// 5. refuses a read of the span as it was at an index known only after
//    the link, the span used as a value, and a span that branches and
//    joins again (a statement `if` that stores, with code after it): an
//    `FTm` cannot name any of them.
//
// Untrusted like every producer: the pin of the reflection's meaning to
// the function is what a `runtime fn` publishes, and a wrong reflection
// fails it.
import logic;
import bool;
import nat;
import list;
import list_window;
import option;
import pair;
import char;
import string;
import tactic;
import bitvec;
import rt;
import rt_file;
import rt_reflect;

// The globals the walk knows by name: the record a body ends in, and the
// two spellings of a store, a window and its putting back. The last two
// are absent where the body's module does not import `list_window`: it
// then writes no window, and none is read.
record FileNames { mutated: Nat, put: Nat, with_byte: Nat, window: Option<Nat>, put_window: Option<Nat>, bytes: Option<Nat>, bytes_put: Option<Nat> }

fn rt_global_here(name: String) → Tac<Option<Nat>> {
    lookup(name).bind(λ c => match c { Accepted(g) => pure(Some(g.id)), Refused(_) => pure(None) })
}

fn FileNames::names(at: Option<Nat>, g: Nat) → Bool { match at { None => False, Some(n) => n.same(g) } }

fn rt_file_names() → Tac<FileNames> {
    let mutated <- rt_global("Mutated");
    let put <- rt_global(name_of(List::put_within));
    let with_byte <- rt_global(name_of(List::with_byte_within));
    let window <- rt_global_here(name_of(List::window));
    let put_window <- rt_global_here(name_of(List::put_window));
    // `Bytes(n)` and its store, where the module imports `bytes`: a
    // function of a `Bytes(n)` is read as one of its bytes and `n`.
    let bytes <- rt_global_here("bytes::Bytes");
    let bytes_put <- rt_global_here("bytes::Bytes::put");
    pure(FileNames(mutated, put, with_byte, window, put_window, bytes, bytes_put))
}

// ---------------------------------------------------------------------------
// The walk

// A computation read so far, the most recent step first: a pure value
// bound, a store, a call that writes, or one over windows. Operands are
// indices at the depth the step is emitted at.
inductive FSeg {
    FLet(e: Tm),
    FPut(i: Nat, length: Nat, v: Nat),
    FCall(f: Nat, args: List<Nat>),
    FLend(f: Nat, views: List<FView>, args: List<Nat>),
}

fn FSeg::close(segs: List<FSeg>, last: FTm) → FTm {
    segs.foldl(λ acc s => match s {
        FLet(e) => FTm::Let(e, acc),
        FPut(i, length, v) => FTm::Put(i, length, v, acc),
        FCall(f, args) => FTm::Call(f, args, acc),
        FLend(f, views, args) => FTm::Lend(f, views, args, acc),
    }, last)
}

fn FSeg::lets(lets: List<Tm>) → List<FSeg> { lets.map(λ e => FLet(e)) }

// Pure code read at the span as it is now. A self-call is not pure code:
// the walk reads it itself, where a body ends.
fn Known::at_file(self k: Known, fk: FileKnown) → Known {
    Known(k.prims, k.funs, k.recs, k.discover, k.bitvec, k.boolean, k.list, k.io, k.nat, None, k.reprs, k.lent, Some(fk), k.named, k.consts, k.payloads)
}

// The values numbered so far that still stand after the span is written:
// a read of the span and a call (whose callee may read it) are made again.
fn RSt::written(self st: RSt, depth: Nat) → RSt {
    RSt(depth, [], st.memo.filter(λ p => match p.fst { Byte(_, _, _) => False, Call(_, _) => False, Fold(_, _, _) => False, _ => True }),
        st.handles, st.locals, st.funs)
}

// `done` counts the links of the chain walked so far; `cfuns` is the
// program's computations so far, a `Call`'s index.
record FWalk { st: RSt, segs: List<FSeg>, fk: FileKnown, done: Nat, cfuns: List<Nat> }

// The length a `Bytes(n)` is of, read off the type of `h`.
fn rt_file_bytes_n(names: FileNames, h: Handle) → Tac<Option<Handle>> {
    match names.bytes {
        None => pure(None),
        Some(bt) => infer(Hd(h)).bind(λ c => match c {
            Refused(_) => pure(None),
            Accepted(t) => view(t).bind(λ tv => match tv {
                HGlobal(tg, _, targs) => match tg.id.same(bt) {
                    True => match targs { Cons(n, _) => pure(Some(n)), Nil => pure(None) },
                    False => pure(None),
                },
                _ => pure(None),
            }),
        }),
    }
}

// A call's arguments from the span it threads: a lifted loop over a
// `Bytes(n)` takes `n` before the record, as a capture
// (crates/elab/src/loops.rs, `implicit_captures`), and the record's type
// says it again.
fn rt_file_threaded(names: FileNames, args: List<Handle>) → Tac<List<Handle>> {
    match args {
        Cons(_, more) => match more {
            Cons(a1, _) => rt_file_bytes_n(names, a1).bind(λ o => match o { Some(_) => pure(more), None => pure(args) }),
            Nil => pure(args),
        },
        Nil => pure(args),
    }
}

// The stores and calls a span has been through, the first first: the
// parameter has been through none.
fn rt_file_chain(fuel: Nat, names: FileNames, span: Nat, h: Handle) → Tac<List<Handle>> {
    match fuel {
        Zero => rt_refuse("the span's chain of stores is longer than the reflector's fuel"),
        Succ(f) => view(h).bind(λ v => match v {
            HLocal(x, _) => match x.id.same(span) {
                True => pure([]),
                False => rt_refuse("a span that is not the function's own"),
            },
            HField(c, name, _) => match Known::str_same(name, "after") {
                True => view(c).bind(λ cv => match cv {
                    HGlobal(_, cname, args) => rt_file_threaded(names, args).bind(λ targs => match targs {
                        Cons(prev, _) => rt_file_chain(f, names, span, prev).bind(λ ls => pure(ls ++ [h])),
                        Nil => rt_refuse("`" ++ cname ++ "` without its span"),
                    }),
                    _ => rt_refuse("the span after something other than a call"),
                }),
                False => rt_refuse("a span read out of a record (`." ++ name ++ "`)"),
            },
            HGlobal(g, name, args) => match g.id.same(names.with_byte).or(FileNames::names(names.bytes_put, g.id)) {
                True => match args {
                    Cons(prev, _) => rt_file_chain(f, names, span, prev).bind(λ ls => pure(ls ++ [h])),
                    Nil => rt_refuse("`" ++ name ++ "` without its span"),
                },
                False => match FileNames::names(names.put_window, g.id) {
                    True => match args.rev() {
                        Cons(_, Cons(_, Cons(prev, _))) => rt_file_chain(f, names, span, prev).bind(λ ls => pure(ls ++ [h])),
                        _ => rt_refuse("`" ++ name ++ "` without its span, start and part"),
                    },
                    False => rt_refuse("`" ++ name ++ "` makes a span the reflector does not know: a store is `put_within` or `with_byte_within`, a call that writes hands its span on as `.after`, and a call over a window has its part put back by `put_window`"),
                },
            },
            HMatch(_) => rt_refuse("the span through a branch that joins again (an `if` that stores, with code after it) is not reflected yet: end each arm in its own result"),
            _ => rt_refuse("a span that is not the function's own, threaded through stores and calls"),
        }),
    }
}

// The links between the span as it is now and `target`.
fn rt_file_links(fuel: Nat, names: FileNames, w: FWalk, target: Handle) → Tac<List<Handle>> {
    let chain <- rt_file_chain(fuel, names, w.fk.span, target);
    match w.done {
        Zero => pure(chain),
        Succ(d) => match chain.nth(d) {
            None => rt_old_span(),
            Some(link) => rt_same_span(w.fk, link).bind(λ same => match same { True => pure(chain.drop(w.done)), False => rt_old_span() }),
        },
    }
}

fn rt_file_length<A>(what: String) → Tac<A> {
    rt_refuse(what ++ " under a word that is not the span's own length parameter")
}

// A store: its index and its byte as variables, read before it.
fn rt_file_store(fuel: Nat, k: Known, w: FWalk, link: Handle, ops: List<Handle>) → Tac<FWalk> {
    match ops.take(3) {
        Cons(length, Cons(i, Cons(v, Nil))) => {
            let kk = k.at_file(w.fk);
            let rl <- rt_go(fuel, kk, w.st, length, True);
            match RSt::level(rl.snd).same(1) {
                False => rt_file_length("a store"),
                True => {
                    let ri <- rt_go(fuel, kk, rl.fst, i, True);
                    let rv <- rt_go(fuel, kk, ri.fst, v, True);
                    let st = rv.fst;
                    pure(FWalk(st.written(st.depth),
                        Cons(FPut(st.index(RSt::level(ri.snd)), st.index(1), st.index(RSt::level(rv.snd))), FSeg::lets(st.lets) ++ w.segs),
                        w.fk.past(link, w.fk.calls), w.done + 1, w.cfuns))
                },
            }
        },
        _ => rt_refuse("a store without its length word, index and byte"),
    }
}

// The function of a laid record that `g` is the function over the span
// of (`T::m::bytes`, published as `HWorld::of_record(T::m, …)`), by the
// name its tables and instance are published under.
fn rt_record_of(g: GlobalRef) → Tac<Option<String>> {
    body(g).bind(λ c => match c {
        Refused(_) => pure(None),
        Accepted(b) => view(b).bind(λ v => match v {
            HGlobal(_, n, args) => match Known::str_same(rt_base_name(n), "of_record") {
                False => pure(None),
                True => match args {
                    Cons(source, _) => view(source).bind(λ sv => match sv {
                        HGlobal(sg, shown, _) => rt_name_of(sg, shown).bind(λ name => pure(Some(name))),
                        _ => pure(None),
                    }),
                    Nil => pure(None),
                },
            },
            _ => pure(None),
        }),
    })
}

// The code a called function of a `Bytes(n)` is compiled as: the function
// of its bytes and `n` that its reflection writes out (`f::bytes`,
// published as `HWorld::of_record(f, …)`), as the program's tables name it.
fn rt_file_code_of(g: GlobalRef, name: String) → Tac<GlobalRef> {
    let n <- rt_name_of(g, name);
    let found <- lookup(n ++ "::bytes");
    match found {
        Refused(_) => pure(g),
        Accepted(code) => rt_record_of(code).bind(λ source => match source {
            Some(s) => match Known::str_same(s, n) { True => pure(code), False => pure(g) },
            None => pure(g),
        }),
    }
}

// The program index of a called computation: its place among those so far
// or, in the generator's mode, a runtime fn not met before, appended.
fn rt_file_callee(k: Known, cfuns: List<Nat>, called: GlobalRef, name: String) → Tac<Pair<List<Nat>, Nat>> {
    let g <- rt_file_code_of(called, name);
    match Known::index(cfuns, g.id, 0) {
        Some(i) => pure(Pair(cfuns, i)),
        None => match k.discover {
            False => rt_refuse("`" ++ name ++ "` writes the span and is not a computation of the program"),
            True => rt_name_of(g, name).bind(λ n => lookup(n ++ "::rt")).bind(λ c => match c {
                Accepted(_) => pure(Pair(cfuns ++ [g.id], cfuns.len())),
                // The code of a function of a laid record, called by the
                // name it is published under (`T::m::bytes`): a computation
                // of the program as a `runtime fn` over a span is.
                Refused(_) => rt_record_of(g).bind(λ source => match source {
                    Some(_) => pure(Pair(cfuns ++ [g.id], cfuns.len())),
                    None => rt_refuse("`" ++ name ++ "` writes the span and is an ordinary fn: mark it `runtime fn`"),
                }),
            }),
        },
    }
}

// A call of a computation: it is handed the span as it is and the span's
// length word, then the spans it only reads, each passed on as it came in
// with its length word (`rt_lent_args`), then its own words (and not the
// facts after them, `rt_data_args`); its word is bound for what follows.
fn rt_file_call(fuel: Nat, k: Known, w: FWalk, link: Handle, c: Handle, g: GlobalRef, name: String, ops: List<Handle>) → Tac<FWalk> {
    match ops {
        Cons(length, rest) => {
            let found <- rt_file_callee(k, w.cfuns, g, name);
            let kk = k.at_file(w.fk);
            // The facts the callee takes after its words are not passed.
            let rest <- rt_data_args(rest);
            let rl <- rt_go(fuel, kk, w.st, length, True);
            match RSt::level(rl.snd).same(1) {
                False => rt_file_length("a call that writes"),
                True => {
                    let reads <- rt_call_lent(64, kk, rest);
                    let r <- rt_lent_args(λ s a => rt_go(fuel, kk, s, a, True), kk, rl.fst, 1, reads, rest);
                    let st = r.fst;
                    pure(FWalk(st.written(st.depth + 1),
                        Cons(FCall(found.snd, Cons(st.index(0), Cons(st.index(1), st.indices(r.snd)))), FSeg::lets(st.lets) ++ w.segs),
                        w.fk.past(link, w.fk.calls ++ [CallRes(w.fk.calls.len(), g.id, c, Some(st.depth), [])]),
                        w.done + 1, found.fst))
                },
            }
        },
        Nil => rt_refuse("`" ++ name ++ "` without its span's length word"),
    }
}

// ---------------------------------------------------------------------------
// A call over windows

// A window as the walk reads it: the function's span it is of and its
// bounds, as levels (`start` is absent for a window from the first byte).
record LentView { span: Nat, start: Option<Nat>, end: Nat }

fn LentView::views(st: RSt, vs: List<LentView>) → List<FView> {
    vs.map(λ v => FView(v.span, st.index(v.span + v.span), v.start.map(λ s => st.index(s)), st.index(v.end)))
}

fn rt_file_bounds<A>() → Tac<A> {
    rt_refuse("a window's bounds are `x.toNat()` of 64-bit words (the code compares and passes the words), or the literal 0 for its start")
}

// A window's bound: `x.toNat()` of a 64-bit word, as that word's variable.
fn rt_file_bound(fuel: Nat, k: Known, st: RSt, h: Handle) → Tac<Pair<RSt, Nat>> {
    view(h).bind(λ v => match v {
        HGlobal(g, _, args) => match Known::prim(k.prims, g.id) {
            Some(p) => match p {
                PToNat => match args {
                    Cons(x, _) => k.ty_of(x).bind(λ t => match t {
                        Word(n) => match n.same(64) {
                            True => rt_go(fuel, k, st, x, True).bind(λ r => pure(Pair(r.fst, RSt::level(r.snd)))),
                            False => rt_file_bounds(),
                        },
                        _ => rt_file_bounds(),
                    }),
                    Nil => rt_file_bounds(),
                },
                _ => rt_file_bounds(),
            },
            None => rt_file_bounds(),
        },
        _ => rt_file_bounds(),
    })
}

// A window's start: a bound, or the literal 0.
fn rt_file_start(fuel: Nat, k: Known, st: RSt, h: Handle) → Tac<Pair<RSt, Option<Nat>>> {
    view(h).bind(λ v => match v {
        HLit(n) => match n { Zero => pure(Pair(st, None)), Succ(_) => rt_file_bounds() },
        _ => rt_file_bound(fuel, k, st, h).bind(λ r => pure(Pair(r.fst, Some(r.snd)))),
    })
}

fn rt_file_size<A>() → Tac<A> {
    rt_refuse("the word after a window is the window's length: `end.sub(start)` of the words its bounds are, or the end's word itself for a window from 0")
}

// The word after a window, held to the window's bounds. Nothing is bound
// for it: the code passes the length it computes from the bounds.
fn rt_file_sized(fuel: Nat, k: Known, st: RSt, length: Handle, start: Option<Nat>, end: Nat) → Tac<RSt> {
    match start {
        None => rt_go(fuel, k, st, length, True).bind(λ r => match RSt::level(r.snd).same(end) { True => pure(r.fst), False => rt_file_size() }),
        Some(s) => view(length).bind(λ v => match v {
            HGlobal(g, _, args) => match Known::prim(k.prims, g.id) {
                Some(p) => match p {
                    PWord(op) => match op.same(1) {
                        False => rt_file_size(),
                        True => match args {
                            Cons(a, Cons(b, Nil)) => rt_go(fuel, k, st, a, True).bind(λ ra => rt_go(fuel, k, ra.fst, b, True).bind(λ rb =>
                                match RSt::level(ra.snd).same(end).and(RSt::level(rb.snd).same(s)) { True => pure(rb.fst), False => rt_file_size() })),
                            _ => rt_file_size(),
                        },
                    },
                    _ => rt_file_size(),
                },
                None => rt_file_size(),
            },
            _ => rt_file_size(),
        }),
    }
}

// The span a window is of: the written span as it is now for the callee's
// first, a span this function only reads for the ones after it.
fn rt_file_viewed(k: Known, fk: FileKnown, st: RSt, j: Nat, xs: Handle) → Tac<Nat> {
    match j {
        Zero => rt_same_span(fk, xs).bind(λ same => match same {
            True => pure(0),
            False => rt_refuse("the first window of a call over windows is of the span this function writes, as it is now: the callee writes its first span"),
        }),
        Succ(_) => rt_span(k, st, xs).bind(λ n => match n {
            Zero => rt_refuse("a window to read of the span the call writes: a view to write is the only view of its span (issues/views-of-one-buffer-apart.md)"),
            Succ(m) => pure(m + 1),
        }),
    }
}

fn rt_file_windows<A>() → Tac<A> {
    rt_refuse("a call whose part is put back by `put_window` takes each of its spans as a window (`span.window(a.toNat(), b.toNat())`) with the window's length word after it")
}

// The `n` windows a call over windows starts with, and its arguments after
// them.
fn rt_file_views(fuel: Nat, k: Known, names: FileNames, fk: FileKnown, st: RSt, j, n: Nat, args: List<Handle>)
    → Tac<Pair<Pair<RSt, List<LentView>>, List<Handle>>> {
    match n {
        Zero => pure(Pair(Pair(st, []), args)),
        Succ(m) => match args {
            Cons(bytes, Cons(length, rest)) => view(bytes).bind(λ v => match v {
                HGlobal(g, _, wargs) => match FileNames::names(names.window, g.id) {
                    False => rt_file_windows(),
                    True => match wargs.rev() {
                        Cons(end, Cons(start, Cons(xs, _))) => {
                            let span <- rt_file_viewed(k, fk, st, j, xs);
                            let rs <- rt_file_start(fuel, k, st, start);
                            let re <- rt_file_bound(fuel, k, rs.fst, end);
                            let sized <- rt_file_sized(fuel, k, re.fst, length, rs.snd, re.snd);
                            let more <- rt_file_views(fuel, k, names, fk, sized, j + 1, m, rest);
                            pure(Pair(Pair(more.fst.fst, Cons(LentView(span, rs.snd, re.snd), more.fst.snd)), more.snd))
                        },
                        _ => rt_file_windows(),
                    },
                },
                _ => rt_file_windows(),
            }),
            _ => rt_file_windows(),
        },
    }
}

fn rt_file_parts<A>() → Tac<A> {
    rt_refuse("`put_window` puts back what a call over windows wrote: `span.put_window(a.toNat(), r.after)` where `r` is the call and `a` its first window's start")
}

fn LentView::starts(self v: LentView, at: Option<Nat>) → Bool {
    match v.start {
        None => match at { None => True, Some(_) => False },
        Some(s) => match at { None => False, Some(a) => s.same(a) },
    }
}

// A call over windows, read from the `put_window` that puts its part
// back: `span.put_window(at, c.after)` with `c` the call.
fn rt_file_lend(fuel: Nat, k: Known, names: FileNames, w: FWalk, link: Handle, args: List<Handle>) → Tac<FWalk> {
    match args.rev() {
        Cons(part, Cons(at, _)) => view(part).bind(λ pv => match pv {
            HField(c, field, _) => match Known::str_same(field, "after") {
                False => rt_file_parts(),
                True => view(c).bind(λ cv => match cv {
                    HGlobal(g, name, cargs) => {
                        let found <- rt_file_callee(k, w.cfuns, g, name);
                        let kk = k.at_file(w.fk);
                        let n <- rt_call_lent(64, kk, cargs);
                        let vs <- rt_file_views(fuel, kk, names, w.fk, w.st, 0, n, cargs);
                        match vs.fst.snd {
                            Nil => rt_file_windows(),
                            Cons(own, _) => {
                                let ra <- rt_file_start(fuel, kk, vs.fst.fst, at);
                                match own.starts(ra.snd) {
                                    False => rt_file_parts(),
                                    True => {
                                        let r <- RSt::operands(λ s a => rt_go(fuel, kk, s, a, True), ra.fst, vs.snd);
                                        let st = r.fst;
                                        pure(FWalk(st.written(st.depth + 1),
                                            Cons(FLend(found.snd, LentView::views(st, vs.fst.snd), st.indices(r.snd)), FSeg::lets(st.lets) ++ w.segs),
                                            w.fk.past(link, w.fk.calls ++ [CallRes(w.fk.calls.len(), g.id, c, Some(st.depth), [])]),
                                            w.done + 1, found.fst))
                                    },
                                }
                            },
                        }
                    },
                    _ => rt_file_parts(),
                }),
            },
            _ => rt_file_parts(),
        }),
        _ => rt_file_parts(),
    }
}

// The operands of a store or a call after the span it threads: its
// length word, then the rest. A `Bytes(n)`'s length word is `n`, read off
// its type, and a store of one is `s.put(i, v)`, its proof not read.
fn rt_file_ops(names: FileNames, args: List<Handle>) → Tac<List<Handle>> {
    match args {
        Nil => pure([]),
        Cons(a0, rest) => match names.bytes {
            None => pure(rest),
            Some(bt) => infer(Hd(a0)).bind(λ c => match c {
                Refused(_) => pure(rest),
                Accepted(t) => view(t).bind(λ tv => match tv {
                    HGlobal(tg, _, targs) => match tg.id.same(bt) {
                        True => match targs { Cons(n, _) => pure(Cons(n, rest)), Nil => pure(rest) },
                        False => pure(rest),
                    },
                    _ => pure(rest),
                }),
            }),
        },
    }
}

fn rt_file_link(fuel: Nat, k: Known, names: FileNames, w: FWalk, link: Handle) → Tac<FWalk> {
    let v <- view(link);
    match v {
        HGlobal(g, _, args) => match FileNames::names(names.put_window, g.id) {
            True => rt_file_lend(fuel, k, names, w, link, args),
            False => rt_file_ops(names, args).bind(λ ops => rt_file_store(fuel, k, w, link, ops)),
        },
        HField(c, _, _) => view(c).bind(λ cv => match cv {
            HGlobal(g, name, args) => match g.id.same(names.put) {
                True => rt_file_store(fuel, k, w, link, args.drop(1)),
                False => rt_file_threaded(names, args).bind(λ targs => rt_file_ops(names, targs)).bind(λ ops => rt_file_call(fuel, k, w, link, c, g, name, ops)),
            },
            _ => rt_refuse("the span after something other than a call"),
        }),
        _ => rt_refuse("a span that is not the function's own, threaded through stores and calls"),
    }
}

// ---------------------------------------------------------------------------
// A byte read before a store and used after it

// A `let` is an alias, so a byte read before a store and used after it is
// read where it is used: `byte_within(span₀, …)` after the store, a read
// of the span as it was, which no `FTm` names. A path's links and the
// values after them are all in hand at its end (`rt_file_upto`), so the
// walk first finds the reads of a state that a step after that state
// reads (`rt_file_plan`), binds each before the link that ends its state
// (`rt_file_hoist`), and reads the later one as that variable
// (`rt_old_byte`, by its state and its index). A read made only while its
// state is current is bound where it is read, as before.

// A read to bind before the link that ends state `state`.
record Planned { state: Nat, read: Handle }

fn Planned::has(plan: List<Planned>, h: Handle) → Bool {
    match plan { Nil => False, Cons(p, rest) => match p.read.id.same(h.id) { True => True, False => Planned::has(rest, h) } }
}

// Whether `c` is a call that writes the span: its first operand is the
// span the walk threads, or a window of it. Its `.value` is the variable
// its `Call` binds, so nothing in it is read again.
fn rt_file_writes(names: FileNames, span: Nat, c: Handle) → Tac<Bool> {
    view(c).bind(λ v => match v {
        HGlobal(_, _, args) => match args {
            Cons(a0, _) => view(a0).bind(λ av => match av {
                HLocal(x, more) => pure(x.id.same(span).and(match more { Nil => True, Cons(_, _) => False })),
                HGlobal(g, _, _) => pure(g.id.same(names.with_byte).or(FileNames::names(names.put_window, g.id)).or(FileNames::names(names.window, g.id))),
                HField(_, name, _) => pure(Known::str_same(name, "after")),
                _ => pure(False),
            }),
            Nil => pure(False),
        },
        _ => pure(False),
    })
}

// The bodies of a `match`'s arms, opened; an arm that does not open is
// left out.
fn rt_file_arm_bodies(m: MatchInfo, todo: List<ArmInfo>) → Tac<List<Handle>> {
    match todo {
        Nil => pure([]),
        Cons(a, rest) => attempt(rt_arm_body(m, a)).bind(λ o => rt_file_arm_bodies(m, rest).bind(λ more => match o {
            Done(b) => pure(Cons(b, more)),
            Failed(_, _) => pure(more),
        })),
    }
}

// The reads in `todo` of a state from `w.done` up to (not with) `now`,
// added to `found`: a `byte_within` of the written span as one of `links`
// left it (`rt_file_state_in`'s numbering), and those inside its index or
// anywhere else the walk may read. The spans the walk threads (stores,
// spans put back, a call's span after it) and a writing call's value are
// not entered: their reads are the links' own. `fuel` counts the nodes
// looked at; past it the rest is not scanned, and a read it would have
// found is refused where it is used.
fn rt_file_scan(fuel: Nat, k: Known, names: FileNames, w: FWalk, links: List<Handle>, now: Nat, todo: List<Handle>, found: List<Planned>)
    → Tac<List<Planned>> {
    match fuel {
        Zero => pure(found),
        Succ(f) => match todo {
            Nil => pure(found),
            Cons(h, rest) => view(h).bind(λ v => match v {
                HLocal(x, args) => match x.id.same(w.fk.span) {
                    True => rt_file_scan(f, k, names, w, links, now, rest, found),
                    False => rt_file_scan(f, k, names, w, links, now, args ++ rest, found),
                },
                HGlobal(g, _, args) => match g.id.same(names.with_byte).or(FileNames::names(names.put_window, g.id)) {
                    True => rt_file_scan(f, k, names, w, links, now, rest, found),
                    False => match Known::prim(k.prims, g.id) {
                        Some(p) => match p {
                            PWithin => match args {
                                Cons(bytes, operands) => rt_file_state_in(w.fk.span, (w.fk.was ++ links).take(now), bytes).bind(λ at => {
                                    let more: List<Planned> = match at {
                                        Some(s) => match w.done.leb(s).and((s + 1).leb(now)).and(!Planned::has(found, h)) {
                                            True => found ++ [Planned(s, h)],
                                            False => found,
                                        },
                                        None => found,
                                    };
                                    rt_file_scan(f, k, names, w, links, now, operands ++ rest, more)
                                }),
                                Nil => rt_file_scan(f, k, names, w, links, now, rest, found),
                            },
                            _ => rt_file_scan(f, k, names, w, links, now, args ++ rest, found),
                        },
                        None => rt_file_scan(f, k, names, w, links, now, args ++ rest, found),
                    },
                },
                HField(of, name, args) => match Known::str_same(name, "after") {
                    True => rt_file_scan(f, k, names, w, links, now, rest, found),
                    False => rt_file_writes(names, w.fk.span, of).bind(λ writes => match writes.and(Known::str_same(name, "value")) {
                        True => rt_file_scan(f, k, names, w, links, now, rest, found),
                        False => rt_file_scan(f, k, names, w, links, now, Cons(of, args) ++ rest, found),
                    }),
                },
                HCtor(_, _, _, fields) => rt_file_scan(f, k, names, w, links, now, fields ++ rest, found),
                HMatch(_) => arms(h).bind(λ c => match c {
                    Accepted(m) => rt_file_arm_bodies(m, m.arms).bind(λ bodies => rt_file_scan(f, k, names, w, links, now, Cons(m.scrut, bodies) ++ rest, found)),
                    Refused(_) => rt_file_scan(f, k, names, w, links, now, rest, found),
                }),
                _ => rt_file_scan(f, k, names, w, links, now, rest, found),
            }),
        },
    }
}

// The nodes a path's scan looks at, at most.
fn rt_file_scan_fuel() → Nat { 65536 }

// What a link reads besides the span it is of: a store's length word,
// index and byte; a call's operands after its span; and for a call over
// windows put back, where it is put and the call's operands (its windows'
// spans are threaded, their bounds read).
fn rt_file_operands(names: FileNames, link: Handle) → Tac<List<Handle>> {
    view(link).bind(λ v => match v {
        HGlobal(g, _, args) => match FileNames::names(names.put_window, g.id) {
            True => match args.rev() {
                Cons(part, Cons(at, _)) => view(part).bind(λ pv => match pv {
                    HField(c, _, _) => view(c).bind(λ cv => match cv { HGlobal(_, _, cargs) => pure(Cons(at, cargs)), _ => pure([at]) }),
                    _ => pure([at]),
                }),
                _ => pure([]),
            },
            False => pure(args.drop(1)),
        },
        HField(c, _, _) => view(c).bind(λ cv => match cv { HGlobal(_, _, args) => pure(args.drop(1)), _ => pure([]) }),
        _ => pure([]),
    })
}

// The reads to bind early on a path: each link's operands are read at the
// state before it, and `uses`, what the path ends in, at the last.
fn rt_file_plan_links(k: Known, names: FileNames, w: FWalk, links: List<Handle>, now: Nat, left: List<Handle>, found: List<Planned>)
    → Tac<List<Planned>> {
    match left {
        Nil => pure(found),
        Cons(link, rest) => rt_file_operands(names, link).bind(λ ops =>
            rt_file_scan(rt_file_scan_fuel(), k, names, w, links, now, ops, found)).bind(λ more =>
            rt_file_plan_links(k, names, w, links, now + 1, rest, more)),
    }
}

fn rt_file_plan(k: Known, names: FileNames, w: FWalk, links: List<Handle>, uses: List<Handle>) → Tac<List<Planned>> {
    rt_file_plan_links(k, names, w, links, w.done, links, []).bind(λ found =>
        rt_file_scan(rt_file_scan_fuel(), k, names, w, links, w.done + links.len(), uses, found))
}

// A byte of the span as it is now, which a step after the next link
// reads: bound now, and kept as the state's byte at its index.
fn rt_file_keep(fuel: Nat, k: Known, w: FWalk, read: Handle) → Tac<FWalk> {
    let v <- view(read);
    match v {
        HGlobal(_, _, args) => match args {
            Cons(_, Cons(length, Cons(i, Nil))) => {
                let kk = k.at_file(w.fk);
                let rl <- rt_go(fuel, kk, w.st, length, True);
                match RSt::level(rl.snd).same(1) {
                    False => rt_file_length("a read kept past a store"),
                    True => {
                        let ri <- rt_go(fuel, kk, rl.fst, i, True);
                        let r = ri.fst.finish(read, True, Byte(0, RSt::level(ri.snd), 1));
                        pure(FWalk(r.fst, w.segs, w.fk.keeping(OldByte(w.done, RSt::level(ri.snd), RSt::level(r.snd))), w.done, w.cfuns))
                    },
                }
            },
            _ => rt_refuse("`byte_within` without its span, length word and index"),
        },
        _ => rt_refuse("a read kept past a store that is not `byte_within`"),
    }
}

// The planned reads of the state the next link ends. One whose index the
// walk cannot read here is left: where it is used, that is refused with
// the reason (`rt_old_byte`); a read only a proof makes is never used.
fn rt_file_hoist(fuel: Nat, k: Known, w: FWalk, plan: List<Planned>) → Tac<FWalk> {
    match plan {
        Nil => pure(w),
        Cons(p, rest) => match p.state.same(w.done) {
            False => rt_file_hoist(fuel, k, w, rest),
            True => attempt(rt_file_keep(fuel, k, w, p.read)).bind(λ o => match o {
                Done(w1) => rt_file_hoist(fuel, k, w1, rest),
                Failed(_, _) => rt_file_hoist(fuel, k, w, rest),
            }),
        },
    }
}

fn rt_file_run(fuel: Nat, k: Known, names: FileNames, w: FWalk, links: List<Handle>, plan: List<Planned>) → Tac<FWalk> {
    match links {
        Nil => pure(w),
        Cons(link, rest) => rt_file_hoist(fuel, k, w, plan).bind(λ w0 => rt_file_link(fuel, k, names, w0, link)).bind(λ w1 =>
            rt_file_run(fuel, k, names, w1, rest, plan)),
    }
}

// The walk up to the span `target`: the stores and calls not yet read,
// each after the reads of the span as it was before it that a later step
// or `uses` (what the path ends in) makes.
fn rt_file_upto(fuel: Nat, k: Known, names: FileNames, w: FWalk, target: Handle, uses: List<Handle>) → Tac<FWalk> {
    let links <- rt_file_links(fuel, names, w, target);
    let plan <- rt_file_plan(k, names, w, links, uses);
    rt_file_run(fuel, k, names, w, links, plan)
}

// What a body's walk leaves: its computation, and the program's pure
// functions and computations after it.
record FileEnd { term: FTm, funs: List<Nat>, cfuns: List<Nat> }

fn rt_file_ends<A>() → Tac<A> {
    rt_refuse("a function over a span ends in `Mutated(span, value)`, in a `match` on a `Bool` whose arms do, or (where it `decreases`) in its own call")
}

// The words a value list holds, its proofs (squashed conditions) left out.
fn rt_file_words(hs: List<Handle>) → Tac<List<Handle>> {
    match hs {
        Nil => pure([]),
        Cons(h, rest) => infer(Hd(h)).bind(λ c => rt_file_words(rest).bind(λ more => match c {
            Refused(_) => pure(Cons(h, more)),
            Accepted(t) => view(t).bind(λ v => pure(match v { HOther => more, _ => Cons(h, more) })),
        })),
    }
}

// A loop's own call as the span, its length word and the words: a function
// of a `Bytes(n)` calls itself on `n`, the record and its words and proofs.
fn rt_file_again(names: FileNames, args: List<Handle>) → Tac<List<Handle>> {
    match names.bytes {
        None => pure(args),
        Some(bt) => match args {
            Nil => pure(args),
            Cons(n, more) => match more {
                Nil => pure(args),
                Cons(s, rest) => infer(Hd(s)).bind(λ c => match c {
                    Refused(_) => pure(args),
                    Accepted(t) => view(t).bind(λ v => match v {
                        HGlobal(g, _, _) => match g.id.same(bt) {
                            True => rt_file_words(rest).bind(λ ws => pure(Cons(s, Cons(n, ws)))),
                            False => pure(args),
                        },
                        _ => pure(args),
                    }),
                }),
            },
        },
    }
}

// A body in tail position. `ih` is the local a measured step calls itself
// through and `arity` the words that call passes, the span and its length
// word first.
fn rt_file_tail(fuel: Nat, k: Known, names: FileNames, ih: Option<Nat>, arity: Nat, w: FWalk, h: Handle) → Tac<FileEnd> {
    match fuel {
        Zero => rt_refuse("the body is deeper than the reflector's fuel"),
        Succ(f) => view(h).bind(λ v => match v {
            HCtor(ty, _, _, fields) => match ty.id.same(names.mutated) {
                False => rt_file_ends(),
                True => match fields.rev() {
                    Cons(value, Cons(after, _)) => {
                        let w1 <- rt_file_upto(f, k, names, w, after, [value]);
                        let r <- rt_go(f, k.at_file(w1.fk), w1.st, value, False);
                        pure(FileEnd(FSeg::close(FSeg::lets(r.fst.lets) ++ w1.segs, FTm::Pure(r.snd)), r.fst.funs, w1.cfuns))
                    },
                    _ => rt_refuse("`Mutated` without its span and value"),
                },
            },
            HMatch(_) => {
                let m <- rt_match("a `match`", h);
                let t <- k.ty_of(m.scrut);
                match t {
                    Bit => {
                        let rc <- rt_go(f, k.at_file(w.fk), w.st, m.scrut, True);
                        let yes_h <- rt_arm(m, 1);
                        let no_h <- rt_arm(m, 0);
                        let base = RSt(rc.fst.depth, [], rc.fst.memo, rc.fst.handles, rc.fst.locals, rc.fst.funs);
                        let ry <- rt_file_tail(f, k, names, ih, arity, FWalk(base, [], w.fk, w.done, w.cfuns), yes_h);
                        let rn <- rt_file_tail(f, k, names, ih, arity, FWalk(base.with_funs(ry.funs), [], w.fk, w.done, ry.cfuns), no_h);
                        let c = rc.fst.index(RSt::level(rc.snd));
                        let node: FTm = match m.args { Nil => FTm::If(c, ry.term, rn.term), Cons(_, _) => FTm::IfEq(c, ry.term, rn.term) };
                        pure(FileEnd(FSeg::close(FSeg::lets(rc.fst.lets) ++ w.segs, node), rn.funs, rn.cfuns))
                    },
                    _ => rt_refuse("a `match` on something other than a `Bool` (enums are not reflected yet)"),
                }
            },
            HLocal(x, args) => match ih.map(λ i => i.same(x.id)).unwrap_or(False) {
                False => rt_file_ends(),
                True => rt_file_again(names, args.take(arity)).bind(λ again => match again {
                    Cons(after, Cons(length, rest)) => {
                        let w1 <- rt_file_upto(f, k, names, w, after, rest);
                        let kk = k.at_file(w1.fk);
                        let rl <- rt_go(f, kk, w1.st, length, True);
                        match RSt::level(rl.snd).same(1) {
                            False => rt_file_length("a loop's own call"),
                            True => {
                                let r <- rt_lent_args(λ s a => rt_go(f, kk, s, a, True), kk, rl.fst, 1, k.lent.pred(), rest);
                                let st = r.fst;
                                pure(FileEnd(FSeg::close(FSeg::lets(st.lets) ++ w1.segs,
                                    FTm::Again(Cons(st.index(0), Cons(st.index(1), st.indices(r.snd))))), st.funs, w1.cfuns))
                            },
                        }
                    },
                    _ => rt_refuse("a loop's own call without its span and length word"),
                }),
            },
            _ => rt_file_ends(),
        }),
    }
}

// ---------------------------------------------------------------------------
// A function

// The code of the value a function's type returns beside the span: the
// `R` of `… → Mutated<List<BitVec(8)>, R>`.
fn rt_file_result(fuel: Nat, k: Known, names: FileNames, t: Handle) → Tac<Ty> {
    match fuel {
        Zero => rt_refuse("more parameters than the reflector's fuel"),
        Succ(f) => view(t).bind(λ v => match v {
            HPi(_) => open(t, "x").bind(λ c => rt_accepted("a parameter", c)).bind(λ o => rt_file_result(f, k, names, o.body)),
            HGlobal(g, _, args) => match g.id.same(names.mutated) {
                True => match args.rev() {
                    Cons(r, _) => k.ty(r),
                    Nil => rt_refuse("`Mutated` without its value's type"),
                },
                False => rt_refuse("a function over a span returns `Mutated<List<BitVec(8)>, R>`"),
            },
            _ => rt_refuse("a function over a span returns `Mutated<List<BitVec(8)>, R>`"),
        }),
    }
}

// The local at level 0: the span.
fn rt_file_span(locals: List<Pair<Nat, Nat>>) → Tac<Nat> {
    match locals {
        Nil => rt_refuse("a function over a span takes the span first"),
        Cons(p, rest) => match p.snd { Zero => pure(p.fst), Succ(_) => rt_file_span(rest) },
    }
}

// `rt_params`, past a parameter that is a proof (a squashed condition,
// `inside: ∥i < s.len()∥`): it is bound to no variable, and a use of it
// outside a proof is refused where the walk meets it. With a count, that
// many parameters and no more.
fn rt_params_proved(fuel: Nat, count: Option<Nat>, k: Known, st: RSt, tys: List<Ty>, b: Handle) → Tac<Pair<Pair<RSt, List<Ty>>, Handle>> {
    match fuel {
        Zero => rt_refuse("more parameters than the reflector's fuel"),
        Succ(f) => match count.map(λ c => c.same(0)).unwrap_or(False) {
            True => pure(Pair(Pair(st, tys), b)),
            False => view(b).bind(λ v => match v {
                HLam(dom) => view(dom).bind(λ dv => open(b, "x").bind(λ c => rt_accepted("a parameter", c)).bind(λ o => match dv {
                    HOther => rt_params_proved(f, count.map(λ c => c.pred()), k, st, tys, o.body),
                    _ => k.ty(dom).bind(λ t => rt_params_proved(f, count.map(λ c => c.pred()), k,
                        RSt(Succ(st.depth), st.lets, st.memo, st.handles, Cons(Pair(o.local.ref.id, st.depth), st.locals), st.funs), tys ++ [t], o.body)),
                })),
                _ => match count {
                    None => pure(Pair(Pair(st, tys), b)),
                    Some(_) => rt_refuse("a step with fewer parameters than its function"),
                },
            }),
        },
    }
}

// A function's parameters, as `rt_params` reads them (with a count, as
// `rt_params_n` does); a function of a `Bytes(n)`, `λ n s x…`, is read as
// one of a span and its length word: `s` is the span, at level 0, and `n`
// its length word, at level 1.
fn rt_file_params(fuel: Nat, count: Option<Nat>, k: Known, names: FileNames, b: Handle) → Tac<Pair<Pair<RSt, List<Ty>>, Handle>> {
    let plain = match count {
        None => rt_params(fuel, k, RSt(0, [], [], [], [], k.funs), [], b),
        Some(c) => rt_params_n(c, k, RSt(0, [], [], [], [], k.funs), [], b),
    };
    match names.bytes {
        None => plain,
        Some(bt) => view(b).bind(λ v => match v {
            HLam(_) => open(b, "n").bind(λ c => rt_accepted("a parameter", c)).bind(λ o1 => view(o1.body).bind(λ v2 => match v2 {
                HLam(dom) => view(dom).bind(λ dv => match dv {
                    HGlobal(g, _, _) => match g.id.same(bt) {
                        True => open(o1.body, "s").bind(λ c => rt_accepted("a parameter", c)).bind(λ o2 =>
                            rt_params_proved(fuel, count.map(λ c => c - 2), k, RSt(2, [], [], [], [Pair(o2.local.ref.id, 0), Pair(o1.local.ref.id, 1)], k.funs),
                                [ByteList(0), Word(64)], o2.body)),
                        False => plain,
                    },
                    _ => plain,
                }),
                _ => plain,
            })),
            _ => plain,
        }),
    }
}

// How many spans the function is lent and the codes its code takes: two
// words for each span and its length word, then the function's own words.
// The first span is the written one; the spans after it are only read.
fn rt_file_codes(tys: List<Ty>) → Tac<Pair<Nat, List<Ty>>> {
    let lent = rt_lent(tys);
    match Nat::leb(1, lent.fst).and(!rt_has_bytes(lent.snd)) {
        True => pure(lent),
        False => rt_refuse("a function over a span takes the span first and then its 64-bit length word, the spans it only reads after it, each with its length word, and no other byte list"),
    }
}

// A function, and the program's pure functions (`k.funs` and the runtime
// fns it was found to call) and computations (`cfuns` likewise) after it
// was walked.
record FileReflected { reflected: FFun, funs: List<Nat>, cfuns: List<Nat> }

fn rt_file_reflect_plain(fuel: Nat, k: Known, names: FileNames, cfuns: List<Nat>, g: Nat) → Tac<FileReflected> {
    let t <- infer(Global(GlobalRef(g))).bind(λ c => rt_accepted("its type", c));
    let result <- rt_file_result(fuel, k, names, t);
    let b <- body(GlobalRef(g)).bind(λ c => rt_accepted("its body", c));
    let p <- rt_file_params(fuel, None, k, names, b);
    let codes <- rt_file_codes(p.fst.snd);
    let span <- rt_file_span(p.fst.fst.locals);
    let r <- rt_file_tail(fuel, k.lending(codes.fst), names, None, 0, FWalk(p.fst.fst, [], FileKnown::start(span, []), 0, cfuns), p.snd);
    pure(FileReflected(FFun(codes.snd, result, r.term, codes.fst), r.funs, r.cfuns))
}

// A function that `decreases`, read from its step `f::body`: `λ k g span
// length x… h => …`, its recursion `g(span′, length, y…, p)` the function
// itself on the span as the pass left it.
fn rt_file_reflect_measured(fuel: Nat, k: Known, names: FileNames, cfuns: List<Nat>, g: Nat, step: Nat) → Tac<FileReflected> {
    let t <- infer(Global(GlobalRef(g))).bind(λ c => rt_accepted("its type", c));
    let result <- rt_file_result(fuel, k, names, t);
    let n <- rt_arity(fuel, t);
    let b <- body(GlobalRef(step)).bind(λ c => rt_accepted("its step's body", c));
    let o1 <- open(b, "k").bind(λ c => rt_accepted("its step's bound", c));
    let o2 <- open(o1.body, "g").bind(λ c => rt_accepted("its step's recursion", c));
    let p <- rt_file_params(fuel, Some(n), k, names, o2.body);
    let codes <- rt_file_codes(p.fst.snd);
    let span <- rt_file_span(p.fst.fst.locals);
    let o3 <- open(p.snd, "h").bind(λ c => rt_accepted("its step's measure proof", c));
    let r <- rt_file_tail(fuel, k.lending(codes.fst), names, Some(o2.local.ref.id), n, FWalk(p.fst.fst, [], FileKnown::start(span, []), 0, cfuns),
        o3.body);
    pure(FileReflected(FFun(codes.snd, result, r.term, codes.fst), r.funs, r.cfuns))
}

fn rt_file_reflect_one(k: Known, names: FileNames, cfuns: List<Nat>, g: Nat, name: String) → Tac<FileReflected> {
    lookup(name ++ "::body").bind(λ c => match c {
        Accepted(step) => rt_file_reflect_measured(4096, k, names, cfuns, g, step.id),
        Refused(_) => rt_file_reflect_plain(4096, k, names, cfuns, g),
    })
}

fn rt_file_reflect_each(k: Known, names: FileNames, cfuns: List<Nat>, gs: List<Nat>, ns: List<String>) → Tac<List<FFun>> {
    match gs {
        Nil => pure([]),
        Cons(g, rest) => match ns {
            Nil => pure([]),
            Cons(n, more) => rt_file_reflect_one(k, names, cfuns, g, n).bind(λ r =>
                rt_file_reflect_each(k, names, cfuns, rest, more).bind(λ rs => pure(Cons(r.reflected, rs)))),
        },
    }
}

// The computations `cfuns`, by name, reflected from their elaborated
// bodies; they may call one another (a `Call`'s index is the place in
// `cfuns`) and the pure runtime functions `funs`.
fn rt_file_reflect(cfuns: List<String>, funs: List<String>) → Tac<List<FFun>> {
    let k <- rt_known(funs, []);
    let names <- rt_file_names();
    let cs <- rt_globals(cfuns);
    rt_file_reflect_each(k, names, cs, cs, cfuns)
}

// ---------------------------------------------------------------------------
// Equality and rendering, for the check and its failures.

fn FView::same(self view: FView, other: FView) → Bool {
    let starts: Bool = match view.start {
        None => match other.start { None => True, Some(_) => False },
        Some(s) => match other.start { None => False, Some(s2) => s.same(s2) },
    };
    view.span.same(other.span).and(view.home.same(other.home)).and(starts).and(view.end.same(other.end))
}

fn FView::all_same(views: List<FView>, others: List<FView>) → Bool {
    match views {
        Nil => match others { Nil => True, Cons(_, _) => False },
        Cons(view, rest) => match others { Nil => False, Cons(other, more) => view.same(other).and(FView::all_same(rest, more)) },
    }
}

fn FTm::same(self t: FTm) → FTm → Bool {
    match t {
        Pure(v) => λ u => match u { Pure(v2) => v.same(v2), _ => False },
        Let(e, body) => λ u => match u { Let(e2, body2) => e.same(e2).and(body.same(body2)), _ => False },
        If(c, yes, no) => λ u => match u { If(c2, yes2, no2) => c.same(c2).and(yes.same(yes2)).and(no.same(no2)), _ => False },
        IfEq(c, yes, no) => λ u => match u { IfEq(c2, yes2, no2) => c.same(c2).and(yes.same(yes2)).and(no.same(no2)), _ => False },
        Put(i, length, v, body) => λ u => match u {
            Put(i2, length2, v2, body2) => i.same(i2).and(length.same(length2)).and(v.same(v2)).and(body.same(body2)),
            _ => False,
        },
        Call(f, args, body) => λ u => match u { Call(f2, args2, body2) => f.same(f2).and(Tm::nats_same(args, args2)).and(body.same(body2)), _ => False },
        Again(args) => λ u => match u { Again(args2) => Tm::nats_same(args, args2), _ => False },
        Lend(f, views, args, body) => λ u => match u {
            Lend(f2, views2, args2, body2) => f.same(f2).and(FView::all_same(views, views2)).and(Tm::nats_same(args, args2)).and(body.same(body2)),
            _ => False,
        },
    }
}

fn FFun::same(self f: FFun, g: FFun) → Bool {
    Ty::all_same(f.params, g.params).and(f.result.same(g.result)).and(f.body.same(g.body)).and(f.lent.same(g.lent))
}

fn FView::show(self view: FView) → String {
    let start: String = match view.start { None => "None", Some(s) => "Some(" ++ rt_nat(s) ++ ")" };
    "FView(" ++ rt_nat(view.span) ++ ", " ++ rt_nat(view.home) ++ ", " ++ start ++ ", " ++ rt_nat(view.end) ++ ")"
}

fn FView::shows(views: List<FView>) → String {
    match views {
        Nil => "",
        Cons(view, rest) => match rest { Nil => view.show(), Cons(_, _) => view.show() ++ ", " ++ FView::shows(rest) },
    }
}

fn FTm::show(self t: FTm) → String {
    match t {
        Pure(v) => "Pure(" ++ v.show() ++ ")",
        Let(e, body) => "Let(" ++ e.show() ++ ", " ++ body.show() ++ ")",
        If(c, yes, no) => "If(" ++ rt_nat(c) ++ ", " ++ yes.show() ++ ", " ++ no.show() ++ ")",
        IfEq(c, yes, no) => "IfEq(" ++ rt_nat(c) ++ ", " ++ yes.show() ++ ", " ++ no.show() ++ ")",
        Put(i, length, v, body) => "Put(" ++ rt_nat(i) ++ ", " ++ rt_nat(length) ++ ", " ++ rt_nat(v) ++ ", " ++ body.show() ++ ")",
        Call(f, args, body) => "Call(" ++ rt_nat(f) ++ ", [" ++ rt_nats(args) ++ "], " ++ body.show() ++ ")",
        Again(args) => "Again([" ++ rt_nats(args) ++ "])",
        Lend(f, views, args, body) => "Lend(" ++ rt_nat(f) ++ ", [" ++ FView::shows(views) ++ "], [" ++ rt_nats(args) ++ "], " ++ body.show() ++ ")",
    }
}

fn FFun::show(self f: FFun) → String {
    "FFun([" ++ Ty::shows(f.params) ++ "], " ++ f.result.show() ++ ", " ++ f.body.show() ++ ")"
}

fn rt_file_compare(got: List<FFun>, expected: List<FFun>) → Tac<Expr> {
    match got {
        Nil => match expected {
            Nil => resolve("trivial").bind(λ c => rt_accepted("`trivial`", c)).bind(λ h => pure(Hd(h))),
            Cons(_, _) => rt_refuse("fewer functions reflected than expected"),
        },
        Cons(g, rest) => match expected {
            Nil => rt_refuse("more functions reflected than expected"),
            Cons(e, more) => match g.same(e) {
                True => rt_file_compare(rest, more),
                False => rt_refuse("the reflection differs:\n  got      " ++ g.show() ++ "\n  expected " ++ e.show()),
            },
        },
    }
}

// The check `lib/_tests` runs: the reflection of the computations `cfuns`
// is `expected`, function by function. Proves `True`; a difference fails,
// showing both.
fn reflects_file_as(cfuns: List<String>, funs: List<String>, expected: List<FFun>) → Tac<Expr> {
    rt_file_reflect(cfuns, funs).bind(λ got => rt_file_compare(got, expected))
}

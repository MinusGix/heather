// Effectful `rt` lowered to a `Source`'s statements, and its soundness
// proved once (docs/language/effects-capabilities-design.md §8.5;
// issues/effects-uniqueness-surface.md, slice 4; R6 item 2).
//
// A computation (`ETm`, `rt_io`) is a chain of pure bindings and calls to
// Linux ending in a value. It lowers to a chain of `Source` statements:
//
// - a pure value (`Pure`, a `Let`'s bound term) is a `Compute` leaf, the
//   region the default setup's pure lowering builds (`Tm::lower`,
//   `rt_lower`), followed by a move of its result to a fresh word;
// - a call (`Invoke`) is an `Invoke` statement whose `CallShape` names the
//   words and buffers its operands live in, its result word fresh;
// - sequencing is `Then`.
//
// Each variable lives somewhere in the source's environment (`Loc`): a word
// or a bit in a word, held as the number it is the `toNat` of (canonical,
// so every width reads it back), a byte buffer in a buffer of the file. A
// read lands in its buffer in place (`fill`), so the variable that named
// the buffer before the read no longer has its value there: every variable
// at that buffer is `Gone` after the call, and the lowering refuses any use
// of a gone variable. That is the `Unique` fact for the call's buffer
// (docs/native/facts-on-demand-design.md §7) decided by the lowering, not assumed.
//
// `ETm::lower_sound` is the theorem every case is a case of, by induction
// over `ETm`: from any environment holding the variables (`LocsHold`) and
// any world, the lowered statements' threading (`Stmt::thread`,
// `native_source_io`) leaves the world the meaning leaves (`ETm::sem`) and
// the meaning's value in the result word. With `Stmt::reads_thread` that is
// `Io::Reads` of the statements' tree against the meaning
// (`ETm::lower_reads`): the R6 statement, for computations with no loop.
//
// The pure parts are the pure lowering's, with its theorem
// (`Tm::lower_sound`) applied at the environment's valuation. Four checks,
// each decided at the lowering and used once in the proof, bridge a
// region's evaluation to `Env::compute`: the region has no byte node or
// loop (`byte_free`), it calls only the world's functions, the ones numbered
// below the world's count (so it runs as it evaluates and keeps the
// buffers wherever those functions leave the file), it names no live
// variable's word as written (so settling keeps them), and the value is a
// word or a bit (one port, moved to a fresh word at its width).
//
// What the theorem asks of the program's functions is asked of the ones a
// pure term can call (`Writers::Still` among `functions_below`): the
// program may have functions that write, numbered after them
// (docs/native/native-one-compiler-design.md §2.6, U4 step 4c-4).
import logic;
import bool;
import nat;
import list;
import option;
import pair;
import bitvec;
import nat_map;
import itree;
import coitree;
import coitree_eutt;
import linux_calls;
import linux_trees;
import linux_world;
import linux_world_co;
import function_ir;
import function_ir_eval;
import function_ir_state;
import function_ir_run;
import native_source;
import native_source_co;
import native_source_io;
import rt;
import rt_lower;
import rt_io;

// ---------------------------------------------------------------------------
// Where variables live

inductive Loc {
    // A word or a bit, in the environment's word `id`.
    InWord(id: Nat),
    // A byte buffer, the environment's buffer `id`.
    InBuffer(id: Nat),
    // A byte buffer a call has since written over: no longer anywhere.
    Gone,
}

// The port the pure lowering reads a variable at: its word. A buffer has no
// port; the valuation asks nothing of it (`Ty::Holds` at `ByteList`).
fn Loc::port(self l: Loc) → Nat { match l { InWord(id) => id, InBuffer(_) => 0, Gone => 0 } }

fn Loc::ports(locs: List<Loc>) → List<Nat> {
    match locs { Nil => Nil, Cons(l, rest) => Cons(l.port(), Loc::ports(rest)) }
}

fn Loc::at(locs: List<Loc>, i: Nat) → Option<Loc> {
    match locs { Nil => None, Cons(l, rest) => match i { Zero => Some(l), Succ(k) => Loc::at(rest, k) } }
}

// After a call wrote buffer `b`, no variable is there any more.
fn Loc::forget(self l: Loc, b: Nat) → Loc {
    match l { InWord(id) => InWord(id), InBuffer(id) => match id.eq_dec(b) { Inl(_) => Gone, Inr(_) => InBuffer(id) }, Gone => Gone }
}

fn Loc::forget_all(locs: List<Loc>, b: Nat) → List<Loc> {
    match locs { Nil => Nil, Cons(l, rest) => Cons(l.forget(b), Loc::forget_all(rest, b)) }
}

// A variable's word is not among `ws`.
fn Loc::clear_one(self l: Loc, ws: List<Nat>) → Bool { match l { InWord(id) => absent(id, ws), InBuffer(_) => True, Gone => True } }

// Every word a variable lives in is not among `ws`.
fn Loc::clear(locs: List<Loc>, ws: List<Nat>) → Bool {
    match locs {
        Nil => True,
        Cons(l, rest) => l.clear_one(ws) && Loc::clear(rest, ws),
    }
}

// The environment holds a value where it lives: a word or a bit as the
// number it is the `toNat` of, a buffer as its bytes, the file having that
// buffer (so a function lent the file's first buffer finds one there). A
// gone buffer holds nothing, and the other codes are refused by the
// lowering.
fn Ty::Kept(self t: Ty, tys: Nat → RecInfo, env: Env, l: Loc) → t.sem(tys) → Type {
    match t {
        Word(_) => λ v => match l { InWord(id) => env.number(id) = v.toNat(), InBuffer(_) => False, Gone => False },
        Bit => λ v => match l { InWord(id) => env.number(id) = BitVec::ofBool(v).toNat(), InBuffer(_) => False, Gone => False },
        ByteList(_) => λ v => match l { InWord(_) => False, InBuffer(id) => env.buffers.nth(id) = Some(v), Gone => True },
        Lines => λ _ => False,
        Named(_) => λ _ => False,
        Count => λ _ => False,
        Enum(_) => λ _ => False,
    }
}

// Every variable is kept where it lives, one place per variable.
fn LocsHold(tys: Nat → RecInfo, env: Env, g: List<Ty>) → List<Loc> → rt::Env(tys, g) → Type {
    match g {
        Nil => λ locs _ => match locs { Nil => True, Cons(_, _) => False },
        Cons(t, rest) => λ locs vals => match locs {
            Nil => False,
            Cons(l, ls) => t.Kept(tys, env, l, vals.fst) ∧ LocsHold(tys, env, rest, ls, vals.snd),
        },
    }
}

// A variable's word is below `next`.
fn Loc::Under(self l: Loc, next: Nat) → Type { match l { InWord(id) => id < next, InBuffer(_) => True, Gone => True } }

// Every word a variable lives in is below `next`.
fn LocsBelow(locs: List<Loc>, next: Nat) → Type {
    match locs {
        Nil => True,
        Cons(l, rest) => l.Under(next) ∧ LocsBelow(rest, next),
    }
}

// ---------------------------------------------------------------------------
// From where variables live to what the pure lowering assumes

// A kept value is held at its port in the environment's valuation.
theorem Ty::kept_holds(self t: Ty, tys: Nat → RecInfo, env: Env, l: Loc): (v: t.sem(tys)) → t.Kept(tys, env, l, v) →
    t.Holds(tys, env.valuation(), l.port(), v) {
    match t {
        Word(w) => λ v => match l as λ k => Word(w).Kept(tys, env, k, v) → Word(w).Holds(tys, env.valuation(), k.port(), v) {
            InWord(id) => λ (h: env.number(id) = v.toNat()) =>
                trans(cong_fn<Nat, BitVec(w)>(λ n => BitVec::ofNat(n), h), BitVec::ofNat_toNat(w, v)),
            InBuffer(_) => λ never => false_elim(never),
            Gone => λ never => false_elim(never),
        },
        Bit => λ v => match l as λ k => Bit.Kept(tys, env, k, v) → Bit.Holds(tys, env.valuation(), k.port(), v) {
            InWord(id) => λ (h: env.number(id) = BitVec::ofBool(v).toNat()) =>
                trans(cong_fn<Nat, BitVec(1)>(λ n => BitVec::ofNat(n), h), BitVec::ofNat_toNat(1, BitVec::ofBool(v))),
            InBuffer(_) => λ never => false_elim(never),
            Gone => λ never => false_elim(never),
        },
        ByteList(_) => λ v _ => trivial,
        Lines => λ v never => false_elim(never),
        Named(_) => λ v never => false_elim(never),
        Count => λ v never => false_elim(never),
        Enum(_) => λ v never => false_elim(never),
    }
}

// A kept value's port is below `next` when its word is, and the buffers'
// port 0 is.
theorem Ty::kept_below(self t: Ty, tys: Nat → RecInfo, env: Env, l: Loc, next: Nat, pos: 0 < next): (v: t.sem(tys)) → t.Kept(tys, env, l, v) →
    l.Under(next) → t.Below(tys, l.port(), next) {
    match t {
        Word(w) => λ v => match l as λ k => Word(w).Kept(tys, env, k, v) →
                k.Under(next) → Word(w).Below(tys, k.port(), next) {
            InWord(_) => λ _ lt => lt,
            InBuffer(_) => λ never => false_elim(never),
            Gone => λ never => false_elim(never),
        },
        Bit => λ v => match l as λ k => Bit.Kept(tys, env, k, v) →
                k.Under(next) → Bit.Below(tys, k.port(), next) {
            InWord(_) => λ _ lt => lt,
            InBuffer(_) => λ never => false_elim(never),
            Gone => λ never => false_elim(never),
        },
        ByteList(c) => λ v => match l as λ k => ByteList(c).Kept(tys, env, k, v) →
                k.Under(next) → ByteList(c).Below(tys, k.port(), next) {
            InWord(_) => λ never => false_elim(never),
            InBuffer(_) => λ _ _ => pos,
            Gone => λ _ _ => pos,
        },
        Lines => λ v never => false_elim(never),
        Named(_) => λ v never => false_elim(never),
        Count => λ v never => false_elim(never),
        Enum(_) => λ v never => false_elim(never),
    }
}

theorem locs_env_holds(tys: Nat → RecInfo, env: Env, g: List<Ty>): (locs: List<Loc>) → (vals: rt::Env(tys, g)) →
    LocsHold(tys, env, g, locs, vals) → EnvHolds(tys, env.valuation(), g, Loc::ports(locs), vals) {
    match g {
        Nil => λ locs => match locs { Nil => λ vals h => h, Cons(_, _) => λ vals never => false_elim(never) },
        Cons(t, rest) => λ locs => match locs {
            Nil => λ vals never => false_elim(never),
            Cons(l, ls) => λ vals h => ⟨t.kept_holds(tys, env, l, vals.fst, h.left), locs_env_holds(tys, env, rest, ls, vals.snd, h.right)⟩,
        },
    }
}

theorem locs_below(tys: Nat → RecInfo, env: Env, g: List<Ty>, next: Nat, pos: 0 < next): (locs: List<Loc>) → (vals: rt::Env(tys, g)) →
    LocsHold(tys, env, g, locs, vals) → LocsBelow(locs, next) → Below(tys, g, Loc::ports(locs), next) {
    match g {
        Nil => λ locs => match locs { Nil => λ vals h b => trivial, Cons(_, _) => λ vals never => false_elim(never) },
        Cons(t, rest) => λ locs => match locs {
            Nil => λ vals never => false_elim(never),
            Cons(l, ls) => λ vals h b => ⟨t.kept_below(tys, env, l, next, pos, vals.fst, h.left, b.left),
                locs_below(tys, env, rest, next, pos, ls, vals.snd, h.right, b.right)⟩,
        },
    }
}

// A variable's place, and what is kept there.
theorem locs_hold_at(tys: Nat → RecInfo, env: Env, g: List<Ty>): (locs: List<Loc>) → (vals: rt::Env(tys, g)) →
    LocsHold(tys, env, g, locs, vals) → (i: Nat) → (l: Loc) → Loc::at(locs, i) = Some(l) →
    Ty::at(g, i).Kept(tys, env, l, Env::get(tys, g, vals, i)) {
    match g {
        Nil => λ locs => match locs {
            Nil => λ vals h i l (at: None<Loc>() = Some(l)) => Option::none_ne_some(l, at, Ty::at(Nil, i).Kept(tys, env, l, Env::get(tys, Nil, vals, i))),
            Cons(_, _) => λ vals never => false_elim(never),
        },
        Cons(t, rest) => λ locs => match locs {
            Nil => λ vals never => false_elim(never),
            Cons(q, qs) => λ vals h i => match i {
                Zero => λ l (at: Some(q) = Some(l)) => j(Option::some_inj(q, l, at), λ x _ => t.Kept(tys, env, x, vals.fst), h.left),
                Succ(k) => λ l at => locs_hold_at(tys, env, rest, qs, vals.snd, h.right, k, l, at),
            },
        },
    }
}

// ---------------------------------------------------------------------------
// A file's entries where one is put

// The entry put is there.
theorem List::put_nth_here<A>(i: Nat): (xs: List<A>) → (x: A) → (d: A) → xs.put(i, x, d).nth(i) = Some(x) {
    match i {
        Zero => λ xs x d => match xs as λ ys => ys.put(Zero, x, d).nth(Zero) = Some(x) { Nil => refl, Cons(_, _) => refl },
        Succ(k) => λ xs x d => match xs as λ ys => ys.put(k + 1, x, d).nth(k + 1) = Some(x) {
            Nil => List::put_nth_here(k, Nil, x, d),
            Cons(_, rest) => List::put_nth_here(k, rest, x, d),
        },
    }
}

// An entry the list had stays where nothing was put.
theorem List::put_nth_other<A>(i: Nat): (xs: List<A>) → (x: A) → (d: A) → (k: Nat) → k ≠ i → (v: A) → xs.nth(k) = Some(v) →
    xs.put(i, x, d).nth(k) = Some(v) {
    match i {
        Zero => λ xs x d k => match k as λ k2 => k2 ≠ Zero → (v: A) → xs.nth(k2) = Some(v) → xs.put(Zero, x, d).nth(k2) = Some(v) {
            Zero => λ ne => false_elim(ne(refl)),
            Succ(k2) => λ _ => match xs as λ ys => (v: A) → ys.nth(k2 + 1) = Some(v) → ys.put(Zero, x, d).nth(k2 + 1) = Some(v) {
                Nil => λ v never => Option::none_ne_some(v, never, Nil<A>().put(Zero, x, d).nth(k2 + 1) = Some(v)),
                Cons(_, _) => λ v h => h,
            },
        },
        Succ(i2) => λ xs x d k => match k as λ k2 => k2 ≠ i2 + 1 → (v: A) → xs.nth(k2) = Some(v) → xs.put(i2 + 1, x, d).nth(k2) = Some(v) {
            Zero => λ _ => match xs as λ ys => (v: A) → ys.nth(Zero) = Some(v) → ys.put(i2 + 1, x, d).nth(Zero) = Some(v) {
                Nil => λ v never => Option::none_ne_some(v, never, Nil<A>().put(i2 + 1, x, d).nth(Zero) = Some(v)),
                Cons(_, _) => λ v h => h,
            },
            Succ(k2) => λ ne => match xs as λ ys => (v: A) → ys.nth(k2 + 1) = Some(v) → ys.put(i2 + 1, x, d).nth(k2 + 1) = Some(v) {
                Nil => λ v never => Option::none_ne_some(v, never, Nil<A>().put(i2 + 1, x, d).nth(k2 + 1) = Some(v)),
                Cons(_, rest) => List::put_nth_other(i2, rest, x, d, k2, λ e => ne(cong_fn(λ (n: Nat) => n + 1, e))),
            },
        },
    }
}

// A buffer the file has reads as its bytes.
theorem Env::buffer_of_nth(self env: Env, id: Nat, v: List<BitVec(8)>, h: env.buffers.nth(id) = Some(v)): env.buffer(id) = v {
    cong_fn(λ (o: Option<List<BitVec(8)>>) => match o { None => Nil, Some(bytes) => bytes }, h)
}

// A file that has a first buffer is that buffer and the rest.
theorem Env::first_buffer(self env: Env, v: List<BitVec(8)>, h: env.buffers.nth(0) = Some(v)): env.buffers = Cons(v, env.buffers.tail()) {
    match env.buffers as λ bs => bs.nth(0) = Some(v) → bs = Cons(v, bs.tail()) {
        Nil => λ never => Option::none_ne_some(v, never, Nil<List<BitVec(8)>>() = Cons(v, Nil<List<BitVec(8)>>().tail())),
        Cons(b, rest) => λ e => cong_fn(λ (x: List<BitVec(8)>) => Cons(x, rest), Option::some_inj(b, v, e)),
    }(h)
}

// ---------------------------------------------------------------------------
// Keeping what is kept when the environment changes

// Where a variable lives reads the same in two environments: the word's
// number, and the buffer's bytes where the first has the buffer.
fn Loc::Same(self l: Loc, env, env2: Env) → Type {
    match l {
        InWord(id) => env2.number(id) = env.number(id),
        InBuffer(id) => (v: List<BitVec(8)>) → env.buffers.nth(id) = Some(v) → env2.buffers.nth(id) = Some(v),
        Gone => True,
    }
}

theorem Ty::kept_same(self t: Ty, tys: Nat → RecInfo, env, env2: Env, l: Loc, same: l.Same(env, env2)): (v: t.sem(tys)) →
    t.Kept(tys, env, l, v) → t.Kept(tys, env2, l, v) {
    match t {
        Word(w) => match l as λ k => k.Same(env, env2) → (v: BitVec(w)) → Word(w).Kept(tys, env, k, v) → Word(w).Kept(tys, env2, k, v) {
            InWord(_) => λ s v h => trans(s, h),
            InBuffer(_) => λ s v never => false_elim(never),
            Gone => λ s v never => false_elim(never),
        }(same),
        Bit => match l as λ k => k.Same(env, env2) → (v: Bool) → Bit.Kept(tys, env, k, v) → Bit.Kept(tys, env2, k, v) {
            InWord(_) => λ s v h => trans(s, h),
            InBuffer(_) => λ s v never => false_elim(never),
            Gone => λ s v never => false_elim(never),
        }(same),
        ByteList(c) => match l as λ k => k.Same(env, env2) → (v: List<BitVec(8)>) → ByteList(c).Kept(tys, env, k, v) → ByteList(c).Kept(tys, env2, k, v) {
            InWord(_) => λ s v never => false_elim(never),
            InBuffer(_) => λ s v h => s(v, h),
            Gone => λ s v h => h,
        }(same),
        Lines => λ v never => false_elim(never),
        Named(_) => λ v never => false_elim(never),
        Count => λ v never => false_elim(never),
        Enum(_) => λ v never => false_elim(never),
    }
}

fn Loc::AllSame(locs: List<Loc>, env, env2: Env) → Type {
    match locs { Nil => True, Cons(l, rest) => l.Same(env, env2) ∧ Loc::AllSame(rest, env, env2) }
}

theorem locs_hold_same(tys: Nat → RecInfo, env, env2: Env, g: List<Ty>): (locs: List<Loc>) → (vals: rt::Env(tys, g)) →
    Loc::AllSame(locs, env, env2) → LocsHold(tys, env, g, locs, vals) → LocsHold(tys, env2, g, locs, vals) {
    match g {
        Nil => λ locs => match locs { Nil => λ vals s h => h, Cons(_, _) => λ vals s never => false_elim(never) },
        Cons(t, rest) => λ locs => match locs {
            Nil => λ vals s never => false_elim(never),
            Cons(l, ls) => λ vals s h => ⟨t.kept_same(tys, env, env2, l, s.left, vals.fst, h.left),
                locs_hold_same(tys, env, env2, rest, ls, vals.snd, s.right, h.right)⟩,
        },
    }
}

// A region that keeps the buffers and names none of the variables' words as
// written keeps every variable.
theorem Loc::same_compute(env: Env, call: Writers(), region: StructuredRegion, keeps: env.compute(call, region).buffers = env.buffers,
    locs: List<Loc>): Loc::clear(locs, region.writes()).IsTrue() → Loc::AllSame(locs, env, env.compute(call, region)) {
    match locs {
        Nil => λ _ => trivial,
        Cons(l, rest) => λ clear => {
            let parts = Bool::is_true_and(l.clear_one(region.writes()),
                Loc::clear(rest, region.writes()), clear);
            ⟨match l as λ k => k.clear_one(region.writes()).IsTrue() →
                    k.Same(env, env.compute(call, region)) {
                InWord(id) => λ h => env.compute_other(call, region, id, h),
                InBuffer(id) => λ _ v h => trans(cong_fn(λ (bs: List<List<BitVec(8)>>) => bs.nth(id), keeps), h),
                Gone => λ _ => trivial,
            }(parts.left), Loc::same_compute(env, call, region, keeps, rest, parts.right)⟩
        },
    }
}

theorem Loc::same_trans(locs: List<Loc>, env, env1, env2: Env): Loc::AllSame(locs, env, env1) → Loc::AllSame(locs, env1, env2) →
    Loc::AllSame(locs, env, env2) {
    match locs {
        Nil => λ _ _ => trivial,
        Cons(l, rest) => λ a b => ⟨match l as λ k => k.Same(env, env1) → k.Same(env1, env2) → k.Same(env, env2) {
                InWord(_) => λ x y => trans(y, x),
                InBuffer(_) => λ x y v h => y(v, x(v, h)),
                Gone => λ _ _ => trivial,
            }(a.left, b.left), Loc::same_trans(rest, env, env1, env2, a.right, b.right)⟩,
    }
}

// A word set at or above `next` keeps every variable below it.
theorem Loc::same_set_word(locs: List<Loc>, env: Env, id: Nat, word: BitVec(64)): LocsBelow(locs, id) →
    Loc::AllSame(locs, env, env.set_word(id, word)) {
    match locs {
        Nil => λ _ => trivial,
        Cons(l, rest) => λ below => ⟨match l as λ k => k.Under(id) → k.Same(env, env.set_word(id, word)) {
                InWord(x) => λ lt => env.number_set_other(id, word, x, Nat::ne_of_lt(x, id, lt)),
                InBuffer(_) => λ _ v h => h,
                Gone => λ _ => trivial,
            }(below.left), Loc::same_set_word(rest, env, id, word, below.right)⟩,
    }
}

// A buffer written keeps every variable not at it.
theorem Loc::same_set_buffer(locs: List<Loc>, env: Env, b: Nat, bytes: List<BitVec(8)>):
    Loc::AllSame(Loc::forget_all(locs, b), env, env.set_buffer(b, bytes)) {
    match locs {
        Nil => trivial,
        Cons(l, rest) => ⟨match l as λ k => k.forget(b).Same(env, env.set_buffer(b, bytes)) {
                InWord(_) => refl,
                InBuffer(x) => match x.eq_dec(b) as λ d =>
                        (match d as λ _ => Loc { Inl(_) => Gone, Inr(_) => InBuffer(x) }).Same(env, env.set_buffer(b, bytes)) {
                    Inl(_) => trivial,
                    Inr(ne) => λ v h => List::put_nth_other(b, env.buffers, bytes, Nil, x, ne, v, h),
                },
                Gone => trivial,
            }, Loc::same_set_buffer(rest, env, b, bytes)⟩,
    }
}

theorem Ty::kept_forget(self t: Ty, tys: Nat → RecInfo, env: Env, l: Loc, b: Nat): (v: t.sem(tys)) → t.Kept(tys, env, l, v) →
    t.Kept(tys, env, l.forget(b), v) {
    match t {
        Word(w) => λ v => match l as λ k => Word(w).Kept(tys, env, k, v) → Word(w).Kept(tys, env, k.forget(b), v) {
            InWord(_) => λ h => h,
            InBuffer(_) => λ never => false_elim(never),
            Gone => λ never => false_elim(never),
        },
        Bit => λ v => match l as λ k => Bit.Kept(tys, env, k, v) → Bit.Kept(tys, env, k.forget(b), v) {
            InWord(_) => λ h => h,
            InBuffer(_) => λ never => false_elim(never),
            Gone => λ never => false_elim(never),
        },
        ByteList(c) => λ v => match l as λ k => ByteList(c).Kept(tys, env, k, v) → ByteList(c).Kept(tys, env, k.forget(b), v) {
            InWord(_) => λ never => false_elim(never),
            InBuffer(x) => λ h => match x.eq_dec(b) as λ d =>
                    ByteList(c).Kept(tys, env, match d as λ _ => Loc { Inl(_) => Gone, Inr(_) => InBuffer(x) }, v) {
                Inl(_) => trivial,
                Inr(_) => h,
            },
            Gone => λ h => h,
        },
        Lines => λ v never => false_elim(never),
        Named(_) => λ v never => false_elim(never),
        Count => λ v never => false_elim(never),
        Enum(_) => λ v never => false_elim(never),
    }
}

theorem locs_hold_forget(tys: Nat → RecInfo, env: Env, b: Nat, g: List<Ty>): (locs: List<Loc>) → (vals: rt::Env(tys, g)) →
    LocsHold(tys, env, g, locs, vals) → LocsHold(tys, env, g, Loc::forget_all(locs, b), vals) {
    match g {
        Nil => λ locs => match locs { Nil => λ vals h => h, Cons(_, _) => λ vals never => false_elim(never) },
        Cons(t, rest) => λ locs => match locs {
            Nil => λ vals never => false_elim(never),
            Cons(l, ls) => λ vals h => ⟨t.kept_forget(tys, env, l, b, vals.fst, h.left), locs_hold_forget(tys, env, b, rest, ls, vals.snd, h.right)⟩,
        },
    }
}

theorem locs_below_forget(locs: List<Loc>, b, next: Nat): LocsBelow(locs, next) → LocsBelow(Loc::forget_all(locs, b), next) {
    match locs {
        Nil => λ h => h,
        Cons(l, rest) => λ h => ⟨match l as λ k => k.Under(next) → k.forget(b).Under(next) {
                InWord(_) => λ lt => lt,
                InBuffer(x) => λ _ => match x.eq_dec(b) as λ d => (match d as λ _ => Loc { Inl(_) => Gone, Inr(_) => InBuffer(x) }).Under(next) {
                    Inl(_) => trivial,
                    Inr(_) => trivial,
                },
                Gone => λ _ => trivial,
            }(h.left), locs_below_forget(rest, b, next, h.right)⟩,
    }
}

theorem locs_below_mono(locs: List<Loc>, next, later: Nat, le: next <= later): LocsBelow(locs, next) → LocsBelow(locs, later) {
    match locs {
        Nil => λ h => h,
        Cons(l, rest) => λ h => ⟨match l as λ k => k.Under(next) → k.Under(later) {
                InWord(x) => λ lt => Nat::lt_of_lt_of_le(x, next, later, lt, le),
                InBuffer(_) => λ _ => trivial,
                Gone => λ _ => trivial,
            }(h.left), locs_below_mono(rest, next, later, le, h.right)⟩,
    }
}

// Words below `out` are not `out`, so a region's writes and then `out`
// clear every variable the region's writes do.
theorem Loc::clear_join(locs: List<Loc>, ws: List<Nat>, out: Nat): Loc::clear(locs, ws).IsTrue() → LocsBelow(locs, out) →
    Loc::clear(locs, ws ++ [out]).IsTrue() {
    match locs {
        Nil => λ _ _ => trivial,
        Cons(l, rest) => λ clear below => {
            let parts = Bool::is_true_and(l.clear_one(ws), Loc::clear(rest, ws), clear);
            Bool::is_true_and_intro(l.clear_one(ws ++ [out]), Loc::clear(rest, ws ++ [out]),
                match l as λ k => k.clear_one(ws).IsTrue() → k.Under(out) → k.clear_one(ws ++ [out]).IsTrue() {
                    InWord(x) => λ h lt => absent_join(x, ws, [out], h,
                        Bool::is_true_and_intro(x.differs(out), True, match x.eq_dec(out) as λ d =>
                                Bool::IsTrue(match d { Inl(_) => False, Inr(_) => True }) {
                            Inl(e) => Nat::ne_of_lt(x, out, lt, e),
                            Inr(_) => trivial,
                        }, trivial)),
                    InBuffer(_) => λ _ _ => trivial,
                    Gone => λ _ _ => trivial,
                }(parts.left, below.left),
                Loc::clear_join(rest, ws, out, parts.right, below.right))
        },
    }
}

// ---------------------------------------------------------------------------
// Operands: each variable's code checked against the parameter's, and its
// place in the environment

// The place a parameter of code `p` is read from: a buffer for bytes, a word
// for the rest.
fn Loc::of(p: Ty, id: Nat) → Loc {
    match p { Word(_) => InWord(id), Bit => InWord(id), ByteList(_) => InBuffer(id), Lines => InWord(id), Named(_) => InWord(id), Count => InWord(id), Enum(_) => InWord(id) }
}

fn Loc::place(self l: Loc, p: Ty) → Option<Nat> {
    match p {
        ByteList(_) => match l { InWord(_) => None, InBuffer(b) => Some(b), Gone => None },
        Word(_) => match l { InWord(id) => Some(id), InBuffer(_) => None, Gone => None },
        Bit => match l { InWord(id) => Some(id), InBuffer(_) => None, Gone => None },
        Lines => match l { InWord(id) => Some(id), InBuffer(_) => None, Gone => None },
        Named(_) => match l { InWord(id) => Some(id), InBuffer(_) => None, Gone => None },
        Count => match l { InWord(id) => Some(id), InBuffer(_) => None, Gone => None },
        Enum(_) => match l { InWord(id) => Some(id), InBuffer(_) => None, Gone => None },
    }
}

theorem Loc::place_of(self l: Loc, p: Ty, id: Nat): l.place(p) = Some(id) → l = Loc::of(p, id) {
    match p {
        ByteList(c) => match l as λ k => k.place(ByteList(c)) = Some(id) → k = Loc::of(ByteList(c), id) {
            InWord(_) => λ e => Option::none_ne_some(id, e, InWord(_) = InBuffer(id)),
            InBuffer(b) => λ e => cong_fn(λ (n: Nat) => InBuffer(n), Option::some_inj(b, id, e)),
            Gone => λ e => Option::none_ne_some(id, e, Gone = InBuffer(id)),
        },
        Word(w) => match l as λ k => k.place(Word(w)) = Some(id) → k = Loc::of(Word(w), id) {
            InWord(x) => λ e => cong_fn(λ (n: Nat) => InWord(n), Option::some_inj(x, id, e)),
            InBuffer(_) => λ e => Option::none_ne_some(id, e, InBuffer(_) = InWord(id)),
            Gone => λ e => Option::none_ne_some(id, e, Gone = InWord(id)),
        },
        Bit => match l as λ k => k.place(Bit) = Some(id) → k = Loc::of(Bit, id) {
            InWord(x) => λ e => cong_fn(λ (n: Nat) => InWord(n), Option::some_inj(x, id, e)),
            InBuffer(_) => λ e => Option::none_ne_some(id, e, InBuffer(_) = InWord(id)),
            Gone => λ e => Option::none_ne_some(id, e, Gone = InWord(id)),
        },
        Lines => match l as λ k => k.place(Lines) = Some(id) → k = Loc::of(Lines, id) {
            InWord(x) => λ e => cong_fn(λ (n: Nat) => InWord(n), Option::some_inj(x, id, e)),
            InBuffer(_) => λ e => Option::none_ne_some(id, e, InBuffer(_) = InWord(id)),
            Gone => λ e => Option::none_ne_some(id, e, Gone = InWord(id)),
        },
        Named(i) => match l as λ k => k.place(Named(i)) = Some(id) → k = Loc::of(Named(i), id) {
            InWord(x) => λ e => cong_fn(λ (n: Nat) => InWord(n), Option::some_inj(x, id, e)),
            InBuffer(_) => λ e => Option::none_ne_some(id, e, InBuffer(_) = InWord(id)),
            Gone => λ e => Option::none_ne_some(id, e, Gone = InWord(id)),
        },
        Count => match l as λ k => k.place(Count) = Some(id) → k = Loc::of(Count, id) {
            InWord(x) => λ e => cong_fn(λ (n: Nat) => InWord(n), Option::some_inj(x, id, e)),
            InBuffer(_) => λ e => Option::none_ne_some(id, e, InBuffer(_) = InWord(id)),
            Gone => λ e => Option::none_ne_some(id, e, Gone = InWord(id)),
        },        Enum(i) => match l as λ k => k.place(Enum(i)) = Some(id) → k = Loc::of(Enum(i), id) {
            InWord(x) => λ e => cong_fn(λ (n: Nat) => InWord(n), Option::some_inj(x, id, e)),
            InBuffer(_) => λ e => Option::none_ne_some(id, e, InBuffer(_) = InWord(id)),
            Gone => λ e => Option::none_ne_some(id, e, Gone = InWord(id)),
        },
    }
}

fn ETm::operand_place(locs: List<Loc>, p: Ty, a: Nat) → Option<Nat> { Loc::at(locs, a).and_then(λ l => l.place(p)) }

// Variable `a` as an operand of code `p`: at `p`, and where it lives.
fn ETm::operand(g: List<Ty>, locs: List<Loc>, p: Ty, a: Nat) → Option<Nat> {
    Ty::at(g, a).check(p).and_then(λ _ => ETm::operand_place(locs, p, a))
}

fn ETm::operands(g: List<Ty>, locs: List<Loc>, ps: List<Ty>, args: List<Nat>) → Option<List<Nat>> {
    match ps {
        Nil => Some(Nil),
        Cons(p, rest) => match args {
            Nil => None,
            Cons(a, more) => ETm::operands(g, locs, rest, more).and_then(λ ids => ETm::operand(g, locs, p, a).and_then(λ id => Some(Cons(id, ids)))),
        },
    }
}

// Each operand, cast to its parameter's code as the meaning reads it, kept
// at its place.
fn ETm::OperandsKept(tys: Nat → RecInfo, env: Env, g: List<Ty>, vals: rt::Env(tys, g), ps: List<Ty>) → List<Nat> → List<Nat> → Type {
    match ps {
        Nil => λ args ids => True,
        Cons(p, rest) => λ args ids => match args {
            Nil => False,
            Cons(a, more) => match ids {
                Nil => False,
                Cons(id, more_ids) => p.Kept(tys, env, Loc::of(p, id), Ty::cast(tys, Ty::at(g, a), p, Env::get(tys, g, vals, a)))
                    ∧ ETm::OperandsKept(tys, env, g, vals, rest, more, more_ids),
            },
        },
    }
}

theorem ETm::operand_kept(tys: Nat → RecInfo, env: Env, g: List<Ty>, locs: List<Loc>, vals: rt::Env(tys, g),
    held: LocsHold(tys, env, g, locs, vals), p: Ty, a, id: Nat, e: ETm::operand(g, locs, p, a) = Some(id)):
    p.Kept(tys, env, Loc::of(p, id), Ty::cast(tys, Ty::at(g, a), p, Env::get(tys, g, vals, a))) {
    let P = λ (r: Option<Nat>) => r = Some(id) → p.Kept(tys, env, Loc::of(p, id), Ty::cast(tys, Ty::at(g, a), p, Env::get(tys, g, vals, a)));
    let none: P(None) = λ never => Option::none_ne_some(id, never, p.Kept(tys, env, Loc::of(p, id), Ty::cast(tys, Ty::at(g, a), p, Env::get(tys, g, vals, a))));
    Option::and_then_elim(P, none, Ty::at(g, a).check(p), λ _ => ETm::operand_place(locs, p, a), λ ea _ =>
    Option::and_then_elim(P, none, Loc::at(locs, a), λ l => l.place(p), λ l at_l => λ placed => {
        let kept = locs_hold_at(tys, env, g, locs, vals, held, a, l, at_l);
        let at_of: (l = Loc::of(p, id)) = l.place_of(p, id, placed);
        j(sym(ea), λ t _ => (v: t.sem(tys)) → t.Kept(tys, env, l, v) → p.Kept(tys, env, Loc::of(p, id), Ty::cast(tys, t, p, v)),
            λ v k => j(sym(Ty::cast_self(tys, p, v)), λ u _ => p.Kept(tys, env, Loc::of(p, id), u),
                j(at_of, λ x _ => p.Kept(tys, env, x, v), k)))(Env::get(tys, g, vals, a), kept)
    }))(e)
}

theorem ETm::operands_kept(tys: Nat → RecInfo, env: Env, g: List<Ty>, locs: List<Loc>, vals: rt::Env(tys, g),
    held: LocsHold(tys, env, g, locs, vals), ps: List<Ty>): (args: List<Nat>) → (ids: List<Nat>) →
    ETm::operands(g, locs, ps, args) = Some(ids) → ETm::OperandsKept(tys, env, g, vals, ps, args, ids) {
    match ps {
        Nil => λ args ids e => j(Option::some_inj(Nil, ids, e), λ z _ => ETm::OperandsKept(tys, env, g, vals, Nil, args, z), trivial),
        Cons(p, rest) => λ args => match args {
            Nil => λ ids e => Option::none_ne_some(ids, e, ETm::OperandsKept(tys, env, g, vals, Cons(p, rest), Nil, ids)),
            Cons(a, more) => λ ids => {
                let P = λ (r: Option<List<Nat>>) => r = Some(ids) → ETm::OperandsKept(tys, env, g, vals, Cons(p, rest), Cons(a, more), ids);
                let none: P(None) = λ never => Option::none_ne_some(ids, never, ETm::OperandsKept(tys, env, g, vals, Cons(p, rest), Cons(a, more), ids));
                Option::and_then_elim(P, none, ETm::operands(g, locs, rest, more),
                    λ tail => ETm::operand(g, locs, p, a).and_then(λ id => Some(Cons(id, tail))), λ tail e_tail =>
                Option::and_then_elim(P, none, ETm::operand(g, locs, p, a), λ id => Some(Cons(id, tail)), λ id e_id =>
                    λ (e: Some(Cons(id, tail)) = Some(ids)) => j(Option::some_inj(Cons(id, tail), ids, e),
                        λ z _ => ETm::OperandsKept(tys, env, g, vals, Cons(p, rest), Cons(a, more), z),
                        ⟨ETm::operand_kept(tys, env, g, locs, vals, held, p, a, id, e_id),
                            ETm::operands_kept(tys, env, g, locs, vals, held, rest, more, tail, e_tail)⟩)))
            },
        },
    }
}

// ---------------------------------------------------------------------------
// Each call, from where its operands live: the world the source's call
// leaves is the word-level method's, and its answer lands where the
// computation's results will live.

theorem ETm::word_of_kept(env: Env, id: Nat, v: BitVec(64), k: env.number(id) = v.toNat()): env.word(id) = v {
    trans(cong_fn<Nat, BitVec(64)>(λ n => BitVec::ofNat(n), k), BitVec::ofNat_toNat(64, v))
}

// A word read back at a width.
fn ETm::word_at(w: Nat, n: Nat) → BitVec(w) { BitVec::ofNat(n) }

theorem ETm::word_at_kept(w: Nat, env: Env, id: Nat, v: BitVec(w), k: env.number(id) = v.toNat()): ETm::word_at(w, env.number(id)) = v {
    trans(cong_fn<Nat, BitVec(w)>(λ n => BitVec::ofNat(n), k), BitVec::ofNat_toNat(w, v))
}

// A read's answer, either way it goes.
theorem ETm::read_answer(env: Env, locs: List<Loc>, fd, b, at, m, next: Nat, bufv: List<BitVec(8)>, atv: BitVec(64), kb: env.buffers.nth(b) = Some(bufv),
    ka: env.number(at) = atv.toNat(), below: LocsBelow(locs, next), r: ReadResult):
    (CallShape::Reads(fd, b, at, m, next).answer(env, r).buffers.nth(b) = Some(Io::landed(bufv, atv.toNat(), r).buf)) ∧
        ((CallShape::Reads(fd, b, at, m, next).answer(env, r).number(next) = Io::landed(bufv, atv.toNat(), r).result.toNat()) ∧
            Loc::AllSame(Loc::forget_all(locs, b), env, CallShape::Reads(fd, b, at, m, next).answer(env, r))) {
    match r {
        ReadBytes(bytes) => {
            let landed = fill_at(env.buffer(b), env.number(at), bytes);
            let filled = env.set_buffer(b, landed);
            ⟨trans(List::put_nth_here(b, env.buffers, landed, Nil),
                    eq2<List<BitVec(8)>, Nat, Option<List<BitVec(8)>>>(λ bs k => Some(fill_at(bs, k, bytes)), env.buffer_of_nth(b, bufv, kb), ka)),
                ⟨filled.number_set_here(next, count_word(bytes.len())),
                    Loc::same_trans(Loc::forget_all(locs, b), env, filled, filled.set_word(next, count_word(bytes.len())),
                        Loc::same_set_buffer(locs, env, b, landed),
                        Loc::same_set_word(Loc::forget_all(locs, b), filled, next, count_word(bytes.len()), locs_below_forget(locs, b, next, below)))⟩⟩
        },
        ReadFailed(errno) => ⟨kb, ⟨env.number_set_here(next, errno_word(errno)),
            Loc::same_set_word(Loc::forget_all(locs, b), env, next, errno_word(errno), locs_below_forget(locs, b, next, below))⟩⟩,
    }
}

theorem ETm::read_lands(env: Env, io: Io, locs: List<Loc>, fd, b, at, m, next: Nat, fdv: BitVec(64), bufv: List<BitVec(8)>, atv, maxv: BitVec(64),
    kfd: env.number(fd) = fdv.toNat(), kb: env.buffers.nth(b) = Some(bufv), ka: env.number(at) = atv.toNat(), km: env.number(m) = maxv.toNat(),
    below: LocsBelow(locs, next)):
    (Io::call(io, CallShape::Reads(fd, b, at, m, next).cmd(env)).after = Io::read_into(io, fdv, bufv, atv, maxv).after) ∧
        ((CallShape::Reads(fd, b, at, m, next).answer(env, Io::call(io, CallShape::Reads(fd, b, at, m, next).cmd(env)).value).buffers.nth(b) =
            Some(Io::read_into(io, fdv, bufv, atv, maxv).value.buf)) ∧
        ((CallShape::Reads(fd, b, at, m, next).answer(env, Io::call(io, CallShape::Reads(fd, b, at, m, next).cmd(env)).value).number(next) =
            Io::read_into(io, fdv, bufv, atv, maxv).value.result.toNat()) ∧
        Loc::AllSame(Loc::forget_all(locs, b), env, CallShape::Reads(fd, b, at, m, next).answer(env, Io::call(io, CallShape::Reads(fd, b, at, m, next).cmd(env)).value)))) {
    let n = maxv.toNat().min(bufv.len() - atv.toNat());
    let e_n: (env.number(m).min(env.buffer(b).len() - env.number(at)) = n) =
        trans(eq2<Nat, List<BitVec(8)>, Nat>(λ x bs => x.min(bs.len() - env.number(at)), km, env.buffer_of_nth(b, bufv, kb)),
            cong_fn<Nat, Nat>(λ y => maxv.toNat().min(bufv.len() - y), ka));
    let e_call: (Io::call(io, ReadCmd(env.word(fd), env.number(m).min(env.buffer(b).len() - env.number(at)))) = Io::call(io, ReadCmd(fdv, n))) =
        eq2<BitVec(64), Nat, Mutated<Io, ReadResult>>(λ f k => Io::call(io, ReadCmd(f, k)), ETm::word_of_kept(env, fd, fdv, kfd), e_n);
    let G = λ (M: Mutated<Io, ReadResult>) => (M.after = Io::read_into(io, fdv, bufv, atv, maxv).after) ∧
        ((CallShape::Reads(fd, b, at, m, next).answer(env, M.value).buffers.nth(b) = Some(Io::read_into(io, fdv, bufv, atv, maxv).value.buf)) ∧
        ((CallShape::Reads(fd, b, at, m, next).answer(env, M.value).number(next) = Io::read_into(io, fdv, bufv, atv, maxv).value.result.toNat()) ∧
        Loc::AllSame(Loc::forget_all(locs, b), env, CallShape::Reads(fd, b, at, m, next).answer(env, M.value))));
    let answered = ETm::read_answer(env, locs, fd, b, at, m, next, bufv, atv, kb, ka, below, Io::call(io, ReadCmd(fdv, n)).value);
    j(sym(e_call), λ M _ => G(M), ⟨refl, answered⟩)
}

theorem ETm::write_lands(env: Env, io: Io, locs: List<Loc>, fd, b, from, len, next: Nat, fdv: BitVec(64), bufv: List<BitVec(8)>,
    fromv, lenv: BitVec(64), kfd: env.number(fd) = fdv.toNat(), kb: env.buffers.nth(b) = Some(bufv), kf: env.number(from) = fromv.toNat(),
    kl: env.number(len) = lenv.toNat(), below: LocsBelow(locs, next)):
    (Io::call(io, CallShape::Writes(fd, b, from, len, next).cmd(env)).after = Io::write_from(io, fdv, bufv, fromv, lenv).after) ∧
        ((CallShape::Writes(fd, b, from, len, next).answer(env, Io::call(io, CallShape::Writes(fd, b, from, len, next).cmd(env)).value).number(next) =
            Io::write_from(io, fdv, bufv, fromv, lenv).value.toNat()) ∧
        Loc::AllSame(locs, env, CallShape::Writes(fd, b, from, len, next).answer(env, Io::call(io, CallShape::Writes(fd, b, from, len, next).cmd(env)).value))) {
    let bytes = span(bufv, fromv.toNat(), lenv.toNat());
    let e_bytes: (span(env.buffer(b), env.number(from), env.number(len)) = bytes) =
        trans(eq2<List<BitVec(8)>, Nat, List<BitVec(8)>>(λ bs x => span(bs, x, env.number(len)), env.buffer_of_nth(b, bufv, kb), kf),
            cong_fn<Nat, List<BitVec(8)>>(λ y => span(bufv, fromv.toNat(), y), kl));
    let e_call: (Io::call(io, WriteCmd(env.word(fd), span(env.buffer(b), env.number(from), env.number(len)))) = Io::call(io, WriteCmd(fdv, bytes))) =
        eq2<BitVec(64), List<BitVec(8)>, Mutated<Io, WriteResult>>(λ f bs => Io::call(io, WriteCmd(f, bs)), ETm::word_of_kept(env, fd, fdv, kfd), e_bytes);
    let G = λ (M: Mutated<Io, WriteResult>) => (M.after = Io::write_from(io, fdv, bufv, fromv, lenv).after) ∧
        ((CallShape::Writes(fd, b, from, len, next).answer(env, M.value).number(next) = Io::write_from(io, fdv, bufv, fromv, lenv).value.toNat()) ∧
        Loc::AllSame(locs, env, CallShape::Writes(fd, b, from, len, next).answer(env, M.value)));
    let r = Io::call(io, WriteCmd(fdv, bytes)).value;
    let answered: ((CallShape::Writes(fd, b, from, len, next).answer(env, r).number(next) = Io::write_word(r).toNat()) ∧
            Loc::AllSame(locs, env, CallShape::Writes(fd, b, from, len, next).answer(env, r))) =
        match r as λ x => (CallShape::Writes(fd, b, from, len, next).answer(env, x).number(next) = Io::write_word(x).toNat()) ∧
                Loc::AllSame(locs, env, CallShape::Writes(fd, b, from, len, next).answer(env, x)) {
            Wrote(count) => ⟨env.number_set_here(next, count_word(count)), Loc::same_set_word(locs, env, next, count_word(count), below)⟩,
            WriteFailed(errno) => ⟨env.number_set_here(next, errno_word(errno)), Loc::same_set_word(locs, env, next, errno_word(errno), below)⟩,
        };
    j(sym(e_call), λ M _ => G(M), ⟨refl, answered⟩)
}

theorem ETm::open_lands(env: Env, io: Io, locs: List<Loc>, path, len, next: Nat, pathv: List<BitVec(8)>, lenv: BitVec(64),
    kp: env.buffers.nth(path) = Some(pathv), kl: env.number(len) = lenv.toNat(), below: LocsBelow(locs, next)):
    (Io::call(io, CallShape::Opens(path, len, next).cmd(env)).after = Io::open_path(io, pathv, lenv).after) ∧
        ((CallShape::Opens(path, len, next).answer(env, Io::call(io, CallShape::Opens(path, len, next).cmd(env)).value).number(next) =
            Io::open_path(io, pathv, lenv).value.toNat()) ∧
        Loc::AllSame(locs, env, CallShape::Opens(path, len, next).answer(env, Io::call(io, CallShape::Opens(path, len, next).cmd(env)).value))) {
    let named = pathv.take(lenv.toNat()).before_nul();
    let e_call: (Io::call(io, OpenCmd(env.buffer(path).take(env.number(len)).before_nul())) = Io::call(io, OpenCmd(named))) =
        cong_fn<List<BitVec(8)>, Mutated<Io, OpenResult>>(λ bs => Io::call(io, OpenCmd(bs)),
            eq2<List<BitVec(8)>, Nat, List<BitVec(8)>>(λ bs x => bs.take(x).before_nul(), env.buffer_of_nth(path, pathv, kp), kl));
    let G = λ (M: Mutated<Io, OpenResult>) => (M.after = Io::open_path(io, pathv, lenv).after) ∧
        ((CallShape::Opens(path, len, next).answer(env, M.value).number(next) = Io::open_path(io, pathv, lenv).value.toNat()) ∧
        Loc::AllSame(locs, env, CallShape::Opens(path, len, next).answer(env, M.value)));
    let r = Io::call(io, OpenCmd(named)).value;
    let answered: ((CallShape::Opens(path, len, next).answer(env, r).number(next) = Io::open_word(r).toNat()) ∧
            Loc::AllSame(locs, env, CallShape::Opens(path, len, next).answer(env, r))) =
        match r as λ x => (CallShape::Opens(path, len, next).answer(env, x).number(next) = Io::open_word(x).toNat()) ∧
                Loc::AllSame(locs, env, CallShape::Opens(path, len, next).answer(env, x)) {
            Opened(fd) => ⟨env.number_set_here(next, count_word(fd)), Loc::same_set_word(locs, env, next, count_word(fd), below)⟩,
            OpenFailed(errno) => ⟨env.number_set_here(next, errno_word(errno)), Loc::same_set_word(locs, env, next, errno_word(errno), below)⟩,
        };
    j(sym(e_call), λ M _ => G(M), ⟨refl, answered⟩)
}

theorem ETm::close_lands(env: Env, io: Io, locs: List<Loc>, fd, next: Nat, fdv: BitVec(64), kfd: env.number(fd) = fdv.toNat(),
    below: LocsBelow(locs, next)):
    (Io::call(io, CallShape::Closes(fd, next).cmd(env)).after = Io::close_fd(io, fdv).after) ∧
        ((CallShape::Closes(fd, next).answer(env, Io::call(io, CallShape::Closes(fd, next).cmd(env)).value).number(next) =
            Io::close_fd(io, fdv).value.toNat()) ∧
        Loc::AllSame(locs, env, CallShape::Closes(fd, next).answer(env, Io::call(io, CallShape::Closes(fd, next).cmd(env)).value))) {
    let e_call: (Io::call(io, CloseCmd(env.word(fd))) = Io::call(io, CloseCmd(fdv))) =
        cong_fn<BitVec(64), Mutated<Io, CloseResult>>(λ f => Io::call(io, CloseCmd(f)), ETm::word_of_kept(env, fd, fdv, kfd));
    let G = λ (M: Mutated<Io, CloseResult>) => (M.after = Io::close_fd(io, fdv).after) ∧
        ((CallShape::Closes(fd, next).answer(env, M.value).number(next) = Io::close_fd(io, fdv).value.toNat()) ∧
        Loc::AllSame(locs, env, CallShape::Closes(fd, next).answer(env, M.value)));
    let r = Io::call(io, CloseCmd(fdv)).value;
    let answered: ((CallShape::Closes(fd, next).answer(env, r).number(next) = Io::close_word(r).toNat()) ∧
            Loc::AllSame(locs, env, CallShape::Closes(fd, next).answer(env, r))) =
        match r as λ x => (CallShape::Closes(fd, next).answer(env, x).number(next) = Io::close_word(x).toNat()) ∧
                Loc::AllSame(locs, env, CallShape::Closes(fd, next).answer(env, x)) {
            Closed => ⟨env.number_set_here(next, count_word(0)), Loc::same_set_word(locs, env, next, count_word(0), below)⟩,
            CloseFailed(errno) => ⟨env.number_set_here(next, errno_word(errno)), Loc::same_set_word(locs, env, next, errno_word(errno), below)⟩,
        };
    j(sym(e_call), λ M _ => G(M), ⟨refl, answered⟩)
}

// ---------------------------------------------------------------------------
// Pure values: the pure lowering's region, its result moved to a fresh word

// A code held in one port at its own width: a word or a bit (`Ty::OneWord`,
// `rt_lower.hthr`, is the boundary's: one 64-bit word, records included).
fn Ty::Scalar(self t: Ty) → Type {
    match t { Word(_) => True, Bit => True, ByteList(_) => False, Lines => False, Named(_) => False, Count => False, Enum(_) => False }
}

fn Ty::check_scalar(self t: Ty) → Option<t.Scalar()> {
    match t as λ x => Option<x.Scalar()> {
        Word(_) => Some(trivial), Bit => Some(trivial), ByteList(_) => None, Lines => None, Named(_) => None, Count => None, Enum(_) => None,
    }
}

// A value held at `port` at its code's width, moved to `out`, is kept there.
theorem Ty::kept_moved(self t: Ty, tys: Nat → RecInfo, env: Env, out: Nat, values: Valuation(), port: Nat, one: t.Scalar(), v: t.sem(tys),
    h: t.Holds(tys, values, port, v), e: env.number(out) = values(t.width(), port).toNat()): t.Kept(tys, env, InWord(out), v) {
    match t as λ x => x.Scalar() → (v: x.sem(tys)) → x.Holds(tys, values, port, v) → env.number(out) = values(x.width(), port).toNat() →
            x.Kept(tys, env, InWord(out), v) {
        Word(wd) => λ _ v h e => trans(e, cong_fn(λ (x: BitVec(wd)) => x.toNat(), h)),
        Bit => λ _ v h e => trans(e, cong_fn(λ (x: BitVec(1)) => x.toNat(), h)),
        ByteList(_) => λ never => false_elim(never),
        Lines => λ never => false_elim(never),
        Named(_) => λ never => false_elim(never),
        Count => λ never => false_elim(never),
        Enum(_) => λ never => false_elim(never),
    }(one, v, h, e)
}

fn ETm::moved(t: Ty, l: Lowered) → StructuredRegion {
    Compose(l.region, Dataflow(Region(Ports(Nil), [Move(t.width(), l.next, l.result)], Ports(Nil))))
}

// Settling ports in two runs is settling them in one.
theorem Env::settle_append(after: Valuation(), xs, ys: List<Port>): (env: Env) →
    env.settle(after, xs ++ ys) = env.settle(after, xs).settle(after, ys) {
    match xs {
        Nil => λ env => refl,
        Cons(port, rest) => λ env => Env::settle_append(after, rest, ys, native_source::Env(env.words.put(port.id, after(port.width, port.id).toNat(), 0), env.buffers, env.args)),
    }
}

// A bit kept where its region wrote it: the region's last node writes `id`
// at one bit (a comparison), so nothing settles after it. The compiler
// takes only wide moves, so a bit moved to a fresh word would not compile;
// one left in its own port does.
fn ETm::nodes_end_at(nodes: List<Node>, id: Nat) → Bool {
    match nodes {
        Nil => False,
        Cons(node, rest) => match rest {
            Nil => node_output(node).id.matches(id) && node_output(node).width.matches(1),
            Cons(_, _) => ETm::nodes_end_at(rest, id),
        },
    }
}

fn ETm::ends_at(region: StructuredRegion, id: Nat) → Bool {
    match region {
        Dataflow(body) => ETm::nodes_end_at(body.nodes, id),
        Compose(_, continuation) => ETm::ends_at(continuation, id),
        Sequence(_, _) => False,
        Conditional(_, _, _, _, _, _) => False,
        Call(_, _, _) => False,
        Lend(_, _, _, _) => False,
        Loop(_, _, _, _, _, _, _, _, _) => False,
    }
}

// One port that writes `id` at one bit settles to that bit.
theorem ETm::settle_one(after: Valuation(), p: Port, id: Nat, env: Env, h: (p.id.matches(id) && p.width.matches(1)).IsTrue()):
    env.settle(after, [p]).number(id) = after(1, id).toNat() {
    let parts = Bool::is_true_and(p.id.matches(id), p.width.matches(1), h);
    j(p.id.matches_eq(id, parts.left), λ x _ => env.settle(after, [p]).number(x) = after(1, x).toNat(),
        j(p.width.matches_eq(1, parts.right), λ y _ => env.settle(after, [p]).number(p.id) = after(y, p.id).toNat(),
            Env::settle_last(after, p, Nil, env)))
}

theorem ETm::nodes_settle_end(after: Valuation(), nodes: List<Node>, id: Nat): (env: Env) → ETm::nodes_end_at(nodes, id).IsTrue() →
    env.settle(after, nodes_write_ports(nodes)).number(id) = after(1, id).toNat() {
    match nodes {
        Nil => λ env never => false_elim(never),
        Cons(node, rest) => match rest as λ r => ((e: Env) → ETm::nodes_end_at(r, id).IsTrue() → e.settle(after, nodes_write_ports(r)).number(id) = after(1, id).toNat()) →
                (env: Env) → ETm::nodes_end_at(Cons(node, r), id).IsTrue() → env.settle(after, nodes_write_ports(Cons(node, r))).number(id) = after(1, id).toNat() {
            Nil => λ _ env h => ETm::settle_one(after, node_output(node), id, env, h),
            Cons(_, _) => λ ih env h => ih(native_source::Env(env.words.put(node_output(node).id, after(node_output(node).width, node_output(node).id).toNat(), 0), env.buffers, env.args), h),
        }(λ e h => ETm::nodes_settle_end(after, rest, id, e, h)),
    }
}

theorem ETm::settle_end(region: StructuredRegion, id: Nat, call: Writers()): (values: Valuation()) → (buffers: Buffers()) → (after: Valuation()) → (env: Env) →
    ETm::ends_at(region, id).IsTrue() → env.settle(after, region.written(call, values, buffers)).number(id) = after(1, id).toNat() {
    match region {
        Dataflow(body) => λ values buffers after env h => ETm::nodes_settle_end(after, body.nodes, id, env, h),
        Compose(prefix, continuation) => λ values buffers after env h => {
            let mid = prefix.run(call, values, buffers);
            trans(cong_fn(λ (e: Env) => e.number(id),
                    Env::settle_append(after, prefix.written(call, values, buffers), continuation.written(call, mid.values, mid.buffers), env)),
                ETm::settle_end(continuation, id, call, mid.values, mid.buffers, after, env.settle(after, prefix.written(call, values, buffers)), h))
        },
        Sequence(_, _) => λ values buffers after env never => false_elim(never),
        Conditional(_, _, _, _, _, _) => λ values buffers after env never => false_elim(never),
        Call(_, _, _) => λ values buffers after env never => false_elim(never),
        Lend(_, _, _, _) => λ values buffers after env never => false_elim(never),
        Loop(_, _, _, _, _, _, _, _, _) => λ values buffers after env never => false_elim(never),
    }
}

// Where a value's lowering leaves it: a bit its region's last node wrote,
// in that port, where the port is fresh and the next one free after it;
// anything else moved to a fresh word.
fn ETm::placed_bit(b: Bool, l: Lowered) → Lowered {
    match b { True => l, False => Lowered(ETm::moved(Bit, l), l.next, l.next + 1) }
}

fn ETm::bit_stays(next: Nat, l: Lowered) → Bool {
    ETm::ends_at(l.region, l.result) && (next.leb(l.result) && l.next.matches(l.result + 1))
}

fn ETm::placed(t: Ty, next: Nat, l: Lowered) → Lowered {
    match t {
        Bit => ETm::placed_bit(ETm::bit_stays(next, l), l),
        Word(_) => Lowered(ETm::moved(t, l), l.next, l.next + 1),
        ByteList(_) => Lowered(ETm::moved(t, l), l.next, l.next + 1),
        Lines => Lowered(ETm::moved(t, l), l.next, l.next + 1),
        Named(_) => Lowered(ETm::moved(t, l), l.next, l.next + 1),
        Count => Lowered(ETm::moved(t, l), l.next, l.next + 1),
        Enum(_) => Lowered(ETm::moved(t, l), l.next, l.next + 1),
    }
}

fn ETm::value_checked(t: Ty, base: Nat, locs: List<Loc>, next: Nat, l: Lowered) → Option<Lowered> {
    Tm::check_true(l.region.byte_free() && l.region.calls_among(functions_below(base))).and_then(λ _ =>
        Tm::check_true(Loc::clear(locs, l.region.writes())).and_then(λ _ => Some(ETm::placed(t, next, l))))
}

// The functions a pure term calls are the world's, numbered below its
// count; a program may have functions that write after them.
fn ETm::lower_value(v: Tm, w: rt::World, g: List<Ty>, locs: List<Loc>, next: Nat) → Option<Lowered> {
    Tm::ty(v, w, g).check_scalar().and_then(λ _ =>
        Tm::lower(v, w, g, Loc::ports(locs), next).and_then(λ l => ETm::value_checked(Tm::ty(v, w, g), w.sigs.len(), locs, next, l)))
}

// What a placed value promises, for a value of type `t` meaning `m`: the
// region keeps every variable and leaves the value in a word at or past
// `next`, the next one free after it.
fn ETm::PlacedHolds(t: Ty, w: rt::World, g: List<Ty>, locs: List<Loc>, next: Nat, m: rt::Env(w.tys, g) → t.sem(w.tys), c: Lowered) → Type {
    (c.next = c.result + 1) ∧ ((call: Writers()) → Writers::Still(call, functions_below(w.sigs.len())) → ((held: Buffers()) → Tm::CallsAgree(w, Writers::words(call, held))) → (env: Env) → (vals: rt::Env(w.tys, g)) →
        LocsHold(w.tys, env, g, locs, vals) → LocsBelow(locs, next) → 0 < next →
        (next <= c.result) ∧ LocsHold(w.tys, env.compute(call, c.region), Cons(t, g), Cons(InWord(c.result), locs), Pair(m(vals), vals)))
}

// The value's region moves `next` up to its fresh word, keeps every
// variable, and leaves the value in the fresh word.
fn ETm::ValueHolds(v: Tm, w: rt::World, g: List<Ty>, locs: List<Loc>, next: Nat, r: Option<Lowered>) → Type {
    match r {
        None => True,
        Some(c) => (c.next = c.result + 1) ∧ ((call: Writers()) → Writers::Still(call, functions_below(w.sigs.len())) → ((held: Buffers()) → Tm::CallsAgree(w, Writers::words(call, held))) → (env: Env) → (vals: rt::Env(w.tys, g)) →
            LocsHold(w.tys, env, g, locs, vals) → LocsBelow(locs, next) → 0 < next →
            (next <= c.result) ∧ LocsHold(w.tys, env.compute(call, c.region), Cons(Tm::ty(v, w, g), g), Cons(InWord(c.result), locs),
                Pair(Tm::sem(v, w, g, vals), vals))),
    }
}

// What the pure lowering's region was proved to do, read over the file.
fn ETm::RegionRan(t: Ty, w: rt::World, g: List<Ty>, locs: List<Loc>, next: Nat, m: rt::Env(w.tys, g) → t.sem(w.tys), l: Lowered) → Type {
    (call: Writers()) → ((held: Buffers()) → Tm::CallsAgree(w, Writers::words(call, held))) → (env: Env) → (vals: rt::Env(w.tys, g)) →
        LocsHold(w.tys, env, g, locs, vals) → LocsBelow(locs, next) → 0 < next →
        (next <= l.next) ∧ t.Holds(w.tys, l.region.eval(Writers::words(call, env.buffers), env.valuation()), l.result, m(vals))
}

// Moved to a fresh word.
theorem ETm::moved_sound(t: Ty, w: rt::World, g: List<Ty>, locs: List<Loc>, next: Nat, m: rt::Env(w.tys, g) → t.sem(w.tys), l: Lowered,
    one: t.Scalar(), ok: (l.region.byte_free() && l.region.calls_among(functions_below(w.sigs.len()))).IsTrue(),
    clear: Loc::clear(locs, l.region.writes()).IsTrue(), ran: ETm::RegionRan(t, w, g, locs, next, m, l)):
    ETm::PlacedHolds(t, w, g, locs, next, m, Lowered(ETm::moved(t, l), l.next, l.next + 1)) {
    ⟨refl, λ call still agree env vals held below pos => {
        let among = functions_below(w.sigs.len());
        let checked = Bool::is_true_and(l.region.byte_free(), l.region.calls_among(among), ok);
        let free = checked.left;
        let r = ran(call, agree, env, vals, held, below, pos);
        let region = ETm::moved(t, l);
        let free2: region.byte_free().IsTrue() = Bool::is_true_and_intro(l.region.byte_free(),
            Dataflow(Region(Ports(Nil), [Move(t.width(), l.next, l.result)], Ports(Nil))).byte_free(), free, trivial);
        let fits2: region.calls_among(among).IsTrue() = Bool::is_true_and_intro(l.region.calls_among(among), True, checked.right, trivial);
        let keeps = env.compute_buffers(call, among, still, region, free2, fits2);
        let clear2 = Loc::clear_join(locs, l.region.writes(), l.next, clear, locs_below_mono(locs, next, l.next, r.left, below));
        let same = Loc::same_compute(env, call, region, keeps, locs, clear2);
        let number = env.compute_moved(call, among, still, l.region, free, checked.right, t.width(), l.next, l.result);
        ⟨r.left, ⟨t.kept_moved(w.tys, env.compute(call, region), l.next, l.region.eval(Writers::words(call, env.buffers), env.valuation()), l.result, one,
                m(vals), r.right, number),
            locs_hold_same(w.tys, env, env.compute(call, region), g, locs, vals, same, held)⟩⟩
    }⟩
}

// Left in its own port: the port is the region's last write, so the file
// reads it there.
theorem ETm::bit_kept_sound(w: rt::World, g: List<Ty>, locs: List<Loc>, next: Nat, m: rt::Env(w.tys, g) → Bool, l: Lowered,
    ok: (l.region.byte_free() && l.region.calls_among(functions_below(w.sigs.len()))).IsTrue(),
    clear: Loc::clear(locs, l.region.writes()).IsTrue(), ran: ETm::RegionRan(Bit, w, g, locs, next, m, l), stays: ETm::bit_stays(next, l).IsTrue()):
    ETm::PlacedHolds(Bit, w, g, locs, next, m, l) {
    let parts = Bool::is_true_and(ETm::ends_at(l.region, l.result), next.leb(l.result) && l.next.matches(l.result + 1), stays);
    let fresh = Bool::is_true_and(next.leb(l.result), l.next.matches(l.result + 1), parts.right);
    ⟨l.next.matches_eq(l.result + 1, fresh.right), λ call still agree env vals held below pos => {
        let among = functions_below(w.sigs.len());
        let checked = Bool::is_true_and(l.region.byte_free(), l.region.calls_among(among), ok);
        let r = ran(call, agree, env, vals, held, below, pos);
        let keeps = env.compute_buffers(call, among, still, l.region, checked.left, checked.right);
        let same = Loc::same_compute(env, call, l.region, keeps, locs, clear);
        let after = l.region.run(call, env.valuation(), env.buffers);
        let number = trans(ETm::settle_end(l.region, l.result, call, env.valuation(), env.buffers, after.values, native_source::Env(env.words, after.buffers, env.args), parts.left),
            cong_fn(λ (s: State) => s.values(1, l.result).toNat(), l.region.run_byte_free(call, among, still, checked.left, checked.right, env.valuation(), env.buffers)));
        ⟨next.leb_sound(l.result, fresh.left), ⟨Bit.kept_moved(w.tys, env.compute(call, l.region), l.result, l.region.eval(Writers::words(call, env.buffers), env.valuation()), l.result, trivial,
                m(vals), r.right, number),
            locs_hold_same(w.tys, env, env.compute(call, l.region), g, locs, vals, same, held)⟩⟩
    }⟩
}

theorem ETm::placed_sound(t: Ty, w: rt::World, g: List<Ty>, locs: List<Loc>, next: Nat, l: Lowered,
    ok: (l.region.byte_free() && l.region.calls_among(functions_below(w.sigs.len()))).IsTrue(), clear: Loc::clear(locs, l.region.writes()).IsTrue()):
    (m: rt::Env(w.tys, g) → t.sem(w.tys)) → t.Scalar() → ETm::RegionRan(t, w, g, locs, next, m, l) → ETm::PlacedHolds(t, w, g, locs, next, m, ETm::placed(t, next, l)) {
    match t as λ x => (m: rt::Env(w.tys, g) → x.sem(w.tys)) → x.Scalar() → ETm::RegionRan(x, w, g, locs, next, m, l) → ETm::PlacedHolds(x, w, g, locs, next, m, ETm::placed(x, next, l)) {
        Bit => λ m one ran => match ETm::bit_stays(next, l) as λ b => (b.IsTrue() → ETm::PlacedHolds(Bit, w, g, locs, next, m, l)) →
                ETm::PlacedHolds(Bit, w, g, locs, next, m, ETm::placed_bit(b, l)) {
            True => λ k => k(trivial),
            False => λ _ => ETm::moved_sound(Bit, w, g, locs, next, m, l, one, ok, clear, ran),
        }(λ stays => ETm::bit_kept_sound(w, g, locs, next, m, l, ok, clear, ran, stays)),
        Word(wd) => λ m one ran => ETm::moved_sound(Word(wd), w, g, locs, next, m, l, one, ok, clear, ran),
        ByteList(c) => λ m one ran => ETm::moved_sound(ByteList(c), w, g, locs, next, m, l, one, ok, clear, ran),
        Lines => λ m one ran => ETm::moved_sound(Lines, w, g, locs, next, m, l, one, ok, clear, ran),
        Named(i) => λ m one ran => ETm::moved_sound(Named(i), w, g, locs, next, m, l, one, ok, clear, ran),
        Count => λ m one ran => ETm::moved_sound(Count, w, g, locs, next, m, l, one, ok, clear, ran),
        Enum(i) => λ m one ran => ETm::moved_sound(Enum(i), w, g, locs, next, m, l, one, ok, clear, ran),
    }
}

theorem ETm::value_sound(v: Tm, w: rt::World, g: List<Ty>, locs: List<Loc>, next: Nat):
    ETm::ValueHolds(v, w, g, locs, next, ETm::lower_value(v, w, g, locs, next)) {
    let P = λ (r: Option<Lowered>) => ETm::ValueHolds(v, w, g, locs, next, r);
    let t = Tm::ty(v, w, g);
    Option::and_then_elim(P, trivial, t.check_scalar(),
        λ _ => Tm::lower(v, w, g, Loc::ports(locs), next).and_then(λ l => ETm::value_checked(t, w.sigs.len(), locs, next, l)), λ one _ =>
    Option::and_then_elim(P, trivial, Tm::lower(v, w, g, Loc::ports(locs), next), λ l => ETm::value_checked(t, w.sigs.len(), locs, next, l), λ l e_l =>
    Option::and_then_elim(P, trivial, Tm::check_true(l.region.byte_free() && l.region.calls_among(functions_below(w.sigs.len()))),
        λ _ => Tm::check_true(Loc::clear(locs, l.region.writes())).and_then(λ _ => Some(ETm::placed(t, next, l))), λ ok _ =>
    Option::and_then_elim(P, trivial, Tm::check_true(Loc::clear(locs, l.region.writes())),
        λ _ => Some(ETm::placed(t, next, l)), λ clear _ => {
        let free = Bool::is_true_and(l.region.byte_free(), l.region.calls_among(functions_below(w.sigs.len())), ok).left;
        let lowered = j(e_l, λ r _ => Tm::LowerHolds(v, w, g, Loc::ports(locs), next, r), Tm::lower_sound(v, w, g, Loc::ports(locs), next));
        // The lowering is proved over the world's spans; a byte-free region
        // evaluates alike over none.
        let ran: ETm::RegionRan(t, w, g, locs, next, λ vals => Tm::sem(v, w, g, vals), l) = λ call agree env vals held below pos => {
            let r = lowered(Writers::words(call, env.buffers), agree(env.buffers), env.valuation(), vals, locs_env_holds(w.tys, env, g, locs, vals, held),
                locs_below(w.tys, env, g, next, pos, locs, vals, held, below));
            ⟨r.left, j(l.region.eval_byte_free(Writers::words(call, env.buffers), w.spans, free, env.valuation()),
                λ u _ => t.Holds(w.tys, u, l.result, Tm::sem(v, w, g, vals)), r.right.right.right)⟩
        };
        ETm::placed_sound(t, w, g, locs, next, l, ok, clear, λ vals => Tm::sem(v, w, g, vals), one, ran)
    }))))
}

// ---------------------------------------------------------------------------
// Calls: the shape names the operands' places, and the result word is fresh

record Called { shape: CallShape, locs: List<Loc> }

// The shape, and where the call's results live after it: the result word at
// `next`; a read's buffer where it landed, every variable that was there
// gone.
fn ETm::called(e: Effect, next: Nat, locs: List<Loc>, ids: List<Nat>) → Option<Called> {
    match e {
        Reads(_) => match ids {
            Nil => None,
            Cons(fd, r1) => match r1 {
                Nil => None,
                Cons(b, r2) => match r2 {
                    Nil => None,
                    Cons(at, r3) => match r3 {
                        Nil => None,
                        Cons(m, _) => Some(Called(CallShape::Reads(fd, b, at, m, next), Cons(InWord(next), Cons(InBuffer(b), Loc::forget_all(locs, b))))),
                    },
                },
            },
        },
        Writes(_) => match ids {
            Nil => None,
            Cons(fd, r1) => match r1 {
                Nil => None,
                Cons(b, r2) => match r2 {
                    Nil => None,
                    Cons(from, r3) => match r3 {
                        Nil => None,
                        Cons(len, _) => Some(Called(CallShape::Writes(fd, b, from, len, next), Cons(InWord(next), locs))),
                    },
                },
            },
        },
        Opens(_) => match ids {
            Nil => None,
            Cons(path, r1) => match r1 {
                Nil => None,
                Cons(len, _) => Some(Called(CallShape::Opens(path, len, next), Cons(InWord(next), locs))),
            },
        },
        Closes => match ids {
            Nil => None,
            Cons(fd, _) => Some(Called(CallShape::Closes(fd, next), Cons(InWord(next), locs))),
        },
    }
}

fn ETm::lower_call(e: Effect, g: List<Ty>, locs: List<Loc>, next: Nat, args: List<Nat>) → Option<Called> {
    ETm::operands(g, locs, e.params(), args).and_then(λ ids => ETm::called(e, next, locs, ids))
}

// The call the meaning makes: the effect at its operands.
fn ETm::applied(e: Effect, w: rt::World, g: List<Ty>, vals: rt::Env(w.tys, g), io: Io, args: List<Nat>) → Mutated<Io, Ty::Flats(e.results())> {
    Effect::apply(w, g, vals, Mutated<Io, Ty::Flats(e.results())>, Mutated(io, Ty::flats_default(e.results())), e.params(), e.sem(w.tys, io), args)
}

// The source's call leaves the meaning's world, and its answer lands where
// the results now live, every other variable kept.
fn ETm::Answered(e: Effect, w: rt::World, g: List<Ty>, vals: rt::Env(w.tys, g), io: Io, args: List<Nat>, next: Nat, k: Called, env: Env) → Type {
    (Io::call(io, k.shape.cmd(env)).after = ETm::applied(e, w, g, vals, io, args).after) ∧
        (LocsHold(w.tys, k.shape.answer(env, Io::call(io, k.shape.cmd(env)).value), Ty::bind_onto(e.results(), g), k.locs,
            Effect::push(w.tys, e.results(), g, vals, ETm::applied(e, w, g, vals, io, args).value))
        ∧ LocsBelow(k.locs, next + 1))
}

fn ETm::CallHolds(e: Effect, w: rt::World, g: List<Ty>, locs: List<Loc>, next: Nat, args: List<Nat>, r: Option<Called>) → Type {
    match r {
        None => True,
        Some(k) => (env: Env) → (vals: rt::Env(w.tys, g)) → (io: Io) → LocsHold(w.tys, env, g, locs, vals) → LocsBelow(locs, next) →
            ETm::Answered(e, w, g, vals, io, args, next, k, env),
    }
}

theorem ETm::next_below(locs: List<Loc>, next: Nat, below: LocsBelow(locs, next)): LocsBelow(Cons(InWord(next), locs), next + 1) {
    ⟨next.lt_succ_self(), locs_below_mono(locs, next, next + 1, Nat::le_succ_r(next, next, next.le_refl()), below)⟩
}

theorem ETm::called_sound(e: Effect, w: rt::World, g: List<Ty>, locs: List<Loc>, next: Nat, args: List<Nat>, ids: List<Nat>):
    ((env: Env) → (vals: rt::Env(w.tys, g)) → LocsHold(w.tys, env, g, locs, vals) → ETm::OperandsKept(w.tys, env, g, vals, e.params(), args, ids)) →
    ETm::CallHolds(e, w, g, locs, next, args, ETm::called(e, next, locs, ids)) {
    match e {
        Reads(c) => match ids {
            Nil => λ _ => trivial,
            Cons(fd, r1) => match r1 {
                Nil => λ _ => trivial,
                Cons(b, r2) => match r2 {
                    Nil => λ _ => trivial,
                    Cons(at, r3) => match r3 {
                        Nil => λ _ => trivial,
                        Cons(m, r4) => λ ok env vals io held below => {
                            let ids4 = Cons(fd, Cons(b, Cons(at, Cons(m, r4))));
                            let k = Called(CallShape::Reads(fd, b, at, m, next), Cons(InWord(next), Cons(InBuffer(b), Loc::forget_all(locs, b))));
                            match args as λ a => ETm::OperandsKept(w.tys, env, g, vals, Effect::params(Effect::Reads(c)), a, ids4) →
                                    ETm::Answered(Effect::Reads(c), w, g, vals, io, a, next, k, env) {
                                Nil => λ never => false_elim(never),
                                Cons(x, a1) => match a1 as λ a => ETm::OperandsKept(w.tys, env, g, vals, Effect::params(Effect::Reads(c)), Cons(x, a), ids4) →
                                        ETm::Answered(Effect::Reads(c), w, g, vals, io, Cons(x, a), next, k, env) {
                                    Nil => λ never => false_elim(never.right),
                                    Cons(y, a2) => match a2 as λ a => ETm::OperandsKept(w.tys, env, g, vals, Effect::params(Effect::Reads(c)), Cons(x, Cons(y, a)), ids4) →
                                            ETm::Answered(Effect::Reads(c), w, g, vals, io, Cons(x, Cons(y, a)), next, k, env) {
                                        Nil => λ never => false_elim(never.right.right),
                                        Cons(z, a3) => match a3 as λ a => ETm::OperandsKept(w.tys, env, g, vals, Effect::params(Effect::Reads(c)), Cons(x, Cons(y, Cons(z, a))), ids4) →
                                                ETm::Answered(Effect::Reads(c), w, g, vals, io, Cons(x, Cons(y, Cons(z, a))), next, k, env) {
                                            Nil => λ never => false_elim(never.right.right.right),
                                            Cons(u, _) => λ kept => {
                                                let fdv = Ty::cast(w.tys, Ty::at(g, x), Word(64), Env::get(w.tys, g, vals, x));
                                                let bufv = Ty::cast(w.tys, Ty::at(g, y), ByteList(c), Env::get(w.tys, g, vals, y));
                                                let atv = Ty::cast(w.tys, Ty::at(g, z), Word(64), Env::get(w.tys, g, vals, z));
                                                let maxv = Ty::cast(w.tys, Ty::at(g, u), Word(64), Env::get(w.tys, g, vals, u));
                                                let landed = ETm::read_lands(env, io, locs, fd, b, at, m, next, fdv, bufv, atv, maxv,
                                                    kept.left, kept.right.left, kept.right.right.left, kept.right.right.right.left, below);
                                                let env2 = CallShape::Reads(fd, b, at, m, next).answer(env, Io::call(io, CallShape::Reads(fd, b, at, m, next).cmd(env)).value);
                                                ⟨landed.left, ⟨⟨landed.right.right.left, ⟨landed.right.left,
                                                        locs_hold_same(w.tys, env, env2, g, Loc::forget_all(locs, b), vals, landed.right.right.right,
                                                            locs_hold_forget(w.tys, env, b, g, locs, vals, held))⟩⟩,
                                                    ⟨next.lt_succ_self(), ⟨trivial, locs_below_forget(locs, b, next + 1,
                                                        locs_below_mono(locs, next, next + 1, Nat::le_succ_r(next, next, next.le_refl()), below))⟩⟩⟩⟩
                                            },
                                        },
                                    },
                                },
                            }(ok(env, vals, held))
                        },
                    },
                },
            },
        },
        Writes(c) => match ids {
            Nil => λ _ => trivial,
            Cons(fd, r1) => match r1 {
                Nil => λ _ => trivial,
                Cons(b, r2) => match r2 {
                    Nil => λ _ => trivial,
                    Cons(from, r3) => match r3 {
                        Nil => λ _ => trivial,
                        Cons(len, r4) => λ ok env vals io held below => {
                            let ids4 = Cons(fd, Cons(b, Cons(from, Cons(len, r4))));
                            let k = Called(CallShape::Writes(fd, b, from, len, next), Cons(InWord(next), locs));
                            match args as λ a => ETm::OperandsKept(w.tys, env, g, vals, Effect::params(Effect::Writes(c)), a, ids4) → ETm::Answered(Effect::Writes(c), w, g, vals, io, a, next, k, env) {
                                Nil => λ never => false_elim(never),
                                Cons(x, a1) => match a1 as λ a => ETm::OperandsKept(w.tys, env, g, vals, Effect::params(Effect::Writes(c)), Cons(x, a), ids4) →
                                        ETm::Answered(Effect::Writes(c), w, g, vals, io, Cons(x, a), next, k, env) {
                                    Nil => λ never => false_elim(never.right),
                                    Cons(y, a2) => match a2 as λ a => ETm::OperandsKept(w.tys, env, g, vals, Effect::params(Effect::Writes(c)), Cons(x, Cons(y, a)), ids4) →
                                            ETm::Answered(Effect::Writes(c), w, g, vals, io, Cons(x, Cons(y, a)), next, k, env) {
                                        Nil => λ never => false_elim(never.right.right),
                                        Cons(z, a3) => match a3 as λ a => ETm::OperandsKept(w.tys, env, g, vals, Effect::params(Effect::Writes(c)), Cons(x, Cons(y, Cons(z, a))), ids4) →
                                                ETm::Answered(Effect::Writes(c), w, g, vals, io, Cons(x, Cons(y, Cons(z, a))), next, k, env) {
                                            Nil => λ never => false_elim(never.right.right.right),
                                            Cons(u, _) => λ kept => {
                                                let fdv = Ty::cast(w.tys, Ty::at(g, x), Word(64), Env::get(w.tys, g, vals, x));
                                                let bufv = Ty::cast(w.tys, Ty::at(g, y), ByteList(c), Env::get(w.tys, g, vals, y));
                                                let fromv = Ty::cast(w.tys, Ty::at(g, z), Word(64), Env::get(w.tys, g, vals, z));
                                                let lenv = Ty::cast(w.tys, Ty::at(g, u), Word(64), Env::get(w.tys, g, vals, u));
                                                let landed = ETm::write_lands(env, io, locs, fd, b, from, len, next, fdv, bufv, fromv, lenv,
                                                    kept.left, kept.right.left, kept.right.right.left, kept.right.right.right.left, below);
                                                let env2 = CallShape::Writes(fd, b, from, len, next).answer(env, Io::call(io, CallShape::Writes(fd, b, from, len, next).cmd(env)).value);
                                                ⟨landed.left, ⟨⟨landed.right.left, locs_hold_same(w.tys, env, env2, g, locs, vals, landed.right.right, held)⟩,
                                                    ETm::next_below(locs, next, below)⟩⟩
                                            },
                                        },
                                    },
                                },
                            }(ok(env, vals, held))
                        },
                    },
                },
            },
        },
        Opens(c) => match ids {
            Nil => λ _ => trivial,
            Cons(path, r1) => match r1 {
                Nil => λ _ => trivial,
                Cons(len, r2) => λ ok env vals io held below => {
                    let ids2 = Cons(path, Cons(len, r2));
                    let k = Called(CallShape::Opens(path, len, next), Cons(InWord(next), locs));
                    match args as λ a => ETm::OperandsKept(w.tys, env, g, vals, Effect::params(Effect::Opens(c)), a, ids2) → ETm::Answered(Effect::Opens(c), w, g, vals, io, a, next, k, env) {
                        Nil => λ never => false_elim(never),
                        Cons(x, a1) => match a1 as λ a => ETm::OperandsKept(w.tys, env, g, vals, Effect::params(Effect::Opens(c)), Cons(x, a), ids2) →
                                ETm::Answered(Effect::Opens(c), w, g, vals, io, Cons(x, a), next, k, env) {
                            Nil => λ never => false_elim(never.right),
                            Cons(y, _) => λ kept => {
                                let pathv = Ty::cast(w.tys, Ty::at(g, x), ByteList(c), Env::get(w.tys, g, vals, x));
                                let lenv = Ty::cast(w.tys, Ty::at(g, y), Word(64), Env::get(w.tys, g, vals, y));
                                let landed = ETm::open_lands(env, io, locs, path, len, next, pathv, lenv, kept.left, kept.right.left, below);
                                let env2 = CallShape::Opens(path, len, next).answer(env, Io::call(io, CallShape::Opens(path, len, next).cmd(env)).value);
                                ⟨landed.left, ⟨⟨landed.right.left, locs_hold_same(w.tys, env, env2, g, locs, vals, landed.right.right, held)⟩,
                                    ETm::next_below(locs, next, below)⟩⟩
                            },
                        },
                    }(ok(env, vals, held))
                },
            },
        },
        Closes => match ids {
            Nil => λ _ => trivial,
            Cons(fd, r1) => λ ok env vals io held below => {
                let ids1 = Cons(fd, r1);
                let k = Called(CallShape::Closes(fd, next), Cons(InWord(next), locs));
                match args as λ a => ETm::OperandsKept(w.tys, env, g, vals, Effect::params(Effect::Closes), a, ids1) → ETm::Answered(Effect::Closes, w, g, vals, io, a, next, k, env) {
                    Nil => λ never => false_elim(never),
                    Cons(x, _) => λ kept => {
                        let fdv = Ty::cast(w.tys, Ty::at(g, x), Word(64), Env::get(w.tys, g, vals, x));
                        let landed = ETm::close_lands(env, io, locs, fd, next, fdv, kept.left, below);
                        let env2 = CallShape::Closes(fd, next).answer(env, Io::call(io, CallShape::Closes(fd, next).cmd(env)).value);
                        ⟨landed.left, ⟨⟨landed.right.left, locs_hold_same(w.tys, env, env2, g, locs, vals, landed.right.right, held)⟩,
                            ETm::next_below(locs, next, below)⟩⟩
                    },
                }(ok(env, vals, held))
            },
        },
    }
}

theorem ETm::call_sound(e: Effect, w: rt::World, g: List<Ty>, locs: List<Loc>, next: Nat, args: List<Nat>):
    ETm::CallHolds(e, w, g, locs, next, args, ETm::lower_call(e, g, locs, next, args)) {
    let P = λ (r: Option<Called>) => ETm::CallHolds(e, w, g, locs, next, args, r);
    Option::and_then_elim(P, trivial, ETm::operands(g, locs, e.params(), args), λ ids => ETm::called(e, next, locs, ids), λ ids e_ids =>
        ETm::called_sound(e, w, g, locs, next, args, ids,
            λ env vals held => ETm::operands_kept(w.tys, env, g, locs, vals, held, e.params(), args, ids, e_ids)))
}

// ---------------------------------------------------------------------------
// A function lent the first buffer (docs/native/native-one-compiler-design.md §2.6)
//
// `Lend` is a `Compute` of a region `Call` of the program's function the
// table's entry names (`Lent::entry`): its words are where the word variables live, its answer
// lands in a fresh word. A program lends a function a prefix of its file
// (`program_writers`), so the buffer handed over is the file's first, and
// the lowering refuses a buffer variable that lives anywhere else
// (issues/source-buffers-as-views.md would lift that). After the call the
// buffer's earlier variables are gone, as after a read, and a new variable
// names the bytes the function left.

// The program's calls answer the table: over every file with a first
// buffer, function `f` of the table, called as the program's function
// `Lent::at(ls, f).entry` on as many words as it takes, answers its word and leaves its
// bytes in the first buffer, the rest of the file as it was. What
// `program_writers` answers for a `runtime fn` lent a span
// (`raise_span_called`, native_tool_spans).
fn ETm::LentsAgree(ls: List<Lent>, call: Writers()) → Type {
    (f: Nat) → (f + 1).leb(ls.len()).IsTrue() → (own: List<BitVec(8)>) → (rest: Buffers()) → (words: List<BitVec(64)>) →
        words.len() = Lent::at(ls, f).arity →
        call(Cons(own, rest), Lent::at(ls, f).entry, words) = Ending(Lent::at(ls, f).run(own, words).value, Cons(Lent::at(ls, f).run(own, words).after, rest))
}

// A table nothing calls agrees with every program.
theorem ETm::lents_agree_none(call: Writers()): ETm::LentsAgree(Nil, call) {
    λ f never own rest words _ => false_elim(never)
}

// The words of the word variables: each a 64-bit word, where it lives.
fn ETm::word_ids(g: List<Ty>, locs: List<Loc>, args: List<Nat>) → Option<List<Nat>> {
    match args {
        Nil => Some(Nil),
        Cons(a, more) => ETm::operand(g, locs, Word(64), a).and_then(λ id => ETm::word_ids(g, locs, more).and_then(λ ids => Some(Cons(id, ids)))),
    }
}

// Those words, read where they live, are the words the meaning hands over.
theorem ETm::word_ids_sound(tys: Nat → RecInfo, env: Env, g: List<Ty>, locs: List<Loc>, vals: rt::Env(tys, g),
    held: LocsHold(tys, env, g, locs, vals), args: List<Nat>): (ids: List<Nat>) →
    ETm::word_ids(g, locs, args) = Some(ids) → words_of(env.valuation(), ids) = Lent::words(tys, g, vals, args) {
    match args {
        Nil => λ ids e => j(Option::some_inj(Nil, ids, e), λ z _ => words_of(env.valuation(), z) = Lent::words(tys, g, vals, Nil), refl),
        Cons(a, more) => λ ids => {
            let Goal = λ (z: List<Nat>) => words_of(env.valuation(), z) = Lent::words(tys, g, vals, Cons(a, more));
            let P = λ (o: Option<List<Nat>>) => o = Some(ids) → Goal(ids);
            let none: P(None) = λ never => Option::none_ne_some(ids, never, Goal(ids));
            Option::and_then_elim(P, none, ETm::operand(g, locs, Word(64), a),
                λ id => ETm::word_ids(g, locs, more).and_then(λ ids2 => Some(Cons(id, ids2))), λ id e_id =>
            Option::and_then_elim(P, none, ETm::word_ids(g, locs, more), λ ids2 => Some(Cons(id, ids2)), λ ids2 e_ids2 =>
                λ (e: Some(Cons(id, ids2)) = Some(ids)) => j(Option::some_inj(Cons(id, ids2), ids, e), λ z _ => Goal(z),
                    eq2<BitVec(64), List<BitVec(64)>, List<BitVec(64)>>(λ x xs => Cons(x, xs),
                        ETm::word_of_kept(env, id, Ty::cast(tys, Ty::at(g, a), Word(64), Env::get(tys, g, vals, a)),
                            ETm::operand_kept(tys, env, g, locs, vals, held, Word(64), a, id, e_id)),
                        ETm::word_ids_sound(tys, env, g, locs, vals, held, more, ids2, e_ids2)))))
        },
    }
}

// The call's region, and where the end context's variables live after it:
// the word at `next`, the bytes left in buffer 0, every other variable at
// buffer 0 gone.
record LentCall { region: StructuredRegion, locs: List<Loc> }

fn ETm::lend_call(entry, next: Nat, ids: List<Nat>, locs: List<Loc>) → LentCall {
    LentCall(Call(entry, ids, next), Cons(InWord(next), Cons(InBuffer(0), Loc::forget_all(locs, 0))))
}

// A function of the table, on as many words as it takes; the buffer
// variable in buffer 0; each word variable in a word.
fn ETm::lower_lend(w: rt::World, ls: List<Lent>, g: List<Ty>, locs: List<Loc>, next, f, cap, buf: Nat, args: List<Nat>) → Option<LentCall> {
    Tm::check_true((f + 1).leb(ls.len()) && Lent::at(ls, f).arity.matches(args.len())).and_then(λ _ =>
        ETm::operand(g, locs, ByteList(cap), buf).and_then(λ b => Tm::check_true(b.matches(0)).and_then(λ _ =>
            ETm::word_ids(g, locs, args).and_then(λ ids => Some(ETm::lend_call(Lent::at(ls, f).entry, next, ids, locs))))))
}

// The call's region, from where the variables live and with the program's
// calls answering the table, leaves the meaning's results where the
// lowering says they live.
fn ETm::LendHolds(w: rt::World, ls: List<Lent>, g: List<Ty>, locs: List<Loc>, next, f, cap, buf: Nat, args: List<Nat>, r: Option<LentCall>) → Type {
    match r {
        None => True,
        Some(k) => (call: Writers()) → ETm::LentsAgree(ls, call) → (env: Env) → (vals: rt::Env(w.tys, g)) →
            LocsHold(w.tys, env, g, locs, vals) → LocsBelow(locs, next) →
            LocsHold(w.tys, env.compute(call, k.region), Ty::bind_onto(Lent::results(cap), g), k.locs,
                Effect::push(w.tys, Lent::results(cap), g, vals, Lent::answer(w.tys, ls, g, vals, f, cap, buf, args)))
            ∧ LocsBelow(k.locs, next + 1),
    }
}

theorem ETm::lend_sound(w: rt::World, ls: List<Lent>, g: List<Ty>, locs: List<Loc>, next, f, cap, buf: Nat, args: List<Nat>):
    ETm::LendHolds(w, ls, g, locs, next, f, cap, buf, args, ETm::lower_lend(w, ls, g, locs, next, f, cap, buf, args)) {
    let P = λ (r: Option<LentCall>) => ETm::LendHolds(w, ls, g, locs, next, f, cap, buf, args, r);
    let entry = Lent::at(ls, f).entry;
    let tail_ids = λ (ids: List<Nat>) => Some(ETm::lend_call(entry, next, ids, locs));
    let after_zero = λ (_: True) => ETm::word_ids(g, locs, args).and_then(tail_ids);
    let after_b = λ (b: Nat) => Tm::check_true(b.matches(0)).and_then(λ z => ETm::word_ids(g, locs, args).and_then(tail_ids));
    Option::and_then_elim(P, trivial, Tm::check_true((f + 1).leb(ls.len()) && Lent::at(ls, f).arity.matches(args.len())),
        λ _ => ETm::operand(g, locs, ByteList(cap), buf).and_then(after_b), λ ok _ =>
    Option::and_then_elim(P, trivial, ETm::operand(g, locs, ByteList(cap), buf), after_b, λ b e_b =>
    Option::and_then_elim(P, trivial, Tm::check_true(b.matches(0)), λ z => ETm::word_ids(g, locs, args).and_then(tail_ids), λ zero _ =>
    Option::and_then_elim(P, trivial, ETm::word_ids(g, locs, args), tail_ids, λ ids e_ids =>
        λ call lents env vals held below => {
            let tys = w.tys;
            let parts = Bool::is_true_and((f + 1).leb(ls.len()), Lent::at(ls, f).arity.matches(args.len()), ok);
            let bytes = Ty::cast(tys, Ty::at(g, buf), ByteList(cap), Env::get(tys, g, vals, buf));
            let words = Lent::words(tys, g, vals, args);
            let m = Lent::at(ls, f).run(bytes, words);
            // The buffer variable is the file's first buffer.
            let kb: (env.buffers.nth(0) = Some(bytes)) = j(b.matches_eq(0, zero), λ x _ => env.buffers.nth(x) = Some(bytes),
                ETm::operand_kept(tys, env, g, locs, vals, held, ByteList(cap), buf, b, e_b));
            let rest = env.buffers.tail();
            let file: (env.buffers = Cons(bytes, rest)) = env.first_buffer(bytes, kb);
            let ws: (words_of(env.valuation(), ids) = words) = ETm::word_ids_sound(tys, env, g, locs, vals, held, args, ids, e_ids);
            let arity: (words.len() = Lent::at(ls, f).arity) =
                trans(Lent::words_len(tys, g, vals, args), sym(Lent::at(ls, f).arity.matches_eq(args.len(), parts.right)));
            let answered: (call(Cons(bytes, rest), entry, words) = Ending(m.value, Cons(m.after, rest))) =
                lents(f, parts.left, bytes, rest, words, arity);
            let region = ETm::lend_call(entry, next, ids, locs).region;
            let values = env.valuation();
            let after = Valuation::set(values, next, word_value(m.value));
            let K = λ (answer: Ending) => State(Valuation::set(values, next, word_value(answer.word)), answer.buffers);
            let ran: (region.run(call, values, env.buffers) = State(after, Cons(m.after, rest))) =
                j(sym(file), λ fb _ => region.run(call, values, fb) = State(after, Cons(m.after, rest)),
                    j(sym(ws), λ u _ => shared(call(Cons(bytes, rest), entry, u), K) = State(after, Cons(m.after, rest)),
                        cong_fn<Ending, State>(K, answered)));
            // The call's word settled in `next`, its file in place of the
            // caller's: the first buffer set to the bytes left.
            let e1 = env.set_buffer(0, m.after);
            let e2 = e1.set_word(next, m.value);
            let put_first: (env.buffers.put(0, m.after, Nil) = Cons(m.after, rest)) =
                cong_fn(λ (bs: List<List<BitVec(8)>>) => bs.put(0, m.after, Nil), file);
            let computed: (env.compute(call, region) = e2) =
                trans(cong_fn(λ (st: State) => native_source::Env(env.words.put(next, st.values(64, next).toNat(), 0), st.buffers, env.args), ran),
                    eq2<BitVec(64), List<List<BitVec(8)>>, native_source::Env>(λ x bs => native_source::Env(env.words.put(next, x.toNat(), 0), bs, env.args),
                        Valuation::set_here(values, next, word_value(m.value), 64), sym(put_first)));
            let same = Loc::same_trans(Loc::forget_all(locs, 0), env, e1, e2, Loc::same_set_buffer(locs, env, 0, m.after),
                Loc::same_set_word(Loc::forget_all(locs, 0), e1, next, m.value, locs_below_forget(locs, 0, next, below)));
            let held2: LocsHold(tys, e2, Ty::bind_onto(Lent::results(cap), g), Cons(InWord(next), Cons(InBuffer(0), Loc::forget_all(locs, 0))),
                    Pair(m.value, Pair(m.after, vals))) =
                ⟨e1.number_set_here(next, m.value), ⟨List::put_nth_here(0, env.buffers, m.after, Nil),
                    locs_hold_same(tys, env, e2, g, Loc::forget_all(locs, 0), vals, same, locs_hold_forget(tys, env, 0, g, locs, vals, held))⟩⟩;
            ⟨j(sym(computed), λ e _ => LocsHold(tys, e, Ty::bind_onto(Lent::results(cap), g),
                    Cons(InWord(next), Cons(InBuffer(0), Loc::forget_all(locs, 0))), Pair(m.value, Pair(m.after, vals))), held2),
                ⟨next.lt_succ_self(), ⟨trivial, locs_below_forget(locs, 0, next + 1,
                    locs_below_mono(locs, next, next + 1, Nat::le_succ_r(next, next, next.le_refl()), below))⟩⟩⟩
        }))))
}

// Where a statement leaves the program: on, with every variable of a
// context kept where it lives.
fn Flow::KeepsAll(self flow: Flow, tys: Nat → RecInfo, g: List<Ty>, locs: List<Loc>, vals: rt::Env(tys, g)) → Type {
    match flow { Onward(env) => LocsHold(tys, env, g, locs, vals), Exited(_) => False }
}

// ---------------------------------------------------------------------------
// Moving values to their places: a loop's state back to where it lives
// before the loop, an `if`'s joined parts to where both arms leave them

// A region that does nothing.
fn Loc::nothing() → StructuredRegion { Dataflow(Region(Ports(Nil), Nil, Ports(Nil))) }

fn Loc::skip() → Stmt { Compute(Loc::nothing()) }

// `src` moved to the word `out`, at `width`.
fn Loc::move_region(width: Nat, out: Nat, src: Nat) → StructuredRegion {
    Compose(Loc::nothing(), Dataflow(Region(Ports(Nil), [Move(width, out, src)], Ports(Nil))))
}

// The words of a layout.
fn Loc::words(locs: List<Loc>) → List<Nat> {
    match locs {
        Nil => Nil,
        Cons(l, rest) => match l { InWord(id) => Cons(id, Loc::words(rest)), InBuffer(_) => Loc::words(rest), Gone => Loc::words(rest) },
    }
}

theorem Loc::clear_nil(locs: List<Loc>): Loc::clear(locs, Nil).IsTrue() {
    match locs {
        Nil => trivial,
        Cons(l, rest) => Bool::is_true_and_intro(l.clear_one(Nil), Loc::clear(rest, Nil),
            match l as λ k => k.clear_one(Nil).IsTrue() { InWord(_) => trivial, InBuffer(_) => trivial, Gone => trivial },
            Loc::clear_nil(rest)),
    }
}

// Clear of a list headed by `x`: clear of `x`, and of the rest.
theorem Loc::clear_cons(locs: List<Loc>, x: Nat, ws: List<Nat>): Loc::clear(locs, Cons(x, ws)).IsTrue() →
    Loc::clear(locs, [x]).IsTrue() ∧ Loc::clear(locs, ws).IsTrue() {
    match locs {
        Nil => λ _ => ⟨trivial, trivial⟩,
        Cons(l, rest) => λ h => {
            let parts = Bool::is_true_and(l.clear_one(Cons(x, ws)), Loc::clear(rest, Cons(x, ws)), h);
            let more = Loc::clear_cons(rest, x, ws, parts.right);
            let one = match l as λ k => k.clear_one(Cons(x, ws)).IsTrue() → k.clear_one([x]).IsTrue() ∧ k.clear_one(ws).IsTrue() {
                InWord(id) => λ c => {
                    let p = Bool::is_true_and(id.differs(x), absent(id, ws), c);
                    ⟨Bool::is_true_and_intro(id.differs(x), True, p.left, trivial), p.right⟩
                },
                InBuffer(_) => λ _ => ⟨trivial, trivial⟩,
                Gone => λ _ => ⟨trivial, trivial⟩,
            }(parts.left);
            ⟨Bool::is_true_and_intro(l.clear_one([x]), Loc::clear(rest, [x]), one.left, more.left),
                Bool::is_true_and_intro(l.clear_one(ws), Loc::clear(rest, ws), one.right, more.right)⟩
        },
    }
}

// One variable moved back: a word or a bit from where the pass left it to
// its word, a buffer left in its own buffer (or a gone one anywhere).
fn Loc::move_one(t: Ty, d: Loc, s: Loc, more: Stmt) → Option<Stmt> {
    match t {
        Word(_) => match d { InWord(dw) => match s { InWord(sw) => Some(Then(Compute(Loc::move_region(t.width(), dw, sw)), more)), InBuffer(_) => None, Gone => None }, InBuffer(_) => None, Gone => None },
        Bit => match d { InWord(dw) => match s { InWord(sw) => Some(Then(Compute(Loc::move_region(t.width(), dw, sw)), more)), InBuffer(_) => None, Gone => None }, InBuffer(_) => None, Gone => None },
        ByteList(_) => match d {
            InWord(_) => None,
            InBuffer(b) => match s { InWord(_) => None, InBuffer(b2) => match b.eq_dec(b2) { Inl(_) => Some(more), Inr(_) => None }, Gone => None },
            Gone => Some(more),
        },
        Lines => None,
        Named(_) => None,
        Count => None,
        Enum(_) => None,
    }
}

// The moves for every variable, in order: each move writes no word a later
// one reads, and no later one writes a word an earlier one wrote.
fn Loc::moves(g: List<Ty>, dsts: List<Loc>, srcs: List<Loc>) → Option<Stmt> {
    match g {
        Nil => match dsts { Nil => match srcs { Nil => Some(Loc::skip()), Cons(_, _) => None }, Cons(_, _) => None },
        Cons(t, rest) => match dsts {
            Nil => None,
            Cons(d, ds) => match srcs {
                Nil => None,
                Cons(s, ss) => Tm::check_true(Loc::clear(ss, Loc::words([d]))).and_then(λ _ =>
                    Tm::check_true(Loc::clear([d], Loc::words(ds))).and_then(λ _ =>
                        Loc::moves(rest, ds, ss).and_then(λ more => Loc::move_one(t, d, s, more)))),
            },
        },
    }
}

// Where a statement leaves the program: on, every place of `frame` as it
// was in `env`.
fn Flow::Frames(self flow: Flow, frame: List<Loc>, env: Env) → Type {
    match flow { Onward(env2) => Loc::AllSame(frame, env, env2), Exited(_) => False }
}

// What the moves promise: loop-free, the world untouched, every variable
// moved from its source to its place, and every place no move writes kept.
fn Loc::MovesHold(tys: Nat → RecInfo, g: List<Ty>, dsts: List<Loc>, srcs: List<Loc>, r: Option<Stmt>) → Type {
    match r {
        None => True,
        Some(st) => st.straight().IsTrue() ∧ ((call: Writers()) → (env: Env) → (vals: rt::Env(tys, g)) → (io: Io) → LocsHold(tys, env, g, srcs, vals) →
            (Stmt::thread(st, call, env, io).after = io) ∧ (Stmt::thread(st, call, env, io).value.KeepsAll(tys, g, dsts, vals)
                ∧ ((frame: List<Loc>) → Loc::clear(frame, Loc::words(dsts)).IsTrue() → Stmt::thread(st, call, env, io).value.Frames(frame, env)))),
    }
}

// Doing nothing keeps every place.
theorem Loc::skip_same(env: Env, call: Writers(), frame: List<Loc>): Loc::AllSame(frame, env, env.compute(call, Loc::nothing())) {
    Loc::same_compute(env, call, Loc::nothing(), env.compute_buffers(call, no_function, Writers::still_none(call), Loc::nothing(), trivial, trivial), frame, Loc::clear_nil(frame))
}

// Keeping the head where the rest's statements keep it.
theorem Loc::keeps_cons(tys: Nat → RecInfo, t: Ty, rest: List<Ty>, d: Loc, ds: List<Loc>, v: t.sem(tys), vs: rt::Env(tys, rest), env: Env,
    kept: t.Kept(tys, env, d, v)): (flow: Flow) → flow.KeepsAll(tys, rest, ds, vs) → flow.Frames([d], env) →
    flow.KeepsAll(tys, Cons(t, rest), Cons(d, ds), Pair(v, vs)) {
    λ flow => match flow {
        Onward(env2) => λ ka fr => ⟨t.kept_same(tys, env, env2, d, fr.left, v, kept), ka⟩,
        Exited(_) => λ never => false_elim(never),
    }
}

theorem Loc::frames_trans(frame: List<Loc>, env, env1: Env, same: Loc::AllSame(frame, env, env1)): (flow: Flow) →
    flow.Frames(frame, env1) → flow.Frames(frame, env) {
    λ flow => match flow {
        Onward(env2) => λ fr => Loc::same_trans(frame, env, env1, env2, same, fr),
        Exited(_) => λ never => false_elim(never),
    }
}

// A word or a bit moved: kept at its place, the rest's sources and every
// other place untouched.
theorem Loc::move_word_sound(tys: Nat → RecInfo, t: Ty, one: t.Scalar(), rest: List<Ty>, ds: List<Loc>, ss: List<Loc>, more: Stmt,
    ih: Loc::MovesHold(tys, rest, ds, ss, Some(more)), dw, sw: Nat,
    c1: Loc::clear(ss, [dw]).IsTrue(), c2: Loc::clear([InWord(dw)], Loc::words(ds)).IsTrue()):
    Loc::MovesHold(tys, Cons(t, rest), Cons(InWord(dw), ds), Cons(InWord(sw), ss),
        Some(Then(Compute(Loc::move_region(t.width(), dw, sw)), more))) {
    let mr = Loc::move_region(t.width(), dw, sw);
    ⟨Bool::is_true_and_intro(True, more.straight(), trivial, ih.left), λ call env vals io held => {
        let env1 = env.compute(call, mr);
        let keeps1: (env1.buffers = env.buffers) = env.compute_buffers(call, no_function, Writers::still_none(call), mr, trivial, trivial);
        let held1 = locs_hold_same(tys, env, env1, rest, ss, vals.snd, Loc::same_compute(env, call, mr, keeps1, ss, c1), held.right);
        let kept1: t.Kept(tys, env1, InWord(dw), vals.fst) = t.kept_moved(tys, env1, dw, env.valuation(), sw, one, vals.fst,
            t.kept_holds(tys, env, InWord(sw), vals.fst, held.left), env.compute_moved(call, no_function, Writers::still_none(call), Loc::nothing(), trivial, trivial, t.width(), dw, sw));
        let r = ih.right(call, env1, vals.snd, io, held1);
        ⟨r.left, ⟨Loc::keeps_cons(tys, t, rest, InWord(dw), ds, vals.fst, vals.snd, env1, kept1, Stmt::thread(more, call, env1, io).value,
                r.right.left, r.right.right([InWord(dw)], c2)),
            λ frame h => {
                let parts = Loc::clear_cons(frame, dw, Loc::words(ds), h);
                Loc::frames_trans(frame, env, env1, Loc::same_compute(env, call, mr, keeps1, frame, parts.left),
                    Stmt::thread(more, call, env1, io).value, r.right.right(frame, parts.right))
            }⟩⟩
    }⟩
}

// A buffer left where it is, or a gone one: nothing moved.
theorem Loc::move_stay_sound(tys: Nat → RecInfo, t: Ty, rest: List<Ty>, d: Loc, ds: List<Loc>, s: Loc, ss: List<Loc>, more: Stmt,
    ih: Loc::MovesHold(tys, rest, ds, ss, Some(more)), stay: (env: Env) → (v: t.sem(tys)) → t.Kept(tys, env, s, v) → t.Kept(tys, env, d, v),
    c2: Loc::clear([d], Loc::words(ds)).IsTrue(), wd: Loc::words(Cons(d, ds)) = Loc::words(ds)):
    Loc::MovesHold(tys, Cons(t, rest), Cons(d, ds), Cons(s, ss), Some(more)) {
    ⟨ih.left, λ call env vals io held => {
        let r = ih.right(call, env, vals.snd, io, held.right);
        ⟨r.left, ⟨Loc::keeps_cons(tys, t, rest, d, ds, vals.fst, vals.snd, env, stay(env, vals.fst, held.left), Stmt::thread(more, call, env, io).value,
                r.right.left, r.right.right([d], c2)),
            λ frame h => r.right.right(frame, j(wd, λ ws _ => Loc::clear(frame, ws).IsTrue(), h))⟩⟩
    }⟩
}

theorem Loc::move_one_sound(tys: Nat → RecInfo, rest: List<Ty>, ds: List<Loc>, ss: List<Loc>, more: Stmt,
    ih: Loc::MovesHold(tys, rest, ds, ss, Some(more))): (t: Ty) → (d: Loc) → (s: Loc) →
    Loc::clear(ss, Loc::words([d])).IsTrue() → Loc::clear([d], Loc::words(ds)).IsTrue() →
    Loc::MovesHold(tys, Cons(t, rest), Cons(d, ds), Cons(s, ss), Loc::move_one(t, d, s, more)) {
    λ t => match t {
        Word(wd) => λ d => match d {
            InWord(dw) => λ s => match s {
                InWord(sw) => λ c1 c2 => Loc::move_word_sound(tys, Word(wd), trivial, rest, ds, ss, more, ih, dw, sw, c1, c2),
                InBuffer(_) => λ _ _ => trivial,
                Gone => λ _ _ => trivial,
            },
            InBuffer(_) => λ s _ _ => trivial,
            Gone => λ s _ _ => trivial,
        },
        Bit => λ d => match d {
            InWord(dw) => λ s => match s {
                InWord(sw) => λ c1 c2 => Loc::move_word_sound(tys, Bit, trivial, rest, ds, ss, more, ih, dw, sw, c1, c2),
                InBuffer(_) => λ _ _ => trivial,
                Gone => λ _ _ => trivial,
            },
            InBuffer(_) => λ s _ _ => trivial,
            Gone => λ s _ _ => trivial,
        },
        ByteList(c) => λ d => match d {
            InWord(_) => λ s _ _ => trivial,
            InBuffer(b) => λ s => match s {
                InWord(_) => λ _ _ => trivial,
                InBuffer(b2) => λ c1 c2 => match b.eq_dec(b2) as λ q => Loc::MovesHold(tys, Cons(ByteList(c), rest), Cons(InBuffer(b), ds), Cons(InBuffer(b2), ss),
                        match q as λ _ => Option<Stmt> { Inl(_) => Some(more), Inr(_) => None }) {
                    Inl(e) => Loc::move_stay_sound(tys, ByteList(c), rest, InBuffer(b), ds, InBuffer(b2), ss, more, ih,
                        λ env v (k: env.buffers.nth(b2) = Some(v)) => j(sym(e), λ x _ => env.buffers.nth(x) = Some(v), k), c2, refl),
                    Inr(_) => trivial,
                },
                Gone => λ _ _ => trivial,
            },
            Gone => λ s c1 c2 => Loc::move_stay_sound(tys, ByteList(c), rest, Gone, ds, s, ss, more, ih, λ env v _ => trivial, c2, refl),
        },
        Lines => λ d s _ _ => trivial,
        Named(_) => λ d s _ _ => trivial,
        Count => λ d s _ _ => trivial,
        Enum(_) => λ d s _ _ => trivial,
    }
}

theorem Loc::moves_sound(tys: Nat → RecInfo, g: List<Ty>): (dsts: List<Loc>) → (srcs: List<Loc>) →
    Loc::MovesHold(tys, g, dsts, srcs, Loc::moves(g, dsts, srcs)) {
    match g {
        Nil => λ dsts => match dsts {
            Nil => λ srcs => match srcs {
                Nil => ⟨trivial, λ call env vals io held => ⟨refl, ⟨trivial, λ frame _ => Loc::skip_same(env, call, frame)⟩⟩⟩,
                Cons(_, _) => trivial,
            },
            Cons(_, _) => λ srcs => trivial,
        },
        Cons(t, rest) => λ dsts => match dsts {
            Nil => λ srcs => trivial,
            Cons(d, ds) => λ srcs => match srcs {
                Nil => trivial,
                Cons(s, ss) => {
                    let P = λ (r: Option<Stmt>) => Loc::MovesHold(tys, Cons(t, rest), Cons(d, ds), Cons(s, ss), r);
                    Option::and_then_elim(P, trivial, Tm::check_true(Loc::clear(ss, Loc::words([d]))),
                        λ _ => Tm::check_true(Loc::clear([d], Loc::words(ds))).and_then(λ _ =>
                            Loc::moves(rest, ds, ss).and_then(λ more => Loc::move_one(t, d, s, more))), λ c1 _ =>
                    Option::and_then_elim(P, trivial, Tm::check_true(Loc::clear([d], Loc::words(ds))),
                        λ _ => Loc::moves(rest, ds, ss).and_then(λ more => Loc::move_one(t, d, s, more)), λ c2 _ =>
                    Option::and_then_elim(P, trivial, Loc::moves(rest, ds, ss), λ more => Loc::move_one(t, d, s, more), λ more e_more =>
                        Loc::move_one_sound(tys, rest, ds, ss, more,
                            j(e_more, λ r _ => Loc::MovesHold(tys, rest, ds, ss, r), Loc::moves_sound(tys, rest, ds, ss)), t, d, s, c1, c2))))
                },
            },
        },
    }
}

// The condition's code is a bit.
fn Ty::check_bit(t: Ty) → Option<t = Bit> {
    match t.equation(Bit) { Inl(e) => Some(e), Inr(_) => None }
}

// ---------------------------------------------------------------------------
// A branch: the condition's flag

// A condition's flag word, read as a bit, is the condition.
theorem ETm::head_bool(v: Bool): ETm::word_at(64, BitVec::ofBool(v).toNat()).head_bit() = v {
    match v { True => refl, False => refl }
}

theorem ETm::bit_kept(tys: Nat → RecInfo, env: Env, c: Nat, t: Ty, e: t = Bit): (v: t.sem(tys)) → t.Kept(tys, env, InWord(c), v) →
    env.bit(c) = ETm::truth(tys, t, v) {
    j(sym(e), λ x _ => (v: x.sem(tys)) → x.Kept(tys, env, InWord(c), v) → env.bit(c) = ETm::truth(tys, x, v),
        λ v (k: env.number(c) = BitVec::ofBool(v).toNat()) =>
            trans(cong_fn(λ (n: Nat) => ETm::word_at(64, n).head_bit(), k), trans(ETm::head_bool(v), sym(Ty::cast_self(tys, Bit, v)))))
}

// A variable's value cast along an equation of codes is kept where it was.
theorem Ty::kept_cast(tys: Nat → RecInfo, env: Env, l: Loc, a, b: Ty, e: a = b, v: a.sem(tys), k: a.Kept(tys, env, l, v)):
    b.Kept(tys, env, l, Ty::cast(tys, a, b, v)) {
    j(e, λ x _ => x.Kept(tys, env, l, Ty::cast(tys, a, x, v)),
        j(sym(Ty::cast_self(tys, a, v)), λ y _ => a.Kept(tys, env, l, y), k))
}

// ---------------------------------------------------------------------------
// A branch: the variables before it, at the end of an arm

// The environment before a computation, out of the one at its end: each
// variable it bound dropped.
fn Effect::pop(tys: Nat → RecInfo, rs: List<Ty>) → (g: List<Ty>) → rt::Env(tys, Ty::bind_onto(rs, g)) → rt::Env(tys, g) {
    match rs { Nil => λ g e => e, Cons(r, rest) => λ g e => Effect::pop(tys, rest, Cons(r, g), e).snd }
}

fn Loc::pop(rs: List<Ty>, el: List<Loc>) → List<Loc> {
    match rs { Nil => el, Cons(_, rest) => Loc::pop(rest, el).tail() }
}

fn Part::drop(self p: Part, tys: Nat → RecInfo, g: List<Ty>) → rt::Env(tys, p.onto(g)) → rt::Env(tys, g) {
    match p as λ x => rt::Env(tys, x.onto(g)) → rt::Env(tys, g) { PWorld => λ e => e, PVar(_, _, _) => λ e => e.snd }
}

fn Part::pop(tys: Nat → RecInfo, ps: List<Part>) → (g: List<Ty>) → rt::Env(tys, Part::ctx(ps, g)) → rt::Env(tys, g) {
    match ps { Nil => λ g e => e, Cons(p, rest) => λ g e => p.drop(tys, g, Part::pop(tys, rest, p.onto(g), e)) }
}

fn Part::drop_locs(self p: Part, el: List<Loc>) → List<Loc> { match p { PWorld => el, PVar(_, _, _) => el.tail() } }

fn Part::pop_locs(ps: List<Part>, el: List<Loc>) → List<Loc> {
    match ps { Nil => el, Cons(p, rest) => p.drop_locs(Part::pop_locs(rest, el)) }
}

fn ETm::base(self t: ETm, w: rt::World) → (g: List<Ty>) → rt::Env(w.tys, t.ctx_end(w, g)) → rt::Env(w.tys, g) {
    match t {
        Pure(_) => λ g ve => ve,
        Let(e, body) => λ g ve => body.base(w, Cons(e.ty(w, g), g), ve).snd,
        Invoke(e, _, body) => λ g ve => Effect::pop(w.tys, e.results(), g, body.base(w, Ty::bind_onto(e.results(), g), ve)),
        Lend(_, cap, _, _, body) => λ g ve => Effect::pop(w.tys, Lent::results(cap), g, body.base(w, Ty::bind_onto(Lent::results(cap), g), ve)),
        If(_, _, _, parts, body) => λ g ve => Part::pop(w.tys, parts, g, body.base(w, Part::ctx(parts, g), ve)),
    }
}

fn ETm::base_locs(self t: ETm, el: List<Loc>) → List<Loc> {
    match t {
        Pure(_) => el,
        Let(_, body) => body.base_locs(el).tail(),
        Invoke(e, _, body) => Loc::pop(e.results(), body.base_locs(el)),
        Lend(_, cap, _, _, body) => Loc::pop(Lent::results(cap), body.base_locs(el)),
        If(_, _, _, parts, body) => Part::pop_locs(parts, body.base_locs(el)),
    }
}

theorem Effect::pop_push(tys: Nat → RecInfo, rs: List<Ty>): (g: List<Ty>) → (env: rt::Env(tys, g)) → (x: Ty::Flats(rs)) →
    Effect::pop(tys, rs, g, Effect::push(tys, rs, g, env, x)) = env {
    match rs {
        Nil => λ g env x => refl,
        Cons(r, rest) => λ g env x => cong_fn(λ (e: rt::Env(tys, Cons(r, g))) => e.snd,
            Effect::pop_push(tys, rest, Cons(r, g), Pair(r.of_flat(tys, x.fst), env), x.snd)),
    }
}

theorem Part::pop_push(tys: Nat → RecInfo, ps: List<Part>): (g: List<Ty>) → (env: rt::Env(tys, g)) → (st: Part::State(tys, ps)) →
    Part::pop(tys, ps, g, Part::push(tys, ps, g, env, st)) = env {
    match ps {
        Nil => λ g env st => refl,
        Cons(p, rest) => λ g env st => {
            let v = Part::head(tys, p, rest, st);
            trans(cong_fn(λ (e: rt::Env(tys, p.onto(g))) => p.drop(tys, g, e),
                    Part::pop_push(tys, rest, p.onto(g), p.add(tys, g, env, v), Part::tail(tys, p, rest, st))),
                match p as λ x => (v: x.ty(tys)) → x.drop(tys, g, x.add(tys, g, env, v)) = env { PWorld => λ _ => refl, PVar(_, _, _) => λ _ => refl }(v))
        },
    }
}

// The variables before a computation are at its end as they were.
theorem ETm::base_end(self t: ETm, w: rt::World, ls: List<Lent>): (g: List<Ty>) → (env: rt::Env(w.tys, g)) → (io: Io) →
    t.base(w, g, t.sem_end(w, ls, g, env, io).value) = env {
    match t {
        Pure(_) => λ g env io => refl,
        Let(e, body) => λ g env io => cong_fn(λ (x: rt::Env(w.tys, Cons(e.ty(w, g), g))) => x.snd,
            body.base_end(w, ls, Cons(e.ty(w, g), g), Pair(e.sem(w, g, env), env), io)),
        Invoke(e, args, body) => λ g env io => {
            let a = Effect::apply(w, g, env, Mutated<Io, Ty::Flats(e.results())>, Mutated(io, Ty::flats_default(e.results())),
                e.params(), e.sem(w.tys, io), args);
            let g2 = Ty::bind_onto(e.results(), g);
            trans(cong_fn(λ (x: rt::Env(w.tys, g2)) => Effect::pop(w.tys, e.results(), g, x),
                    body.base_end(w, ls, g2, Effect::push(w.tys, e.results(), g, env, a.value), a.after)),
                Effect::pop_push(w.tys, e.results(), g, env, a.value))
        },
        Lend(f, cap, buf, args, body) => λ g env io => {
            let g2 = Ty::bind_onto(Lent::results(cap), g);
            let x = Lent::answer(w.tys, ls, g, env, f, cap, buf, args);
            trans(cong_fn(λ (y: rt::Env(w.tys, g2)) => Effect::pop(w.tys, Lent::results(cap), g, y),
                    body.base_end(w, ls, g2, Effect::push(w.tys, Lent::results(cap), g, env, x), io)),
                Effect::pop_push(w.tys, Lent::results(cap), g, env, x))
        },
        If(cond, yes, no, parts, body) => λ g env io => {
            let st = ETm::joined(w, ls, g, env, io, cond, yes, no, parts);
            let g2 = Part::ctx(parts, g);
            trans(cong_fn(λ (y: rt::Env(w.tys, g2)) => Part::pop(w.tys, parts, g, y),
                    body.base_end(w, ls, g2, Part::push(w.tys, parts, g, env, st), Part::world(w.tys, parts, st, io))),
                Part::pop_push(w.tys, parts, g, env, st))
        },
    }
}

// Dropping the variable a context's head is.
theorem locs_hold_tail(tys: Nat → RecInfo, env: Env, t: Ty, g: List<Ty>): (locs: List<Loc>) → (vals: rt::Env(tys, Cons(t, g))) →
    LocsHold(tys, env, Cons(t, g), locs, vals) → LocsHold(tys, env, g, locs.tail(), vals.snd) {
    λ locs => match locs {
        Nil => λ vals never => false_elim(never),
        Cons(_, _) => λ vals h => h.right,
    }
}

theorem Effect::pop_holds(tys: Nat → RecInfo, env: Env, rs: List<Ty>): (g: List<Ty>) → (el: List<Loc>) → (e: rt::Env(tys, Ty::bind_onto(rs, g))) →
    LocsHold(tys, env, Ty::bind_onto(rs, g), el, e) → LocsHold(tys, env, g, Loc::pop(rs, el), Effect::pop(tys, rs, g, e)) {
    match rs {
        Nil => λ g el e h => h,
        Cons(r, rest) => λ g el e h => locs_hold_tail(tys, env, r, g, Loc::pop(rest, el), Effect::pop(tys, rest, Cons(r, g), e),
            Effect::pop_holds(tys, env, rest, Cons(r, g), el, e, h)),
    }
}

theorem Part::pop_holds(tys: Nat → RecInfo, env: Env, ps: List<Part>): (g: List<Ty>) → (el: List<Loc>) → (e: rt::Env(tys, Part::ctx(ps, g))) →
    LocsHold(tys, env, Part::ctx(ps, g), el, e) → LocsHold(tys, env, g, Part::pop_locs(ps, el), Part::pop(tys, ps, g, e)) {
    match ps {
        Nil => λ g el e h => h,
        Cons(p, rest) => λ g el e h => {
            let inner = Part::pop_holds(tys, env, rest, p.onto(g), el, e, h);
            match p as λ x => (q: rt::Env(tys, x.onto(g))) → LocsHold(tys, env, x.onto(g), Part::pop_locs(rest, el), q) →
                    LocsHold(tys, env, g, x.drop_locs(Part::pop_locs(rest, el)), x.drop(tys, g, q)) {
                PWorld => λ q k => k,
                PVar(t, _, _) => λ q k => locs_hold_tail(tys, env, t, g, Part::pop_locs(rest, el), q, k),
            }(Part::pop(tys, rest, p.onto(g), e), inner)
        },
    }
}

theorem ETm::base_holds(self t: ETm, w: rt::World, env: Env): (g: List<Ty>) → (el: List<Loc>) → (ve: rt::Env(w.tys, t.ctx_end(w, g))) →
    LocsHold(w.tys, env, t.ctx_end(w, g), el, ve) → LocsHold(w.tys, env, g, t.base_locs(el), t.base(w, g, ve)) {
    match t {
        Pure(_) => λ g el ve h => h,
        Let(e, body) => λ g el ve h => locs_hold_tail(w.tys, env, e.ty(w, g), g, body.base_locs(el), body.base(w, Cons(e.ty(w, g), g), ve),
            body.base_holds(w, env, Cons(e.ty(w, g), g), el, ve, h)),
        Invoke(e, _, body) => λ g el ve h => Effect::pop_holds(w.tys, env, e.results(), g, body.base_locs(el), body.base(w, Ty::bind_onto(e.results(), g), ve),
            body.base_holds(w, env, Ty::bind_onto(e.results(), g), el, ve, h)),
        Lend(_, cap, _, _, body) => λ g el ve h => Effect::pop_holds(w.tys, env, Lent::results(cap), g, body.base_locs(el),
            body.base(w, Ty::bind_onto(Lent::results(cap), g), ve), body.base_holds(w, env, Ty::bind_onto(Lent::results(cap), g), el, ve, h)),
        If(_, _, _, parts, body) => λ g el ve h => Part::pop_holds(w.tys, env, parts, g, body.base_locs(el), body.base(w, Part::ctx(parts, g), ve),
            body.base_holds(w, env, Part::ctx(parts, g), el, ve, h)),
    }
}

// ---------------------------------------------------------------------------
// A branch: the joined state's parts

// The value parts of a state, as an environment over their codes.
fn Part::vals(tys: Nat → RecInfo, ps: List<Part>) → Part::State(tys, ps) → rt::Env(tys, Part::codes(ps)) {
    match ps {
        Nil => λ _ => trivial,
        Cons(p, rest) => match p as λ x => Part::State(tys, Cons(x, rest)) → rt::Env(tys, Part::codes(Cons(x, rest))) {
            PWorld => λ st => Part::vals(tys, rest, Part::tail(tys, PWorld, rest, st)),
            PVar(t, y, n) => λ st => Pair(Part::head(tys, PVar(t, y, n), rest, st), Part::vals(tys, rest, Part::tail(tys, PVar(t, y, n), rest, st))),
        },
    }
}

theorem Part::head_cons(tys: Nat → RecInfo, p: Part, rest: List<Part>, v: p.ty(tys), x: Part::State(tys, rest)):
    Part::head(tys, p, rest, Part::cons(tys, p, rest, v, x)) = v {
    match rest as λ r => (x: Part::State(tys, r)) → Part::head(tys, p, r, Part::cons(tys, p, r, v, x)) = v {
        Nil => λ _ => refl,
        Cons(_, _) => λ _ => refl,
    }(x)
}

theorem Part::tail_cons(tys: Nat → RecInfo, p: Part, rest: List<Part>, v: p.ty(tys), x: Part::State(tys, rest)):
    Part::tail(tys, p, rest, Part::cons(tys, p, rest, v, x)) = x {
    match rest as λ r => (x: Part::State(tys, r)) → Part::tail(tys, p, r, Part::cons(tys, p, r, v, x)) = x {
        Nil => λ _ => refl,
        Cons(_, _) => λ _ => refl,
    }(x)
}

// Where each value part lives at the end of an arm, its code checked.
fn Part::sources(ps: List<Part>, side: Bool, ce: List<Ty>, el: List<Loc>) → Option<List<Loc>> {
    match ps {
        Nil => Some(Nil),
        Cons(p, rest) => match p {
            PWorld => Part::sources(rest, side, ce, el),
            PVar(t, y, n) => match Ty::at(ce, Part::pick(side, y, n)).equation(t) {
                Inl(_) => Loc::at(el, Part::pick(side, y, n)).and_then(λ l => Part::sources(rest, side, ce, el).and_then(λ ls => Some(Cons(l, ls)))),
                Inr(_) => None,
            },
        },
    }
}

fn Part::SourcesHold(tys: Nat → RecInfo, ps: List<Part>, side: Bool, ce: List<Ty>, el: List<Loc>, r: Option<List<Loc>>) → Type {
    match r {
        None => True,
        Some(srcs) => (env: Env) → (ve: rt::Env(tys, ce)) → (io: Io) → LocsHold(tys, env, ce, el, ve) →
            LocsHold(tys, env, Part::codes(ps), srcs, Part::vals(tys, ps, Part::state(tys, ps, side, ce, ve, io))),
    }
}

theorem Part::sources_sound(tys: Nat → RecInfo, side: Bool, ce: List<Ty>, el: List<Loc>, ps: List<Part>):
    Part::SourcesHold(tys, ps, side, ce, el, Part::sources(ps, side, ce, el)) {
    match ps {
        Nil => λ env ve io _ => trivial,
        Cons(p, rest) => match p {
            PWorld => match Part::sources(rest, side, ce, el) as λ r => Part::SourcesHold(tys, rest, side, ce, el, r) →
                    Part::SourcesHold(tys, Cons(PWorld, rest), side, ce, el, r) {
                None => λ _ => trivial,
                Some(srcs) => λ ih env ve io held => j(sym(Part::tail_cons(tys, PWorld, rest, io, Part::state(tys, rest, side, ce, ve, io))),
                    λ s _ => LocsHold(tys, env, Part::codes(rest), srcs, Part::vals(tys, rest, s)), ih(env, ve, io, held)),
            }(Part::sources_sound(tys, side, ce, el, rest)),
            PVar(t, y, n) => {
                let k = Part::pick(side, y, n);
                let P = λ (r: Option<List<Loc>>) => Part::SourcesHold(tys, Cons(PVar(t, y, n), rest), side, ce, el, r);
                match Ty::at(ce, k).equation(t) as λ q => P(match q as λ _ => Option<List<Loc>> {
                        Inl(_) => Loc::at(el, k).and_then(λ l => Part::sources(rest, side, ce, el).and_then(λ ls => Some(Cons(l, ls)))),
                        Inr(_) => None,
                    }) {
                    Inl(e) => Option::and_then_elim(P, trivial, Loc::at(el, k), λ l => Part::sources(rest, side, ce, el).and_then(λ ls => Some(Cons(l, ls))),
                        λ l e_l => Option::and_then_elim(P, trivial, Part::sources(rest, side, ce, el), λ ls => Some(Cons(l, ls)), λ ls e_ls =>
                            λ env ve io held => {
                                let one = PVar(t, y, n).one(tys, side, ce, ve, io);
                                let more = Part::state(tys, rest, side, ce, ve, io);
                                let ih = j(e_ls, λ r _ => Part::SourcesHold(tys, rest, side, ce, el, r), Part::sources_sound(tys, side, ce, el, rest))(env, ve, io, held);
                                ⟨j(sym(Part::head_cons(tys, PVar(t, y, n), rest, one, more)), λ v _ => t.Kept(tys, env, l, v),
                                        Ty::kept_cast(tys, env, l, Ty::at(ce, k), t, e, Env::get(tys, ce, ve, k), locs_hold_at(tys, env, ce, el, ve, held, k, l, e_l))),
                                    j(sym(Part::tail_cons(tys, PVar(t, y, n), rest, one, more)), λ s _ => LocsHold(tys, env, Part::codes(rest), ls, Part::vals(tys, rest, s)), ih)⟩
                            })),
                    Inr(_) => trivial,
                }
            },
        },
    }
}

// Where the joined variables live after the join: each value part at its
// place, bound onto the places of the variables before.
fn Part::locs(ps: List<Part>, dsts: List<Loc>, base: List<Loc>) → List<Loc> {
    match ps {
        Nil => base,
        Cons(p, rest) => match p {
            PWorld => Part::locs(rest, dsts, base),
            PVar(_, _, _) => match dsts { Nil => base, Cons(d, ds) => Part::locs(rest, ds, Cons(d, base)) },
        },
    }
}

theorem Part::push_holds(tys: Nat → RecInfo, env: Env, ps: List<Part>): (g: List<Ty>) → (base: List<Loc>) → (vals: rt::Env(tys, g)) →
    (dsts: List<Loc>) → (st: Part::State(tys, ps)) →
    LocsHold(tys, env, Part::codes(ps), dsts, Part::vals(tys, ps, st)) → LocsHold(tys, env, g, base, vals) →
    LocsHold(tys, env, Part::ctx(ps, g), Part::locs(ps, dsts, base), Part::push(tys, ps, g, vals, st)) {
    match ps {
        Nil => λ g base vals dsts st _ hb => hb,
        Cons(p, rest) => match p {
            PWorld => λ g base vals dsts st hd hb =>
                Part::push_holds(tys, env, rest, g, base, vals, dsts, Part::tail(tys, PWorld, rest, st), hd, hb),
            PVar(t, y, n) => λ g base vals dsts => match dsts {
                Nil => λ st never _ => false_elim(never),
                Cons(d, ds) => λ st hd hb => Part::push_holds(tys, env, rest, Cons(t, g), Cons(d, base),
                    Pair(Part::head(tys, PVar(t, y, n), rest, st), vals), ds, Part::tail(tys, PVar(t, y, n), rest, st), hd.right, ⟨hd.left, hb⟩),
            },
        },
    }
}

// Which world the join leaves.
fn Part::world_pick(has: Bool, a: Io, b: Io) → Io { match has { True => a, False => b } }

theorem Part::world_state(tys: Nat → RecInfo, side: Bool, ce: List<Ty>, ve: rt::Env(tys, ce), a: Io, io: Io, ps: List<Part>):
    Part::world(tys, ps, Part::state(tys, ps, side, ce, ve, a), io) = Part::world_pick(Part::has_world(ps), a, io) {
    match ps {
        Nil => refl,
        Cons(p, rest) => match p {
            PWorld => Part::head_cons(tys, PWorld, rest, a, Part::state(tys, rest, side, ce, ve, a)),
            PVar(t, y, n) => trans(cong_fn(λ (s: Part::State(tys, rest)) => Part::world(tys, rest, s, io),
                    Part::tail_cons(tys, PVar(t, y, n), rest, PVar(t, y, n).one(tys, side, ce, ve, a), Part::state(tys, rest, side, ce, ve, a))),
                Part::world_state(tys, side, ce, ve, a, io, rest)),
        },
    }
}

// A computation that calls nothing on Linux, so leaves the world as it was.
fn ETm::silent(self t: ETm) → Bool {
    match t {
        Pure(_) => True,
        Let(_, body) => body.silent(),
        Invoke(_, _, _) => False,
        Lend(_, _, _, _, body) => body.silent(),
        If(_, yes, no, _, body) => yes.silent() && (no.silent() && body.silent()),
    }
}

theorem Part::world_same(has: Bool, io: Io): Part::world_pick(has, io, io) = io { match has { True => refl, False => refl } }

theorem ETm::silent_after(self t: ETm, w: rt::World, ls: List<Lent>): t.silent().IsTrue() → (g: List<Ty>) → (env: rt::Env(w.tys, g)) → (io: Io) →
    t.sem_end(w, ls, g, env, io).after = io {
    match t {
        Pure(_) => λ _ g env io => refl,
        Let(e, body) => λ s g env io => body.silent_after(w, ls, s, Cons(e.ty(w, g), g), Pair(e.sem(w, g, env), env), io),
        Invoke(_, _, _) => λ never g env io => false_elim(never),
        Lend(f, cap, buf, args, body) => λ s g env io => body.silent_after(w, ls, s, Ty::bind_onto(Lent::results(cap), g),
            Effect::push(w.tys, Lent::results(cap), g, env, Lent::answer(w.tys, ls, g, env, f, cap, buf, args)), io),
        If(cond, yes, no, parts, body) => λ s g env io => {
            let s1 = Bool::is_true_and(yes.silent(), no.silent() && body.silent(), s);
            let s2 = Bool::is_true_and(no.silent(), body.silent(), s1.right);
            let ys = yes.sem_end(w, ls, g, env, io);
            let ns = no.sem_end(w, ls, g, env, io);
            let yst = Part::state(w.tys, parts, True, yes.ctx_end(w, g), ys.value, ys.after);
            let nst = Part::state(w.tys, parts, False, no.ctx_end(w, g), ns.value, ns.after);
            let st = Part::branch(w.tys, parts, ETm::truth(w.tys, cond.ty(w, g), cond.sem(w, g, env)), yst, nst);
            let at_world: (Part::world(w.tys, parts, st, io) = io) =
                match ETm::truth(w.tys, cond.ty(w, g), cond.sem(w, g, env)) as λ b => Part::world(w.tys, parts, Part::branch(w.tys, parts, b, yst, nst), io) = io {
                    True => trans(Part::world_state(w.tys, True, yes.ctx_end(w, g), ys.value, ys.after, io, parts),
                        j(sym(yes.silent_after(w, ls, s1.left, g, env, io)), λ a _ => Part::world_pick(Part::has_world(parts), a, io) = io,
                            Part::world_same(Part::has_world(parts), io))),
                    False => trans(Part::world_state(w.tys, False, no.ctx_end(w, g), ns.value, ns.after, io, parts),
                        j(sym(no.silent_after(w, ls, s2.left, g, env, io)), λ a _ => Part::world_pick(Part::has_world(parts), a, io) = io,
                            Part::world_same(Part::has_world(parts), io))),
                };
            trans(body.silent_after(w, ls, s2.right, Part::ctx(parts, g), Part::push(w.tys, parts, g, env, st), Part::world(w.tys, parts, st, io)), at_world)
        },
    }
}

// ---------------------------------------------------------------------------
// A branch: where the joined variables go

// The place two arms leave a variable of code `t` in: one word, or for a
// buffer one buffer, or none (gone, which a later use refuses).
fn Loc::meet(t: Ty, a: Loc, b: Loc) → Option<Loc> {
    match t {
        Word(_) => match a { InWord(x) => match b { InWord(y) => match x.eq_dec(y) { Inl(_) => Some(InWord(x)), Inr(_) => None }, InBuffer(_) => None, Gone => None }, InBuffer(_) => None, Gone => None },
        Bit => match a { InWord(x) => match b { InWord(y) => match x.eq_dec(y) { Inl(_) => Some(InWord(x)), Inr(_) => None }, InBuffer(_) => None, Gone => None }, InBuffer(_) => None, Gone => None },
        ByteList(_) => match a { InWord(_) => None, Gone => Some(Gone), InBuffer(x) => match b { InWord(_) => None, Gone => Some(Gone),
            InBuffer(y) => match x.eq_dec(y) { Inl(_) => Some(InBuffer(x)), Inr(_) => Some(Gone) } } },
        Lines => None,
        Named(_) => None,
        Count => None,
        Enum(_) => None,
    }
}

fn Loc::MeetHolds(tys: Nat → RecInfo, t: Ty, a: Loc, b: Loc, r: Option<Loc>) → Type {
    match r {
        None => True,
        Some(m) => (env: Env) → (v: t.sem(tys)) → (t.Kept(tys, env, a, v) → t.Kept(tys, env, m, v)) ∧ (t.Kept(tys, env, b, v) → t.Kept(tys, env, m, v)),
    }
}

theorem Loc::meet_word(tys: Nat → RecInfo, t: Ty, x, y: Nat):
    Loc::MeetHolds(tys, t, InWord(x), InWord(y), match x.eq_dec(y) { Inl(_) => Some(InWord(x)), Inr(_) => None }) {
    match x.eq_dec(y) as λ d => Loc::MeetHolds(tys, t, InWord(x), InWord(y), match d { Inl(_) => Some(InWord(x)), Inr(_) => None }) {
        Inl(e) => λ env v => ⟨λ k => k, λ k => j(sym(e), λ z _ => t.Kept(tys, env, InWord(z), v), k)⟩,
        Inr(_) => trivial,
    }
}

theorem Loc::meet_sound(tys: Nat → RecInfo, t: Ty, a: Loc, b: Loc): Loc::MeetHolds(tys, t, a, b, Loc::meet(t, a, b)) {
    match t {
        Word(wd) => match a {
            InWord(x) => match b { InWord(y) => Loc::meet_word(tys, Word(wd), x, y), InBuffer(_) => trivial, Gone => trivial },
            InBuffer(_) => trivial,
            Gone => trivial,
        },
        Bit => match a {
            InWord(x) => match b { InWord(y) => Loc::meet_word(tys, Bit, x, y), InBuffer(_) => trivial, Gone => trivial },
            InBuffer(_) => trivial,
            Gone => trivial,
        },
        ByteList(c) => match a {
            InWord(_) => trivial,
            Gone => λ env v => ⟨λ _ => trivial, λ _ => trivial⟩,
            InBuffer(x) => match b {
                InWord(_) => trivial,
                Gone => λ env v => ⟨λ _ => trivial, λ _ => trivial⟩,
                InBuffer(y) => match x.eq_dec(y) as λ d => Loc::MeetHolds(tys, ByteList(c), InBuffer(x), InBuffer(y),
                        match d { Inl(_) => Some(InBuffer(x)), Inr(_) => Some(Gone) }) {
                    Inl(e) => λ env v => ⟨λ k => k, λ k => j(sym(e), λ z _ => ByteList(c).Kept(tys, env, InBuffer(z), v), k)⟩,
                    Inr(_) => λ env v => ⟨λ _ => trivial, λ _ => trivial⟩,
                },
            },
        },
        Lines => trivial,
        Named(_) => trivial,
        Count => trivial,
        Enum(_) => trivial,
    }
}

fn Loc::meets(g: List<Ty>, a: List<Loc>, b: List<Loc>) → Option<List<Loc>> {
    match g {
        Nil => match a { Nil => match b { Nil => Some(Nil), Cons(_, _) => None }, Cons(_, _) => None },
        Cons(t, rest) => match a {
            Nil => None,
            Cons(x, xs) => match b {
                Nil => None,
                Cons(y, ys) => Loc::meet(t, x, y).and_then(λ m => Loc::meets(rest, xs, ys).and_then(λ ms => Some(Cons(m, ms)))),
            },
        },
    }
}

fn Loc::MeetsHold(tys: Nat → RecInfo, g: List<Ty>, a: List<Loc>, b: List<Loc>, r: Option<List<Loc>>) → Type {
    match r {
        None => True,
        Some(m) => (env: Env) → (vals: rt::Env(tys, g)) →
            (LocsHold(tys, env, g, a, vals) → LocsHold(tys, env, g, m, vals)) ∧ (LocsHold(tys, env, g, b, vals) → LocsHold(tys, env, g, m, vals)),
    }
}

theorem Loc::meets_sound(tys: Nat → RecInfo, g: List<Ty>): (a: List<Loc>) → (b: List<Loc>) → Loc::MeetsHold(tys, g, a, b, Loc::meets(g, a, b)) {
    match g {
        Nil => λ a => match a {
            Nil => λ b => match b as λ q => Loc::MeetsHold(tys, Nil, Nil, q, Loc::meets(Nil, Nil, q)) {
                Nil => λ env vals => ⟨λ h => h, λ h => h⟩,
                Cons(_, _) => trivial,
            },
            Cons(_, _) => λ b => trivial,
        },
        Cons(t, rest) => λ a => match a {
            Nil => λ b => trivial,
            Cons(x, xs) => λ b => match b {
                Nil => trivial,
                Cons(y, ys) => {
                    let P = λ (r: Option<List<Loc>>) => Loc::MeetsHold(tys, Cons(t, rest), Cons(x, xs), Cons(y, ys), r);
                    Option::and_then_elim(P, trivial, Loc::meet(t, x, y), λ m => Loc::meets(rest, xs, ys).and_then(λ ms => Some(Cons(m, ms))), λ m e_m =>
                    Option::and_then_elim(P, trivial, Loc::meets(rest, xs, ys), λ ms => Some(Cons(m, ms)), λ ms e_ms => λ env vals => {
                        let one = j(e_m, λ r _ => Loc::MeetHolds(tys, t, x, y, r), Loc::meet_sound(tys, t, x, y))(env, vals.fst);
                        let more = j(e_ms, λ r _ => Loc::MeetsHold(tys, rest, xs, ys, r), Loc::meets_sound(tys, rest, xs, ys))(env, vals.snd);
                        ⟨λ h => ⟨one.left(h.left), more.left(h.right)⟩, λ h => ⟨one.right(h.left), more.right(h.right)⟩⟩
                    }))
                },
            },
        },
    }
}

// The fresh places of the joined variables, from `next` on: a word or a bit
// in a fresh word, a buffer where both arms leave it (or gone).
record Dests { locs: List<Loc>, next: Nat }

fn Part::dests(codes: List<Ty>, sy: List<Loc>, sn: List<Loc>, next: Nat) → Option<Dests> {
    match codes {
        Nil => Some(Dests(Nil, next)),
        Cons(t, rest) => match sy {
            Nil => None,
            Cons(a, ys) => match sn {
                Nil => None,
                Cons(b, ns) => match t {
                    ByteList(_) => Loc::meet(t, a, b).and_then(λ m => Part::dests(rest, ys, ns, next).and_then(λ d => Some(Dests(Cons(m, d.locs), d.next)))),
                    _ => Part::dests(rest, ys, ns, next + 1).and_then(λ d => Some(Dests(Cons(InWord(next), d.locs), d.next))),
                },
            },
        },
    }
}

// Every word of a layout below `next`, decided.
fn Loc::below(locs: List<Loc>, next: Nat) → Bool {
    match locs {
        Nil => True,
        Cons(l, rest) => match l { InWord(id) => (id + 1).leb(next) && Loc::below(rest, next), InBuffer(_) => Loc::below(rest, next), Gone => Loc::below(rest, next) },
    }
}

theorem Loc::below_sound(locs: List<Loc>, next: Nat): Loc::below(locs, next).IsTrue() → LocsBelow(locs, next) {
    match locs {
        Nil => λ _ => trivial,
        Cons(l, rest) => match l {
            InWord(id) => λ h => {
                let parts = Bool::is_true_and((id + 1).leb(next), Loc::below(rest, next), h);
                ⟨(id + 1).leb_sound(next, parts.left), Loc::below_sound(rest, next, parts.right)⟩
            },
            InBuffer(_) => λ h => ⟨trivial, Loc::below_sound(rest, next, h)⟩,
            Gone => λ h => ⟨trivial, Loc::below_sound(rest, next, h)⟩,
        },
    }
}

// ---------------------------------------------------------------------------
// The lowering

// The statements, the word the value ends in, and the next fresh word.
// The statements, the word the value lands in, the next fresh word, and
// where every variable of the end context lives after them.
record ELowered { stmt: Stmt, result: Nat, next: Nat, locs: List<Loc> }

// ---------------------------------------------------------------------------
// A branch, lowered

// What each arm runs after its statements, the places of the variables
// after the join, and the next fresh word.
record Joined { yes: Stmt, no: Stmt, locs: List<Loc>, next: Nat }

// The join of two lowered arms: each arm's value parts moved to fresh
// places (a buffer stays where both arms leave it), the variables before
// the branch where both arms leave them, the world a part when an arm calls
// Linux. Decided here, used once in the proof: the moves write no place a
// variable before the branch lives in, and every word is below the next
// fresh one.
fn ETm::join_lower(w: rt::World, g: List<Ty>, next: Nat, yes: ETm, no: ETm, parts: List<Part>, ly: ELowered, ln: ELowered) → Option<Joined> {
    Tm::check_true(Part::has_world(parts) || (yes.silent() && no.silent())).and_then(λ _ =>
    Part::sources(parts, True, yes.ctx_end(w, g), ly.locs).and_then(λ sy =>
    Part::sources(parts, False, no.ctx_end(w, g), ln.locs).and_then(λ sn =>
    Loc::meets(g, yes.base_locs(ly.locs), no.base_locs(ln.locs)).and_then(λ m =>
    Part::dests(Part::codes(parts), sy, sn, ly.next.max(ln.next)).and_then(λ ds =>
    Loc::moves(Part::codes(parts), ds.locs, sy).and_then(λ my =>
    Loc::moves(Part::codes(parts), ds.locs, sn).and_then(λ mn =>
    Tm::check_true(Loc::clear(yes.base_locs(ly.locs), Loc::words(ds.locs)) && (Loc::clear(no.base_locs(ln.locs), Loc::words(ds.locs))
        && (Loc::below(Part::locs(parts, ds.locs, m), ds.next) && next.leb(ds.next)))).and_then(λ _ =>
        Some(Joined(my, mn, Part::locs(parts, ds.locs, m), ds.next))))))))))
}

// `if cond { yes } else { no }` then `body`: the condition into its flag,
// a `Branch` on it to each arm's statements and moves, then the body's,
// from the places the join leaves. The arms and the body are lowered by
// the caller (`ylow`, `nlow`, `blow`), which recurses.
fn ETm::lower_if(w: rt::World, g: List<Ty>, locs: List<Loc>, next: Nat, cond: Tm, yes: ETm, no: ETm, parts: List<Part>,
    ylow: Nat → Option<ELowered>, nlow: Nat → Option<ELowered>, blow: List<Loc> → Nat → Option<ELowered>) → Option<ELowered> {
    Ty::check_bit(Tm::ty(cond, w, g)).and_then(λ _ =>
    ETm::lower_value(cond, w, g, locs, next).and_then(λ c =>
    ylow(c.next).and_then(λ ly =>
    nlow(c.next).and_then(λ ln =>
    ETm::join_lower(w, g, c.next, yes, no, parts, ly, ln).and_then(λ jn =>
    blow(jn.locs, jn.next).and_then(λ lb =>
        Some(ELowered(Then(Compute(c.region), Then(Branch(c.result, Then(ly.stmt, jn.yes), Then(ln.stmt, jn.no)), lb.stmt)),
            lb.result, lb.next, lb.locs))))))))
}

fn ETm::lower(self t: ETm, w: rt::World, ls: List<Lent>, g: List<Ty>, locs: List<Loc>, next: Nat) → Option<ELowered> {
    match t {
        Pure(v) => ETm::lower_value(v, w, g, locs, next).and_then(λ c => Some(ELowered(Compute(c.region), c.result, c.next, locs))),
        // The body sees the value as variable 0, in the word it was moved to.
        Let(e, body) => ETm::lower_value(e, w, g, locs, next).and_then(λ c =>
            body.lower(w, ls, Cons(Tm::ty(e, w, g), g), Cons(InWord(c.result), locs), c.next).and_then(λ lb =>
                Some(ELowered(Then(Compute(c.region), lb.stmt), lb.result, lb.next, lb.locs)))),
        // The body sees the call's results where it landed them.
        Invoke(e, args, body) => ETm::lower_call(e, g, locs, next, args).and_then(λ k =>
            body.lower(w, ls, Ty::bind_onto(e.results(), g), k.locs, next + 1).and_then(λ lb =>
                Some(ELowered(Then(Stmt::Invoke(k.shape), lb.stmt), lb.result, lb.next, lb.locs)))),
        // The body sees the bytes left and the word where the call left them.
        Lend(f, cap, buf, args, body) => ETm::lower_lend(w, ls, g, locs, next, f, cap, buf, args).and_then(λ k =>
            body.lower(w, ls, Ty::bind_onto(Lent::results(cap), g), k.locs, next + 1).and_then(λ lb =>
                Some(ELowered(Then(Compute(k.region), lb.stmt), lb.result, lb.next, lb.locs)))),
        If(cond, yes, no, parts, body) => ETm::lower_if(w, g, locs, next, cond, yes, no, parts,
            λ n => yes.lower(w, ls, g, locs, n), λ n => no.lower(w, ls, g, locs, n), λ l2 n => body.lower(w, ls, Part::ctx(parts, g), l2, n)),
    }
}

// Where a statement leaves the program: on, with the value kept in the
// result word.
fn Flow::Keeps(self flow: Flow, t: Ty, tys: Nat → RecInfo, result: Nat, v: t.sem(tys)) → Type {
    match flow { Onward(env) => t.Kept(tys, env, InWord(result), v), Exited(_) => False }
}

// The statements' threading lands where the meaning does: the same world,
// and the value in the result word.
fn ETm::Lands(t: Ty, tys: Nat → RecInfo, result: Nat, m: Mutated<Io, Flow>, e: Mutated<Io, t.sem(tys)>) → Type {
    (m.after = e.after) ∧ m.value.Keeps(t, tys, result, e.value)
}

// After the statements: every variable of the end context kept where the
// lowering says it lives, below the next fresh word.
fn ETm::EndHolds(self t: ETm, w: rt::World, ls: List<Lent>, g: List<Ty>, vals: rt::Env(w.tys, g), io: Io, next: Nat, l: ELowered, m: Mutated<Io, Flow>) → Type {
    m.value.KeepsAll(w.tys, t.ctx_end(w, g), l.locs, t.sem_end(w, ls, g, vals, io).value) ∧ (LocsBelow(l.locs, l.next) ∧ (next <= l.next))
}

// What a lowering promises: loop-free statements that, from any environment
// holding the variables and at any world, land where the meaning does, and
// leave the end context's variables where they live. The program's
// functions a pure term calls leave the file and answer their meanings; the
// ones the computation lends a buffer to answer the table.
fn ETm::LowerHolds(self t: ETm, w: rt::World, ls: List<Lent>, g: List<Ty>, locs: List<Loc>, next: Nat, r: Option<ELowered>) → Type {
    match r {
        None => True,
        Some(l) => l.stmt.straight().IsTrue() ∧ ((call: Writers()) → Writers::Still(call, functions_below(w.sigs.len())) → ((held: Buffers()) → Tm::CallsAgree(w, Writers::words(call, held))) →
            ETm::LentsAgree(ls, call) → (env: Env) → (vals: rt::Env(w.tys, g)) → (io: Io) →
            LocsHold(w.tys, env, g, locs, vals) → LocsBelow(locs, next) → 0 < next →
            ETm::Lands(t.ty(w, g), w.tys, l.result, Stmt::thread(l.stmt, call, env, io), t.sem(w, ls, g, vals, io))
                ∧ t.EndHolds(w, ls, g, vals, io, next, l, Stmt::thread(l.stmt, call, env, io))),
    }
}

// ---------------------------------------------------------------------------
// A branch, sound

// An arm and its moves land where the join says: the world the state's
// world part is (or the one before, when no arm calls), and the flow on,
// holding the state's value parts and the variables before the branch at
// the join's places.
fn ETm::ArmLands(w: rt::World, ls: List<Lent>, g: List<Ty>, parts: List<Part>, arm: ETm, l: ELowered, mv: Stmt, side: Bool, jlocs: List<Loc>,
    call: Writers(), env: Env, vals: rt::Env(w.tys, g), io: Io) → Type {
    (Stmt::thread(Then(l.stmt, mv), call, env, io).after = Part::world(w.tys, parts,
        Part::state(w.tys, parts, side, arm.ctx_end(w, g), arm.sem_end(w, ls, g, vals, io).value, arm.sem_end(w, ls, g, vals, io).after), io))
    ∧ Stmt::thread(Then(l.stmt, mv), call, env, io).value.KeepsAll(w.tys, Part::ctx(parts, g), jlocs, Part::push(w.tys, parts, g, vals,
        Part::state(w.tys, parts, side, arm.ctx_end(w, g), arm.sem_end(w, ls, g, vals, io).value, arm.sem_end(w, ls, g, vals, io).after)))
}

theorem ETm::arm_sound(w: rt::World, ls: List<Lent>, g: List<Ty>, locs: List<Loc>, next: Nat, parts: List<Part>, side: Bool,
    arm: ETm, l: ELowered, ah: ETm::LowerHolds(arm, w, ls, g, locs, next, Some(l)),
    srcs: List<Loc>, sh: Part::SourcesHold(w.tys, parts, side, arm.ctx_end(w, g), l.locs, Some(srcs)),
    dsts: List<Loc>, mv: Stmt, mh: Loc::MovesHold(w.tys, Part::codes(parts), dsts, srcs, Some(mv)),
    m: List<Loc>, meet: (e: Env) → (vals: rt::Env(w.tys, g)) → LocsHold(w.tys, e, g, arm.base_locs(l.locs), vals) → LocsHold(w.tys, e, g, m, vals),
    clear: Loc::clear(arm.base_locs(l.locs), Loc::words(dsts)).IsTrue(), quiet: (Part::has_world(parts) || arm.silent()).IsTrue(),
    call: Writers(), still: Writers::Still(call, functions_below(w.sigs.len())), agree: (held: Buffers()) → Tm::CallsAgree(w, Writers::words(call, held)),
    lents: ETm::LentsAgree(ls, call), env: Env, vals: rt::Env(w.tys, g), io: Io,
    held: LocsHold(w.tys, env, g, locs, vals), below: LocsBelow(locs, next), pos: 0 < next):
    ETm::ArmLands(w, ls, g, parts, arm, l, mv, side, Part::locs(parts, dsts, m), call, env, vals, io)
{
    let r = ah.right(call, still, agree, lents, env, vals, io, held, below, pos);
    let ce = arm.ctx_end(w, g);
    let ve = arm.sem_end(w, ls, g, vals, io).value;
    let a_end = arm.sem_end(w, ls, g, vals, io).after;
    let st = Part::state(w.tys, parts, side, ce, ve, a_end);
    let mb = Stmt::thread(l.stmt, call, env, io);
    let wa: (mb.after = a_end) = trans(r.left.left, sym(arm.sem_end_after(w, ls, g, vals, io)));
    let wj: (Part::world(w.tys, parts, st, io) = a_end) = trans(Part::world_state(w.tys, side, ce, ve, a_end, io, parts),
        match Part::has_world(parts) as λ h => (h || arm.silent()).IsTrue() → Part::world_pick(h, a_end, io) = a_end {
            True => λ _ => refl,
            False => λ s => sym(arm.silent_after(w, ls, s, g, vals, io)),
        }(quiet));
    let base = arm.base_locs(l.locs);
    let moved: (flow: Flow) → (e2: Env) → flow.KeepsAll(w.tys, Part::codes(parts), dsts, Part::vals(w.tys, parts, st)) → flow.Frames(base, e2) →
        LocsHold(w.tys, e2, g, base, vals) → flow.KeepsAll(w.tys, Part::ctx(parts, g), Part::locs(parts, dsts, m), Part::push(w.tys, parts, g, vals, st)) =
        λ flow => match flow {
            Onward(e3) => λ e2 kd fr hb => Part::push_holds(w.tys, e3, parts, g, m, vals, dsts, st, kd,
                meet(e3, vals, locs_hold_same(w.tys, e2, e3, g, base, vals, fr, hb))),
            Exited(_) => λ e2 never _ _ => false_elim(never),
        };
    let step: (flow: Flow) → (a: Io) → flow.KeepsAll(w.tys, ce, l.locs, ve) →
        (Stmt::then_thread(mv, call, Mutated(a, flow)).after = a)
            ∧ Stmt::then_thread(mv, call, Mutated(a, flow)).value.KeepsAll(w.tys, Part::ctx(parts, g), Part::locs(parts, dsts, m), Part::push(w.tys, parts, g, vals, st)) =
        λ flow => match flow {
            Onward(e2) => λ a held2 => {
                let hs = sh(e2, ve, a_end, held2);
                let mres = mh.right(call, e2, Part::vals(w.tys, parts, st), a, hs);
                let hb = j(arm.base_end(w, ls, g, vals, io), λ v _ => LocsHold(w.tys, e2, g, base, v), arm.base_holds(w, e2, g, l.locs, ve, held2));
                let m3 = Stmt::thread(mv, call, e2, a);
                ⟨mres.left, moved(m3.value, e2, mres.right.left, mres.right.right(base, clear), hb)⟩
            },
            Exited(_) => λ a never => false_elim(never),
        };
    let res = step(mb.value, mb.after, r.right.left);
    ⟨trans(res.left, trans(wa, sym(wj))), res.right⟩
}

// What a join promises: straight moves, the next fresh word past the
// arms', every word of the join's places below it, and each arm landing
// where the join says from an environment holding the variables.
fn ETm::JoinHolds(w: rt::World, ls: List<Lent>, g: List<Ty>, locs: List<Loc>, next: Nat, yes: ETm, no: ETm, parts: List<Part>, ly: ELowered, ln: ELowered,
    r: Option<Joined>) → Type {
    match r {
        None => True,
        Some(jn) => (jn.yes.straight() && jn.no.straight()).IsTrue() ∧ ((next <= jn.next) ∧ (LocsBelow(jn.locs, jn.next) ∧
            ((call: Writers()) → Writers::Still(call, functions_below(w.sigs.len())) → ((held: Buffers()) → Tm::CallsAgree(w, Writers::words(call, held))) →
                ETm::LentsAgree(ls, call) → (env: Env) → (vals: rt::Env(w.tys, g)) → (io: Io) →
                LocsHold(w.tys, env, g, locs, vals) → LocsBelow(locs, next) → 0 < next →
                ETm::ArmLands(w, ls, g, parts, yes, ly, jn.yes, True, jn.locs, call, env, vals, io)
                    ∧ ETm::ArmLands(w, ls, g, parts, no, ln, jn.no, False, jn.locs, call, env, vals, io)))),
    }
}

theorem ETm::quiet_yes(h: Bool, a, b: Bool): (h || (a && b)).IsTrue() → (h || a).IsTrue() {
    match h { True => λ _ => trivial, False => λ s => Bool::is_true_and(a, b, s).left }
}

theorem ETm::quiet_no(h: Bool, a, b: Bool): (h || (a && b)).IsTrue() → (h || b).IsTrue() {
    match h { True => λ _ => trivial, False => λ s => Bool::is_true_and(a, b, s).right }
}

theorem ETm::join_sound(w: rt::World, ls: List<Lent>, g: List<Ty>, locs: List<Loc>, next: Nat, yes: ETm, no: ETm, parts: List<Part>,
    ly: ELowered, ln: ELowered, yh: ETm::LowerHolds(yes, w, ls, g, locs, next, Some(ly)), nh: ETm::LowerHolds(no, w, ls, g, locs, next, Some(ln))):
    ETm::JoinHolds(w, ls, g, locs, next, yes, no, parts, ly, ln, ETm::join_lower(w, g, next, yes, no, parts, ly, ln)) {
    let P = λ (r: Option<Joined>) => ETm::JoinHolds(w, ls, g, locs, next, yes, no, parts, ly, ln, r);
    let codes = Part::codes(parts);
    let yb = yes.base_locs(ly.locs);
    let nb = no.base_locs(ln.locs);
    let top = ly.next.max(ln.next);
    Option::and_then_elim(P, trivial, Tm::check_true(Part::has_world(parts) || (yes.silent() && no.silent())), λ _ =>
        Part::sources(parts, True, yes.ctx_end(w, g), ly.locs).and_then(λ sy =>
        Part::sources(parts, False, no.ctx_end(w, g), ln.locs).and_then(λ sn =>
        Loc::meets(g, yb, nb).and_then(λ m =>
        Part::dests(codes, sy, sn, top).and_then(λ ds =>
        Loc::moves(codes, ds.locs, sy).and_then(λ my =>
        Loc::moves(codes, ds.locs, sn).and_then(λ mn =>
        Tm::check_true(Loc::clear(yb, Loc::words(ds.locs)) && (Loc::clear(nb, Loc::words(ds.locs))
            && (Loc::below(Part::locs(parts, ds.locs, m), ds.next) && next.leb(ds.next)))).and_then(λ _ =>
            Some(Joined(my, mn, Part::locs(parts, ds.locs, m), ds.next))))))))), λ quiet _ =>
    Option::and_then_elim(P, trivial, Part::sources(parts, True, yes.ctx_end(w, g), ly.locs), λ sy =>
        Part::sources(parts, False, no.ctx_end(w, g), ln.locs).and_then(λ sn =>
        Loc::meets(g, yb, nb).and_then(λ m =>
        Part::dests(codes, sy, sn, top).and_then(λ ds =>
        Loc::moves(codes, ds.locs, sy).and_then(λ my =>
        Loc::moves(codes, ds.locs, sn).and_then(λ mn =>
        Tm::check_true(Loc::clear(yb, Loc::words(ds.locs)) && (Loc::clear(nb, Loc::words(ds.locs))
            && (Loc::below(Part::locs(parts, ds.locs, m), ds.next) && next.leb(ds.next)))).and_then(λ _ =>
            Some(Joined(my, mn, Part::locs(parts, ds.locs, m), ds.next)))))))), λ sy e_sy =>
    Option::and_then_elim(P, trivial, Part::sources(parts, False, no.ctx_end(w, g), ln.locs), λ sn =>
        Loc::meets(g, yb, nb).and_then(λ m =>
        Part::dests(codes, sy, sn, top).and_then(λ ds =>
        Loc::moves(codes, ds.locs, sy).and_then(λ my =>
        Loc::moves(codes, ds.locs, sn).and_then(λ mn =>
        Tm::check_true(Loc::clear(yb, Loc::words(ds.locs)) && (Loc::clear(nb, Loc::words(ds.locs))
            && (Loc::below(Part::locs(parts, ds.locs, m), ds.next) && next.leb(ds.next)))).and_then(λ _ =>
            Some(Joined(my, mn, Part::locs(parts, ds.locs, m), ds.next))))))), λ sn e_sn =>
    Option::and_then_elim(P, trivial, Loc::meets(g, yb, nb), λ m =>
        Part::dests(codes, sy, sn, top).and_then(λ ds =>
        Loc::moves(codes, ds.locs, sy).and_then(λ my =>
        Loc::moves(codes, ds.locs, sn).and_then(λ mn =>
        Tm::check_true(Loc::clear(yb, Loc::words(ds.locs)) && (Loc::clear(nb, Loc::words(ds.locs))
            && (Loc::below(Part::locs(parts, ds.locs, m), ds.next) && next.leb(ds.next)))).and_then(λ _ =>
            Some(Joined(my, mn, Part::locs(parts, ds.locs, m), ds.next)))))), λ m e_m =>
    Option::and_then_elim(P, trivial, Part::dests(codes, sy, sn, top), λ ds =>
        Loc::moves(codes, ds.locs, sy).and_then(λ my =>
        Loc::moves(codes, ds.locs, sn).and_then(λ mn =>
        Tm::check_true(Loc::clear(yb, Loc::words(ds.locs)) && (Loc::clear(nb, Loc::words(ds.locs))
            && (Loc::below(Part::locs(parts, ds.locs, m), ds.next) && next.leb(ds.next)))).and_then(λ _ =>
            Some(Joined(my, mn, Part::locs(parts, ds.locs, m), ds.next))))), λ ds _ =>
    Option::and_then_elim(P, trivial, Loc::moves(codes, ds.locs, sy), λ my =>
        Loc::moves(codes, ds.locs, sn).and_then(λ mn =>
        Tm::check_true(Loc::clear(yb, Loc::words(ds.locs)) && (Loc::clear(nb, Loc::words(ds.locs))
            && (Loc::below(Part::locs(parts, ds.locs, m), ds.next) && next.leb(ds.next)))).and_then(λ _ =>
            Some(Joined(my, mn, Part::locs(parts, ds.locs, m), ds.next)))), λ my e_my =>
    Option::and_then_elim(P, trivial, Loc::moves(codes, ds.locs, sn), λ mn =>
        Tm::check_true(Loc::clear(yb, Loc::words(ds.locs)) && (Loc::clear(nb, Loc::words(ds.locs))
            && (Loc::below(Part::locs(parts, ds.locs, m), ds.next) && next.leb(ds.next)))).and_then(λ _ =>
            Some(Joined(my, mn, Part::locs(parts, ds.locs, m), ds.next))), λ mn e_mn =>
    Option::and_then_elim(P, trivial, Tm::check_true(Loc::clear(yb, Loc::words(ds.locs)) && (Loc::clear(nb, Loc::words(ds.locs))
            && (Loc::below(Part::locs(parts, ds.locs, m), ds.next) && next.leb(ds.next)))),
        λ _ => Some(Joined(my, mn, Part::locs(parts, ds.locs, m), ds.next)), λ ok _ => {
        let c1 = Bool::is_true_and(Loc::clear(yb, Loc::words(ds.locs)), Loc::clear(nb, Loc::words(ds.locs))
            && (Loc::below(Part::locs(parts, ds.locs, m), ds.next) && next.leb(ds.next)), ok);
        let c2 = Bool::is_true_and(Loc::clear(nb, Loc::words(ds.locs)), Loc::below(Part::locs(parts, ds.locs, m), ds.next) && next.leb(ds.next), c1.right);
        let c3 = Bool::is_true_and(Loc::below(Part::locs(parts, ds.locs, m), ds.next), next.leb(ds.next), c2.right);
        let mhy = j(e_my, λ r _ => Loc::MovesHold(w.tys, codes, ds.locs, sy, r), Loc::moves_sound(w.tys, codes, ds.locs, sy));
        let mhn = j(e_mn, λ r _ => Loc::MovesHold(w.tys, codes, ds.locs, sn, r), Loc::moves_sound(w.tys, codes, ds.locs, sn));
        let shy = j(e_sy, λ r _ => Part::SourcesHold(w.tys, parts, True, yes.ctx_end(w, g), ly.locs, r), Part::sources_sound(w.tys, True, yes.ctx_end(w, g), ly.locs, parts));
        let shn = j(e_sn, λ r _ => Part::SourcesHold(w.tys, parts, False, no.ctx_end(w, g), ln.locs, r), Part::sources_sound(w.tys, False, no.ctx_end(w, g), ln.locs, parts));
        let mt = j(e_m, λ r _ => Loc::MeetsHold(w.tys, g, yb, nb, r), Loc::meets_sound(w.tys, g, yb, nb));
        ⟨Bool::is_true_and_intro(my.straight(), mn.straight(), mhy.left, mhn.left), ⟨next.leb_sound(ds.next, c3.right),
            ⟨Loc::below_sound(Part::locs(parts, ds.locs, m), ds.next, c3.left),
            λ call still agree lents env vals io held below pos =>
                ⟨ETm::arm_sound(w, ls, g, locs, next, parts, True, yes, ly, yh, sy, shy, ds.locs, my, mhy, m, λ e v h => mt(e, v).left(h),
                    c1.left, ETm::quiet_yes(Part::has_world(parts), yes.silent(), no.silent(), quiet),
                    call, still, agree, lents, env, vals, io, held, below, pos),
                ETm::arm_sound(w, ls, g, locs, next, parts, False, no, ln, nh, sn, shn, ds.locs, mn, mhn, m, λ e v h => mt(e, v).right(h),
                    c2.left, ETm::quiet_no(Part::has_world(parts), yes.silent(), no.silent(), quiet),
                    call, still, agree, lents, env, vals, io, held, below, pos)⟩⟩⟩⟩
    }))))))))
}

// After the branch: the body from the join's places, at the joined state.
fn ETm::IfGoal(w: rt::World, ls: List<Lent>, g: List<Ty>, parts: List<Part>, body: ETm, vals: rt::Env(w.tys, g), io: Io, next: Nat, lb: ELowered,
    st: Part::State(w.tys, parts), m: Mutated<Io, Flow>) → Type {
    ETm::Lands(body.ty(w, Part::ctx(parts, g)), w.tys, lb.result, m,
        body.sem(w, ls, Part::ctx(parts, g), Part::push(w.tys, parts, g, vals, st), Part::world(w.tys, parts, st, io)))
    ∧ (m.value.KeepsAll(w.tys, body.ctx_end(w, Part::ctx(parts, g)), lb.locs,
            body.sem_end(w, ls, Part::ctx(parts, g), Part::push(w.tys, parts, g, vals, st), Part::world(w.tys, parts, st, io)).value)
        ∧ (LocsBelow(lb.locs, lb.next) ∧ (next <= lb.next)))
}

theorem ETm::if_tail(w: rt::World, ls: List<Lent>, g: List<Ty>, parts: List<Part>, body: ETm, jn: Joined, lb: ELowered,
    bh: ETm::LowerHolds(body, w, ls, Part::ctx(parts, g), jn.locs, jn.next, Some(lb)),
    call: Writers(), still: Writers::Still(call, functions_below(w.sigs.len())), agree: (held: Buffers()) → Tm::CallsAgree(w, Writers::words(call, held)),
    lents: ETm::LentsAgree(ls, call), vals: rt::Env(w.tys, g), io: Io, next: Nat, le: next <= jn.next, below: LocsBelow(jn.locs, jn.next), pos: 0 < jn.next,
    st: Part::State(w.tys, parts)): (a: Io) → (flow: Flow) → (a = Part::world(w.tys, parts, st, io)) →
    flow.KeepsAll(w.tys, Part::ctx(parts, g), jn.locs, Part::push(w.tys, parts, g, vals, st)) →
    ETm::IfGoal(w, ls, g, parts, body, vals, io, next, lb, st, Stmt::then_thread(lb.stmt, call, Mutated(a, flow)))
{
    let g2 = Part::ctx(parts, g);
    let v2 = Part::push(w.tys, parts, g, vals, st);
    λ a flow => match flow {
        Onward(e3) => λ wa held3 => {
            let r = bh.right(call, still, agree, lents, e3, v2, a, held3, below, pos);
            let m = Stmt::thread(lb.stmt, call, e3, a);
            j(wa, λ x _ => ETm::Lands(body.ty(w, g2), w.tys, lb.result, m, body.sem(w, ls, g2, v2, x))
                    ∧ (m.value.KeepsAll(w.tys, body.ctx_end(w, g2), lb.locs, body.sem_end(w, ls, g2, v2, x).value) ∧ (LocsBelow(lb.locs, lb.next) ∧ (next <= lb.next))),
                ⟨r.left, ⟨r.right.left, ⟨r.right.right.left, Nat::le_trans(next, jn.next, lb.next, le, r.right.right.right)⟩⟩⟩)
        },
        Exited(_) => λ _ never => false_elim(never),
    }
}

theorem ETm::lower_if_sound(w: rt::World, ls: List<Lent>, g: List<Ty>, locs: List<Loc>, next: Nat, cond: Tm, yes: ETm, no: ETm, parts: List<Part>, body: ETm,
    ylow: Nat → Option<ELowered>, nlow: Nat → Option<ELowered>, blow: List<Loc> → Nat → Option<ELowered>,
    yh: (n: Nat) → ETm::LowerHolds(yes, w, ls, g, locs, n, ylow(n)), nh: (n: Nat) → ETm::LowerHolds(no, w, ls, g, locs, n, nlow(n)),
    bh: (l2: List<Loc>) → (n: Nat) → ETm::LowerHolds(body, w, ls, Part::ctx(parts, g), l2, n, blow(l2, n))):
    ETm::LowerHolds(ETm::If(cond, yes, no, parts, body), w, ls, g, locs, next, ETm::lower_if(w, g, locs, next, cond, yes, no, parts, ylow, nlow, blow))
{
    let P = λ (r: Option<ELowered>) => ETm::LowerHolds(ETm::If(cond, yes, no, parts, body), w, ls, g, locs, next, r);
    Option::and_then_elim(P, trivial, Ty::check_bit(Tm::ty(cond, w, g)), λ _ =>
        ETm::lower_value(cond, w, g, locs, next).and_then(λ c =>
        ylow(c.next).and_then(λ ly =>
        nlow(c.next).and_then(λ ln =>
        ETm::join_lower(w, g, c.next, yes, no, parts, ly, ln).and_then(λ jn =>
        blow(jn.locs, jn.next).and_then(λ lb =>
            Some(ELowered(Then(Compute(c.region), Then(Branch(c.result, Then(ly.stmt, jn.yes), Then(ln.stmt, jn.no)), lb.stmt)),
                lb.result, lb.next, lb.locs))))))), λ eb _ =>
    Option::and_then_elim(P, trivial, ETm::lower_value(cond, w, g, locs, next), λ c =>
        ylow(c.next).and_then(λ ly =>
        nlow(c.next).and_then(λ ln =>
        ETm::join_lower(w, g, c.next, yes, no, parts, ly, ln).and_then(λ jn =>
        blow(jn.locs, jn.next).and_then(λ lb =>
            Some(ELowered(Then(Compute(c.region), Then(Branch(c.result, Then(ly.stmt, jn.yes), Then(ln.stmt, jn.no)), lb.stmt)),
                lb.result, lb.next, lb.locs)))))), λ c e_c =>
    Option::and_then_elim(P, trivial, ylow(c.next), λ ly =>
        nlow(c.next).and_then(λ ln =>
        ETm::join_lower(w, g, c.next, yes, no, parts, ly, ln).and_then(λ jn =>
        blow(jn.locs, jn.next).and_then(λ lb =>
            Some(ELowered(Then(Compute(c.region), Then(Branch(c.result, Then(ly.stmt, jn.yes), Then(ln.stmt, jn.no)), lb.stmt)),
                lb.result, lb.next, lb.locs))))), λ ly e_ly =>
    Option::and_then_elim(P, trivial, nlow(c.next), λ ln =>
        ETm::join_lower(w, g, c.next, yes, no, parts, ly, ln).and_then(λ jn =>
        blow(jn.locs, jn.next).and_then(λ lb =>
            Some(ELowered(Then(Compute(c.region), Then(Branch(c.result, Then(ly.stmt, jn.yes), Then(ln.stmt, jn.no)), lb.stmt)),
                lb.result, lb.next, lb.locs)))), λ ln e_ln =>
    Option::and_then_elim(P, trivial, ETm::join_lower(w, g, c.next, yes, no, parts, ly, ln), λ jn =>
        blow(jn.locs, jn.next).and_then(λ lb =>
            Some(ELowered(Then(Compute(c.region), Then(Branch(c.result, Then(ly.stmt, jn.yes), Then(ln.stmt, jn.no)), lb.stmt)),
                lb.result, lb.next, lb.locs))), λ jn e_jn =>
    Option::and_then_elim(P, trivial, blow(jn.locs, jn.next), λ lb =>
        Some(ELowered(Then(Compute(c.region), Then(Branch(c.result, Then(ly.stmt, jn.yes), Then(ln.stmt, jn.no)), lb.stmt)),
            lb.result, lb.next, lb.locs)), λ lb e_lb => {
        let vh = j(e_c, λ r _ => ETm::ValueHolds(cond, w, g, locs, next, r), ETm::value_sound(cond, w, g, locs, next));
        let yH = j(e_ly, λ r _ => ETm::LowerHolds(yes, w, ls, g, locs, c.next, r), yh(c.next));
        let nH = j(e_ln, λ r _ => ETm::LowerHolds(no, w, ls, g, locs, c.next, r), nh(c.next));
        let jH = j(e_jn, λ r _ => ETm::JoinHolds(w, ls, g, locs, c.next, yes, no, parts, ly, ln, r), ETm::join_sound(w, ls, g, locs, c.next, yes, no, parts, ly, ln, yH, nH));
        let bH = j(e_lb, λ r _ => ETm::LowerHolds(body, w, ls, Part::ctx(parts, g), jn.locs, jn.next, r), bh(jn.locs, jn.next));
        let js = Bool::is_true_and(jn.yes.straight(), jn.no.straight(), jH.left);
        let Y = Then(ly.stmt, jn.yes);
        let N = Then(ln.stmt, jn.no);
        let straight = Bool::is_true_and_intro(True, Branch(c.result, Y, N).straight() && lb.stmt.straight(), trivial,
            Bool::is_true_and_intro(Branch(c.result, Y, N).straight(), lb.stmt.straight(),
                Bool::is_true_and_intro(Y.straight(), N.straight(),
                    Bool::is_true_and_intro(ly.stmt.straight(), jn.yes.straight(), yH.left, js.left),
                    Bool::is_true_and_intro(ln.stmt.straight(), jn.no.straight(), nH.left, js.right)),
                bH.left));
        ⟨straight, λ call still agree lents env vals io held below pos => {
            let ran = vh.right(call, still, agree, env, vals, held, below, pos);
            let env1 = env.compute(call, c.region);
            let held1: LocsHold(w.tys, env1, g, locs, vals) = ran.right.right;
            let cle: (next <= c.next) = Nat::le_trans(next, c.result, c.next, ran.left,
                j(sym(vh.left), λ n _ => c.result <= n, Nat::le_succ_r(c.result, c.result, c.result.le_refl())));
            let below1 = locs_below_mono(locs, next, c.next, cle, below);
            let pos1 = Nat::lt_of_lt_of_le(0, next, c.next, pos, cle);
            let jle: (next <= jn.next) = Nat::le_trans(next, c.next, jn.next, cle, jH.right.left);
            let jpos = Nat::lt_of_lt_of_le(0, next, jn.next, pos, jle);
            let arms = jH.right.right.right(call, still, agree, lents, env1, vals, io, held1, below1, pos1);
            let bit = ETm::bit_kept(w.tys, env1, c.result, Tm::ty(cond, w, g), eb, Tm::sem(cond, w, g, vals), ran.right.left);
            let ys = Part::state(w.tys, parts, True, yes.ctx_end(w, g), yes.sem_end(w, ls, g, vals, io).value, yes.sem_end(w, ls, g, vals, io).after);
            let ns = Part::state(w.tys, parts, False, no.ctx_end(w, g), no.sem_end(w, ls, g, vals, io).value, no.sem_end(w, ls, g, vals, io).after);
            let tail = ETm::if_tail(w, ls, g, parts, body, jn, lb, bH, call, still, agree, lents, vals, io, next, jle, jH.right.right.left, jpos);
            let truth = ETm::truth(w.tys, Tm::ty(cond, w, g), Tm::sem(cond, w, g, vals));
            let at_truth = match truth as λ b => ETm::IfGoal(w, ls, g, parts, body, vals, io, next, lb, Part::branch(w.tys, parts, b, ys, ns),
                    Stmt::then_thread(lb.stmt, call, match b as λ _ => Mutated<Io, Flow> { True => Stmt::thread(Y, call, env1, io), False => Stmt::thread(N, call, env1, io) })) {
                True => tail(ys, Stmt::thread(Y, call, env1, io).after, Stmt::thread(Y, call, env1, io).value, arms.left.left, arms.left.right),
                False => tail(ns, Stmt::thread(N, call, env1, io).after, Stmt::thread(N, call, env1, io).value, arms.right.left, arms.right.right),
            };
            j(sym(bit), λ x _ => ETm::IfGoal(w, ls, g, parts, body, vals, io, next, lb, Part::branch(w.tys, parts, truth, ys, ns),
                    Stmt::then_thread(lb.stmt, call, match x as λ _ => Mutated<Io, Flow> { True => Stmt::thread(Y, call, env1, io), False => Stmt::thread(N, call, env1, io) })),
                at_truth)
        }⟩
    }))))))
}

// The theorem, by induction over the computation.
theorem ETm::lower_sound(self t: ETm, w: rt::World, ls: List<Lent>): (g: List<Ty>) → (locs: List<Loc>) → (next: Nat) →
    ETm::LowerHolds(t, w, ls, g, locs, next, t.lower(w, ls, g, locs, next)) {
    match t {
        Pure(v) => λ g locs next => {
            let P = λ (r: Option<ELowered>) => ETm::LowerHolds(ETm::Pure(v), w, ls, g, locs, next, r);
            Option::and_then_elim(P, trivial, ETm::lower_value(v, w, g, locs, next), λ c => Some(ELowered(Compute(c.region), c.result, c.next, locs)),
                λ c e_c => ⟨trivial, λ call still agree lents env vals io held below pos => {
                    let vh = j(e_c, λ r _ => ETm::ValueHolds(v, w, g, locs, next, r), ETm::value_sound(v, w, g, locs, next));
                    let ran = vh.right(call, still, agree, env, vals, held, below, pos);
                    let le: (next <= c.next) = Nat::le_trans(next, c.result, c.next, ran.left,
                        j(sym(vh.left), λ n _ => c.result <= n, Nat::le_succ_r(c.result, c.result, c.result.le_refl())));
                    ⟨⟨refl, ran.right.left⟩, ⟨ran.right.right, ⟨locs_below_mono(locs, next, c.next, le, below), le⟩⟩⟩
                }⟩)
        },
        Let(e, body) => λ g locs next => {
            let P = λ (r: Option<ELowered>) => ETm::LowerHolds(ETm::Let(e, body), w, ls, g, locs, next, r);
            let g2 = Cons(Tm::ty(e, w, g), g);
            Option::and_then_elim(P, trivial, ETm::lower_value(e, w, g, locs, next),
                λ c => body.lower(w, ls, g2, Cons(InWord(c.result), locs), c.next).and_then(λ lb =>
                    Some(ELowered(Then(Compute(c.region), lb.stmt), lb.result, lb.next, lb.locs))), λ c e_c =>
            Option::and_then_elim(P, trivial, body.lower(w, ls, g2, Cons(InWord(c.result), locs), c.next),
                λ lb => Some(ELowered(Then(Compute(c.region), lb.stmt), lb.result, lb.next, lb.locs)), λ lb e_lb => {
                let vh = j(e_c, λ r _ => ETm::ValueHolds(e, w, g, locs, next, r), ETm::value_sound(e, w, g, locs, next));
                let ih = j(e_lb, λ r _ => ETm::LowerHolds(body, w, ls, g2, Cons(InWord(c.result), locs), c.next, r),
                    body.lower_sound(w, ls, g2, Cons(InWord(c.result), locs), c.next));
                ⟨ih.left, λ call still agree lents env vals io held below pos => {
                    let ran = vh.right(call, still, agree, env, vals, held, below, pos);
                    let fresh: (c.result < c.next) = j(sym(vh.left), λ n _ => c.result < n, c.result.lt_succ_self());
                    let le: (next <= c.next) = Nat::le_trans(next, c.result, c.next, ran.left, Nat::le_trans(c.result, c.result + 1, c.next,
                        Nat::le_succ_r(c.result, c.result, c.result.le_refl()), fresh));
                    let r = ih.right(call, still, agree, lents, env.compute(call, c.region), Pair(Tm::sem(e, w, g, vals), vals), io, ran.right,
                        ⟨fresh, locs_below_mono(locs, next, c.next, le, below)⟩, Nat::lt_of_lt_of_le(0, next, c.next, pos, le));
                    ⟨r.left, ⟨r.right.left, ⟨r.right.right.left, Nat::le_trans(next, c.next, lb.next, le, r.right.right.right)⟩⟩⟩
                }⟩
            }))
        },
        Invoke(e, args, body) => λ g locs next => {
            let P = λ (r: Option<ELowered>) => ETm::LowerHolds(ETm::Invoke(e, args, body), w, ls, g, locs, next, r);
            let g2 = Ty::bind_onto(e.results(), g);
            Option::and_then_elim(P, trivial, ETm::lower_call(e, g, locs, next, args),
                λ k => body.lower(w, ls, g2, k.locs, next + 1).and_then(λ lb => Some(ELowered(Then(Stmt::Invoke(k.shape), lb.stmt), lb.result, lb.next, lb.locs))),
                λ k e_k =>
            Option::and_then_elim(P, trivial, body.lower(w, ls, g2, k.locs, next + 1),
                λ lb => Some(ELowered(Then(Stmt::Invoke(k.shape), lb.stmt), lb.result, lb.next, lb.locs)), λ lb e_lb => {
                let ch = j(e_k, λ r _ => ETm::CallHolds(e, w, g, locs, next, args, r), ETm::call_sound(e, w, g, locs, next, args));
                let ih = j(e_lb, λ r _ => ETm::LowerHolds(body, w, ls, g2, k.locs, next + 1, r), body.lower_sound(w, ls, g2, k.locs, next + 1));
                ⟨ih.left, λ call still agree lents env vals io held below pos => {
                    let ans = ch(env, vals, io, held, below);
                    let after = Io::call(io, k.shape.cmd(env)).after;
                    let env2 = k.shape.answer(env, Io::call(io, k.shape.cmd(env)).value);
                    let vals2 = Effect::push(w.tys, e.results(), g, vals, ETm::applied(e, w, g, vals, io, args).value);
                    let r = ih.right(call, still, agree, lents, env2, vals2, after, ans.right.left, ans.right.right,
                            Nat::lt_of_lt_of_le(0, next, next + 1, pos, Nat::le_succ_r(next, next, next.le_refl())));
                    j(ans.left, λ y _ => ETm::Lands(body.ty(w, g2), w.tys, lb.result, Stmt::thread(lb.stmt, call, env2, after), body.sem(w, ls, g2, vals2, y))
                            ∧ (Stmt::thread(lb.stmt, call, env2, after).value.KeepsAll(w.tys, body.ctx_end(w, g2), lb.locs, body.sem_end(w, ls, g2, vals2, y).value)
                                ∧ (LocsBelow(lb.locs, lb.next) ∧ (next <= lb.next))),
                        ⟨r.left, ⟨r.right.left, ⟨r.right.right.left,
                            Nat::le_trans(next, next + 1, lb.next, Nat::le_succ_r(next, next, next.le_refl()), r.right.right.right)⟩⟩⟩)
                }⟩
            }))
        },
        Lend(f, cap, buf, args, body) => λ g locs next => {
            let P = λ (r: Option<ELowered>) => ETm::LowerHolds(ETm::Lend(f, cap, buf, args, body), w, ls, g, locs, next, r);
            let g2 = Ty::bind_onto(Lent::results(cap), g);
            Option::and_then_elim(P, trivial, ETm::lower_lend(w, ls, g, locs, next, f, cap, buf, args),
                λ k => body.lower(w, ls, g2, k.locs, next + 1).and_then(λ lb => Some(ELowered(Then(Compute(k.region), lb.stmt), lb.result, lb.next, lb.locs))),
                λ k e_k =>
            Option::and_then_elim(P, trivial, body.lower(w, ls, g2, k.locs, next + 1),
                λ lb => Some(ELowered(Then(Compute(k.region), lb.stmt), lb.result, lb.next, lb.locs)), λ lb e_lb => {
                let ch = j(e_k, λ r _ => ETm::LendHolds(w, ls, g, locs, next, f, cap, buf, args, r), ETm::lend_sound(w, ls, g, locs, next, f, cap, buf, args));
                let ih = j(e_lb, λ r _ => ETm::LowerHolds(body, w, ls, g2, k.locs, next + 1, r), body.lower_sound(w, ls, g2, k.locs, next + 1));
                ⟨ih.left, λ call still agree lents env vals io held below pos => {
                    let ans = ch(call, lents, env, vals, held, below);
                    let vals2 = Effect::push(w.tys, Lent::results(cap), g, vals, Lent::answer(w.tys, ls, g, vals, f, cap, buf, args));
                    let r = ih.right(call, still, agree, lents, env.compute(call, k.region), vals2, io, ans.left, ans.right,
                        Nat::lt_of_lt_of_le(0, next, next + 1, pos, Nat::le_succ_r(next, next, next.le_refl())));
                    ⟨r.left, ⟨r.right.left, ⟨r.right.right.left,
                        Nat::le_trans(next, next + 1, lb.next, Nat::le_succ_r(next, next, next.le_refl()), r.right.right.right)⟩⟩⟩
                }⟩
            }))
        },
        If(cond, yes, no, parts, body) => λ g locs next => ETm::lower_if_sound(w, ls, g, locs, next, cond, yes, no, parts, body,
            λ n => yes.lower(w, ls, g, locs, n), λ n => no.lower(w, ls, g, locs, n), λ l2 n => body.lower(w, ls, Part::ctx(parts, g), l2, n),
            λ n => yes.lower_sound(w, ls, g, locs, n), λ n => no.lower_sound(w, ls, g, locs, n), λ l2 n => body.lower_sound(w, ls, Part::ctx(parts, g), l2, n)),
    }
}

// ---------------------------------------------------------------------------
// The R6 statement: `Io::Reads`

// A value read back from the word it ends in: a word at its width, a bit as
// its one-bit word's bit (the default for the codes no lowering ends in).
fn Ty::read_back(self t: Ty, tys: Nat → RecInfo, env: Env, id: Nat) → t.sem(tys) {
    match t as λ x => x.sem(tys) {
        Word(w) => ETm::word_at(w, env.number(id)),
        Bit => ETm::word_at(1, env.number(id)).head_bit(),
        ByteList(c) => ByteList(c).default(tys),
        Lines => Lines.default(tys),
        Named(i) => Named(i).default(tys),
        Count => Count.default(tys),
        Enum(i) => Enum(i).default(tys),
    }
}

// A flow that left the program reads back as its status, the word an
// `Exit` after the statements would have reported (`Stmt::exit_reads`); no
// lowering's statements leave the program (`Flow::Keeps`).
fn Flow::read_back(self flow: Flow, t: Ty, tys: Nat → RecInfo, id: Nat) → t.sem(tys) {
    match flow { Onward(env) => t.read_back(tys, env, id), Exited(status) => t.read_back(tys, native_source::Env([status.toNat()], [], []), 0) }
}

theorem Ty::read_back_kept(self t: Ty, tys: Nat → RecInfo, env: Env, id: Nat): (v: t.sem(tys)) → t.Kept(tys, env, InWord(id), v) →
    t.read_back(tys, env, id) = v {
    match t {
        Word(w) => λ v (k: env.number(id) = v.toNat()) => ETm::word_at_kept(w, env, id, v, k),
        Bit => λ v (k: env.number(id) = BitVec::ofBool(v).toNat()) =>
            trans(cong_fn(λ (x: BitVec(1)) => x.head_bit(), ETm::word_at_kept(1, env, id, BitVec::ofBool(v), k)), BitVec::head_bit_ofBool(v)),
        ByteList(_) => λ v never => false_elim(never),
        Lines => λ v never => false_elim(never),
        Named(_) => λ v never => false_elim(never),
        Count => λ v never => false_elim(never),
        Enum(_) => λ v never => false_elim(never),
    }
}

theorem Flow::read_back_keeps(self flow: Flow, t: Ty, tys: Nat → RecInfo, id: Nat, v: t.sem(tys)): flow.Keeps(t, tys, id, v) →
    flow.read_back(t, tys, id) = v {
    match flow {
        Onward(env) => λ k => t.read_back_kept(tys, env, id, v, k),
        Exited(_) => λ never => false_elim(never),
    }
}

// The lowered statements' tree, read against any world, with the value read
// back from its word, agrees with the computation's meaning up to silent
// steps: `Io::Reads`, the agreement the default setup's `sound` states for
// an effectful function (docs/native/runtime-fn-setups-design.md §6.1), from an
// environment that holds the variables.
fn ETm::lower_reads(self t: ETm, w: rt::World, ls: List<Lent>, g: List<Ty>, locs: List<Loc>, next: Nat, l: ELowered, lowered: t.lower(w, ls, g, locs, next) = Some(l),
    call: Writers(), still: Writers::Still(call, functions_below(w.sigs.len())), agree: (held: Buffers()) → Tm::CallsAgree(w, Writers::words(call, held)),
    lents: ETm::LentsAgree(ls, call), perform: PerformsCo(), env: Env, vals: rt::Env(w.tys, g),
    held: LocsHold(w.tys, env, g, locs, vals), below: LocsBelow(locs, next), pos: 0 < next) →
    Io::Reads<t.ty(w, g).sem(w.tys)>(CoTree::map(Events::linux(), l.stmt.denote_co(call, perform)(env), λ flow => flow.read_back(t.ty(w, g), w.tys, l.result)),
        λ io => CRet(t.sem(w, ls, g, vals, io)))
{
    let holds = j(lowered, λ r _ => ETm::LowerHolds(t, w, ls, g, locs, next, r), t.lower_sound(w, ls, g, locs, next));
    let ty = t.ty(w, g);
    let back: Mutated<Io, Flow> → Partial(Mutated<Io, ty.sem(w.tys)>) = λ m => CRet(Mutated(m.after, m.value.read_back(ty, w.tys, l.result)));
    let bound = Io::reads_bind<Flow, ty.sem(w.tys)>(l.stmt.denote_co(call, perform)(env), λ io => CRet(Stmt::thread(l.stmt, call, env, io)),
        λ flow => CRet(flow.read_back(ty, w.tys, l.result)), λ flow io => CRet(Mutated(io, flow.read_back(ty, w.tys, l.result))),
        Stmt::reads_thread(l.stmt, call, perform, holds.left, env), λ flow => Io::reads_ret(flow.read_back(ty, w.tys, l.result)));
    λ io => {
        let m = Stmt::thread(l.stmt, call, env, io);
        let lands = holds.right(call, still, agree, lents, env, vals, io, held, below, pos).left;
        let same: (back(m) = CRet(t.sem(w, ls, g, vals, io))) =
            eq2<Io, ty.sem(w.tys), Partial(Mutated<Io, ty.sem(w.tys)>)>(λ a x => CRet(Mutated(a, x)), lands.left,
                m.value.read_back_keeps(ty, w.tys, l.result, t.sem(w, ls, g, vals, io).value, lands.right));
        Eutt::trans(Events::none(), Io::against_co(CoTree::map(Events::linux(), l.stmt.denote_co(call, perform)(env), λ flow => flow.read_back(ty, w.tys, l.result)), io),
            CoTree::bind<Mutated<Io, Flow>, Mutated<Io, ty.sem(w.tys)>>(Events::none(), CRet(m), λ m2 => back(m2)),
            CRet(t.sem(w, ls, g, vals, io)),
            bound(io),
            j(same, λ y _ => Eutt<Mutated<Io, ty.sem(w.tys)>>(Events::none(), CoTree::bind<Mutated<Io, Flow>, Mutated<Io, ty.sem(w.tys)>>(Events::none(), CRet(m), λ m2 => back(m2)), y),
                Eutt::bind_ret_l<Mutated<Io, Flow>, Mutated<Io, ty.sem(w.tys)>>(Events::none(), m, λ m2 => back(m2))))
    }
}

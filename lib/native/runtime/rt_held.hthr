// A computation over a span, read as a computation over what the span
// holds (docs/layout-design.md §9.2): a second meaning of the terms of
// `rt_file.hthr`, and the theorem that the two agree.
//
// A `runtime fn` whose receiver is a laid record is a function of the
// record: `t.count` is the record's projection, and `t.count := e` is the
// record with the field replaced. The code is a function of bytes. The
// two are equal by a theorem (`Part::reads`, `Part::get_put`) and not by
// computation, so a function of the record cannot be pinned to the byte
// meaning by conversion, which is how every `runtime fn` is pinned.
//
// So the same terms get a second meaning, `FTm::held`, over a world that
// marks some of the program's functions: a pure function may be a
// codec's **reader** (`Reads(width, fields)`), and a computation a
// codec's **writer** (`Writes(width, fields)`), each with the fields of
// the record it reaches, by where they lie. A field access is a call of
// the codec's own accessor on the span's place, its length word and the
// field's offset, so no function is compiled per field. The held meaning
// answers the record the computation leaves and its value, a
// `Mutated<A, R>`, which is what a function of the record answers. A
// bound call of a reader at a field's offset answers the field of the
// record, a writer's call there leaves the record with the field set,
// and everything else is the byte meaning's. The
// span's bytes are an operand it carries for the terms that are not
// field accesses, and never part of its answer: an answer that held them
// would put a projection around every branch, and a projection of a
// stuck `match` is not the match of the projections. Where every field
// access is a marked call, the record and the value never read the
// bytes, so a function of the record is its reflection's held meaning by
// `refl` (the probes pin a straight-line one and one with a branch).
//
// `FTm::held_runs` is the agreement, by induction over the term, once:
// where the span holds a record under its length word (`Stored::Holds`)
// and the world keeps its marks' promises (`Sound`, one proof per field
// of a marked function, each one application of a lemma of
// `rt_held_fields.hthr`),
// the held meaning's value is the byte meaning's, and the bytes the byte
// meaning leaves hold the record the held meaning leaves. `FFun::held_runs`
// is the same for a function, in the shape a function's own statement is
// read off by conversion. Nothing is proved per function.
//
// A store is a field's only where its offset is one: the verdict
// (`FTm::kept`) reads the offset off the literal that bound the variable
// (`Tm::literal`), and the agreement carries what the verdict knew of
// the variables to the environment (`FTm::Knows`). A read needs no such
// knowledge: at an offset that is no field's it is the byte meaning's.
//
// A computation may also be another held function (`Runs(words, run)`):
// its call answers what its function of the record answers and leaves
// what that leaves, and what it owes (`HWorld::Runs`) is its own
// agreement, which its generator published.
//
// Not here yet: a loop (`Again`), a lend, a byte stored outside a field
// and a store at a computed offset (an array's element at an index that
// is a word) are refused by `FTm::kept`; the first needs the floor of
// docs/layout-design.md §9.3.
import logic;
import bool;
import nat;
import list;
import option;
import pair;
import bitvec;
import bitvec_nat;
import nat_map;
import list_window;
import layout;
import stored;
import rt;
import rt_lower;
import rt_file;

// What a pure function of the program is to a held computation: any
// function, or a reader of fields of the `A` the span holds, each by the
// offset it lies at, answering a word of `width` bits. A reader takes
// the span's place, its length word and the offset.
inductive Reader<A> { Plain, Reads(width: Nat, fields: List<Pair<Nat, A → BitVec(width)>>) }

// What a computation of the program is to one: not held, the store of a
// word into a field, by the offset the field lies at, or another held
// function, by the function of what the span holds that it is. A writer
// takes the span's place, its length word, the offset and the word; a
// held function the span's place, its length word and `words` words,
// which its function of the record takes as a list.
inductive Writer<A> {
    Apart,
    Writes(width: Nat, fields: List<Pair<Nat, A → BitVec(width) → A>>),
    Runs(words: Nat, run: A → List<BitVec(64)> → Mutated<A, BitVec(64)>),
}

// The marks of a program's functions, in the order of its tables; a
// function past a list's end is the plain kind.
record HWorld<A> { fw: FWorld, readers: List<Reader<A>>, writers: List<Writer<A>> }

fn Reader::at<A>(rs: List<Reader<A>>, f: Nat) → Reader<A> {
    match rs { Nil => Plain, Cons(r, rest) => match f { Zero => r, Succ(k) => Reader::at(rest, k) } }
}

fn Writer::at<A>(ws: List<Writer<A>>, f: Nat) → Writer<A> {
    match ws { Nil => Apart, Cons(w, rest) => match f { Zero => w, Succ(k) => Writer::at(rest, k) } }
}

// The field at an offset among a mark's, the first that lies there.
fn FTm::field<X>(fields: List<Pair<Nat, X>>, at: Nat) → Option<X> {
    match fields {
        Nil => None,
        Cons(f, rest) => match at.same(f.fst) { True => Some(f.snd), False => FTm::field(rest, at) },
    }
}

fn FTm::is_field<X>(fields: List<Pair<Nat, X>>, at: Nat) → Bool { match FTm::field(fields, at) { None => False, Some(_) => True } }

// Something of every field of a mark: a tuple, one part per field.
fn FTm::Fields<X>(fields: List<Pair<Nat, X>>, P: Nat → X → Type) → Type {
    match fields { Nil => True, Cons(f, rest) => P(f.fst, f.snd) ∧ FTm::Fields(rest, P) }
}

// What is true of every field is true of the one found at an offset.
theorem FTm::field_case<X>(fields: List<Pair<Nat, X>>, P: Nat → X → Type, n: Nat, Q: Option<X> → Type, none: Q(None), some: (x: X) → P(n, x) → Q(Some(x))):
    FTm::Fields(fields, P) → Q(FTm::field(fields, n)) {
    match fields {
        Nil => λ _ => none,
        Cons(f, rest) => λ all => {
            let by_case: ((b: Bool) → n.same(f.fst) = b → Q(match b { True => Some(f.snd), False => FTm::field(rest, n) })) =
                λ b => match b {
                    False => λ _ => FTm::field_case(rest, P, n, Q, none, some, all.right),
                    True => λ is => some(f.snd, j(sym(n.same_sound(f.fst, is)), λ k _ => P(k, f.snd), all.left)),
                };
            by_case(n.same(f.fst), refl)
        },
    }
}

// The variable a field access names its offset by: a call's third
// operand, after the place and the length word.
fn FTm::third(args: List<Nat>) → Nat {
    match args {
        Nil => 0,
        Cons(_, after_place) => match after_place {
            Nil => 0,
            Cons(_, after_length) => match after_length { Nil => 0, Cons(i, _) => i },
        },
    }
}

fn Tm::offset(self e: Tm) → Nat {
    match e {
        Call(_, args) => FTm::third(args),
        _ => 0,
    }
}

// What a bound term is to a held computation: a reader's call, or plain.
fn Tm::reader<A>(self e: Tm, hw: HWorld<A>) → Reader<A> {
    match e {
        Call(f, _) => Reader::at(hw.readers, f),
        _ => Plain,
    }
}

// A reader's answer at the offset `at` from what the span holds, where a
// field lies there, and a plain term's own.
fn Reader::value<A>(self r: Reader<A>, tys: Nat → RecInfo, to: Ty, a: A, at: Nat, plain: to.sem(tys)) → to.sem(tys) {
    match r {
        Plain => plain,
        Reads(width, fields) => match FTm::field(fields, at) { None => plain, Some(get) => Ty::cast(tys, Word(width), to, get(a)) },
    }
}

// A bound pure term's value: a reader at a field's offset answers from
// what the span holds, every other term from the span.
fn FTm::held_value<A>(hw: HWorld<A>, own: List<BitVec(8)>, e: Tm, g: List<Ty>, env: Env(hw.fw.w.tys, g), a: A) → e.ty(hw.fw.w, g).sem(hw.fw.w.tys) {
    e.reader(hw).value(hw.fw.w.tys, e.ty(hw.fw.w, g), a, FTm::word(hw.fw.w.tys, g, env, e.offset()).toNat(), FTm::value(hw.fw, own, e, g, env))
}

// A call's operands after the span's place and its length word, and the
// words they are.
fn FTm::operands(args: List<Nat>) → List<Nat> {
    match args {
        Nil => [],
        Cons(_, after_place) => match after_place { Nil => [], Cons(_, rest) => rest },
    }
}

fn FTm::words(tys: Nat → RecInfo, g: List<Ty>, env: Env(tys, g), vs: List<Nat>) → List<BitVec(64)> {
    match vs { Nil => [], Cons(v, rest) => Cons(FTm::word(tys, g, env, v), FTm::words(tys, g, env, rest)) }
}

// What a computation leaves the span holding: a writer at a field's
// offset, its third operand, stores its fourth into the field, and a
// held function leaves what its function of the record leaves.
fn Writer::state<A>(self w: Writer<A>, tys: Nat → RecInfo, args: List<Nat>, g: List<Ty>, env: Env(tys, g), a: A) → A {
    match w {
        Apart => a,
        Runs(_, run) => run(a, FTm::words(tys, g, env, FTm::operands(args))).after,
        Writes(width, fields) => match args {
            Nil => a,
            Cons(_, after_place) => match after_place {
                Nil => a,
                Cons(_, after_length) => match after_length {
                    Nil => a,
                    Cons(i, after_offset) => match after_offset {
                        Nil => a,
                        Cons(v, _) => match FTm::field(fields, FTm::word(tys, g, env, i).toNat()) {
                            None => a,
                            Some(set) => set(a, Ty::cast(tys, Ty::at(g, v), Word(width), Env::get(tys, g, env, v))),
                        },
                    },
                },
            },
        },
    }
}

fn FTm::held_state<A>(hw: HWorld<A>, f: Nat, args: List<Nat>, g: List<Ty>, env: Env(hw.fw.w.tys, g), a: A) → A {
    Writer::at(hw.writers, f).state(hw.fw.w.tys, args, g, env, a)
}

// What a computation answers, to a held computation: a held function's
// word is its function of the record's, so that a caller's held meaning
// names the callee's function of the record and never the span; any
// other computation's is the byte meaning's own (`plain`).
fn Writer::answer<A>(self w: Writer<A>, tys: Nat → RecInfo, args: List<Nat>, g: List<Ty>, env: Env(tys, g), a: A, to: Ty, plain: to.sem(tys)) → to.sem(tys) {
    match w {
        Apart => plain,
        Writes(_, _) => plain,
        Runs(_, run) => Ty::cast(tys, Word(64), to, run(a, FTm::words(tys, g, env, FTm::operands(args))).value),
    }
}

fn FTm::held_answer<A>(hw: HWorld<A>, f: Nat, args: List<Nat>, g: List<Ty>, env: Env(hw.fw.w.tys, g), a: A, plain: Sig::at(hw.fw.fsigs, f).result.sem(hw.fw.w.tys))
    → Sig::at(hw.fw.fsigs, f).result.sem(hw.fw.w.tys) {
    Writer::at(hw.writers, f).answer(hw.fw.w.tys, args, g, env, a, Sig::at(hw.fw.fsigs, f).result, plain)
}

// A held computation's answer read at another code.
fn FTm::held_recast<A>(tys: Nat → RecInfo, x, y: Ty, h: Mutated<A, x.sem(tys)>) → Mutated<A, y.sem(tys)> { Mutated(h.after, Ty::cast(tys, x, y, h.value)) }

// The held meaning: what the span holds, threaded through the term. The
// span's bytes are an operand and not an answer: a pure term is read at
// them and a call goes on from the bytes its callee leaves, which are the
// byte meaning's own, so the answer is the record and the value alone and
// a function of the record is this by `refl`.
fn FTm::held<A>(self t: FTm, hw: HWorld<A>) → (g: List<Ty>) → Env(hw.fw.w.tys, g) → List<BitVec(8)> → A
    → Mutated<A, t.ty(hw.fw.w, hw.fw.fsigs, g).sem(hw.fw.w.tys)> {
    match t {
        Pure(v) => λ g env own a => Mutated(a, FTm::value(hw.fw, own, v, g, env)),
        Let(e, body) => λ g env own a => body.held(hw, Cons(e.ty(hw.fw.w, g), g), Pair(FTm::held_value(hw, own, e, g, env, a), env), own, a),
        If(c, yes, no) => λ g env own a =>
            match Ty::cast(hw.fw.w.tys, Ty::at(g, c), Bit, Env::get(hw.fw.w.tys, g, env, c)) {
                False => FTm::held_recast(hw.fw.w.tys, no.ty(hw.fw.w, hw.fw.fsigs, g), yes.ty(hw.fw.w, hw.fw.fsigs, g), no.held(hw, g, env, own, a)),
                True => yes.held(hw, g, env, own, a),
            },
        IfEq(c, yes, no) => λ g env own a =>
            Tm::convoy(Mutated<A, yes.ty(hw.fw.w, hw.fw.fsigs, g).sem(hw.fw.w.tys)>,
                Ty::cast(hw.fw.w.tys, Ty::at(g, c), Bit, Env::get(hw.fw.w.tys, g, env, c)), yes.held(hw, g, env, own, a),
                FTm::held_recast(hw.fw.w.tys, no.ty(hw.fw.w, hw.fw.fsigs, g), yes.ty(hw.fw.w, hw.fw.fsigs, g), no.held(hw, g, env, own, a))),
        Put(i, length, v, body) => λ g env own a => body.held(hw, g, env, FTm::put(hw.fw.w.tys, g, env, i, length, v, own), a),
        Call(f, args, body) => λ g env own a =>
            shared(FTm::called(hw.fw, g, env, f, args, own), λ m =>
                body.held(hw, Cons(Sig::at(hw.fw.fsigs, f).result, g), Pair(FTm::held_answer(hw, f, args, g, env, a, m.value), env), m.after,
                    FTm::held_state(hw, f, args, g, env, a))),
        Again(args) => λ g env own a => Mutated(a, FTm::called(hw.fw, g, env, 0, args, own).value),
        Lend(f, views, args, body) => λ g env own a =>
            shared(FTm::lent(hw.fw, g, env, f, views, args, own), λ m =>
                body.held(hw, Cons(Sig::at(hw.fw.fsigs, f).result, g), Pair(m.value, env), m.after, a)),
    }
}

// ---------------------------------------------------------------------------
// The two meanings agree

// The span, lent under the length word `n`, holds `a`: the record is
// inside the length word, the length word is inside the span, and `a` is
// what is read at the span's start. A compiled read or store is under
// the length word, so it is the codec's only where the record is inside
// it; and the length word a caller hands over is the span's own.
fn Stored::Holds<A>(self whole: Stored<A>, own: List<BitVec(8)>, n: BitVec(64), a: A) → Type {
    (whole.layout.size <= n.toNat()) ∧ ((n.toNat() <= own.len()) ∧ (whole.get(own, 0) = a))
}

// A reader's operands: a place, the variable `len`, and an offset.
fn FTm::read_args(args: List<Nat>, len: Nat) → Bool {
    match args {
        Nil => False,
        Cons(_, after_place) => match after_place {
            Nil => False,
            Cons(l, after_length) => match after_length {
                Nil => False,
                Cons(_, more) => match more { Nil => l.same(len), Cons(_, _) => False },
            },
        },
    }
}

// A writer's: a place, the variable `len`, an offset and a word.
fn FTm::write_args(args: List<Nat>, len: Nat) → Bool {
    match args {
        Nil => False,
        Cons(_, after_place) => match after_place {
            Nil => False,
            Cons(l, after_length) => match after_length {
                Nil => False,
                Cons(_, after_offset) => match after_offset {
                    Nil => False,
                    Cons(_, more) => match more { Nil => l.same(len), Cons(_, _) => False },
                },
            },
        },
    }
}

// A held function's: a place, the variable `len`, and `words` operands.
fn FTm::run_args(args: List<Nat>, len: Nat, words: Nat) → Bool {
    match args {
        Nil => False,
        Cons(_, after_place) => match after_place {
            Nil => False,
            Cons(l, rest) => l.same(len) && rest.len().same(words),
        },
    }
}

// A statement about a list of `k` variables, as a function of them: what
// a promise about a call of `k` operands is stated as, so that the call's
// operands are a list written out and its callee is applied to each.
fn FTm::Shaped(k: Nat, P: List<Nat> → Type) → Type {
    match k {
        Zero => P(Nil),
        Succ(j) => (x: Nat) → FTm::Shaped(j, λ (rest: List<Nat>) => P(Cons(x, rest))),
    }
}

theorem FTm::shaped(k: Nat): (P: List<Nat> → Type) → FTm::Shaped(k, P) → (rest: List<Nat>) → rest.len().same(k).IsTrue() → P(rest) {
    match k {
        Zero => λ P all rest => match rest {
            Nil => λ _ => all,
            Cons(_, _) => λ never => false_elim(never),
        },
        Succ(j, ih) => λ P all rest => match rest {
            Nil => λ never => false_elim(never),
            Cons(x, more) => λ long => ih(λ (r: List<Nat>) => P(Cons(x, r)), all(x), more, long),
        },
    }
}

theorem FTm::run_args_elim(args: List<Nat>, len: Nat, words: Nat, P: List<Nat> → Type,
    at: (place: Nat) → (rest: List<Nat>) → rest.len().same(words).IsTrue() → P(Cons(place, Cons(len, rest)))): FTm::run_args(args, len, words).IsTrue() → P(args) {
    match args {
        Nil => λ never => false_elim(never),
        Cons(place, after_place) => match after_place {
            Nil => λ never => false_elim(never),
            Cons(l, rest) => λ is => {
                let two = l.same(len).is_true_and(rest.len().same(words), is);
                j(sym(l.same_sound(len, eq_true_of_is_true(l.same(len), two.left))), λ x _ => P(Cons(place, Cons(x, rest))), at(place, rest, two.right))
            },
        },
    }
}

theorem FTm::read_args_elim(args: List<Nat>, len: Nat, P: List<Nat> → Type, at: (place, i: Nat) → P([place, len, i])): FTm::read_args(args, len).IsTrue() → P(args) {
    match args {
        Nil => λ never => false_elim(never),
        Cons(place, after_place) => match after_place {
            Nil => λ never => false_elim(never),
            Cons(l, after_length) => match after_length {
                Nil => λ never => false_elim(never),
                Cons(i, more) => match more {
                    Nil => λ is => j(sym(l.same_sound(len, eq_true_of_is_true(l.same(len), is))), λ x _ => P([place, x, i]), at(place, i)),
                    Cons(_, _) => λ never => false_elim(never),
                },
            },
        },
    }
}

theorem FTm::write_args_elim(args: List<Nat>, len: Nat, P: List<Nat> → Type, at: (place, i, v: Nat) → P([place, len, i, v])): FTm::write_args(args, len).IsTrue() → P(args) {
    match args {
        Nil => λ never => false_elim(never),
        Cons(place, after_place) => match after_place {
            Nil => λ never => false_elim(never),
            Cons(l, after_length) => match after_length {
                Nil => λ never => false_elim(never),
                Cons(i, after_offset) => match after_offset {
                    Nil => λ never => false_elim(never),
                    Cons(v, more) => match more {
                        Nil => λ is => j(sym(l.same_sound(len, eq_true_of_is_true(l.same(len), is))), λ x _ => P([place, x, i, v]), at(place, i, v)),
                        Cons(_, _) => λ never => false_elim(never),
                    },
                },
            },
        },
    }
}

// ---------------------------------------------------------------------------
// What the verdict knows of a variable

// The literal that bound a variable, where one did: its code and its
// number, the most recent variable first.
fn FTm::known_at(known: List<Option<Pair<Ty, Nat>>>, v: Nat) → Option<Pair<Ty, Nat>> {
    match known { Nil => None, Cons(k, rest) => match v { Zero => k, Succ(u) => FTm::known_at(rest, u) } }
}

fn Tm::literal(self e: Tm) → Option<Pair<Ty, Nat>> {
    match e {
        Lit(t, n) => Some(Pair(t, n)),
        _ => None,
    }
}

// A literal as the word a variable bound by it is.
fn FTm::literal_word(tys: Nat → RecInfo, p: Pair<Ty, Nat>) → BitVec(64) { Ty::cast(tys, p.fst, Word(64), Tm::lit(p.fst, p.snd, tys)) }

// The environment is what the verdict knows: a variable known to be
// bound by a literal is that literal's word.
fn FTm::Knows(tys: Nat → RecInfo, g: List<Ty>, env: Env(tys, g), known: List<Option<Pair<Ty, Nat>>>) → Type {
    (v: Nat) → (p: Pair<Ty, Nat>) → FTm::known_at(known, v) = Some(p) → FTm::word(tys, g, env, v) = FTm::literal_word(tys, p)
}

theorem FTm::knows_nothing(tys: Nat → RecInfo, g: List<Ty>, env: Env(tys, g)): FTm::Knows(tys, g, env, Nil) {
    λ v p is => Option::none_ne_some(p, is, FTm::word(tys, g, env, v) = FTm::literal_word(tys, p))
}

// Under one more variable nothing is known of.
theorem FTm::knows_more(tys: Nat → RecInfo, g: List<Ty>, env: Env(tys, g), known: List<Option<Pair<Ty, Nat>>>, knows: FTm::Knows(tys, g, env, known), t: Ty,
    x: t.sem(tys)): FTm::Knows(tys, Cons(t, g), Pair(x, env), Cons(None, known)) {
    λ v p => match v {
        Zero => λ is => Option::none_ne_some(p, is, FTm::word(tys, Cons(t, g), Pair(x, env), Zero) = FTm::literal_word(tys, p)),
        Succ(u) => λ is => knows(u, p, is),
    }
}

// Whether the variable `i` is known to be a field's offset.
fn FTm::known_field<X>(tys: Nat → RecInfo, fields: List<Pair<Nat, X>>, known: List<Option<Pair<Ty, Nat>>>, i: Nat) → Bool {
    match FTm::known_at(known, i) { None => False, Some(p) => FTm::is_field(fields, FTm::literal_word(tys, p).toNat()) }
}

// Then the word it is in the environment is one.
theorem FTm::known_found<X>(tys: Nat → RecInfo, g: List<Ty>, env: Env(tys, g), known: List<Option<Pair<Ty, Nat>>>, knows: FTm::Knows(tys, g, env, known),
    fields: List<Pair<Nat, X>>, i: Nat): FTm::known_field(tys, fields, known, i).IsTrue() → FTm::is_field(fields, FTm::word(tys, g, env, i).toNat()).IsTrue() {
    let by_case: ((o: Option<Pair<Ty, Nat>>) → FTm::known_at(known, i) = o →
        (match o { None => False, Some(p) => FTm::is_field(fields, FTm::literal_word(tys, p).toNat()) }).IsTrue() →
        FTm::is_field(fields, FTm::word(tys, g, env, i).toNat()).IsTrue()) =
        λ o => match o {
            None => λ _ never => false_elim(never),
            Some(p) => λ is found => j(sym(knows(i, p, is)), λ w _ => FTm::is_field(fields, w.toNat()).IsTrue(), found),
        };
    by_case(FTm::known_at(known, i), refl)
}

// A pure function of a signature applied to variables under a type
// table: `Tm::apply`, which takes a world for its table.
fn FTm::apply_pure(tys: Nat → RecInfo, g: List<Ty>, env: Env(tys, g), r: Ty, ps: List<Ty>) → Ty::Arrows(tys, ps, r) → List<Nat> → r.sem(tys) {
    match ps {
        Nil => λ f vs => f,
        Cons(p, rest) => λ f vs => match vs {
            Nil => r.default(tys),
            Cons(v, more) => FTm::apply_pure(tys, g, env, r, rest, f(Ty::cast(tys, Ty::at(g, v), p, Env::get(tys, g, env, v))), more),
        },
    }
}

theorem Tm::apply_pure(w: World, g: List<Ty>, env: Env(w.tys, g), r: Ty, ps: List<Ty>): (F: Ty::Arrows(w.tys, ps, r)) → (vs: List<Nat>) →
    Tm::apply(w, g, env, r, ps, F, vs) = FTm::apply_pure(w.tys, g, env, r, ps, F, vs) {
    match ps {
        Nil => λ F vs => refl,
        Cons(p, rest) => λ F vs => match vs {
            Nil => refl,
            Cons(v, more) => Tm::apply_pure(w, g, env, r, rest, F(Ty::cast(w.tys, Ty::at(g, v), p, Env::get(w.tys, g, env, v))), more),
        },
    }
}

// A pure function's call over the span, its operands read under the
// program's own type table. This is what a reader's promise is stated
// of, and not `FTm::value` of the call, which is the same value
// (`FTm::value_read`): at a program's own tables the value's operands are
// cast under the type table of the world at the file, a promise names the
// length word under the program's, and where the two spellings meet the
// kernel tells the world at the file from the world at no file by
// evaluating the callee at both (issues/runtime-link-compares-functions.md).
fn FTm::read(fw: FWorld, own: List<BitVec(8)>, f: Nat, args: List<Nat>, g: List<Ty>, env: Env(fw.w.tys, g)) → Sig::at(fw.w.sigs, f).result.sem(fw.w.tys) {
    FTm::apply_pure(fw.w.tys, g, env, Sig::at(fw.w.sigs, f).result, Sig::at(fw.w.sigs, f).params, Sig::get(fw.w.tys, fw.w.sigs, fw.callees(Cons(own, fw.rest)), f), args)
}

theorem FTm::value_read(fw: FWorld, own: List<BitVec(8)>, f: Nat, args: List<Nat>, g: List<Ty>, env: Env(fw.w.tys, g)):
    FTm::value(fw, own, Call(f, args), g, env) = FTm::read(fw, own, f, args, g, env) {
    trans(Ty::cast_self(fw.w.tys, Sig::at(fw.w.sigs, f).result, Tm::sem(Call(f, args), fw.at(own), g, env)),
        Tm::apply_pure(fw.at(own), g, env, Sig::at(fw.w.sigs, f).result, Sig::at(fw.w.sigs, f).params, Sig::get(fw.w.tys, fw.w.sigs, fw.callees(Cons(own, fw.rest)), f), args))
}

// What a reader owes at a field: called on a place, the span's length
// word and the offset the field lies at, it answers the field of what
// the span holds.
fn HWorld::Reads<A>(self hw: HWorld<A>, whole: Stored<A>, f: Nat, width: Nat, at: Nat, get: A → BitVec(width)) → Type {
    (place, length, i: Nat) → (own: List<BitVec(8)>) → (a: A) → (g: List<Ty>) → (env: Env(hw.fw.w.tys, g)) →
        whole.Holds(own, FTm::word(hw.fw.w.tys, g, env, length), a) → FTm::word(hw.fw.w.tys, g, env, i).toNat() = at →
        FTm::read(hw.fw, own, f, [place, length, i], g, env) = Ty::cast(hw.fw.w.tys, Word(width), Sig::at(hw.fw.w.sigs, f).result, get(a))
}

// What a writer owes at a field: called on a place, the span's length
// word, the offset the field lies at and a word, it leaves the span
// holding the record with the field set.
fn HWorld::Writes<A>(self hw: HWorld<A>, whole: Stored<A>, f: Nat, width: Nat, at: Nat, set: A → BitVec(width) → A) → Type {
    (place, length, i, v: Nat) → (own: List<BitVec(8)>) → (a: A) → (g: List<Ty>) → (env: Env(hw.fw.w.tys, g)) →
        whole.Holds(own, FTm::word(hw.fw.w.tys, g, env, length), a) → FTm::word(hw.fw.w.tys, g, env, i).toNat() = at →
        whole.Holds(FTm::called(hw.fw, g, env, f, [place, length, i, v], own).after, FTm::word(hw.fw.w.tys, g, env, length),
            set(a, Ty::cast(hw.fw.w.tys, Ty::at(g, v), Word(width), Env::get(hw.fw.w.tys, g, env, v))))
}

// The held meaning beside the byte meaning: the same value, and the
// bytes the second leaves hold the record the first leaves, under the
// same length word.
record Agrees<A, R>(whole: Stored<A>, n: BitVec(64), h: Mutated<A, R>, m: Mutated<List<BitVec(8)>, R>) {
    value: h.value = m.value,
    holds: whole.Holds(m.after, n, h.after),
}

// What a held function owes: called on a place, the span's length word
// and its operands, where the span holds a record it answers what its
// function of the record answers and leaves the span holding the record
// that leaves. Stated at the operands written out (`FTm::Shaped`).
fn HWorld::Runs<A>(self hw: HWorld<A>, whole: Stored<A>, f: Nat, words: Nat, run: A → List<BitVec(64)> → Mutated<A, BitVec(64)>) → Type {
    (place, length: Nat) → FTm::Shaped(words, λ (rest: List<Nat>) => (own: List<BitVec(8)>) → (a: A) → (g: List<Ty>) → (env: Env(hw.fw.w.tys, g)) →
        whole.Holds(own, FTm::word(hw.fw.w.tys, g, env, length), a) →
        Agrees<A, Sig::at(hw.fw.fsigs, f).result.sem(hw.fw.w.tys)>(whole, FTm::word(hw.fw.w.tys, g, env, length),
            Mutated(run(a, FTm::words(hw.fw.w.tys, g, env, rest)).after,
                Ty::cast(hw.fw.w.tys, Word(64), Sig::at(hw.fw.fsigs, f).result, run(a, FTm::words(hw.fw.w.tys, g, env, rest)).value)),
            FTm::called(hw.fw, g, env, f, Cons(place, Cons(length, rest)), own)))
}

// Each mark's obligation, in the tables' order: a tuple, one proof per
// field of each function, which is what a generator writes.
fn Reader::Owes<A>(self r: Reader<A>, P: (width: Nat) → Nat → (A → BitVec(width)) → Type) → Type {
    match r { Plain => True, Reads(width, fields) => FTm::Fields(fields, P(width)) }
}

fn Reader::All<A>(rs: List<Reader<A>>, P: Nat → (width: Nat) → Nat → (A → BitVec(width)) → Type) → Type {
    match rs {
        Nil => True,
        Cons(r, rest) => r.Owes(P(Zero)) ∧ Reader::All(rest, λ (k: Nat) => P(Succ(k))),
    }
}

fn Writer::Owes<A>(self w: Writer<A>, P: (width: Nat) → Nat → (A → BitVec(width) → A) → Type,
    Q: (words: Nat) → (A → List<BitVec(64)> → Mutated<A, BitVec(64)>) → Type) → Type {
    match w { Apart => True, Writes(width, fields) => FTm::Fields(fields, P(width)), Runs(words, run) => Q(words, run) }
}

fn Writer::All<A>(ws: List<Writer<A>>, P: Nat → (width: Nat) → Nat → (A → BitVec(width) → A) → Type,
    Q: Nat → (words: Nat) → (A → List<BitVec(64)> → Mutated<A, BitVec(64)>) → Type) → Type {
    match ws {
        Nil => True,
        Cons(w, rest) => w.Owes(P(Zero), Q(Zero)) ∧ Writer::All(rest, λ (k: Nat) => P(Succ(k)), λ (k: Nat) => Q(Succ(k))),
    }
}

theorem Reader::all_at<A>(rs: List<Reader<A>>): (P: Nat → (width: Nat) → Nat → (A → BitVec(width)) → Type) → Reader::All(rs, P) → (f: Nat) →
    Reader::at(rs, f).Owes(P(f)) {
    match rs {
        Nil => λ P all f => trivial,
        Cons(r, rest) => λ P all f => match f {
            Zero => all.left,
            Succ(k) => Reader::all_at(rest, λ (j: Nat) => P(Succ(j)), all.right, k),
        },
    }
}

theorem Writer::all_at<A>(ws: List<Writer<A>>): (P: Nat → (width: Nat) → Nat → (A → BitVec(width) → A) → Type) →
    (Q: Nat → (words: Nat) → (A → List<BitVec(64)> → Mutated<A, BitVec(64)>) → Type) → Writer::All(ws, P, Q) → (f: Nat) →
    Writer::at(ws, f).Owes(P(f), Q(f)) {
    match ws {
        Nil => λ P Q all f => trivial,
        Cons(w, rest) => λ P Q all f => match f {
            Zero => all.left,
            Succ(k) => Writer::all_at(rest, λ (j: Nat) => P(Succ(j)), λ (j: Nat) => Q(Succ(j)), all.right, k),
        },
    }
}

// What a held world owes, whole.
record Sound<A>(hw: HWorld<A>, whole: Stored<A>) {
    readers: Reader::All(hw.readers, λ (f: Nat) (width: Nat) (at: Nat) (get: A → BitVec(width)) => hw.Reads(whole, f, width, at, get)),
    writers: Writer::All(hw.writers, λ (f: Nat) (width: Nat) (at: Nat) (set: A → BitVec(width) → A) => hw.Writes(whole, f, width, at, set),
        λ (f: Nat) (words: Nat) (run: A → List<BitVec(64)> → Mutated<A, BitVec(64)>) => hw.Runs(whole, f, words, run)),
}

// A bound term a held function may have: a reader is called on the
// span's own length word, the variable `len`.
fn Reader::lent<A>(self r: Reader<A>, args: List<Nat>, len: Nat) → Bool {
    match r { Plain => True, Reads(_, _) => FTm::read_args(args, len) }
}

fn Tm::kept<A>(self e: Tm, hw: HWorld<A>, len: Nat) → Bool {
    match e {
        Call(f, args) => Reader::at(hw.readers, f).lent(args, len),
        _ => True,
    }
}

// A call a held function may make: a writer's, on that length word, at
// an offset known to be a field's.
fn Writer::lent<A>(self w: Writer<A>, tys: Nat → RecInfo, args: List<Nat>, len: Nat, known: List<Option<Pair<Ty, Nat>>>) → Bool {
    match w {
        Apart => False,
        Writes(_, fields) => FTm::write_args(args, len) && FTm::known_field(tys, fields, known, FTm::third(args)),
        Runs(words, _) => FTm::run_args(args, len, words),
    }
}

// The computations a held function is made of, where `len` is the
// variable that is the span's length word and `known` what the literals
// say of the variables: no byte stored but by a writer at a field's
// offset, every call a writer's on that length word, no loop, nothing
// lent. A verdict, so that it is `trivial` at a closed term.
fn FTm::kept<A>(self t: FTm, hw: HWorld<A>) → Nat → List<Option<Pair<Ty, Nat>>> → Bool {
    match t {
        Pure(_) => λ len known => True,
        Let(e, body) => λ len known => e.kept(hw, len) && body.kept(hw, Succ(len), Cons(e.literal(), known)),
        If(_, yes, no) => λ len known => yes.kept(hw, len, known) && no.kept(hw, len, known),
        IfEq(_, yes, no) => λ len known => yes.kept(hw, len, known) && no.kept(hw, len, known),
        Put(_, _, _, _) => λ len known => False,
        Call(f, args, body) => λ len known => Writer::at(hw.writers, f).lent(hw.fw.w.tys, args, len, known) && body.kept(hw, Succ(len), Cons(None, known)),
        Again(_) => λ len known => False,
        Lend(_, _, _, _) => λ len known => False,
    }
}

theorem Agrees::recast<A>(whole: Stored<A>, n: BitVec(64), tys: Nat → RecInfo, x, y: Ty, h: Mutated<A, x.sem(tys)>, m: Mutated<List<BitVec(8)>, x.sem(tys)>,
    agrees: Agrees<A, x.sem(tys)>(whole, n, h, m)): Agrees<A, y.sem(tys)>(whole, n, FTm::held_recast(tys, x, y, h), FTm::recast(tys, x, y, m)) {
    Agrees(cong_fn(λ (v: x.sem(tys)) => Ty::cast(tys, x, y, v), agrees.value), agrees.holds)
}

// A reader's call on the span's length word answers the field.
theorem Tm::reader_ok<A>(self e: Tm, hw: HWorld<A>, whole: Stored<A>, sound: Sound<A>(hw, whole), len: Nat, kept: e.kept(hw, len).IsTrue(),
    own: List<BitVec(8)>, a: A, g: List<Ty>, env: Env(hw.fw.w.tys, g), holds: whole.Holds(own, FTm::word(hw.fw.w.tys, g, env, len), a)):
    FTm::held_value(hw, own, e, g, env, a) = FTm::value(hw.fw, own, e, g, env) {
    match e {
        Var(i) => refl,
        Lit(c, n) => refl,
        Prim(op, xs) => refl,
        Let(x, body) => refl,
        If(c, yes, no) => refl,
        IfEq(c, yes, no) => refl,
        Make(i, xs) => refl,
        Field(i, k, of) => refl,
        Call(f, args) => {
            let by_case: ((r: Reader<A>) → r.Owes(λ (width: Nat) (at: Nat) (get: A → BitVec(width)) => hw.Reads(whole, f, width, at, get)) → r.lent(args, len).IsTrue() →
                r.value(hw.fw.w.tys, Sig::at(hw.fw.w.sigs, f).result, a, FTm::word(hw.fw.w.tys, g, env, FTm::third(args)).toNat(),
                    FTm::value(hw.fw, own, Call(f, args), g, env)) = FTm::value(hw.fw, own, Call(f, args), g, env)) =
                λ r => match r {
                    Plain => λ _ _ => refl,
                    Reads(width, fields) => λ reads lent =>
                        FTm::read_args_elim(args, len,
                            λ (xs: List<Nat>) => (Reads(width, fields).value(hw.fw.w.tys, Sig::at(hw.fw.w.sigs, f).result, a,
                                FTm::word(hw.fw.w.tys, g, env, FTm::third(xs)).toNat(), FTm::value(hw.fw, own, Call(f, xs), g, env)) = FTm::value(hw.fw, own, Call(f, xs), g, env)),
                            λ place i => FTm::field_case(fields, λ (at: Nat) (get: A → BitVec(width)) => hw.Reads(whole, f, width, at, get),
                                FTm::word(hw.fw.w.tys, g, env, i).toNat(),
                                λ (o: Option<A → BitVec(width)>) => ((match o {
                                    None => FTm::value(hw.fw, own, Call(f, [place, len, i]), g, env),
                                    Some(get) => Ty::cast(hw.fw.w.tys, Word(width), Sig::at(hw.fw.w.sigs, f).result, get(a)),
                                }) = FTm::value(hw.fw, own, Call(f, [place, len, i]), g, env)),
                                refl,
                                λ get promise => sym(trans(FTm::value_read(hw.fw, own, f, [place, len, i], g, env), promise(place, len, i, own, a, g, env, holds, refl))),
                                reads),
                            lent),
                };
            by_case(Reader::at(hw.readers, f),
                Reader::all_at(hw.readers, λ (f: Nat) (width: Nat) (at: Nat) (get: A → BitVec(width)) => hw.Reads(whole, f, width, at, get), sound.readers, f), kept)
        },
        Fold(over, init, step) => refl,
        Case(c, zero, succ) => refl,
        Byte(k, i, length) => refl,
    }
}

// Under a variable bound by a term, what is known is the term's literal.
theorem Tm::literal_known(self e: Tm, fw: FWorld, own: List<BitVec(8)>, g: List<Ty>, env: Env(fw.w.tys, g), known: List<Option<Pair<Ty, Nat>>>,
    knows: FTm::Knows(fw.w.tys, g, env, known)):
    FTm::Knows(fw.w.tys, Cons(e.ty(fw.w, g), g), Pair(FTm::value(fw, own, e, g, env), env), Cons(e.literal(), known)) {
    match e {
        Var(i) => FTm::knows_more(fw.w.tys, g, env, known, knows, Var(i).ty(fw.w, g), FTm::value(fw, own, Var(i), g, env)),
        Lit(t, n) => λ v p => match v {
            Zero => λ is => j(Option::some_inj(Pair(t, n), p, is),
                λ q _ => FTm::word(fw.w.tys, Cons(t, g), Pair(FTm::value(fw, own, Lit(t, n), g, env), env), Zero) = FTm::literal_word(fw.w.tys, q),
                cong_fn(λ (x: t.sem(fw.w.tys)) => Ty::cast(fw.w.tys, t, Word(64), x), Ty::cast_self(fw.w.tys, t, Tm::lit(t, n, fw.w.tys)))),
            Succ(u) => λ is => knows(u, p, is),
        },
        Prim(op, xs) => FTm::knows_more(fw.w.tys, g, env, known, knows, Prim(op, xs).ty(fw.w, g), FTm::value(fw, own, Prim(op, xs), g, env)),
        Let(x, body) => FTm::knows_more(fw.w.tys, g, env, known, knows, Let(x, body).ty(fw.w, g), FTm::value(fw, own, Let(x, body), g, env)),
        If(c, yes, no) => FTm::knows_more(fw.w.tys, g, env, known, knows, If(c, yes, no).ty(fw.w, g), FTm::value(fw, own, If(c, yes, no), g, env)),
        IfEq(c, yes, no) => FTm::knows_more(fw.w.tys, g, env, known, knows, IfEq(c, yes, no).ty(fw.w, g), FTm::value(fw, own, IfEq(c, yes, no), g, env)),
        Make(i, xs) => FTm::knows_more(fw.w.tys, g, env, known, knows, Make(i, xs).ty(fw.w, g), FTm::value(fw, own, Make(i, xs), g, env)),
        Field(i, k, of) => FTm::knows_more(fw.w.tys, g, env, known, knows, Field(i, k, of).ty(fw.w, g), FTm::value(fw, own, Field(i, k, of), g, env)),
        Call(f, args) => FTm::knows_more(fw.w.tys, g, env, known, knows, Call(f, args).ty(fw.w, g), FTm::value(fw, own, Call(f, args), g, env)),
        Fold(over, init, step) => FTm::knows_more(fw.w.tys, g, env, known, knows, Fold(over, init, step).ty(fw.w, g), FTm::value(fw, own, Fold(over, init, step), g, env)),
        Case(c, zero, succ) => FTm::knows_more(fw.w.tys, g, env, known, knows, Case(c, zero, succ).ty(fw.w, g), FTm::value(fw, own, Case(c, zero, succ), g, env)),
        Byte(k, i, length) => FTm::knows_more(fw.w.tys, g, env, known, knows, Byte(k, i, length).ty(fw.w, g), FTm::value(fw, own, Byte(k, i, length), g, env)),
    }
}

theorem FTm::held_runs<A>(self t: FTm, hw: HWorld<A>, whole: Stored<A>, sound: Sound<A>(hw, whole)): (len: Nat) → (known: List<Option<Pair<Ty, Nat>>>) →
    t.kept(hw, len, known).IsTrue() → (g: List<Ty>) → (env: Env(hw.fw.w.tys, g)) → FTm::Knows(hw.fw.w.tys, g, env, known) →
    (own: List<BitVec(8)>) → (a: A) → whole.Holds(own, FTm::word(hw.fw.w.tys, g, env, len), a) →
    Agrees<A, t.ty(hw.fw.w, hw.fw.fsigs, g).sem(hw.fw.w.tys)>(whole, FTm::word(hw.fw.w.tys, g, env, len), t.held(hw, g, env, own, a), t.sem(hw.fw, g, env, own)) {
    match t {
        Pure(v) => λ len known _ g env knows own a holds => Agrees(refl, holds),
        Let(e, body) => λ len known kept g env knows own a holds => {
            let both = e.kept(hw, len).is_true_and(body.kept(hw, Succ(len), Cons(e.literal(), known)), kept);
            let same = e.reader_ok(hw, whole, sound, len, both.left, own, a, g, env, holds);
            let ran = body.held_runs(hw, whole, sound, Succ(len), Cons(e.literal(), known), both.right, Cons(e.ty(hw.fw.w, g), g),
                Pair(FTm::value(hw.fw, own, e, g, env), env), e.literal_known(hw.fw, own, g, env, known, knows), own, a, holds);
            let goal: Agrees<A, body.ty(hw.fw.w, hw.fw.fsigs, Cons(e.ty(hw.fw.w, g), g)).sem(hw.fw.w.tys)>(whole, FTm::word(hw.fw.w.tys, g, env, len),
                body.held(hw, Cons(e.ty(hw.fw.w, g), g), Pair(FTm::held_value(hw, own, e, g, env, a), env), own, a),
                body.sem(hw.fw, Cons(e.ty(hw.fw.w, g), g), Pair(FTm::value(hw.fw, own, e, g, env), env), own)) = rewrite(same, ran);
            goal
        },
        If(c, yes, no) => λ len known kept g env knows own a holds => {
            let both = yes.kept(hw, len, known).is_true_and(no.kept(hw, len, known), kept);
            let by_case: ((b: Bool) → Agrees<A, yes.ty(hw.fw.w, hw.fw.fsigs, g).sem(hw.fw.w.tys)>(whole, FTm::word(hw.fw.w.tys, g, env, len),
                match b {
                    False => FTm::held_recast(hw.fw.w.tys, no.ty(hw.fw.w, hw.fw.fsigs, g), yes.ty(hw.fw.w, hw.fw.fsigs, g), no.held(hw, g, env, own, a)),
                    True => yes.held(hw, g, env, own, a),
                },
                match b {
                    False => FTm::recast(hw.fw.w.tys, no.ty(hw.fw.w, hw.fw.fsigs, g), yes.ty(hw.fw.w, hw.fw.fsigs, g), no.sem(hw.fw, g, env, own)),
                    True => yes.sem(hw.fw, g, env, own),
                })) =
                λ b => match b {
                    False => Agrees::recast(whole, FTm::word(hw.fw.w.tys, g, env, len), hw.fw.w.tys, no.ty(hw.fw.w, hw.fw.fsigs, g), yes.ty(hw.fw.w, hw.fw.fsigs, g),
                        no.held(hw, g, env, own, a), no.sem(hw.fw, g, env, own), no.held_runs(hw, whole, sound, len, known, both.right, g, env, knows, own, a, holds)),
                    True => yes.held_runs(hw, whole, sound, len, known, both.left, g, env, knows, own, a, holds),
                };
            by_case(Ty::cast(hw.fw.w.tys, Ty::at(g, c), Bit, Env::get(hw.fw.w.tys, g, env, c)))
        },
        IfEq(c, yes, no) => λ len known kept g env knows own a holds => {
            let both = yes.kept(hw, len, known).is_true_and(no.kept(hw, len, known), kept);
            let by_case: ((b: Bool) → Agrees<A, yes.ty(hw.fw.w, hw.fw.fsigs, g).sem(hw.fw.w.tys)>(whole, FTm::word(hw.fw.w.tys, g, env, len),
                Tm::convoy(Mutated<A, yes.ty(hw.fw.w, hw.fw.fsigs, g).sem(hw.fw.w.tys)>, b, yes.held(hw, g, env, own, a),
                    FTm::held_recast(hw.fw.w.tys, no.ty(hw.fw.w, hw.fw.fsigs, g), yes.ty(hw.fw.w, hw.fw.fsigs, g), no.held(hw, g, env, own, a))),
                Tm::convoy(Mutated<List<BitVec(8)>, yes.ty(hw.fw.w, hw.fw.fsigs, g).sem(hw.fw.w.tys)>, b, yes.sem(hw.fw, g, env, own),
                    FTm::recast(hw.fw.w.tys, no.ty(hw.fw.w, hw.fw.fsigs, g), yes.ty(hw.fw.w, hw.fw.fsigs, g), no.sem(hw.fw, g, env, own))))) =
                λ b => match b {
                    False => Agrees::recast(whole, FTm::word(hw.fw.w.tys, g, env, len), hw.fw.w.tys, no.ty(hw.fw.w, hw.fw.fsigs, g), yes.ty(hw.fw.w, hw.fw.fsigs, g),
                        no.held(hw, g, env, own, a), no.sem(hw.fw, g, env, own), no.held_runs(hw, whole, sound, len, known, both.right, g, env, knows, own, a, holds)),
                    True => yes.held_runs(hw, whole, sound, len, known, both.left, g, env, knows, own, a, holds),
                };
            by_case(Ty::cast(hw.fw.w.tys, Ty::at(g, c), Bit, Env::get(hw.fw.w.tys, g, env, c)))
        },
        Put(_, _, _, _) => λ len known kept => false_elim(kept),
        Call(f, args, body) => λ len known kept g env knows own a holds => {
            let both = Writer::at(hw.writers, f).lent(hw.fw.w.tys, args, len, known).is_true_and(body.kept(hw, Succ(len), Cons(None, known)), kept);
            let by_case: ((w: Writer<A>) → w.Owes(λ (width: Nat) (at: Nat) (set: A → BitVec(width) → A) => hw.Writes(whole, f, width, at, set),
                    λ (words: Nat) (run: A → List<BitVec(64)> → Mutated<A, BitVec(64)>) => hw.Runs(whole, f, words, run)) →
                w.lent(hw.fw.w.tys, args, len, known).IsTrue() →
                (w.answer(hw.fw.w.tys, args, g, env, a, Sig::at(hw.fw.fsigs, f).result, FTm::called(hw.fw, g, env, f, args, own).value)
                    = FTm::called(hw.fw, g, env, f, args, own).value)
                ∧ whole.Holds(FTm::called(hw.fw, g, env, f, args, own).after, FTm::word(hw.fw.w.tys, g, env, len), w.state(hw.fw.w.tys, args, g, env, a))) =
                λ w => match w {
                    Apart => λ _ never => false_elim(never),
                    Writes(width, fields) => λ writes lent => {
                        let two = FTm::write_args(args, len).is_true_and(FTm::known_field(hw.fw.w.tys, fields, known, FTm::third(args)), lent);
                        And(refl, FTm::write_args_elim(args, len,
                            λ (xs: List<Nat>) => FTm::known_field(hw.fw.w.tys, fields, known, FTm::third(xs)).IsTrue() →
                                whole.Holds(FTm::called(hw.fw, g, env, f, xs, own).after, FTm::word(hw.fw.w.tys, g, env, len),
                                    Writes(width, fields).state(hw.fw.w.tys, xs, g, env, a)),
                            λ place i v => λ found =>
                                FTm::field_case(fields, λ (at: Nat) (set: A → BitVec(width) → A) => hw.Writes(whole, f, width, at, set),
                                    FTm::word(hw.fw.w.tys, g, env, i).toNat(),
                                    λ (o: Option<A → BitVec(width) → A>) => ((match o { None => False, Some(_) => True }).IsTrue() →
                                        whole.Holds(FTm::called(hw.fw, g, env, f, [place, len, i, v], own).after, FTm::word(hw.fw.w.tys, g, env, len),
                                            match o {
                                                None => a,
                                                Some(set) => set(a, Ty::cast(hw.fw.w.tys, Ty::at(g, v), Word(width), Env::get(hw.fw.w.tys, g, env, v))),
                                            })),
                                    λ never => false_elim(never),
                                    λ set promise _ => promise(place, len, i, v, own, a, g, env, holds, refl),
                                    writes)(FTm::known_found(hw.fw.w.tys, g, env, known, knows, fields, i, found)),
                            two.left)(two.right))
                    },
                    Runs(words, run) => λ runs lent =>
                        FTm::run_args_elim(args, len, words,
                            λ (xs: List<Nat>) => (Runs(words, run).answer(hw.fw.w.tys, xs, g, env, a, Sig::at(hw.fw.fsigs, f).result, FTm::called(hw.fw, g, env, f, xs, own).value)
                                    = FTm::called(hw.fw, g, env, f, xs, own).value)
                                ∧ whole.Holds(FTm::called(hw.fw, g, env, f, xs, own).after, FTm::word(hw.fw.w.tys, g, env, len),
                                    Runs(words, run).state(hw.fw.w.tys, xs, g, env, a)),
                            λ place rest long => {
                                let agrees = FTm::shaped(words, λ (r: List<Nat>) => (own: List<BitVec(8)>) → (a: A) → (g: List<Ty>) → (env: Env(hw.fw.w.tys, g)) →
                                        whole.Holds(own, FTm::word(hw.fw.w.tys, g, env, len), a) →
                                        Agrees<A, Sig::at(hw.fw.fsigs, f).result.sem(hw.fw.w.tys)>(whole, FTm::word(hw.fw.w.tys, g, env, len),
                                            Mutated(run(a, FTm::words(hw.fw.w.tys, g, env, r)).after,
                                                Ty::cast(hw.fw.w.tys, Word(64), Sig::at(hw.fw.fsigs, f).result, run(a, FTm::words(hw.fw.w.tys, g, env, r)).value)),
                                            FTm::called(hw.fw, g, env, f, Cons(place, Cons(len, r)), own)),
                                    runs(place, len), rest, long)(own, a, g, env, holds);
                                And(agrees.value, agrees.holds)
                            },
                            lent),
                };
            let got = by_case(Writer::at(hw.writers, f),
                Writer::all_at(hw.writers, λ (f: Nat) (width: Nat) (at: Nat) (set: A → BitVec(width) → A) => hw.Writes(whole, f, width, at, set),
                    λ (f: Nat) (words: Nat) (run: A → List<BitVec(64)> → Mutated<A, BitVec(64)>) => hw.Runs(whole, f, words, run), sound.writers, f), both.left);
            let ran = body.held_runs(hw, whole, sound, Succ(len), Cons(None, known), both.right, Cons(Sig::at(hw.fw.fsigs, f).result, g),
                Pair(FTm::called(hw.fw, g, env, f, args, own).value, env),
                FTm::knows_more(hw.fw.w.tys, g, env, known, knows, Sig::at(hw.fw.fsigs, f).result, FTm::called(hw.fw, g, env, f, args, own).value),
                FTm::called(hw.fw, g, env, f, args, own).after, FTm::held_state(hw, f, args, g, env, a), got.right);
            let same: (FTm::held_answer(hw, f, args, g, env, a, FTm::called(hw.fw, g, env, f, args, own).value) = FTm::called(hw.fw, g, env, f, args, own).value) = got.left;
            let goal: Agrees<A, body.ty(hw.fw.w, hw.fw.fsigs, Cons(Sig::at(hw.fw.fsigs, f).result, g)).sem(hw.fw.w.tys)>(whole, FTm::word(hw.fw.w.tys, g, env, len),
                body.held(hw, Cons(Sig::at(hw.fw.fsigs, f).result, g),
                    Pair(FTm::held_answer(hw, f, args, g, env, a, FTm::called(hw.fw, g, env, f, args, own).value), env),
                    FTm::called(hw.fw, g, env, f, args, own).after, FTm::held_state(hw, f, args, g, env, a)),
                body.sem(hw.fw, Cons(Sig::at(hw.fw.fsigs, f).result, g), Pair(FTm::called(hw.fw, g, env, f, args, own).value, env),
                    FTm::called(hw.fw, g, env, f, args, own).after)) = rewrite(same, ran);
            goal
        },
        Again(_) => λ len known kept => false_elim(kept),
        Lend(_, _, _, _) => λ len known kept => false_elim(kept),
    }
}

// ---------------------------------------------------------------------------
// A function

// Agreement carried along two equations: a pin of the held meaning to a
// function of the record, and a reflection's of the byte meaning to the
// compiled function.
theorem Agrees::along<A, R>(whole: Stored<A>, n: BitVec(64), h, h2: Mutated<A, R>, m, m2: Mutated<List<BitVec(8)>, R>, hq: h = h2, mq: m = m2,
    agrees: Agrees<A, R>(whole, n, h, m)): Agrees<A, R>(whole, n, h2, m2) {
    j(mq, λ y _ => Agrees<A, R>(whole, n, h2, y), j(hq, λ x _ => Agrees<A, R>(whole, n, x, m), agrees))
}

// A held answer read at its own code is itself.
theorem FTm::held_recast_along<A>(tys: Nat → RecInfo, x, y: Ty, e: x = y, h: Mutated<A, x.sem(tys)>):
    FTm::held_recast(tys, x, y, h) = j(e, λ z _ => Mutated<A, z.sem(tys)>, h) {
    j(e, λ z q => FTm::held_recast(tys, x, z, h) = j(q, λ u _ => Mutated<A, u.sem(tys)>, h),
        match h { Mutated(after, value) => cong_fn(λ (v: x.sem(tys)) => Mutated(after, v), Ty::cast_self(tys, x, value)) })
}

// A function's byte meaning at an environment of its parameters: what
// `FFun::meaning` curries.
fn FFun::bytes(f: FFun, fw: FWorld, env: Env(fw.w.tys, Ty::bind_onto(f.params, Nil)), own: List<BitVec(8)>) → Mutated<List<BitVec(8)>, f.result.sem(fw.w.tys)> {
    FTm::recast(fw.w.tys, f.body.ty(fw.w, fw.fsigs, Ty::bind_onto(f.params, Nil)), f.result, f.body.sem(fw, Ty::bind_onto(f.params, Nil), env, own))
}

// The agreement for a function, with nothing in the held meaning's way:
// the body's held meaning stands as it is (a function of the record is
// pinned to it by `refl`, branch for branch), read at the declared result
// along `typed`, which is `refl` at a reflection. `len` is the variable
// the length word is: as many as the function's operands after it.
theorem FFun::held_runs<A>(self f: FFun, hw: HWorld<A>, whole: Stored<A>, sound: Sound<A>(hw, whole), len: Nat, kept: f.body.kept(hw, len, Nil).IsTrue(),
    typed: f.body.ty(hw.fw.w, hw.fw.fsigs, Ty::bind_onto(f.params, Nil)) = f.result, env: Env(hw.fw.w.tys, Ty::bind_onto(f.params, Nil)), own: List<BitVec(8)>, a: A,
    holds: whole.Holds(own, FTm::word(hw.fw.w.tys, Ty::bind_onto(f.params, Nil), env, len), a)):
    Agrees<A, f.result.sem(hw.fw.w.tys)>(whole, FTm::word(hw.fw.w.tys, Ty::bind_onto(f.params, Nil), env, len),
        j(typed, λ z _ => Mutated<A, z.sem(hw.fw.w.tys)>, f.body.held(hw, Ty::bind_onto(f.params, Nil), env, own, a)), FFun::bytes(f, hw.fw, env, own)) {
    let ran = f.body.held_runs(hw, whole, sound, len, Nil, kept, Ty::bind_onto(f.params, Nil), env,
        FTm::knows_nothing(hw.fw.w.tys, Ty::bind_onto(f.params, Nil), env), own, a, holds);
    let cast = Agrees::recast(whole, FTm::word(hw.fw.w.tys, Ty::bind_onto(f.params, Nil), env, len), hw.fw.w.tys, f.body.ty(hw.fw.w, hw.fw.fsigs, Ty::bind_onto(f.params, Nil)), f.result,
        f.body.held(hw, Ty::bind_onto(f.params, Nil), env, own, a), f.body.sem(hw.fw, Ty::bind_onto(f.params, Nil), env, own), ran);
    Agrees::along(whole, FTm::word(hw.fw.w.tys, Ty::bind_onto(f.params, Nil), env, len),
        FTm::held_recast(hw.fw.w.tys, f.body.ty(hw.fw.w, hw.fw.fsigs, Ty::bind_onto(f.params, Nil)), f.result, f.body.held(hw, Ty::bind_onto(f.params, Nil), env, own, a)),
        j(typed, λ z _ => Mutated<A, z.sem(hw.fw.w.tys)>, f.body.held(hw, Ty::bind_onto(f.params, Nil), env, own, a)),
        FFun::bytes(f, hw.fw, env, own), FFun::bytes(f, hw.fw, env, own),
        FTm::held_recast_along(hw.fw.w.tys, f.body.ty(hw.fw.w, hw.fw.fsigs, Ty::bind_onto(f.params, Nil)), f.result, typed, f.body.held(hw, Ty::bind_onto(f.params, Nil), env, own, a)),
        refl, cast)
}

// ---------------------------------------------------------------------------
// What a generator applies (`runtime_held`, runtime.hthr). A tactic's
// `Expr` has no constructor form, so the marks, the lists and the tuple of
// what the marks owe are built by calls, each its constructor; and the
// agreement is one call, its equations by conversion.

fn Reader::plain<A>() → Reader<A> { Plain }

fn Reader::of<A>(fields: List<Pair<Nat, A → BitVec(64)>>) → Reader<A> { Reads(64, fields) }

fn Writer::apart<A>() → Writer<A> { Apart }

fn Writer::of<A>(fields: List<Pair<Nat, A → BitVec(64) → A>>) → Writer<A> { Writes(64, fields) }

// A held function's mark: how many words it takes after the span's
// length word, and its function of the record at them.
fn Writer::runs<A>(words: Nat, run: A → List<BitVec(64)> → Mutated<A, BitVec(64)>) → Writer<A> { Runs(words, run) }

// Operand `i` of a held function's words: what its mark hands its
// function of the record, a parameter at a time.
fn FTm::operand(ws: List<BitVec(64)>, i: Nat) → BitVec(64) {
    match ws {
        Nil => 0,
        Cons(w, rest) => match i { Zero => w, Succ(j) => FTm::operand(rest, j) },
    }
}

// What a generator states a held callee's promise with: a variable, a
// scope and an environment's types, a variable's word, and the callee's
// own agreement (its `runs_held`) as the promise words it, the function
// of the record's answer taken apart.
fn HWorld::Var() → Type { Nat }

fn HWorld::Scope() → Type { List<Ty> }

fn HWorld::EnvAt<A>(self hw: HWorld<A>, g: List<Ty>) → Type { Env(hw.fw.w.tys, g) }

fn HWorld::word_at<A>(self hw: HWorld<A>, g: List<Ty>, env: Env(hw.fw.w.tys, g), v: Nat) → BitVec(64) { FTm::word(hw.fw.w.tys, g, env, v) }

// A call of computation `f`, by the marked world.
fn HWorld::called_at<A>(self hw: HWorld<A>, g: List<Ty>, env: Env(hw.fw.w.tys, g), f: Nat, args: List<Nat>, own: List<BitVec(8)>)
    → Mutated<List<BitVec(8)>, Sig::at(hw.fw.fsigs, f).result.sem(hw.fw.w.tys)> {
    FTm::called(hw.fw, g, env, f, args, own)
}

// `same` is the call as the world makes it against the callee applied,
// which a generator proves with the callee a parameter: at the callee
// itself the kernel would run its body before the world's table arrived
// at its name.
theorem HWorld::ran<A>(whole: Stored<A>, n: BitVec(64), spec: Mutated<A, BitVec(64)>, code: Mutated<List<BitVec(8)>, BitVec(64)>,
    got: Agrees<A, BitVec(64)>(whole, n, spec, code), called: Mutated<List<BitVec(8)>, BitVec(64)>, same: called = code):
    Agrees<A, BitVec(64)>(whole, n, Mutated(spec.after, spec.value), called) {
    j(sym(same), λ y _ => Agrees<A, BitVec(64)>(whole, n, Mutated(spec.after, spec.value), y), Agrees(got.value, got.holds))
}

fn HWorld::marked<A>(fw: FWorld, readers: List<Reader<A>>, writers: List<Writer<A>>) → HWorld<A> { HWorld(fw, readers, writers) }

fn HWorld::none<X>() → List<X> { Nil }

fn HWorld::more<X>(x: X, rest: List<X>) → List<X> { Cons(x, rest) }

// An environment, one value on.
fn HWorld::bound<X, E>(x: X, env: E) → Pair<X, E> { Pair(x, env) }

theorem HWorld::owed<P, Q>(p: P, q: Q): P ∧ Q { And(p, q) }

// What the function over the span is written out with (`T::m::bytes`):
// a value bound once, its answer at the span as it stands, what follows
// a store at the span the store leaves and the word it answers, and a
// branch. A value is bound by `HWorld::once` and not by `shared`, which
// it is: the meaning the written function is compared with binds what a
// call answers by `shared`, and two applications of one function are
// compared argument by argument before either unfolds, which here would
// be a value against a store.
fn HWorld::once<X, S>(x: X, k: X → S) → S { k(x) }

// The function written out, under a name. Where it meets itself through
// other definitions (the program's run against it, the instance's source
// against it), the kernel meets at the name and compares what the name is
// applied to; with no name it runs one side to its end before the other
// arrives, and compares the two ends.
fn HWorld::written<F>(f: F) → F { f }

// The function over the span, published as `T::m::bytes`, with the
// function of the record it is compiled from beside it: a linker that
// meets it as a callee reads there whose tables and instance are its
// (`T::m::world`, `T::m::compile`).
fn HWorld::of_record<F, G>(source: G, f: F) → F { f }

// What holds at every value of a type, at one. A function written out is
// a function of its callees, and what is proved of it by conversion is
// proved with each callee a parameter and read here at the program's own:
// a parameter has no body for the kernel to unfold.
theorem HWorld::at<A>(B: A → Type, a: A, all: (x: A) → B(x)): B(a) { all(a) }

fn HWorld::answer<R>(span: List<BitVec(8)>, value: R) → Mutated<List<BitVec(8)>, R> { Mutated(span, value) }

// What a function that only reads a record answers, as one that changes
// it: its value beside the record as it was.
fn HWorld::unchanged<A, R>(a: A, value: R) → Mutated<A, R> { Mutated(a, value) }

fn HWorld::after<A, R, S>(m: Mutated<A, R>, k: A → R → S) → S { k(m.after, m.value) }

fn HWorld::either<S>(c: Bool, yes: S, no: S) → S { match c { False => no, True => yes } }

theorem Sound::of<A>(hw: HWorld<A>, whole: Stored<A>,
    readers: Reader::All(hw.readers, λ (f: Nat) (width: Nat) (at: Nat) (get: A → BitVec(width)) => hw.Reads(whole, f, width, at, get)),
    writers: Writer::All(hw.writers, λ (f: Nat) (width: Nat) (at: Nat) (set: A → BitVec(width) → A) => hw.Writes(whole, f, width, at, set),
        λ (f: Nat) (words: Nat) (run: A → List<BitVec(64)> → Mutated<A, BitVec(64)>) => hw.Runs(whole, f, words, run))): Sound<A>(hw, whole) {
    Sound(readers, writers)
}

// The agreement of a compiled function with the function of the record
// it was reflected from: `pinned` is the pin of the held meaning to that
// function and `reflects` the byte meaning's to the compiled function,
// both by conversion at a reflection.
theorem FFun::held_agrees<A>(self f: FFun, hw: HWorld<A>, whole: Stored<A>, sound: Sound<A>(hw, whole), len: Nat, kept: f.body.kept(hw, len, Nil).IsTrue(),
    typed: f.body.ty(hw.fw.w, hw.fw.fsigs, Ty::bind_onto(f.params, Nil)) = f.result, env: Env(hw.fw.w.tys, Ty::bind_onto(f.params, Nil)), own: List<BitVec(8)>, a: A,
    holds: whole.Holds(own, FTm::word(hw.fw.w.tys, Ty::bind_onto(f.params, Nil), env, len), a),
    spec: Mutated<A, f.result.sem(hw.fw.w.tys)>,
    pinned: j(typed, λ z _ => Mutated<A, z.sem(hw.fw.w.tys)>, f.body.held(hw, Ty::bind_onto(f.params, Nil), env, own, a)) = spec,
    code: Mutated<List<BitVec(8)>, f.result.sem(hw.fw.w.tys)>, reflects: FFun::bytes(f, hw.fw, env, own) = code):
    Agrees<A, f.result.sem(hw.fw.w.tys)>(whole, FTm::word(hw.fw.w.tys, Ty::bind_onto(f.params, Nil), env, len), spec, code) {
    Agrees::along(whole, FTm::word(hw.fw.w.tys, Ty::bind_onto(f.params, Nil), env, len),
        j(typed, λ z _ => Mutated<A, z.sem(hw.fw.w.tys)>, f.body.held(hw, Ty::bind_onto(f.params, Nil), env, own, a)), spec,
        FFun::bytes(f, hw.fw, env, own), code, pinned, reflects, f.held_runs(hw, whole, sound, len, kept, typed, env, own, a, holds))
}

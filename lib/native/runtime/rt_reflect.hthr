// The reflector: an elaborated body, read through the host interface, as
// `rt` (docs/native/runtime-fn-setups-design.md §3,
// issues/runtime-fn-reflected-language.md).
//
// Untrusted like every producer: a wrong reflection fails the pin
// (`rt.hthr`), never compiles to a wrong program. It reads a definition's
// body with `Body`, its parameters by opening the body's `λ`s, a `match` with
// `Arms`, and every other node with `View`, and builds A-normal form: an
// operand that is not a variable is bound by a `Let` first.
//
// **Value numbering.** A block's `let` is an alias, so the source's sharing
// is a shared subterm, not a binder. The host hands out one handle per
// shared subterm, and the reflector memoises on handles; it also numbers
// values (a node whose operands it has already bound is bound once), as
// the Rust reflector does, because an elaborated body today repeats a
// let-bound value at each use rather than sharing it
// (`issues/elaborated-let-sharing-lost.md`).
//
// What it reads, and what it refuses with the reason: words and `Bool`,
// records it is told about, byte buffers, lists of lines (`Nil` and `Cons`);
// the primitives of `Known`; calls of the program's own functions; `foldl`
// of one of them; `match` and `match h:` on a `Bool`; a named constant (a
// global with no parameters whose body is a literal). Anything else is "not
// in the reflected fragment", naming the form, never a guess.
//
// An effectful body (`rt_io_reflect`) is read by the same walk with the
// world in `Known::io`: a call's answer is the variables its `Invoke` bound,
// and the world itself is never a value.

import logic;
import bool;
import nat;
import list;
import option;
import pair;
import char;
import string;
import tactic;
import derive;
import rt;

// ---------------------------------------------------------------------------
// What the reflector recognises, as the host's global references.

// A primitive global: a word operation (by `Op::code`'s number), a `Bool`
// connective, a literal, an extension, `foldl`, or a byte read or write.
//
// Two are not operations of `rt` but rewritings into them
// (issues/rt-complement-and-rotate.md), which the pin accepts because each
// right side converts to its left at a literal width: `PComplement` is
// `~x` read as `all_ones ⊕ x` (`Bool::xor` matches on its left operand, so
// a literal of all ones on the left computes to `!b` bit by bit, where on
// the right it would be stuck on the neutral bit), and `PRotate(kind)` is
// `x.rotr(k)` (`kind` 0) or `x.rotl(k)` (1) read as the shift pair it is
// defined as (`bitvec_rotate.hthr`), the other count `w - k` computed here.
inductive Prim { PWord(op: Nat), PConj, PDisj, PNeg, POfNat, PZext, PFoldl, PGet, PSet, PToNat, PTrunc, PShift(kind: Nat), PSext, PWithin, PComplement, PRotate(kind: Nat) }

record PrimEntry { g: Nat, p: Prim }

record RecEntry { g: Nat }

// A type the program holds by its `datarepr` (docs/native/runtime-fn-setups-design.md
// §16.13): the repr's global (what `Repr` answers for the type) and name, the spec
// type's name (whose own operations the walk reads through), the repr's
// `abs` and `emb`, and the type itself. Its code is `Named(recs.len() + i)`,
// `i` its place among the program's reprs, in the order the walk met them.
record ReprEntry { repr: Nat, name: String, spec: String, abs: Nat, emb: Nat, ty: Handle }

// A call on Linux an effectful body has made (`rt_io_reflect`,
// docs/language/effects-capabilities-design.md §8.3), as the reflector reads its
// answer back: its place on the world chain (the first call is 0), the
// method, the call as the body has it, and the variables its `Invoke` bound
// the answer to: `.value` when the answer is one word, `.value.<field>` when
// it is a record of them.
record CallRes { pos: Nat, method: Nat, call: Handle, value: Option<Nat>, fields: List<Pair<String, Nat>> }

// A statement `if` the walk has made (docs/native/io-programs-design.md
// §4.2): the locals its arms assign, the world among them, are joined in
// one record, `#stage`, a `match` on the test whose arms each end in the
// locals written out (`Mutated(io, Mutated(k, s))`), and every later read of
// a local is a field of it (`#stage.value.after`, which `Arms` answers as
// the `match` and the fields' numbers). `stage` is that `match`, and
// `parts` each local's variable after the `if`, in the record's order,
// `None` for the world.
record IfRes { stage: MatchInfo, parts: List<Option<Nat>> }

// What an effectful body's reflection knows of its world: the capability's
// local, the word-level methods that call Linux, and the calls made so far,
// in order; the functions of the program a computation may lend a buffer
// to (`ETm::Lend`), the table's order, and the calls of them made so far,
// each with the variables its `Lend` bound the bytes it left (`after`) and
// its word (`value`) to; the globals `Io` and `Mutated`, and the statement
// `if`s made so far (`ETm::If`, `rt_if_make`).
record IoKnown { world: Nat, methods: List<Nat>, calls: List<CallRes>, lends: List<Nat>, lent: List<CallRes>, ty: Nat, mutated: Nat, ifs: List<IfRes> }

fn IoKnown::with_calls(self io: IoKnown, calls: List<CallRes>) → IoKnown { IoKnown(io.world, io.methods, calls, io.lends, io.lent, io.ty, io.mutated, io.ifs) }
fn IoKnown::with_lent(self io: IoKnown, lent: List<CallRes>) → IoKnown { IoKnown(io.world, io.methods, io.calls, io.lends, lent, io.ty, io.mutated, io.ifs) }
fn IoKnown::with_ifs(self io: IoKnown, ifs: List<IfRes>) → IoKnown { IoKnown(io.world, io.methods, io.calls, io.lends, io.lent, io.ty, io.mutated, ifs) }
// The same names, the world `world` with no call made yet.
fn IoKnown::at(self io: IoKnown, world: Nat) → IoKnown { IoKnown(world, io.methods, [], io.lends, io.lent, io.ty, io.mutated, io.ifs) }

// What the body of a function over a span it writes knows of that span
// (`rt_file_reflect`, docs/native/native-one-compiler-design.md §2.6): the span
// parameter's local, the span as it is now (`None` while nothing has
// written it: the parameter itself; after a store or a call that writes,
// that link of the chain), and the calls that wrote it so far, in order,
// each with the variable its word is bound to. `was` is the links walked
// so far, in order (the span after `was[j]` is state `j + 1`, the
// parameter state 0, the last link the span now), and `olds` the bytes of
// earlier states bound before the store or call that ended their state
// (`rt_file_reflect`'s plan, issues/rt-file-read-before-store.md).
record FileKnown { span: Nat, now: Option<Handle>, calls: List<CallRes>, was: List<Handle>, olds: List<OldByte> }

// A byte of the written span as it was at state `state`, read at the word
// variable `index` and bound to the variable `level` before the link that
// ended that state: what a read of that state after the link stands for.
record OldByte { state: Nat, index: Nat, level: Nat }

// The span at a function's start: the parameter, nothing walked.
fn FileKnown::start(span: Nat, calls: List<CallRes>) → FileKnown { FileKnown(span, None, calls, [], []) }

// The span after `link`, with the calls that wrote it so far.
fn FileKnown::past(self fk: FileKnown, link: Handle, calls: List<CallRes>) → FileKnown {
    FileKnown(fk.span, Some(link), calls, fk.was ++ [link], fk.olds)
}

fn FileKnown::keeping(self fk: FileKnown, old: OldByte) → FileKnown {
    FileKnown(fk.span, fk.now, fk.calls, fk.was, Cons(old, fk.olds))
}

// The variable a byte of state `s` at the index variable `i` was bound to.
fn OldByte::find(olds: List<OldByte>, s: Nat, i: Nat) → Option<Nat> {
    match olds {
        Nil => None,
        Cons(o, rest) => match o.state.same(s).and(o.index.same(i)) { True => Some(o.level), False => OldByte::find(rest, s, i) },
    }
}

// A recursion the walk is inside (design §16.11): a fuel recursion's `Succ`
// arm, or a measured function's step (`f::body`). `ih` is the local the
// recursion is called through, and a call of it is a call of the function
// itself (entry 0) on `head` (a fuel recursion's predecessor) and then the
// words: each word parameter's level (`slots`), those the recursion varies
// (`varied`, in the order the call passes them) replaced by the call's
// arguments. A measured step's call passes a proof after the words, which
// nothing reads.
record SelfCall { ih: Nat, head: List<Nat>, slots: List<Nat>, varied: List<Nat> }

// The elements of an array field, each a word its codec's accessor reads:
// element `i` of `count` lies at the word `base + i * stride`, and a read
// of it at a literal index stands for `narrow` of `read` at that word
// (`read` and `narrow` are applied to it, and to the word read). A read
// at an index that is a word, `vector_get(x.f, i.toNat(), 0)`, stands for
// `narrow` of `read_at` at the word the array begins at, its count and
// the index: the accessor's checked read, 0 past the count.
// `under` is the local a new one is assumed under where the terms live.
record ElementTerm { count: Nat, base: Nat, stride: Nat, read: Expr, narrow: Expr, read_at: Expr, under: LocalRef }

// What an element's read stands for: a term, and for a read at a word
// the local that stands in it for the index beside the index itself. The
// index is under the body's binders and the accessor's terms under the
// span's, so the term has a local of the span's for it, and the walk
// binds that local to the index's variable.
record ElementRead { term: Handle, index: Option<Pair<Nat, Handle>> }

// What a field `field` of the local `of` stands for: a term, or for an
// array its elements' terms. `FieldNow(of, call)` says the record the
// local `of` named is now what `call` left, `call.after`: a field of that
// term stands for what the local's did, and a field of the local itself,
// read for the first time, is the record as it was and stands for nothing.
inductive FieldTerm { FieldWhole(of: Nat, field: String, term: Handle), FieldEach(of: Nat, field: String, each: ElementTerm), FieldNow(of: Nat, call: Handle) }

record Known {
    prims: List<PrimEntry>,
    // The program's functions, in order: a `Call`'s index.
    funs: List<Nat>,
    // The records the program reads, in order: a `Named` code's index.
    recs: List<RecEntry>,
    // Whether a call of a global that is not one of `funs` may name another
    // runtime fn (one with a published reflection, `g::rt`): the `runtime`
    // generator's mode, which appends it to the program (`RSt::funs`).
    discover: Bool,
    bitvec: Nat,
    boolean: Nat,
    list: Nat,
    // The world of an effectful body; `None` for pure code.
    io: Option<IoKnown>,
    // `Nat`, a loop's fuel (`Count`).
    nat: Nat,
    // The recursion the walk is inside, if any.
    recursion: Option<SelfCall>,
    // The types the program holds by their `datarepr`, after `recs` in the
    // type table.
    reprs: List<ReprEntry>,
    // How many spans the function being walked is lent (the generator's
    // mode): span `j`'s bytes are the parameter at level `2j`, its length
    // word the one at `2j + 1`.
    lent: Nat,
    // The span a computation writes; `None` for code that writes nothing.
    file: Option<FileKnown>,
    // Fields of a local that stand for a term each (a field of the record
    // a span holds, for its accessor's read, `rt_held_reflect`): a read of
    // the field is the term, reflected where it is first read.
    named: List<FieldTerm>,
}

fn Known::within(self k: Known, sc: SelfCall) → Known {
    Known(k.prims, k.funs, k.recs, k.discover, k.bitvec, k.boolean, k.list, k.io, k.nat, Some(sc), k.reprs, k.lent, k.file, k.named)
}

fn Known::with_reprs(self k: Known, rs: List<ReprEntry>) → Known {
    Known(k.prims, k.funs, k.recs, k.discover, k.bitvec, k.boolean, k.list, k.io, k.nat, k.recursion, rs, k.lent, k.file, k.named)
}

fn Known::lending(self k: Known, lent: Nat) → Known {
    Known(k.prims, k.funs, k.recs, k.discover, k.bitvec, k.boolean, k.list, k.io, k.nat, k.recursion, k.reprs, lent, k.file, k.named)
}

fn Known::naming(self k: Known, named: List<FieldTerm>) → Known {
    Known(k.prims, k.funs, k.recs, k.discover, k.bitvec, k.boolean, k.list, k.io, k.nat, k.recursion, k.reprs, k.lent, k.file, named)
}

// The span a parameter level is the bytes of, if it is one.
fn Known::span_of(self k: Known, l: Nat) → Option<Nat> {
    match Succ(l).leb(k.lent + k.lent).and(l.mod(2).same(0)) { True => Some(l.div(2)), False => None }
}

// Whether the walk reads types held by their repr: the generator's mode
// (which finds them as it goes), or a program given some.
fn Known::reprs_on(self k: Known) → Bool { match k.reprs { Nil => k.discover, Cons(_, _) => True } }

fn Known::repr_at(rs: List<ReprEntry>, g: Nat, i: Nat) → Option<Nat> {
    match rs { Nil => None, Cons(r, rest) => match r.repr.same(g) { True => Some(i), False => Known::repr_at(rest, g, Succ(i)) } }
}

// Whether a local is the recursion's.
fn Known::is_ih(self k: Known, x: LocalRef) → Bool {
    match k.recursion { None => False, Some(sc) => x.id.same(sc.ih) }
}

fn Known::prim(ps: List<PrimEntry>, g: Nat) → Option<Prim> {
    match ps { Nil => None, Cons(p, rest) => match p.g.same(g) { True => Some(p.p), False => Known::prim(rest, g) } }
}

fn Known::index(gs: List<Nat>, g: Nat, i: Nat) → Option<Nat> {
    match gs { Nil => None, Cons(x, rest) => match x.same(g) { True => Some(i), False => Known::index(rest, g, Succ(i)) } }
}

// A call of the recursion: its first `varied` arguments' levels in place of
// the varied words.
fn SelfCall::call_args(self sc: SelfCall, ls: List<Nat>) → List<Nat> {
    sc.head ++ sc.slots.map(λ l => match Known::index(sc.varied, l, 0) { None => l, Some(j) => ls.nth(j).unwrap_or(l) })
}

fn Known::rec(rs: List<RecEntry>, g: Nat, i: Nat) → Option<Nat> {
    match rs { Nil => None, Cons(r, rest) => match r.g.same(g) { True => Some(i), False => Known::rec(rest, g, Succ(i)) } }
}

fn Known::str_same(a, b: String) → Bool { match string_eq_dec(a, b) { Inl(_) => True, Inr(_) => False } }

fn Known::field(names: List<String>, name: String, k: Nat) → Option<Nat> {
    match names {
        Nil => None,
        Cons(n, rest) => match Known::str_same(n, name) { True => Some(k), False => Known::field(rest, name, Succ(k)) },
    }
}

// The word operation of a `PWord` number at a width.
// A shift by its kind: left, logical right, arithmetic right.
fn Known::shift_op(kind, w, c: Nat) → Op {
    match kind { Zero => Shl(w, c), Succ(a) => match a { Zero => Lshr(w, c), Succ(_) => Ashr(w, c) } }
}

fn Known::word_op(op: Nat, w: Nat) → Op {
    match op {
        Zero => Add(w),
        Succ(a) => match a {
            Zero => Sub(w),
            Succ(b) => match b {
                Zero => Band(w),
                Succ(c) => match c {
                    Zero => Bor(w),
                    Succ(d) => match d {
                        Zero => Bxor(w),
                        Succ(e) => match e { Zero => Eq(w), Succ(f) => match f { Zero => Ult(w), Succ(_) => Slt(w) } },
                    },
                },
            },
        },
    }
}

// ---------------------------------------------------------------------------
// Small plumbing.

fn rt_refuse<A>(why: String) → Tac<A> { fail("rt: " ++ why, []) }

// A refusal that shows the term refused.
fn rt_refuse_at<A>(why: String, h: Handle) → Tac<A> {
    view(h).bind(λ v => {
        let what = match v {
            HPi(_) => "a function type",
            HEq(_, _) => "an equation",
            HHole => "a term not known yet",
            HLam(_) => "a function value",
            HOther => "a term the host shows no layer of",
            _ => "not reflected",
        };
        fail("rt: " ++ why, [At(Hd(h), Tried("the term", what))])
    })
}

fn rt_accepted<A>(what: String, c: Checked<A>) → Tac<A> {
    match c { Accepted(a) => pure(a), Refused(why) => rt_refuse(what ++ ": " ++ why) }
}

// The `match` `h` is, itself: a field read of its record (`Arms`' `path`)
// is a statement `if`'s joined locals, which only an effectful walk reads
// (`rt_if_make`).
fn rt_match(what: String, h: Handle) → Tac<MatchInfo> {
    arms(h).bind(λ c => rt_accepted(what, c)).bind(λ m => match m.path {
        Nil => pure(m),
        Cons(_, _) => rt_refuse(what ++ ": a field of a `match`'s record, which is read only as an `if`'s locals"),
    })
}

// A generated global (`f#rec`, a `decreases` function's recursor): its name
// has a `#`, which no source name has.
fn rt_generated(cs: List<Char>) → Bool {
    match cs { Nil => False, Cons(c, rest) => match c.code.same(35) { True => True, False => rt_generated(rest) } }
}

// Why a global the reflector does not know is refused.
fn rt_unknown<A>(name: String) → Tac<A> {
    match rt_generated(name.chars) {
        True => rt_refuse("`" ++ name ++ "` is generated (a `decreases` function's recursion): measured recursion is not reflected yet"),
        False => rt_refuse("`" ++ name ++ "` is an ordinary fn: mark it `runtime fn`, or the setup has no primitive for it"),
    }
}

fn rt_global(name: String) → Tac<Nat> {
    lookup(name).bind(λ c => rt_accepted("`" ++ name ++ "`", c)).bind(λ g => pure(g.id))
}

fn rt_globals(names: List<String>) → Tac<List<Nat>> {
    match names { Nil => pure([]), Cons(n, rest) => rt_global(n).bind(λ g => rt_globals(rest).bind(λ gs => pure(Cons(g, gs)))) }
}

fn rt_assoc(xs: List<Pair<Nat, Nat>>, k: Nat) → Option<Nat> {
    match xs { Nil => None, Cons(p, rest) => match p.fst.same(k) { True => Some(p.snd), False => rt_assoc(rest, k) } }
}

fn rt_memo(xs: List<Pair<Tm, Nat>>, t: Tm) → Option<Nat> {
    match xs { Nil => None, Cons(p, rest) => match p.fst.same(t) { True => Some(p.snd), False => rt_memo(rest, t) } }
}

// A numeral, or a number computed from numerals as `zero_extend`'s
// `extra + n` leaves an operand's width: its head normal forms are
// successors (`succ`, the constructor's global) down to a numeral, one per
// step, `fuel` of them at most.
fn rt_number(fuel, succ: Nat, h: Handle) → Tac<Nat> {
    match fuel {
        Zero => rt_refuse("expected a numeral"),
        Succ(f) => whnf_or(h).bind(λ w => view(w).bind(λ u => match u {
            HLit(n) => pure(n),
            HGlobal(g, _, args) => match g.id.same(succ) {
                True => match args { Cons(p, Nil) => rt_number(f, succ, p).bind(λ n => pure(Succ(n))), _ => rt_refuse("expected a numeral") },
                False => rt_refuse("expected a numeral"),
            },
            _ => rt_refuse("expected a numeral"),
        })),
    }
}

fn rt_literal(h: Handle) → Tac<Nat> {
    view(h).bind(λ v => match v { HLit(n) => pure(n), _ => rt_global("Succ").bind(λ succ => rt_number(1024, succ, h)) })
}

// ---------------------------------------------------------------------------
// Types.

// Whether a type is `BitVec(8)`.
fn Known::is_byte(self k: Known, h: Handle) → Tac<Bool> {
    let v <- view(h);
    match v {
        HGlobal(g, _, args) => match g.id.same(k.bitvec) {
            True => match args { Cons(w, _) => { let n <- rt_literal(w); pure(n.same(8)) }, Nil => pure(False) },
            False => pure(False),
        },
        _ => pure(False),
    }
}

// Whether a type is `List<BitVec(8)>`.
fn Known::is_bytes(self k: Known, h: Handle) → Tac<Bool> {
    let v <- view(h);
    match v {
        HGlobal(g, _, args) => match g.id.same(k.list) {
            True => match args { Cons(a, _) => k.is_byte(a), Nil => pure(False) },
            False => pure(False),
        },
        _ => pure(False),
    }
}

// A repr the walk has met but was not given: the walk stops with this
// message, naming the repr and its spec type, and `rt_with_reprs` adds the
// repr and walks again (a repr's place in the table is fixed before any
// `Named` code names it).
fn rt_repr_marker() → String { "a repr the walk has not met yet: " }

fn rt_needs_repr<A>(rname: String, spec: String) → Tac<A> { rt_refuse(rt_repr_marker() ++ rname ++ "|" ++ spec) }

// A type held by its `datarepr`: its place among the program's reprs, after
// its records.
fn Known::repr_ty(self k: Known, h: Handle, name: String) → Tac<Ty> {
    let none = "`" ++ name ++ "` has no runtime layout under the reflected fragment";
    match k.reprs_on() {
        False => rt_refuse(none),
        True => repr_of(h).bind(λ c => match c {
            Refused(_) => rt_refuse(none),
            Accepted(r) => view(r).bind(λ v => match v {
                HGlobal(rg, rname, _) => match Known::repr_at(k.reprs, rg.id, 0) {
                    Some(i) => pure(Named(k.recs.len() + i)),
                    None => match k.discover {
                        True => rt_needs_repr(rname, name),
                        False => rt_refuse("`" ++ name ++ "` is held by its datarepr `" ++ rname ++ "`, which the program was not given"),
                    },
                },
                _ => rt_refuse(none),
            }),
        }),
    }
}

// Whether a node's type is one the program holds by its `datarepr`
// (failing only to ask for a repr the walk has not met; a node whose type
// has no layout is not).
fn Known::is_repr_typed(self k: Known, h: Handle) → Tac<Bool> {
    match k.reprs_on() {
        False => pure(False),
        True => infer(Hd(h)).bind(λ c => match c {
            Refused(_) => pure(False),
            Accepted(t) => view(t).bind(λ v => match v {
                HGlobal(g, tname, _) => match Known::rec(k.recs, g.id, 0) {
                    Some(_) => pure(False),
                    None => repr_of(t).bind(λ rc => match rc {
                        Refused(_) => pure(False),
                        Accepted(r) => view(r).bind(λ rv => match rv {
                            HGlobal(rg, rname, _) => match Known::repr_at(k.reprs, rg.id, 0) {
                                Some(_) => pure(True),
                                None => match k.discover { True => rt_needs_repr(rname, tname), False => pure(False) },
                            },
                            _ => pure(False),
                        }),
                    }),
                },
                _ => pure(False),
            }),
        }),
    }
}

fn Known::any_repr_typed(self k: Known, hs: List<Handle>) → Tac<Bool> {
    match hs {
        Nil => pure(False),
        Cons(h, rest) => k.is_repr_typed(h).bind(λ b => match b { True => pure(True), False => k.any_repr_typed(rest) }),
    }
}

// A type alias (a definition such as `ByteBuffer(n)`, a list of bytes) is
// read as what it stands for, a few definitions deep.
fn Known::ty_within(self k: Known, fuel: Nat, h: Handle) → Tac<Ty> {
    view(h).bind(λ v => match v {
        HGlobal(g, name, args) => match g.id.same(k.nat) {
          True => pure(Count),
          False => match g.id.same(k.bitvec) {
            True => match args {
                Cons(w, _) => rt_literal(w).bind(λ n => pure(Word(n))),
                Nil => rt_refuse("`BitVec` without its width"),
            },
            False => match g.id.same(k.boolean) {
                True => pure(Bit),
                False => match g.id.same(k.list) {
                    // A list of bytes is a byte buffer, its capacity the
                    // setup's to choose; a list of those is a list of lines.
                    True => match args {
                        Cons(a, _) => k.is_byte(a).bind(λ byte => match byte {
                            True => pure(Bytes(0)),
                            False => k.is_bytes(a).bind(λ bytes => match bytes {
                                True => pure(Lines),
                                False => rt_refuse("a list of these has no runtime layout under the reflected fragment"),
                            }),
                        }),
                        Nil => rt_refuse("`List` without its element type"),
                    },
                    False => match Known::rec(k.recs, g.id, 0) {
                        Some(i) => pure(Named(i)),
                        None => repr_of(h).bind(λ c => match c {
                            Accepted(_) => k.repr_ty(h, name),
                            Refused(_) => match fuel {
                                Zero => k.repr_ty(h, name),
                                Succ(f) => whnf(h).bind(λ u => match u {
                                    Accepted(x) => k.ty_within(f, x),
                                    Refused(_) => k.repr_ty(h, name),
                                }),
                            },
                        }),
                    },
                },
            },
          },
        },
        _ => rt_refuse("a type with no runtime layout under the reflected fragment"),
    })
}

fn Known::ty(self k: Known, h: Handle) → Tac<Ty> { k.ty_within(4, h) }

fn Known::ty_of(self k: Known, h: Handle) → Tac<Ty> {
    infer(Hd(h)).bind(λ c => rt_accepted("a node's type", c)).bind(λ t => k.ty(t))
}

// ---------------------------------------------------------------------------
// The reflection state: the variables bound so far (parameters, arm
// payloads that are read, and lets), the current block's lets, the most
// recent first, the values numbered so far, by their nodes with operands as
// levels, and the handles and locals already bound, by level.

// `funs` is the program's functions so far, a `Call`'s index: `Known`'s,
// then each runtime fn the walk found called, in the order it found them.
record RSt { depth: Nat, lets: List<Tm>, memo: List<Pair<Tm, Nat>>, handles: List<Pair<Nat, Nat>>, locals: List<Pair<Nat, Nat>>, funs: List<Nat> }

fn RSt::with_funs(self st: RSt, funs: List<Nat>) → RSt { RSt(st.depth, st.lets, st.memo, st.handles, st.locals, funs) }

fn RSt::with_handles(self st: RSt, handles: List<Pair<Nat, Nat>>) → RSt { RSt(st.depth, st.lets, st.memo, handles, st.locals, st.funs) }

// The local `x` bound to the variable at `level`.
fn RSt::with_local(self st: RSt, x: Nat, level: Nat) → RSt { RSt(st.depth, st.lets, st.memo, st.handles, Cons(Pair(x, level), st.locals), st.funs) }

// The handle `h` bound to the variable at `level`.
fn RSt::binding(self st: RSt, h: Handle, level: Nat) → RSt { st.with_handles(Cons(Pair(h.id, level), st.handles)) }

// The handles in `ids` forgotten: what a term stood for before the
// record changed is not what it stands for after.
fn RSt::forgetting(self st: RSt, ids: List<Nat>) → RSt {
    st.with_handles(st.handles.filter(λ p => match Known::index(ids, p.fst, 0) { Some(_) => False, None => True }))
}

// A level as a de Bruijn index at the current depth.
fn RSt::index(self st: RSt, l: Nat) → Nat { st.depth - Succ(l) }

fn RSt::indices(self st: RSt, ls: List<Nat>) → List<Nat> { ls.map(λ l => st.index(l)) }

// A node whose operands are levels, at the current depth.
fn RSt::at_depth(self st: RSt, t: Tm) → Tm {
    match t {
        Var(l) => Var(st.index(l)),
        Prim(op, args) => Prim(op, st.indices(args)),
        Make(i, args) => Make(i, st.indices(args)),
        Field(i, k, of) => Field(i, k, st.index(of)),
        Call(f, args) => Call(f, st.indices(args)),
        Fold(over, init, step) => Fold(st.index(over), st.index(init), step),
        If(c, yes, no) => If(st.index(c), yes, no),
        IfEq(c, yes, no) => IfEq(st.index(c), yes, no),
        Byte(k, i, length) => Byte(k, st.index(i), st.index(length)),
        _ => t,
    }
}

fn RSt::bind(self st: RSt, t: Tm) → RSt {
    RSt(Succ(st.depth), Cons(t, st.lets), st.memo, st.handles, st.locals, st.funs)
}

fn RSt::level(t: Tm) → Nat { match t { Var(l) => l, _ => 0 } }

// The lets of a block around its result, the earliest outermost.
fn RSt::wrap(lets: List<Tm>, t: Tm) → Tm { lets.foldl(λ acc e => Let(e, acc), t) }

// A node built from levels, as the reflection of `h`: as an operand, a
// variable (bound by a `Let` unless the node is one already, or numbered
// before); otherwise the node at the current depth.
fn RSt::finish(self st: RSt, h: Handle, operand: Bool, node: Tm) → Pair<RSt, Tm> {
    match operand {
        False => Pair(st, st.at_depth(node)),
        True => match node {
            Var(l) => Pair(st, Var(l)),
            _ => match (match node { Lit(_, _) => None, If(_, _, _) => None, IfEq(_, _, _) => None, _ => rt_memo(st.memo, node) }) {
                Some(l) => Pair(RSt(st.depth, st.lets, st.memo, Cons(Pair(h.id, l), st.handles), st.locals, st.funs), Var(l)),
                None => Pair(RSt(Succ(st.depth), Cons(st.at_depth(node), st.lets), Cons(Pair(node, st.depth), st.memo),
                    Cons(Pair(h.id, st.depth), st.handles), st.locals, st.funs), Var(st.depth)),
            },
        },
    }
}

// A node no source handle stands for (a part of a rewriting, `PRotate`'s
// shifts), as a variable: numbered like `finish`'s, bound by a `Let` unless
// an equal node is bound already.
fn RSt::node(self st: RSt, node: Tm) → Pair<RSt, Nat> {
    match (match node { Lit(_, _) => None, _ => rt_memo(st.memo, node) }) {
        Some(l) => Pair(st, l),
        None => Pair(RSt(Succ(st.depth), Cons(st.at_depth(node), st.lets), Cons(Pair(node, st.depth), st.memo),
            st.handles, st.locals, st.funs), st.depth),
    }
}

// Each operand reflected as a variable, left to right: their levels.
fn RSt::operands(step: RSt → Handle → Tac<Pair<RSt, Tm>>, st: RSt, hs: List<Handle>) → Tac<Pair<RSt, List<Nat>>> {
    match hs {
        Nil => pure(Pair(st, [])),
        Cons(h, rest) => step(st, h).bind(λ r => RSt::operands(step, r.fst, rest).bind(λ s => pure(Pair(s.fst, Cons(RSt::level(r.snd), s.snd))))),
    }
}

// ---------------------------------------------------------------------------
// The walk. One function, by fuel (a reflection is a `Tac`, not structural
// recursion on a term the reflector holds): `operand` asks for a variable.

// `r.name` for a record the program reads: its table index and the field's
// position.
fn rt_field_names(fs: List<FieldInfo>) → List<String> { fs.map(λ f => f.name) }

// The part of a name after its last `::`.
fn rt_base_chars(cs: List<Char>, acc: List<Char>) → List<Char> {
    match cs {
        Nil => acc.rev(),
        Cons(c, rest) => match c.code.same(58) { True => rt_base_chars(rest, []), False => rt_base_chars(rest, Cons(c, acc)) },
    }
}

fn rt_base_name(name: String) → String { String(rt_base_chars(name.chars, [])) }

// Whether `name` is the member `base` of the vector type (`Vec::at`). The
// host names a global by its last part alone, so this reads the base; each
// caller goes on to require the receiver to be an array field of the record,
// which is what tells `Vec::put` from a record's own `put`.
fn rt_vec_member(name: String, base: String) → Bool { Known::str_same(rt_base_name(name), base) }

// The field `name` of `r` where `r` is a constructor's value of a type
// with one constructor that the program holds neither as a record nor by
// a repr: the field's own term, which is what the read computes to. A
// function of a record that the source updates and reads back
// (`t.count := e; t.count`) elaborates to such reads.
fn rt_field_of_value(k: Known, r: Handle, name: String) → Tac<Option<Handle>> {
    view(r).bind(λ v => match v {
        HCtor(ty, _, _, values) => match Known::rec(k.recs, ty.id, 0) {
            Some(_) => pure(None),
            None => k.is_repr_typed(r).bind(λ held => match held {
                True => pure(None),
                // The value's own type, so a type with parameters
                // (`Mutated<A, B>`, a loop's state) has its constructor.
                False => infer(Hd(r)).bind(λ ct => match ct {
                    Refused(_) => pure(None),
                    Accepted(t) => ctors(t).bind(λ cc => match cc {
                        Refused(_) => pure(None),
                        Accepted(cs) => match cs {
                            Nil => pure(None),
                            Cons(c, more) => match more {
                                Nil => pure(Known::field(rt_field_names(c.fields), rt_base_name(name), 0).and_then(λ pos => values.nth(pos))),
                                Cons(_, _) => pure(None),
                            },
                        },
                    }),
                }),
            }),
        },
        _ => pure(None),
    })
}

fn rt_field_at(f: Nat, k: Known, st: RSt, h: Handle, operand: Bool, r: Handle, name: String,
    step: RSt → Handle → Tac<Pair<RSt, Tm>>) → Tac<Pair<RSt, Tm>>
{
    k.ty_of(r).bind(λ t => match t {
        Named(ri) => infer(Hd(r)).bind(λ c => rt_accepted("a record's type", c)).bind(λ rty =>
            ctors(rty).bind(λ cc => rt_accepted("a record's constructor", cc)).bind(λ cs => match cs {
                Cons(c, _) => match Known::field(rt_field_names(c.fields), name, 0) {
                    Some(pos) => step(st, r).bind(λ rr => pure(rr.fst.finish(h, operand, Field(ri, pos, RSt::level(rr.snd))))),
                    // A function of one record that is not its field.
                    None => rt_unknown(name),
                },
                Nil => rt_refuse("a record with no constructor"),
            })),
        _ => rt_unknown(name),
    })
}

// The term a field of a local stands for, if the setup named one.
fn Known::named_at(named: List<FieldTerm>, x: Nat, field: String) → Option<Handle> {
    match named {
        Nil => None,
        Cons(n, rest) => match n {
            FieldWhole(of, name, term) => match of.same(x) && Known::str_same(name, field) { True => Some(term), False => Known::named_at(rest, x, field) },
            FieldEach(_, _, _) => Known::named_at(rest, x, field),
            FieldNow(_, _) => Known::named_at(rest, x, field),
        },
    }
}

fn Known::elements_at(named: List<FieldTerm>, x: Nat, field: String) → Option<ElementTerm> {
    match named {
        Nil => None,
        Cons(n, rest) => match n {
            FieldWhole(_, _, _) => Known::elements_at(rest, x, field),
            FieldNow(_, _) => Known::elements_at(rest, x, field),
            FieldEach(of, name, each) => match of.same(x) && Known::str_same(name, field) { True => Some(each), False => Known::elements_at(rest, x, field) },
        },
    }
}

// The word element `i` lies at, as a term.
fn ElementTerm::place(self e: ElementTerm, i: Nat) → Tac<Expr> {
    let of_nat <- lookup("BitVec::ofNat").bind(λ c => rt_accepted("`BitVec::ofNat`", c));
    pure(App(App(Global(of_nat), NatLit(64)), NatLit(e.base + i * e.stride)))
}

// The accessor's read of element `i`, and that read at the element's type.
fn ElementTerm::reads(self e: ElementTerm, i: Nat) → Tac<Pair<Handle, Handle>> {
    let at <- e.place(i);
    let read <- next_spelling(App(e.read, at)).bind(λ c => rt_accepted("an accessor's read of an element", c));
    let value <- next_spelling(App(e.narrow, Hd(read))).bind(λ c => rt_accepted("an accessor's read at its element's width", c));
    pure(Pair(read, value))
}

// The accessor's checked read of the element at the word `i`, at the
// element's type.
fn ElementTerm::reads_at(self e: ElementTerm, i: Handle) → Tac<ElementRead> {
    let of_nat <- lookup("BitVec::ofNat").bind(λ c => rt_accepted("`BitVec::ofNat`", c));
    let bitvec <- lookup("BitVec").bind(λ c => rt_accepted("`BitVec`", c));
    let word_t <- as_type(App(Global(bitvec), NatLit(64))).bind(λ c => rt_accepted("a word's type", c));
    let x <- assume(Hd(word_t), "index", Some(e.under)).bind(λ c => rt_accepted("an index's local", c));
    let word: Nat → Expr = λ n => App(App(Global(of_nat), NatLit(64)), NatLit(n));
    let read <- next_spelling(App(App(App(e.read_at, word(e.base)), word(e.count)), Local(x.ref))).bind(λ c => rt_accepted("an accessor's read of an element at a word", c));
    let value <- next_spelling(App(e.narrow, Hd(read))).bind(λ c => rt_accepted("an accessor's read at its element's width", c));
    pure(ElementRead(value, Some(Pair(x.ref.id, i))))
}

// The word a term is the `toNat()` of, if it is one.
fn rt_to_nat_of(i: Handle) → Tac<Option<Handle>> {
    view(i).bind(λ v => {
        let word: Option<Handle> = match v {
            HGlobal(_, name, args) => match Known::str_same(rt_base_name(name), "toNat") { True => args.nth(0), False => None },
            _ => None,
        };
        pure(word)
    })
}

// The call whose record a local's fields are now read off, if one has
// been made (`FieldNow`).
fn Known::now_at(named: List<FieldTerm>) → Option<Pair<Nat, Handle>> {
    match named {
        Nil => None,
        Cons(n, rest) => match n { FieldNow(of, call) => Some(Pair(of, call)), _ => Known::now_at(rest) },
    }
}

// A term read as a field of a record: the record and the field's name.
fn rt_field_read(h: Handle) → Tac<Option<Pair<Handle, String>>> {
    let v <- view(h);
    let read: Option<Pair<Handle, String>> = match v {
        HGlobal(_, name, args) => match args {
            Nil => None,
            Cons(r, more) => match more { Nil => Some(Pair(r, name)), Cons(_, _) => None },
        },
        HField(r, name, args) => match args { Nil => Some(Pair(r, name)), Cons(_, _) => None },
        _ => None,
    };
    pure(read)
}

// Whether `r` is what `call` left: `call.after`, at that call or a copy
// of it (the elaborator repeats a call wherever its record is read).
fn rt_after_of(r: Handle, call: Handle) → Tac<Bool> {
    rt_field_read(r).bind(λ read => match read {
        None => pure(False),
        Some(p) => match Known::str_same(rt_base_name(p.snd), "after") {
            False => pure(False),
            True => match p.fst.id.same(call.id) { True => pure(True), False => defeq(Hd(p.fst), Hd(call)) },
        },
    })
}

fn rt_record_before<A>() → Tac<A> {
    rt_refuse("a field of the record as it was before a call of another function of the record, which the walk did not read before the call (a read under a `match` that is a value): the code reads the record as it is")
}

// The local whose named fields a record term's fields stand for: the
// local itself while no call has changed the record, and what the last
// call left once one has.
fn rt_named_record(k: Known, r: Handle) → Tac<Option<Nat>> {
    match k.named {
        Nil => pure(None),
        Cons(_, _) => view(r).bind(λ v => {
            let local: Option<Nat> = match v { HLocal(x, args) => match args { Nil => Some(x.id), Cons(_, _) => None }, _ => None };
            match Known::now_at(k.named) {
                None => pure(local),
                Some(now) => match local {
                    Some(x) => match x.same(now.fst) { True => rt_record_before(), False => pure(local) },
                    None => rt_after_of(r, now.snd).bind(λ is => {
                        let found: Option<Nat> = match is { True => Some(now.fst), False => None };
                        pure(found)
                    }),
                },
            }
        }),
    }
}

// A term that is a field of a record with named fields, by the local the
// record stands for and the field's name.
fn rt_field_of_local(k: Known, h: Handle) → Tac<Option<Pair<Nat, String>>> {
    rt_field_read(h).bind(λ read => match read {
        None => pure(None),
        Some(p) => rt_named_record(k, p.fst).bind(λ x => pure(x.map(λ id => Pair(id, rt_base_name(p.snd))))),
    })
}

// An element of an array field the setup named, read at an index that is
// a word: `vector_get(x.f, i.toNat(), 0)` stands for the accessor's
// checked read of the array at `i`.
fn rt_element_at(k: Known, args: List<Handle>) → Tac<Option<ElementRead>> {
    match args.nth(0) {
        None => pure(None),
        Some(v) => match args.nth(1) {
            None => pure(None),
            Some(i) => match args.nth(2) {
                None => pure(None),
                Some(pad) => rt_field_of_local(k, v).bind(λ field => match field {
                    None => pure(None),
                    Some(p) => match Known::elements_at(k.named, p.fst, p.snd) {
                        None => pure(None),
                        Some(e) => rt_refuse("an element of the array field `" ++ p.snd ++ "` by `vector_get`, which answers a value past the end: write `t." ++ p.snd ++ ".at(i)` at a word `i`, whose proof that it is inside is found where it is called, or `vector_index` at a literal"),
                    },
                }),
            },
        },
    }
}

// An element of an array field the setup named, read at an index that is
// a word: `x.f.at(i, _)` (`Vec::at`) stands for the accessor's read of the
// array at `i`. The proof that `i` is inside is the source's and is not
// read here.
fn rt_element_word(k: Known, args: List<Handle>) → Tac<Option<ElementRead>> {
    match args.nth(0) {
        None => pure(None),
        Some(v) => match args.nth(1) {
            None => pure(None),
            Some(i) => rt_field_of_local(k, v).bind(λ field => match field {
                None => pure(None),
                Some(p) => match Known::elements_at(k.named, p.fst, p.snd) {
                    None => pure(None),
                    Some(e) => e.reads_at(i).bind(λ r => pure(Some(r))),
                },
            }),
        },
    }
}

// An element of an array field the setup named, read at a literal index:
// `vector_index(x.f, i, _)` stands for the accessor's read where element
// `i` lies.
fn rt_element(k: Known, name: String, args: List<Handle>) → Tac<Option<ElementRead>> {
    match k.named {
        Nil => pure(None),
        Cons(_, _) => match Known::str_same(rt_base_name(name), "vector_index") {
            False => match rt_vec_member(name, "at") {
                True => rt_element_word(k, args),
                False => match Known::str_same(rt_base_name(name), "vector_get") { False => pure(None), True => rt_element_at(k, args) },
            },
            True => match args.nth(0) {
                None => pure(None),
                Some(v) => match args.nth(1) {
                    None => pure(None),
                    Some(i) => rt_field_of_local(k, v).bind(λ field => match field {
                        None => pure(None),
                        Some(p) => match Known::elements_at(k.named, p.fst, p.snd) {
                            None => pure(None),
                            Some(e) => rt_literal(i).bind(λ n => match Succ(n).leb(e.count) {
                                False => rt_refuse("element " ++ decimal_name(Succ(n), n) ++ " of the array field `" ++ p.snd ++ "`, which has fewer"),
                                True => e.reads(n).bind(λ r => pure(Some(ElementRead(r.snd, None)))),
                            }),
                        },
                    }),
                },
            },
        },
    }
}

fn rt_field_named(k: Known, r: Handle, name: String) → Tac<Option<Handle>> {
    rt_named_record(k, r).bind(λ x => pure(x.and_then(λ id => Known::named_at(k.named, id, rt_base_name(name)))))
}

// A record that is a field of a local whose fields name terms (a loop's
// state, `z.value`, rt_io_reflect_loop): the term, which is the record
// written out, so a read of its field is the field's term. A record nested
// in it (`z.value.value`, a state of three locals) is its field of that
// term written out.
fn rt_settle_named_in(fuel: Nat, k: Known, r: Handle) → Tac<Handle> {
    match fuel {
        Zero => pure(r),
        Succ(f) => rt_field_read(r).bind(λ read => match read {
            None => pure(r),
            Some(p) => view(p.fst).bind(λ bv => match bv {
                HLocal(x, xs) => match xs {
                    Nil => pure(Known::named_at(k.named, x.id, rt_base_name(p.snd)).unwrap_or(r)),
                    Cons(_, _) => pure(r),
                },
                _ => rt_settle_named_in(f, k, p.fst).bind(λ inner => match inner.id.same(p.fst.id) {
                    True => pure(r),
                    False => rt_field_of_value(k, inner, p.snd).bind(λ v => pure(v.unwrap_or(r))),
                }),
            }),
        }),
    }
}

fn rt_settle_named(k: Known, r: Handle) → Tac<Handle> {
    match k.named {
        Nil => pure(r),
        Cons(_, _) => rt_settle_named_in(16, k, r),
    }
}

fn rt_field(f: Nat, k: Known, st: RSt, h: Handle, operand: Bool, r: Handle, name: String,
    step: RSt → Handle → Tac<Pair<RSt, Tm>>) → Tac<Pair<RSt, Tm>>
{
    rt_field_named(k, r, name).bind(λ named => match named {
        // A named term is one term for a field whatever record the span
        // holds, so nothing inside it is kept by its handle: only the term
        // itself, which a walk that changes the record forgets
        // (`RSt::forgetting`), and the read as the body has it, which is a
        // read of that record and stays what it was.
        Some(e) => match rt_assoc(st.handles, e.id) {
            Some(l) => pure(st.binding(h, l).finish(h, operand, Var(l))),
            None => step(st.with_handles([]), e).bind(λ rr => {
                let back = rr.fst.with_handles(st.handles);
                let kept = match rr.snd { Var(l) => back.binding(e, l).binding(h, l), _ => back };
                pure(kept.finish(h, operand, rr.snd))
            }),
        },
        None => rt_settle_named(k, r).bind(λ r2 => rt_field_of_value(k, r2, name)).bind(λ value => match value {
            Some(e) => step(st, e).bind(λ rr => pure(rr.fst.finish(h, operand, rr.snd))),
            None => rt_field_at(f, k, st, h, operand, r, name, step),
        }),
    })
}

fn rt_arm_body(m: MatchInfo, a: ArmInfo) → Tac<Handle> {
    open(a.body, "payload").bind(λ c => rt_accepted("a match arm", c)).bind(λ o =>
        match m.args {
            Nil => pure(o.body),
            Cons(_, _) => open(o.body, "equation").bind(λ c2 => rt_accepted("a `match h:` arm", c2)).bind(λ o2 => pure(o2.body)),
        })
}

fn rt_arm(m: MatchInfo, i: Nat) → Tac<Handle> {
    match m.arms.nth(i) { None => rt_refuse("a match without its arms"), Some(a) => rt_arm_body(m, a) }
}

// A `Bool` match's `True` and `False` arms, both under the one local the
// `True` arm's payload is opened at, so that a term of one arm can be
// compared with a term of the other (`Defeq` refuses locals of two
// binders).
fn rt_bool_arms(m: MatchInfo) → Tac<Pair<Handle, Handle>> {
    match m.args {
        Cons(_, _) => rt_refuse("an `if h:` over the world is not reflected yet"),
        Nil => match m.arms.nth(1) {
            None => rt_refuse("a match without its arms"),
            Some(yes) => match m.arms.nth(0) {
                None => rt_refuse("a match without its arms"),
                Some(no) => open(yes.body, "payload").bind(λ c => rt_accepted("a match arm", c)).bind(λ o =>
                    next_spelling(App(Hd(no.body), Local(o.local.ref))).bind(λ c2 => rt_accepted("a match arm", c2)).bind(λ n =>
                    pure(Pair(o.body, n)))),
            },
        },
    }
}

// A byte read or write: its operands as variables, its buffer's capacity
// from the buffer's code.
fn rt_bytes_op(k: Known, st: RSt, h: Handle, operand: Bool, name: String, args: List<Handle>, op: Nat → Op,
    step: RSt → Handle → Tac<Pair<RSt, Tm>>) → Tac<Pair<RSt, Tm>>
{
    match args {
        Nil => rt_refuse("`" ++ name ++ "` without its buffer"),
        Cons(xs, _) => k.ty_of(xs).bind(λ t => match t {
            Bytes(c) => RSt::operands(step, st, args).bind(λ r => pure(r.fst.finish(h, operand, Prim(op(c), r.snd)))),
            _ => rt_refuse("`" ++ name ++ "` of something other than a byte buffer"),
        }),
    }
}

// The name `lookup` finds the global `g` by where the tactic runs. A view
// shows a global as a call of it is spelled, which for a member (`fn
// List::poke`, called `span.poke(…)`) is its base name; that one is found
// under its first parameter's type. `shown` where neither is it.
fn rt_name_of(g: GlobalRef, shown: String) → Tac<String> {
    let is_g = λ (c: Checked<GlobalRef>) => match c { Accepted(r) => r.id.same(g.id), Refused(_) => False };
    lookup(shown).bind(λ c => match is_g(c) {
        True => pure(shown),
        False => infer(Global(g)).bind(λ ct => match ct {
            Refused(_) => pure(shown),
            Accepted(t) => view(t).bind(λ v => match v {
                HPi(dom) => view(dom).bind(λ dv => match dv {
                    HGlobal(_, owner, _) => lookup(owner ++ "::" ++ shown).bind(λ c2 => match is_g(c2) {
                        True => pure(owner ++ "::" ++ shown),
                        False => pure(shown),
                    }),
                    _ => pure(shown),
                }),
                _ => pure(shown),
            }),
        }),
    })
}

// The program index of a called global: its place in the functions so far
// or, in the generator's mode, a runtime fn not met before, appended (a
// global `g` is one when `g::rt` is published, which only the `runtime`
// generator does). `None` for anything else.
fn rt_callee(k: Known, st: RSt, g: GlobalRef, name: String) → Tac<Option<Pair<RSt, Nat>>> {
    match Known::index(st.funs, g.id, 0) {
        Some(i) => pure(Some(Pair(st, i))),
        None => match k.discover {
            False => pure(None),
            True => rt_name_of(g, name).bind(λ n => lookup(n ++ "::rt")).bind(λ c => match c {
                Accepted(_) => pure(Some(Pair(st.with_funs(st.funs ++ [g.id]), st.funs.len()))),
                Refused(_) => pure(None),
            }),
        },
    }
}

// A named constant (`Io::stdin()`): a global with no parameters whose body
// is a word literal or a `Bool` is read as that literal, which is its
// δ-reduct. Any other global is a function the program must name.
fn rt_constant(k: Known, g: GlobalRef, name: String) → Tac<Handle> {
    let refused = "`" ++ name ++ "` is an ordinary fn: mark it `runtime fn`, or the setup has no primitive for it";
    body(g).bind(λ c => match c {
        Refused(_) => rt_refuse(refused),
        Accepted(b) => view(b).bind(λ v => match v {
            HGlobal(bg, _, args) => match Known::prim(k.prims, bg.id) {
                Some(p) => match p {
                    POfNat => match args { Cons(n, _) => view(n).bind(λ nv => match nv { HLit(_) => pure(b), _ => rt_refuse(refused) }), Nil => rt_refuse(refused) },
                    _ => rt_refuse(refused),
                },
                None => rt_refuse(refused),
            },
            HCtor(ty, _, _, _) => match ty.id.same(k.boolean) { True => pure(b), False => rt_refuse(refused) },
            _ => rt_refuse(refused),
        }),
    })
}

// ---------------------------------------------------------------------------
// The world of an effectful body (docs/language/effects-capabilities-design.md §8.3).
//
// Each `io.m(…)` on the capability elaborates to one call `m(io_k, …)`, shared
// wherever the body reads it: `.after` is the world the next call takes, and
// `.value` (or a field of it) the answer. The world chain is read from the
// body's final world back to the parameter: that is the call order, and a
// world that is anything but the chain is refused here, at the call.

fn Known::is_world(self k: Known, x: LocalRef) → Bool {
    match k.io { None => False, Some(io) => x.id.same(io.world) }
}

fn IoKnown::is_method(self io: IoKnown, g: GlobalRef) → Bool {
    match Known::index(io.methods, g.id, 0) { Some(_) => True, None => False }
}

fn IoKnown::is_lent(self io: IoKnown, g: GlobalRef) → Bool {
    match Known::index(io.lends, g.id, 0) { Some(_) => True, None => False }
}

// Which of a joined record's `n` locals a read of it reads (`Arms`'
// `path`): field 1 (`.value`) `i` times, then field 0 (`.after`) for the
// `i`-th of all but the last, or nothing for the last; `None` for a read
// that stops inside the record.
fn rt_stage_part(n: Nat, i: Nat, path: List<Nat>) → Option<Nat> {
    match path {
        Nil => match Succ(i).same(n) { True => Some(i), False => None },
        Cons(j, rest) => match j {
            Zero => match rest { Nil => match Succ(Succ(i)).leb(n) { True => Some(i), False => None }, Cons(_, _) => None },
            Succ(_) => rt_stage_part(n, Succ(i), rest),
        },
    }
}

// The term an arm of the `match` gives the local a read reads: the arm ends
// in its locals written out, `Mutated(io, Mutated(k, s))`.
fn rt_stage_follow(h: Handle, path: List<Nat>) → Tac<Handle> {
    match path {
        Nil => pure(h),
        Cons(j, rest) => view(h).bind(λ v => match v {
            HCtor(_, _, _, fields) => match fields.nth(j) {
                Some(x) => rt_stage_follow(x, rest),
                None => rt_refuse("an `if`'s arm whose locals are not all written out"),
            },
            _ => rt_refuse("an `if`'s arm that does not end in the locals it assigns written out"),
        }),
    }
}

// The longest run two worlds' calls start with: the calls before an `if`
// whose arms are the two.
fn rt_common(ys: List<Handle>, ns: List<Handle>) → Tac<List<Handle>> {
    match ys {
        Nil => pure([]),
        Cons(y, yr) => match ns {
            Nil => pure([]),
            Cons(n, nr) => (match y.id.same(n.id) { True => pure(True), False => defeq(Hd(y), Hd(n)) }).bind(λ same => match same {
                True => rt_common(yr, nr).bind(λ rest => pure(Cons(y, rest))),
                False => pure([]),
            }),
        },
    }
}

fn rt_same_handle(a: Handle, b: Handle) → Tac<Bool> {
    match a.id.same(b.id) { True => pure(True), False => defeq(Hd(a), Hd(b)) }
}

// Whether two reads are of one `match`: one scrutinee, and the same arms.
fn rt_same_match(m: MatchInfo, n: MatchInfo) → Tac<Bool> {
    match m.arms {
        Cons(m0, mr) => match mr {
            Cons(m1, _) => match n.arms {
                Cons(n0, nr) => match nr {
                    Cons(n1, _) => rt_same_handle(m.scrut, n.scrut).bind(λ s => match s {
                        False => pure(False),
                        True => rt_same_handle(m0.body, n0.body).bind(λ s0 => match s0 {
                            False => pure(False),
                            True => rt_same_handle(m1.body, n1.body),
                        }),
                    }),
                    Nil => pure(False),
                },
                Nil => pure(False),
            },
            Nil => pure(False),
        },
        Nil => pure(False),
    }
}

// The `if` the walk has made that `m` reads (the elaborator repeats the
// `match` wherever a local of it is read).
fn rt_if_made(ifs: List<IfRes>, m: MatchInfo) → Tac<Option<IfRes>> {
    match ifs {
        Nil => pure(None),
        Cons(r, rest) => rt_same_match(r.stage, m).bind(λ same => match same {
            True => pure(Some(r)),
            False => rt_if_made(rest, m),
        }),
    }
}

// A read of a local an `if` the walk has made assigned: its variable after
// the `if` (`None` for the world), or `None` when `h` is no such read.
fn rt_if_read(io: IoKnown, h: Handle) → Tac<Option<Option<Nat>>> {
    match io.ifs {
        Nil => pure(None),
        Cons(_, _) => arms(h).bind(λ c => match c {
            Refused(_) => pure(None),
            Accepted(m) => match m.path {
                Nil => pure(None),
                Cons(_, _) => rt_if_made(io.ifs, m).bind(λ made => match made {
                    None => pure(None),
                    Some(r) => pure(match rt_stage_part(r.parts.len(), 0, m.path) { Some(i) => r.parts.nth(i), None => None }),
                }),
            },
        }),
    }
}

// In effectful code, a read of a local an `if` the walk has made assigned.
fn rt_if_local(k: Known, h: Handle) → Tac<Option<Option<Nat>>> {
    match k.io { None => pure(None), Some(io) => rt_if_read(io, h) }
}

// The calls a world has been through, the first first: the parameter has
// been through none, and `m(w, …).after` through `w`'s and then `m`. A
// world an `if` joined (`#stage.after`) has been through the calls before
// the `if`, the run both arms' worlds start with, and then the `if`, whose
// `match` stands in the list for it (`rt_if_make` reads its arms).
fn rt_world_calls(fuel: Nat, io: IoKnown, w: Handle) → Tac<List<Handle>> {
    match fuel {
        Zero => rt_refuse("the world's chain of calls is longer than the reflector's fuel"),
        Succ(f) => view(w).bind(λ v => match v {
            HMatch(_) => {
                let m <- arms(w).bind(λ c => rt_accepted("an `if` over the world", c));
                let both <- rt_bool_arms(m);
                let yw <- rt_stage_follow(both.fst, m.path);
                let nw <- rt_stage_follow(both.snd, m.path);
                let yc <- rt_world_calls(f, io, yw);
                let nc <- rt_world_calls(f, io, nw);
                let before <- rt_common(yc, nc);
                pure(before ++ [w])
            },
            HLocal(x, _) => match x.id.same(io.world) {
                True => pure([]),
                False => rt_refuse("a world that is not the capability `io`"),
            },
            HField(c, name, _) => match Known::str_same(name, "after") {
                True => view(c).bind(λ cv => match cv {
                    // The world of a loop's state (`z.after`, where the
                    // world is the state `z`, rt_io_reflect_loop): where
                    // the pass's chain starts.
                    HLocal(x, _) => match x.id.same(io.world) {
                        True => pure([]),
                        False => rt_refuse("a world read out of a record that is not the loop's state"),
                    },
                    HGlobal(g, cname, args) => match io.is_method(g) {
                        True => match args {
                            Cons(prev, _) => rt_world_calls(f, io, prev).bind(λ cs => pure(cs ++ [c])),
                            Nil => rt_refuse("`" ++ cname ++ "` without its world"),
                        },
                        False => rt_refuse("`" ++ cname ++ "` is not a call on Linux the reflector knows (`Io::read_into`, `Io::write_from`, `Io::open_path`, `Io::close_fd`)"),
                    },
                    _ => rt_refuse("the world after something other than a call on Linux"),
                }),
                False => rt_refuse("a world read out of a record (`." ++ name ++ "`)"),
            },
            _ => rt_refuse("a world that is not the capability threaded through calls"),
        }),
    }
}

fn rt_call_by_handle(cs: List<CallRes>, id: Nat) → Option<CallRes> {
    match cs { Nil => None, Cons(c, rest) => match c.call.id.same(id) { True => Some(c), False => rt_call_by_handle(rest, id) } }
}

fn rt_call_at(cs: List<CallRes>, pos: Nat) → Option<CallRes> {
    match cs { Nil => None, Cons(c, rest) => match c.pos.same(pos) { True => Some(c), False => rt_call_at(rest, pos) } }
}

fn rt_answer_field(fs: List<Pair<String, Nat>>, name: String) → Option<Nat> {
    match fs { Nil => None, Cons(p, rest) => match Known::str_same(p.fst, name) { True => Some(p.snd), False => rt_answer_field(rest, name) } }
}

// Whether `r` is a call on Linux.
fn rt_call_of(io: IoKnown, r: Handle) → Tac<Bool> {
    view(r).bind(λ v => match v { HGlobal(g, _, _) => pure(io.is_method(g)), _ => pure(False) })
}

// The call a read of an answer names, among the calls made so far: the
// same handle, or a copy of the call at its world's place on the chain. A
// call on a world the chain does not continue (a copied `io`, or a call
// whose world after is dropped) is another program, refused here.
fn rt_answer(fuel: Nat, io: IoKnown, c: Handle) → Tac<CallRes> {
    match rt_call_by_handle(io.calls, c.id) {
        Some(a) => pure(a),
        None => view(c).bind(λ v => match v {
            HGlobal(g, name, args) => match args {
                Cons(w, _) => rt_world_calls(fuel, io, w).bind(λ before =>
                    match rt_call_at(io.calls, before.len()) {
                        Some(a) => match a.method.same(g.id) {
                            True => defeq(Hd(c), Hd(a.call)).bind(λ same => match same {
                                True => pure(a),
                                False => rt_refuse("`" ++ name ++ "` answers a call the body does not thread its world through (a copy of `io`, or a call whose world after is dropped)"),
                            }),
                            False => rt_refuse("`" ++ name ++ "` answers a call the body does not thread its world through (a copy of `io`, or a call whose world after is dropped)"),
                        },
                        None => rt_refuse("`" ++ name ++ "` answers a call the body does not thread its world through (a copy of `io`, or a call whose world after is dropped)"),
                    }),
                Nil => rt_refuse("`" ++ name ++ "` without its world"),
            },
            _ => rt_refuse("an answer of something other than a call on Linux"),
        }),
    }
}

// The call that wrote the span which `r` is, among those made so far: the
// same handle, or a copy of one (the elaborator repeats a call wherever
// its record is read).
fn rt_file_answer_in(cs: List<CallRes>, g: Nat, r: Handle) → Tac<Option<CallRes>> {
    match cs {
        Nil => pure(None),
        Cons(c, rest) => match c.method.same(g) {
            False => rt_file_answer_in(rest, g, r),
            True => defeq(Hd(r), Hd(c.call)).bind(λ same => match same { True => pure(Some(c)), False => rt_file_answer_in(rest, g, r) }),
        },
    }
}

// The call of a lent function `r` names among those made so far: the same
// handle, or a copy of one (the elaborator repeats a call wherever its
// record is read).
fn rt_lent_answer(io: IoKnown, r: Handle) → Tac<Option<CallRes>> {
    match rt_call_by_handle(io.lent, r.id) {
        Some(a) => pure(Some(a)),
        None => view(r).bind(λ v => match v { HGlobal(g, _, _) => rt_file_answer_in(io.lent, g.id, r), _ => pure(None) }),
    }
}

fn rt_file_answer(fk: FileKnown, r: Handle) → Tac<Option<CallRes>> {
    match rt_call_by_handle(fk.calls, r.id) {
        Some(a) => pure(Some(a)),
        None => view(r).bind(λ v => match v { HGlobal(g, _, _) => rt_file_answer_in(fk.calls, g.id, r), _ => pure(None) }),
    }
}

// A field read. In effectful code, the answer of a call is the variables its
// `Invoke` bound, and the world after a call is never a value; anything else
// is an ordinary record's field.
fn rt_read(f: Nat, k: Known, st: RSt, h: Handle, operand: Bool, r: Handle, name: String,
    step: RSt → Handle → Tac<Pair<RSt, Tm>>) → Tac<Pair<RSt, Tm>>
{
    match k.io {
        None => match k.file {
            None => rt_field(f, k, st, h, operand, r, name, step),
            Some(fk) => rt_file_answer(fk, r).bind(λ found => match found {
                None => rt_field(f, k, st, h, operand, r, name, step),
                Some(a) => match Known::str_same(name, "value") {
                    True => match a.value {
                        Some(l) => pure(st.finish(h, operand, Var(l))),
                        None => rt_refuse("a call's whole answer used as one value"),
                    },
                    False => rt_refuse("the span after a call used as a value: it is threaded on to the next store or call, never runtime data"),
                },
            }),
        },
        Some(io) => rt_call_of(io, r).bind(λ direct => match direct {
            True => match Known::str_same(name, "after") {
                True => rt_refuse("the world after a call used as a value: it is threaded on to the next call, never runtime data"),
                False => rt_answer(f, io, r).bind(λ a => match a.value {
                    Some(l) => pure(st.finish(h, operand, Var(l))),
                    None => rt_refuse("a call's whole answer used as one value: read its fields"),
                }),
            },
            False => view(r).bind(λ rv => match rv {
                // A field of a lent function's answer: a variable its `Lend`
                // bound, once the call is made (`rt_lend_calls`).
                HGlobal(g, gname, _) => match io.is_lent(g) {
                    True => rt_lent_answer(io, r).bind(λ found => match found {
                        Some(a) => match rt_answer_field(a.fields, rt_base_name(name)) {
                            Some(l) => pure(st.finish(h, operand, Var(l))),
                            None => rt_refuse("`" ++ name ++ "` is not a field of `" ++ gname ++ "`'s answer: its bytes `after` and its word `value`"),
                        },
                        None => rt_refuse("an answer of `" ++ gname ++ "` read where the call is not made: a lent function is called where a call on Linux, a loop's pass or the end needs its answer"),
                    }),
                    False => rt_field(f, k, st, h, operand, r, name, step),
                },
                HLocal(x, _) => match x.id.same(io.world) {
                    // A loop's state holds the world and the locals; a read
                    // of one of its locals names a term (`k.named`).
                    True => match Known::named_at(k.named, x.id, rt_base_name(name)) {
                        Some(_) => match Known::str_same(name, "after") {
                            True => rt_refuse("the world after a loop's pass used as a value: it is threaded on to the next call, never runtime data"),
                            False => rt_field(f, k, st, h, operand, r, name, step),
                        },
                        None => rt_refuse("the world `io` used as a value: it is threaded through calls, never runtime data"),
                    },
                    False => rt_field(f, k, st, h, operand, r, name, step),
                },
                HField(c, inner, _) => match Known::str_same(inner, "value") {
                    True => rt_call_of(io, c).bind(λ called => match called {
                        True => rt_answer(f, io, c).bind(λ a => match rt_answer_field(a.fields, name) {
                            Some(l) => pure(st.finish(h, operand, Var(l))),
                            None => rt_refuse("`" ++ name ++ "` is not a field of the call's answer"),
                        }),
                        False => rt_field(f, k, st, h, operand, r, name, step),
                    }),
                    False => rt_field(f, k, st, h, operand, r, name, step),
                },
                _ => rt_field(f, k, st, h, operand, r, name, step),
            }),
        }),
    }
}

// A local: a variable bound so far, else refused with why.
fn rt_local(k: Known, st: RSt, h: Handle, operand: Bool, x: LocalRef, args: List<Handle>) → Tac<Pair<RSt, Tm>> {
    match args {
        Nil => match rt_assoc(st.locals, x.id) {
            Some(l) => match k.span_of(l) {
                None => pure(st.finish(h, operand, Var(l))),
                Some(_) => rt_refuse("a lent span used as a value: its bytes are read by `byte_within` under its own length word, and a loop passes it on as it is"),
            },
            None => match k.is_world(x) {
                True => rt_refuse("the world `io` used as a value: it is threaded through calls, never runtime data"),
                False => rt_refuse("a local that is not runtime data (a proof, or a match's payload)"),
            },
        },
        Cons(_, _) => rt_refuse("a local applied to arguments (a function value)"),
    }
}

// An arm's λs over the words a `Nat` eliminator's motive generalizes, each
// read as the variable at its level (the words the match is applied to).
fn rt_bind_words(fuel: Nat, st: RSt, b: Handle, levels: List<Nat>) → Tac<Pair<RSt, Handle>> {
    match levels {
        Nil => pure(Pair(st, b)),
        Cons(l, rest) => match fuel {
            Zero => rt_refuse("more words than the reflector's fuel"),
            Succ(f) => open(b, "w").bind(λ c => rt_accepted("a fuel arm's word", c)).bind(λ o =>
                rt_bind_words(f, RSt(st.depth, st.lets, st.memo, st.handles, Cons(Pair(o.local.ref.id, l), st.locals), st.funs), o.body, rest)),
        },
    }
}

fn rt_arm_handle(m: MatchInfo, i: Nat) → Tac<Handle> {
    match m.arms.nth(i) { None => rt_refuse("a match without its arms"), Some(a) => pure(a.body) }
}

// A fuel recursion's body (design §16.11): the kernel's `Nat` eliminator on
// the first parameter, at the top, the words it varies applied. `Case`
// with the `Zero` arm and the `Succ` arm, whose recursion is a call of the
// function itself on the predecessor and the words.
fn rt_fuel_match(f: Nat, k: Known, st: RSt, h: Handle, operand: Bool, m: MatchInfo,
    go: Known → RSt → Handle → Bool → Tac<Pair<RSt, Tm>>) → Tac<Pair<RSt, Tm>>
{
    match operand {
        True => rt_refuse("a `match` on a `Nat` used as a value: only a fuel recursion's body is its fuel's `match`"),
        False => go(k, st, m.scrut, True).bind(λ rc => match RSt::level(rc.snd).same(0) {
            False => rt_refuse("a `match` on a `Nat` that is not the fuel, the first parameter"),
            True => RSt::operands(λ s a => go(k, s, a, True), rc.fst, m.args).bind(λ ra => {
                let st0 = ra.fst;
                let fresh = RSt(st0.depth, [], st0.memo, st0.handles, st0.locals, st0.funs);
                rt_arm_handle(m, 0).bind(λ zh => rt_bind_words(f, fresh, zh, ra.snd).bind(λ zb =>
                go(k, zb.fst, zb.snd, False).bind(λ rz =>
                rt_arm_handle(m, 1).bind(λ sh => open(sh, "k").bind(λ c1 => rt_accepted("the `Succ` arm", c1)).bind(λ ok =>
                open(ok.body, "ih").bind(λ c2 => rt_accepted("the recursion", c2)).bind(λ oih => {
                    let at_k = RSt(Succ(st0.depth), [], st0.memo, st0.handles, Cons(Pair(ok.local.ref.id, st0.depth), st0.locals), rz.fst.funs);
                    let sc = SelfCall(oih.local.ref.id, [st0.depth], List::range(st0.depth).drop(1), ra.snd);
                    rt_bind_words(f, at_k, oih.body, ra.snd).bind(λ sb =>
                    go(k.within(sc), sb.fst, sb.snd, False).bind(λ rs =>
                    pure(Pair(st0.with_funs(rs.fst.funs),
                        Case(st0.index(0), RSt::wrap(rz.fst.lets, rz.snd), RSt::wrap(rs.fst.lets, rs.snd))))))
                }))))))
            }),
        }),
    }
}

// Whether `name` is a field of a repr'd record `r`.
fn Known::is_field_of_repr(self k: Known, r: Handle, name: String) → Tac<Bool> {
    let held <- k.is_repr_typed(r);
    match held {
        False => pure(False),
        True => infer(Hd(r)).bind(λ c => match c {
            Refused(_) => pure(False),
            Accepted(rty) => ctors(rty).bind(λ cc => match cc {
                Accepted(cs) => match cs {
                    Cons(ci, _) => pure(match Known::field(rt_field_names(ci.fields), name, 0) { Some(_) => True, None => False }),
                    Nil => pure(False),
                },
                Refused(_) => pure(False),
            }),
        }),
    }
}

// Whether `g` is an operation of a repr'd type, declared in its spec
// type's namespace (`SInt::add`): `Spec::name` names it. Minus decided
// (2026-11-08) the walk reads only these through their definitions; any
// other function over the type is one the program must mark `runtime fn`.
// One repr's: `Spec::name` is `g`, or `g` is the function the repr's `abs`
// is (`BitVec::as_signed` for `I64`, which builds the type from its word).
fn Known::is_own_op(e: ReprEntry, g: Nat, name: String) → Tac<Bool> {
    let c <- lookup(e.spec ++ "::" ++ name);
    let named = match c { Accepted(r) => r.id.same(g), Refused(_) => False };
    match named {
        True => pure(True),
        False => body(GlobalRef(e.abs)).bind(λ cb => match cb {
            Refused(_) => pure(False),
            Accepted(b) => view(b).bind(λ v => match v { HGlobal(bg, _, _) => pure(bg.id.same(g)), _ => pure(False) }),
        }),
    }
}

fn Known::own_op(rs: List<ReprEntry>, g: Nat, name: String) → Tac<Bool> {
    match rs {
        Nil => pure(False),
        Cons(e, rest) => Known::is_own_op(e, g, name).bind(λ own => match own { True => pure(True), False => Known::own_op(rest, g, name) }),
    }
}

// An operation of a type the program holds by its repr (`SInt::add`, design
// §16.13), read through its definition: its one-step unfolding, which
// builds the record from operations on the carrier's words. `None` for a
// global that touches no repr'd type, a field of one (read as a field), or
// a function outside the type's namespace, which the walk reads as before.
fn rt_transfer(k: Known, g: GlobalRef, h: Handle, name: String, args: List<Handle>) → Tac<Option<Handle>> {
    match k.reprs_on() {
        False => pure(None),
        True => {
            let field <- match args {
                Cons(r, Nil) => k.is_field_of_repr(r, name),
                _ => pure(False),
            };
            match field {
                True => pure(None),
                False => {
                    let touches <- k.any_repr_typed(Cons(h, args));
                    match touches {
                        False => pure(None),
                        True => Known::own_op(k.reprs, g.id, name).bind(λ own => match own {
                            False => pure(None),
                            True => unfold(h).bind(λ c => match c {
                                Accepted(u) => pure(Some(u)),
                                Refused(why) => rt_refuse("`" ++ name ++ "` on a type held by its repr could not be read through its definition: " ++ why),
                            }),
                        }),
                    }
                },
            }
        },
    }
}

// Whether `h` is the written span as it is now.
fn rt_same_span(fk: FileKnown, h: Handle) → Tac<Bool> {
    match fk.now {
        None => view(h).bind(λ v => match v {
            HLocal(x, args) => match args { Nil => pure(x.id.same(fk.span)), Cons(_, _) => pure(False) },
            _ => pure(False),
        }),
        Some(now) => match h.id.same(now.id) { True => pure(True), False => defeq(Hd(h), Hd(now)) },
    }
}

fn rt_file_copy_of(latest: List<Handle>, s: Nat, h: Handle) → Tac<Option<Nat>> {
    match latest {
        Nil => pure(None),
        Cons(l, rest) => defeq(Hd(h), Hd(l)).bind(λ same => match same { True => pure(Some(s)), False => rt_file_copy_of(rest, s - 1, h) }),
    }
}

fn rt_file_link_of(links: List<Handle>, h: Handle) → Tac<Option<Nat>> {
    match Known::index(links.map(λ l => l.id), h.id, 1) {
        Some(s) => pure(Some(s)),
        None => rt_file_copy_of(links.rev(), links.len(), h),
    }
}

// Which of the states `links` reach `h` is: the parameter `span` (state 0),
// or the span after `links[j]` (state `j + 1`), by the same handle or else
// a copy of one, the latest first.
fn rt_file_state_in(span: Nat, links: List<Handle>, h: Handle) → Tac<Option<Nat>> {
    view(h).bind(λ v => match v {
        HLocal(x, args) => match args {
            Nil => pure(match x.id.same(span) { True => Some(0), False => None }),
            Cons(_, _) => pure(None),
        },
        HGlobal(_, _, _) => rt_file_link_of(links, h),
        HField(_, _, _) => rt_file_link_of(links, h),
        _ => pure(None),
    })
}

// Which earlier state of the written span `h` is, if it is one: the
// parameter (state 0) once something has written the span, or a link
// walked before the last.
fn rt_file_was(fk: FileKnown, h: Handle) → Tac<Option<Nat>> {
    match fk.now {
        None => pure(None),
        Some(_) => rt_file_state_in(fk.span, fk.was.take(fk.was.len() - 1), h),
    }
}

// A byte of the written span as it was at state `s`: the variable it was
// bound to before the link that ended the state, found by its index.
fn rt_old_byte(f: Nat, k: Known, fk: FileKnown, st: RSt, h: Handle, operand: Bool, s: Nat, length: Handle, i: Handle,
    step: RSt → Handle → Tac<Pair<RSt, Tm>>) → Tac<Pair<RSt, Tm>> {
    let rl <- step(st, length);
    match RSt::level(rl.snd).same(1) {
        False => rt_refuse("`byte_within` under a word that is not the span's own length parameter"),
        True => {
            let ri <- step(rl.fst, i);
            match OldByte::find(fk.olds, s, RSt::level(ri.snd)) {
                Some(l) => pure(ri.fst.finish(h, operand, Var(l))),
                None => rt_refuse("a byte of the span as it was before a store or a call that wrote it, at an index not known before that store: the byte is read before the store, so its index must be (issues/rt-file-read-before-store.md)"),
            }
        },
    }
}

fn rt_old_span<A>() → Tac<A> {
    rt_refuse("the span as it was before a store or a call that wrote it: a span that is written is one, and code reads its bytes as they are now (a byte read before a store and used after it is read where it is used, which is after: issues/rt-file-read-before-store.md)")
}

// In a computation, the earlier state of the written span `h` is, with
// what the walk knows of the span.
fn rt_was_of(k: Known, h: Handle) → Tac<Option<Pair<FileKnown, Nat>>> {
    match k.file {
        None => pure(None),
        Some(fk) => rt_same_span(fk, h).bind(λ same => match same {
            True => pure(None),
            False => rt_file_was(fk, h).bind(λ was => pure(was.map(λ s => Pair(fk, s)))),
        }),
    }
}

// A span parameter, by number.
fn rt_param_span(k: Known, st: RSt, h: Handle) → Tac<Nat> {
    let v <- view(h);
    let found: Option<Nat> = match v {
        HLocal(x, args) => match args { Nil => rt_assoc(st.locals, x.id).and_then(λ l => k.span_of(l)), Cons(_, _) => None },
        _ => None,
    };
    match found {
        Some(j) => pure(j),
        None => rt_refuse("`byte_within` of bytes that are not a lent span (a leading `List<BitVec(8)>` parameter followed by its length word)"),
    }
}

// The lent span an expression is: a span parameter, by number. In a
// computation the written span is span 0, as it is now.
fn rt_span(k: Known, st: RSt, h: Handle) → Tac<Nat> {
    match k.file {
        // The written span as it is now is span 0. A span the function only
        // reads is its parameter, as in a function that writes none; the
        // written span's own parameter is the span as it was.
        Some(fk) => rt_same_span(fk, h).bind(λ same => match same {
            True => pure(0),
            False => view(h).bind(λ v => {
                let found: Option<Nat> = match v {
                    HLocal(x, args) => match args { Nil => rt_assoc(st.locals, x.id).and_then(λ l => k.span_of(l)), Cons(_, _) => None },
                    _ => None,
                };
                match found.unwrap_or(0) { Zero => rt_old_span(), Succ(j) => pure(Succ(j)) }
            }),
        }),
        None => rt_param_span(k, st, h),
    }
}

// A call's arguments, as variables, where the callee is lent `lent` spans
// (the function itself, or another function lent spans): each span's bytes
// and its length word are passed on as they came in, span `j` as the
// callee's span `j` (a loop keeps a span's home in place, and a call reads
// its callee over the caller's file), and the words after them are
// operands.
fn rt_lent_args(step: RSt → Handle → Tac<Pair<RSt, Tm>>, k: Known, st: RSt, j: Nat, lent: Nat, args: List<Handle>) → Tac<Pair<RSt, List<Nat>>> {
    match lent {
        Zero => RSt::operands(step, st, args),
        Succ(n) => match args {
            Cons(bytes, Cons(length, rest)) => {
                let param: Tac<Nat> = Tac::bind<Head, Nat>(view(bytes), λ v => match v {
                    HLocal(x, more) => match more {
                        Nil => match rt_assoc(st.locals, x.id) { Some(l) => pure(l), None => pure(j + j + 1) },
                        Cons(_, _) => pure(j + j + 1),
                    },
                    _ => pure(j + j + 1),
                });
                // In a computation the span passed is the written one as it
                // is now, wherever the chain stands.
                let passed: Tac<Nat> = match k.file {
                    None => param,
                    Some(fk) => match j { Zero => rt_same_span(fk, bytes).bind(λ same => match same { True => pure(0), False => rt_old_span() }), Succ(_) => param },
                };
                let l <- passed;
                match l.same(j + j).and(Succ(j).leb(k.lent)) {
                    False => rt_refuse("a lent span is passed on as it is, in its own place: the loop keeps its home, and a callee reads the caller's file"),
                    True => step(st, length).bind(λ r => match RSt::level(r.snd).same(j + j + 1) {
                        False => rt_refuse("a lent span's length word is passed on as it is: the loop keeps its home, and a callee reads the caller's file"),
                        True => rt_lent_args(step, k, r.fst, Succ(j), n, rest).bind(λ s => pure(Pair(s.fst, Cons(j + j, Cons(j + j + 1, s.snd))))),
                    }),
                }
            },
            _ => rt_refuse("a call without its span"),
        },
    }
}

// How many spans a call's callee is lent, read off the arguments: its
// leading byte lists, each with the word after it.
fn rt_call_lent(fuel: Nat, k: Known, args: List<Handle>) → Tac<Nat> {
    match fuel {
        Zero => pure(0),
        Succ(f) => match args {
            Cons(bytes, Cons(_, rest)) => infer(Hd(bytes)).bind(λ c => match c {
                Accepted(t) => k.is_bytes(t).bind(λ yes => match yes {
                    True => rt_call_lent(f, k, rest).bind(λ n => pure(Succ(n))),
                    False => pure(0),
                }),
                Refused(_) => pure(0),
            }),
            _ => pure(0),
        },
    }
}

fn rt_go(fuel: Nat, k: Known, st: RSt, h: Handle, operand: Bool) → Tac<Pair<RSt, Tm>> {
    match fuel {
        Zero => rt_refuse("the body is deeper than the reflector's fuel"),
        Succ(f) => match (match operand { True => rt_assoc(st.handles, h.id), False => None }) {
            Some(l) => pure(Pair(st, Var(l))),
            None => Tac::bind<Head, Pair<RSt, Tm>>(view(h), λ v => match v {
                HLocal(x, args) => match k.recursion {
                    Some(sc) => match x.id.same(sc.ih) {
                        True => rt_lent_args(λ s a => rt_go(f, k, s, a, True), k, st, 0, k.lent, args.take(sc.varied.len())).bind(λ r =>
                            pure(r.fst.finish(h, operand, Call(0, sc.call_args(r.snd))))),
                        False => rt_local(k, st, h, operand, x, args),
                    },
                    None => rt_local(k, st, h, operand, x, args),
                },
                HGlobal(g, name, args) => match Known::prim(k.prims, g.id) {
                    Some(p) => match p {
                        PWord(op) => RSt::operands(λ s a => rt_go(f, k, s, a, True), st, args).bind(λ r =>
                            match args {
                                Nil => rt_refuse("`" ++ name ++ "` without its operands"),
                                Cons(a0, _) => k.ty_of(a0).bind(λ t => match t {
                                    Word(w) => pure(r.fst.finish(h, operand, Prim(Known::word_op(op, w), r.snd))),
                                    _ => rt_refuse("`" ++ name ++ "` on something other than a word"),
                                }),
                            }),
                        PConj => RSt::operands(λ s a => rt_go(f, k, s, a, True), st, args).bind(λ r => pure(r.fst.finish(h, operand, Prim(Conj, r.snd)))),
                        PDisj => RSt::operands(λ s a => rt_go(f, k, s, a, True), st, args).bind(λ r => pure(r.fst.finish(h, operand, Prim(Disj, r.snd)))),
                        PNeg => RSt::operands(λ s a => rt_go(f, k, s, a, True), st, args).bind(λ r => pure(r.fst.finish(h, operand, Prim(Neg, r.snd)))),
                        POfNat => match args {
                            Cons(n, _) => rt_literal(n).bind(λ value => k.ty_of(h).bind(λ t => pure(st.finish(h, operand, Lit(t, value))))),
                            Nil => rt_refuse("`BitVec::ofNat` without its numeral"),
                        },
                        PZext => match args {
                            Cons(extra, rest) => rt_literal(extra).bind(λ e => match rest {
                                Cons(x, _) => k.ty_of(x).bind(λ t => match t {
                                    Word(w) => rt_go(f, k, st, x, True).bind(λ r => pure(r.fst.finish(h, operand, Prim(Zext(w, e), [RSt::level(r.snd)])))),
                                    _ => rt_refuse("`zero_extend` of something other than a word"),
                                }),
                                Nil => rt_refuse("`zero_extend` without its operand"),
                            }),
                            Nil => rt_refuse("`zero_extend` without its width"),
                        },
                        // `sign_extend(extra, x)`: the width is a literal, the
                        // operand a word of positive width.
                        PSext => match args {
                            Cons(extra, rest) => rt_literal(extra).bind(λ e => match rest {
                                Cons(x, _) => k.ty_of(x).bind(λ t => match t {
                                    Word(w) => match w {
                                        Succ(n) => rt_go(f, k, st, x, True).bind(λ r => pure(r.fst.finish(h, operand, Prim(Sext(n, e), [RSt::level(r.snd)])))),
                                        Zero => rt_refuse("`sign_extend` of a zero-width word"),
                                    },
                                    _ => rt_refuse("`sign_extend` of something other than a word"),
                                }),
                                Nil => rt_refuse("`sign_extend` without its operand"),
                            }),
                            Nil => rt_refuse("`sign_extend` without its width"),
                        },
                        // `truncate(n, extra, x)`: both widths are literals.
                        PTrunc => match args {
                            Cons(n, rest) => rt_literal(n).bind(λ nv => match rest {
                                Cons(extra, more) => rt_literal(extra).bind(λ e => match more {
                                    Cons(x, _) => rt_go(f, k, st, x, True).bind(λ r => pure(r.fst.finish(h, operand, Prim(Trunc(nv, e), [RSt::level(r.snd)])))),
                                    Nil => rt_refuse("`truncate` without its operand"),
                                }),
                                Nil => rt_refuse("`truncate` without its widths"),
                            }),
                            Nil => rt_refuse("`truncate` without its widths"),
                        },
                        // A shift of a word by a literal count (FunctionIR's
                        // shifts are immediate).
                        PShift(kind) => match args {
                            Cons(x, rest) => match rest {
                                Cons(count, _) => k.ty_of(x).bind(λ t => match t {
                                    Word(w) => rt_literal(count).bind(λ c => rt_go(f, k, st, x, True).bind(λ r =>
                                        pure(r.fst.finish(h, operand, Prim(Known::shift_op(kind, w, c), [RSt::level(r.snd)]))))),
                                    _ => rt_refuse("`" ++ name ++ "` of something other than a word"),
                                }),
                                Nil => rt_refuse("`" ++ name ++ "` without its count"),
                            },
                            Nil => rt_refuse("`" ++ name ++ "` without its operand"),
                        },
                        PToNat => match args {
                            Cons(x, _) => k.ty_of(x).bind(λ t => match t {
                                Word(w) => match w.same(64) {
                                    True => rt_go(f, k, st, x, True).bind(λ r => pure(r.fst.finish(h, operand, Prim(ToNat, [RSt::level(r.snd)])))),
                                    False => rt_refuse("`toNat` of a word that is not 64 bits: a count is held in a 64-bit word"),
                                },
                                _ => rt_refuse("`toNat` of something other than a word"),
                            }),
                            Nil => rt_refuse("`toNat` without its operand"),
                        },
                        // `span.byte_within(length, i)`: a byte of a lent span,
                        // under the span's own length word.
                        PWithin => match args {
                            // Of the written span as it was before a store, the
                            // byte bound before that store.
                            Cons(bytes, Cons(length, Cons(i, Nil))) => rt_was_of(k, bytes).bind(λ was => match was {
                              Some(fs) => rt_old_byte(f, k, fs.fst, st, h, operand, fs.snd, length, i, λ s a => rt_go(f, k, s, a, True)),
                              None => rt_span(k, st, bytes).bind(λ j =>
                                rt_go(f, k, st, length, True).bind(λ rl => match RSt::level(rl.snd).same(j + j + 1) {
                                    False => rt_refuse("`byte_within` under a word that is not the span's own length parameter"),
                                    True => rt_go(f, k, rl.fst, i, True).bind(λ ri =>
                                        pure(ri.fst.finish(h, operand, Byte(j, RSt::level(ri.snd), j + j + 1)))),
                                })),
                            }),
                            _ => rt_refuse("`byte_within` without its span, length word and index"),
                        },
                        // `~x`: all ones, then `all_ones ⊕ x` (the literal on
                        // the left, where `Bool::xor` reads it).
                        PComplement => match args {
                            Cons(x, _) => k.ty_of(x).bind(λ t => match t {
                                Word(w) => rt_go(f, k, st, x, True).bind(λ r => {
                                    let ones = r.fst.node(Lit(Word(w), Nat::pow(2, w) - 1));
                                    pure(ones.fst.finish(h, operand, Prim(Bxor(w), [ones.snd, RSt::level(r.snd)])))
                                }),
                                _ => rt_refuse("`" ++ name ++ "` of something other than a word"),
                            }),
                            Nil => rt_refuse("`" ++ name ++ "` without its operand"),
                        },
                        // `x.rotr(c)` is `x >> c | x << (w - c)`, `x.rotl(c)`
                        // the mirror, the count a literal.
                        PRotate(kind) => match args {
                            Cons(x, Cons(count, _)) => k.ty_of(x).bind(λ t => match t {
                                Word(w) => rt_literal(count).bind(λ c => rt_go(f, k, st, x, True).bind(λ r => {
                                    let first = r.fst.node(Prim(Known::shift_op(1 - kind, w, c), [RSt::level(r.snd)]));
                                    let second = first.fst.node(Prim(Known::shift_op(kind, w, w - c), [RSt::level(r.snd)]));
                                    pure(second.fst.finish(h, operand, Prim(Bor(w), [first.snd, second.snd])))
                                })),
                                _ => rt_refuse("`" ++ name ++ "` of something other than a word"),
                            }),
                            _ => rt_refuse("`" ++ name ++ "` without its operand and count"),
                        },
                        PGet => rt_bytes_op(k, st, h, operand, name, args, λ c => Get(c), λ s a => rt_go(f, k, s, a, True)),
                        PSet => rt_bytes_op(k, st, h, operand, name, args, λ c => Set(c), λ s a => rt_go(f, k, s, a, True)),
                        PFoldl => match args {
                            Cons(over, more) => match more {
                                Cons(step, rest) => match rest {
                                    Cons(init, _) => view(step).bind(λ sv => match sv {
                                        HGlobal(sg, sname, _) => rt_callee(k, st, sg, sname).bind(λ found => match found {
                                            Some(si) => rt_go(f, k, si.fst, over, True).bind(λ r1 => rt_go(f, k, r1.fst, init, True).bind(λ r2 =>
                                                pure(r2.fst.finish(h, operand, Fold(RSt::level(r1.snd), RSt::level(r2.snd), si.snd))))),
                                            None => rt_refuse("a fold's step `" ++ sname ++ "` is not a function of the program: mark it `runtime fn`"),
                                        }),
                                        _ => rt_refuse("a fold's step must be a named function of the program"),
                                    }),
                                    Nil => rt_refuse("`foldl` without its start"),
                                },
                                Nil => rt_refuse("`foldl` without its step"),
                            },
                            Nil => rt_refuse("`foldl` without its list"),
                        },
                    },
                    None => rt_callee(k, st, g, name).bind(λ found => match found {
                        // In the generator's mode a callee may be lent the
                        // caller's spans.
                        Some(si) => (match k.discover { True => rt_call_lent(f, k, args), False => pure(0) }).bind(λ lent =>
                            rt_lent_args(λ s a => rt_go(f, k, s, a, True), k, si.fst, 0, lent, args).bind(λ r =>
                                pure(r.fst.finish(h, operand, Call(si.snd, r.snd))))),
                        None => rt_transfer(k, g, h, name, args).bind(λ moved => match moved {
                            Some(u) => rt_go(f, k, st, u, operand),
                            None => match args {
                                Cons(r, rest) => match rest {
                                    Nil => rt_field(f, k, st, h, operand, r, name, λ s a => rt_go(f, k, s, a, True)),
                                    Cons(_, _) => rt_element(k, name, args).bind(λ element => match element {
                                        Some(u) => {
                                            // An index that is a word is
                                            // computed first, and the
                                            // term's local stands for it.
                                            let indexed: Tac<RSt> = match u.index {
                                                None => pure(st),
                                                Some(ix) => rt_go(f, k, st, ix.snd, True).bind(λ ri => pure(ri.fst.with_local(ix.fst, RSt::level(ri.snd)))),
                                            };
                                            indexed.bind(λ s1 => rt_go(f, k, s1.with_handles([]), u.term, True).bind(λ rr => {
                                                let back = rr.fst.with_handles(s1.handles);
                                                let kept = match rr.snd { Var(l) => back.binding(h, l), _ => back };
                                                pure(kept.finish(h, operand, rr.snd))
                                            }))
                                        },
                                        None => rt_unknown(name),
                                    }),
                                },
                                Nil => rt_constant(k, g, name).bind(λ c => rt_go(f, k, st, c, operand)),
                            },
                        }),
                    }),
                },
                HField(r, name, args) => match args {
                    Nil => rt_read(f, k, st, h, operand, r, name, λ s a => rt_go(f, k, s, a, True)),
                    Cons(_, _) => rt_refuse("a field applied to arguments (a function value)"),
                },
                HCtor(ty, i, name, fields) => match ty.id.same(k.boolean) {
                    True => pure(st.finish(h, operand, Lit(Bit, i))),
                    False => match ty.id.same(k.list) {
                        True => k.ty_of(h).bind(λ lt => match i {
                            // `Nil`: the empty buffer, or the name 0.
                            Zero => pure(st.finish(h, operand, Lit(lt, 0))),
                            Succ(_) => match lt {
                                Lines => match fields.rev() {
                                    Cons(tl, more) => match more {
                                        Cons(hd, _) => k.ty_of(hd).bind(λ ht => match ht {
                                            Bytes(c) => RSt::operands(λ s a => rt_go(f, k, s, a, True), st, [hd, tl]).bind(λ r =>
                                                pure(r.fst.finish(h, operand, Prim(ConsLine(c), r.snd)))),
                                            _ => rt_refuse("a line that is not a byte buffer"),
                                        }),
                                        Nil => rt_refuse("`Cons` without its head"),
                                    },
                                    Nil => rt_refuse("`Cons` without its tail"),
                                },
                                _ => rt_refuse("`Cons` onto a byte buffer: a buffer is written in place (`with_byte`), not consed onto"),
                            },
                        }),
                        False => match Known::rec(k.recs, ty.id, 0) {
                        Some(ri) => RSt::operands(λ s a => rt_go(f, k, s, a, True), st, fields).bind(λ r => pure(r.fst.finish(h, operand, Make(ri, r.snd)))),
                        // A record held by its repr: its code is its type's.
                        None => k.is_repr_typed(h).bind(λ held => match held {
                            True => k.ty_of(h).bind(λ t => match t {
                                Named(ri) => RSt::operands(λ s a => rt_go(f, k, s, a, True), st, fields).bind(λ r => pure(r.fst.finish(h, operand, Make(ri, r.snd)))),
                                _ => rt_refuse("the constructor `" ++ name ++ "` builds a type with no runtime layout under the reflected fragment"),
                            }),
                            False => rt_refuse("the constructor `" ++ name ++ "` builds a type with no runtime layout under the reflected fragment"),
                        }),
                        },
                    },
                },
                HMatch(_) => rt_if_local(k, h).bind(λ joined => match joined {
                  Some(part) => match part {
                    Some(l) => pure(st.finish(h, operand, Var(l))),
                    None => rt_refuse("the world after an `if` used as a value: it is threaded on to the next call, never runtime data"),
                  },
                  None => rt_match("a `match`", h).bind(λ m =>
                    k.ty_of(m.scrut).bind(λ st_ty => match st_ty {
                        Bit => rt_go(f, k, st, m.scrut, True).bind(λ rc =>
                            rt_arm(m, 1).bind(λ yes_h => rt_arm(m, 0).bind(λ no_h =>
                            rt_go(f, k, RSt(rc.fst.depth, [], rc.fst.memo, rc.fst.handles, rc.fst.locals, rc.fst.funs), yes_h, False).bind(λ ry =>
                            rt_go(f, k, RSt(rc.fst.depth, [], rc.fst.memo, rc.fst.handles, rc.fst.locals, ry.fst.funs), no_h, False).bind(λ rn =>
                            pure(rc.fst.with_funs(rn.fst.funs).finish(h, operand, match m.args {
                                Nil => If(RSt::level(rc.snd), RSt::wrap(ry.fst.lets, ry.snd), RSt::wrap(rn.fst.lets, rn.snd)),
                                Cons(_, _) => IfEq(RSt::level(rc.snd), RSt::wrap(ry.fst.lets, ry.snd), RSt::wrap(rn.fst.lets, rn.snd)),
                            }))))))),
                        Count => rt_fuel_match(f, k, st, h, operand, m, λ k2 s a o => rt_go(f, k2, s, a, o)),
                        _ => rt_refuse("a `match` on something other than a `Bool` (enums are not reflected yet)"),
                    })),
                }),
                HLit(_) => rt_refuse("a `Nat` numeral is not runtime data under the reflected fragment"),
                HLam(_) => rt_refuse("a function value is not runtime data under the reflected fragment"),
                // A fuel recursion's `Nat` eliminator applied to the words it
                // varies, which `View` does not present as a `match`.
                _ => arms(h).bind(λ c => match c {
                    Accepted(m) => k.ty_of(m.scrut).bind(λ st_ty => match st_ty {
                        Count => rt_fuel_match(f, k, st, h, operand, m, λ k2 s a o => rt_go(f, k2, s, a, o)),
                        _ => rt_refuse_at("a form the reflected fragment does not have", h),
                    }),
                    // A field read of a record just built, left as the
                    // record's projection: one step on is the field's term.
                    Refused(_) => next_spelling(Hd(h)).bind(λ s => match s {
                        Accepted(u) => rt_go(f, k, st, u, operand),
                        Refused(_) => rt_refuse_at("a form the reflected fragment does not have", h),
                    }),
                }),
            }),
        },
    }
}

// ---------------------------------------------------------------------------
// A function: its parameters (the body's leading `λ`s), its result's code,
// and its body as a term.

fn rt_params(fuel: Nat, k: Known, st: RSt, tys: List<Ty>, b: Handle) → Tac<Pair<Pair<RSt, List<Ty>>, Handle>> {
    match fuel {
        Zero => rt_refuse("more parameters than the reflector's fuel"),
        Succ(f) => view(b).bind(λ v => match v {
            HLam(dom) => k.ty(dom).bind(λ t => open(b, "x").bind(λ c => rt_accepted("a parameter", c)).bind(λ o =>
                rt_params(f, k, RSt(Succ(st.depth), st.lets, st.memo, st.handles, Cons(Pair(o.local.ref.id, st.depth), st.locals), st.funs),
                    tys ++ [t], o.body))),
            _ => pure(Pair(Pair(st, tys), b)),
        }),
    }
}

// The spans a function is lent, read off its parameters' codes: each
// leading byte list followed by a 64-bit word is a span and its length
// word, and its code takes two words for them (where the bytes are, how
// many). Their count, and the codes the function's code takes.
fn rt_lent(tys: List<Ty>) → Pair<Nat, List<Ty>> {
    match tys {
        Nil => Pair(0, tys),
        Cons(bytes, more) => match more {
            Nil => Pair(0, tys),
            Cons(length, rest) => match bytes {
                Bytes(_) => match (match length { Word(w) => w.same(64), _ => False }) {
                    True => { let r = rt_lent(rest); Pair(Succ(r.fst), Cons(Word(64), Cons(Word(64), r.snd))) },
                    False => Pair(0, tys),
                },
                _ => Pair(0, tys),
            },
        },
    }
}

fn rt_has_bytes(tys: List<Ty>) → Bool {
    match tys { Nil => False, Cons(t, rest) => match t { Bytes(_) => True, _ => rt_has_bytes(rest) } }
}

// In the generator's mode a function may be lent spans; any other byte
// list among its parameters is refused here, with what a span is.
fn rt_lend(k: Known, tys: List<Ty>) → Tac<Pair<Nat, List<Ty>>> {
    match k.discover {
        False => pure(Pair(0, tys)),
        True => {
            let r = rt_lent(tys);
            match rt_has_bytes(r.snd) {
                False => pure(r),
                True => rt_refuse("a byte list parameter that is not a lent span: a span comes before the other parameters, each followed by its 64-bit length word"),
            }
        },
    }
}

// A function, and the program's functions after it was walked (`k.funs`
// and the runtime fns it was found to call).
fn rt_reflect_one(fuel: Nat, k: Known, g: Nat) → Tac<Pair<Fun, List<Nat>>> {
    body(GlobalRef(g)).bind(λ c => rt_accepted("its body", c)).bind(λ b =>
    rt_params(fuel, k, RSt(0, [], [], [], [], k.funs), [], b).bind(λ p =>
    rt_lend(k, p.fst.snd).bind(λ lent =>
    k.ty_of(p.snd).bind(λ result =>
    rt_go(fuel, k.lending(lent.fst), p.fst.fst, p.snd, False).bind(λ r =>
    pure(Pair(Fun(lent.snd, result, RSt::wrap(r.fst.lets, r.snd), lent.fst), r.fst.funs)))))))
}

// How many parameters a function type takes.
fn rt_arity(fuel: Nat, t: Handle) → Tac<Nat> {
    match fuel {
        Zero => rt_refuse("more parameters than the reflector's fuel"),
        Succ(f) => view(t).bind(λ v => match v {
            HPi(_) => open(t, "x").bind(λ c => rt_accepted("a parameter", c)).bind(λ o => rt_arity(f, o.body).bind(λ n => pure(Succ(n)))),
            _ => pure(0),
        }),
    }
}

// The first `n` parameters, as `rt_params` reads them.
fn rt_params_n(n: Nat, k: Known, st: RSt, tys: List<Ty>, b: Handle) → Tac<Pair<Pair<RSt, List<Ty>>, Handle>> {
    match n {
        Zero => pure(Pair(Pair(st, tys), b)),
        Succ(m) => view(b).bind(λ v => match v {
            HLam(dom) => k.ty(dom).bind(λ t => open(b, "x").bind(λ c => rt_accepted("a parameter", c)).bind(λ o =>
                rt_params_n(m, k, RSt(Succ(st.depth), st.lets, st.memo, st.handles, Cons(Pair(o.local.ref.id, st.depth), st.locals), st.funs),
                    tys ++ [t], o.body))),
            _ => rt_refuse("a step with fewer parameters than its function"),
        }),
    }
}

// A function that `decreases` (design §16.11), read from its step `f::body`
// (`step`): `λ k g x… h => …`, its words `x…`, its recursion `g(y…, p)` a
// call of the function itself on `y…`. The bound `k` and the proofs are
// read by nothing.
fn rt_reflect_measured(fuel: Nat, k: Known, g: Nat, step: Nat) → Tac<Pair<Fun, List<Nat>>> {
    let n <- infer(Global(GlobalRef(g))).bind(λ c => rt_accepted("its type", c)).bind(λ t => rt_arity(fuel, t));
    let b <- body(GlobalRef(step)).bind(λ c => rt_accepted("its step's body", c));
    let o1 <- open(b, "k").bind(λ c => rt_accepted("its step's bound", c));
    let o2 <- open(o1.body, "g").bind(λ c => rt_accepted("its step's recursion", c));
    let sc = SelfCall(o2.local.ref.id, [], List::range(n), List::range(n));
    let p <- rt_params_n(n, k, RSt(0, [], [], [], [], k.funs), [], o2.body);
    let lent <- rt_lend(k, p.fst.snd);
    let o3 <- open(p.snd, "h").bind(λ c => rt_accepted("its step's measure proof", c));
    let result <- k.ty_of(o3.body);
    let r <- rt_go(fuel, k.within(sc).lending(lent.fst), p.fst.fst, o3.body, False);
    pure(Pair(Fun(lent.snd, result, RSt::wrap(r.fst.lets, r.snd), lent.fst), r.fst.funs))
}

fn rt_reflect_fun(fuel: Nat, k: Known, g: Nat) → Tac<Fun> { rt_reflect_one(fuel, k, g).bind(λ r => pure(r.fst)) }

fn rt_reflect_funs(fuel: Nat, k: Known, gs: List<Nat>) → Tac<List<Fun>> {
    match gs {
        Nil => pure([]),
        Cons(g, rest) => rt_reflect_fun(fuel, k, g).bind(λ f => rt_reflect_funs(fuel, k, rest).bind(λ fs => pure(Cons(f, fs)))),
    }
}

// The primitives the reflector knows, by name, resolved where it runs (the
// caller imports `bitvec`, `bool` and `list`).
fn rt_prim_names() → List<Pair<String, Prim>> {
    [Pair("BitVec::add", PWord(0)), Pair("BitVec::sub", PWord(1)), Pair("BitVec::band", PWord(2)),
     Pair("BitVec::bor", PWord(3)), Pair("BitVec::bxor", PWord(4)), Pair("BitVec::eq_bit", PWord(5)),
     Pair("BitVec::unsigned_lt_bit", PWord(6)), Pair("BitVec::signed_lt_bit", PWord(7)),
     Pair("Bool::and", PConj), Pair("Bool::or", PDisj), Pair("Bool::not", PNeg),
     Pair("BitVec::ofNat", POfNat), Pair("BitVec::zero_extend", PZext), Pair("BitVec::sign_extend", PSext), Pair("List::foldl", PFoldl),
     Pair("List::byte_at", PGet), Pair("List::with_byte", PSet), Pair("BitVec::toNat", PToNat),
     Pair("BitVec::truncate", PTrunc), Pair("BitVec::shift_left", PShift(0)), Pair("BitVec::shift_right", PShift(1)),
     Pair("BitVec::arithmetic_shift_right", PShift(2)), Pair("List::byte_within", PWithin)]
}

// The rewritings among the primitives (`PComplement`, `PRotate`), each
// known where its operation is in scope: a module that does not import
// `bitvec_rotate` has no `rotr` to call.
fn rt_derived_names() → List<Pair<String, Prim>> {
    [Pair("BitVec::complement", PComplement), Pair("BitVec::rotr", PRotate(0)), Pair("BitVec::rotl", PRotate(1))]
}

fn rt_prims_present(ps: List<Pair<String, Prim>>) → Tac<List<PrimEntry>> {
    match ps {
        Nil => pure([]),
        Cons(p, rest) => lookup(p.fst).bind(λ c => rt_prims_present(rest).bind(λ es => match c {
            Accepted(g) => pure(Cons(PrimEntry(g.id, p.snd), es)),
            Refused(_) => pure(es),
        })),
    }
}

fn rt_prims(ps: List<Pair<String, Prim>>) → Tac<List<PrimEntry>> {
    match ps {
        Nil => pure([]),
        Cons(p, rest) => rt_global(p.fst).bind(λ g => rt_prims(rest).bind(λ es => pure(Cons(PrimEntry(g, p.snd), es)))),
    }
}

fn rt_recs(names: List<String>) → Tac<List<RecEntry>> {
    match names {
        Nil => pure([]),
        Cons(n, rest) => rt_global(n).bind(λ g => rt_recs(rest).bind(λ es => pure(Cons(RecEntry(g), es)))),
    }
}

// What the reflector knows, for a program of the functions `funs` (by
// name, in order) reading the records `recs`.
fn rt_known_in(funs: List<String>, recs: List<String>, discover: Bool) → Tac<Known> {
    rt_prims(rt_prim_names()).bind(λ base =>
    rt_prims_present(rt_derived_names()).bind(λ derived =>
    rt_globals(funs).bind(λ gs =>
    rt_recs(recs).bind(λ rs =>
    rt_global("BitVec").bind(λ bv =>
    rt_global("Bool").bind(λ bo =>
    rt_global("List").bind(λ li =>
    rt_global("Nat").bind(λ na =>
    pure(Known(base ++ derived, gs, rs, discover, bv, bo, li, None, na, None, [], 0, None, []))))))))))
}

fn rt_known(funs: List<String>, recs: List<String>) → Tac<Known> { rt_known_in(funs, recs, False) }

// A repr's entry, from its name and its spec type's: its global, `abs`,
// `emb`, and the spec type (`emb`'s domain).
fn rt_repr_entry(rname: String, spec: String) → Tac<ReprEntry> {
    let r <- rt_global(rname);
    let abs <- rt_global(rname ++ "::abs");
    let emb <- rt_global(rname ++ "::emb");
    let et <- infer(Global(GlobalRef(emb))).bind(λ c => rt_accepted("`" ++ rname ++ "::emb`'s type", c));
    let ev <- view(et);
    match ev {
        HPi(dom) => pure(ReprEntry(r, rname, spec, abs, emb, dom)),
        _ => rt_refuse("`" ++ rname ++ "::emb` is not a function"),
    }
}

fn rt_strip(p, cs: List<Char>) → Option<List<Char>> {
    match p {
        Nil => Some(cs),
        Cons(a, pr) => match cs { Nil => None, Cons(c, cr) => match a.code.same(c.code) { True => rt_strip(pr, cr), False => None } },
    }
}

fn rt_split_bar(cs: List<Char>, acc: List<Char>) → Pair<List<Char>, List<Char>> {
    match cs { Nil => Pair(acc, Nil), Cons(c, rest) => match c.code.same(124) { True => Pair(acc, rest), False => rt_split_bar(rest, acc ++ [c]) } }
}

// The repr a walk stopped for, read off its refusal.
fn rt_needed_repr(msg: String) → Option<Pair<String, String>> {
    match rt_strip(("rt: " ++ rt_repr_marker()).chars, msg.chars) {
        None => None,
        Some(rest) => Some(Pair(String(rt_split_bar(rest, []).fst), String(rt_split_bar(rest, []).snd))),
    }
}

// A walk in the generator's mode, the reprs it meets added as it meets
// them: each time it stops for a repr not yet in the table, the repr is
// appended and the walk runs again (at most `fuel` reprs). The `Known`
// returned holds the reprs the run read.
fn rt_with_reprs<A>(fuel: Nat, k: Known, run: Known → Tac<A>) → Tac<Pair<Known, A>> {
    match fuel {
        Zero => rt_refuse("a program of more repr'd types than the reflector reads"),
        Succ(more) => attempt(run(k)).bind(λ o => match o {
            Done(a) => pure(Pair(k, a)),
            Failed(msg, notes) => match rt_needed_repr(msg) {
                None => fail(msg, notes),
                Some(p) => rt_repr_entry(p.fst, p.snd).bind(λ e => rt_with_reprs(more, k.with_reprs(k.reprs ++ [e]), run)),
            },
        }),
    }
}

// The program's functions, reflected from their elaborated bodies.
fn rt_reflect(funs: List<String>, recs: List<String>) → Tac<List<Fun>> {
    rt_known(funs, recs).bind(λ k => rt_reflect_funs(4096, k, k.funs))
}

// ---------------------------------------------------------------------------
// Rendering, for refusals and test failures.

// A numeral up to 255 in decimal, a larger one elided: the value domain's
// division is by steps, so a decimal of a 64-bit literal is out of reach.
fn rt_nat(n: Nat) → String { match n.leb(255) { True => decimal_name(4, n), False => "…" } }

fn rt_nats(ns: List<Nat>) → String {
    match ns { Nil => "", Cons(n, rest) => match rest { Nil => rt_nat(n), Cons(_, _) => rt_nat(n) ++ ", " ++ rt_nats(rest) } }
}

fn Ty::show(self t: Ty) → String {
    match t { Word(w) => "Word(" ++ rt_nat(w) ++ ")", Bit => "Bit", Bytes(c) => "Bytes(" ++ rt_nat(c) ++ ")", Lines => "Lines", Named(i) => "Named(" ++ rt_nat(i) ++ ")", Count => "Count" }
}

fn Ty::shows(ts: List<Ty>) → String {
    match ts { Nil => "", Cons(t, rest) => match rest { Nil => t.show(), Cons(_, _) => t.show() ++ ", " ++ Ty::shows(rest) } }
}

fn Op::show(self o: Op) → String {
    "op" ++ rt_nat(o.code().fst) ++ "(" ++ rt_nat(o.code().snd.fst) ++ ", " ++ rt_nat(o.code().snd.snd) ++ ")"
}

fn Tm::show(self t: Tm) → String {
    match t {
        Var(i) => "Var(" ++ rt_nat(i) ++ ")",
        Lit(c, n) => "Lit(" ++ c.show() ++ ", " ++ rt_nat(n) ++ ")",
        Prim(op, args) => "Prim(" ++ op.show() ++ ", [" ++ rt_nats(args) ++ "])",
        Let(e, body) => "Let(" ++ e.show() ++ ", " ++ body.show() ++ ")",
        If(c, yes, no) => "If(" ++ rt_nat(c) ++ ", " ++ yes.show() ++ ", " ++ no.show() ++ ")",
        IfEq(c, yes, no) => "IfEq(" ++ rt_nat(c) ++ ", " ++ yes.show() ++ ", " ++ no.show() ++ ")",
        Make(i, args) => "Make(" ++ rt_nat(i) ++ ", [" ++ rt_nats(args) ++ "])",
        Field(i, k, of) => "Field(" ++ rt_nat(i) ++ ", " ++ rt_nat(k) ++ ", " ++ rt_nat(of) ++ ")",
        Call(f, args) => "Call(" ++ rt_nat(f) ++ ", [" ++ rt_nats(args) ++ "])",
        Fold(over, init, step) => "Fold(" ++ rt_nat(over) ++ ", " ++ rt_nat(init) ++ ", " ++ rt_nat(step) ++ ")",
        Case(c, zero, succ) => "Case(" ++ rt_nat(c) ++ ", " ++ zero.show() ++ ", " ++ succ.show() ++ ")",
        Byte(k, i, length) => "Byte(" ++ rt_nat(k) ++ ", " ++ rt_nat(i) ++ ", " ++ rt_nat(length) ++ ")",
    }
}

fn Fun::show(self f: Fun) → String {
    "Fun([" ++ Ty::shows(f.params) ++ "], " ++ f.result.show() ++ ", " ++ f.body.show() ++ ", " ++ rt_nat(f.lent) ++ ")"
}

// ---------------------------------------------------------------------------
// The check `lib/_tests` runs: the reflection of the functions `funs`
// (reading the records `recs`) is `expected`, function by function. Proves
// `True`; a difference fails, showing both.

fn rt_compare(got: List<Fun>, expected: List<Fun>) → Tac<Expr> {
    match got {
        Nil => match expected {
            Nil => resolve("trivial").bind(λ c => rt_accepted("`trivial`", c)).bind(λ h => pure(Hd(h))),
            Cons(_, _) => rt_refuse("fewer functions reflected than expected"),
        },
        Cons(g, rest) => match expected {
            Nil => rt_refuse("more functions reflected than expected"),
            Cons(e, more) => match g.same(e) {
                True => rt_compare(rest, more),
                False => rt_refuse("the reflection differs:\n  got      " ++ g.show() ++ "\n  expected " ++ e.show()),
            },
        },
    }
}

fn reflects_as(funs: List<String>, recs: List<String>, expected: List<Fun>) → Tac<Expr> {
    rt_reflect(funs, recs).bind(λ got => rt_compare(got, expected))
}

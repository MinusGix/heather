// Loops over a written span (docs/native/native-one-compiler-design.md §2.6, U4
// step 4c-2): a computation function that calls itself in tail position
// (`FTm::Again`) and `decreases` a measure is one FunctionIR `Loop`, the
// span carried from pass to pass, and its soundness is proved once.
//
// This is `rt_loop`'s measured loop with the file threaded. A pass is the
// body lowered in **tail mode** (`FTm::lower_tail`): every leaf either goes
// round, moving the self-call's arguments to the loop's next ports with the
// flag word 0, or leaves, moving its value to the first of them with the
// flag 1; the stores and the calls on the way are the ones `FTm::lower`
// makes. `FTm::tail_sound` says what a pass runs to, for any continuation
// `again`: `FTm::tail_sem`, the body with its self-call answered by `again`
// on the arguments' words and the span as the pass left it.
//
// The loop theorem (`FFun::measured_sound`) is over the one evaluator
// (`Function::run`): from a bound on the measure and `FFun::Guarded` (the
// body, its recursion answered by anything that agrees with the function
// below the measure, is the function), the loop's code run over any file
// `Cons(own, rest)` answers the function's word and leaves the function's
// span over the rest. The measure may read the span as well as the words.
import logic;
import bool;
import nat;
import list;
import option;
import pair;
import bitvec;
import bitvec_nat;
import nat_map;
import rt;
import rt_lower;
import rt_loop;
import rt_file;
import rt_file_lower;
import function_ir;
import function_ir_eval;
import function_ir_state;
import function_ir_writes;
import function_ir_run;
import function_ir_compile;
import list_window;
import dec_set;
import set_tactic;

// ---------------------------------------------------------------------------
// The tail meaning

// What a self-call is answered with: on the arguments' words and the span
// as it is, the span left and the value at the result's code.
fn FTm::Round(tys: Table, res: Ty) → Type { List<BitVec(64)> → List<BitVec(8)> → Mutated<List<BitVec(8)>, res.sem(tys)> }

// A loop step's meaning at the function's result code `res`: `t` with its
// self-call answered by `again`, the arguments read as the words a call
// passes, and a value it ends in read at `res`. At a closed term it unfolds
// as `FTm::sem` does, so a step's equation with the function's body is a
// conversion.
fn FTm::tail_sem(self t: FTm, fw: FWorld, res: Ty, again: FTm::Round(fw.w.tys, res)) → (g: List<Ty>) → Env(fw.w.tys, g) → List<BitVec(8)>
    → Mutated<List<BitVec(8)>, res.sem(fw.w.tys)> {
    match t {
        Pure(v) => λ g env own => Mutated(own, Ty::cast(fw.w.tys, v.ty(fw.w, g), res, FTm::value(fw, own, v, g, env))),
        Let(e, body) => λ g env own => body.tail_sem(fw, res, again, Cons(e.ty(fw.w, g), g), Pair(FTm::value(fw, own, e, g, env), env), own),
        If(c, yes, no) => λ g env own => match Ty::cast(fw.w.tys, Ty::at(g, c), Bit, Env::get(fw.w.tys, g, env, c)) {
            False => no.tail_sem(fw, res, again, g, env, own),
            True => yes.tail_sem(fw, res, again, g, env, own),
        },
        IfEq(c, yes, no) => λ g env own => Tm::convoy(Mutated<List<BitVec(8)>, res.sem(fw.w.tys)>,
            Ty::cast(fw.w.tys, Ty::at(g, c), Bit, Env::get(fw.w.tys, g, env, c)), yes.tail_sem(fw, res, again, g, env, own),
            no.tail_sem(fw, res, again, g, env, own)),
        Put(i, length, v, body) => λ g env own => body.tail_sem(fw, res, again, g, env, FTm::put(fw.w.tys, g, env, i, length, v, own)),
        Call(f, args, body) => λ g env own => shared(FTm::called(fw, g, env, f, args, own), λ m =>
            body.tail_sem(fw, res, again, Cons(Sig::at(fw.fsigs, f).result, g), Pair(m.value, env), m.after)),
        Again(args) => λ g env own => again(Tm::words(fw.w, g, env, args), own),
        Lend(f, views, args, body) => λ g env own => shared(FTm::lent(fw, g, env, f, views, args, own), λ m =>
            body.tail_sem(fw, res, again, Cons(Sig::at(fw.fsigs, f).result, g), Pair(m.value, env), m.after)),
        Loop(init, test, body, rest) => λ g env own => FTm::bind_at(fw.w.tys, g, Ty::at(g, init),
            FTm::iterated(fw, g, init, test, body.ty(fw.w, fw.fsigs, Cons(Ty::at(g, init), g)), λ e o => body.sem(fw, Cons(Ty::at(g, init), g), e, o), env, own),
            env, λ e o => rest.tail_sem(fw, res, again, Cons(Ty::at(g, init), g), e, o)),
        // A loop node is not a tail pass's (docs/language/loop-combinator-design.md
        // §6.10): its lowering refuses it.
        Node(_, _) => λ g env own => Mutated(own, res.default(fw.w.tys)),
        Next(_, _) => λ g env own => Mutated(own, res.default(fw.w.tys)),
    }
}

// Two continuations that agree go on alike after a loop.
theorem FTm::bind_at_ext<S>(tys: Table, g: List<Ty>, st: Ty, m: Mutated<List<BitVec(8)>, st.sem(tys)>, env: Env(tys, g),
    k1, k2: Env(tys, Cons(st, g)) → List<BitVec(8)> → S, same: (e: Env(tys, Cons(st, g))) → (o: List<BitVec(8)>) → k1(e, o) = k2(e, o)):
    FTm::bind_at(tys, g, st, m, env, k1) = FTm::bind_at(tys, g, st, m, env, k2) {
    same(Pair(m.value, env), m.after)
}

// What follows a loop, read through `f`.
theorem FTm::bind_at_after<S, T>(tys: Table, g: List<Ty>, st: Ty, m: Mutated<List<BitVec(8)>, st.sem(tys)>, env: Env(tys, g),
    k: Env(tys, Cons(st, g)) → List<BitVec(8)> → S, f: S → T):
    FTm::bind_at(tys, g, st, m, env, λ e o => f(k(e, o))) = f(FTm::bind_at(tys, g, st, m, env, k)) { refl }

// A step's meaning reads its recursion only at the calls it makes: two
// recursions that answer alike give one meaning.
theorem FTm::tail_sem_ext(self t: FTm, fw: FWorld, res: Ty, k1, k2: FTm::Round(fw.w.tys, res),
    same: (ys: List<BitVec(64)>) → (o: List<BitVec(8)>) → k1(ys, o) = k2(ys, o)): (g: List<Ty>) → (env: Env(fw.w.tys, g)) → (own: List<BitVec(8)>) →
    t.tail_sem(fw, res, k1, g, env, own) = t.tail_sem(fw, res, k2, g, env, own) {
    match t {
        Pure(_) => λ g env own => refl,
        Let(e, body) => λ g env own =>
            FTm::tail_sem_ext(body, fw, res, k1, k2, same, Cons(e.ty(fw.w, g), g), Pair(FTm::value(fw, own, e, g, env), env), own),
        If(c, yes, no) => λ g env own => match Ty::cast(fw.w.tys, Ty::at(g, c), Bit, Env::get(fw.w.tys, g, env, c)) as λ bit =>
            (match bit { False => no.tail_sem(fw, res, k1, g, env, own), True => yes.tail_sem(fw, res, k1, g, env, own) }) =
                (match bit { False => no.tail_sem(fw, res, k2, g, env, own), True => yes.tail_sem(fw, res, k2, g, env, own) }) {
            False => FTm::tail_sem_ext(no, fw, res, k1, k2, same, g, env, own),
            True => FTm::tail_sem_ext(yes, fw, res, k1, k2, same, g, env, own),
        },
        IfEq(c, yes, no) => λ g env own => eq2(λ (y: Mutated<List<BitVec(8)>, res.sem(fw.w.tys)>) (n: Mutated<List<BitVec(8)>, res.sem(fw.w.tys)>) =>
                Tm::convoy(Mutated<List<BitVec(8)>, res.sem(fw.w.tys)>, Ty::cast(fw.w.tys, Ty::at(g, c), Bit, Env::get(fw.w.tys, g, env, c)), y, n),
            FTm::tail_sem_ext(yes, fw, res, k1, k2, same, g, env, own), FTm::tail_sem_ext(no, fw, res, k1, k2, same, g, env, own)),
        Put(i, length, v, body) => λ g env own => FTm::tail_sem_ext(body, fw, res, k1, k2, same, g, env, FTm::put(fw.w.tys, g, env, i, length, v, own)),
        Call(f, args, body) => λ g env own => FTm::tail_sem_ext(body, fw, res, k1, k2, same, Cons(Sig::at(fw.fsigs, f).result, g),
            Pair(FTm::called(fw, g, env, f, args, own).value, env), FTm::called(fw, g, env, f, args, own).after),
        Again(args) => λ g env own => same(Tm::words(fw.w, g, env, args), own),
        Lend(f, views, args, body) => λ g env own => FTm::tail_sem_ext(body, fw, res, k1, k2, same, Cons(Sig::at(fw.fsigs, f).result, g),
            Pair(FTm::lent(fw, g, env, f, views, args, own).value, env), FTm::lent(fw, g, env, f, views, args, own).after),
        Loop(init, test, body, rest) => λ g env own => FTm::bind_at_ext(fw.w.tys, g, Ty::at(g, init),
            FTm::iterated(fw, g, init, test, body.ty(fw.w, fw.fsigs, Cons(Ty::at(g, init), g)), λ e o => body.sem(fw, Cons(Ty::at(g, init), g), e, o), env, own),
            env, λ e o => rest.tail_sem(fw, res, k1, Cons(Ty::at(g, init), g), e, o), λ e o => rest.tail_sem(fw, res, k2, Cons(Ty::at(g, init), g), e, o),
            λ e o => FTm::tail_sem_ext(rest, fw, res, k1, k2, same, Cons(Ty::at(g, init), g), e, o)),
        Node(_, _) => λ g env own => refl,
        Next(_, _) => λ g env own => refl,
    }
}

// ---------------------------------------------------------------------------
// What a pass leaves

// A file whose spans after the first are `rest`.
fn FTm::Spanned(rest: List<List<BitVec(8)>>, file: Buffers()) → Type { file = Cons(buffer_bytes(file, 0), rest) }

// What a pass leaves for the loop: where the flag is 1 the result, the
// first of `nexts`, and the file; otherwise the continuation on the next
// state (`kept` in place, then `nexts`) and the file (`Tm::leave` with the
// file carried).
fn FTm::leave(end: State, flag: Nat, kept, nexts: List<Nat>, again: List<BitVec(64)> → Buffers() → Ending) → Ending {
    match end.values(64, flag).eq_bit(BitVec::ofNat(1)) {
        False => again(words_of(end.values, kept) ++ words_of(end.values, nexts), end.buffers),
        True => Ending(words_of(end.values, nexts).head_or(BitVec::zero()), end.buffers),
    }
}

// A self-call's answer as the loop's continuation: from the file's first
// span, ending as a computation's code does.
fn FTm::resume(tys: Table, res: Ty, rest: List<List<BitVec(8)>>, again: FTm::Round(tys, res)) → List<BitVec(64)> → Buffers() → Ending {
    λ ys file => FTm::ended(tys, res, rest, again(ys, buffer_bytes(file, 0)))
}

// A pass that ended in `end` took the turn `out`: the file's other spans
// are as they were, and whatever answers the self-call, what the pass
// leaves is what `out` ends in.
fn FTm::Turn(tys: Table, res: Ty, rest: List<List<BitVec(8)>>, flag: Nat, kept, nexts: List<Nat>, end: State,
    out: FTm::Round(tys, res) → Mutated<List<BitVec(8)>, res.sem(tys)>) → Type {
    FTm::Spanned(rest, end.buffers) ∧ ((again: FTm::Round(tys, res)) →
        FTm::leave(end, flag, kept, nexts, FTm::resume(tys, res, rest, again)) = FTm::ended(tys, res, rest, out(again)))
}

// A region that ran to `mid`, then a pass from there.
theorem FTm::turn_after(tys: Table, res: Ty, rest: List<List<BitVec(8)>>, flag: Nat, kept, nexts: List<Nat>, pre, post: StructuredRegion,
    call: Writers(), values: Valuation(), file: Buffers(), mid: State, out: FTm::Round(tys, res) → Mutated<List<BitVec(8)>, res.sem(tys)>,
    at: pre.run(call, values, file) = mid, then: FTm::Turn(tys, res, rest, flag, kept, nexts, post.run(call, mid.values, mid.buffers), out)):
    FTm::Turn(tys, res, rest, flag, kept, nexts, Compose(pre, post).run(call, values, file), out) {
    j(sym(at), λ s _ => FTm::Turn(tys, res, rest, flag, kept, nexts, post.run(call, s.values, s.buffers), out), then)
}

// A branch's pass is the arm's the bit chooses.
theorem FTm::turn_branch(tys: Table, res: Ty, rest: List<List<BitVec(8)>>, flag: Nat, kept, nexts: List<Nat>, values: Valuation(),
    condition: Nat, outputs: Ports, when_true, when_false: StructuredRegion, call: Writers(), file: Buffers(), b: Bool,
    yes, no: FTm::Round(tys, res) → Mutated<List<BitVec(8)>, res.sem(tys)>, h: values(1, condition).head_bit() = b,
    turn_true: FTm::Turn(tys, res, rest, flag, kept, nexts, when_true.run(call, values, file), yes),
    turn_false: FTm::Turn(tys, res, rest, flag, kept, nexts, when_false.run(call, values, file), no)):
    FTm::Turn(tys, res, rest, flag, kept, nexts, branch(condition, outputs, when_true, when_false).run(call, values, file),
        λ again => match b { False => no(again), True => yes(again) }) {
    let on = when_true.run(call, values, file);
    let off = when_false.run(call, values, file);
    let chosen = λ (x: Bool) => State(λ w id => match x { False => off.values(w, id), True => on.values(w, id) },
        match x { False => off.buffers, True => on.buffers });
    j(sym(h), λ x _ => FTm::Turn(tys, res, rest, flag, kept, nexts, chosen(x), λ again => match b { False => no(again), True => yes(again) }),
        match b as λ x => FTm::Turn(tys, res, rest, flag, kept, nexts, chosen(x), λ again => match x { False => no(again), True => yes(again) }) {
            False => turn_false,
            True => turn_true,
        })
}

// What a lowered pass promises, whatever it is a pass of: over any file
// `Cons(own, rest)`, from any valuation where the environment holds and
// the ports are below `next`, with calls answered by the program, `next`
// grows and the run takes the turn `m`.
fn FTm::TurnHolds(fw: FWorld, base: Nat, res: Ty, flag: Nat, kept, nexts: List<Nat>, g: List<Ty>, ports: List<Nat>, next: Nat,
    m: FTm::Round(fw.w.tys, res) → Env(fw.w.tys, g) → List<BitVec(8)> → Mutated<List<BitVec(8)>, res.sem(fw.w.tys)>, r: Option<Lowered>) → Type {
    match r {
        None => True,
        Some(c) => (call: Writers()) → FTm::CallsAgree(fw, base, call) → (values: Valuation()) → (env: Env(fw.w.tys, g)) →
            (own: List<BitVec(8)>) → EnvHolds(fw.w.tys, values, g, ports, env) → Below(fw.w.tys, g, ports, next) →
            (next <= c.next) ∧ FTm::Turn(fw.w.tys, res, fw.rest, flag, kept, nexts, c.region.run(call, values, Cons(own, fw.rest)),
                λ again => m(again, env, own)),
    }
}

// The same promise of a meaning that is equal everywhere.
theorem FTm::turn_holds_same(fw: FWorld, base: Nat, res: Ty, flag: Nat, kept, nexts: List<Nat>, g: List<Ty>, ports: List<Nat>, next: Nat,
    m1, m2: FTm::Round(fw.w.tys, res) → Env(fw.w.tys, g) → List<BitVec(8)> → Mutated<List<BitVec(8)>, res.sem(fw.w.tys)>,
    same: (again: FTm::Round(fw.w.tys, res)) → (env: Env(fw.w.tys, g)) → (own: List<BitVec(8)>) → m1(again, env, own) = m2(again, env, own)):
    (r: Option<Lowered>) → FTm::TurnHolds(fw, base, res, flag, kept, nexts, g, ports, next, m1, r) →
        FTm::TurnHolds(fw, base, res, flag, kept, nexts, g, ports, next, m2, r) {
    λ r => match r as λ q => FTm::TurnHolds(fw, base, res, flag, kept, nexts, g, ports, next, m1, q) →
        FTm::TurnHolds(fw, base, res, flag, kept, nexts, g, ports, next, m2, q) {
        None => λ _ => trivial,
        Some(c) => λ h call agree values env own held below => {
            let x = h(call, agree, values, env, own, held, below);
            ⟨x.left, ⟨x.right.left, λ again => trans(x.right.right(again),
                cong_fn(λ (m: Mutated<List<BitVec(8)>, res.sem(fw.w.tys)>) => FTm::ended(fw.w.tys, res, fw.rest, m), same(again, env, own)))⟩⟩
        },
    }
}

// ---------------------------------------------------------------------------
// The cases

// A step whose value the pass binds: the pass runs from the span the step
// left.
theorem FTm::tail_bind_sound(fw: FWorld, base: Nat, res: Ty, flag: Nat, kept, nexts: List<Nat>, g: List<Ty>, ports: List<Nat>, next: Nat, a: Ty,
    ma: Env(fw.w.tys, g) → List<BitVec(8)> → Mutated<List<BitVec(8)>, a.sem(fw.w.tys)>,
    mb: FTm::Round(fw.w.tys, res) → Env(fw.w.tys, Cons(a, g)) → List<BitVec(8)> → Mutated<List<BitVec(8)>, res.sem(fw.w.tys)>, lc, lb: Lowered,
    first: FTm::StepHolds(fw, base, g, ports, next, a, ma, Some(lc)),
    then: FTm::TurnHolds(fw, base, res, flag, kept, nexts, Cons(a, g), Cons(lc.result, ports), lc.next, mb, Some(lb))):
    FTm::TurnHolds(fw, base, res, flag, kept, nexts, g, ports, next,
        λ again env own => mb(again, Pair(ma(env, own).value, env), ma(env, own).after), Tm::compose(lc, lb)) {
    λ call agree values env own held below => {
        let file: Buffers() = Cons(own, fw.rest);
        let one = first(call, agree, values, env, own, held, below);
        let mid = lc.region.run(call, values, file);
        let m = ma(env, own);
        let two = then(call, agree, mid.values, Pair(m.value, env), m.after,
            ⟨one.right.right.right.left, env_holds_keeps(fw.w.tys, g, values, mid.values, next, one.right.right.left, ports, env, below, held)⟩,
            ⟨one.right.left, below_mono(fw.w.tys, g, next, lc.next, one.left, ports, below)⟩);
        ⟨Nat::le_trans(next, lc.next, lb.next, one.left, two.left),
            FTm::turn_after(fw.w.tys, res, fw.rest, flag, kept, nexts, lc.region, lb.region, call, values, file, State(mid.values, Cons(m.after, fw.rest)),
                λ again => mb(again, Pair(m.value, env), m.after), mid.left(Cons(m.after, fw.rest), one.right.right.right.right), two.right)⟩
    }
}

// A store, then the pass from the span it left.
theorem FTm::tail_put_sound(fw: FWorld, base: Nat, res: Ty, flag: Nat, kept, nexts: List<Nat>, g: List<Ty>, ports: List<Nat>, next, i, length, v: Nat,
    at: PutAt, found: FTm::PutAtHolds(g, ports, i, length, v, Some(at)),
    mb: FTm::Round(fw.w.tys, res) → Env(fw.w.tys, g) → List<BitVec(8)> → Mutated<List<BitVec(8)>, res.sem(fw.w.tys)>, lb: Lowered,
    then: FTm::TurnHolds(fw, base, res, flag, kept, nexts, g, ports, next + 3, mb, Some(lb))):
    FTm::TurnHolds(fw, base, res, flag, kept, nexts, g, ports, next,
        λ again env own => mb(again, env, FTm::put(fw.w.tys, g, env, i, length, v, own)), FTm::put_then(at, next, lb)) {
    λ call agree values env own held below => {
        let tys = fw.w.tys;
        let file: Buffers() = Cons(own, fw.rest);
        let index = Ty::cast(tys, Ty::at(g, i), Word(64), Env::get(tys, g, env, i));
        let bound = Ty::cast(tys, Ty::at(g, length), Word(64), Env::get(tys, g, env, length));
        let byte = Ty::cast(tys, Ty::at(g, v), Word(8), Env::get(tys, g, env, v));
        let region = FTm::put_region(at.index, at.length, at.value, next);
        let put = region.run(call, values, file);
        let ran = FTm::put_runs(call, values, own, fw.rest, at.index, at.length, at.value, next, index, bound, byte,
            Tm::operand(fw.w, g, ports, values, env, held, i, at.index, found.left.left, Word(64), found.left.right),
            Tm::operand(fw.w, g, ports, values, env, held, length, at.length, found.right.left.left, Word(64), found.right.left.right),
            Tm::operand(fw.w, g, ports, values, env, held, v, at.value, found.right.right.left, Word(8), found.right.right.right),
            Ty::below_cast(tys, Ty::at(g, i), Word(64), found.left.right, at.index, next, below_at(tys, g, ports, next, below, i, at.index, found.left.left)),
            Ty::below_cast(tys, Ty::at(g, v), Word(8), found.right.right.right, at.value, next,
                below_at(tys, g, ports, next, below, v, at.value, found.right.right.left)));
        let later = next + 3;
        let step: (next <= later) = Nat::le_succ_r(next, next + 2, Nat::le_succ_r(next, next + 1, Nat::le_succ_r(next, next, next.le_refl())));
        let written = own.with_byte_within(bound, index, byte);
        let two = then(call, agree, put.values, env, written, env_holds_keeps(tys, g, values, put.values, next, ran.left, ports, env, below, held),
            below_mono(tys, g, next, later, step, ports, below));
        ⟨Nat::le_trans(next, later, lb.next, step, two.left),
            FTm::turn_after(tys, res, fw.rest, flag, kept, nexts, region, lb.region, call, values, file, State(put.values, Cons(written, fw.rest)),
                λ again => mb(again, env, written), put.left(Cons(written, fw.rest), ran.right), two.right)⟩
    }
}

// A branch of a pass, from what each arm's pass promises.
theorem FTm::tail_if_sound(fw: FWorld, base: Nat, res: Ty, flag: Nat, kept, nexts: List<Nat>, g: List<Ty>, ports: List<Nat>, next, c: Nat,
    my, mn: FTm::Round(fw.w.tys, res) → Env(fw.w.tys, g) → List<BitVec(8)> → Mutated<List<BitVec(8)>, res.sem(fw.w.tys)>, ly, ln: Lowered,
    first: FTm::TurnHolds(fw, base, res, flag, kept, nexts, g, ports, next, my, Some(ly)),
    second: FTm::TurnHolds(fw, base, res, flag, kept, nexts, g, ports, ly.next, mn, Some(ln))):
    FTm::TurnHolds(fw, base, res, flag, kept, nexts, g, ports, next,
        λ again env own => match Ty::cast(fw.w.tys, Ty::at(g, c), Bit, Env::get(fw.w.tys, g, env, c)) {
            False => mn(again, env, own),
            True => my(again, env, own),
        }, Tm::tail_branch(g, ports, c, flag, nexts, ly, ln)) {
    let tys = fw.w.tys;
    let P = λ (r: Option<Lowered>) => FTm::TurnHolds(fw, base, res, flag, kept, nexts, g, ports, next,
        λ again env own => match Ty::cast(tys, Ty::at(g, c), Bit, Env::get(tys, g, env, c)) {
            False => mn(again, env, own),
            True => my(again, env, own),
        }, r);
    let outs = Ports(word_ports(Cons(flag, nexts)));
    Option::and_then_elim(P, trivial, port_at(ports, c),
        λ pc => Ty::at(g, c).check(Bit).and_then(λ _ => Some(Lowered(branch(pc, outs, ly.region, ln.region), flag, ln.next))), λ pc at_c =>
    Option::and_then_elim(P, trivial, Ty::at(g, c).check(Bit), λ _ => Some(Lowered(branch(pc, outs, ly.region, ln.region), flag, ln.next)),
        λ ec _ =>
        λ call agree values env own held below => {
            let file: Buffers() = Cons(own, fw.rest);
            let one = first(call, agree, values, env, own, held, below);
            let two = second(call, agree, values, env, own, held, below_mono(tys, g, next, ly.next, one.left, ports, below));
            let scrutinee = Ty::cast(tys, Ty::at(g, c), Bit, Env::get(tys, g, env, c));
            let bit = Tm::operand(fw.w, g, ports, values, env, held, c, pc, at_c, Bit, ec);
            let chosen = trans(cong_fn(λ (x: BitVec(1)) => x.head_bit(), bit), BitVec::head_bit_ofBool(scrutinee));
            ⟨Nat::le_trans(next, ly.next, ln.next, one.left, two.left),
                FTm::turn_branch(tys, res, fw.rest, flag, kept, nexts, values, pc, outs, ly.region, ln.region, call, file, scrutinee,
                    λ again => my(again, env, own), λ again => mn(again, env, own), chosen, one.right, two.right)⟩
        }))
}

// Moves store nothing.
theorem Tm::moves_to_quiet(ns: List<Nat>): (qs: List<Nat>) → nodes_quiet(Tm::moves_to(ns, qs)).IsTrue() {
    match ns {
        Nil => λ qs => trivial,
        Cons(n, rest) => λ qs => match qs as λ q2 => nodes_quiet(Tm::moves_to(Cons(n, rest), q2)).IsTrue() {
            Nil => trivial,
            Cons(q, more) => Tm::moves_to_quiet(rest, more),
        },
    }
}

// A value the pass ends in: the term's region, its word moved to the first
// of `nexts`, the flag 1.
fn FTm::lower_leaf(v: Tm, w: World, base: Nat, res: Ty, flag: Nat, nexts: List<Nat>, g: List<Ty>, ports: List<Nat>, next: Nat) → Option<Lowered> {
    FTm::lower_value(v, w, base, g, ports, next).and_then(λ l => v.ty(w, g).check(res).and_then(λ _ => Tm::leave_at(flag, nexts, l)))
}

theorem FTm::tail_leaf_sound(v: Tm, fw: FWorld, base: Nat, res: Ty, er: res.OneWord(fw.w.tys), flag: Nat, kept, nexts: List<Nat>, g: List<Ty>,
    ports: List<Nat>, next: Nat):
    FTm::TurnHolds(fw, base, res, flag, kept, nexts, g, ports, next,
        λ again env own => Mutated(own, Ty::cast(fw.w.tys, v.ty(fw.w, g), res, FTm::value(fw, own, v, g, env))),
        FTm::lower_leaf(v, fw.w, base, res, flag, nexts, g, ports, next)) {
    let tys = fw.w.tys;
    let vty = v.ty(fw.w, g);
    let M = λ (again: FTm::Round(tys, res)) (env: Env(tys, g)) (own: List<BitVec(8)>) =>
        Mutated(own, Ty::cast(tys, vty, res, FTm::value(fw, own, v, g, env)));
    match nexts as λ ns => FTm::TurnHolds(fw, base, res, flag, kept, ns, g, ports, next, M, FTm::lower_leaf(v, fw.w, base, res, flag, ns, g, ports, next)) {
        Nil => {
            let P = λ (r: Option<Lowered>) => FTm::TurnHolds(fw, base, res, flag, kept, Nil, g, ports, next, M, r);
            Option::and_then_elim(P, trivial, FTm::lower_value(v, fw.w, base, g, ports, next),
                λ l => vty.check(res).and_then(λ _ => Tm::leave_at(flag, Nil, l)), λ l _ =>
            Option::and_then_elim(P, trivial, vty.check(res), λ _ => Tm::leave_at(flag, Nil, l), λ _ _ => trivial))
        },
        Cons(n0, rest) => {
            let ns = Cons(n0, rest);
            let P = λ (r: Option<Lowered>) => FTm::TurnHolds(fw, base, res, flag, kept, ns, g, ports, next, M, r);
            Option::and_then_elim(P, trivial, FTm::lower_value(v, fw.w, base, g, ports, next),
                λ l => vty.check(res).and_then(λ _ => Tm::leave_at(flag, ns, l)), λ l lowered =>
            Option::and_then_elim(P, trivial, vty.check(res), λ _ => Tm::leave_at(flag, ns, l), λ e _ =>
            Option::and_then_elim(P, trivial, Tm::check_true(distinct(Cons(flag, Cons(n0, rest)))),
                λ _ => Some(Lowered(Tm::leave_region(l, flag, n0, rest), flag, l.next)), λ apart _ =>
                λ call agree values env own held below => {
                    let file: Buffers() = Cons(own, fw.rest);
                    let value = FTm::value(fw, own, v, g, env);
                    let ran = j(lowered, λ r _ => FTm::ValueHolds(v, fw, base, g, ports, next, r), FTm::value_sound(v, fw, base, g, ports, next))(
                        call, agree, values, env, own, held, below);
                    let p1 = Bool::is_true_and(absent(flag, Cons(n0, rest)), distinct(Cons(n0, rest)), apart);
                    let pf = Bool::is_true_and(flag.differs(n0), absent(flag, rest), p1.left);
                    let pn = Bool::is_true_and(absent(n0, rest), distinct(rest), p1.right);
                    let end = l.region.run(call, values, file);
                    let mid = end.values;
                    let moved = Valuation::set(mid, n0, λ wd => mid(wd, l.result));
                    let copies = Tm::moves_to(rest, Tm::copies(rest, n0));
                    let moves = Cons(Move(64, n0, l.result), copies);
                    let copied = eval_nodes_over(file, copies, moved);
                    let after = Valuation::set(copied, flag, λ wd => BitVec::ofNat(1));
                    let at_flag: (after(64, flag) = BitVec::ofNat(1)) = Valuation::set_here(copied, flag, λ wd => BitVec::ofNat(1), 64);
                    let at_n0: (after(64, n0) = mid(64, l.result)) = trans(
                        Valuation::set_other(copied, flag, λ wd => BitVec::ofNat(1), 64, n0, λ same => Nat::differs_ne(flag, n0, pf.left, sym(same))), trans(
                        eval_nodes_frame(copies, file, moved, 64, n0, Tm::moves_to_writes(rest, Tm::copies(rest, n0), n0, pn.left)),
                        Valuation::set_here(mid, n0, λ wd => mid(wd, l.result), 64)));
                    let held_one: vty.OneWord(tys) = j(sym(e), λ x _ => x.OneWord(tys), er);
                    let word: (mid(64, l.result) = Tm::out(tys, res, Ty::cast(tys, vty, res, value))) =
                        trans(Ty::one_word_reads(tys, mid, l.result, vty, held_one, value, ran.right.right.right.left),
                            sym(Tm::out_cast(tys, vty, res, e, value)));
                    let out = λ (again: FTm::Round(tys, res)) => M(again, env, own);
                    let last: FTm::Turn(tys, res, fw.rest, flag, kept, ns, State(after, file), out) = ⟨refl, λ again =>
                        trans(cong_fn(λ (x: BitVec(64)) => match x.eq_bit(BitVec::ofNat(1)) {
                                False => FTm::resume(tys, res, fw.rest, again, words_of(after, kept) ++ words_of(after, ns), file),
                                True => Ending(words_of(after, ns).head_or(BitVec::zero()), file) }, at_flag),
                            cong_fn(λ (x: BitVec(64)) => Ending(x, file), trans(at_n0, word)))⟩;
                    ⟨ran.left, FTm::turn_after(tys, res, fw.rest, flag, kept, ns, l.region,
                        Compose(nodes_region(moves), nodes_region([Const(64, flag, 1)])), call, values, file, State(mid, file), out,
                        end.left(file, ran.right.right.right.right),
                        FTm::turn_after(tys, res, fw.rest, flag, kept, ns, nodes_region(moves), nodes_region([Const(64, flag, 1)]), call, mid, file,
                            State(eval_nodes_over(file, moves, mid), file), out,
                            run_nodes_quiet(moves, Tm::moves_to_quiet(rest, Tm::copies(rest, n0)), mid, file), last))⟩
                })))
        },
    }
}

// Going round: the self-call's arguments moved to `nexts`, the flag 0, the
// span as it is.
theorem FTm::tail_again_sound(fw: FWorld, base: Nat, res: Ty, flag: Nat, kept, nexts: List<Nat>, g: List<Ty>, ports: List<Nat>, next: Nat,
    args: List<Nat>):
    FTm::TurnHolds(fw, base, res, flag, kept, nexts, g, ports, next, λ again env own => again(Tm::words(fw.w, g, env, args), own),
        Tm::self_args(fw.w, g, ports, args).and_then(λ qs => Tm::lower_again(flag, kept, nexts, next, qs))) {
    let tys = fw.w.tys;
    let P = λ (r: Option<Lowered>) => FTm::TurnHolds(fw, base, res, flag, kept, nexts, g, ports, next,
        λ again env own => again(Tm::words(fw.w, g, env, args), own), r);
    Option::and_then_elim(P, trivial, Tm::self_args(fw.w, g, ports, args), λ qs => Tm::lower_again(flag, kept, nexts, next, qs), λ qs e_qs =>
    Option::and_then_elim(P, trivial, Tm::split_kept(kept, qs), λ moved =>
        Tm::check_true((distinct(Cons(flag, nexts)) && (disjoint(Cons(flag, nexts), moved) && nexts.len().matches(moved.len()))) &&
            disjoint(Cons(flag, nexts), kept))
            .and_then(λ _ => Some(Lowered(Tm::again_region(flag, nexts, moved), flag, next))), λ moved e_moved =>
    Option::and_then_elim(P, trivial,
        Tm::check_true((distinct(Cons(flag, nexts)) && (disjoint(Cons(flag, nexts), moved) && nexts.len().matches(moved.len()))) &&
            disjoint(Cons(flag, nexts), kept)),
        λ _ => Some(Lowered(Tm::again_region(flag, nexts, moved), flag, next)), λ ok _ =>
        λ call agree values env own held below => {
            let file: Buffers() = Cons(own, fw.rest);
            let both = Bool::is_true_and(distinct(Cons(flag, nexts)) && (disjoint(Cons(flag, nexts), moved) && nexts.len().matches(moved.len())),
                disjoint(Cons(flag, nexts), kept), ok);
            let parts = Bool::is_true_and(distinct(Cons(flag, nexts)), disjoint(Cons(flag, nexts), moved) && nexts.len().matches(moved.len()), both.left);
            let rest = Bool::is_true_and(disjoint(Cons(flag, nexts), moved), nexts.len().matches(moved.len()), parts.right);
            let apart = Bool::is_true_and(absent(flag, nexts), distinct(nexts), parts.left);
            let moves = Tm::moves_to(nexts, moved);
            let shifted = eval_nodes_over(file, moves, values);
            let after = Valuation::set(shifted, flag, λ wd => BitVec::ofNat(0));
            let at_flag: (after(64, flag) = BitVec::ofNat(0)) = Valuation::set_here(shifted, flag, λ wd => BitVec::ofNat(0), 64);
            // The flag is none of `nexts`.
            let unflagged: (words_of(after, nexts) = words_of(shifted, nexts)) = words_agree(nexts, shifted, after, λ y m =>
                Valuation::set_other(shifted, flag, λ wd => BitVec::ofNat(0), 64, y, λ e => absent_mem(flag, nexts, apart.left, y, m, sym(e))));
            let moved_words: (words_of(after, nexts) = words_of(values, moved)) = trans(unflagged,
                Tm::moves_to_words(nexts, file, moved, values, apart.right, Tm::disjoint_tail(flag, nexts, moved, rest.left),
                    nexts.len().matches_eq(moved.len(), rest.right)));
            // Nothing written is one of `kept`.
            let kept_words: (words_of(after, kept) = words_of(values, kept)) = words_agree(kept, values, after, λ y m => {
                let out = Bool::is_true_and(y.differs(flag), absent(y, nexts), disjoint_mem(Cons(flag, nexts), kept, both.right, y, m));
                trans(Valuation::set_other(shifted, flag, λ wd => BitVec::ofNat(0), 64, y, y.differs_ne(flag, out.left)),
                    eval_nodes_frame(moves, file, values, 64, y, Tm::moves_to_writes(nexts, moved, y, out.right)))
            });
            let state: (words_of(after, kept) ++ words_of(after, nexts) = Tm::words(fw.w, g, env, args)) = trans(
                eq2(λ (a: List<BitVec(64)>) (b: List<BitVec(64)>) => a ++ b, kept_words, moved_words),
                trans(Tm::split_kept_words(values, kept, qs, moved, e_moved), Tm::self_args_sound(fw.w, g, ports, values, env, held, args, qs, e_qs)));
            let out = λ (again: FTm::Round(tys, res)) => again(Tm::words(fw.w, g, env, args), own);
            let last: FTm::Turn(tys, res, fw.rest, flag, kept, nexts, State(after, file), out) = ⟨refl, λ again =>
                trans(cong_fn(λ (x: BitVec(64)) => match x.eq_bit(BitVec::ofNat(1)) {
                        False => FTm::resume(tys, res, fw.rest, again, words_of(after, kept) ++ words_of(after, nexts), file),
                        True => Ending(words_of(after, nexts).head_or(BitVec::zero()), file) }, at_flag),
                    cong_fn(λ (ws: List<BitVec(64)>) => FTm::ended(tys, res, fw.rest, again(ws, own)), state))⟩;
            ⟨next.le_refl(), FTm::turn_after(tys, res, fw.rest, flag, kept, nexts, nodes_region(moves), nodes_region([Const(64, flag, 0)]), call, values,
                file, State(shifted, file), out, run_nodes_quiet(moves, Tm::moves_to_quiet(nexts, moved), values, file), last)⟩
        })))
}

// ---------------------------------------------------------------------------
// A pass

// `t` in tail mode. The flag and `nexts` are ports below `next` that
// nothing in the context is held at (checked where the self-call goes
// round, whose arguments are moved there); `kept` are handed on in place.
fn FTm::lower_tail(self t: FTm, w: World, fsigs: List<Sig>, base: Nat, res: Ty, flag: Nat, kept, nexts: List<Nat>, g: List<Ty>, ports: List<Nat>,
    next: Nat) → Option<Lowered> {
    match t {
        Pure(v) => FTm::lower_leaf(v, w, base, res, flag, nexts, g, ports, next),
        Let(e, body) => FTm::lower_value(e, w, base, g, ports, next).and_then(λ le =>
            FTm::lower_tail(body, w, fsigs, base, res, flag, kept, nexts, Cons(e.ty(w, g), g), Cons(le.result, ports), le.next)
                .and_then(λ lb => Tm::compose(le, lb))),
        If(c, yes, no) => FTm::lower_tail(yes, w, fsigs, base, res, flag, kept, nexts, g, ports, next).and_then(λ ly =>
            FTm::lower_tail(no, w, fsigs, base, res, flag, kept, nexts, g, ports, ly.next).and_then(λ ln => Tm::tail_branch(g, ports, c, flag, nexts, ly, ln))),
        IfEq(c, yes, no) => FTm::lower_tail(yes, w, fsigs, base, res, flag, kept, nexts, g, ports, next).and_then(λ ly =>
            FTm::lower_tail(no, w, fsigs, base, res, flag, kept, nexts, g, ports, ly.next).and_then(λ ln => Tm::tail_branch(g, ports, c, flag, nexts, ly, ln))),
        Put(i, length, v, body) => FTm::put_ports(g, ports, i, length, v).and_then(λ at =>
            FTm::lower_tail(body, w, fsigs, base, res, flag, kept, nexts, g, ports, next + 3).and_then(λ lb => FTm::put_then(at, next, lb))),
        Call(f, args, body) => FTm::lower_call(w, fsigs, base, g, ports, next, f, args).and_then(λ lc =>
            FTm::lower_tail(body, w, fsigs, base, res, flag, kept, nexts, Cons(Sig::at(fsigs, f).result, g), Cons(lc.result, ports), lc.next)
                .and_then(λ lb => Tm::compose(lc, lb))),
        Again(args) => Tm::self_args(w, g, ports, args).and_then(λ qs => Tm::lower_again(flag, kept, nexts, next, qs)),
        Lend(f, views, args, body) => FTm::lower_lend(w, fsigs, base, g, ports, next, f, views, args).and_then(λ lc =>
            FTm::lower_tail(body, w, fsigs, base, res, flag, kept, nexts, Cons(Sig::at(fsigs, f).result, g), Cons(lc.result, ports), lc.next)
                .and_then(λ lb => Tm::compose(lc, lb))),
        Loop(_, _, _, _) => None,
        Node(_, _) => None,
        Next(_, _) => None,
    }
}

// What a pass promises: the turn of `FTm::tail_sem`.
fn FTm::TailHolds(self t: FTm, fw: FWorld, base: Nat, res: Ty, flag: Nat, kept, nexts: List<Nat>, g: List<Ty>, ports: List<Nat>, next: Nat,
    r: Option<Lowered>) → Type {
    FTm::TurnHolds(fw, base, res, flag, kept, nexts, g, ports, next, λ again env own => t.tail_sem(fw, res, again, g, env, own), r)
}

// A branch's two arms lowered in tail mode, then the branch.
theorem FTm::tail_arms_sound(c: Nat, yes, no: FTm, fw: FWorld, base: Nat, res: Ty, flag: Nat, kept, nexts: List<Nat>,
    ih_yes: (g: List<Ty>) → (ports: List<Nat>) → (next: Nat) →
        FTm::TailHolds(yes, fw, base, res, flag, kept, nexts, g, ports, next, FTm::lower_tail(yes, fw.w, fw.fsigs, base, res, flag, kept, nexts, g, ports, next)),
    ih_no: (g: List<Ty>) → (ports: List<Nat>) → (next: Nat) →
        FTm::TailHolds(no, fw, base, res, flag, kept, nexts, g, ports, next, FTm::lower_tail(no, fw.w, fw.fsigs, base, res, flag, kept, nexts, g, ports, next)),
    g: List<Ty>, ports: List<Nat>, next: Nat):
    FTm::TailHolds(If(c, yes, no), fw, base, res, flag, kept, nexts, g, ports, next,
        FTm::lower_tail(If(c, yes, no), fw.w, fw.fsigs, base, res, flag, kept, nexts, g, ports, next)) {
    let P = λ (r: Option<Lowered>) => FTm::TailHolds(If(c, yes, no), fw, base, res, flag, kept, nexts, g, ports, next, r);
    Option::and_then_elim(P, trivial, FTm::lower_tail(yes, fw.w, fw.fsigs, base, res, flag, kept, nexts, g, ports, next),
        λ ly => FTm::lower_tail(no, fw.w, fw.fsigs, base, res, flag, kept, nexts, g, ports, ly.next).and_then(λ ln =>
            Tm::tail_branch(g, ports, c, flag, nexts, ly, ln)),
        λ ly lowered_yes =>
    Option::and_then_elim(P, trivial, FTm::lower_tail(no, fw.w, fw.fsigs, base, res, flag, kept, nexts, g, ports, ly.next),
        λ ln => Tm::tail_branch(g, ports, c, flag, nexts, ly, ln), λ ln lowered_no =>
        FTm::tail_if_sound(fw, base, res, flag, kept, nexts, g, ports, next, c, λ again env own => yes.tail_sem(fw, res, again, g, env, own),
            λ again env own => no.tail_sem(fw, res, again, g, env, own), ly, ln,
            j(lowered_yes, λ r _ => FTm::TailHolds(yes, fw, base, res, flag, kept, nexts, g, ports, next, r), ih_yes(g, ports, next)),
            j(lowered_no, λ r _ => FTm::TailHolds(no, fw, base, res, flag, kept, nexts, g, ports, ly.next, r), ih_no(g, ports, ly.next)))))
}

// What a pass runs to, wherever the result's code is held in one word.
theorem FTm::tail_sound(self t: FTm, fw: FWorld, base: Nat, res: Ty, er: res.OneWord(fw.w.tys), flag: Nat, kept, nexts: List<Nat>): (g: List<Ty>) →
    (ports: List<Nat>) → (next: Nat) →
    FTm::TailHolds(t, fw, base, res, flag, kept, nexts, g, ports, next, FTm::lower_tail(t, fw.w, fw.fsigs, base, res, flag, kept, nexts, g, ports, next)) {
    match t {
        Pure(v) => λ g ports next => FTm::tail_leaf_sound(v, fw, base, res, er, flag, kept, nexts, g, ports, next),
        Let(e, body) => λ g ports next => {
            let P = λ (r: Option<Lowered>) => FTm::TailHolds(Let(e, body), fw, base, res, flag, kept, nexts, g, ports, next, r);
            let inner = Cons(e.ty(fw.w, g), g);
            Option::and_then_elim(P, trivial, FTm::lower_value(e, fw.w, base, g, ports, next),
                λ le => FTm::lower_tail(body, fw.w, fw.fsigs, base, res, flag, kept, nexts, inner, Cons(le.result, ports), le.next)
                    .and_then(λ lb => Tm::compose(le, lb)),
                λ le lowered_e =>
            Option::and_then_elim(P, trivial, FTm::lower_tail(body, fw.w, fw.fsigs, base, res, flag, kept, nexts, inner, Cons(le.result, ports), le.next),
                λ lb => Tm::compose(le, lb), λ lb lowered_body =>
                FTm::tail_bind_sound(fw, base, res, flag, kept, nexts, g, ports, next, e.ty(fw.w, g),
                    λ env own => Mutated(own, FTm::value(fw, own, e, g, env)), λ again env own => body.tail_sem(fw, res, again, inner, env, own), le, lb,
                    j(lowered_e, λ r _ => FTm::ValueHolds(e, fw, base, g, ports, next, r), FTm::value_sound(e, fw, base, g, ports, next)),
                    j(lowered_body, λ r _ => FTm::TailHolds(body, fw, base, res, flag, kept, nexts, inner, Cons(le.result, ports), le.next, r),
                        FTm::tail_sound(body, fw, base, res, er, flag, kept, nexts, inner, Cons(le.result, ports), le.next)))))
        },
        If(c, yes, no) => λ g ports next => FTm::tail_arms_sound(c, yes, no, fw, base, res, flag, kept, nexts,
            λ g2 ports2 next2 => FTm::tail_sound(yes, fw, base, res, er, flag, kept, nexts, g2, ports2, next2),
            λ g2 ports2 next2 => FTm::tail_sound(no, fw, base, res, er, flag, kept, nexts, g2, ports2, next2), g, ports, next),
        IfEq(c, yes, no) => λ g ports next => FTm::turn_holds_same(fw, base, res, flag, kept, nexts, g, ports, next,
            λ again env own => FTm::tail_sem(If(c, yes, no), fw, res, again, g, env, own),
            λ again env own => FTm::tail_sem(IfEq(c, yes, no), fw, res, again, g, env, own),
            λ again env own => sym(Tm::convoy_match(Mutated<List<BitVec(8)>, res.sem(fw.w.tys)>,
                Ty::cast(fw.w.tys, Ty::at(g, c), Bit, Env::get(fw.w.tys, g, env, c)), yes.tail_sem(fw, res, again, g, env, own),
                no.tail_sem(fw, res, again, g, env, own))),
            FTm::lower_tail(If(c, yes, no), fw.w, fw.fsigs, base, res, flag, kept, nexts, g, ports, next),
            FTm::tail_arms_sound(c, yes, no, fw, base, res, flag, kept, nexts,
                λ g2 ports2 next2 => FTm::tail_sound(yes, fw, base, res, er, flag, kept, nexts, g2, ports2, next2),
                λ g2 ports2 next2 => FTm::tail_sound(no, fw, base, res, er, flag, kept, nexts, g2, ports2, next2), g, ports, next)),
        Put(i, length, v, body) => λ g ports next => {
            let P = λ (r: Option<Lowered>) => FTm::TailHolds(Put(i, length, v, body), fw, base, res, flag, kept, nexts, g, ports, next, r);
            let later = next + 3;
            Option::and_then_elim(P, trivial, FTm::put_ports(g, ports, i, length, v),
                λ at => FTm::lower_tail(body, fw.w, fw.fsigs, base, res, flag, kept, nexts, g, ports, later).and_then(λ lb => FTm::put_then(at, next, lb)),
                λ at found =>
            Option::and_then_elim(P, trivial, FTm::lower_tail(body, fw.w, fw.fsigs, base, res, flag, kept, nexts, g, ports, later),
                λ lb => FTm::put_then(at, next, lb), λ lb lowered_body =>
                FTm::tail_put_sound(fw, base, res, flag, kept, nexts, g, ports, next, i, length, v, at,
                    j(found, λ r _ => FTm::PutAtHolds(g, ports, i, length, v, r), FTm::put_ports_sound(g, ports, i, length, v)),
                    λ again env own => body.tail_sem(fw, res, again, g, env, own), lb,
                    j(lowered_body, λ r _ => FTm::TailHolds(body, fw, base, res, flag, kept, nexts, g, ports, later, r),
                        FTm::tail_sound(body, fw, base, res, er, flag, kept, nexts, g, ports, later)))))
        },
        Call(f, args, body) => λ g ports next => {
            let P = λ (r: Option<Lowered>) => FTm::TailHolds(Call(f, args, body), fw, base, res, flag, kept, nexts, g, ports, next, r);
            let result = Sig::at(fw.fsigs, f).result;
            let inner = Cons(result, g);
            Option::and_then_elim(P, trivial, FTm::lower_call(fw.w, fw.fsigs, base, g, ports, next, f, args),
                λ lc => FTm::lower_tail(body, fw.w, fw.fsigs, base, res, flag, kept, nexts, inner, Cons(lc.result, ports), lc.next)
                    .and_then(λ lb => Tm::compose(lc, lb)),
                λ lc lowered_call =>
            Option::and_then_elim(P, trivial, FTm::lower_tail(body, fw.w, fw.fsigs, base, res, flag, kept, nexts, inner, Cons(lc.result, ports), lc.next),
                λ lb => Tm::compose(lc, lb), λ lb lowered_body =>
                FTm::tail_bind_sound(fw, base, res, flag, kept, nexts, g, ports, next, result, λ env own => FTm::called(fw, g, env, f, args, own),
                    λ again env own => body.tail_sem(fw, res, again, inner, env, own), lc, lb,
                    j(lowered_call, λ r _ => FTm::StepHolds(fw, base, g, ports, next, result, λ env own => FTm::called(fw, g, env, f, args, own), r),
                        FTm::call_sound(fw, base, g, ports, next, f, args)),
                    j(lowered_body, λ r _ => FTm::TailHolds(body, fw, base, res, flag, kept, nexts, inner, Cons(lc.result, ports), lc.next, r),
                        FTm::tail_sound(body, fw, base, res, er, flag, kept, nexts, inner, Cons(lc.result, ports), lc.next)))))
        },
        Again(args) => λ g ports next => FTm::tail_again_sound(fw, base, res, flag, kept, nexts, g, ports, next, args),
        Lend(f, views, args, body) => λ g ports next => {
            let P = λ (r: Option<Lowered>) => FTm::TailHolds(Lend(f, views, args, body), fw, base, res, flag, kept, nexts, g, ports, next, r);
            let result = Sig::at(fw.fsigs, f).result;
            let inner = Cons(result, g);
            Option::and_then_elim(P, trivial, FTm::lower_lend(fw.w, fw.fsigs, base, g, ports, next, f, views, args),
                λ lc => FTm::lower_tail(body, fw.w, fw.fsigs, base, res, flag, kept, nexts, inner, Cons(lc.result, ports), lc.next)
                    .and_then(λ lb => Tm::compose(lc, lb)),
                λ lc lowered_lend =>
            Option::and_then_elim(P, trivial, FTm::lower_tail(body, fw.w, fw.fsigs, base, res, flag, kept, nexts, inner, Cons(lc.result, ports), lc.next),
                λ lb => Tm::compose(lc, lb), λ lb lowered_body =>
                FTm::tail_bind_sound(fw, base, res, flag, kept, nexts, g, ports, next, result, λ env own => FTm::lent(fw, g, env, f, views, args, own),
                    λ again env own => body.tail_sem(fw, res, again, inner, env, own), lc, lb,
                    j(lowered_lend, λ r _ => FTm::StepHolds(fw, base, g, ports, next, result, λ env own => FTm::lent(fw, g, env, f, views, args, own), r),
                        FTm::lend_sound(fw, base, g, ports, next, f, views, args)),
                    j(lowered_body, λ r _ => FTm::TailHolds(body, fw, base, res, flag, kept, nexts, inner, Cons(lc.result, ports), lc.next, r),
                        FTm::tail_sound(body, fw, base, res, er, flag, kept, nexts, inner, Cons(lc.result, ports), lc.next)))))
        },
        Loop(_, _, _, _) => λ g ports next => trivial,
        Node(_, _) => λ g ports next => trivial,
        Next(_, _) => λ g ports next => trivial,
    }
}

// ---------------------------------------------------------------------------
// The function on words

// A curried function into any type on a word list: each word cast to its
// parameter's code (zero past the list's end, as `Ty::extend` reads).
fn Ty::apply_to(tys: Table, ps: List<Ty>, R: Type) → Ty::ArrowsTo(tys, ps, R) → List<BitVec(64)> → R {
    match ps {
        Nil => λ v ws => v,
        Cons(p, rest) => λ v ws => match ws {
            Nil => Ty::apply_to(tys, rest, R, v(Ty::cast(tys, Word(64), p, BitVec::zero())), Nil),
            Cons(x, more) => Ty::apply_to(tys, rest, R, v(Ty::cast(tys, Word(64), p, x)), more),
        },
    }
}

// A computation's meaning on words and a span, its value read as a word:
// what a call of its code answers, and the span it leaves.
fn FFun::uncurry(tys: Table, ps: List<Ty>, r: Ty, h: FTm::Sem(tys, Sig(ps, r)), xs: List<BitVec(64)>, own: List<BitVec(8)>)
    → Mutated<List<BitVec(8)>, BitVec(64)> {
    FTm::recast(tys, r, Word(64), Ty::apply_to(tys, ps, Mutated<List<BitVec(8)>, r.sem(tys)>, h(own), xs))
}

// The ending of a word and a span over the rest of the file.
fn FTm::end_of(rest: List<List<BitVec(8)>>, m: Mutated<List<BitVec(8)>, BitVec(64)>) → Ending { Ending(m.value, Cons(m.after, rest)) }

// What answers like the uncurried meaning on as many words as parameters
// answers like the meaning.
theorem FFun::answers_of_uncurry(tys: Table, r: Ty, rest: List<List<BitVec(8)>>, ps: List<Ty>):
    (F: Ty::ArrowsTo(tys, ps, Mutated<List<BitVec(8)>, r.sem(tys)>)) → (ans: List<BitVec(64)> → Ending) →
    ((xs: List<BitVec(64)>) → xs.len() = ps.len() →
        ans(xs) = FTm::end_of(rest, FTm::recast(tys, r, Word(64), Ty::apply_to(tys, ps, Mutated<List<BitVec(8)>, r.sem(tys)>, F, xs)))) →
    FTm::Answers(tys, ps, r, rest, F, ans) {
    match ps {
        Nil => λ F ans h => h(Nil, refl),
        Cons(p, later) => λ F ans h => λ x => FFun::answers_of_uncurry(tys, r, rest, later, F(Ty::cast(tys, Word(64), p, x)), λ ws => ans(Cons(x, ws)),
            λ ws len => h(Cons(x, ws), cong_fn(λ (n: Nat) => n + 1, len))),
    }
}

// ---------------------------------------------------------------------------
// After a loop that writes (`Fun::post` run over the file the loop left)

// Leaving: the result is the first moved word, the file the loop's.
theorem Fun::post_left_run(x, rr, o0: Nat, ko, os: List<Nat>, exhausted: StructuredRegion, call: Writers(), file: Buffers(), values: Valuation(),
    kw: List<BitVec(64)>, s0: BitVec(64), rest: List<BitVec(64)>, apart: x ≠ o0, fresh: absent(o0, ko).IsTrue(), len: ko.len() = kw.len()):
    loop_finish_run(Fun::post(x, rr, o0, exhausted), call, values, ko ++ Cons(o0, os), x, rr, LoopState(LoopEnd(kw ++ Cons(s0, rest), False), file)) =
        Ending(s0, file) {
    let bound = Valuation::bind(values, ko ++ Cons(o0, os), kw ++ Cons(s0, rest));
    let q = Valuation::set(bound, x, bit_value(False));
    let left: (q(1, x).head_bit() = False) = cong_fn(λ (v: BitVec(1)) => v.head_bit(), Valuation::set_here(bound, x, bit_value(False), 1));
    let on = exhausted.run(call, q, file);
    let off = nodes_region([Move(64, rr, o0)]).run(call, q, file);
    trans(cong_fn(λ (b: Bool) => Ending(match b as λ _ => BitVec(64) { False => off.values(64, rr), True => on.values(64, rr) },
            match b as λ _ => Buffers() { False => off.buffers, True => on.buffers }), left),
        cong_fn(λ (word: BitVec(64)) => Ending(word, file), trans(Valuation::set_here(q, rr, λ wd => q(wd, o0), 64),
            trans(Valuation::set_other(bound, x, bit_value(False), 64, o0, λ e => apart(sym(e))),
                Fun::bind_past(values, o0, os, s0, rest, ko, kw, fresh, len)))))
}

// What the exhausted branch runs from: the state at `os`, the bit at `x`
// set, the file the loop left.
theorem Fun::post_exhausted_run(x, rr, o0: Nat, exhausted: StructuredRegion, call: Writers(), file: Buffers(), values: Valuation(), os: List<Nat>,
    st: List<BitVec(64)>):
    loop_finish_run(Fun::post(x, rr, o0, exhausted), call, values, os, x, rr, LoopState(LoopEnd(st, True), file)) =
        shared(exhausted.run(call, Valuation::set(Valuation::bind(values, os, st), x, bit_value(True)), file),
            λ (end: State) => Ending(end.values(64, rr), end.buffers)) {
    let q = Valuation::set(Valuation::bind(values, os, st), x, bit_value(True));
    let on = exhausted.run(call, q, file);
    let off = nodes_region([Move(64, rr, o0)]).run(call, q, file);
    cong_fn(λ (b: Bool) => Ending(match b as λ _ => BitVec(64) { False => off.values(64, rr), True => on.values(64, rr) },
            match b as λ _ => Buffers() { False => off.buffers, True => on.buffers }),
        cong_fn(λ (v: BitVec(1)) => v.head_bit(), Valuation::set_here(Valuation::bind(values, os, st), x, bit_value(True), 1)))
}

// What a pass leaves reads its continuation only at the next state and the
// file.
theorem FTm::leave_cont(end: State, flag: Nat, kept, ns: List<Nat>, k1, k2: List<BitVec(64)> → Buffers() → Ending,
    same: k1(words_of(end.values, kept) ++ words_of(end.values, ns), end.buffers) = k2(words_of(end.values, kept) ++ words_of(end.values, ns), end.buffers)):
    FTm::leave(end, flag, kept, ns, k1) = FTm::leave(end, flag, kept, ns, k2) {
    cong_fn(λ (k: Ending) => match end.values(64, flag).eq_bit(BitVec::ofNat(1)) {
        False => k, True => Ending(words_of(end.values, ns).head_or(BitVec::zero()), end.buffers) }, same)
}

// Leaving or not, the first moved word and the file, for a continuation
// that is them.
theorem FTm::leave_first(end: State, flag: Nat, kept, ns: List<Nat>):
    FTm::leave(end, flag, kept, ns, λ (ys: List<BitVec(64)>) (file: Buffers()) => Ending(words_of(end.values, ns).head_or(BitVec::zero()), file)) =
        Ending(words_of(end.values, ns).head_or(BitVec::zero()), end.buffers) {
    match end.values(64, flag).eq_bit(BitVec::ofNat(1)) as λ b => (match b {
        False => Ending(words_of(end.values, ns).head_or(BitVec::zero()), end.buffers),
        True => Ending(words_of(end.values, ns).head_or(BitVec::zero()), end.buffers) }) =
            Ending(words_of(end.values, ns).head_or(BitVec::zero()), end.buffers) {
        False => refl,
        True => refl,
    }
}

// ---------------------------------------------------------------------------
// A measured recursion that writes: `rt_loop`'s loop (`Fun::meas_code`,
// its ids and its shape), the pass and the exhausted branch `FTm`'s tail
// lowering. The words kept in place are the span's home.

fn FFun::meas_tail2(all, ks, ws: List<Ty>, res: Ty, body: FTm, w: World, fsigs: List<Sig>, base, o, x: Nat) → Option<Lowered> {
    FTm::lower_tail(body, w, fsigs, base, res, Fun::meas_flag2(ws, x), Fun::param_ids(ks, o), Fun::meas_ns2(ws, x), Ty::bind_onto(all, Nil),
        Fun::ports_onto(all, o, Nil), Fun::meas_flag2(ws, x) + 1)
}

fn FFun::lower_measured_at(all, ks, ws: List<Ty>, body: FTm, res: Ty, w: World, fsigs: List<Sig>, base, lent: Nat) → Option<Function> {
    Ty::check_one_words(w.tys, all).and_then(λ _ => res.check_one_word(w.tys).and_then(λ _ =>
        FTm::lower_tail(body, w, fsigs, base, res, Fun::meas_flag(all, ws), Fun::meas_kept(all, ks), Fun::meas_ns(all, ws), Ty::bind_onto(all, Nil),
            Fun::ports_onto(all, Fun::meas_bnd(all) + 1, Nil), Fun::meas_flag(all, ws) + 1).and_then(λ t =>
        FFun::meas_tail2(all, ks, ws, res, body, w, fsigs, base, t.next + 2, Fun::past(all, t.next + 2)).and_then(λ t2 =>
            Some(Fun::meas_code(all, ks, ws, lent, t, t2))))))
}

// The words kept, then at least one moved: the loop leaves with its result
// as the first moved word.
fn FFun::lower_measured(ks: List<Ty>, w0: Ty, wrest: List<Ty>, body: FTm, res: Ty, w: World, fsigs: List<Sig>, base, lent: Nat) → Option<Function> {
    FFun::lower_measured_at(ks ++ Cons(w0, wrest), ks, Cons(w0, wrest), body, res, w, fsigs, base, lent)
}

// What a measured function that writes owes: its measure, which may read
// the span, is below `2^64`, and its body, its recursion answered by
// anything that agrees with it below the measure, is the function. The
// recursion answers in a word and a span, as the loop's next pass does.
fn FFun::Bounded(ws: List<Ty>, m: List<BitVec(64)> → List<BitVec(8)> → Nat) → Type {
    (own: List<BitVec(8)>) → Ty::ForWords(ws, λ (xs: List<BitVec(64)>) => m(xs, own) < Nat::pow(2, 64))
}

fn FFun::Guarded(ws: List<Ty>, res: Ty, body: FTm, fw: FWorld, h: FTm::Sem(fw.w.tys, Sig(ws, res)), m: List<BitVec(64)> → List<BitVec(8)> → Nat) → Type {
    Ty::ForWords(ws, λ (xs: List<BitVec(64)>) => (own: List<BitVec(8)>) →
        (again: List<BitVec(64)> → List<BitVec(8)> → Mutated<List<BitVec(8)>, BitVec(64)>) →
        ((ys: List<BitVec(64)>) → (o: List<BitVec(8)>) → ys.len() = ws.len() → m(ys, o) < m(xs, own) →
            again(ys, o) = FFun::uncurry(fw.w.tys, ws, res, h, ys, o)) →
        FTm::recast(fw.w.tys, res, Word(64), body.tail_sem(fw, res, λ (ys: List<BitVec(64)>) (o: List<BitVec(8)>) =>
                FTm::recast(fw.w.tys, Word(64), res, again(ys, o)), Ty::bind_onto(ws, Nil), Ty::extend(fw.w.tys, ws, Nil, trivial, xs), own)) =
            FFun::uncurry(fw.w.tys, ws, res, h, xs, own))
}

theorem FFun::pick_same<A>(b: Bool, yes, no: A, same: b = True → yes = no): (match b { False => no, True => yes }) = no {
    (match b as λ c => (c = True → yes = no) → (match c { False => no, True => yes }) = no { False => λ _ => refl, True => λ s => s(refl) })(same)
}

// The same as a family with its recursion keyed apart from its worlds, as
// `Fun::GuardedBy` is for a function that only reads (rt_loop.hthr). A
// function that writes one span and reads others is one function at each
// list of the spans it reads, and a world at each rest of the file: the
// worlds are indexed by `I` and the recursion by `K`, `key` reading an
// index's key and `value` being the function at a key. `again` answers at
// every key, which is what the function's own `f::ext` can use (it asks
// its recursions to agree at every span, read or written), and a pass's own
// recursion is `again` at its world's key. The measure may read the key.
fn FFun::GuardedBy<I, K>(ws: List<Ty>, res: Ty, body: FTm, worlds: I → FWorld, h: (i: I) → FTm::Sem(worlds(i).w.tys, Sig(ws, res)), key: I → K,
    value: K → List<BitVec(64)> → List<BitVec(8)> → Mutated<List<BitVec(8)>, BitVec(64)>, m: K → List<BitVec(64)> → List<BitVec(8)> → Nat) → Type {
    (i: I) → Ty::ForWords(ws, λ (xs: List<BitVec(64)>) => (own: List<BitVec(8)>) →
        (again: K → List<BitVec(64)> → List<BitVec(8)> → Mutated<List<BitVec(8)>, BitVec(64)>) →
        ((k: K) → (ys: List<BitVec(64)>) → (o: List<BitVec(8)>) → ys.len() = ws.len() → m(k, ys, o) < m(key(i), xs, own) →
            again(k, ys, o) = value(k, ys, o)) →
        FTm::recast(worlds(i).w.tys, res, Word(64), body.tail_sem(worlds(i), res, λ (ys: List<BitVec(64)>) (o: List<BitVec(8)>) =>
                FTm::recast(worlds(i).w.tys, Word(64), res, again(key(i), ys, o)), Ty::bind_onto(ws, Nil),
                Ty::extend(worlds(i).w.tys, ws, Nil, trivial, xs), own)) =
            FFun::uncurry(worlds(i).w.tys, ws, res, h(i), xs, own))
}

theorem FFun::guarded_by<I, K>(ws: List<Ty>, res: Ty, body: FTm, worlds: I → FWorld, h: (i: I) → FTm::Sem(worlds(i).w.tys, Sig(ws, res)), key: I → K,
    value: K → List<BitVec(64)> → List<BitVec(8)> → Mutated<List<BitVec(8)>, BitVec(64)>, m: K → List<BitVec(64)> → List<BitVec(8)> → Nat,
    meets: (i: I) → (ys: List<BitVec(64)>) → (o: List<BitVec(8)>) → value(key(i), ys, o) = FFun::uncurry(worlds(i).w.tys, ws, res, h(i), ys, o),
    guarded: FFun::GuardedBy(ws, res, body, worlds, h, key, value, m), i: I):
    FFun::Guarded(ws, res, body, worlds(i), h(i), m(key(i))) {
    let fw = worlds(i);
    let ctx = Ty::bind_onto(ws, Nil);
    Ty::for_words_of(ws, λ (xs: List<BitVec(64)>) => (own: List<BitVec(8)>) →
        (again: List<BitVec(64)> → List<BitVec(8)> → Mutated<List<BitVec(8)>, BitVec(64)>) →
        ((ys: List<BitVec(64)>) → (o: List<BitVec(8)>) → ys.len() = ws.len() → m(key(i), ys, o) < m(key(i), xs, own) →
            again(ys, o) = FFun::uncurry(fw.w.tys, ws, res, h(i), ys, o)) →
        FTm::recast(fw.w.tys, res, Word(64), body.tail_sem(fw, res, λ (ys: List<BitVec(64)>) (o: List<BitVec(8)>) =>
                FTm::recast(fw.w.tys, Word(64), res, again(ys, o)), ctx, Ty::extend(fw.w.tys, ws, Nil, trivial, xs), own)) =
            FFun::uncurry(fw.w.tys, ws, res, h(i), xs, own),
        λ xs len own again hyp => {
            // Where the family's hypothesis speaks: a state of the words'
            // length, below the measure.
            let below = λ (k: K) (ys: List<BitVec(64)>) (o: List<BitVec(8)>) => ys.len().same(ws.len()) && (m(k, ys, o) + 1).leb(m(key(i), xs, own));
            let every = λ (k: K) (ys: List<BitVec(64)>) (o: List<BitVec(8)>) => match below(k, ys, o) {
                False => again(ys, o),
                True => value(k, ys, o),
            };
            let at_xs = Ty::for_words_at(ws, λ (zs: List<BitVec(64)>) => (own2: List<BitVec(8)>) →
                (again2: K → List<BitVec(64)> → List<BitVec(8)> → Mutated<List<BitVec(8)>, BitVec(64)>) →
                ((k: K) → (ys: List<BitVec(64)>) → (o: List<BitVec(8)>) → ys.len() = ws.len() → m(k, ys, o) < m(key(i), zs, own2) →
                    again2(k, ys, o) = value(k, ys, o)) →
                FTm::recast(fw.w.tys, res, Word(64), body.tail_sem(fw, res, λ (ys: List<BitVec(64)>) (o: List<BitVec(8)>) =>
                        FTm::recast(fw.w.tys, Word(64), res, again2(key(i), ys, o)), ctx, Ty::extend(fw.w.tys, ws, Nil, trivial, zs), own2)) =
                    FFun::uncurry(fw.w.tys, ws, res, h(i), zs, own2), guarded(i), xs, len);
            let got = at_xs(own, every, λ k ys o len_ys lt =>
                cong_fn(λ (c: Bool) => match c { False => again(ys, o), True => value(k, ys, o) },
                    eq2(λ (p: Bool) (q: Bool) => p && q, j(len_ys, λ n _ => ys.len().same(n) = True, ys.len().same_self()),
                        Nat::leb_true(m(k, ys, o) + 1, m(key(i), xs, own), lt))));
            let here = λ (ys: List<BitVec(64)>) (o: List<BitVec(8)>) =>
                FFun::pick_same(below(key(i), ys, o), value(key(i), ys, o), again(ys, o), λ yes => {
                    let both = Bool::is_true_and(ys.len().same(ws.len()), (m(key(i), ys, o) + 1).leb(m(key(i), xs, own)),
                        j(sym(yes), λ c _ => c.IsTrue(), trivial));
                    trans(meets(i, ys, o), sym(hyp(ys, o, Nat::same_sound(ys.len(), ws.len(), eq_true_of_is_true(ys.len().same(ws.len()), both.left)),
                        Nat::leb_sound(m(key(i), ys, o) + 1, m(key(i), xs, own), both.right))))
                });
            trans(cong_fn(λ (v: Mutated<List<BitVec(8)>, res.sem(fw.w.tys)>) => FTm::recast(fw.w.tys, res, Word(64), v),
                    sym(FTm::tail_sem_ext(body, fw, res, λ (ys: List<BitVec(64)>) (o: List<BitVec(8)>) =>
                            FTm::recast(fw.w.tys, Word(64), res, every(key(i), ys, o)),
                        λ (ys: List<BitVec(64)>) (o: List<BitVec(8)>) => FTm::recast(fw.w.tys, Word(64), res, again(ys, o)),
                        λ ys o => cong_fn(λ (x: Mutated<List<BitVec(8)>, BitVec(64)>) => FTm::recast(fw.w.tys, Word(64), res, x), here(ys, o)), ctx,
                        Ty::extend(fw.w.tys, ws, Nil, trivial, xs), own))),
                got)
        })
}

// What the loop's code promises: on as many words as parameters, over any
// file `Cons(own, rest)`, the function's word and its span over the rest.
fn FFun::MeasuredHolds(ws: List<Ty>, res: Ty, fw: FWorld, base: Nat, h: FTm::Sem(fw.w.tys, Sig(ws, res)), r: Option<Function>) → Type {
    match r {
        None => True,
        Some(code) => (call: Writers()) → FTm::CallsAgree(fw, base, call) → (own: List<BitVec(8)>) → (xs: List<BitVec(64)>) → xs.len() = ws.len() →
            code.run(call, xs, Cons(own, fw.rest)) = FTm::end_of(fw.rest, FFun::uncurry(fw.w.tys, ws, res, h, xs, own)),
    }
}

// What every end of the loop satisfies, the measure aside: the file's
// other spans are as they were.
fn FFun::Good(rest: List<List<BitVec(8)>>) → Ending → Type { λ e => FTm::Spanned(rest, e.buffers) ∧ (e.rest = []) }

// The recursion the loop is held to: the function, whatever the passes
// left.
fn FFun::meas_run(tys: Table, ws: List<Ty>, res: Ty, rest: List<List<BitVec(8)>>, h: FTm::Sem(tys, Sig(ws, res)),
    m: List<BitVec(64)> → List<BitVec(8)> → Nat) → (r: Nat) → (state: List<BitVec(64)>) → (o: List<BitVec(8)>) → Nat::Lt(m(state, o), r + 1) → Ending {
    λ r state o _ => FTm::end_of(rest, FFun::uncurry(tys, ws, res, h, state, o))
}

fn FFun::Agrees(tys: Table, ws: List<Ty>, res: Ty, rest: List<List<BitVec(8)>>, h: FTm::Sem(tys, Sig(ws, res)),
    m: List<BitVec(64)> → List<BitVec(8)> → Nat, r: Nat, state: List<BitVec(64)>, o: List<BitVec(8)>, end: Ending) → Type {
    LoopAgrees<List<BitVec(8)>>(FFun::Good(rest), m, FFun::meas_run(tys, ws, res, rest, h, m), r, state, o, end)
}

// The later passes, read as the body's recursion: on a state and a span,
// the word they end in and the span they leave.
fn FFun::later_word(rest: List<List<BitVec(8)>>, later: List<BitVec(64)> → Buffers() → Ending) → List<BitVec(64)> → List<BitVec(8)>
    → Mutated<List<BitVec(8)>, BitVec(64)> {
    λ ys o => shared(later(ys, Cons(o, rest)), λ (e: Ending) => Mutated(buffer_bytes(e.buffers, 0), e.word))
}

fn FFun::later_round(tys: Table, res: Ty, rest: List<List<BitVec(8)>>, later: List<BitVec(64)> → Buffers() → Ending) → FTm::Round(tys, res) {
    λ ys o => FTm::recast(tys, Word(64), res, FFun::later_word(rest, later, ys, o))
}

// A pass with passes left is the body, its recursion the later passes,
// where those leave the file's other spans as they were. Nothing is asked
// of what the body means.
theorem FFun::meas_pass_turn(ks, ws: List<Ty>, res: Ty, body: FTm, fw: FWorld, base: Nat,
    ok: Ty::OneWords(fw.w.tys, ks ++ ws), er: res.OneWord(fw.w.tys), t: Lowered,
    lowered: FTm::lower_tail(body, fw.w, fw.fsigs, base, res, Fun::meas_flag(ks ++ ws, ws), Fun::meas_kept(ks ++ ws, ks), Fun::meas_ns(ks ++ ws, ws),
        Ty::bind_onto(ks ++ ws, Nil), Fun::ports_onto(ks ++ ws, Fun::meas_bnd(ks ++ ws) + 1, Nil), Fun::meas_flag(ks ++ ws, ws) + 1) = Some(t),
    call: Writers(), agree: FTm::CallsAgree(fw, base, call), finish: LoopState → Ending,
    left: (v: Valuation()) → (file: Buffers()) → finish(LoopState(LoopEnd(words_of(v, Fun::meas_next(ks ++ ws, ks, ws)), False), file)) =
        Ending(words_of(v, Fun::meas_ns(ks ++ ws, ws)).head_or(BitVec::zero()), file),
    r: Nat, v: Valuation(), own: List<BitVec(8)>,
    good: (state: List<BitVec(64)>) → (o: List<BitVec(8)>) → state.len() = Fun::meas_ps(ks ++ ws).len() →
        FFun::Good(fw.rest, finish(loop_run(λ (pass: Valuation()) (held: Buffers()) => Fun::meas_pass(ks ++ ws, ws, t).run(call, pass, held),
            Fun::meas_ps(ks ++ ws), Fun::meas_c(ks ++ ws), t.next + 1, Fun::meas_next(ks ++ ws, ks, ws), r, state, Cons(o, fw.rest))))):
    loop_pass_run(λ (pass: Valuation()) (held: Buffers()) => Fun::meas_pass(ks ++ ws, ws, t).run(call, pass, held), Fun::meas_ps(ks ++ ws),
        Fun::meas_c(ks ++ ws), t.next + 1, Fun::meas_next(ks ++ ws, ks, ws), finish,
        λ (state: List<BitVec(64)>) (file: Buffers()) => finish(loop_run(λ (pass: Valuation()) (held: Buffers()) =>
            Fun::meas_pass(ks ++ ws, ws, t).run(call, pass, held), Fun::meas_ps(ks ++ ws), Fun::meas_c(ks ++ ws), t.next + 1,
            Fun::meas_next(ks ++ ws, ks, ws), r, state, file)), r, v, Cons(own, fw.rest)) =
        FTm::ended(fw.w.tys, res, fw.rest, body.tail_sem(fw, res, FFun::later_round(fw.w.tys, res, fw.rest,
                λ (state: List<BitVec(64)>) (file: Buffers()) => finish(loop_run(λ (pass: Valuation()) (held: Buffers()) =>
                    Fun::meas_pass(ks ++ ws, ws, t).run(call, pass, held), Fun::meas_ps(ks ++ ws), Fun::meas_c(ks ++ ws), t.next + 1,
                    Fun::meas_next(ks ++ ws, ks, ws), r, state, file))),
            Ty::bind_onto(ks ++ ws, Nil), Ty::extend(fw.w.tys, ks ++ ws, Nil, trivial, words_of(v, Fun::meas_ps(ks ++ ws))), own)) {
    let all = ks ++ ws;
    let tys = fw.w.tys;
    let rest = fw.rest;
    let bnd = Fun::meas_bnd(all);
    let ps = Fun::meas_ps(all);
    let kept = Fun::meas_kept(all, ks);
    let c = Fun::meas_c(all);
    let ns = Fun::meas_ns(all, ws);
    let next = Fun::meas_next(all, ks, ws);
    let flag = Fun::meas_flag(all, ws);
    let ctx = Ty::bind_onto(all, Nil);
    let ports = Fun::ports_onto(all, bnd + 1, Nil);
    let step = λ (pass: Valuation()) (held: Buffers()) => Fun::meas_pass(all, ws, t).run(call, pass, held);
    let later = λ (state: List<BitVec(64)>) (file: Buffers()) => finish(loop_run(step, ps, c, t.next + 1, next, r, state, file));
    let st = words_of(v, ps);
    let len_st: (st.len() = all.len()) = trans(words_of_len(v, ps), Fun::ids_len(all, bnd + 1));
    let counted = Valuation::set(Valuation::zero(), c, word_value(BitVec::ofNat(r + 1)));
    let pv = Valuation::bind(counted, ps, st);
    let env = Ty::extend(tys, all, Nil, trivial, st);
    let held = Fun::meas_env(all, tys, ok, bnd + 1, counted, st, len_st);
    let c_flag: (c < flag + 1) = Nat::lt_of_lt_of_le(c, c + 1, flag + 1, c.lt_succ_self(),
        Nat::le_succ_r(c + 1, flag, Fun::past_ge(ws, c + 1)));
    let below: Below(tys, ctx, ports, flag + 1) = below_mono(tys, ctx, c, flag + 1, Nat::le_of_lt(c, flag + 1, c_flag), ports,
        Fun::below_onto(tys, all, Nil, bnd + 1, Nil, ok, trivial));
    let file: Buffers() = Cons(own, rest);
    let ran = j(lowered, λ o _ => FTm::TailHolds(body, fw, base, res, flag, kept, ns, ctx, ports, flag + 1, o),
        FTm::tail_sound(body, fw, base, res, er, flag, kept, ns, ctx, ports, flag + 1))(call, agree, pv, env, own, held, below);
    let end2 = t.region.run(call, pv, file);
    let pv2 = end2.values;
    let left_file = end2.buffers;
    let pv2a = Valuation::set(pv2, t.next, λ wd => BitVec::ofNat(1));
    let exit_value = bit_value(pv2a(64, flag).eq_bit(pv2a(64, t.next)));
    let pv3 = Valuation::set(pv2a, t.next + 1, exit_value);
    let flag_lt: (flag < t.next) = Nat::lt_of_lt_of_le(flag, flag + 1, t.next, flag.lt_succ_self(), ran.left);
    let exit_bit: (pv3(1, t.next + 1).head_bit() = pv2(64, flag).eq_bit(BitVec::ofNat(1))) =
        trans(cong_fn(λ (x: BitVec(1)) => x.head_bit(), Valuation::set_here(pv2a, t.next + 1, exit_value, 1)),
            eq2(λ (a: BitVec(64)) (b: BitVec(64)) => a.eq_bit(b),
                Valuation::set_other(pv2, t.next, λ wd => BitVec::ofNat(1), 64, flag, Nat::ne_of_lt(flag, t.next, flag_lt)),
                Valuation::set_here(pv2, t.next, λ wd => BitVec::ofNat(1), 64)));
    // Neither id the exit test writes is a next id or a kept one: the kept
    // ids end at or before the count.
    let kept_next: (Fun::past(ks, bnd + 1) <= t.next) = Nat::le_trans(Fun::past(ks, bnd + 1), c, t.next, Fun::past_first(ks, ws, bnd + 1),
        Nat::le_of_lt(c, t.next, Nat::lt_of_lt_of_le(c, flag + 1, t.next, c_flag, ran.left)));
    let ns_out = Fun::absent_ids(ws, c + 1, t.next, Inr(Nat::le_of_lt(flag, t.next, flag_lt)));
    let ns_out2 = Fun::absent_ids(ws, c + 1, t.next + 1, Inr(Nat::le_succ_r(flag, t.next, Nat::le_of_lt(flag, t.next, flag_lt))));
    let kept_out = Fun::absent_ids(ks, bnd + 1, t.next, Inr(kept_next));
    let kept_out2 = Fun::absent_ids(ks, bnd + 1, t.next + 1, Inr(Nat::le_succ_r(Fun::past(ks, bnd + 1), t.next, kept_next)));
    let nexts_same: (words_of(pv3, ns) = words_of(pv2, ns)) = words_agree(ns, pv2, pv3, λ id mem =>
        trans(Valuation::set_other(pv2a, t.next + 1, exit_value, 64, id, λ e => absent_mem(t.next + 1, ns, ns_out2, id, mem, sym(e))),
            Valuation::set_other(pv2, t.next, λ wd => BitVec::ofNat(1), 64, id, λ e => absent_mem(t.next, ns, ns_out, id, mem, sym(e)))));
    let kept_same: (words_of(pv3, kept) = words_of(pv2, kept)) = words_agree(kept, pv2, pv3, λ id mem =>
        trans(Valuation::set_other(pv2a, t.next + 1, exit_value, 64, id, λ e => absent_mem(t.next + 1, kept, kept_out2, id, mem, sym(e))),
            Valuation::set_other(pv2, t.next, λ wd => BitVec::ofNat(1), 64, id, λ e => absent_mem(t.next, kept, kept_out, id, mem, sym(e)))));
    let state_same: (words_of(pv3, next) = words_of(pv2, kept) ++ words_of(pv2, ns)) = trans(Fun::words_append(pv3, kept, ns),
        eq2(λ (a: List<BitVec(64)>) (b: List<BitVec(64)>) => a ++ b, kept_same, nexts_same));
    // The state handed on, and the span it is handed on with.
    let handed = words_of(pv2, kept) ++ words_of(pv2, ns);
    let len_handed: (handed.len() = ps.len()) = trans(List::len_append(words_of(pv2, kept), words_of(pv2, ns)),
        trans(eq2(λ (a: Nat) (b: Nat) => a + b, trans(words_of_len(pv2, kept), Fun::ids_len(ks, bnd + 1)),
                trans(words_of_len(pv2, ns), Fun::ids_len(ws, c + 1))),
            sym(trans(Fun::ids_len(all, bnd + 1), List::len_append(ks, ws)))));
    let span = buffer_bytes(left_file, 0);
    let spanned: FTm::Spanned(rest, left_file) = ran.right.left;
    let onward = later(handed, Cons(span, rest));
    let good_onward: FFun::Good(rest, onward) = good(handed, span, len_handed);
    // The later passes, read as the body's recursion.
    let again: FTm::Round(tys, res) = FFun::later_round(tys, res, rest, later);
    let resumed: (later(handed, left_file) = FTm::resume(tys, res, rest, again, handed, left_file)) =
        trans(cong_fn(λ (f: Buffers()) => later(handed, f), spanned),
            trans(onward.still(Cons(buffer_bytes(onward.buffers, 0), rest), good_onward.left),
                eq2(λ (x: BitVec(64)) (more: List<BitVec(64)>) => Ending(x, Cons(buffer_bytes(onward.buffers, 0), rest), rest := more),
                    sym(Tm::out_into(tys, res, er, onward.word)), good_onward.right)));
    let M = λ (b: Bool) (s: List<BitVec(64)>) (fin: Ending) => match b { False => later(s, left_file), True => fin };
    let turned = FTm::ended(tys, res, rest, body.tail_sem(fw, res, again, ctx, env, own));
    let chain: (loop_pass_run(step, ps, c, t.next + 1, next, finish, later, r, v, file) = turned) =
        trans(cong_fn(λ (fin: Ending) => M(pv3(1, t.next + 1).head_bit(), words_of(pv3, next), fin), left(pv3, left_file)),
            trans(Tm::eq3(M, exit_bit, state_same, cong_fn(λ (s: List<BitVec(64)>) => Ending(s.head_or(BitVec::zero()), left_file), nexts_same)),
                trans(FTm::leave_cont(end2, flag, kept, ns, later, FTm::resume(tys, res, rest, again), resumed), ran.right.right(again))));
    chain
}

// A pass with passes left: whatever the later passes are held to, the
// loop from here is held to it.
theorem FFun::meas_pass_sound(ks, ws: List<Ty>, res: Ty, body: FTm, fw: FWorld, base: Nat, h: FTm::Sem(fw.w.tys, Sig(ks ++ ws, res)),
    ok: Ty::OneWords(fw.w.tys, ks ++ ws), er: res.OneWord(fw.w.tys), m: List<BitVec(64)> → List<BitVec(8)> → Nat,
    guarded: FFun::Guarded(ks ++ ws, res, body, fw, h, m), t: Lowered,
    lowered: FTm::lower_tail(body, fw.w, fw.fsigs, base, res, Fun::meas_flag(ks ++ ws, ws), Fun::meas_kept(ks ++ ws, ks), Fun::meas_ns(ks ++ ws, ws),
        Ty::bind_onto(ks ++ ws, Nil), Fun::ports_onto(ks ++ ws, Fun::meas_bnd(ks ++ ws) + 1, Nil), Fun::meas_flag(ks ++ ws, ws) + 1) = Some(t),
    call: Writers(), agree: FTm::CallsAgree(fw, base, call), finish: LoopState → Ending,
    left: (v: Valuation()) → (file: Buffers()) → finish(LoopState(LoopEnd(words_of(v, Fun::meas_next(ks ++ ws, ks, ws)), False), file)) =
        Ending(words_of(v, Fun::meas_ns(ks ++ ws, ws)).head_or(BitVec::zero()), file),
    r: Nat, v: Valuation(), own: List<BitVec(8)>,
    earlier: (state: List<BitVec(64)>) → (o: List<BitVec(8)>) → state.len() = Fun::meas_ps(ks ++ ws).len() →
        FFun::Agrees(fw.w.tys, ks ++ ws, res, fw.rest, h, m, r, state, o,
            finish(loop_run(λ (pass: Valuation()) (held: Buffers()) => Fun::meas_pass(ks ++ ws, ws, t).run(call, pass, held), Fun::meas_ps(ks ++ ws),
                Fun::meas_c(ks ++ ws), t.next + 1, Fun::meas_next(ks ++ ws, ks, ws), r, state, Cons(o, fw.rest))))):
    FFun::Agrees(fw.w.tys, ks ++ ws, res, fw.rest, h, m, r + 1, words_of(v, Fun::meas_ps(ks ++ ws)), own,
        loop_pass_run(λ (pass: Valuation()) (held: Buffers()) => Fun::meas_pass(ks ++ ws, ws, t).run(call, pass, held), Fun::meas_ps(ks ++ ws),
            Fun::meas_c(ks ++ ws), t.next + 1, Fun::meas_next(ks ++ ws, ks, ws), finish,
            λ (state: List<BitVec(64)>) (file: Buffers()) => finish(loop_run(λ (pass: Valuation()) (held: Buffers()) =>
                Fun::meas_pass(ks ++ ws, ws, t).run(call, pass, held), Fun::meas_ps(ks ++ ws), Fun::meas_c(ks ++ ws), t.next + 1,
                Fun::meas_next(ks ++ ws, ks, ws), r, state, file)), r, v, Cons(own, fw.rest))) {
    let all = ks ++ ws;
    let tys = fw.w.tys;
    let rest = fw.rest;
    let ps = Fun::meas_ps(all);
    let step = λ (pass: Valuation()) (held: Buffers()) => Fun::meas_pass(all, ws, t).run(call, pass, held);
    let later = λ (state: List<BitVec(64)>) (file: Buffers()) => finish(loop_run(step, ps, Fun::meas_c(all), t.next + 1, Fun::meas_next(all, ks, ws), r, state, file));
    let st = words_of(v, ps);
    let len_st: (st.len() = all.len()) = trans(words_of_len(v, ps), Fun::ids_len(all, Fun::meas_bnd(all) + 1));
    let ctx = Ty::bind_onto(all, Nil);
    let again_w = FFun::later_word(rest, later);
    let chain = FFun::meas_pass_turn(ks, ws, res, body, fw, base, ok, er, t, lowered, call, agree, finish, left, r, v, own,
        λ state o len => earlier(state, o, len).left);
    let at_st = Ty::for_words_at(all, λ (xs: List<BitVec(64)>) => (o1: List<BitVec(8)>) →
        (k: List<BitVec(64)> → List<BitVec(8)> → Mutated<List<BitVec(8)>, BitVec(64)>) →
        ((ys: List<BitVec(64)>) → (o: List<BitVec(8)>) → ys.len() = all.len() → m(ys, o) < m(xs, o1) → k(ys, o) = FFun::uncurry(tys, all, res, h, ys, o)) →
        FTm::recast(tys, res, Word(64), body.tail_sem(fw, res, λ (ys: List<BitVec(64)>) (o: List<BitVec(8)>) =>
                FTm::recast(tys, Word(64), res, k(ys, o)), ctx, Ty::extend(tys, all, Nil, trivial, xs), o1)) =
            FFun::uncurry(tys, all, res, h, xs, o1), guarded, st, len_st);
    ⟨j(sym(chain), λ e _ => FFun::Good(rest, e), ⟨refl, refl⟩),
        λ hr => trans(chain, cong_fn(λ (x: Mutated<List<BitVec(8)>, BitVec(64)>) => FTm::end_of(rest, x), at_st(own, again_w, λ ys o len_ys lt =>
            cong_fn(λ (e: Ending) => Mutated(buffer_bytes(e.buffers, 0), e.word),
                    earlier(ys, o, trans(len_ys, sym(Fun::ids_len(all, Fun::meas_bnd(all) + 1)))).right(Nat::lt_of_lt_of_le(m(ys, o), m(st, own), r + 1, lt, hr))))))⟩
}

// What the code answers a self-call with once its passes have run out:
// the span as it is and the first of the words the call moves.
fn FFun::spent(kept: Nat) → List<BitVec(64)> → List<BitVec(8)> → Mutated<List<BitVec(8)>, BitVec(64)> {
    λ ys o => Mutated(o, ys.drop(kept).head_or(BitVec::zero()))
}

// The passes run out: the body once more, its recursion anything that
// answers a state of the function's as `FFun::spent` does.
theorem FFun::meas_zero_turn(ks, ws: List<Ty>, res: Ty, body: FTm, fw: FWorld, base: Nat,
    ok: Ty::OneWords(fw.w.tys, ks ++ ws), er: res.OneWord(fw.w.tys), o, x, o0: Nat, t2: Lowered,
    lowered2: FFun::meas_tail2(ks ++ ws, ks, ws, res, body, fw.w, fw.fsigs, base, o, x) = Some(t2),
    x_at: x = Fun::past(ks ++ ws, o), n0: Nat, ns_rest: List<Nat>, ns_at: Fun::meas_ns2(ws, x) = Cons(n0, ns_rest),
    call: Writers(), agree: FTm::CallsAgree(fw, base, call), values: Valuation(), st: List<BitVec(64)>, len: st.len() = (ks ++ ws).len(),
    own: List<BitVec(8)>, stop: List<BitVec(64)> → List<BitVec(8)> → Mutated<List<BitVec(8)>, BitVec(64)>,
    stops: (ys: List<BitVec(64)>) → (o1: List<BitVec(8)>) → ys.len() = (ks ++ ws).len() → stop(ys, o1) = FFun::spent(ks.len(), ys, o1)):
    loop_finish_run(Fun::post(x, t2.next, o0, Compose(t2.region, nodes_region([Move(64, t2.next, n0)]))), call, values,
        Fun::param_ids(ks ++ ws, o), x, t2.next, LoopState(LoopEnd(st, True), Cons(own, fw.rest))) =
        FTm::ended(fw.w.tys, res, fw.rest, body.tail_sem(fw, res, λ (ys: List<BitVec(64)>) (o1: List<BitVec(8)>) =>
            FTm::recast(fw.w.tys, Word(64), res, stop(ys, o1)), Ty::bind_onto(ks ++ ws, Nil), Ty::extend(fw.w.tys, ks ++ ws, Nil, trivial, st), own)) {
    let all = ks ++ ws;
    let tys = fw.w.tys;
    let rest = fw.rest;
    let os = Fun::param_ids(all, o);
    let kept2 = Fun::param_ids(ks, o);
    let ctx = Ty::bind_onto(all, Nil);
    let ports = Fun::ports_onto(all, o, Nil);
    let flag2 = Fun::meas_flag2(ws, x);
    let ns2 = Fun::meas_ns2(ws, x);
    let bound = Valuation::bind(values, os, st);
    let q = Valuation::set(bound, x, bit_value(True));
    let env = Ty::extend(tys, all, Nil, trivial, st);
    let len_os: (os.len() = st.len()) = trans(Fun::ids_len(all, o), sym(len));
    let x_out = Fun::absent_ids(all, o, x, Inr(j(sym(x_at), λ y _ => Fun::past(all, o) <= y, Fun::past(all, o).le_refl())));
    let read: (words_of(q, os) = st) = trans(words_agree(os, bound, q,
            λ y mem => Valuation::set_other(bound, x, bit_value(True), 64, y, λ e => absent_mem(x, os, x_out, y, mem, sym(e)))),
        words_of_bind(values, os, Fun::ids_distinct(all, o), st, len_os));
    let held: EnvHolds(tys, q, ctx, ports, env) = Fun::env_extend_holds(tys, q, all, Nil, Nil, trivial, o, st, ok, trivial,
        Fun::bound_of_words(q, os, st, len_os, read));
    let x_flag: (x <= flag2 + 1) = Nat::le_succ_r(x, flag2, Nat::le_of_lt(x, flag2,
        Nat::lt_of_lt_of_le(x, x + 1, flag2, x.lt_succ_self(), Fun::past_ge(ws, x + 1))));
    let below: Below(tys, ctx, ports, flag2 + 1) = below_mono(tys, ctx, x, flag2 + 1, x_flag, ports,
        j(sym(x_at), λ y _ => Below(tys, ctx, ports, y), Fun::below_onto(tys, all, Nil, o, Nil, ok, trivial)));
    let file: Buffers() = Cons(own, rest);
    let ran = j(lowered2, λ r _ => FTm::TailHolds(body, fw, base, res, flag2, kept2, ns2, ctx, ports, flag2 + 1, r),
        FTm::tail_sound(body, fw, base, res, er, flag2, kept2, ns2, ctx, ports, flag2 + 1))(call, agree, q, env, own, held, below);
    let end2 = t2.region.run(call, q, file);
    let q2 = end2.values;
    let left_file = end2.buffers;
    let first = words_of(q2, ns2).head_or(BitVec::zero());
    let again: FTm::Round(tys, res) = λ ys o1 => FTm::recast(tys, Word(64), res, stop(ys, o1));
    // The state the body hands on: the kept words, then the moved ones,
    // whose first is what the code answers.
    let handed = words_of(q2, kept2) ++ words_of(q2, ns2);
    let span = buffer_bytes(left_file, 0);
    let kept_len: (words_of(q2, kept2).len() = ks.len()) = trans(words_of_len(q2, kept2), Fun::ids_len(ks, o));
    let len_handed: (handed.len() = all.len()) = trans(List::len_append(words_of(q2, kept2), words_of(q2, ns2)),
        trans(eq2(λ (a: Nat) (b: Nat) => a + b, kept_len, trans(words_of_len(q2, ns2), Fun::ids_len(ws, x + 1))), sym(List::len_append(ks, ws))));
    let dropped: (handed.drop(ks.len()) = words_of(q2, ns2)) = j(kept_len, λ n _ => handed.drop(n) = words_of(q2, ns2),
        List::drop_append_len(words_of(q2, kept2), words_of(q2, ns2)));
    let stopped: (stop(handed, span) = Mutated(span, first)) = trans(stops(handed, span, len_handed),
        cong_fn(λ (l: List<BitVec(64)>) => Mutated(span, l.head_or(BitVec::zero())), dropped));
    let moved: (q2(64, n0) = first) = j(sym(ns_at), λ l _ => q2(64, n0) = words_of(q2, l).head_or(BitVec::zero()), refl);
    let exhausted = Compose(t2.region, nodes_region([Move(64, t2.next, n0)]));
    let turned = FTm::ended(tys, res, rest, body.tail_sem(fw, res, again, ctx, env, own));
    let chain: (loop_finish_run(Fun::post(x, t2.next, o0, exhausted), call, values, os, x, t2.next, LoopState(LoopEnd(st, True), file)) = turned) =
        trans(Fun::post_exhausted_run(x, t2.next, o0, exhausted, call, file, values, os, st),
            trans(cong_fn(λ (word: BitVec(64)) => Ending(word, left_file), trans(Valuation::set_here(q2, t2.next, λ wd => q2(wd, n0), 64), moved)),
                trans(sym(FTm::leave_first(end2, flag2, kept2, ns2)),
                    trans(FTm::leave_cont(end2, flag2, kept2, ns2, λ (ys: List<BitVec(64)>) (f: Buffers()) => Ending(first, f),
                            FTm::resume(tys, res, rest, again),
                            j(sym(stopped), λ u _ =>
                                    Ending(first, left_file) = FTm::ended(tys, res, rest, FTm::recast(tys, Word(64), res, u)),
                                eq2(λ (word: BitVec(64)) (f: Buffers()) => Ending(word, f), sym(Tm::out_into(tys, res, er, first)), ran.right.left))),
                        ran.right.right(again)))));
    chain
}

// The passes run out: the body once more, no recursion being reachable
// where the measure is spent.
theorem FFun::meas_zero_sound(ks, ws: List<Ty>, res: Ty, body: FTm, fw: FWorld, base: Nat, h: FTm::Sem(fw.w.tys, Sig(ks ++ ws, res)),
    ok: Ty::OneWords(fw.w.tys, ks ++ ws), er: res.OneWord(fw.w.tys), m: List<BitVec(64)> → List<BitVec(8)> → Nat,
    guarded: FFun::Guarded(ks ++ ws, res, body, fw, h, m), o, x, o0: Nat, t2: Lowered,
    lowered2: FFun::meas_tail2(ks ++ ws, ks, ws, res, body, fw.w, fw.fsigs, base, o, x) = Some(t2),
    x_at: x = Fun::past(ks ++ ws, o), n0: Nat, ns_rest: List<Nat>, ns_at: Fun::meas_ns2(ws, x) = Cons(n0, ns_rest),
    call: Writers(), agree: FTm::CallsAgree(fw, base, call), values: Valuation(), st: List<BitVec(64)>, len: st.len() = (ks ++ ws).len(),
    own: List<BitVec(8)>):
    FFun::Agrees(fw.w.tys, ks ++ ws, res, fw.rest, h, m, 0, st, own,
        loop_finish_run(Fun::post(x, t2.next, o0, Compose(t2.region, nodes_region([Move(64, t2.next, n0)]))), call, values,
            Fun::param_ids(ks ++ ws, o), x, t2.next, LoopState(LoopEnd(st, True), Cons(own, fw.rest)))) {
    let all = ks ++ ws;
    let tys = fw.w.tys;
    let rest = fw.rest;
    let ctx = Ty::bind_onto(all, Nil);
    let chain = FFun::meas_zero_turn(ks, ws, res, body, fw, base, ok, er, o, x, o0, t2, lowered2, x_at, n0, ns_rest, ns_at, call, agree, values, st, len, own,
        FFun::spent(ks.len()), λ ys o1 _ => refl);
    let at_st = Ty::for_words_at(all, λ (xs: List<BitVec(64)>) => (o1: List<BitVec(8)>) →
        (k: List<BitVec(64)> → List<BitVec(8)> → Mutated<List<BitVec(8)>, BitVec(64)>) →
        ((ys: List<BitVec(64)>) → (o2: List<BitVec(8)>) → ys.len() = all.len() → m(ys, o2) < m(xs, o1) → k(ys, o2) = FFun::uncurry(tys, all, res, h, ys, o2)) →
        FTm::recast(tys, res, Word(64), body.tail_sem(fw, res, λ (ys: List<BitVec(64)>) (o2: List<BitVec(8)>) =>
                FTm::recast(tys, Word(64), res, k(ys, o2)), ctx, Ty::extend(tys, all, Nil, trivial, xs), o1)) =
            FFun::uncurry(tys, all, res, h, xs, o1), guarded, st, len);
    ⟨j(sym(chain), λ e _ => FFun::Good(rest, e), ⟨refl, refl⟩),
        λ hz => trans(chain, cong_fn(λ (u: Mutated<List<BitVec(8)>, BitVec(64)>) => FTm::end_of(rest, u), at_st(own, FFun::spent(ks.len()), λ ys o2 _ lt =>
            false_elim(Nat::lt_of_lt_of_le(m(ys, o2), m(st, own), 0, lt, hz)))))⟩
}

// A measured recursion that writes: its loop runs to it, from its bound
// and `Guarded`.
theorem FFun::measured_sound(ks: List<Ty>, w0: Ty, wrest: List<Ty>, body: FTm, res: Ty, fw: FWorld, base, lent: Nat,
    h: FTm::Sem(fw.w.tys, Sig(ks ++ Cons(w0, wrest), res)), m: List<BitVec(64)> → List<BitVec(8)> → Nat,
    bounded: FFun::Bounded(ks ++ Cons(w0, wrest), m), guarded: FFun::Guarded(ks ++ Cons(w0, wrest), res, body, fw, h, m)):
    FFun::MeasuredHolds(ks ++ Cons(w0, wrest), res, fw, base, h, FFun::lower_measured(ks, w0, wrest, body, res, fw.w, fw.fsigs, base, lent)) {
    let ws = Cons(w0, wrest);
    let all = ks ++ ws;
    let tys = fw.w.tys;
    let rest = fw.rest;
    let P = λ (o: Option<Function>) => FFun::MeasuredHolds(all, res, fw, base, h, o);
    let ctx = Ty::bind_onto(all, Nil);
    let ports = Fun::ports_onto(all, Fun::meas_bnd(all) + 1, Nil);
    let flag = Fun::meas_flag(all, ws);
    let kept = Fun::meas_kept(all, ks);
    let ns = Fun::meas_ns(all, ws);
    Option::and_then_elim(P, trivial, Ty::check_one_words(tys, all), λ _ => res.check_one_word(tys).and_then(λ _ =>
        FTm::lower_tail(body, fw.w, fw.fsigs, base, res, flag, kept, ns, ctx, ports, flag + 1).and_then(λ t =>
            FFun::meas_tail2(all, ks, ws, res, body, fw.w, fw.fsigs, base, t.next + 2, Fun::past(all, t.next + 2)).and_then(λ t2 =>
                Some(Fun::meas_code(all, ks, ws, lent, t, t2))))),
        λ ok _ =>
    Option::and_then_elim(P, trivial, res.check_one_word(tys), λ _ =>
        FTm::lower_tail(body, fw.w, fw.fsigs, base, res, flag, kept, ns, ctx, ports, flag + 1).and_then(λ t =>
            FFun::meas_tail2(all, ks, ws, res, body, fw.w, fw.fsigs, base, t.next + 2, Fun::past(all, t.next + 2)).and_then(λ t2 =>
                Some(Fun::meas_code(all, ks, ws, lent, t, t2)))),
        λ er _ =>
    Option::and_then_elim(P, trivial, FTm::lower_tail(body, fw.w, fw.fsigs, base, res, flag, kept, ns, ctx, ports, flag + 1),
        λ t => FFun::meas_tail2(all, ks, ws, res, body, fw.w, fw.fsigs, base, t.next + 2, Fun::past(all, t.next + 2)).and_then(λ t2 =>
            Some(Fun::meas_code(all, ks, ws, lent, t, t2))),
        λ t lowered =>
    Option::and_then_elim(P, trivial, FFun::meas_tail2(all, ks, ws, res, body, fw.w, fw.fsigs, base, t.next + 2, Fun::past(all, t.next + 2)),
        λ t2 => Some(Fun::meas_code(all, ks, ws, lent, t, t2)), λ t2 lowered2 =>
        λ call agree own xs len => {
            let bnd = Fun::meas_bnd(all);
            let ps = Fun::meas_ps(all);
            let c = Fun::meas_c(all);
            let o = t.next + 2;
            let x = Fun::past(all, o);
            let o0 = Fun::past(ks, o);
            let ids = Fun::param_ids(all, 0);
            let values0 = Valuation::bind(Valuation::zero(), ids, xs);
            let values1 = Valuation::set(values0, bnd, λ wd => BitVec::ofNat(Fun::meas_passes()));
            let exhausted = Compose(t2.region, nodes_region([Move(64, t2.next, x + 1)]));
            let post = Fun::post(x, t2.next, o0, exhausted);
            let fin = loop_finish_run(post, call, values1, Fun::param_ids(all, o), x, t2.next);
            let step = λ (pass: Valuation()) (held: Buffers()) => Fun::meas_pass(all, ws, t).run(call, pass, held);
            let st0 = words_of(values1, ids);
            let len_ids: (ids.len() = xs.len()) = trans(Fun::ids_len(all, 0), sym(len));
            let bnd_out = Fun::absent_ids(all, 0, bnd, Inr(bnd.le_refl()));
            let read: (st0 = xs) = trans(words_agree(ids, values0, values1, λ y mem =>
                    Valuation::set_other(values0, bnd, λ wd => BitVec::ofNat(Fun::meas_passes()), 64, y, λ e => absent_mem(bnd, ids, bnd_out, y, mem, sym(e)))),
                words_of_bind(Valuation::zero(), ids, Fun::ids_distinct(all, 0), xs, len_ids));
            let passes_below: (Fun::meas_passes() < Nat::pow(2, 64)) = trivial;
            let at_bound: (values1(64, bnd).toNat() = Fun::meas_passes()) = trans(
                cong_fn(λ (v: BitVec(64)) => v.toNat(), Valuation::set_here(values0, bnd, λ wd => BitVec::ofNat(Fun::meas_passes()), 64)),
                BitVec::toNat_ofNat(64, Fun::meas_passes(), passes_below));
            let len0: (st0.len() = all.len()) = trans(words_of_len(values1, ids), Fun::ids_len(all, 0));
            let measured0: (m(st0, own) < Nat::pow(2, 64)) =
                Ty::for_words_at(all, λ (ys: List<BitVec(64)>) => m(ys, own) < Nat::pow(2, 64), bounded(own), st0, len0);
            let start: (m(st0, own) < values1(64, bnd).toNat() + 1) = j(sym(at_bound), λ b _ => m(st0, own) < b + 1, measured0);
            // The outputs are the kept words' and then the moved ones', the
            // first of those at `o0`, below the exhausted bit.
            let x_at: (x = Fun::past(ws, o0)) = Fun::past_append(ks, ws, o);
            let o_x: (o0 < x) = j(sym(x_at), λ y _ => o0 < y,
                Nat::lt_of_lt_of_le(o0, o0 + 1, Fun::past(wrest, o0 + 1), o0.lt_succ_self(), Fun::past_ge(wrest, o0 + 1)));
            let os_at: (Fun::param_ids(all, o) = Fun::param_ids(ks, o) ++ Cons(o0, Fun::param_ids(wrest, o0 + 1))) = Fun::ids_append(ks, ws, o);
            let kept_len = λ (v: Valuation()) => trans(Fun::ids_len(ks, o), sym(trans(words_of_len(v, kept), Fun::ids_len(ks, bnd + 1))));
            let left = λ (v: Valuation()) (f: Buffers()) =>
                j(sym(os_at), λ os _ => loop_finish_run(post, call, values1, os, x, t2.next,
                        LoopState(LoopEnd(words_of(v, Fun::meas_next(all, ks, ws)), False), f)) = Ending(v(64, c + 1), f),
                    j(sym(Fun::words_append(v, kept, ns)), λ state _ => loop_finish_run(post, call, values1,
                            Fun::param_ids(ks, o) ++ Cons(o0, Fun::param_ids(wrest, o0 + 1)), x, t2.next, LoopState(LoopEnd(state, False), f)) =
                                Ending(v(64, c + 1), f),
                        Fun::post_left_run(x, t2.next, o0, Fun::param_ids(ks, o), Fun::param_ids(wrest, o0 + 1), exhausted, call, f, values1,
                            words_of(v, kept), v(64, c + 1), words_of(v, Fun::param_ids(wrest, c + 2)), Nat::ne_of_gt(x, o0, o_x),
                            Fun::absent_ids(ks, o, o0, Inr(o0.le_refl())), kept_len(v))));
            let agreed = loop_run_agrees_measured<List<BitVec(8)>>(step, ps, c, t.next + 1, Fun::meas_next(all, ks, ws),
                Fun::ids_distinct(all, bnd + 1), fin, λ (s: List<BitVec(8)>) => Cons(s, rest), FFun::Good(rest), m,
                FFun::meas_run(tys, all, res, rest, h, m),
                λ v s => FFun::meas_zero_sound(ks, ws, res, body, fw, base, h, ok, er, m, guarded, o, x, o0, t2, lowered2, refl, x + 1,
                    Fun::param_ids(wrest, x + 2), refl, call, agree, values1, words_of(v, ps),
                    trans(words_of_len(v, ps), Fun::ids_len(all, bnd + 1)), s),
                λ r v s earlier => FFun::meas_pass_sound(ks, ws, res, body, fw, base, h, ok, er, m, guarded, t, lowered, call, agree, fin, left, r, v, s, earlier),
                values1(64, bnd).toNat(), st0, own, trans(len0, sym(Fun::ids_len(all, bnd + 1))));
            trans(agreed.right(start), cong_fn(λ (l: List<BitVec(64)>) => FTm::end_of(rest, FFun::uncurry(tys, all, res, h, l, own)), read))
        }))))
}

// A measured loop's code answers like the function.
theorem FFun::measured_answers(ws: List<Ty>, res: Ty, fw: FWorld, base: Nat, h: FTm::Sem(fw.w.tys, Sig(ws, res)), r: Option<Function>,
    lowered: (match r { None => False, Some(_) => True }).IsTrue(), held: FFun::MeasuredHolds(ws, res, fw, base, h, r)):
    (call: Writers()) → FTm::CallsAgree(fw, base, call) → (own: List<BitVec(8)>) →
    FTm::Answers(fw.w.tys, ws, res, fw.rest, h(own),
        λ xs => (match r { None => Function([], nodes_region(Nil), 0), Some(c) => c }).run(call, xs, Cons(own, fw.rest))) {
    match r as λ o => (match o { None => False, Some(_) => True }).IsTrue() → FFun::MeasuredHolds(ws, res, fw, base, h, o) →
        (call: Writers()) → FTm::CallsAgree(fw, base, call) → (own: List<BitVec(8)>) →
        FTm::Answers(fw.w.tys, ws, res, fw.rest, h(own),
            λ xs => (match o { None => Function([], nodes_region(Nil), 0), Some(c) => c }).run(call, xs, Cons(own, fw.rest))) {
        None => λ never _ => false_elim(never),
        Some(code) => λ _ holds call agree own => FFun::answers_of_uncurry(fw.w.tys, res, fw.rest, ws, h(own),
            λ xs => code.run(call, xs, Cons(own, fw.rest)), λ xs len => holds(call, agree, own, xs, len)),
    }(lowered, held)
}

// ---------------------------------------------------------------------------
// A loop as the passes it counts
//
// The loop's code counts its passes (`Fun::meas_passes`) and, the count
// spent, runs the body once more with its self-call answered by
// `FFun::spent`. So what the code computes is known at every state without
// a measure: the body iterated as often as the count allows. A function
// that is given as that iteration (`FFun::rounds` of a pass and of what
// answers when the count is spent) is what its code runs to at every
// span, with nothing owed but that the pass is the body
// (`FFun::Passes`, a conversion at a closed body).
//
// This is how a function whose own equation holds only at some spans is
// compiled: a function of a laid record, whose equation is the record's
// and holds where the span holds one (`rt_held.hthr`). What it computes
// elsewhere is this iteration, and is nobody's theorem.

// `pass` of the passes after it, `n` deep, over `pass(stop)`.
fn FFun::rounds<F>(n: Nat, pass: F → F, stop: F) → F {
    match n { Zero => pass(stop), Succ(k) => pass(FFun::rounds(k, pass, stop)) }
}

// `known` on a state of `n` words and `again` on any other: a body's
// self-call passes as many words as the function takes, so at a closed
// body this is `known` by evaluation, and `again` is never read.
fn FFun::pick(n: Nat, again, known: List<BitVec(64)> → List<BitVec(8)> → Mutated<List<BitVec(8)>, BitVec(64)>)
    → List<BitVec(64)> → List<BitVec(8)> → Mutated<List<BitVec(8)>, BitVec(64)> {
    λ ys o => match ys.len().same(n) { False => again(ys, o), True => known(ys, o) }
}

// `pass` is the body: with its self-call answered by `later`, the body is
// `pass(later)`. `at` reads a function as a meaning.
fn FFun::Passes<F>(ws: List<Ty>, res: Ty, body: FTm, fw: FWorld, at: F → FTm::Sem(fw.w.tys, Sig(ws, res)), pass: F → F) → Type {
    (later: F) → Ty::ForWords(ws, λ (xs: List<BitVec(64)>) => (own: List<BitVec(8)>) →
        (again: List<BitVec(64)> → List<BitVec(8)> → Mutated<List<BitVec(8)>, BitVec(64)>) →
        FTm::recast(fw.w.tys, res, Word(64), body.tail_sem(fw, res, λ (ys: List<BitVec(64)>) (o: List<BitVec(8)>) =>
                FTm::recast(fw.w.tys, Word(64), res, FFun::pick(ws.len(), again,
                    λ (zs: List<BitVec(64)>) (p: List<BitVec(8)>) => FFun::uncurry(fw.w.tys, ws, res, at(later), zs, p), ys, o)),
            Ty::bind_onto(ws, Nil), Ty::extend(fw.w.tys, ws, Nil, trivial, xs), own)) =
            FFun::uncurry(fw.w.tys, ws, res, at(pass(later)), xs, own))
}

// `stop` answers as the code does once its count is spent.
fn FFun::Stops<F>(kept: Nat, ws: List<Ty>, res: Ty, tys: Table, at: F → FTm::Sem(tys, Sig(ws, res)), stop: F) → Type {
    Ty::ForWords(ws, λ (xs: List<BitVec(64)>) => (own: List<BitVec(8)>) → FFun::uncurry(tys, ws, res, at(stop), xs, own) = FFun::spent(kept, xs, own))
}

theorem FFun::pick_at(n: Nat, again, known: List<BitVec(64)> → List<BitVec(8)> → Mutated<List<BitVec(8)>, BitVec(64)>, ys: List<BitVec(64)>,
    o: List<BitVec(8)>, len: ys.len() = n): FFun::pick(n, again, known, ys, o) = known(ys, o) {
    cong_fn(λ (b: Bool) => match b { False => again(ys, o), True => known(ys, o) }, j(len, λ k _ => ys.len().same(k) = True, ys.len().same_self()))
}

// The loop's code runs to the iteration, at every span and every state.
theorem FFun::counted_sound<F>(ks: List<Ty>, w0: Ty, wrest: List<Ty>, body: FTm, res: Ty, fw: FWorld, base, lent: Nat,
    at: F → FTm::Sem(fw.w.tys, Sig(ks ++ Cons(w0, wrest), res)), pass: F → F, stop: F,
    passes: FFun::Passes(ks ++ Cons(w0, wrest), res, body, fw, at, pass),
    stops: FFun::Stops(ks.len(), ks ++ Cons(w0, wrest), res, fw.w.tys, at, stop)):
    FFun::MeasuredHolds(ks ++ Cons(w0, wrest), res, fw, base, at(FFun::rounds(Fun::meas_passes(), pass, stop)),
        FFun::lower_measured(ks, w0, wrest, body, res, fw.w, fw.fsigs, base, lent)) {
    let ws = Cons(w0, wrest);
    let all = ks ++ ws;
    let tys = fw.w.tys;
    let rest = fw.rest;
    let P = λ (o: Option<Function>) => FFun::MeasuredHolds(all, res, fw, base, at(FFun::rounds(Fun::meas_passes(), pass, stop)), o);
    let ctx = Ty::bind_onto(all, Nil);
    let ports = Fun::ports_onto(all, Fun::meas_bnd(all) + 1, Nil);
    let flag = Fun::meas_flag(all, ws);
    let kept = Fun::meas_kept(all, ks);
    let ns = Fun::meas_ns(all, ws);
    Option::and_then_elim(P, trivial, Ty::check_one_words(tys, all), λ _ => res.check_one_word(tys).and_then(λ _ =>
        FTm::lower_tail(body, fw.w, fw.fsigs, base, res, flag, kept, ns, ctx, ports, flag + 1).and_then(λ t =>
            FFun::meas_tail2(all, ks, ws, res, body, fw.w, fw.fsigs, base, t.next + 2, Fun::past(all, t.next + 2)).and_then(λ t2 =>
                Some(Fun::meas_code(all, ks, ws, lent, t, t2))))),
        λ ok _ =>
    Option::and_then_elim(P, trivial, res.check_one_word(tys), λ _ =>
        FTm::lower_tail(body, fw.w, fw.fsigs, base, res, flag, kept, ns, ctx, ports, flag + 1).and_then(λ t =>
            FFun::meas_tail2(all, ks, ws, res, body, fw.w, fw.fsigs, base, t.next + 2, Fun::past(all, t.next + 2)).and_then(λ t2 =>
                Some(Fun::meas_code(all, ks, ws, lent, t, t2)))),
        λ er _ =>
    Option::and_then_elim(P, trivial, FTm::lower_tail(body, fw.w, fw.fsigs, base, res, flag, kept, ns, ctx, ports, flag + 1),
        λ t => FFun::meas_tail2(all, ks, ws, res, body, fw.w, fw.fsigs, base, t.next + 2, Fun::past(all, t.next + 2)).and_then(λ t2 =>
            Some(Fun::meas_code(all, ks, ws, lent, t, t2))),
        λ t lowered =>
    Option::and_then_elim(P, trivial, FFun::meas_tail2(all, ks, ws, res, body, fw.w, fw.fsigs, base, t.next + 2, Fun::past(all, t.next + 2)),
        λ t2 => Some(Fun::meas_code(all, ks, ws, lent, t, t2)), λ t2 lowered2 =>
        λ call agree own xs len => {
            let bnd = Fun::meas_bnd(all);
            let ps = Fun::meas_ps(all);
            let c = Fun::meas_c(all);
            let o = t.next + 2;
            let x = Fun::past(all, o);
            let o0 = Fun::past(ks, o);
            let ids = Fun::param_ids(all, 0);
            let values0 = Valuation::bind(Valuation::zero(), ids, xs);
            let values1 = Valuation::set(values0, bnd, λ wd => BitVec::ofNat(Fun::meas_passes()));
            let exhausted = Compose(t2.region, nodes_region([Move(64, t2.next, x + 1)]));
            let post = Fun::post(x, t2.next, o0, exhausted);
            let fin = loop_finish_run(post, call, values1, Fun::param_ids(all, o), x, t2.next);
            let step = λ (pass_v: Valuation()) (held: Buffers()) => Fun::meas_pass(all, ws, t).run(call, pass_v, held);
            let st0 = words_of(values1, ids);
            let len_ids: (ids.len() = xs.len()) = trans(Fun::ids_len(all, 0), sym(len));
            let bnd_out = Fun::absent_ids(all, 0, bnd, Inr(bnd.le_refl()));
            let read: (st0 = xs) = trans(words_agree(ids, values0, values1, λ y mem =>
                    Valuation::set_other(values0, bnd, λ wd => BitVec::ofNat(Fun::meas_passes()), 64, y, λ e => absent_mem(bnd, ids, bnd_out, y, mem, sym(e)))),
                words_of_bind(Valuation::zero(), ids, Fun::ids_distinct(all, 0), xs, len_ids));
            let passes_below: (Fun::meas_passes() < Nat::pow(2, 64)) = trivial;
            let at_bound: (values1(64, bnd).toNat() = Fun::meas_passes()) = trans(
                cong_fn(λ (v: BitVec(64)) => v.toNat(), Valuation::set_here(values0, bnd, λ wd => BitVec::ofNat(Fun::meas_passes()), 64)),
                BitVec::toNat_ofNat(64, Fun::meas_passes(), passes_below));
            let len0: (st0.len() = all.len()) = trans(words_of_len(values1, ids), Fun::ids_len(all, 0));
            let x_at: (x = Fun::past(ws, o0)) = Fun::past_append(ks, ws, o);
            let o_x: (o0 < x) = j(sym(x_at), λ y _ => o0 < y,
                Nat::lt_of_lt_of_le(o0, o0 + 1, Fun::past(wrest, o0 + 1), o0.lt_succ_self(), Fun::past_ge(wrest, o0 + 1)));
            let os_at: (Fun::param_ids(all, o) = Fun::param_ids(ks, o) ++ Cons(o0, Fun::param_ids(wrest, o0 + 1))) = Fun::ids_append(ks, ws, o);
            let kept_len = λ (v: Valuation()) => trans(Fun::ids_len(ks, o), sym(trans(words_of_len(v, kept), Fun::ids_len(ks, bnd + 1))));
            let left = λ (v: Valuation()) (f: Buffers()) =>
                j(sym(os_at), λ os _ => loop_finish_run(post, call, values1, os, x, t2.next,
                        LoopState(LoopEnd(words_of(v, Fun::meas_next(all, ks, ws)), False), f)) = Ending(v(64, c + 1), f),
                    j(sym(Fun::words_append(v, kept, ns)), λ state _ => loop_finish_run(post, call, values1,
                            Fun::param_ids(ks, o) ++ Cons(o0, Fun::param_ids(wrest, o0 + 1)), x, t2.next, LoopState(LoopEnd(state, False), f)) =
                                Ending(v(64, c + 1), f),
                        Fun::post_left_run(x, t2.next, o0, Fun::param_ids(ks, o), Fun::param_ids(wrest, o0 + 1), exhausted, call, f, values1,
                            words_of(v, kept), v(64, c + 1), words_of(v, Fun::param_ids(wrest, c + 2)), Nat::ne_of_gt(x, o0, o_x),
                            Fun::absent_ids(ks, o, o0, Inr(o0.le_refl())), kept_len(v))));
            // What a self-call is answered with, `r` passes left: the
            // iteration that deep.
            let known = λ (r: Nat) (zs: List<BitVec(64)>) (p: List<BitVec(8)>) => FFun::uncurry(tys, all, res, at(FFun::rounds(r, pass, stop)), zs, p);
            let no_measure = λ (state: List<BitVec(64)>) (s: List<BitVec(8)>) => 0;
            let run = λ (r: Nat) (state: List<BitVec(64)>) (s: List<BitVec(8)>) (_: Nat::Lt(0, r + 1)) => FTm::end_of(rest, known(r, state, s));
            let agreed = loop_run_agrees_measured<List<BitVec(8)>>(step, ps, c, t.next + 1, Fun::meas_next(all, ks, ws),
                Fun::ids_distinct(all, bnd + 1), fin, λ (s: List<BitVec(8)>) => Cons(s, rest), FFun::Good(rest), no_measure, run,
                λ v s => {
                    let st = words_of(v, ps);
                    let len_st: (st.len() = all.len()) = trans(words_of_len(v, ps), Fun::ids_len(all, bnd + 1));
                    let stop_w = FFun::pick(all.len(), FFun::spent(ks.len()), λ (zs: List<BitVec(64)>) (p: List<BitVec(8)>) => FFun::uncurry(tys, all, res, at(stop), zs, p));
                    let turn = FFun::meas_zero_turn(ks, ws, res, body, fw, base, ok, er, o, x, o0, t2, lowered2, refl, x + 1,
                        Fun::param_ids(wrest, x + 2), refl, call, agree, values1, st, len_st, s, stop_w,
                        λ ys o1 len_ys => trans(FFun::pick_at(all.len(), FFun::spent(ks.len()),
                                λ (zs: List<BitVec(64)>) (p: List<BitVec(8)>) => FFun::uncurry(tys, all, res, at(stop), zs, p), ys, o1, len_ys),
                            Ty::for_words_at(all, λ (zs: List<BitVec(64)>) => (p: List<BitVec(8)>) →
                                FFun::uncurry(tys, all, res, at(stop), zs, p) = FFun::spent(ks.len(), zs, p), stops, ys, len_ys)(o1)));
                    let passed = Ty::for_words_at(all, λ (zs: List<BitVec(64)>) => (p: List<BitVec(8)>) →
                        (again: List<BitVec(64)> → List<BitVec(8)> → Mutated<List<BitVec(8)>, BitVec(64)>) →
                        FTm::recast(tys, res, Word(64), body.tail_sem(fw, res, λ (ys: List<BitVec(64)>) (o1: List<BitVec(8)>) =>
                                FTm::recast(tys, Word(64), res, FFun::pick(all.len(), again,
                                    λ (us: List<BitVec(64)>) (q: List<BitVec(8)>) => FFun::uncurry(tys, all, res, at(stop), us, q), ys, o1)),
                            ctx, Ty::extend(tys, all, Nil, trivial, zs), p)) =
                            FFun::uncurry(tys, all, res, at(pass(stop)), zs, p), passes(stop), st, len_st)(s, FFun::spent(ks.len()));
                    ⟨j(sym(turn), λ e _ => FFun::Good(rest, e), ⟨refl, refl⟩),
                        λ _ => trans(turn, cong_fn(λ (u: Mutated<List<BitVec(8)>, BitVec(64)>) => FTm::end_of(rest, u), passed))⟩
                },
                λ r v s earlier => {
                    let st = words_of(v, ps);
                    let len_st: (st.len() = all.len()) = trans(words_of_len(v, ps), Fun::ids_len(all, bnd + 1));
                    let later = λ (state: List<BitVec(64)>) (file: Buffers()) =>
                        fin(loop_run(step, ps, c, t.next + 1, Fun::meas_next(all, ks, ws), r, state, file));
                    let again_w = FFun::later_word(rest, later);
                    let turn = FFun::meas_pass_turn(ks, ws, res, body, fw, base, ok, er, t, lowered, call, agree, fin, left, r, v, s,
                        λ state o1 len_s => earlier(state, o1, len_s).left);
                    let picked = FFun::pick(all.len(), again_w, known(r));
                    let same = λ (ys: List<BitVec(64)>) (o1: List<BitVec(8)>) =>
                        FFun::pick_same(ys.len().same(all.len()), known(r, ys, o1), again_w(ys, o1), λ yes =>
                            sym(cong_fn(λ (e: Ending) => Mutated(buffer_bytes(e.buffers, 0), e.word),
                                    earlier(ys, o1, trans(Nat::same_sound(ys.len(), all.len(), yes), sym(Fun::ids_len(all, bnd + 1)))).right(trivial))));
                    let swapped = FTm::tail_sem_ext(body, fw, res, FFun::later_round(tys, res, rest, later),
                        λ (ys: List<BitVec(64)>) (o1: List<BitVec(8)>) => FTm::recast(tys, Word(64), res, picked(ys, o1)),
                        λ ys o1 => cong_fn(λ (u: Mutated<List<BitVec(8)>, BitVec(64)>) => FTm::recast(tys, Word(64), res, u), sym(same(ys, o1))),
                        ctx, Ty::extend(tys, all, Nil, trivial, st), s);
                    let passed = Ty::for_words_at(all, λ (zs: List<BitVec(64)>) => (p: List<BitVec(8)>) →
                        (again: List<BitVec(64)> → List<BitVec(8)> → Mutated<List<BitVec(8)>, BitVec(64)>) →
                        FTm::recast(tys, res, Word(64), body.tail_sem(fw, res, λ (ys: List<BitVec(64)>) (o1: List<BitVec(8)>) =>
                                FTm::recast(tys, Word(64), res, FFun::pick(all.len(), again,
                                    λ (us: List<BitVec(64)>) (q: List<BitVec(8)>) => FFun::uncurry(tys, all, res, at(FFun::rounds(r, pass, stop)), us, q), ys, o1)),
                            ctx, Ty::extend(tys, all, Nil, trivial, zs), p)) =
                            FFun::uncurry(tys, all, res, at(pass(FFun::rounds(r, pass, stop))), zs, p), passes(FFun::rounds(r, pass, stop)), st, len_st)(s, again_w);
                    ⟨j(sym(turn), λ e _ => FFun::Good(rest, e), ⟨refl, refl⟩),
                        λ _ => trans(turn, trans(cong_fn(λ (u: Mutated<List<BitVec(8)>, res.sem(tys)>) => FTm::ended(tys, res, rest, u), swapped),
                            cong_fn(λ (u: Mutated<List<BitVec(8)>, BitVec(64)>) => FTm::end_of(rest, u), passed)))⟩
                },
                values1(64, bnd).toNat(), st0, own, trans(len0, sym(Fun::ids_len(all, bnd + 1))));
            trans(agreed.right(trivial), eq2(λ (n: Nat) (l: List<BitVec(64)>) => FTm::end_of(rest, known(n, l, own)), at_bound, read))
        }))))
}

// Loops over the world in effectful `rt`, lowered to a `Source`'s `Repeat`,
// and their soundness proved once (docs/language/effects-capabilities-design.md §8.6;
// issues/effects-uniqueness-surface.md, slice 5).
//
// A program (`ELoop`) is a chain of loop-free computations (`ETm`, `rt_io`)
// and loops ending in a computation's value. A loop is `while cond { body }`
// whose state is the whole environment: each pass runs `body`, a
// computation, and rebinds every variable to one of the end context's
// (`rebind`), as the surface's `while` threads the locals its body assigns
// and keeps the rest (docs/language/sequencing-surface-design.md §18). It may go
// round forever, so a program's meaning is in `Partial`: the loop is
// `if cond { do body while cond }`, `Io::iterate` of a total pass that runs
// the body and then tests the condition again.
//
// The lowering keeps every variable where it lived before the loop. A pass
// is the body's statements, then moves of each word variable from where
// the body left its new value back to its word, then the condition again
// into a flag word the `Repeat` tests; a buffer variable must end in its
// own buffer. Before the loop the condition is computed once and a `Branch`
// skips the loop when it fails.
//
// Soundness is `Io::iterate_rel` (`linux_world_co`): from an environment
// holding the state at its places, the source's pass and the meaning's
// leave the same world and go on together, at an environment holding the
// next state. Its premise is the loop-free lowering's theorem
// (`ETm::lower_sound`, with the end environment it keeps) and the moves'.
import logic;
import bool;
import nat;
import list;
import option;
import pair;
import bitvec;
import itree;
import coitree;
import coitree_eutt;
import linux_calls;
import linux_trees;
import linux_world;
import linux_world_co;
import function_ir;
import function_ir_eval;
import function_ir_state;
import function_ir_run;
import native_source;
import native_source_co;
import native_source_io;
import rt;
import rt_lower;
import rt_io;
import rt_io_lower;

// ---------------------------------------------------------------------------
// Programs with loops

inductive ELoop {
    // A loop-free computation: its value is the program's.
    Done(t: ETm),
    // A loop-free computation, then the rest in the context it ends in.
    Seq(t: ETm, rest: ELoop),
    // `while cond { body }` over the whole environment: each pass runs
    // `body` and rebinds variable `i` to the end context's variable
    // `rebind[i]`; then the rest.
    While(cond: Tm, body: ETm, rebind: List<Nat>, rest: ELoop),
}

// ---------------------------------------------------------------------------
// The state a pass leaves

// Every variable at its code's default.
fn ELoop::defaults(tys: Table, g: List<Ty>) → rt::Env(tys, g) {
    match g as λ x => rt::Env(tys, x) { Nil => trivial, Cons(t, rest) => Pair(t.default(tys), ELoop::defaults(tys, rest)) }
}

// Each variable of `g` rebound to the end context's variable `rebind`
// names, at its code.
fn ELoop::gather(tys: Table, ce: List<Ty>, ve: rt::Env(tys, ce), g: List<Ty>, rebind: List<Nat>) → rt::Env(tys, g) {
    match g as λ x => rt::Env(tys, x) {
        Nil => trivial,
        Cons(t, rest) => match rebind {
            Nil => Pair(t.default(tys), ELoop::defaults(tys, rest)),
            Cons(n, ns) => Pair(Ty::cast(tys, Ty::at(ce, n), t, Env::get(tys, ce, ve, n)), ELoop::gather(tys, ce, ve, rest, ns)),
        },
    }
}

// Where each rebound value lives at the end of the pass, the codes
// checked: `None` where a variable is rebound to one of another code or to
// none.
fn ELoop::sources(ce: List<Ty>, el: List<Loc>, g: List<Ty>, rebind: List<Nat>) → Option<List<Loc>> {
    match g {
        Nil => match rebind { Nil => Some(Nil), Cons(_, _) => None },
        Cons(t, rest) => match rebind {
            Nil => None,
            Cons(n, ns) => match Ty::at(ce, n).equation(t) {
                Inl(_) => Loc::at(el, n).and_then(λ l => ELoop::sources(ce, el, rest, ns).and_then(λ ls => Some(Cons(l, ls)))),
                Inr(_) => None,
            },
        },
    }
}

fn ELoop::SourcesHold(tys: Table, ce: List<Ty>, el: List<Loc>, g: List<Ty>, rebind: List<Nat>, r: Option<List<Loc>>) → Type {
    match r {
        None => True,
        Some(srcs) => (env: Env) → (ve: rt::Env(tys, ce)) → LocsHold(tys, env, ce, el, ve) →
            LocsHold(tys, env, g, srcs, ELoop::gather(tys, ce, ve, g, rebind)),
    }
}

theorem ELoop::sources_sound(tys: Table, ce: List<Ty>, el: List<Loc>, g: List<Ty>): (rebind: List<Nat>) →
    ELoop::SourcesHold(tys, ce, el, g, rebind, ELoop::sources(ce, el, g, rebind)) {
    match g {
        Nil => λ rebind => match rebind as λ r => ELoop::SourcesHold(tys, ce, el, Nil, r, ELoop::sources(ce, el, Nil, r)) {
            Nil => λ env ve _ => trivial,
            Cons(_, _) => trivial,
        },
        Cons(t, rest) => λ rebind => match rebind as λ r => ELoop::SourcesHold(tys, ce, el, Cons(t, rest), r, ELoop::sources(ce, el, Cons(t, rest), r)) {
            Nil => trivial,
            Cons(n, ns) => {
                let P = λ (r: Option<List<Loc>>) => ELoop::SourcesHold(tys, ce, el, Cons(t, rest), Cons(n, ns), r);
                match Ty::at(ce, n).equation(t) as λ q => P(match q as λ _ => Option<List<Loc>> {
                        Inl(_) => Loc::at(el, n).and_then(λ l => ELoop::sources(ce, el, rest, ns).and_then(λ ls => Some(Cons(l, ls)))),
                        Inr(_) => None,
                    }) {
                    Inl(e) => Option::and_then_elim(P, trivial, Loc::at(el, n), λ l => ELoop::sources(ce, el, rest, ns).and_then(λ ls => Some(Cons(l, ls))),
                        λ l e_l => Option::and_then_elim(P, trivial, ELoop::sources(ce, el, rest, ns), λ ls => Some(Cons(l, ls)), λ ls e_ls =>
                            λ env ve held => ⟨Ty::kept_cast(tys, env, l, Ty::at(ce, n), t, e, Env::get(tys, ce, ve, n),
                                    locs_hold_at(tys, env, ce, el, ve, held, n, l, e_l)),
                                j(e_ls, λ r _ => ELoop::SourcesHold(tys, ce, el, rest, ns, r), ELoop::sources_sound(tys, ce, el, rest, ns))(env, ve, held)⟩)),
                    Inr(_) => trivial,
                }
            },
        },
    }
}

// ---------------------------------------------------------------------------
// The meaning

// The code a program returns.
fn ELoop::ty(self p: ELoop, w: rt::World, g: List<Ty>) → Ty {
    match p {
        Done(t) => t.ty(w, g),
        Seq(t, rest) => rest.ty(w, t.ctx_end(w, g)),
        While(_, _, _, rest) => rest.ty(w, g),
    }
}

// Round again at `s` while the condition holds.
fn ELoop::go<S>(b: Bool, s: S) → Step<S, S> {
    match b { True => Continue(s), False => Break(s) }
}

// One pass: the body, the state rebound from where it ends, and the
// condition tested again.
fn ELoop::step(w: rt::World, ls: List<Lent>, g: List<Ty>, cond: Tm, body: ETm, rebind: List<Nat>) →
    rt::Env(w.tys, g) → Io → Mutated<Io, Step<rt::Env(w.tys, g), rt::Env(w.tys, g)>>
{
    λ vals io => Mutated(body.sem_end(w, ls, g, vals, io).after,
        ELoop::go(ETm::truth(w.tys, Tm::ty(cond, w, g),
                Tm::sem(cond, w, g, ELoop::gather(w.tys, body.ctx_end(w, g), body.sem_end(w, ls, g, vals, io).value, g, rebind))),
            ELoop::gather(w.tys, body.ctx_end(w, g), body.sem_end(w, ls, g, vals, io).value, g, rebind)))
}

// `while cond { body }`: nothing when the condition fails at the start,
// else the passes until it fails, for as long as that takes.
fn ELoop::run_while(w: rt::World, ls: List<Lent>, g: List<Ty>, cond: Tm, body: ETm, rebind: List<Nat>, vals: rt::Env(w.tys, g), io: Io) →
    Partial(Mutated<Io, rt::Env(w.tys, g)>)
{
    match ETm::truth(w.tys, Tm::ty(cond, w, g), Tm::sem(cond, w, g, vals)) {
        True => Io::iterate(Io::total(ELoop::step(w, ls, g, cond, body, rebind)), vals, io),
        False => CRet(Mutated(io, vals)),
    }
}

// The meaning: world threading in `Partial`, at the code the program
// returns. A function of the context, so that the recursion is on the
// program.
fn ELoop::sem(self p: ELoop, w: rt::World, ls: List<Lent>) → (g: List<Ty>) → rt::Env(w.tys, g) → Io → Partial(Mutated<Io, p.ty(w, g).sem(w.tys)>) {
    match p {
        Done(t) => λ g vals io => CRet(t.sem(w, ls, g, vals, io)),
        Seq(t, rest) => λ g vals io => rest.sem(w, ls, t.ctx_end(w, g), t.sem_end(w, ls, g, vals, io).value, t.sem_end(w, ls, g, vals, io).after),
        While(cond, body, rebind, rest) => λ g vals io => CoTree::bind(Events::none(), ELoop::run_while(w, ls, g, cond, body, rebind, vals, io),
            λ m => rest.sem(w, ls, g, m.value, m.after)),
    }
}

// ---------------------------------------------------------------------------
// The lowering

// The loop: the condition into its flag word, and when it holds, the passes
// (body, moves back, condition again) while it does.
fn ELoop::pass(c: Lowered, body: Stmt, moves: Stmt) → Stmt {
    Then(body, Then(moves, Compute(c.region)))
}

fn ELoop::loop_stmt(c: Lowered, body: Stmt, moves: Stmt) → Stmt {
    Then(Compute(c.region), Branch(c.result, Repeat(ELoop::pass(c, body, moves), c.result), Loc::skip()))
}

fn ELoop::lower(self p: ELoop, w: rt::World, ls: List<Lent>, g: List<Ty>, locs: List<Loc>, next: Nat) → Option<ELowered> {
    match p {
        Done(t) => t.lower(w, ls, g, locs, next),
        Seq(t, rest) => t.lower(w, ls, g, locs, next).and_then(λ lt =>
            rest.lower(w, ls, t.ctx_end(w, g), lt.locs, lt.next).and_then(λ lr =>
                Some(ELowered(Then(lt.stmt, lr.stmt), lr.result, lr.next, lr.locs)))),
        While(cond, body, rebind, rest) => Ty::check_bit(Tm::ty(cond, w, g)).and_then(λ _ =>
            ETm::lower_value(cond, w, g, locs, next).and_then(λ c =>
            body.lower(w, ls, g, locs, next).and_then(λ lb =>
            ELoop::sources(body.ctx_end(w, g), lb.locs, g, rebind).and_then(λ srcs =>
            Loc::moves(g, locs, srcs).and_then(λ mv =>
            rest.lower(w, ls, g, locs, next).and_then(λ lr =>
                Some(ELowered(Then(ELoop::loop_stmt(c, lb.stmt, mv), lr.stmt), lr.result, lr.next, lr.locs)))))))),
    }
}

// ---------------------------------------------------------------------------
// Steps up to silent steps

fn ELoop::eutt_of_eq<T>(x: Partial(T), y: Partial(T), e: x = y) → Eutt<T>(Events::none(), x, y) {
    j(e, λ z _ => Eutt<T>(Events::none(), x, z), Eutt::refl(Events::none(), x))
}

fn ELoop::bind_map<A, B, C>(t: Partial(A), k: A → Partial(B), f: B → C) →
    Eutt<C>(Events::none(), CoTree::map(Events::none(), CoTree::bind(Events::none(), t, k), f),
        CoTree::bind(Events::none(), t, λ a => CoTree::map(Events::none(), k(a), f)))
{
    Eutt::of_bisim(Events::none(), CoTree::map(Events::none(), CoTree::bind(Events::none(), t, k), f),
        CoTree::bind(Events::none(), t, λ a => CoTree::map(Events::none(), k(a), f)),
        CoTree::bind_assoc(Events::none(), t, k, λ r => CRet(f(r))))
}

// A computation that returns `m` (up to silent steps), followed by `k`.
fn ELoop::bind_ret<A, B>(t: Partial(A), m: A, k: A → Partial(B), e: Eutt<A>(Events::none(), t, CRet(m))) →
    Eutt<B>(Events::none(), CoTree::bind(Events::none(), t, k), k(m))
{
    Eutt::trans(Events::none(), CoTree::bind(Events::none(), t, k), CoTree::bind(Events::none(), CRet(m), k), k(m),
        Eutt::bind_cong_l(Events::none(), t, CRet(m), k, e), Eutt::bind_ret_l(Events::none(), m, k))
}

// ---------------------------------------------------------------------------
// Soundness

// The program's value read back from its word, the world as the statements
// left it.
fn ELoop::back(t: Ty, tys: Table, result: Nat, m: Mutated<Io, Flow>) → Mutated<Io, t.sem(tys)> {
    Mutated(m.after, m.value.read_back(t, tys, result))
}

// What a lowering promises: from any environment holding the variables, at
// any world, the statements' threading, its value read back, is the
// program's meaning up to silent steps.
fn ELoop::LowerHolds(self p: ELoop, w: rt::World, ls: List<Lent>, g: List<Ty>, locs: List<Loc>, next: Nat, r: Option<ELowered>) → Type {
    match r {
        None => True,
        Some(l) => (call: Writers()) → Writers::Still(call, functions_below(w.sigs.len())) → ((held: Buffers()) → Tm::CallsAgree(w, Writers::words(call, held))) →
            ETm::LentsAgree(ls, call) → (perform: PerformsCo()) → (env: Env) → (vals: rt::Env(w.tys, g)) → (io: Io) →
            LocsHold(w.tys, env, g, locs, vals) → LocsBelow(locs, next) → 0 < next →
            Eutt<Mutated<Io, p.ty(w, g).sem(w.tys)>>(Events::none(),
                CoTree::map(Events::none(), l.stmt.run(call, perform)(env, io), λ m => ELoop::back(p.ty(w, g), w.tys, l.result, m)),
                p.sem(w, ls, g, vals, io)),
    }
}

// The rest of a program after a statement that left `flow`: its lowering's
// promise, where the flow goes on holding the rest's variables.
fn ELoop::rest_holds(rest: ELoop, w: rt::World, ls: List<Lent>, g: List<Ty>, locs: List<Loc>, next: Nat, lr: ELowered,
    rh: ELoop::LowerHolds(rest, w, ls, g, locs, next, Some(lr)), call: Writers(), still: Writers::Still(call, functions_below(w.sigs.len())), agree: (held: Buffers()) → Tm::CallsAgree(w, Writers::words(call, held)),
    lents: ETm::LentsAgree(ls, call), perform: PerformsCo(),
    below: LocsBelow(locs, next), pos: 0 < next, vals: rt::Env(w.tys, g)) → (flow: Flow) → (io: Io) → flow.KeepsAll(w.tys, g, locs, vals) →
    Eutt<Mutated<Io, rest.ty(w, g).sem(w.tys)>>(Events::none(),
        CoTree::map(Events::none(), Stmt::then_run(λ io2 env2 => lr.stmt.run(call, perform)(env2, io2), Mutated(io, flow)),
            λ m => ELoop::back(rest.ty(w, g), w.tys, lr.result, m)),
        rest.sem(w, ls, g, vals, io))
{
    λ flow => match flow {
        Onward(env) => λ io held => rh(call, still, agree, lents, perform, env, vals, io, held, below, pos),
        Exited(_) => λ io never => false_elim(never),
    }
}

// ---------------------------------------------------------------------------
// A pass, source and meaning together

// The relation the loop keeps: the environment holds the state where it
// lives; and out of the loop, the flow goes on holding it.
fn ELoop::Held(tys: Table, g: List<Ty>, locs: List<Loc>) → Env → rt::Env(tys, g) → Type {
    λ e v => LocsHold(tys, e, g, locs, v)
}

fn ELoop::Left(tys: Table, g: List<Ty>, locs: List<Loc>) → Flow → rt::Env(tys, g) → Type {
    λ f v => f.KeepsAll(tys, g, locs, v)
}

// A pass of the source as a total step of its loop.
fn ELoop::pass_total(call: Writers(), c: Lowered, body: Stmt, moves: Stmt) → Env → Io → Mutated<Io, Step<Env, Flow>> {
    λ e io => Mutated(Stmt::thread(ELoop::pass(c, body, moves), call, e, io).after,
        Stmt::thread(ELoop::pass(c, body, moves), call, e, io).value.pass(c.result))
}

// The condition again, from an environment holding the next state: the
// flag goes round exactly when the meaning does.
theorem ELoop::cond_step(w: rt::World, g: List<Ty>, locs: List<Loc>, next: Nat, cond: Tm, c: Lowered,
    vh: ETm::ValueHolds(cond, w, g, locs, next, Some(c)), eb: Tm::ty(cond, w, g) = Bit,
    call: Writers(), still: Writers::Still(call, functions_below(w.sigs.len())), agree: (held: Buffers()) → Tm::CallsAgree(w, Writers::words(call, held)), below: LocsBelow(locs, next), pos: 0 < next,
    em: Env, v2: rt::Env(w.tys, g), held: LocsHold(w.tys, em, g, locs, v2)):
    Io::StepRel(ELoop::Held(w.tys, g, locs), ELoop::Left(w.tys, g, locs), Onward(em.compute(call, c.region)).pass(c.result),
        ELoop::go(ETm::truth(w.tys, Tm::ty(cond, w, g), Tm::sem(cond, w, g, v2)), v2))
{
    let ran = vh.right(call, still, agree, em, v2, held, below, pos);
    let ec = em.compute(call, c.region);
    let hc: LocsHold(w.tys, ec, g, locs, v2) = ran.right.right;
    let bit = ETm::bit_kept(w.tys, ec, c.result, Tm::ty(cond, w, g), eb, Tm::sem(cond, w, g, v2), ran.right.left);
    j(sym(bit), λ y _ => Io::StepRel(ELoop::Held(w.tys, g, locs), ELoop::Left(w.tys, g, locs),
            match y as λ _ => Step<Env, Flow> { True => Continue(ec), False => Break(Onward(ec)) },
            ELoop::go(ETm::truth(w.tys, Tm::ty(cond, w, g), Tm::sem(cond, w, g, v2)), v2)),
        match ETm::truth(w.tys, Tm::ty(cond, w, g), Tm::sem(cond, w, g, v2)) as λ b =>
                Io::StepRel(ELoop::Held(w.tys, g, locs), ELoop::Left(w.tys, g, locs),
                    match b as λ _ => Step<Env, Flow> { True => Continue(ec), False => Break(Onward(ec)) }, ELoop::go(b, v2)) {
            True => hc,
            False => hc,
        })
}

// After the moves.
theorem ELoop::moved_step(w: rt::World, g: List<Ty>, locs: List<Loc>, next: Nat, cond: Tm, c: Lowered,
    vh: ETm::ValueHolds(cond, w, g, locs, next, Some(c)), eb: Tm::ty(cond, w, g) = Bit,
    call: Writers(), still: Writers::Still(call, functions_below(w.sigs.len())), agree: (held: Buffers()) → Tm::CallsAgree(w, Writers::words(call, held)), below: LocsBelow(locs, next), pos: 0 < next, v2: rt::Env(w.tys, g)):
    (flow: Flow) → (a: Io) → flow.KeepsAll(w.tys, g, locs, v2) →
    (Stmt::then_thread(Compute(c.region), call, Mutated(a, flow)).after = a) ∧
    Io::StepRel(ELoop::Held(w.tys, g, locs), ELoop::Left(w.tys, g, locs), Stmt::then_thread(Compute(c.region), call, Mutated(a, flow)).value.pass(c.result),
        ELoop::go(ETm::truth(w.tys, Tm::ty(cond, w, g), Tm::sem(cond, w, g, v2)), v2))
{
    λ flow => match flow {
        Onward(em) => λ a held => ⟨refl, ELoop::cond_step(w, g, locs, next, cond, c, vh, eb, call, still, agree, below, pos, em, v2, held)⟩,
        Exited(_) => λ a never => false_elim(never),
    }
}

// After the body: the moves from where it left the next state, then the
// condition.
theorem ELoop::body_step(w: rt::World, g: List<Ty>, locs: List<Loc>, next: Nat, cond: Tm, c: Lowered,
    vh: ETm::ValueHolds(cond, w, g, locs, next, Some(c)), eb: Tm::ty(cond, w, g) = Bit,
    call: Writers(), still: Writers::Still(call, functions_below(w.sigs.len())), agree: (held: Buffers()) → Tm::CallsAgree(w, Writers::words(call, held)), below: LocsBelow(locs, next), pos: 0 < next,
    ce: List<Ty>, el: List<Loc>, rebind: List<Nat>, srcs: List<Loc>, mv: Stmt,
    sh: ELoop::SourcesHold(w.tys, ce, el, g, rebind, Some(srcs)), mh: Loc::MovesHold(w.tys, g, locs, srcs, Some(mv)), ve: rt::Env(w.tys, ce)):
    (flow: Flow) → (a: Io) → flow.KeepsAll(w.tys, ce, el, ve) →
    (Stmt::then_thread(Then(mv, Compute(c.region)), call, Mutated(a, flow)).after = a) ∧
    Io::StepRel(ELoop::Held(w.tys, g, locs), ELoop::Left(w.tys, g, locs),
        Stmt::then_thread(Then(mv, Compute(c.region)), call, Mutated(a, flow)).value.pass(c.result),
        ELoop::go(ETm::truth(w.tys, Tm::ty(cond, w, g), Tm::sem(cond, w, g, ELoop::gather(w.tys, ce, ve, g, rebind))),
            ELoop::gather(w.tys, ce, ve, g, rebind)))
{
    λ flow => match flow {
        Onward(eb2) => λ a ka => {
            let v2 = ELoop::gather(w.tys, ce, ve, g, rebind);
            let mres = mh.right(call, eb2, v2, a, sh(eb2, ve, ka));
            let mm = Stmt::thread(mv, call, eb2, a);
            let r = ELoop::moved_step(w, g, locs, next, cond, c, vh, eb, call, still, agree, below, pos, v2, mm.value, mm.after, mres.right.left);
            ⟨trans(r.left, mres.left), r.right⟩
        },
        Exited(_) => λ a never => false_elim(never),
    }
}

// A whole pass: the source's and the meaning's leave the same world and go
// on together.
theorem ELoop::pass_rel(w: rt::World, ls: List<Lent>, g: List<Ty>, locs: List<Loc>, next: Nat, cond: Tm, c: Lowered,
    vh: ETm::ValueHolds(cond, w, g, locs, next, Some(c)), eb: Tm::ty(cond, w, g) = Bit,
    call: Writers(), still: Writers::Still(call, functions_below(w.sigs.len())), agree: (held: Buffers()) → Tm::CallsAgree(w, Writers::words(call, held)),
    lents: ETm::LentsAgree(ls, call), below: LocsBelow(locs, next), pos: 0 < next,
    body: ETm, lb: ELowered, bh: ETm::LowerHolds(body, w, ls, g, locs, next, Some(lb)), rebind: List<Nat>, srcs: List<Loc>, mv: Stmt,
    sh: ELoop::SourcesHold(w.tys, body.ctx_end(w, g), lb.locs, g, rebind, Some(srcs)), mh: Loc::MovesHold(w.tys, g, locs, srcs, Some(mv))):
    (env: Env) → (vals: rt::Env(w.tys, g)) → ELoop::Held(w.tys, g, locs)(env, vals) → (io: Io) →
    (ELoop::pass_total(call, c, lb.stmt, mv)(env, io).after = ELoop::step(w, ls, g, cond, body, rebind)(vals, io).after) ∧
    Io::StepRel(ELoop::Held(w.tys, g, locs), ELoop::Left(w.tys, g, locs),
        ELoop::pass_total(call, c, lb.stmt, mv)(env, io).value, ELoop::step(w, ls, g, cond, body, rebind)(vals, io).value)
{
    λ env vals held io => {
        let bres = bh.right(call, still, agree, lents, env, vals, io, held, below, pos);
        let mb = Stmt::thread(lb.stmt, call, env, io);
        let r = ELoop::body_step(w, g, locs, next, cond, c, vh, eb, call, still, agree, below, pos, body.ctx_end(w, g), lb.locs, rebind, srcs, mv, sh, mh,
            body.sem_end(w, ls, g, vals, io).value, mb.value, mb.after, bres.right.left);
        ⟨trans(r.left, trans(bres.left.left, sym(body.sem_end_after(w, ls, g, vals, io)))), r.right⟩
    }
}

// ---------------------------------------------------------------------------
// The theorem, construct by construct

// A loop-free computation: its statements return what their threading
// does, which lands where the meaning does.
theorem ELoop::done_holds(t: ETm, w: rt::World, ls: List<Lent>, g: List<Ty>, locs: List<Loc>, next: Nat): (r: Option<ELowered>) →
    ETm::LowerHolds(t, w, ls, g, locs, next, r) → ELoop::LowerHolds(ELoop::Done(t), w, ls, g, locs, next, r) {
    λ r => match r {
        None => λ _ => trivial,
        Some(l) => λ h call still agree lents perform env vals io held below pos => {
            let m = Stmt::thread(l.stmt, call, env, io);
            let lands = h.right(call, still, agree, lents, env, vals, io, held, below, pos).left;
            let ty = t.ty(w, g);
            let same: (ELoop::back(ty, w.tys, l.result, m) = t.sem(w, ls, g, vals, io)) =
                eq2<Io, ty.sem(w.tys), Mutated<Io, ty.sem(w.tys)>>(λ a x => Mutated(a, x), lands.left,
                    m.value.read_back_keeps(ty, w.tys, l.result, t.sem(w, ls, g, vals, io).value, lands.right));
            Eutt::trans(Events::none(),
                CoTree::map(Events::none(), l.stmt.run(call, perform)(env, io), λ m2 => ELoop::back(ty, w.tys, l.result, m2)),
                CRet(ELoop::back(ty, w.tys, l.result, m)), CRet(t.sem(w, ls, g, vals, io)),
                ELoop::bind_ret<Mutated<Io, Flow>, Mutated<Io, ty.sem(w.tys)>>(l.stmt.run(call, perform)(env, io), m,
                    λ m2 => CRet(ELoop::back(ty, w.tys, l.result, m2)), Stmt::run_straight(l.stmt, call, perform, h.left, env, io)),
                ELoop::eutt_of_eq<Mutated<Io, ty.sem(w.tys)>>(CRet(ELoop::back(ty, w.tys, l.result, m)), CRet(t.sem(w, ls, g, vals, io)),
                    cong_fn(λ (x: Mutated<Io, ty.sem(w.tys)>) => CRet(x), same)))
        },
    }
}

// A loop-free computation, then the rest from where it ends.
theorem ELoop::seq_holds(t: ETm, rest: ELoop, w: rt::World, ls: List<Lent>, g: List<Ty>, locs: List<Loc>, next: Nat,
    lt: ELowered, ht: ETm::LowerHolds(t, w, ls, g, locs, next, Some(lt)),
    lr: ELowered, hr: ELoop::LowerHolds(rest, w, ls, t.ctx_end(w, g), lt.locs, lt.next, Some(lr))):
    ELoop::LowerHolds(ELoop::Seq(t, rest), w, ls, g, locs, next, Some(ELowered(Then(lt.stmt, lr.stmt), lr.result, lr.next, lr.locs)))
{
    λ call still agree lents perform env vals io held below pos => {
        let ce = t.ctx_end(w, g);
        let mt = Stmt::thread(lt.stmt, call, env, io);
        let res = ht.right(call, still, agree, lents, env, vals, io, held, below, pos);
        let ty = rest.ty(w, ce);
        let k = λ (m: Mutated<Io, Flow>) => CoTree::map(Events::none(), Stmt::then_run(λ io2 env2 => lr.stmt.run(call, perform)(env2, io2), m),
            λ m2 => ELoop::back(ty, w.tys, lr.result, m2));
        let ve = t.sem_end(w, ls, g, vals, io);
        let after: (mt.after = ve.after) = trans(res.left.left, sym(t.sem_end_after(w, ls, g, vals, io)));
        let pos2: (0 < lt.next) = Nat::lt_of_lt_of_le(0, next, lt.next, pos, res.right.right.right);
        let rest_at = ELoop::rest_holds(rest, w, ls, ce, lt.locs, lt.next, lr, hr, call, still, agree, lents, perform, res.right.right.left, pos2, ve.value,
            mt.value, mt.after, res.right.left);
        Eutt::trans(Events::none(),
            CoTree::map(Events::none(), Stmt::run(Then(lt.stmt, lr.stmt), call, perform)(env, io), λ m2 => ELoop::back(ty, w.tys, lr.result, m2)),
            CoTree::bind(Events::none(), lt.stmt.run(call, perform)(env, io), k),
            rest.sem(w, ls, ce, ve.value, ve.after),
            ELoop::bind_map<Mutated<Io, Flow>, Mutated<Io, Flow>, Mutated<Io, ty.sem(w.tys)>>(lt.stmt.run(call, perform)(env, io),
                λ m => Stmt::then_run(λ io2 env2 => lr.stmt.run(call, perform)(env2, io2), m), λ m2 => ELoop::back(ty, w.tys, lr.result, m2)),
            Eutt::trans(Events::none(), CoTree::bind(Events::none(), lt.stmt.run(call, perform)(env, io), k), k(mt), rest.sem(w, ls, ce, ve.value, ve.after),
                ELoop::bind_ret<Mutated<Io, Flow>, Mutated<Io, ty.sem(w.tys)>>(lt.stmt.run(call, perform)(env, io), mt, k,
                    Stmt::run_straight(lt.stmt, call, perform, ht.left, env, io)),
                j(after, λ y _ => Eutt<Mutated<Io, ty.sem(w.tys)>>(Events::none(), k(mt), rest.sem(w, ls, ce, ve.value, y)), rest_at)))
    }
}

// A loop, then the rest from the state it leaves.
theorem ELoop::while_holds(cond: Tm, body: ETm, rebind: List<Nat>, rest: ELoop, w: rt::World, ls: List<Lent>, g: List<Ty>, locs: List<Loc>, next: Nat,
    eb: Tm::ty(cond, w, g) = Bit, c: Lowered, vh: ETm::ValueHolds(cond, w, g, locs, next, Some(c)),
    lb: ELowered, bh: ETm::LowerHolds(body, w, ls, g, locs, next, Some(lb)),
    srcs: List<Loc>, sh: ELoop::SourcesHold(w.tys, body.ctx_end(w, g), lb.locs, g, rebind, Some(srcs)),
    mv: Stmt, mh: Loc::MovesHold(w.tys, g, locs, srcs, Some(mv)),
    lr: ELowered, hr: ELoop::LowerHolds(rest, w, ls, g, locs, next, Some(lr))):
    ELoop::LowerHolds(ELoop::While(cond, body, rebind, rest), w, ls, g, locs, next,
        Some(ELowered(Then(ELoop::loop_stmt(c, lb.stmt, mv), lr.stmt), lr.result, lr.next, lr.locs)))
{
    λ call still agree lents perform env vals io held below pos => {
        let cr = c.result;
        let ty = rest.ty(w, g);
        let pass = ELoop::pass(c, lb.stmt, mv);
        let branch = Branch(cr, Repeat(pass, cr), Loc::skip());
        let KE = λ (m: Mutated<Io, rt::Env(w.tys, g)>) => rest.sem(w, ls, g, m.value, m.after);
        let KR = λ (m: Mutated<Io, Flow>) => CoTree::map(Events::none(), Stmt::then_run(λ io2 env2 => lr.stmt.run(call, perform)(env2, io2), m),
            λ m2 => ELoop::back(ty, w.tys, lr.result, m2));
        let ran = vh.right(call, still, agree, env, vals, held, below, pos);
        let env1 = env.compute(call, c.region);
        let held1: LocsHold(w.tys, env1, g, locs, vals) = ran.right.right;
        let cv = Tm::sem(cond, w, g, vals);
        let truth = ETm::truth(w.tys, Tm::ty(cond, w, g), cv);
        let bit: (env1.bit(cr) = truth) = ETm::bit_kept(w.tys, env1, cr, Tm::ty(cond, w, g), eb, cv, ran.right.left);
        let straight: pass.straight().IsTrue() = Bool::is_true_and_intro(lb.stmt.straight(), Then(mv, Compute(c.region)).straight(), bh.left,
            Bool::is_true_and_intro(mv.straight(), True, mh.left, trivial));
        let fS = ELoop::pass_total(call, c, lb.stmt, mv);
        let fE = ELoop::step(w, ls, g, cond, body, rebind);
        let stepS = λ (e: Env) (io2: Io) => CoTree::bind(Events::none(), pass.run(call, perform)(e, io2), λ m => Stmt::pass_step(cr, m));
        let rest_at = λ (flow: Flow) (v2: rt::Env(w.tys, g)) (q: ELoop::Left(w.tys, g, locs)(flow, v2)) (io2: Io) =>
            ELoop::rest_holds(rest, w, ls, g, locs, next, lr, hr, call, still, agree, lents, perform, below, pos, v2, flow, io2, q);
        // The loop and the meaning's `while`, at the condition's value.
        let at: Eutt<Mutated<Io, ty.sem(w.tys)>>(Events::none(),
                CoTree::bind(Events::none(), match truth as λ _ => Partial(Mutated<Io, Flow>) {
                    True => Stmt::run(Repeat(pass, cr), call, perform)(env1, io),
                    False => Stmt::run(Loc::skip(), call, perform)(env1, io),
                }, KR),
                CoTree::bind(Events::none(), match truth as λ _ => Partial(Mutated<Io, rt::Env(w.tys, g)>) {
                    True => Io::iterate(Io::total(fE), vals, io),
                    False => CRet(Mutated(io, vals)),
                }, KE)) =
            match truth as λ b => Eutt<Mutated<Io, ty.sem(w.tys)>>(Events::none(),
                    CoTree::bind(Events::none(), match b as λ _ => Partial(Mutated<Io, Flow>) {
                        True => Stmt::run(Repeat(pass, cr), call, perform)(env1, io),
                        False => Stmt::run(Loc::skip(), call, perform)(env1, io),
                    }, KR),
                    CoTree::bind(Events::none(), match b as λ _ => Partial(Mutated<Io, rt::Env(w.tys, g)>) {
                        True => Io::iterate(Io::total(fE), vals, io),
                        False => CRet(Mutated(io, vals)),
                    }, KE)) {
                True => Eutt::trans(Events::none(),
                    CoTree::bind(Events::none(), Io::iterate<Env, Flow>(stepS, env1, io), KR),
                    CoTree::bind(Events::none(), Io::iterate(Io::total(fS), env1, io), KR),
                    CoTree::bind(Events::none(), Io::iterate(Io::total(fE), vals, io), KE),
                    Eutt::bind_cong_l(Events::none(), Io::iterate<Env, Flow>(stepS, env1, io), Io::iterate(Io::total(fS), env1, io), KR,
                        Io::iterate_cong<Env, Flow>(stepS, Io::total(fS),
                            λ e io2 => ELoop::bind_ret<Mutated<Io, Flow>, Mutated<Io, Step<Env, Flow>>>(pass.run(call, perform)(e, io2),
                                Stmt::thread(pass, call, e, io2), λ m => Stmt::pass_step(cr, m), Stmt::run_straight(pass, call, perform, straight, e, io2)),
                            env1, io)),
                    Io::iterate_rel(fS, fE, ELoop::Held(w.tys, g, locs), ELoop::Left(w.tys, g, locs),
                        ELoop::pass_rel(w, ls, g, locs, next, cond, c, vh, eb, call, still, agree, lents, below, pos, body, lb, bh, rebind, srcs, mv, sh, mh),
                        KR, KE, rest_at, env1, vals, held1, io)),
                False => {
                    let env2 = env1.compute(call, Loc::nothing());
                    let held2 = locs_hold_same(w.tys, env1, env2, g, locs, vals, Loc::skip_same(env1, call, locs), held1);
                    Eutt::trans(Events::none(),
                        CoTree::bind(Events::none(), CRet(Mutated(io, Onward(env2))), KR),
                        rest.sem(w, ls, g, vals, io),
                        CoTree::bind(Events::none(), CRet(Mutated(io, vals)), KE),
                        Eutt::trans(Events::none(), CoTree::bind(Events::none(), CRet(Mutated(io, Onward(env2))), KR), KR(Mutated(io, Onward(env2))),
                            rest.sem(w, ls, g, vals, io),
                            Eutt::bind_ret_l(Events::none(), Mutated(io, Onward(env2)), KR), rest_at(Onward(env2), vals, held2, io)),
                        Eutt::sym(Events::none(), CoTree::bind(Events::none(), CRet(Mutated(io, vals)), KE), rest.sem(w, ls, g, vals, io),
                            Eutt::bind_ret_l(Events::none(), Mutated(io, vals), KE)))
                },
            };
        let loop_run = Stmt::run(ELoop::loop_stmt(c, lb.stmt, mv), call, perform)(env, io);
        let branch_run = Stmt::run(branch, call, perform)(env1, io);
        Eutt::trans(Events::none(),
            CoTree::map(Events::none(), Stmt::run(Then(ELoop::loop_stmt(c, lb.stmt, mv), lr.stmt), call, perform)(env, io),
                λ m2 => ELoop::back(ty, w.tys, lr.result, m2)),
            CoTree::bind(Events::none(), loop_run, KR),
            ELoop::sem(ELoop::While(cond, body, rebind, rest), w, ls, g, vals, io),
            ELoop::bind_map<Mutated<Io, Flow>, Mutated<Io, Flow>, Mutated<Io, ty.sem(w.tys)>>(loop_run,
                λ m => Stmt::then_run(λ io2 env2 => lr.stmt.run(call, perform)(env2, io2), m), λ m2 => ELoop::back(ty, w.tys, lr.result, m2)),
            Eutt::trans(Events::none(), CoTree::bind(Events::none(), loop_run, KR), CoTree::bind(Events::none(), branch_run, KR),
                ELoop::sem(ELoop::While(cond, body, rebind, rest), w, ls, g, vals, io),
                Eutt::bind_cong_l(Events::none(), loop_run, branch_run, KR,
                    Eutt::bind_ret_l(Events::none(), Mutated(io, Onward(env1)),
                        λ m => Stmt::then_run(λ io2 env2 => branch.run(call, perform)(env2, io2), m))),
                j(sym(bit), λ y _ => Eutt<Mutated<Io, ty.sem(w.tys)>>(Events::none(),
                        CoTree::bind(Events::none(), match y as λ _ => Partial(Mutated<Io, Flow>) {
                            True => Stmt::run(Repeat(pass, cr), call, perform)(env1, io),
                            False => Stmt::run(Loc::skip(), call, perform)(env1, io),
                        }, KR),
                        ELoop::sem(ELoop::While(cond, body, rebind, rest), w, ls, g, vals, io)), at)))
    }
}

// The theorem, by induction over the program.
theorem ELoop::lower_sound(self p: ELoop, w: rt::World, ls: List<Lent>): (g: List<Ty>) → (locs: List<Loc>) → (next: Nat) →
    ELoop::LowerHolds(p, w, ls, g, locs, next, p.lower(w, ls, g, locs, next)) {
    match p {
        Done(t) => λ g locs next => ELoop::done_holds(t, w, ls, g, locs, next, t.lower(w, ls, g, locs, next), t.lower_sound(w, ls, g, locs, next)),
        Seq(t, rest) => λ g locs next => {
            let P = λ (r: Option<ELowered>) => ELoop::LowerHolds(ELoop::Seq(t, rest), w, ls, g, locs, next, r);
            Option::and_then_elim(P, trivial, t.lower(w, ls, g, locs, next),
                λ lt => rest.lower(w, ls, t.ctx_end(w, g), lt.locs, lt.next).and_then(λ lr =>
                    Some(ELowered(Then(lt.stmt, lr.stmt), lr.result, lr.next, lr.locs))),
                λ lt e_lt => Option::and_then_elim(P, trivial, rest.lower(w, ls, t.ctx_end(w, g), lt.locs, lt.next),
                    λ lr => Some(ELowered(Then(lt.stmt, lr.stmt), lr.result, lr.next, lr.locs)),
                    λ lr e_lr => ELoop::seq_holds(t, rest, w, ls, g, locs, next, lt,
                        j(e_lt, λ r _ => ETm::LowerHolds(t, w, ls, g, locs, next, r), t.lower_sound(w, ls, g, locs, next)), lr,
                        j(e_lr, λ r _ => ELoop::LowerHolds(rest, w, ls, t.ctx_end(w, g), lt.locs, lt.next, r),
                            rest.lower_sound(w, ls, t.ctx_end(w, g), lt.locs, lt.next)))))
        },
        While(cond, body, rebind, rest) => λ g locs next => {
            let P = λ (r: Option<ELowered>) => ELoop::LowerHolds(ELoop::While(cond, body, rebind, rest), w, ls, g, locs, next, r);
            Option::and_then_elim(P, trivial, Ty::check_bit(Tm::ty(cond, w, g)), λ _ =>
                ETm::lower_value(cond, w, g, locs, next).and_then(λ c =>
                body.lower(w, ls, g, locs, next).and_then(λ lb =>
                ELoop::sources(body.ctx_end(w, g), lb.locs, g, rebind).and_then(λ srcs =>
                Loc::moves(g, locs, srcs).and_then(λ mv =>
                rest.lower(w, ls, g, locs, next).and_then(λ lr =>
                    Some(ELowered(Then(ELoop::loop_stmt(c, lb.stmt, mv), lr.stmt), lr.result, lr.next, lr.locs))))))), λ eb _ =>
            Option::and_then_elim(P, trivial, ETm::lower_value(cond, w, g, locs, next), λ c =>
                body.lower(w, ls, g, locs, next).and_then(λ lb =>
                ELoop::sources(body.ctx_end(w, g), lb.locs, g, rebind).and_then(λ srcs =>
                Loc::moves(g, locs, srcs).and_then(λ mv =>
                rest.lower(w, ls, g, locs, next).and_then(λ lr =>
                    Some(ELowered(Then(ELoop::loop_stmt(c, lb.stmt, mv), lr.stmt), lr.result, lr.next, lr.locs)))))), λ c e_c =>
            Option::and_then_elim(P, trivial, body.lower(w, ls, g, locs, next), λ lb =>
                ELoop::sources(body.ctx_end(w, g), lb.locs, g, rebind).and_then(λ srcs =>
                Loc::moves(g, locs, srcs).and_then(λ mv =>
                rest.lower(w, ls, g, locs, next).and_then(λ lr =>
                    Some(ELowered(Then(ELoop::loop_stmt(c, lb.stmt, mv), lr.stmt), lr.result, lr.next, lr.locs))))), λ lb e_lb =>
            Option::and_then_elim(P, trivial, ELoop::sources(body.ctx_end(w, g), lb.locs, g, rebind), λ srcs =>
                Loc::moves(g, locs, srcs).and_then(λ mv =>
                rest.lower(w, ls, g, locs, next).and_then(λ lr =>
                    Some(ELowered(Then(ELoop::loop_stmt(c, lb.stmt, mv), lr.stmt), lr.result, lr.next, lr.locs)))), λ srcs e_srcs =>
            Option::and_then_elim(P, trivial, Loc::moves(g, locs, srcs), λ mv =>
                rest.lower(w, ls, g, locs, next).and_then(λ lr =>
                    Some(ELowered(Then(ELoop::loop_stmt(c, lb.stmt, mv), lr.stmt), lr.result, lr.next, lr.locs))), λ mv e_mv =>
            Option::and_then_elim(P, trivial, rest.lower(w, ls, g, locs, next), λ lr =>
                    Some(ELowered(Then(ELoop::loop_stmt(c, lb.stmt, mv), lr.stmt), lr.result, lr.next, lr.locs)), λ lr e_lr =>
                ELoop::while_holds(cond, body, rebind, rest, w, ls, g, locs, next, eb, c,
                    j(e_c, λ r _ => ETm::ValueHolds(cond, w, g, locs, next, r), ETm::value_sound(cond, w, g, locs, next)),
                    lb, j(e_lb, λ r _ => ETm::LowerHolds(body, w, ls, g, locs, next, r), body.lower_sound(w, ls, g, locs, next)),
                    srcs, j(e_srcs, λ r _ => ELoop::SourcesHold(w.tys, body.ctx_end(w, g), lb.locs, g, rebind, r),
                        ELoop::sources_sound(w.tys, body.ctx_end(w, g), lb.locs, g, rebind)),
                    mv, j(e_mv, λ r _ => Loc::MovesHold(w.tys, g, locs, srcs, r), Loc::moves_sound(w.tys, g, locs, srcs)),
                    lr, j(e_lr, λ r _ => ELoop::LowerHolds(rest, w, ls, g, locs, next, r), rest.lower_sound(w, ls, g, locs, next)))))))))
        },
    }
}

// ---------------------------------------------------------------------------
// The R6 statement for programs with loops: `Io::Reads`

// The lowered statements' tree, read against any world, with the value read
// back from its word, agrees with the program's meaning up to silent
// steps, loops and all, from an environment that holds the variables.
fn ELoop::lower_reads(self p: ELoop, w: rt::World, ls: List<Lent>, g: List<Ty>, locs: List<Loc>, next: Nat, l: ELowered, lowered: p.lower(w, ls, g, locs, next) = Some(l),
    call: Writers(), still: Writers::Still(call, functions_below(w.sigs.len())), agree: (held: Buffers()) → Tm::CallsAgree(w, Writers::words(call, held)),
    lents: ETm::LentsAgree(ls, call), perform: PerformsCo(), env: Env, vals: rt::Env(w.tys, g),
    held: LocsHold(w.tys, env, g, locs, vals), below: LocsBelow(locs, next), pos: 0 < next) →
    Io::Reads<p.ty(w, g).sem(w.tys)>(CoTree::map(Events::linux(), l.stmt.denote_co(call, perform)(env), λ flow => flow.read_back(p.ty(w, g), w.tys, l.result)),
        λ io => p.sem(w, ls, g, vals, io))
{
    let holds = j(lowered, λ r _ => ELoop::LowerHolds(p, w, ls, g, locs, next, r), p.lower_sound(w, ls, g, locs, next));
    let ty = p.ty(w, g);
    let bound = Io::reads_bind<Flow, ty.sem(w.tys)>(l.stmt.denote_co(call, perform)(env), λ io => l.stmt.run(call, perform)(env, io),
        λ flow => CRet(flow.read_back(ty, w.tys, l.result)), λ flow io => CRet(Mutated(io, flow.read_back(ty, w.tys, l.result))),
        Stmt::reads_run(l.stmt, call, perform, env), λ flow => Io::reads_ret(flow.read_back(ty, w.tys, l.result)));
    λ io => Eutt::trans(Events::none(),
        Io::against_co(CoTree::map(Events::linux(), l.stmt.denote_co(call, perform)(env), λ flow => flow.read_back(ty, w.tys, l.result)), io),
        CoTree::map(Events::none(), l.stmt.run(call, perform)(env, io), λ m => ELoop::back(ty, w.tys, l.result, m)),
        p.sem(w, ls, g, vals, io),
        bound(io), holds(call, still, agree, lents, perform, env, vals, io, held, below, pos))
}

// Loops over the world in effectful `rt`, lowered to a `Source`'s `Repeat`,
// and their soundness proved once (docs/effects-capabilities-design.md §8.6;
// issues/effects-uniqueness-surface.md, slice 5).
//
// A program (`ELoop`) is a chain of loop-free computations (`ETm`, `rt_io`)
// and loops ending in a computation's value. A loop is `while cond { body }`
// whose state is the whole environment: each pass runs `body`, a
// computation, and rebinds every variable to one of the end context's
// (`rebind`), as the surface's `while` threads the locals its body assigns
// and keeps the rest (docs/sequencing-surface-design.md §18). It may go
// round forever, so a program's meaning is in `Partial`: the loop is
// `if cond { do body while cond }`, `Io::iterate` of a total pass that runs
// the body and then tests the condition again.
//
// The lowering keeps every variable where it lived before the loop. A pass
// is the body's statements, then moves of each word variable from where
// the body left its new value back to its word, then the condition again
// into a flag word the `Repeat` tests; a buffer variable must end in its
// own buffer. Before the loop the condition is computed once and a `Branch`
// skips the loop when it fails.
//
// Soundness is `Io::iterate_rel` (`linux_world_co`): from an environment
// holding the state at its places, the source's pass and the meaning's
// leave the same world and go on together, at an environment holding the
// next state. Its premise is the loop-free lowering's theorem
// (`ETm::lower_sound`, with the end environment it keeps) and the moves'.
import logic;
import bool;
import nat;
import list;
import option;
import pair;
import bitvec;
import itree;
import coitree;
import coitree_eutt;
import linux_calls;
import linux_trees;
import linux_world;
import linux_world_co;
import function_ir;
import function_ir_eval;
import function_ir_state;
import function_ir_run;
import native_source;
import native_source_co;
import native_source_io;
import rt;
import rt_lower;
import rt_io;
import rt_io_lower;

// ---------------------------------------------------------------------------
// Programs with loops

inductive ELoop {
    // A loop-free computation: its value is the program's.
    Done(t: ETm),
    // A loop-free computation, then the rest in the context it ends in.
    Seq(t: ETm, rest: ELoop),
    // `while cond { body }` over the whole environment: each pass runs
    // `body` and rebinds variable `i` to the end context's variable
    // `rebind[i]`; then the rest.
    While(cond: Tm, body: ETm, rebind: List<Nat>, rest: ELoop),
}

// ---------------------------------------------------------------------------
// The state a pass leaves

// Every variable at its code's default.
fn ELoop::defaults(tys: Nat → RecInfo, g: List<Ty>) → rt::Env(tys, g) {
    match g as λ x => rt::Env(tys, x) { Nil => trivial, Cons(t, rest) => Pair(t.default(tys), ELoop::defaults(tys, rest)) }
}

// Each variable of `g` rebound to the end context's variable `rebind`
// names, at its code.
fn ELoop::gather(tys: Nat → RecInfo, ce: List<Ty>, ve: rt::Env(tys, ce), g: List<Ty>, rebind: List<Nat>) → rt::Env(tys, g) {
    match g as λ x => rt::Env(tys, x) {
        Nil => trivial,
        Cons(t, rest) => match rebind {
            Nil => Pair(t.default(tys), ELoop::defaults(tys, rest)),
            Cons(n, ns) => Pair(Ty::cast(tys, Ty::at(ce, n), t, Env::get(tys, ce, ve, n)), ELoop::gather(tys, ce, ve, rest, ns)),
        },
    }
}

// Where each rebound value lives at the end of the pass, the codes
// checked: `None` where a variable is rebound to one of another code or to
// none.
fn ELoop::sources(ce: List<Ty>, el: List<Loc>, g: List<Ty>, rebind: List<Nat>) → Option<List<Loc>> {
    match g {
        Nil => match rebind { Nil => Some(Nil), Cons(_, _) => None },
        Cons(t, rest) => match rebind {
            Nil => None,
            Cons(n, ns) => match Ty::at(ce, n).equation(t) {
                Inl(_) => Loc::at(el, n).and_then(λ l => ELoop::sources(ce, el, rest, ns).and_then(λ ls => Some(Cons(l, ls)))),
                Inr(_) => None,
            },
        },
    }
}

fn ELoop::SourcesHold(tys: Nat → RecInfo, ce: List<Ty>, el: List<Loc>, g: List<Ty>, rebind: List<Nat>, r: Option<List<Loc>>) → Type {
    match r {
        None => True,
        Some(srcs) => (env: Env) → (ve: rt::Env(tys, ce)) → LocsHold(tys, env, ce, el, ve) →
            LocsHold(tys, env, g, srcs, ELoop::gather(tys, ce, ve, g, rebind)),
    }
}

// A variable's value cast along an equation of codes is kept where it was.
theorem ELoop::kept_cast(tys: Nat → RecInfo, env: Env, l: Loc, a, b: Ty, e: a = b, v: a.sem(tys), k: a.Kept(tys, env, l, v)):
    b.Kept(tys, env, l, Ty::cast(tys, a, b, v)) {
    j(e, λ x _ => x.Kept(tys, env, l, Ty::cast(tys, a, x, v)),
        j(sym(Ty::cast_self(tys, a, v)), λ y _ => a.Kept(tys, env, l, y), k))
}

theorem ELoop::sources_sound(tys: Nat → RecInfo, ce: List<Ty>, el: List<Loc>, g: List<Ty>): (rebind: List<Nat>) →
    ELoop::SourcesHold(tys, ce, el, g, rebind, ELoop::sources(ce, el, g, rebind)) {
    match g {
        Nil => λ rebind => match rebind as λ r => ELoop::SourcesHold(tys, ce, el, Nil, r, ELoop::sources(ce, el, Nil, r)) {
            Nil => λ env ve _ => trivial,
            Cons(_, _) => trivial,
        },
        Cons(t, rest) => λ rebind => match rebind as λ r => ELoop::SourcesHold(tys, ce, el, Cons(t, rest), r, ELoop::sources(ce, el, Cons(t, rest), r)) {
            Nil => trivial,
            Cons(n, ns) => {
                let P = λ (r: Option<List<Loc>>) => ELoop::SourcesHold(tys, ce, el, Cons(t, rest), Cons(n, ns), r);
                match Ty::at(ce, n).equation(t) as λ q => P(match q as λ _ => Option<List<Loc>> {
                        Inl(_) => Loc::at(el, n).and_then(λ l => ELoop::sources(ce, el, rest, ns).and_then(λ ls => Some(Cons(l, ls)))),
                        Inr(_) => None,
                    }) {
                    Inl(e) => Option::and_then_elim(P, trivial, Loc::at(el, n), λ l => ELoop::sources(ce, el, rest, ns).and_then(λ ls => Some(Cons(l, ls))),
                        λ l e_l => Option::and_then_elim(P, trivial, ELoop::sources(ce, el, rest, ns), λ ls => Some(Cons(l, ls)), λ ls e_ls =>
                            λ env ve held => ⟨ELoop::kept_cast(tys, env, l, Ty::at(ce, n), t, e, Env::get(tys, ce, ve, n),
                                    locs_hold_at(tys, env, ce, el, ve, held, n, l, e_l)),
                                j(e_ls, λ r _ => ELoop::SourcesHold(tys, ce, el, rest, ns, r), ELoop::sources_sound(tys, ce, el, rest, ns))(env, ve, held)⟩)),
                    Inr(_) => trivial,
                }
            },
        },
    }
}

// ---------------------------------------------------------------------------
// Moving the state back

// A region that does nothing.
fn ELoop::nothing() → StructuredRegion { Dataflow(Region(Ports(Nil), Nil, Ports(Nil))) }

fn ELoop::skip() → Stmt { Compute(ELoop::nothing()) }

// `src` moved to the word `out`, at `width`.
fn ELoop::move_region(width: Nat, out: Nat, src: Nat) → StructuredRegion {
    Compose(ELoop::nothing(), Dataflow(Region(Ports(Nil), [Move(width, out, src)], Ports(Nil))))
}

// The words of a layout.
fn Loc::words(locs: List<Loc>) → List<Nat> {
    match locs {
        Nil => Nil,
        Cons(l, rest) => match l { InWord(id) => Cons(id, Loc::words(rest)), InBuffer(_) => Loc::words(rest), Gone => Loc::words(rest) },
    }
}

theorem Loc::clear_nil(locs: List<Loc>): Loc::clear(locs, Nil).IsTrue() {
    match locs {
        Nil => trivial,
        Cons(l, rest) => Bool::is_true_and_intro(l.clear_one(Nil), Loc::clear(rest, Nil),
            match l as λ k => k.clear_one(Nil).IsTrue() { InWord(_) => trivial, InBuffer(_) => trivial, Gone => trivial },
            Loc::clear_nil(rest)),
    }
}

// Clear of a list headed by `x`: clear of `x`, and of the rest.
theorem Loc::clear_cons(locs: List<Loc>, x: Nat, ws: List<Nat>): Loc::clear(locs, Cons(x, ws)).IsTrue() →
    Loc::clear(locs, [x]).IsTrue() ∧ Loc::clear(locs, ws).IsTrue() {
    match locs {
        Nil => λ _ => ⟨trivial, trivial⟩,
        Cons(l, rest) => λ h => {
            let parts = Bool::is_true_and(l.clear_one(Cons(x, ws)), Loc::clear(rest, Cons(x, ws)), h);
            let more = Loc::clear_cons(rest, x, ws, parts.right);
            let one = match l as λ k => k.clear_one(Cons(x, ws)).IsTrue() → k.clear_one([x]).IsTrue() ∧ k.clear_one(ws).IsTrue() {
                InWord(id) => λ c => {
                    let p = Bool::is_true_and(id.differs(x), absent(id, ws), c);
                    ⟨Bool::is_true_and_intro(id.differs(x), True, p.left, trivial), p.right⟩
                },
                InBuffer(_) => λ _ => ⟨trivial, trivial⟩,
                Gone => λ _ => ⟨trivial, trivial⟩,
            }(parts.left);
            ⟨Bool::is_true_and_intro(l.clear_one([x]), Loc::clear(rest, [x]), one.left, more.left),
                Bool::is_true_and_intro(l.clear_one(ws), Loc::clear(rest, ws), one.right, more.right)⟩
        },
    }
}

// One variable moved back: a word or a bit from where the pass left it to
// its word, a buffer left in its own buffer (or a gone one anywhere).
fn ELoop::move_one(t: Ty, d: Loc, s: Loc, more: Stmt) → Option<Stmt> {
    match t {
        Word(_) => match d { InWord(dw) => match s { InWord(sw) => Some(Then(Compute(ELoop::move_region(t.width(), dw, sw)), more)), InBuffer(_) => None, Gone => None }, InBuffer(_) => None, Gone => None },
        Bit => match d { InWord(dw) => match s { InWord(sw) => Some(Then(Compute(ELoop::move_region(t.width(), dw, sw)), more)), InBuffer(_) => None, Gone => None }, InBuffer(_) => None, Gone => None },
        Bytes(_) => match d {
            InWord(_) => None,
            InBuffer(b) => match s { InWord(_) => None, InBuffer(b2) => match b.eq_dec(b2) { Inl(_) => Some(more), Inr(_) => None }, Gone => None },
            Gone => Some(more),
        },
        Lines => None,
        Named(_) => None,
        Count => None,
    }
}

// The moves for every variable, in order: each move writes no word a later
// one reads, and no later one writes a word an earlier one wrote.
fn ELoop::moves(g: List<Ty>, dsts: List<Loc>, srcs: List<Loc>) → Option<Stmt> {
    match g {
        Nil => match dsts { Nil => match srcs { Nil => Some(ELoop::skip()), Cons(_, _) => None }, Cons(_, _) => None },
        Cons(t, rest) => match dsts {
            Nil => None,
            Cons(d, ds) => match srcs {
                Nil => None,
                Cons(s, ss) => Tm::check_true(Loc::clear(ss, Loc::words([d]))).and_then(λ _ =>
                    Tm::check_true(Loc::clear([d], Loc::words(ds))).and_then(λ _ =>
                        ELoop::moves(rest, ds, ss).and_then(λ more => ELoop::move_one(t, d, s, more)))),
            },
        },
    }
}

// Where a statement leaves the program: on, every place of `frame` as it
// was in `env`.
fn Flow::Frames(self flow: Flow, frame: List<Loc>, env: Env) → Type {
    match flow { Onward(env2) => Loc::AllSame(frame, env, env2), Exited(_) => False }
}

// What the moves promise: loop-free, the world untouched, every variable
// moved from its source to its place, and every place no move writes kept.
fn ELoop::MovesHold(tys: Nat → RecInfo, g: List<Ty>, dsts: List<Loc>, srcs: List<Loc>, r: Option<Stmt>) → Type {
    match r {
        None => True,
        Some(st) => st.straight().IsTrue() ∧ ((call: Writers()) → (env: Env) → (vals: rt::Env(tys, g)) → (io: Io) → LocsHold(tys, env, g, srcs, vals) →
            (Stmt::thread(st, call, env, io).after = io) ∧ (Stmt::thread(st, call, env, io).value.KeepsAll(tys, g, dsts, vals)
                ∧ ((frame: List<Loc>) → Loc::clear(frame, Loc::words(dsts)).IsTrue() → Stmt::thread(st, call, env, io).value.Frames(frame, env)))),
    }
}

// Doing nothing keeps every place.
theorem ELoop::skip_same(env: Env, call: Writers(), frame: List<Loc>): Loc::AllSame(frame, env, env.compute(call, ELoop::nothing())) {
    Loc::same_compute(env, call, ELoop::nothing(), env.compute_buffers(call, no_function, Writers::still_none(call), ELoop::nothing(), trivial, trivial), frame, Loc::clear_nil(frame))
}

// Keeping the head where the rest's statements keep it.
theorem ELoop::keeps_cons(tys: Nat → RecInfo, t: Ty, rest: List<Ty>, d: Loc, ds: List<Loc>, v: t.sem(tys), vs: rt::Env(tys, rest), env: Env,
    kept: t.Kept(tys, env, d, v)): (flow: Flow) → flow.KeepsAll(tys, rest, ds, vs) → flow.Frames([d], env) →
    flow.KeepsAll(tys, Cons(t, rest), Cons(d, ds), Pair(v, vs)) {
    λ flow => match flow {
        Onward(env2) => λ ka fr => ⟨t.kept_same(tys, env, env2, d, fr.left, v, kept), ka⟩,
        Exited(_) => λ never => false_elim(never),
    }
}

theorem ELoop::frames_trans(frame: List<Loc>, env, env1: Env, same: Loc::AllSame(frame, env, env1)): (flow: Flow) →
    flow.Frames(frame, env1) → flow.Frames(frame, env) {
    λ flow => match flow {
        Onward(env2) => λ fr => Loc::same_trans(frame, env, env1, env2, same, fr),
        Exited(_) => λ never => false_elim(never),
    }
}

// A word or a bit moved: kept at its place, the rest's sources and every
// other place untouched.
theorem ELoop::move_word_sound(tys: Nat → RecInfo, t: Ty, one: t.Scalar(), rest: List<Ty>, ds: List<Loc>, ss: List<Loc>, more: Stmt,
    ih: ELoop::MovesHold(tys, rest, ds, ss, Some(more)), dw, sw: Nat,
    c1: Loc::clear(ss, [dw]).IsTrue(), c2: Loc::clear([InWord(dw)], Loc::words(ds)).IsTrue()):
    ELoop::MovesHold(tys, Cons(t, rest), Cons(InWord(dw), ds), Cons(InWord(sw), ss),
        Some(Then(Compute(ELoop::move_region(t.width(), dw, sw)), more))) {
    let mr = ELoop::move_region(t.width(), dw, sw);
    ⟨Bool::is_true_and_intro(True, more.straight(), trivial, ih.left), λ call env vals io held => {
        let env1 = env.compute(call, mr);
        let keeps1: (env1.buffers = env.buffers) = env.compute_buffers(call, no_function, Writers::still_none(call), mr, trivial, trivial);
        let held1 = locs_hold_same(tys, env, env1, rest, ss, vals.snd, Loc::same_compute(env, call, mr, keeps1, ss, c1), held.right);
        let kept1: t.Kept(tys, env1, InWord(dw), vals.fst) = t.kept_moved(tys, env1, dw, env.valuation(), sw, one, vals.fst,
            t.kept_holds(tys, env, InWord(sw), vals.fst, held.left), env.compute_moved(call, no_function, Writers::still_none(call), ELoop::nothing(), trivial, trivial, t.width(), dw, sw));
        let r = ih.right(call, env1, vals.snd, io, held1);
        ⟨r.left, ⟨ELoop::keeps_cons(tys, t, rest, InWord(dw), ds, vals.fst, vals.snd, env1, kept1, Stmt::thread(more, call, env1, io).value,
                r.right.left, r.right.right([InWord(dw)], c2)),
            λ frame h => {
                let parts = Loc::clear_cons(frame, dw, Loc::words(ds), h);
                ELoop::frames_trans(frame, env, env1, Loc::same_compute(env, call, mr, keeps1, frame, parts.left),
                    Stmt::thread(more, call, env1, io).value, r.right.right(frame, parts.right))
            }⟩⟩
    }⟩
}

// A buffer left where it is, or a gone one: nothing moved.
theorem ELoop::move_stay_sound(tys: Nat → RecInfo, t: Ty, rest: List<Ty>, d: Loc, ds: List<Loc>, s: Loc, ss: List<Loc>, more: Stmt,
    ih: ELoop::MovesHold(tys, rest, ds, ss, Some(more)), stay: (env: Env) → (v: t.sem(tys)) → t.Kept(tys, env, s, v) → t.Kept(tys, env, d, v),
    c2: Loc::clear([d], Loc::words(ds)).IsTrue(), wd: Loc::words(Cons(d, ds)) = Loc::words(ds)):
    ELoop::MovesHold(tys, Cons(t, rest), Cons(d, ds), Cons(s, ss), Some(more)) {
    ⟨ih.left, λ call env vals io held => {
        let r = ih.right(call, env, vals.snd, io, held.right);
        ⟨r.left, ⟨ELoop::keeps_cons(tys, t, rest, d, ds, vals.fst, vals.snd, env, stay(env, vals.fst, held.left), Stmt::thread(more, call, env, io).value,
                r.right.left, r.right.right([d], c2)),
            λ frame h => r.right.right(frame, j(wd, λ ws _ => Loc::clear(frame, ws).IsTrue(), h))⟩⟩
    }⟩
}

theorem ELoop::move_one_sound(tys: Nat → RecInfo, rest: List<Ty>, ds: List<Loc>, ss: List<Loc>, more: Stmt,
    ih: ELoop::MovesHold(tys, rest, ds, ss, Some(more))): (t: Ty) → (d: Loc) → (s: Loc) →
    Loc::clear(ss, Loc::words([d])).IsTrue() → Loc::clear([d], Loc::words(ds)).IsTrue() →
    ELoop::MovesHold(tys, Cons(t, rest), Cons(d, ds), Cons(s, ss), ELoop::move_one(t, d, s, more)) {
    λ t => match t {
        Word(wd) => λ d => match d {
            InWord(dw) => λ s => match s {
                InWord(sw) => λ c1 c2 => ELoop::move_word_sound(tys, Word(wd), trivial, rest, ds, ss, more, ih, dw, sw, c1, c2),
                InBuffer(_) => λ _ _ => trivial,
                Gone => λ _ _ => trivial,
            },
            InBuffer(_) => λ s _ _ => trivial,
            Gone => λ s _ _ => trivial,
        },
        Bit => λ d => match d {
            InWord(dw) => λ s => match s {
                InWord(sw) => λ c1 c2 => ELoop::move_word_sound(tys, Bit, trivial, rest, ds, ss, more, ih, dw, sw, c1, c2),
                InBuffer(_) => λ _ _ => trivial,
                Gone => λ _ _ => trivial,
            },
            InBuffer(_) => λ s _ _ => trivial,
            Gone => λ s _ _ => trivial,
        },
        Bytes(c) => λ d => match d {
            InWord(_) => λ s _ _ => trivial,
            InBuffer(b) => λ s => match s {
                InWord(_) => λ _ _ => trivial,
                InBuffer(b2) => λ c1 c2 => match b.eq_dec(b2) as λ q => ELoop::MovesHold(tys, Cons(Bytes(c), rest), Cons(InBuffer(b), ds), Cons(InBuffer(b2), ss),
                        match q as λ _ => Option<Stmt> { Inl(_) => Some(more), Inr(_) => None }) {
                    Inl(e) => ELoop::move_stay_sound(tys, Bytes(c), rest, InBuffer(b), ds, InBuffer(b2), ss, more, ih,
                        λ env v (k: env.buffer(b2) = v) => j(sym(e), λ x _ => env.buffer(x) = v, k), c2, refl),
                    Inr(_) => trivial,
                },
                Gone => λ _ _ => trivial,
            },
            Gone => λ s c1 c2 => ELoop::move_stay_sound(tys, Bytes(c), rest, Gone, ds, s, ss, more, ih, λ env v _ => trivial, c2, refl),
        },
        Lines => λ d s _ _ => trivial,
        Named(_) => λ d s _ _ => trivial,
        Count => λ d s _ _ => trivial,
    }
}

theorem ELoop::moves_sound(tys: Nat → RecInfo, g: List<Ty>): (dsts: List<Loc>) → (srcs: List<Loc>) →
    ELoop::MovesHold(tys, g, dsts, srcs, ELoop::moves(g, dsts, srcs)) {
    match g {
        Nil => λ dsts => match dsts {
            Nil => λ srcs => match srcs {
                Nil => ⟨trivial, λ call env vals io held => ⟨refl, ⟨trivial, λ frame _ => ELoop::skip_same(env, call, frame)⟩⟩⟩,
                Cons(_, _) => trivial,
            },
            Cons(_, _) => λ srcs => trivial,
        },
        Cons(t, rest) => λ dsts => match dsts {
            Nil => λ srcs => trivial,
            Cons(d, ds) => λ srcs => match srcs {
                Nil => trivial,
                Cons(s, ss) => {
                    let P = λ (r: Option<Stmt>) => ELoop::MovesHold(tys, Cons(t, rest), Cons(d, ds), Cons(s, ss), r);
                    Option::and_then_elim(P, trivial, Tm::check_true(Loc::clear(ss, Loc::words([d]))),
                        λ _ => Tm::check_true(Loc::clear([d], Loc::words(ds))).and_then(λ _ =>
                            ELoop::moves(rest, ds, ss).and_then(λ more => ELoop::move_one(t, d, s, more))), λ c1 _ =>
                    Option::and_then_elim(P, trivial, Tm::check_true(Loc::clear([d], Loc::words(ds))),
                        λ _ => ELoop::moves(rest, ds, ss).and_then(λ more => ELoop::move_one(t, d, s, more)), λ c2 _ =>
                    Option::and_then_elim(P, trivial, ELoop::moves(rest, ds, ss), λ more => ELoop::move_one(t, d, s, more), λ more e_more =>
                        ELoop::move_one_sound(tys, rest, ds, ss, more,
                            j(e_more, λ r _ => ELoop::MovesHold(tys, rest, ds, ss, r), ELoop::moves_sound(tys, rest, ds, ss)), t, d, s, c1, c2))))
                },
            },
        },
    }
}

// ---------------------------------------------------------------------------
// The meaning

// The code a program returns.
fn ELoop::ty(self p: ELoop, w: rt::World, g: List<Ty>) → Ty {
    match p {
        Done(t) => t.ty(w, g),
        Seq(t, rest) => rest.ty(w, t.ctx_end(w, g)),
        While(_, _, _, rest) => rest.ty(w, g),
    }
}

// A condition's value as a bit (a bit's own; the lowering refuses any other
// code).
fn ELoop::truth(tys: Nat → RecInfo, t: Ty, v: t.sem(tys)) → Bool { Ty::cast(tys, t, Bit, v) }

// Round again at `s` while the condition holds.
fn ELoop::go<S>(b: Bool, s: S) → Step<S, S> {
    match b { True => Continue(s), False => Break(s) }
}

// One pass: the body, the state rebound from where it ends, and the
// condition tested again.
fn ELoop::step(w: rt::World, g: List<Ty>, cond: Tm, body: ETm, rebind: List<Nat>) →
    rt::Env(w.tys, g) → Io → Mutated<Io, Step<rt::Env(w.tys, g), rt::Env(w.tys, g)>>
{
    λ vals io => Mutated(body.sem_end(w, g, vals, io).after,
        ELoop::go(ELoop::truth(w.tys, Tm::ty(cond, w, g),
                Tm::sem(cond, w, g, ELoop::gather(w.tys, body.ctx_end(w, g), body.sem_end(w, g, vals, io).value, g, rebind))),
            ELoop::gather(w.tys, body.ctx_end(w, g), body.sem_end(w, g, vals, io).value, g, rebind)))
}

// `while cond { body }`: nothing when the condition fails at the start,
// else the passes until it fails, for as long as that takes.
fn ELoop::run_while(w: rt::World, g: List<Ty>, cond: Tm, body: ETm, rebind: List<Nat>, vals: rt::Env(w.tys, g), io: Io) →
    Partial(Mutated<Io, rt::Env(w.tys, g)>)
{
    match ELoop::truth(w.tys, Tm::ty(cond, w, g), Tm::sem(cond, w, g, vals)) {
        True => Io::iterate(Io::total(ELoop::step(w, g, cond, body, rebind)), vals, io),
        False => CRet(Mutated(io, vals)),
    }
}

// The meaning: world threading in `Partial`, at the code the program
// returns. A function of the context, so that the recursion is on the
// program.
fn ELoop::sem(self p: ELoop, w: rt::World) → (g: List<Ty>) → rt::Env(w.tys, g) → Io → Partial(Mutated<Io, p.ty(w, g).sem(w.tys)>) {
    match p {
        Done(t) => λ g vals io => CRet(t.sem(w, g, vals, io)),
        Seq(t, rest) => λ g vals io => rest.sem(w, t.ctx_end(w, g), t.sem_end(w, g, vals, io).value, t.sem_end(w, g, vals, io).after),
        While(cond, body, rebind, rest) => λ g vals io => CoTree::bind(Events::none(), ELoop::run_while(w, g, cond, body, rebind, vals, io),
            λ m => rest.sem(w, g, m.value, m.after)),
    }
}

// ---------------------------------------------------------------------------
// The lowering

// The condition's code is a bit.
fn ELoop::check_bit(t: Ty) → Option<t = Bit> {
    match t.equation(Bit) { Inl(e) => Some(e), Inr(_) => None }
}

// The loop: the condition into its flag word, and when it holds, the passes
// (body, moves back, condition again) while it does.
fn ELoop::pass(c: Lowered, body: Stmt, moves: Stmt) → Stmt {
    Then(body, Then(moves, Compute(c.region)))
}

fn ELoop::loop_stmt(c: Lowered, body: Stmt, moves: Stmt) → Stmt {
    Then(Compute(c.region), Branch(c.result, Repeat(ELoop::pass(c, body, moves), c.result), ELoop::skip()))
}

fn ELoop::lower(self p: ELoop, w: rt::World, g: List<Ty>, locs: List<Loc>, next: Nat) → Option<ELowered> {
    match p {
        Done(t) => t.lower(w, g, locs, next),
        Seq(t, rest) => t.lower(w, g, locs, next).and_then(λ lt =>
            rest.lower(w, t.ctx_end(w, g), lt.locs, lt.next).and_then(λ lr =>
                Some(ELowered(Then(lt.stmt, lr.stmt), lr.result, lr.next, lr.locs)))),
        While(cond, body, rebind, rest) => ELoop::check_bit(Tm::ty(cond, w, g)).and_then(λ _ =>
            ETm::lower_value(cond, w, g, locs, next).and_then(λ c =>
            body.lower(w, g, locs, next).and_then(λ lb =>
            ELoop::sources(body.ctx_end(w, g), lb.locs, g, rebind).and_then(λ srcs =>
            ELoop::moves(g, locs, srcs).and_then(λ mv =>
            rest.lower(w, g, locs, next).and_then(λ lr =>
                Some(ELowered(Then(ELoop::loop_stmt(c, lb.stmt, mv), lr.stmt), lr.result, lr.next, lr.locs)))))))),
    }
}

// ---------------------------------------------------------------------------
// Steps up to silent steps

fn ELoop::eutt_of_eq<T>(x: Partial(T), y: Partial(T), e: x = y) → Eutt<T>(Events::none(), x, y) {
    j(e, λ z _ => Eutt<T>(Events::none(), x, z), Eutt::refl(Events::none(), x))
}

fn ELoop::bind_map<A, B, C>(t: Partial(A), k: A → Partial(B), f: B → C) →
    Eutt<C>(Events::none(), CoTree::map(Events::none(), CoTree::bind(Events::none(), t, k), f),
        CoTree::bind(Events::none(), t, λ a => CoTree::map(Events::none(), k(a), f)))
{
    Eutt::of_bisim(Events::none(), CoTree::map(Events::none(), CoTree::bind(Events::none(), t, k), f),
        CoTree::bind(Events::none(), t, λ a => CoTree::map(Events::none(), k(a), f)),
        CoTree::bind_assoc(Events::none(), t, k, λ r => CRet(f(r))))
}

// A computation that returns `m` (up to silent steps), followed by `k`.
fn ELoop::bind_ret<A, B>(t: Partial(A), m: A, k: A → Partial(B), e: Eutt<A>(Events::none(), t, CRet(m))) →
    Eutt<B>(Events::none(), CoTree::bind(Events::none(), t, k), k(m))
{
    Eutt::trans(Events::none(), CoTree::bind(Events::none(), t, k), CoTree::bind(Events::none(), CRet(m), k), k(m),
        Eutt::bind_cong_l(Events::none(), t, CRet(m), k, e), Eutt::bind_ret_l(Events::none(), m, k))
}

// ---------------------------------------------------------------------------
// Soundness

// A condition's flag word, read as a bit, is the condition.
theorem ELoop::head_bool(v: Bool): ETm::word_at(64, BitVec::ofBool(v).toNat()).head_bit() = v {
    match v { True => refl, False => refl }
}

theorem ELoop::bit_kept(tys: Nat → RecInfo, env: Env, c: Nat, t: Ty, e: t = Bit): (v: t.sem(tys)) → t.Kept(tys, env, InWord(c), v) →
    env.bit(c) = ELoop::truth(tys, t, v) {
    j(sym(e), λ x _ => (v: x.sem(tys)) → x.Kept(tys, env, InWord(c), v) → env.bit(c) = ELoop::truth(tys, x, v),
        λ v (k: env.number(c) = BitVec::ofBool(v).toNat()) =>
            trans(cong_fn(λ (n: Nat) => ETm::word_at(64, n).head_bit(), k), trans(ELoop::head_bool(v), sym(Ty::cast_self(tys, Bit, v)))))
}

// The program's value read back from its word, the world as the statements
// left it.
fn ELoop::back(t: Ty, tys: Nat → RecInfo, result: Nat, m: Mutated<Io, Flow>) → Mutated<Io, t.sem(tys)> {
    Mutated(m.after, m.value.read_back(t, tys, result))
}

// What a lowering promises: from any environment holding the variables, at
// any world, the statements' threading, its value read back, is the
// program's meaning up to silent steps.
fn ELoop::LowerHolds(self p: ELoop, w: rt::World, g: List<Ty>, locs: List<Loc>, next: Nat, r: Option<ELowered>) → Type {
    match r {
        None => True,
        Some(l) => (call: Writers()) → Writers::Still(call, functions_below(w.sigs.len())) → ((held: Buffers()) → Tm::CallsAgree(w, Writers::words(call, held))) → (perform: PerformsCo()) → (env: Env) → (vals: rt::Env(w.tys, g)) → (io: Io) →
            LocsHold(w.tys, env, g, locs, vals) → LocsBelow(locs, next) → 0 < next →
            Eutt<Mutated<Io, p.ty(w, g).sem(w.tys)>>(Events::none(),
                CoTree::map(Events::none(), l.stmt.run(call, perform)(env, io), λ m => ELoop::back(p.ty(w, g), w.tys, l.result, m)),
                p.sem(w, g, vals, io)),
    }
}

// The rest of a program after a statement that left `flow`: its lowering's
// promise, where the flow goes on holding the rest's variables.
fn ELoop::rest_holds(rest: ELoop, w: rt::World, g: List<Ty>, locs: List<Loc>, next: Nat, lr: ELowered,
    rh: ELoop::LowerHolds(rest, w, g, locs, next, Some(lr)), call: Writers(), still: Writers::Still(call, functions_below(w.sigs.len())), agree: (held: Buffers()) → Tm::CallsAgree(w, Writers::words(call, held)), perform: PerformsCo(),
    below: LocsBelow(locs, next), pos: 0 < next, vals: rt::Env(w.tys, g)) → (flow: Flow) → (io: Io) → flow.KeepsAll(w.tys, g, locs, vals) →
    Eutt<Mutated<Io, rest.ty(w, g).sem(w.tys)>>(Events::none(),
        CoTree::map(Events::none(), Stmt::then_run(λ io2 env2 => lr.stmt.run(call, perform)(env2, io2), Mutated(io, flow)),
            λ m => ELoop::back(rest.ty(w, g), w.tys, lr.result, m)),
        rest.sem(w, g, vals, io))
{
    λ flow => match flow {
        Onward(env) => λ io held => rh(call, still, agree, perform, env, vals, io, held, below, pos),
        Exited(_) => λ io never => false_elim(never),
    }
}

// ---------------------------------------------------------------------------
// A pass, source and meaning together

// The relation the loop keeps: the environment holds the state where it
// lives; and out of the loop, the flow goes on holding it.
fn ELoop::Held(tys: Nat → RecInfo, g: List<Ty>, locs: List<Loc>) → Env → rt::Env(tys, g) → Type {
    λ e v => LocsHold(tys, e, g, locs, v)
}

fn ELoop::Left(tys: Nat → RecInfo, g: List<Ty>, locs: List<Loc>) → Flow → rt::Env(tys, g) → Type {
    λ f v => f.KeepsAll(tys, g, locs, v)
}

// A pass of the source as a total step of its loop.
fn ELoop::pass_total(call: Writers(), c: Lowered, body: Stmt, moves: Stmt) → Env → Io → Mutated<Io, Step<Env, Flow>> {
    λ e io => Mutated(Stmt::thread(ELoop::pass(c, body, moves), call, e, io).after,
        Stmt::thread(ELoop::pass(c, body, moves), call, e, io).value.pass(c.result))
}

// The condition again, from an environment holding the next state: the
// flag goes round exactly when the meaning does.
theorem ELoop::cond_step(w: rt::World, g: List<Ty>, locs: List<Loc>, next: Nat, cond: Tm, c: Lowered,
    vh: ETm::ValueHolds(cond, w, g, locs, next, Some(c)), eb: Tm::ty(cond, w, g) = Bit,
    call: Writers(), still: Writers::Still(call, functions_below(w.sigs.len())), agree: (held: Buffers()) → Tm::CallsAgree(w, Writers::words(call, held)), below: LocsBelow(locs, next), pos: 0 < next,
    em: Env, v2: rt::Env(w.tys, g), held: LocsHold(w.tys, em, g, locs, v2)):
    Io::StepRel(ELoop::Held(w.tys, g, locs), ELoop::Left(w.tys, g, locs), Onward(em.compute(call, c.region)).pass(c.result),
        ELoop::go(ELoop::truth(w.tys, Tm::ty(cond, w, g), Tm::sem(cond, w, g, v2)), v2))
{
    let ran = vh.right(call, still, agree, em, v2, held, below, pos);
    let ec = em.compute(call, c.region);
    let hc: LocsHold(w.tys, ec, g, locs, v2) = ran.right.right;
    let bit = ELoop::bit_kept(w.tys, ec, c.result, Tm::ty(cond, w, g), eb, Tm::sem(cond, w, g, v2), ran.right.left);
    j(sym(bit), λ y _ => Io::StepRel(ELoop::Held(w.tys, g, locs), ELoop::Left(w.tys, g, locs),
            match y as λ _ => Step<Env, Flow> { True => Continue(ec), False => Break(Onward(ec)) },
            ELoop::go(ELoop::truth(w.tys, Tm::ty(cond, w, g), Tm::sem(cond, w, g, v2)), v2)),
        match ELoop::truth(w.tys, Tm::ty(cond, w, g), Tm::sem(cond, w, g, v2)) as λ b =>
                Io::StepRel(ELoop::Held(w.tys, g, locs), ELoop::Left(w.tys, g, locs),
                    match b as λ _ => Step<Env, Flow> { True => Continue(ec), False => Break(Onward(ec)) }, ELoop::go(b, v2)) {
            True => hc,
            False => hc,
        })
}

// After the moves.
theorem ELoop::moved_step(w: rt::World, g: List<Ty>, locs: List<Loc>, next: Nat, cond: Tm, c: Lowered,
    vh: ETm::ValueHolds(cond, w, g, locs, next, Some(c)), eb: Tm::ty(cond, w, g) = Bit,
    call: Writers(), still: Writers::Still(call, functions_below(w.sigs.len())), agree: (held: Buffers()) → Tm::CallsAgree(w, Writers::words(call, held)), below: LocsBelow(locs, next), pos: 0 < next, v2: rt::Env(w.tys, g)):
    (flow: Flow) → (a: Io) → flow.KeepsAll(w.tys, g, locs, v2) →
    (Stmt::then_thread(Compute(c.region), call, Mutated(a, flow)).after = a) ∧
    Io::StepRel(ELoop::Held(w.tys, g, locs), ELoop::Left(w.tys, g, locs), Stmt::then_thread(Compute(c.region), call, Mutated(a, flow)).value.pass(c.result),
        ELoop::go(ELoop::truth(w.tys, Tm::ty(cond, w, g), Tm::sem(cond, w, g, v2)), v2))
{
    λ flow => match flow {
        Onward(em) => λ a held => ⟨refl, ELoop::cond_step(w, g, locs, next, cond, c, vh, eb, call, still, agree, below, pos, em, v2, held)⟩,
        Exited(_) => λ a never => false_elim(never),
    }
}

// After the body: the moves from where it left the next state, then the
// condition.
theorem ELoop::body_step(w: rt::World, g: List<Ty>, locs: List<Loc>, next: Nat, cond: Tm, c: Lowered,
    vh: ETm::ValueHolds(cond, w, g, locs, next, Some(c)), eb: Tm::ty(cond, w, g) = Bit,
    call: Writers(), still: Writers::Still(call, functions_below(w.sigs.len())), agree: (held: Buffers()) → Tm::CallsAgree(w, Writers::words(call, held)), below: LocsBelow(locs, next), pos: 0 < next,
    ce: List<Ty>, el: List<Loc>, rebind: List<Nat>, srcs: List<Loc>, mv: Stmt,
    sh: ELoop::SourcesHold(w.tys, ce, el, g, rebind, Some(srcs)), mh: ELoop::MovesHold(w.tys, g, locs, srcs, Some(mv)), ve: rt::Env(w.tys, ce)):
    (flow: Flow) → (a: Io) → flow.KeepsAll(w.tys, ce, el, ve) →
    (Stmt::then_thread(Then(mv, Compute(c.region)), call, Mutated(a, flow)).after = a) ∧
    Io::StepRel(ELoop::Held(w.tys, g, locs), ELoop::Left(w.tys, g, locs),
        Stmt::then_thread(Then(mv, Compute(c.region)), call, Mutated(a, flow)).value.pass(c.result),
        ELoop::go(ELoop::truth(w.tys, Tm::ty(cond, w, g), Tm::sem(cond, w, g, ELoop::gather(w.tys, ce, ve, g, rebind))),
            ELoop::gather(w.tys, ce, ve, g, rebind)))
{
    λ flow => match flow {
        Onward(eb2) => λ a ka => {
            let v2 = ELoop::gather(w.tys, ce, ve, g, rebind);
            let mres = mh.right(call, eb2, v2, a, sh(eb2, ve, ka));
            let mm = Stmt::thread(mv, call, eb2, a);
            let r = ELoop::moved_step(w, g, locs, next, cond, c, vh, eb, call, still, agree, below, pos, v2, mm.value, mm.after, mres.right.left);
            ⟨trans(r.left, mres.left), r.right⟩
        },
        Exited(_) => λ a never => false_elim(never),
    }
}

// A whole pass: the source's and the meaning's leave the same world and go
// on together.
theorem ELoop::pass_rel(w: rt::World, g: List<Ty>, locs: List<Loc>, next: Nat, cond: Tm, c: Lowered,
    vh: ETm::ValueHolds(cond, w, g, locs, next, Some(c)), eb: Tm::ty(cond, w, g) = Bit,
    call: Writers(), still: Writers::Still(call, functions_below(w.sigs.len())), agree: (held: Buffers()) → Tm::CallsAgree(w, Writers::words(call, held)), below: LocsBelow(locs, next), pos: 0 < next,
    body: ETm, lb: ELowered, bh: ETm::LowerHolds(body, w, g, locs, next, Some(lb)), rebind: List<Nat>, srcs: List<Loc>, mv: Stmt,
    sh: ELoop::SourcesHold(w.tys, body.ctx_end(w, g), lb.locs, g, rebind, Some(srcs)), mh: ELoop::MovesHold(w.tys, g, locs, srcs, Some(mv))):
    (env: Env) → (vals: rt::Env(w.tys, g)) → ELoop::Held(w.tys, g, locs)(env, vals) → (io: Io) →
    (ELoop::pass_total(call, c, lb.stmt, mv)(env, io).after = ELoop::step(w, g, cond, body, rebind)(vals, io).after) ∧
    Io::StepRel(ELoop::Held(w.tys, g, locs), ELoop::Left(w.tys, g, locs),
        ELoop::pass_total(call, c, lb.stmt, mv)(env, io).value, ELoop::step(w, g, cond, body, rebind)(vals, io).value)
{
    λ env vals held io => {
        let bres = bh.right(call, still, agree, env, vals, io, held, below, pos);
        let mb = Stmt::thread(lb.stmt, call, env, io);
        let r = ELoop::body_step(w, g, locs, next, cond, c, vh, eb, call, still, agree, below, pos, body.ctx_end(w, g), lb.locs, rebind, srcs, mv, sh, mh,
            body.sem_end(w, g, vals, io).value, mb.value, mb.after, bres.right.left);
        ⟨trans(r.left, trans(bres.left.left, sym(body.sem_end_after(w, g, vals, io)))), r.right⟩
    }
}

// ---------------------------------------------------------------------------
// The theorem, construct by construct

// A loop-free computation: its statements return what their threading
// does, which lands where the meaning does.
theorem ELoop::done_holds(t: ETm, w: rt::World, g: List<Ty>, locs: List<Loc>, next: Nat): (r: Option<ELowered>) →
    ETm::LowerHolds(t, w, g, locs, next, r) → ELoop::LowerHolds(ELoop::Done(t), w, g, locs, next, r) {
    λ r => match r {
        None => λ _ => trivial,
        Some(l) => λ h call still agree perform env vals io held below pos => {
            let m = Stmt::thread(l.stmt, call, env, io);
            let lands = h.right(call, still, agree, env, vals, io, held, below, pos).left;
            let ty = t.ty(w, g);
            let same: (ELoop::back(ty, w.tys, l.result, m) = t.sem(w, g, vals, io)) =
                eq2<Io, ty.sem(w.tys), Mutated<Io, ty.sem(w.tys)>>(λ a x => Mutated(a, x), lands.left,
                    m.value.read_back_keeps(ty, w.tys, l.result, t.sem(w, g, vals, io).value, lands.right));
            Eutt::trans(Events::none(),
                CoTree::map(Events::none(), l.stmt.run(call, perform)(env, io), λ m2 => ELoop::back(ty, w.tys, l.result, m2)),
                CRet(ELoop::back(ty, w.tys, l.result, m)), CRet(t.sem(w, g, vals, io)),
                ELoop::bind_ret<Mutated<Io, Flow>, Mutated<Io, ty.sem(w.tys)>>(l.stmt.run(call, perform)(env, io), m,
                    λ m2 => CRet(ELoop::back(ty, w.tys, l.result, m2)), Stmt::run_straight(l.stmt, call, perform, h.left, env, io)),
                ELoop::eutt_of_eq<Mutated<Io, ty.sem(w.tys)>>(CRet(ELoop::back(ty, w.tys, l.result, m)), CRet(t.sem(w, g, vals, io)),
                    cong_fn(λ (x: Mutated<Io, ty.sem(w.tys)>) => CRet(x), same)))
        },
    }
}

// A loop-free computation, then the rest from where it ends.
theorem ELoop::seq_holds(t: ETm, rest: ELoop, w: rt::World, g: List<Ty>, locs: List<Loc>, next: Nat,
    lt: ELowered, ht: ETm::LowerHolds(t, w, g, locs, next, Some(lt)),
    lr: ELowered, hr: ELoop::LowerHolds(rest, w, t.ctx_end(w, g), lt.locs, lt.next, Some(lr))):
    ELoop::LowerHolds(ELoop::Seq(t, rest), w, g, locs, next, Some(ELowered(Then(lt.stmt, lr.stmt), lr.result, lr.next, lr.locs)))
{
    λ call still agree perform env vals io held below pos => {
        let ce = t.ctx_end(w, g);
        let mt = Stmt::thread(lt.stmt, call, env, io);
        let res = ht.right(call, still, agree, env, vals, io, held, below, pos);
        let ty = rest.ty(w, ce);
        let k = λ (m: Mutated<Io, Flow>) => CoTree::map(Events::none(), Stmt::then_run(λ io2 env2 => lr.stmt.run(call, perform)(env2, io2), m),
            λ m2 => ELoop::back(ty, w.tys, lr.result, m2));
        let ve = t.sem_end(w, g, vals, io);
        let after: (mt.after = ve.after) = trans(res.left.left, sym(t.sem_end_after(w, g, vals, io)));
        let pos2: (0 < lt.next) = Nat::lt_of_lt_of_le(0, next, lt.next, pos, res.right.right.right);
        let rest_at = ELoop::rest_holds(rest, w, ce, lt.locs, lt.next, lr, hr, call, still, agree, perform, res.right.right.left, pos2, ve.value,
            mt.value, mt.after, res.right.left);
        Eutt::trans(Events::none(),
            CoTree::map(Events::none(), Stmt::run(Then(lt.stmt, lr.stmt), call, perform)(env, io), λ m2 => ELoop::back(ty, w.tys, lr.result, m2)),
            CoTree::bind(Events::none(), lt.stmt.run(call, perform)(env, io), k),
            rest.sem(w, ce, ve.value, ve.after),
            ELoop::bind_map<Mutated<Io, Flow>, Mutated<Io, Flow>, Mutated<Io, ty.sem(w.tys)>>(lt.stmt.run(call, perform)(env, io),
                λ m => Stmt::then_run(λ io2 env2 => lr.stmt.run(call, perform)(env2, io2), m), λ m2 => ELoop::back(ty, w.tys, lr.result, m2)),
            Eutt::trans(Events::none(), CoTree::bind(Events::none(), lt.stmt.run(call, perform)(env, io), k), k(mt), rest.sem(w, ce, ve.value, ve.after),
                ELoop::bind_ret<Mutated<Io, Flow>, Mutated<Io, ty.sem(w.tys)>>(lt.stmt.run(call, perform)(env, io), mt, k,
                    Stmt::run_straight(lt.stmt, call, perform, ht.left, env, io)),
                j(after, λ y _ => Eutt<Mutated<Io, ty.sem(w.tys)>>(Events::none(), k(mt), rest.sem(w, ce, ve.value, y)), rest_at)))
    }
}

// A loop, then the rest from the state it leaves.
theorem ELoop::while_holds(cond: Tm, body: ETm, rebind: List<Nat>, rest: ELoop, w: rt::World, g: List<Ty>, locs: List<Loc>, next: Nat,
    eb: Tm::ty(cond, w, g) = Bit, c: Lowered, vh: ETm::ValueHolds(cond, w, g, locs, next, Some(c)),
    lb: ELowered, bh: ETm::LowerHolds(body, w, g, locs, next, Some(lb)),
    srcs: List<Loc>, sh: ELoop::SourcesHold(w.tys, body.ctx_end(w, g), lb.locs, g, rebind, Some(srcs)),
    mv: Stmt, mh: ELoop::MovesHold(w.tys, g, locs, srcs, Some(mv)),
    lr: ELowered, hr: ELoop::LowerHolds(rest, w, g, locs, next, Some(lr))):
    ELoop::LowerHolds(ELoop::While(cond, body, rebind, rest), w, g, locs, next,
        Some(ELowered(Then(ELoop::loop_stmt(c, lb.stmt, mv), lr.stmt), lr.result, lr.next, lr.locs)))
{
    λ call still agree perform env vals io held below pos => {
        let cr = c.result;
        let ty = rest.ty(w, g);
        let pass = ELoop::pass(c, lb.stmt, mv);
        let branch = Branch(cr, Repeat(pass, cr), ELoop::skip());
        let KE = λ (m: Mutated<Io, rt::Env(w.tys, g)>) => rest.sem(w, g, m.value, m.after);
        let KR = λ (m: Mutated<Io, Flow>) => CoTree::map(Events::none(), Stmt::then_run(λ io2 env2 => lr.stmt.run(call, perform)(env2, io2), m),
            λ m2 => ELoop::back(ty, w.tys, lr.result, m2));
        let ran = vh.right(call, still, agree, env, vals, held, below, pos);
        let env1 = env.compute(call, c.region);
        let held1: LocsHold(w.tys, env1, g, locs, vals) = ran.right.right;
        let cv = Tm::sem(cond, w, g, vals);
        let truth = ELoop::truth(w.tys, Tm::ty(cond, w, g), cv);
        let bit: (env1.bit(cr) = truth) = ELoop::bit_kept(w.tys, env1, cr, Tm::ty(cond, w, g), eb, cv, ran.right.left);
        let straight: pass.straight().IsTrue() = Bool::is_true_and_intro(lb.stmt.straight(), Then(mv, Compute(c.region)).straight(), bh.left,
            Bool::is_true_and_intro(mv.straight(), True, mh.left, trivial));
        let fS = ELoop::pass_total(call, c, lb.stmt, mv);
        let fE = ELoop::step(w, g, cond, body, rebind);
        let stepS = λ (e: Env) (io2: Io) => CoTree::bind(Events::none(), pass.run(call, perform)(e, io2), λ m => Stmt::pass_step(cr, m));
        let rest_at = λ (flow: Flow) (v2: rt::Env(w.tys, g)) (q: ELoop::Left(w.tys, g, locs)(flow, v2)) (io2: Io) =>
            ELoop::rest_holds(rest, w, g, locs, next, lr, hr, call, still, agree, perform, below, pos, v2, flow, io2, q);
        // The loop and the meaning's `while`, at the condition's value.
        let at: Eutt<Mutated<Io, ty.sem(w.tys)>>(Events::none(),
                CoTree::bind(Events::none(), match truth as λ _ => Partial(Mutated<Io, Flow>) {
                    True => Stmt::run(Repeat(pass, cr), call, perform)(env1, io),
                    False => Stmt::run(ELoop::skip(), call, perform)(env1, io),
                }, KR),
                CoTree::bind(Events::none(), match truth as λ _ => Partial(Mutated<Io, rt::Env(w.tys, g)>) {
                    True => Io::iterate(Io::total(fE), vals, io),
                    False => CRet(Mutated(io, vals)),
                }, KE)) =
            match truth as λ b => Eutt<Mutated<Io, ty.sem(w.tys)>>(Events::none(),
                    CoTree::bind(Events::none(), match b as λ _ => Partial(Mutated<Io, Flow>) {
                        True => Stmt::run(Repeat(pass, cr), call, perform)(env1, io),
                        False => Stmt::run(ELoop::skip(), call, perform)(env1, io),
                    }, KR),
                    CoTree::bind(Events::none(), match b as λ _ => Partial(Mutated<Io, rt::Env(w.tys, g)>) {
                        True => Io::iterate(Io::total(fE), vals, io),
                        False => CRet(Mutated(io, vals)),
                    }, KE)) {
                True => Eutt::trans(Events::none(),
                    CoTree::bind(Events::none(), Io::iterate<Env, Flow>(stepS, env1, io), KR),
                    CoTree::bind(Events::none(), Io::iterate(Io::total(fS), env1, io), KR),
                    CoTree::bind(Events::none(), Io::iterate(Io::total(fE), vals, io), KE),
                    Eutt::bind_cong_l(Events::none(), Io::iterate<Env, Flow>(stepS, env1, io), Io::iterate(Io::total(fS), env1, io), KR,
                        Io::iterate_cong<Env, Flow>(stepS, Io::total(fS),
                            λ e io2 => ELoop::bind_ret<Mutated<Io, Flow>, Mutated<Io, Step<Env, Flow>>>(pass.run(call, perform)(e, io2),
                                Stmt::thread(pass, call, e, io2), λ m => Stmt::pass_step(cr, m), Stmt::run_straight(pass, call, perform, straight, e, io2)),
                            env1, io)),
                    Io::iterate_rel(fS, fE, ELoop::Held(w.tys, g, locs), ELoop::Left(w.tys, g, locs),
                        ELoop::pass_rel(w, g, locs, next, cond, c, vh, eb, call, still, agree, below, pos, body, lb, bh, rebind, srcs, mv, sh, mh),
                        KR, KE, rest_at, env1, vals, held1, io)),
                False => {
                    let env2 = env1.compute(call, ELoop::nothing());
                    let held2 = locs_hold_same(w.tys, env1, env2, g, locs, vals, ELoop::skip_same(env1, call, locs), held1);
                    Eutt::trans(Events::none(),
                        CoTree::bind(Events::none(), CRet(Mutated(io, Onward(env2))), KR),
                        rest.sem(w, g, vals, io),
                        CoTree::bind(Events::none(), CRet(Mutated(io, vals)), KE),
                        Eutt::trans(Events::none(), CoTree::bind(Events::none(), CRet(Mutated(io, Onward(env2))), KR), KR(Mutated(io, Onward(env2))),
                            rest.sem(w, g, vals, io),
                            Eutt::bind_ret_l(Events::none(), Mutated(io, Onward(env2)), KR), rest_at(Onward(env2), vals, held2, io)),
                        Eutt::sym(Events::none(), CoTree::bind(Events::none(), CRet(Mutated(io, vals)), KE), rest.sem(w, g, vals, io),
                            Eutt::bind_ret_l(Events::none(), Mutated(io, vals), KE)))
                },
            };
        let loop_run = Stmt::run(ELoop::loop_stmt(c, lb.stmt, mv), call, perform)(env, io);
        let branch_run = Stmt::run(branch, call, perform)(env1, io);
        Eutt::trans(Events::none(),
            CoTree::map(Events::none(), Stmt::run(Then(ELoop::loop_stmt(c, lb.stmt, mv), lr.stmt), call, perform)(env, io),
                λ m2 => ELoop::back(ty, w.tys, lr.result, m2)),
            CoTree::bind(Events::none(), loop_run, KR),
            ELoop::sem(ELoop::While(cond, body, rebind, rest), w, g, vals, io),
            ELoop::bind_map<Mutated<Io, Flow>, Mutated<Io, Flow>, Mutated<Io, ty.sem(w.tys)>>(loop_run,
                λ m => Stmt::then_run(λ io2 env2 => lr.stmt.run(call, perform)(env2, io2), m), λ m2 => ELoop::back(ty, w.tys, lr.result, m2)),
            Eutt::trans(Events::none(), CoTree::bind(Events::none(), loop_run, KR), CoTree::bind(Events::none(), branch_run, KR),
                ELoop::sem(ELoop::While(cond, body, rebind, rest), w, g, vals, io),
                Eutt::bind_cong_l(Events::none(), loop_run, branch_run, KR,
                    Eutt::bind_ret_l(Events::none(), Mutated(io, Onward(env1)),
                        λ m => Stmt::then_run(λ io2 env2 => branch.run(call, perform)(env2, io2), m))),
                j(sym(bit), λ y _ => Eutt<Mutated<Io, ty.sem(w.tys)>>(Events::none(),
                        CoTree::bind(Events::none(), match y as λ _ => Partial(Mutated<Io, Flow>) {
                            True => Stmt::run(Repeat(pass, cr), call, perform)(env1, io),
                            False => Stmt::run(ELoop::skip(), call, perform)(env1, io),
                        }, KR),
                        ELoop::sem(ELoop::While(cond, body, rebind, rest), w, g, vals, io)), at)))
    }
}

// The theorem, by induction over the program.
theorem ELoop::lower_sound(self p: ELoop, w: rt::World): (g: List<Ty>) → (locs: List<Loc>) → (next: Nat) →
    ELoop::LowerHolds(p, w, g, locs, next, p.lower(w, g, locs, next)) {
    match p {
        Done(t) => λ g locs next => ELoop::done_holds(t, w, g, locs, next, t.lower(w, g, locs, next), t.lower_sound(w, g, locs, next)),
        Seq(t, rest) => λ g locs next => {
            let P = λ (r: Option<ELowered>) => ELoop::LowerHolds(ELoop::Seq(t, rest), w, g, locs, next, r);
            Option::and_then_elim(P, trivial, t.lower(w, g, locs, next),
                λ lt => rest.lower(w, t.ctx_end(w, g), lt.locs, lt.next).and_then(λ lr =>
                    Some(ELowered(Then(lt.stmt, lr.stmt), lr.result, lr.next, lr.locs))),
                λ lt e_lt => Option::and_then_elim(P, trivial, rest.lower(w, t.ctx_end(w, g), lt.locs, lt.next),
                    λ lr => Some(ELowered(Then(lt.stmt, lr.stmt), lr.result, lr.next, lr.locs)),
                    λ lr e_lr => ELoop::seq_holds(t, rest, w, g, locs, next, lt,
                        j(e_lt, λ r _ => ETm::LowerHolds(t, w, g, locs, next, r), t.lower_sound(w, g, locs, next)), lr,
                        j(e_lr, λ r _ => ELoop::LowerHolds(rest, w, t.ctx_end(w, g), lt.locs, lt.next, r),
                            rest.lower_sound(w, t.ctx_end(w, g), lt.locs, lt.next)))))
        },
        While(cond, body, rebind, rest) => λ g locs next => {
            let P = λ (r: Option<ELowered>) => ELoop::LowerHolds(ELoop::While(cond, body, rebind, rest), w, g, locs, next, r);
            Option::and_then_elim(P, trivial, ELoop::check_bit(Tm::ty(cond, w, g)), λ _ =>
                ETm::lower_value(cond, w, g, locs, next).and_then(λ c =>
                body.lower(w, g, locs, next).and_then(λ lb =>
                ELoop::sources(body.ctx_end(w, g), lb.locs, g, rebind).and_then(λ srcs =>
                ELoop::moves(g, locs, srcs).and_then(λ mv =>
                rest.lower(w, g, locs, next).and_then(λ lr =>
                    Some(ELowered(Then(ELoop::loop_stmt(c, lb.stmt, mv), lr.stmt), lr.result, lr.next, lr.locs))))))), λ eb _ =>
            Option::and_then_elim(P, trivial, ETm::lower_value(cond, w, g, locs, next), λ c =>
                body.lower(w, g, locs, next).and_then(λ lb =>
                ELoop::sources(body.ctx_end(w, g), lb.locs, g, rebind).and_then(λ srcs =>
                ELoop::moves(g, locs, srcs).and_then(λ mv =>
                rest.lower(w, g, locs, next).and_then(λ lr =>
                    Some(ELowered(Then(ELoop::loop_stmt(c, lb.stmt, mv), lr.stmt), lr.result, lr.next, lr.locs)))))), λ c e_c =>
            Option::and_then_elim(P, trivial, body.lower(w, g, locs, next), λ lb =>
                ELoop::sources(body.ctx_end(w, g), lb.locs, g, rebind).and_then(λ srcs =>
                ELoop::moves(g, locs, srcs).and_then(λ mv =>
                rest.lower(w, g, locs, next).and_then(λ lr =>
                    Some(ELowered(Then(ELoop::loop_stmt(c, lb.stmt, mv), lr.stmt), lr.result, lr.next, lr.locs))))), λ lb e_lb =>
            Option::and_then_elim(P, trivial, ELoop::sources(body.ctx_end(w, g), lb.locs, g, rebind), λ srcs =>
                ELoop::moves(g, locs, srcs).and_then(λ mv =>
                rest.lower(w, g, locs, next).and_then(λ lr =>
                    Some(ELowered(Then(ELoop::loop_stmt(c, lb.stmt, mv), lr.stmt), lr.result, lr.next, lr.locs)))), λ srcs e_srcs =>
            Option::and_then_elim(P, trivial, ELoop::moves(g, locs, srcs), λ mv =>
                rest.lower(w, g, locs, next).and_then(λ lr =>
                    Some(ELowered(Then(ELoop::loop_stmt(c, lb.stmt, mv), lr.stmt), lr.result, lr.next, lr.locs))), λ mv e_mv =>
            Option::and_then_elim(P, trivial, rest.lower(w, g, locs, next), λ lr =>
                    Some(ELowered(Then(ELoop::loop_stmt(c, lb.stmt, mv), lr.stmt), lr.result, lr.next, lr.locs)), λ lr e_lr =>
                ELoop::while_holds(cond, body, rebind, rest, w, g, locs, next, eb, c,
                    j(e_c, λ r _ => ETm::ValueHolds(cond, w, g, locs, next, r), ETm::value_sound(cond, w, g, locs, next)),
                    lb, j(e_lb, λ r _ => ETm::LowerHolds(body, w, g, locs, next, r), body.lower_sound(w, g, locs, next)),
                    srcs, j(e_srcs, λ r _ => ELoop::SourcesHold(w.tys, body.ctx_end(w, g), lb.locs, g, rebind, r),
                        ELoop::sources_sound(w.tys, body.ctx_end(w, g), lb.locs, g, rebind)),
                    mv, j(e_mv, λ r _ => ELoop::MovesHold(w.tys, g, locs, srcs, r), ELoop::moves_sound(w.tys, g, locs, srcs)),
                    lr, j(e_lr, λ r _ => ELoop::LowerHolds(rest, w, g, locs, next, r), rest.lower_sound(w, g, locs, next)))))))))
        },
    }
}

// ---------------------------------------------------------------------------
// The R6 statement for programs with loops: `Io::Reads`

// The lowered statements' tree, read against any world, with the value read
// back from its word, agrees with the program's meaning up to silent
// steps, loops and all, from an environment that holds the variables.
fn ELoop::lower_reads(self p: ELoop, w: rt::World, g: List<Ty>, locs: List<Loc>, next: Nat, l: ELowered, lowered: p.lower(w, g, locs, next) = Some(l),
    call: Writers(), still: Writers::Still(call, functions_below(w.sigs.len())), agree: (held: Buffers()) → Tm::CallsAgree(w, Writers::words(call, held)), perform: PerformsCo(), env: Env, vals: rt::Env(w.tys, g),
    held: LocsHold(w.tys, env, g, locs, vals), below: LocsBelow(locs, next), pos: 0 < next) →
    Io::Reads<p.ty(w, g).sem(w.tys)>(CoTree::map(Events::linux(), l.stmt.denote_co(call, perform)(env), λ flow => flow.read_back(p.ty(w, g), w.tys, l.result)),
        λ io => p.sem(w, g, vals, io))
{
    let holds = j(lowered, λ r _ => ELoop::LowerHolds(p, w, g, locs, next, r), p.lower_sound(w, g, locs, next));
    let ty = p.ty(w, g);
    let bound = Io::reads_bind<Flow, ty.sem(w.tys)>(l.stmt.denote_co(call, perform)(env), λ io => l.stmt.run(call, perform)(env, io),
        λ flow => CRet(flow.read_back(ty, w.tys, l.result)), λ flow io => CRet(Mutated(io, flow.read_back(ty, w.tys, l.result))),
        Stmt::reads_run(l.stmt, call, perform, env), λ flow => Io::reads_ret(flow.read_back(ty, w.tys, l.result)));
    λ io => Eutt::trans(Events::none(),
        Io::against_co(CoTree::map(Events::linux(), l.stmt.denote_co(call, perform)(env), λ flow => flow.read_back(ty, w.tys, l.result)), io),
        CoTree::map(Events::none(), l.stmt.run(call, perform)(env, io), λ m => ELoop::back(ty, w.tys, l.result, m)),
        p.sem(w, g, vals, io),
        bound(io), holds(call, still, agree, perform, env, vals, io, held, below, pos))
}

// A pure function that calls procedures, lowered to a procedure's
// statements (docs/native/runtime-fn-recursion-design.md §2, §6 step 2).
//
// A region is a total function of its words, so what it calls must answer
// with a value; a call that can run out of levels is a call between
// statements. A function whose body calls a recursive one (itself, or a
// cycle) is therefore read as a `PTm`: `rt` terms for its pure parts, with
// bindings, branches and calls of procedures between them.
//
// - a value (`Value`) is the pure lowering's region (`Tm::lower`), its
//   word moved to the body's result word `out`;
// - a pure binding (`Bind`) is a `Compute` of its region, its word fresh
//   (`ETm::lower_value`);
// - a call (`Recur`) is a `Perform` on the arguments' words, its result
//   word fresh;
// - a branch (`Choose`) is a `Branch` on the bit variable's word, each arm
//   ending in `out`.
//
// The meaning (`PTm::sem`) reads a call through the procedures' meanings
// `f`, as `Tm::sem` reads a `Call` through the world's. `PTm::lower_sound`
// is the theorem every case is a case of: from any environment holding the
// variables, the statements threaded with each call answered by `f`
// (`Stmt::thread_by`) leave the world and the buffers as they were and the
// meaning's word in `out`, and where the meaning's calls are all `ok`, so
// are the statements' (`Stmt::calls_ok`). What `Source::pure_reads`
// (`native_source_pure`) asks of a body is that, read at the procedure's
// entry.
import logic;
import bool;
import nat;
import list;
import option;
import pair;
import bitvec;
import itree;
import coitree;
import coitree_eutt;
import linux_calls;
import linux_trees;
import linux_world;
import linux_world_co;
import function_ir;
import function_ir_eval;
import function_ir_state;
import function_ir_run;
import native_source;
import native_source_co;
import native_source_io;
import rt;
import rt_lower;
import rt_io;
import rt_io_lower;
import native_source_pure;

// ---------------------------------------------------------------------------
// Terms and their meaning

inductive PTm {
    // The value: a word.
    Value(v: Tm),
    // A pure value bound once: `body` sees it as variable 0.
    Bind(e: Tm, body: PTm),
    // Procedure `p` called on word variables: `body` sees its word as
    // variable 0.
    Recur(p: Nat, args: List<Nat>, body: PTm),
    // A branch on a bit variable.
    Choose(c: Nat, yes: PTm, no: PTm),
}

// What the procedures mean: each one's word from its argument words.
fn PCalls() → Type { Nat → List<BitVec(64)> → BitVec(64) }

// Variables as words, each cast to a word as the meaning reads it.
fn PTm::words(w: rt::World, g: List<Ty>, vals: rt::Env(w.tys, g), args: List<Nat>) → List<BitVec(64)> {
    match args {
        Nil => Nil,
        Cons(a, more) => Cons(Ty::cast(w.tys, Ty::at(g, a), Word(64), Env::get(w.tys, g, vals, a)), PTm::words(w, g, vals, more)),
    }
}

fn PTm::sem(self t: PTm, w: rt::World, f: PCalls()) → (g: List<Ty>) → rt::Env(w.tys, g) → BitVec(64) {
    match t {
        Value(v) => λ g vals => Ty::cast(w.tys, Tm::ty(v, w, g), Word(64), Tm::sem(v, w, g, vals)),
        Bind(e, body) => λ g vals => body.sem(w, f, Cons(Tm::ty(e, w, g), g), Pair(Tm::sem(e, w, g, vals), vals)),
        Recur(p, args, body) => λ g vals => body.sem(w, f, Cons(Word(64), g), Pair(f(p, PTm::words(w, g, vals, args)), vals)),
        Choose(c, yes, no) => λ g vals => match Ty::cast(w.tys, Ty::at(g, c), Bit, Env::get(w.tys, g, vals, c)) {
            True => yes.sem(w, f, g, vals),
            False => no.sem(w, f, g, vals),
        },
    }
}

// Whether every call the meaning makes is `ok`, read on its procedure and
// argument words.
fn PTm::calls_ok(self t: PTm, w: rt::World, f: PCalls(), ok: Nat → List<BitVec(64)> → Bool) → (g: List<Ty>) → rt::Env(w.tys, g) → Bool {
    match t {
        Value(_) => λ g vals => True,
        Bind(e, body) => λ g vals => body.calls_ok(w, f, ok, Cons(Tm::ty(e, w, g), g), Pair(Tm::sem(e, w, g, vals), vals)),
        Recur(p, args, body) => λ g vals => ok(p, PTm::words(w, g, vals, args))
            && body.calls_ok(w, f, ok, Cons(Word(64), g), Pair(f(p, PTm::words(w, g, vals, args)), vals)),
        Choose(c, yes, no) => λ g vals => match Ty::cast(w.tys, Ty::at(g, c), Bit, Env::get(w.tys, g, vals, c)) {
            True => yes.calls_ok(w, f, ok, g, vals),
            False => no.calls_ok(w, f, ok, g, vals),
        },
    }
}

// A call within `k` levels: it spends one where counted, and its callee
// fits within the rest.
fn PTm::within(fits: Nat → Nat → List<BitVec(64)> → Bool, counted: Nat → Bool, k: Nat) → Nat → List<BitVec(64)> → Bool {
    λ p xs => match k.spend(counted(p)) { None => False, Some(j) => fits(j, p, xs) }
}

// What every call is `ok` by, it is by any weaker `ok`.
theorem PTm::calls_ok_mono(self t: PTm, w: rt::World, f: PCalls(), ok1, ok2: Nat → List<BitVec(64)> → Bool,
    more: (p: Nat) → (xs: List<BitVec(64)>) → ok1(p, xs).IsTrue() → ok2(p, xs).IsTrue()):
    (g: List<Ty>) → (vals: rt::Env(w.tys, g)) → t.calls_ok(w, f, ok1, g, vals).IsTrue() → t.calls_ok(w, f, ok2, g, vals).IsTrue() {
    match t {
        Value(_) => λ g vals _ => trivial,
        Bind(e, body) => λ g vals h => body.calls_ok_mono(w, f, ok1, ok2, more, Cons(Tm::ty(e, w, g), g), Pair(Tm::sem(e, w, g, vals), vals), h),
        Recur(p, args, body) => λ g vals h => {
            let xs = PTm::words(w, g, vals, args);
            let parts = Bool::both(h);
            Bool::is_true_and_intro(ok2(p, xs), body.calls_ok(w, f, ok2, Cons(Word(64), g), Pair(f(p, xs), vals)),
                more(p, xs, parts.left), body.calls_ok_mono(w, f, ok1, ok2, more, Cons(Word(64), g), Pair(f(p, xs), vals), parts.right))
        },
        Choose(c, yes, no) => λ g vals => match Ty::cast(w.tys, Ty::at(g, c), Bit, Env::get(w.tys, g, vals, c)) as λ b =>
                (match b as λ _ => Bool { True => yes.calls_ok(w, f, ok1, g, vals), False => no.calls_ok(w, f, ok1, g, vals) }).IsTrue() →
                (match b as λ _ => Bool { True => yes.calls_ok(w, f, ok2, g, vals), False => no.calls_ok(w, f, ok2, g, vals) }).IsTrue() {
            True => λ h => yes.calls_ok_mono(w, f, ok1, ok2, more, g, vals, h),
            False => λ h => no.calls_ok_mono(w, f, ok1, ok2, more, g, vals, h),
        },
    }
}

// ---------------------------------------------------------------------------
// The lowering

// A value's region, its word moved to `out`.
fn PTm::to_out(l: Lowered, out: Nat) → StructuredRegion {
    Compose(l.region, Dataflow(Region(Ports(Nil), [Move(64, out, l.result)], Ports(Nil))))
}

// The words a call's arguments live in: each a word variable.
fn PTm::arg_words(g: List<Ty>, locs: List<Loc>, args: List<Nat>) → Option<List<Nat>> {
    match args {
        Nil => Some(Nil),
        Cons(a, more) => ETm::operand(g, locs, Word(64), a).and_then(λ id => PTm::arg_words(g, locs, more).and_then(λ ids => Some(Cons(id, ids)))),
    }
}

// A body's statements, its value left in `out`. Each call is of a procedure
// `known` names, on word variables, its word fresh at `next`; a value or a
// binding is a region that keeps the buffers and calls only the world's
// functions.
fn PTm::lower(self t: PTm, w: rt::World, known: Nat → Nat → Bool, g: List<Ty>, locs: List<Loc>, next, out: Nat) → Option<Stmt> {
    match t {
        Value(v) => Tm::ty(v, w, g).check(Word(64)).and_then(λ _ =>
            Tm::lower(v, w, g, Loc::ports(locs), next).and_then(λ l =>
            Tm::check_true(l.region.byte_free() && l.region.calls_among(functions_below(w.sigs.len()))).and_then(λ _ =>
                Some(Compute(PTm::to_out(l, out)))))),
        Bind(e, body) => ETm::lower_value(e, w, g, locs, next).and_then(λ c =>
            Tm::check_true(c.region.byte_free() && c.region.calls_among(functions_below(w.sigs.len()))).and_then(λ _ =>
            body.lower(w, known, Cons(Tm::ty(e, w, g), g), Cons(InWord(c.result), locs), c.next, out).and_then(λ sb =>
                Some(Then(Compute(c.region), sb))))),
        Recur(p, args, body) => PTm::arg_words(g, locs, args).and_then(λ ids =>
            Tm::check_true(known(p, ids.len())).and_then(λ _ =>
            body.lower(w, known, Cons(Word(64), g), Cons(InWord(next), locs), next + 1, out).and_then(λ sb =>
                Some(Then(Perform(p, ids, [next]), sb))))),
        Choose(c, yes, no) => ETm::operand(g, locs, Bit, c).and_then(λ id =>
            yes.lower(w, known, g, locs, next, out).and_then(λ sy =>
            no.lower(w, known, g, locs, next, out).and_then(λ sn =>
                Some(Branch(id, sy, sn))))),
    }
}

// ---------------------------------------------------------------------------
// What the lowering promises

// Each call of a known procedure answered by its meaning's word, in its
// result word, with the world and the buffers as they were.
fn PTm::Answers(known: Nat → Nat → Bool, answer: CallAnswers(), f: PCalls()) → Type {
    (p: Nat) → (ids: List<Nat>) → known(p, ids.len()).IsTrue() → (r: Nat) → (env: Env) → (io: Io) →
        answer(p, ids, [r], env, io) = Mutated(io, Onward(env.set_word(r, f(p, env.words_at(ids)))))
}

// A call's `ok` is read on its procedure and argument words.
fn PTm::OkReads(known: Nat → Nat → Bool, ok: Nat → List<Nat> → List<Nat> → Env → Bool, okw: Nat → List<BitVec(64)> → Bool) → Type {
    (p: Nat) → (ids: List<Nat>) → known(p, ids.len()).IsTrue() → (r: Nat) → (env: Env) → ok(p, ids, [r], env) = okw(p, env.words_at(ids))
}

// Where a body's run ends: on, the world and the buffers as they were, the
// value in `out`.
fn PTm::Lands(v: BitVec(64), out: Nat, env: Env, io: Io, m: Mutated<Io, Flow>) → Type {
    (m.after = io) ∧ (match m.value {
        Onward(after) => (after.buffers = env.buffers) ∧ (after.number(out) = v.toNat()),
        Exited(_) => False,
    })
}

// What a lowering promises: loop-free statements that, from any environment
// holding the variables, with each call answered by the procedures'
// meaning, land as the meaning does, and make only calls that are `ok`
// where the meaning's are.
fn PTm::LowerHolds(self t: PTm, w: rt::World, known: Nat → Nat → Bool, g: List<Ty>, locs: List<Loc>, next, out: Nat, r: Option<Stmt>) → Type {
    match r {
        None => True,
        Some(s) => s.loop_free().IsTrue() ∧ ((call: Writers()) → Writers::Still(call, functions_below(w.sigs.len())) →
            ((held: Buffers()) → Tm::CallsAgree(w, Writers::words(call, held))) →
            (f: PCalls()) → (answer: CallAnswers()) → PTm::Answers(known, answer, f) →
            (env: Env) → (vals: rt::Env(w.tys, g)) → (io: Io) → LocsHold(w.tys, env, g, locs, vals) → LocsBelow(locs, next) → 0 < next →
            PTm::Lands(t.sem(w, f, g, vals), out, env, io, Stmt::thread_by(s, call, answer, env, io)) ∧
            ((ok: Nat → List<Nat> → List<Nat> → Env → Bool) → (okw: Nat → List<BitVec(64)> → Bool) → PTm::OkReads(known, ok, okw) →
                t.calls_ok(w, f, okw, g, vals).IsTrue() → s.calls_ok(call, answer, ok, env, io).IsTrue()))
    }
}

// ---------------------------------------------------------------------------
// Sound

// A port holding a value of a code that is a word holds it as a word.
theorem PTm::holds_word(tys: Nat → RecInfo, t: Ty, eq: t = Word(64), values: Valuation(), port: Nat, v: t.sem(tys), h: t.Holds(tys, values, port, v)):
    values(64, port) = Ty::cast(tys, t, Word(64), v) {
    j(sym(eq), λ x _ => (u: x.sem(tys)) → x.Holds(tys, values, port, u) → values(64, port) = Ty::cast(tys, x, Word(64), u),
        λ u k => trans(k, sym(Ty::cast_self(tys, Word(64), u))))(v, h)
}

// A run landing from one environment lands from another with the same
// buffers.
theorem PTm::lands_from(v: BitVec(64), out: Nat, env, env1: Env, io: Io, m: Mutated<Io, Flow>, same: env1.buffers = env.buffers,
    h: PTm::Lands(v, out, env1, io, m)): PTm::Lands(v, out, env, io, m) {
    ⟨h.left, (match m.value as λ x => (match x as λ _ => Type {
                Onward(after) => (after.buffers = env1.buffers) ∧ (after.number(out) = v.toNat()),
                Exited(_) => False,
            }) → (match x as λ _ => Type {
                Onward(after) => (after.buffers = env.buffers) ∧ (after.number(out) = v.toNat()),
                Exited(_) => False,
            }) {
        Onward(_) => λ k => ⟨trans(k.left, same), k.right⟩,
        Exited(_) => λ never => never,
    })(h.right)⟩
}

// The arguments' words are the meaning's.
theorem PTm::arg_words_kept(w: rt::World, env: Env, g: List<Ty>, locs: List<Loc>, vals: rt::Env(w.tys, g), held: LocsHold(w.tys, env, g, locs, vals),
    args: List<Nat>): (ids: List<Nat>) → PTm::arg_words(g, locs, args) = Some(ids) → env.words_at(ids) = PTm::words(w, g, vals, args) {
    match args {
        Nil => λ ids e => j(Option::some_inj(Nil, ids, e), λ z _ => env.words_at(z) = Nil, refl),
        Cons(a, more) => λ ids => {
            let P = λ (r: Option<List<Nat>>) => r = Some(ids) → env.words_at(ids) = PTm::words(w, g, vals, Cons(a, more));
            let none: P(None) = λ never => Option::none_ne_some(ids, never, env.words_at(ids) = PTm::words(w, g, vals, Cons(a, more)));
            Option::and_then_elim(P, none, ETm::operand(g, locs, Word(64), a), λ id => PTm::arg_words(g, locs, more).and_then(λ rest => Some(Cons(id, rest))), λ id e_id =>
            Option::and_then_elim(P, none, PTm::arg_words(g, locs, more), λ rest => Some(Cons(id, rest)), λ rest e_rest =>
                λ (e: Some(Cons(id, rest)) = Some(ids)) => {
                    let x = Ty::cast(w.tys, Ty::at(g, a), Word(64), Env::get(w.tys, g, vals, a));
                    let k = ETm::operand_kept(w.tys, env, g, locs, vals, held, Word(64), a, id, e_id);
                    let first: (env.word(id) = x) = ETm::word_of_kept(env, id, x, k);
                    let tail = PTm::arg_words_kept(w, env, g, locs, vals, held, more, rest, e_rest);
                    j(Option::some_inj(Cons(id, rest), ids, e), λ z _ => env.words_at(z) = PTm::words(w, g, vals, Cons(a, more)),
                        j(first, λ y _ => Cons(env.word(id), env.words_at(rest)) = Cons(y, PTm::words(w, g, vals, more)),
                            cong_fn(λ (ys: List<BitVec(64)>) => Cons(env.word(id), ys), tail)))
                }))
        },
    }
}

theorem PTm::lower_sound(self t: PTm, w: rt::World, known: Nat → Nat → Bool): (g: List<Ty>) → (locs: List<Loc>) → (next, out: Nat) →
    PTm::LowerHolds(t, w, known, g, locs, next, out, t.lower(w, known, g, locs, next, out)) {
    let among = functions_below(w.sigs.len());
    match t {
        Value(v) => λ g locs next out => {
            let P = λ (r: Option<Stmt>) => PTm::LowerHolds(Value(v), w, known, g, locs, next, out, r);
            let tv = Tm::ty(v, w, g);
            Option::and_then_elim(P, trivial, tv.check(Word(64)), λ _ => Tm::lower(v, w, g, Loc::ports(locs), next).and_then(λ l =>
                    Tm::check_true(l.region.byte_free() && l.region.calls_among(among)).and_then(λ _ => Some(Compute(PTm::to_out(l, out))))), λ eq _ =>
            Option::and_then_elim(P, trivial, Tm::lower(v, w, g, Loc::ports(locs), next), λ l =>
                    Tm::check_true(l.region.byte_free() && l.region.calls_among(among)).and_then(λ _ => Some(Compute(PTm::to_out(l, out)))), λ l e_l =>
            Option::and_then_elim(P, trivial, Tm::check_true(l.region.byte_free() && l.region.calls_among(among)), λ _ => Some(Compute(PTm::to_out(l, out))), λ ok _ =>
            ⟨trivial, λ call still agree f answer answers env vals io held below pos => {
                let checked = Bool::is_true_and(l.region.byte_free(), l.region.calls_among(among), ok);
                let lowered = j(e_l, λ r _ => Tm::LowerHolds(v, w, g, Loc::ports(locs), next, r), Tm::lower_sound(v, w, g, Loc::ports(locs), next));
                let r = lowered(Writers::words(call, env.buffers), agree(env.buffers), env.valuation(), vals, locs_env_holds(w.tys, env, g, locs, vals, held),
                    locs_below(w.tys, env, g, next, pos, locs, vals, held, below));
                let ev = l.region.eval(Writers::words(call, env.buffers), env.valuation());
                let held_v = j(l.region.eval_byte_free(Writers::words(call, env.buffers), w.spans, checked.left, env.valuation()),
                    λ u _ => tv.Holds(w.tys, u, l.result, Tm::sem(v, w, g, vals)), r.right.right.right);
                let as_word = PTm::holds_word(w.tys, tv, eq, ev, l.result, Tm::sem(v, w, g, vals), held_v);
                let number = env.compute_moved(call, among, still, l.region, checked.left, checked.right, 64, out, l.result);
                let region = PTm::to_out(l, out);
                let free2: region.byte_free().IsTrue() = Bool::is_true_and_intro(l.region.byte_free(),
                    Dataflow(Region(Ports(Nil), [Move(64, out, l.result)], Ports(Nil))).byte_free(), checked.left, trivial);
                let fits2: region.calls_among(among).IsTrue() = Bool::is_true_and_intro(l.region.calls_among(among), True, checked.right, trivial);
                let keeps = env.compute_buffers(call, among, still, region, free2, fits2);
                ⟨⟨refl, ⟨keeps, trans(number, cong_fn(λ (x: BitVec(64)) => x.toNat(), as_word))⟩⟩, λ ok okw _ _ => trivial⟩
            }⟩)))
        },
        Bind(e, body) => λ g locs next out => {
            let P = λ (r: Option<Stmt>) => PTm::LowerHolds(Bind(e, body), w, known, g, locs, next, out, r);
            let te = Tm::ty(e, w, g);
            Option::and_then_elim(P, trivial, ETm::lower_value(e, w, g, locs, next), λ c =>
                    Tm::check_true(c.region.byte_free() && c.region.calls_among(among)).and_then(λ _ =>
                    body.lower(w, known, Cons(te, g), Cons(InWord(c.result), locs), c.next, out).and_then(λ sb => Some(Then(Compute(c.region), sb)))), λ c e_c =>
            Option::and_then_elim(P, trivial, Tm::check_true(c.region.byte_free() && c.region.calls_among(among)), λ _ =>
                    body.lower(w, known, Cons(te, g), Cons(InWord(c.result), locs), c.next, out).and_then(λ sb => Some(Then(Compute(c.region), sb))), λ ok _ =>
            Option::and_then_elim(P, trivial, body.lower(w, known, Cons(te, g), Cons(InWord(c.result), locs), c.next, out),
                    λ sb => Some(Then(Compute(c.region), sb)), λ sb e_sb => {
                let vh = j(e_c, λ r _ => ETm::ValueHolds(e, w, g, locs, next, r), ETm::value_sound(e, w, g, locs, next));
                let bh = j(e_sb, λ r _ => PTm::LowerHolds(body, w, known, Cons(te, g), Cons(InWord(c.result), locs), c.next, out, r),
                    body.lower_sound(w, known, Cons(te, g), Cons(InWord(c.result), locs), c.next, out));
                ⟨bh.left, λ call still agree f answer answers env vals io held below pos => {
                    let checked = Bool::is_true_and(c.region.byte_free(), c.region.calls_among(among), ok);
                    let v1 = vh.right(call, still, agree, env, vals, held, below, pos);
                    let env1 = env.compute(call, c.region);
                    let keeps = env.compute_buffers(call, among, still, c.region, checked.left, checked.right);
                    let step: (c.next = c.result + 1) = vh.left;
                    let lt: (c.result < c.next) = omega(step);
                    let le: (next <= c.next) = omega(step, v1.left);
                    let pos1: (0 < c.next) = omega(step);
                    let below1: LocsBelow(Cons(InWord(c.result), locs), c.next) = ⟨lt, locs_below_mono(locs, next, c.next, le, below)⟩;
                    let r = bh.right(call, still, agree, f, answer, answers, env1, Pair(Tm::sem(e, w, g, vals), vals), io, v1.right, below1, pos1);
                    ⟨PTm::lands_from(body.sem(w, f, Cons(te, g), Pair(Tm::sem(e, w, g, vals), vals)), out, env, env1, io,
                        Stmt::thread_by(sb, call, answer, env1, io), keeps, r.left), r.right⟩
                }⟩
            })))
        },
        Recur(p, args, body) => λ g locs next out => {
            let P = λ (r: Option<Stmt>) => PTm::LowerHolds(Recur(p, args, body), w, known, g, locs, next, out, r);
            Option::and_then_elim(P, trivial, PTm::arg_words(g, locs, args), λ ids => Tm::check_true(known(p, ids.len())).and_then(λ _ =>
                    body.lower(w, known, Cons(Word(64), g), Cons(InWord(next), locs), next + 1, out).and_then(λ sb => Some(Then(Perform(p, ids, [next]), sb)))), λ ids e_ids =>
            Option::and_then_elim(P, trivial, Tm::check_true(known(p, ids.len())), λ _ =>
                    body.lower(w, known, Cons(Word(64), g), Cons(InWord(next), locs), next + 1, out).and_then(λ sb => Some(Then(Perform(p, ids, [next]), sb))), λ kp _ =>
            Option::and_then_elim(P, trivial, body.lower(w, known, Cons(Word(64), g), Cons(InWord(next), locs), next + 1, out),
                    λ sb => Some(Then(Perform(p, ids, [next]), sb)), λ sb e_sb => {
                let bh = j(e_sb, λ r _ => PTm::LowerHolds(body, w, known, Cons(Word(64), g), Cons(InWord(next), locs), next + 1, out, r),
                    body.lower_sound(w, known, Cons(Word(64), g), Cons(InWord(next), locs), next + 1, out));
                ⟨bh.left, λ call still agree f answer answers env vals io held below pos => {
                    let xs = PTm::words(w, g, vals, args);
                    let words_eq = PTm::arg_words_kept(w, env, g, locs, vals, held, args, ids, e_ids);
                    let x = f(p, xs);
                    let env1 = env.set_word(next, x);
                    let answered: (answer(p, ids, [next], env, io) = Mutated(io, Onward(env1))) =
                        trans(answers(p, ids, kp, next, env, io), cong_fn(λ (ys: List<BitVec(64)>) => Mutated(io, Onward(env.set_word(next, f(p, ys)))), words_eq));
                    let held1: LocsHold(w.tys, env1, Cons(Word(64), g), Cons(InWord(next), locs), Pair(x, vals)) =
                        ⟨env.number_set_here(next, x), locs_hold_same(w.tys, env, env1, g, locs, vals, Loc::same_set_word(locs, env, next, x, below), held)⟩;
                    let lt: (next < next + 1) = omega();
                    let le: (next <= next + 1) = omega();
                    let pos1: (0 < next + 1) = omega();
                    let below1: LocsBelow(Cons(InWord(next), locs), next + 1) = ⟨lt, locs_below_mono(locs, next, next + 1, le, below)⟩;
                    let r = bh.right(call, still, agree, f, answer, answers, env1, Pair(x, vals), io, held1, below1, pos1);
                    let v = body.sem(w, f, Cons(Word(64), g), Pair(x, vals));
                    let lands = j(sym(answered), λ m _ => PTm::Lands(v, out, env, io, match m.value as λ _ => Mutated<Io, Flow> {
                            Onward(n) => Stmt::thread_by(sb, call, answer, n, m.after),
                            Exited(s) => Mutated(m.after, Exited(s)),
                        }),
                        PTm::lands_from(v, out, env, env1, io, Stmt::thread_by(sb, call, answer, env1, io), refl, r.left));
                    ⟨lands, λ ok okw reads okm => {
                        let parts = Bool::is_true_and(okw(p, xs), body.calls_ok(w, f, okw, Cons(Word(64), g), Pair(x, vals)), okm);
                        let read: (ok(p, ids, [next], env) = okw(p, xs)) = trans(reads(p, ids, kp, next, env), cong_fn(λ (ys: List<BitVec(64)>) => okw(p, ys), words_eq));
                        let first: ok(p, ids, [next], env).IsTrue() = j(sym(read), λ b _ => b.IsTrue(), parts.left);
                        let rest_ok = j(sym(answered), λ m _ => (match m.value as λ _ => Bool {
                                Onward(n) => sb.calls_ok(call, answer, ok, n, m.after),
                                Exited(_) => True,
                            }).IsTrue(), r.right(ok, okw, reads, parts.right));
                        Bool::is_true_and_intro(ok(p, ids, [next], env), match answer(p, ids, [next], env, io).value as λ _ => Bool {
                                Onward(n) => sb.calls_ok(call, answer, ok, n, answer(p, ids, [next], env, io).after),
                                Exited(_) => True,
                            }, first, rest_ok)
                    }⟩
                }⟩
            })))
        },
        Choose(c, yes, no) => λ g locs next out => {
            let P = λ (r: Option<Stmt>) => PTm::LowerHolds(Choose(c, yes, no), w, known, g, locs, next, out, r);
            Option::and_then_elim(P, trivial, ETm::operand(g, locs, Bit, c), λ id => yes.lower(w, known, g, locs, next, out).and_then(λ sy =>
                    no.lower(w, known, g, locs, next, out).and_then(λ sn => Some(Branch(id, sy, sn)))), λ id e_id =>
            Option::and_then_elim(P, trivial, yes.lower(w, known, g, locs, next, out), λ sy =>
                    no.lower(w, known, g, locs, next, out).and_then(λ sn => Some(Branch(id, sy, sn))), λ sy e_sy =>
            Option::and_then_elim(P, trivial, no.lower(w, known, g, locs, next, out), λ sn => Some(Branch(id, sy, sn)), λ sn e_sn => {
                let yh = j(e_sy, λ r _ => PTm::LowerHolds(yes, w, known, g, locs, next, out, r), yes.lower_sound(w, known, g, locs, next, out));
                let nh = j(e_sn, λ r _ => PTm::LowerHolds(no, w, known, g, locs, next, out, r), no.lower_sound(w, known, g, locs, next, out));
                ⟨Bool::is_true_and_intro(sy.loop_free(), sn.loop_free(), yh.left, nh.left), λ call still agree f answer answers env vals io held below pos => {
                    let cv = Ty::cast(w.tys, Ty::at(g, c), Bit, Env::get(w.tys, g, vals, c));
                    let k = ETm::operand_kept(w.tys, env, g, locs, vals, held, Bit, c, id, e_id);
                    let bit: (env.bit(id) = cv) = trans(cong_fn(λ (n: Nat) => ETm::word_at(64, n).head_bit(), k), ETm::head_bool(cv));
                    let ry = yh.right(call, still, agree, f, answer, answers, env, vals, io, held, below, pos);
                    let rn = nh.right(call, still, agree, f, answer, answers, env, vals, io, held, below, pos);
                    j(sym(bit), λ x _ => PTm::Lands(match cv as λ _ => BitVec(64) { True => yes.sem(w, f, g, vals), False => no.sem(w, f, g, vals) }, out, env, io,
                                match x as λ _ => Mutated<Io, Flow> {
                                    True => Stmt::thread_by(sy, call, answer, env, io),
                                    False => Stmt::thread_by(sn, call, answer, env, io),
                                }) ∧
                            ((ok: Nat → List<Nat> → List<Nat> → Env → Bool) → (okw: Nat → List<BitVec(64)> → Bool) → PTm::OkReads(known, ok, okw) →
                                (match cv as λ _ => Bool { True => yes.calls_ok(w, f, okw, g, vals), False => no.calls_ok(w, f, okw, g, vals) }).IsTrue() →
                                (match x as λ _ => Bool { True => sy.calls_ok(call, answer, ok, env, io), False => sn.calls_ok(call, answer, ok, env, io) }).IsTrue()),
                        match cv as λ b => PTm::Lands(match b as λ _ => BitVec(64) { True => yes.sem(w, f, g, vals), False => no.sem(w, f, g, vals) }, out, env, io,
                                match b as λ _ => Mutated<Io, Flow> {
                                    True => Stmt::thread_by(sy, call, answer, env, io),
                                    False => Stmt::thread_by(sn, call, answer, env, io),
                                }) ∧
                            ((ok: Nat → List<Nat> → List<Nat> → Env → Bool) → (okw: Nat → List<BitVec(64)> → Bool) → PTm::OkReads(known, ok, okw) →
                                (match b as λ _ => Bool { True => yes.calls_ok(w, f, okw, g, vals), False => no.calls_ok(w, f, okw, g, vals) }).IsTrue() →
                                (match b as λ _ => Bool { True => sy.calls_ok(call, answer, ok, env, io), False => sn.calls_ok(call, answer, ok, env, io) }).IsTrue()) {
                            True => ry,
                            False => rn,
                        })
                }⟩
            })))
        },
    }
}

// ---------------------------------------------------------------------------
// Procedures from bodies: what `Source::pure_reads` asks of them
//
// A body over `n` word variables is a procedure whose parameters are words
// `0` to `n - 1`, whose value is word `n`, and whose statements start past
// it (`PDef::procedure`). Read at its entry, its statements are its
// meaning at its parameter words, so the procedures' meanings, given as
// functions that unfold to their bodies' (`PDef::Unfolds`), and which
// entries fit within how many levels, given as a predicate their bodies'
// calls keep (`PDef::Fits`), meet every obligation of
// `Source::PureBodies` (`PDef::bodies`). Where every call is counted, as
// in a recursive function whose every call of itself is checked, the
// predicate is `PDef::fits`, by recursion on the levels (`PDef::fits_fit`).

// Words `from` to `from + n - 1`.
fn PTm::range(from, n: Nat) → List<Nat> {
    match n { Zero => Nil, Succ(m) => Cons(from, PTm::range(from + 1, m)) }
}

// `n` word variables.
fn PTm::word_ctx(n: Nat) → List<Ty> {
    match n { Zero => Nil, Succ(m) => Cons(Word(64), PTm::word_ctx(m)) }
}

// Variable `i` in word `from + i`.
fn PTm::param_locs(from, n: Nat) → List<Loc> {
    match n { Zero => Nil, Succ(m) => Cons(InWord(from), PTm::param_locs(from + 1, m)) }
}

// The values of `n` word variables, from words; a missing one is zero.
fn PTm::vals_n(tys: Nat → RecInfo, n: Nat, xs: List<BitVec(64)>) → rt::Env(tys, PTm::word_ctx(n)) {
    match n as λ k => rt::Env(tys, PTm::word_ctx(k)) {
        Zero => trivial,
        Succ(m) => match xs {
            Nil => Pair(BitVec::ofNat(0), PTm::vals_n(tys, m, Nil)),
            Cons(x, rest) => Pair(x, PTm::vals_n(tys, m, rest)),
        },
    }
}

// The words from `from` on hold `xs`, in order.
fn PTm::WordsAt(env: Env, from: Nat, xs: List<BitVec(64)>) → Type {
    match xs { Nil => True, Cons(x, rest) => (env.number(from) = x.toNat()) ∧ PTm::WordsAt(env, from + 1, rest) }
}

theorem PTm::range_len(n: Nat): (from: Nat) → PTm::range(from, n).len() = n {
    match n {
        Zero => λ from => refl,
        Succ(m) => λ from => cong_fn(λ (k: Nat) => Succ(k), PTm::range_len(m, from + 1)),
    }
}

theorem PTm::words_at_len(env: Env, ids: List<Nat>): env.words_at(ids).len() = ids.len() {
    match ids {
        Nil => refl,
        Cons(_, rest) => cong_fn(λ (k: Nat) => Succ(k), PTm::words_at_len(env, rest)),
    }
}

// Setting the words from `from` on keeps every word below it.
theorem PTm::set_words_below(m: Nat): (from: Nat) → (ws: List<BitVec(64)>) → (env: Env) → (k: Nat) → k < from →
    env.set_words(PTm::range(from, m), ws).number(k) = env.number(k) {
    match m {
        Zero => λ from ws env k _ => refl,
        Succ(m2) => λ from ws => match ws {
            Nil => λ env k _ => refl,
            Cons(x, more) => λ env k lt => {
                let lt2: (k < from + 1) = omega(lt);
                let ne: (k ≠ from) = Nat::ne_of_lt(k, from, lt);
                trans(PTm::set_words_below(m2, from + 1, more, env.set_word(from, x), k, lt2), env.number_set_other(from, x, k, ne))
            },
        },
    }
}

// Words set from `from` on hold what they were set to.
theorem PTm::set_words_at(xs: List<BitVec(64)>): (from: Nat) → (env: Env) → PTm::WordsAt(env.set_words(PTm::range(from, xs.len()), xs), from, xs) {
    match xs {
        Nil => λ from env => trivial,
        Cons(x, rest) => λ from env => {
            let lt: (from < from + 1) = omega();
            ⟨trans(PTm::set_words_below(rest.len(), from + 1, rest, env.set_word(from, x), from, lt), env.number_set_here(from, x)),
                PTm::set_words_at(rest, from + 1, env.set_word(from, x))⟩
        },
    }
}

// Words holding `xs` read back as `xs`.
theorem PTm::words_of(xs: List<BitVec(64)>): (from: Nat) → (env: Env) → PTm::WordsAt(env, from, xs) → env.words_at(PTm::range(from, xs.len())) = xs {
    match xs {
        Nil => λ from env _ => refl,
        Cons(x, rest) => λ from env h => {
            let first: (env.word(from) = x) = ETm::word_of_kept(env, from, x, h.left);
            j(first, λ y _ => Cons(env.word(from), env.words_at(PTm::range(from + 1, rest.len()))) = Cons(y, rest),
                cong_fn(λ (ys: List<BitVec(64)>) => Cons(env.word(from), ys), PTm::words_of(rest, from + 1, env, h.right)))
        },
    }
}

// A callee entered with as many argument words as it has parameters reads
// them back.
theorem PTm::entered_words(env, callee: Env, ids: List<Nat>, n: Nat, len: ids.len() = n):
    native_source::Env(Nil, env.buffers, env.args).set_words(PTm::range(0, n), callee.words_at(ids)).words_at(PTm::range(0, n)) = callee.words_at(ids) {
    let xs = callee.words_at(ids);
    let lx: (xs.len() = n) = trans(PTm::words_at_len(callee, ids), len);
    j(lx, λ k _ => native_source::Env(Nil, env.buffers, env.args).set_words(PTm::range(0, k), xs).words_at(PTm::range(0, k)) = xs,
        PTm::words_of(xs, 0, native_source::Env(Nil, env.buffers, env.args).set_words(PTm::range(0, xs.len()), xs),
            PTm::set_words_at(xs, 0, native_source::Env(Nil, env.buffers, env.args))))
}

// Every word a number a word can hold.
fn PTm::Bounded(env: Env) → Type { (k: Nat) → env.number(k) < Nat::pow(2, 64) }

theorem PTm::bounded_set_word(env: Env, b: PTm::Bounded(env), id: Nat, x: BitVec(64)): PTm::Bounded(env.set_word(id, x)) {
    λ k => match k.eq_dec(id) {
        Inl(e) => j(sym(e), λ q _ => env.set_word(id, x).number(q) < Nat::pow(2, 64),
            j(sym(env.number_set_here(id, x)), λ v _ => v < Nat::pow(2, 64), BitVec::toNat_lt_pow(64, x))),
        Inr(ne) => j(sym(env.number_set_other(id, x, k, ne)), λ v _ => v < Nat::pow(2, 64), b(k)),
    }
}

theorem PTm::bounded_set_words(ids: List<Nat>): (ws: List<BitVec(64)>) → (env: Env) → PTm::Bounded(env) → PTm::Bounded(env.set_words(ids, ws)) {
    match ids {
        Nil => λ ws env b => b,
        Cons(id, rest) => λ ws => match ws {
            Nil => λ env b => b,
            Cons(x, more) => λ env b => PTm::bounded_set_words(rest, more, env.set_word(id, x), PTm::bounded_set_word(env, b, id, x)),
        },
    }
}

theorem PTm::bounded_none(buffers, args: List<List<BitVec(8)>>): PTm::Bounded(native_source::Env(Nil, buffers, args)) {
    λ k => {
        let one: (1 <= Nat::pow(2, 64)) = Nat::one_le_pow(2, 64, trivial);
        let zero: (native_source::Env(Nil, buffers, args).number(k) = 0) = refl;
        j(sym(zero), λ v _ => v < Nat::pow(2, 64), omega(one))
    }
}

// Bounded words hold what they read as.
theorem PTm::words_at_bounded(m: Nat): (from: Nat) → (env: Env) → PTm::Bounded(env) → PTm::WordsAt(env, from, env.words_at(PTm::range(from, m))) {
    match m {
        Zero => λ from env b => trivial,
        Succ(m2) => λ from env b => ⟨sym(BitVec::toNat_ofNat(64, env.number(from), b(from))), PTm::words_at_bounded(m2, from + 1, env, b)⟩,
    }
}

// Words holding `xs` hold the `n` word variables they are.
theorem PTm::hold_params(tys: Nat → RecInfo, n: Nat): (xs: List<BitVec(64)>) → xs.len() = n → (env: Env) → (from: Nat) → PTm::WordsAt(env, from, xs) →
    LocsHold(tys, env, PTm::word_ctx(n), PTm::param_locs(from, n), PTm::vals_n(tys, n, xs)) {
    match n {
        Zero => λ xs _ env from _ => trivial,
        Succ(m) => λ xs => match xs {
            Nil => λ never => {
                let bad: False = omega(never);
                false_elim(bad)
            },
            Cons(_, rest) => λ len env from h => {
                let len2: (rest.len() = m) = omega(len);
                ⟨h.left, PTm::hold_params(tys, m, rest, len2, env, from + 1, h.right)⟩
            },
        },
    }
}

theorem PTm::params_below(m: Nat): (from, bound: Nat) → from + m <= bound → LocsBelow(PTm::param_locs(from, m), bound) {
    match m {
        Zero => λ from bound _ => trivial,
        Succ(m2) => λ from bound le => {
            let lt: (from < bound) = omega(le);
            let le2: ((from + 1) + m2 <= bound) = omega(le);
            ⟨lt, PTm::params_below(m2, from + 1, bound, le2)⟩
        },
    }
}

// A procedure's body: how many word arguments it takes, and its term over
// them.
record PDef { arity: Nat, body: PTm }

// Its parameters the first words, its value the word after them, its
// statements past that.
fn PDef::procedure(self d: PDef, w: rt::World, known: Nat → Nat → Bool) → Option<Procedure> {
    d.body.lower(w, known, PTm::word_ctx(d.arity), PTm::param_locs(0, d.arity), d.arity + 1, d.arity)
        .and_then(λ s => Some(Procedure(PTm::range(0, d.arity), [d.arity], s)))
}

fn PDef::procedures(defs: List<PDef>, w: rt::World, known: Nat → Nat → Bool) → Option<List<Procedure>> {
    match defs {
        Nil => Some(Nil),
        Cons(d, rest) => d.procedure(w, known).and_then(λ proc => PDef::procedures(rest, w, known).and_then(λ procs => Some(Cons(proc, procs)))),
    }
}

// The calls a body may make: of a definition, with as many arguments as it
// takes.
fn PDef::known(defs: List<PDef>) → Nat → Nat → Bool {
    λ p m => match defs.nth(p) { None => False, Some(d) => m.matches(d.arity) }
}

fn PDef::arity_at(defs: List<PDef>, p: Nat) → Nat { match defs.nth(p) { None => 0, Some(d) => d.arity } }

// Each procedure's value, and whether it fits within `k` levels, read at
// its parameter words.
fn PDef::spec(defs: List<PDef>, f: PCalls(), fits: Nat → Nat → List<BitVec(64)> → Bool) → PureSpec {
    PureSpec(λ p entered => [f(p, entered.words_at(PTm::range(0, PDef::arity_at(defs, p))))],
        λ k p entered => fits(k, p, entered.words_at(PTm::range(0, PDef::arity_at(defs, p)))))
}

// The procedures' meanings unfold to their bodies' (each function's pin).
fn PDef::Unfolds(defs: List<PDef>, w: rt::World, f: PCalls()) → Type {
    (p: Nat) → (d: PDef) → defs.nth(p) = Some(d) → (xs: List<BitVec(64)>) →
        f(p, xs) = d.body.sem(w, f, PTm::word_ctx(d.arity), PTm::vals_n(w.tys, d.arity, xs))
}

// Where one fits within `k` levels, every call its body makes is within
// them.
fn PDef::Fits(defs: List<PDef>, w: rt::World, f: PCalls(), fits: Nat → Nat → List<BitVec(64)> → Bool, counted: Nat → Bool) → Type {
    (p: Nat) → (d: PDef) → defs.nth(p) = Some(d) → (xs: List<BitVec(64)>) → (k: Nat) → fits(k, p, xs).IsTrue() →
        d.body.calls_ok(w, f, PTm::within(fits, counted, k), PTm::word_ctx(d.arity), PTm::vals_n(w.tys, d.arity, xs)).IsTrue()
}

// Whether definition `p`'s body, at `xs`, makes only calls `below` allows.
fn PDef::body_fits(defs: List<PDef>, w: rt::World, f: PCalls(), below: Nat → List<BitVec(64)> → Bool, p: Nat, xs: List<BitVec(64)>) → Bool {
    match defs.nth(p) { None => True, Some(d) => d.body.calls_ok(w, f, below, PTm::word_ctx(d.arity), PTm::vals_n(w.tys, d.arity, xs)) }
}

// Whether definition `p` at `xs` runs within `k` levels when every call
// spends one: each call its body makes fits within the levels below. At a
// closed argument it evaluates, so `f::fits(levels, x) = True` is `refl`.
fn PDef::fits(defs: List<PDef>, w: rt::World, f: PCalls(), k: Nat) → Nat → List<BitVec(64)> → Bool {
    match k {
        Zero => λ p xs => PDef::body_fits(defs, w, f, λ _ _ => False, p, xs),
        Succ(j) => λ p xs => PDef::body_fits(defs, w, f, PDef::fits(defs, w, f, j), p, xs),
    }
}

// What `PDef::fits` at `k` lets a body's calls do: nothing at none, and
// fit within one fewer otherwise.
fn PDef::below(defs: List<PDef>, w: rt::World, f: PCalls(), k: Nat) → Nat → List<BitVec(64)> → Bool {
    match k { Zero => λ _ _ => False, Succ(j) => PDef::fits(defs, w, f, j) }
}

// Where every call is counted, `PDef::fits` is what the bodies' calls keep.
theorem PDef::fits_fit(defs: List<PDef>, w: rt::World, f: PCalls(), counted: Nat → Bool, all: (p: Nat) → counted(p) = True):
    PDef::Fits(defs, w, f, λ k p xs => PDef::fits(defs, w, f, k, p, xs), counted) {
    let fits = λ (k: Nat) (p: Nat) (xs: List<BitVec(64)>) => PDef::fits(defs, w, f, k, p, xs);
    λ p d found xs k fit => {
        let below = PDef::below(defs, w, f, k);
        let at: (PDef::fits(defs, w, f, k, p, xs) = PDef::body_fits(defs, w, f, below, p, xs)) =
            match k as λ k2 => PDef::fits(defs, w, f, k2, p, xs) = PDef::body_fits(defs, w, f, PDef::below(defs, w, f, k2), p, xs) {
                Zero => refl,
                Succ(_) => refl,
            };
        let body: (d.body.calls_ok(w, f, below, PTm::word_ctx(d.arity), PTm::vals_n(w.tys, d.arity, xs)).IsTrue()) =
            j(found, λ o _ => (match o as λ _ => Bool { None => True, Some(d2) => d2.body.calls_ok(w, f, below, PTm::word_ctx(d2.arity), PTm::vals_n(w.tys, d2.arity, xs)) }).IsTrue(),
                j(at, λ b _ => b.IsTrue(), fit));
        d.body.calls_ok_mono(w, f, below, PTm::within(fits, counted, k), λ q ys ok => {
            let spent = j(sym(all(q)), λ b _ => (match k.spend(b) as λ _ => Bool { None => False, Some(j2) => fits(j2, q, ys) }) =
                    (match k.spend(True) as λ _ => Bool { None => False, Some(j2) => fits(j2, q, ys) }), refl);
            let on_k = (match k as λ k2 => PDef::below(defs, w, f, k2, q, ys).IsTrue() →
                    (match k2.spend(True) as λ _ => Bool { None => False, Some(j2) => fits(j2, q, ys) }).IsTrue() {
                Zero => λ never => false_elim(never),
                Succ(_) => λ h => h,
            })(ok);
            j(sym(spent), λ b _ => b.IsTrue(), on_k)
        }, PTm::word_ctx(d.arity), PTm::vals_n(w.tys, d.arity, xs), body)
    }
}

// A procedure at an index is the definition's there.
theorem PDef::procedures_at(defs: List<PDef>, w: rt::World, known: Nat → Nat → Bool): (ps: List<Procedure>) → PDef::procedures(defs, w, known) = Some(ps) →
    (p: Nat) → (proc: Procedure) → ps.nth(p) = Some(proc) →
    (match defs.nth(p) as λ _ => Type { None => False, Some(d) => d.procedure(w, known) = Some(proc) }) {
    match defs {
        Nil => λ ps e p proc found => {
            let none: (ps.nth(p) = None) = j(Option::some_inj(Nil, ps, e), λ z _ => z.nth(p) = None, refl);
            Option::none_ne_some(proc, trans(sym(none), found), False)
        },
        Cons(d, rest) => λ ps => {
            let P = λ (r: Option<List<Procedure>>) => r = Some(ps) → (p: Nat) → (proc: Procedure) → ps.nth(p) = Some(proc) →
                (match Cons(d, rest).nth(p) as λ _ => Type { None => False, Some(d2) => d2.procedure(w, known) = Some(proc) });
            let none: P(None) = λ never => Option::none_ne_some(ps, never, (p: Nat) → (proc: Procedure) → ps.nth(p) = Some(proc) →
                (match Cons(d, rest).nth(p) as λ _ => Type { None => False, Some(d2) => d2.procedure(w, known) = Some(proc) }));
            Option::and_then_elim(P, none, d.procedure(w, known), λ proc0 => PDef::procedures(rest, w, known).and_then(λ ps0 => Some(Cons(proc0, ps0))), λ proc0 e0 =>
            Option::and_then_elim(P, none, PDef::procedures(rest, w, known), λ ps0 => Some(Cons(proc0, ps0)), λ ps0 e1 =>
                λ (e: Some(Cons(proc0, ps0)) = Some(ps)) p proc found => {
                    let found2: (Cons(proc0, ps0).nth(p) = Some(proc)) = trans(cong_fn(λ (z: List<Procedure>) => z.nth(p), Option::some_inj(Cons(proc0, ps0), ps, e)), found);
                    (match p as λ i => Cons(proc0, ps0).nth(i) = Some(proc) →
                            (match Cons(d, rest).nth(i) as λ _ => Type { None => False, Some(d2) => d2.procedure(w, known) = Some(proc) }) {
                        Zero => λ h => trans(e0, h),
                        Succ(i) => λ h => PDef::procedures_at(rest, w, known, ps0, e1, i, proc, h),
                    })(found2)
                }))
        },
    }
}

// A definition at an index has its procedure there.
theorem PDef::procedures_found(defs: List<PDef>, w: rt::World, known: Nat → Nat → Bool): (ps: List<Procedure>) → PDef::procedures(defs, w, known) = Some(ps) →
    (p: Nat) → (d: PDef) → defs.nth(p) = Some(d) →
    (match ps.nth(p) as λ _ => Type { None => False, Some(proc) => d.procedure(w, known) = Some(proc) }) {
    match defs {
        Nil => λ ps e p d found => Option::none_ne_some(d, found, match ps.nth(p) as λ _ => Type { None => False, Some(proc) => d.procedure(w, known) = Some(proc) }),
        Cons(d0, rest) => λ ps => {
            let P = λ (r: Option<List<Procedure>>) => r = Some(ps) → (p: Nat) → (d: PDef) → Cons(d0, rest).nth(p) = Some(d) →
                (match ps.nth(p) as λ _ => Type { None => False, Some(proc) => d.procedure(w, known) = Some(proc) });
            let none: P(None) = λ never => Option::none_ne_some(ps, never, (p: Nat) → (d: PDef) → Cons(d0, rest).nth(p) = Some(d) →
                (match ps.nth(p) as λ _ => Type { None => False, Some(proc) => d.procedure(w, known) = Some(proc) }));
            Option::and_then_elim(P, none, d0.procedure(w, known), λ proc0 => PDef::procedures(rest, w, known).and_then(λ ps0 => Some(Cons(proc0, ps0))), λ proc0 e0 =>
            Option::and_then_elim(P, none, PDef::procedures(rest, w, known), λ ps0 => Some(Cons(proc0, ps0)), λ ps0 e1 =>
                λ (e: Some(Cons(proc0, ps0)) = Some(ps)) p d found =>
                    j(Option::some_inj(Cons(proc0, ps0), ps, e), λ z _ => (match z.nth(p) as λ _ => Type { None => False, Some(proc) => d.procedure(w, known) = Some(proc) }),
                        (match p as λ i => Cons(d0, rest).nth(i) = Some(d) →
                                (match Cons(proc0, ps0).nth(i) as λ _ => Type { None => False, Some(proc) => d.procedure(w, known) = Some(proc) }) {
                            Zero => λ h => j(Option::some_inj(d0, d, h), λ x _ => x.procedure(w, known) = Some(proc0), e0),
                            Succ(i) => λ h => PDef::procedures_found(rest, w, known, ps0, e1, i, d, h),
                        })(found))))
        },
    }
}

// A definition's procedure: its parameters, its value word, its lowered body.
theorem PDef::procedure_parts(self d: PDef, w: rt::World, known: Nat → Nat → Bool, proc: Procedure, made: d.procedure(w, known) = Some(proc)):
    (proc.params = PTm::range(0, d.arity)) ∧ ((proc.results = [d.arity]) ∧
        (d.body.lower(w, known, PTm::word_ctx(d.arity), PTm::param_locs(0, d.arity), d.arity + 1, d.arity) = Some(proc.body))) {
    let low = d.body.lower(w, known, PTm::word_ctx(d.arity), PTm::param_locs(0, d.arity), d.arity + 1, d.arity);
    (match low as λ o => low = o → o.and_then(λ s => Some(Procedure(PTm::range(0, d.arity), [d.arity], s))) = Some(proc) →
            (proc.params = PTm::range(0, d.arity)) ∧ ((proc.results = [d.arity]) ∧ (low = Some(proc.body))) {
        None => λ _ never => Option::none_ne_some(proc, never, (proc.params = PTm::range(0, d.arity)) ∧ ((proc.results = [d.arity]) ∧ (low = Some(proc.body)))),
        Some(s) => λ es e => j(Option::some_inj(Procedure(PTm::range(0, d.arity), [d.arity], s), proc, e),
            λ q _ => (q.params = PTm::range(0, d.arity)) ∧ ((q.results = [d.arity]) ∧ (low = Some(q.body))), ⟨refl, ⟨refl, es⟩⟩),
    })(refl, made)
}

// Setting words keeps the buffers.
theorem PTm::set_words_buffers(ids: List<Nat>): (ws: List<BitVec(64)>) → (env: Env) → env.set_words(ids, ws).buffers = env.buffers {
    match ids {
        Nil => λ ws env => refl,
        Cons(id, rest) => λ ws => match ws {
            Nil => λ env => refl,
            Cons(x, more) => λ env => PTm::set_words_buffers(rest, more, env.set_word(id, x)),
        },
    }
}

// The definition at an index, where there is one.
fn PDef::at(defs: List<PDef>, p: Nat) → PDef { match defs.nth(p) { None => PDef(0, Value(Var(0))), Some(d) => d } }

theorem PDef::at_of(defs: List<PDef>, p: Nat, T: PDef → Type, h: match defs.nth(p) as λ _ => Type { None => False, Some(d) => T(d) }):
    (defs.nth(p) = Some(PDef::at(defs, p))) ∧ T(PDef::at(defs, p)) {
    (match defs.nth(p) as λ o => (match o as λ _ => Type { None => False, Some(d) => T(d) }) →
            (o = Some(match o as λ _ => PDef { None => PDef(0, Value(Var(0))), Some(d) => d })) ∧ T(match o as λ _ => PDef { None => PDef(0, Value(Var(0))), Some(d) => d }) {
        None => λ never => false_elim(never),
        Some(_) => λ t => ⟨refl, t⟩,
    })(h)
}

// The procedure at an index, where there is one.
fn PDef::proc_at(ps: List<Procedure>, p: Nat) → Procedure { match ps.nth(p) { None => Procedure(Nil, Nil, Exit(0)), Some(proc) => proc } }

theorem PDef::proc_at_of(ps: List<Procedure>, p: Nat, T: Procedure → Type, h: match ps.nth(p) as λ _ => Type { None => False, Some(proc) => T(proc) }):
    (ps.nth(p) = Some(PDef::proc_at(ps, p))) ∧ T(PDef::proc_at(ps, p)) {
    (match ps.nth(p) as λ o => (match o as λ _ => Type { None => False, Some(proc) => T(proc) }) →
            (o = Some(match o as λ _ => Procedure { None => Procedure(Nil, Nil, Exit(0)), Some(proc) => proc })) ∧
                T(match o as λ _ => Procedure { None => Procedure(Nil, Nil, Exit(0)), Some(proc) => proc }) {
        None => λ never => false_elim(never),
        Some(_) => λ t => ⟨refl, t⟩,
    })(h)
}

// A known call's definition, and its arity.
theorem PDef::known_at(defs: List<PDef>, p, m: Nat, k: PDef::known(defs, p, m).IsTrue()):
    (defs.nth(p) = Some(PDef::at(defs, p))) ∧ (m = PDef::at(defs, p).arity) {
    (match defs.nth(p) as λ o => (match o as λ _ => Bool { None => False, Some(d) => m.matches(d.arity) }).IsTrue() →
            (o = Some(match o as λ _ => PDef { None => PDef(0, Value(Var(0))), Some(d) => d })) ∧
                (m = (match o as λ _ => PDef { None => PDef(0, Value(Var(0))), Some(d) => d }).arity) {
        None => λ never => false_elim(never),
        Some(d) => λ t => ⟨refl, m.matches_eq(d.arity, t)⟩,
    })(k)
}

// A known call's definition, its procedure, and its arguments' words read
// back at the callee's entry.
record PDef::Known(defs: List<PDef>, w: rt::World, ps: List<Procedure>, p: Nat, env: Env, ids: List<Nat>) {
    def_at: defs.nth(p) = Some(PDef::at(defs, p)),
    proc_at: ps.nth(p) = Some(PDef::proc_at(ps, p)),
    arity: PDef::arity_at(defs, p) = PDef::at(defs, p).arity,
    entered: PDef::proc_at(ps, p).enter(env, ids).words_at(PTm::range(0, PDef::at(defs, p).arity)) = env.words_at(ids),
}

theorem PDef::known_call(defs: List<PDef>, w: rt::World, ps: List<Procedure>, made: PDef::procedures(defs, w, PDef::known(defs)) = Some(ps),
    p: Nat, env: Env, ids: List<Nat>, k: PDef::known(defs, p, ids.len()).IsTrue()): PDef::Known(defs, w, ps, p, env, ids) {
    let got = PDef::known_at(defs, p, ids.len(), k);
    let d = PDef::at(defs, p);
    let len: (ids.len() = d.arity) = got.right;
    let found = PDef::procedures_found(defs, w, PDef::known(defs), ps, made, p, d, got.left);
    let has = PDef::proc_at_of(ps, p, λ proc => d.procedure(w, PDef::known(defs)) = Some(proc), found);
    let proc = PDef::proc_at(ps, p);
    let parts = d.procedure_parts(w, PDef::known(defs), proc, has.right);
    let ar: (PDef::arity_at(defs, p) = d.arity) = j(sym(got.left), λ o _ => (match o as λ _ => Nat { None => 0, Some(x) => x.arity }) = d.arity, refl);
    let back = j(sym(parts.left), λ qs _ => native_source::Env(Nil, env.buffers, env.args).set_words(qs, env.words_at(ids)).words_at(PTm::range(0, d.arity)) = env.words_at(ids),
        PTm::entered_words(env, env, ids, d.arity, len));
    PDef::Known(got.left, has.left, ar, back)
}

// Calls of known procedures are answered by their meanings.
theorem PDef::answers(defs: List<PDef>, w: rt::World, src: Source, made: PDef::procedures(defs, w, PDef::known(defs)) = Some(src.procedures),
    f: PCalls(), fits: Nat → Nat → List<BitVec(64)> → Bool): PTm::Answers(PDef::known(defs), src.pure_answer(PDef::spec(defs, f, fits)), f) {
    λ p ids k r env io => {
        let kc = PDef::known_call(defs, w, src.procedures, made, p, env, ids, k);
        let proc = PDef::proc_at(src.procedures, p);
        let n = PDef::at(defs, p).arity;
        let value = λ (xs: List<BitVec(64)>) => Mutated(io, Onward(native_source::Env(env.words, env.buffers, env.args).set_words([r], [f(p, xs)])));
        let at_proc: (value(proc.enter(env, ids).words_at(PTm::range(0, PDef::arity_at(defs, p)))) = value(env.words_at(ids))) =
            trans(cong_fn(λ (a: Nat) => value(proc.enter(env, ids).words_at(PTm::range(0, a))), kc.arity), cong_fn(value, kc.entered));
        j(sym(kc.proc_at), λ o _ => Mutated(io, match o as λ _ => Flow {
                None => Onward(env),
                Some(q) => Onward(native_source::Env(env.words, env.buffers, env.args).set_words([r], PDef::spec(defs, f, fits).value(p, q.enter(env, ids)))),
            }) = Mutated(io, Onward(env.set_word(r, f(p, env.words_at(ids))))), at_proc)
    }
}

// A known call's `ok` within the levels is read on its words.
theorem PDef::ok_reads(defs: List<PDef>, w: rt::World, src: Source, made: PDef::procedures(defs, w, PDef::known(defs)) = Some(src.procedures),
    f: PCalls(), fits: Nat → Nat → List<BitVec(64)> → Bool, counted: Nat → Bool, k: Nat):
    PTm::OkReads(PDef::known(defs), src.pure_within(PDef::spec(defs, f, fits), counted, k), PTm::within(fits, counted, k)) {
    λ p ids kn r env => {
        let kc = PDef::known_call(defs, w, src.procedures, made, p, env, ids, kn);
        let proc = PDef::proc_at(src.procedures, p);
        let words: (proc.enter(env, ids).words_at(PTm::range(0, PDef::arity_at(defs, p))) = env.words_at(ids)) =
            trans(cong_fn(λ (a: Nat) => proc.enter(env, ids).words_at(PTm::range(0, a)), kc.arity), kc.entered);
        j(sym(kc.proc_at), λ o _ => (match k.spend(counted(p)) as λ _ => Bool {
                None => False,
                Some(j2) => match o as λ _ => Bool { None => True, Some(q) => PDef::spec(defs, f, fits).fits(j2, p, q.enter(env, ids)) },
            }) = PTm::within(fits, counted, k, p, env.words_at(ids)),
            match k.spend(counted(p)) as λ s => (match s as λ _ => Bool { None => False, Some(j2) => fits(j2, p, proc.enter(env, ids).words_at(PTm::range(0, PDef::arity_at(defs, p)))) })
                    = (match s as λ _ => Bool { None => False, Some(j2) => fits(j2, p, env.words_at(ids)) }) {
                None => refl,
                Some(j2) => cong_fn(λ (xs: List<BitVec(64)>) => fits(j2, p, xs), words),
            })
    }
}

// The theorem: procedures lowered from definitions whose meanings and
// depths unfold to their bodies' meet every obligation `Source::pure_reads`
// asks of their bodies.
theorem PDef::bodies(defs: List<PDef>, w: rt::World, src: Source, made: PDef::procedures(defs, w, PDef::known(defs)) = Some(src.procedures),
    call: Writers(), still: Writers::Still(call, functions_below(w.sigs.len())), agree: (held: Buffers()) → Tm::CallsAgree(w, Writers::words(call, held)),
    f: PCalls(), fits: Nat → Nat → List<BitVec(64)> → Bool, counted: Nat → Bool,
    unfolds: PDef::Unfolds(defs, w, f), fitting: PDef::Fits(defs, w, f, fits, counted)):
    src.PureBodies(call, PDef::spec(defs, f, fits), counted) {
    let known = PDef::known(defs);
    let spec = PDef::spec(defs, f, fits);
    λ p proc found => {
        let pa = PDef::procedures_at(defs, w, known, src.procedures, made, p, proc, found);
        let got = PDef::at_of(defs, p, λ d => d.procedure(w, known) = Some(proc), pa);
        let d = PDef::at(defs, p);
        let n = d.arity;
        let parts = d.procedure_parts(w, known, proc, got.right);
        let low = j(parts.right.right, λ r _ => PTm::LowerHolds(d.body, w, known, PTm::word_ctx(n), PTm::param_locs(0, n), n + 1, n, r),
            d.body.lower_sound(w, known, PTm::word_ctx(n), PTm::param_locs(0, n), n + 1, n));
        let ar: (PDef::arity_at(defs, p) = n) = j(sym(got.left), λ o _ => (match o as λ _ => Nat { None => 0, Some(x) => x.arity }) = n, refl);
        ⟨low.left, λ caller args results lj enough io => {
            let entered = proc.enter(caller, args);
            let xs = entered.words_at(PTm::range(0, n));
            let lx: (xs.len() = n) = trans(PTm::words_at_len(entered, PTm::range(0, n)), PTm::range_len(n, 0));
            let bounded = PTm::bounded_set_words(proc.params, caller.words_at(args), native_source::Env(Nil, caller.buffers, caller.args),
                PTm::bounded_none(caller.buffers, caller.args));
            let wa = PTm::words_at_bounded(n, 0, entered, bounded);
            let held = PTm::hold_params(w.tys, n, xs, lx, entered, 0, wa);
            let le: (0 + n <= n + 1) = omega();
            let below = PTm::params_below(n, 0, n + 1, le);
            let pos: (0 < n + 1) = omega();
            let answer = src.pure_answer(spec);
            let r = low.right(call, still, agree, f, answer, PDef::answers(defs, w, src, made, f, fits), entered, PTm::vals_n(w.tys, n, xs), io, held, below, pos);
            let m = Stmt::thread_by(proc.body, call, answer, entered, io);
            let v = d.body.sem(w, f, PTm::word_ctx(n), PTm::vals_n(w.tys, n, xs));
            // Within the levels.
            let fit: (fits(lj, p, xs).IsTrue()) = j(ar, λ a _ => fits(lj, p, entered.words_at(PTm::range(0, a))).IsTrue(), enough);
            let within = fitting(p, d, got.left, xs, lj, fit);
            let calls = r.right(src.pure_within(spec, counted, lj), PTm::within(fits, counted, lj), PDef::ok_reads(defs, w, src, made, f, fits, counted, lj), within);
            // The value it leaves.
            let single: BitVec(64) → List<BitVec(64)> = λ x => [x];
            let sv: (spec.value(p, entered) = [v]) = trans(cong_fn(λ (a: Nat) => single(f(p, entered.words_at(PTm::range(0, a)))), ar),
                cong_fn(single, unfolds(p, d, got.left, xs)));
            let bufs0: (entered.buffers = caller.buffers) = PTm::set_words_buffers(proc.params, caller.words_at(args), native_source::Env(Nil, caller.buffers, caller.args));
            let target = Onward(native_source::Env(caller.words, caller.buffers, caller.args).set_words(results, [v]));
            let leaves = (match m.value as λ fl => (match fl as λ _ => Type {
                        Onward(after) => (after.buffers = entered.buffers) ∧ (after.number(n) = v.toNat()),
                        Exited(_) => False,
                    }) → proc.leave(caller, results, fl) = target {
                Onward(after) => λ k => {
                    let wv: (after.word(n) = v) = ETm::word_of_kept(after, n, v, k.right);
                    let ws: (after.words_at(proc.results) = [v]) = j(sym(parts.right.left), λ rs _ => after.words_at(rs) = [v],
                        cong_fn(single, wv));
                    let bufs: (after.buffers = caller.buffers) = trans(k.left, bufs0);
                    j(sym(ws), λ ys _ => Onward(native_source::Env(caller.words, after.buffers, caller.args).set_words(results, ys)) = target,
                        cong_fn(λ (bs: List<List<BitVec(8)>>) => Onward(native_source::Env(caller.words, bs, caller.args).set_words(results, [v])), bufs))
                },
                Exited(_) => λ never => false_elim(never),
            })(r.left.right);
            ⟨calls, ⟨r.left.left, trans(leaves, sym(cong_fn(λ (ys: List<BitVec(64)>) =>
                Onward(native_source::Env(caller.words, caller.buffers, caller.args).set_words(results, ys)), sv)))⟩⟩
        }⟩
    }
}

// Byte nodes and initial bytes compiled (issues/native-source-bytes.md): a
// `BufferLoad` or `BufferStore` runs as `Env::compute` says of its leaf of
// one node (a longer leaf runs a node at a time, native_compile_nodes), and
// the stores at entry leave the region holding the source's start.
//
// A byte the code stores lands in its buffer's range, so the environment
// stays placed with that one byte of the buffer set (`Layout::keeps_byte`);
// an index the CMP finds past the capacity stores nothing, and the source's
// store, an update past the buffer's end, leaves it as it was
// (`Target::placed_past`). A load reads the cell the environment keeps at
// the buffer's offset plus the index (`cells_nth`), or zero past the end.
import native_source;
import native_compile;
import native_compile_facts;
import native_compile_region;
import native_compile_steps;
import native_compile_segments;
import native_compile_calls;
import native_compile_claims;
import native_compile_leaf;
import native_compile_homes;
import native_alloc;
import function_ir;
import function_ir_eval;
import function_ir_state;
import linux_trees;
import linux_x86_64_byte_memory;
import itree;
import x86_64;
import x86_64_block;
import x86_64_asm;
import x86_64_asm_runs;
import x86_64_data_read;
import x86_64_store;
import x86_64_byte_memory;
import memory;
import bitvec;
import bitvec_nat;
import bool;
import list;
import list_window;
import logic;
import nat;
import option;
import omega;

// ---------------------------------------------------------------------------
// A buffer's bytes after one is stored

// The cells with `bytes` stored from `q`, as the region's store leaves them.
fn DataRegion::stored_cells(self r: DataRegion, v: Nat → BitVec(8), q: Nat, bytes: List<BitVec(8)>) → Nat → BitVec(8) {
    r.buffer(v).set_span(q, bytes.to_vector()).cells
}

// A byte node reads the buffer the environment names.
theorem Env::buffer_byte_is(self env: Env, buf, i: Nat): buffer_byte(env.buffers, buf, i) = env.buffer(buf).get_or(i, BitVec::zero()) {
    match env.buffers.nth(buf) {
        None => refl,
        Some(_) => refl,
    }
}

theorem Env::buffer_stored_here(self env: Env, buf, i: Nat, c: BitVec(8)):
    Env(env.words, store_byte(env.buffers, buf, i, c), env.args).buffer(buf) = env.buffer(buf).update(i, λ _ => c) {
    let f = λ (bytes: List<BitVec(8)>) => bytes.update(i, λ _ => c);
    match none: env.buffers.nth(buf) {
        None => j(sym(env.buffers.nth_update_none(buf, f, none)),
            λ x _ => (match x as λ _ => List<BitVec(8)> { None => Nil, Some(bytes) => bytes }) = Nil.update(i, λ _ => c), refl),
        Some(bytes) => j(sym(env.buffers.nth_update_here(buf, f, bytes, none)),
            λ x _ => (match x as λ _ => List<BitVec(8)> { None => Nil, Some(bytes) => bytes }) = bytes.update(i, λ _ => c), refl),
    }
}

theorem Env::buffer_stored_other(self env: Env, buf, i: Nat, c: BitVec(8), b: Nat, ne: b ≠ buf):
    Env(env.words, store_byte(env.buffers, buf, i, c), env.args).buffer(b) = env.buffer(b) {
    cong_fn<Option<List<BitVec(8)>>, List<BitVec(8)>>(λ o => match o { None => Nil, Some(bytes) => bytes },
        env.buffers.nth_update_other(buf, λ (bytes: List<BitVec(8)>) => bytes.update(i, λ _ => c), b, ne))
}

// Cells that differ only at `o + i`, where they hold `c`: the list with `c`
// at `i`.
theorem cells_update(v, w: Nat → BitVec(8), c: BitVec(8), n: Nat): (o, i: Nat) → i < n → w(o + i) = c →
    ((p: Nat) → p ≠ o + i → w(p) = v(p)) → cells_at(w, o, n) = cells_at(v, o, n).update(i, λ _ => c) {
    match n {
        Zero => λ o i below => false_elim(omega(below)),
        Succ(k, ih) => λ o i => match i {
            Zero => λ _ here other => eq2(λ (x: BitVec(8)) (rest: List<BitVec(8)>) => Cons(x, rest), here,
                cells_agree(w, v, k, Succ(o), λ t _ => other(Succ(o) + t, λ same => false_elim(omega(same))))),
            Succ(l) => λ below here other => eq2(λ (x: BitVec(8)) (rest: List<BitVec(8)>) => Cons(x, rest),
                other(o, λ same => false_elim(omega(same))),
                ih(Succ(o), l, below, trans(cong_fn<Nat, BitVec(8)>(λ p => w(p), Nat::add_succ_left(o, l)), here),
                    λ p ne => other(p, λ same => ne(trans(same, sym(Nat::add_succ_left(o, l))))))),
        },
    }
}

// Bytes stored inside a buffer: it reads them from `i`, and every other
// buffer reads what it did.
theorem Env::buffer_spanned_here(self env: Env, buf, i: Nat, bytes: List<BitVec(8)>, inside: i < env.buffer(buf).len()):
    Env(env.words, store_span(env.buffers, buf, i, bytes), env.args).buffer(buf) = env.buffer(buf).put_window(i, bytes) {
    let f = λ (xs: List<BitVec(8)>) => xs.put_window(i, bytes);
    let read = λ (found: Option<List<BitVec(8)>>) => match found { None => Nil, Some(xs) => xs };
    (match env.buffers.nth(buf) as λ found => env.buffers.nth(buf) = found → i < read(found).len() →
        read(env.buffers.update(buf, f).nth(buf)) = f(read(found)) {
        None => λ none below => false_elim(below),
        Some(xs) => λ some below => cong_fn(read, env.buffers.nth_update_here(buf, f, xs, some)),
    })(refl, inside)
}

theorem Env::buffer_spanned_other(self env: Env, buf, i: Nat, bytes: List<BitVec(8)>, b: Nat, ne: b ≠ buf):
    Env(env.words, store_span(env.buffers, buf, i, bytes), env.args).buffer(b) = env.buffer(b) {
    cong_fn<Option<List<BitVec(8)>>, List<BitVec(8)>>(λ o => match o { None => Nil, Some(xs) => xs },
        env.buffers.nth_update_other(buf, λ (xs: List<BitVec(8)>) => xs.put_window(i, bytes), b, ne))
}

// Cells that differ only from `o + i`, where they hold `bytes`: the list
// with `bytes` written over it from `i`.
theorem cells_put_window(v, w: Nat → BitVec(8), n, o, i: Nat, bytes: List<BitVec(8)>, fits: bytes.len() + i <= n,
    inside: (t: Nat) → t < bytes.len() → Some(w(o + i + t)) = bytes.nth(t),
    outside: (p: Nat) → (p < o + i) ∨ (o + i + bytes.len() <= p) → w(p) = v(p)):
    cells_at(w, o, n) = cells_at(v, o, n).put_window(i, bytes) {
    let xs = cells_at(v, o, n);
    let xs_len: (xs.len() = n) = cells_len(v, n, o);
    let start: (i <= xs.len()) = omega(fits, xs_len);
    let len: (xs.put_window(i, bytes).len() = n) = trans(xs.len_put_window(i, bytes, omega(fits, xs_len)), xs_len);
    cells_at(w, o, n).ext_nth(xs.put_window(i, bytes), trans(cells_len(w, n, o), sym(len)), λ k short => {
        let below: (k < n) = j(cells_len(w, n, o), λ m _ => k < m, short);
        let here: (cells_at(w, o, n).nth(k) = Some(w(o + k))) = cells_nth(w, n, o, k, below);
        match k.lt_or_ge(i) {
            Inl(before) => trans(here, trans(cong_fn<BitVec(8), Option<BitVec(8)>>(λ c => Some(c), outside(o + k, Inl(omega(before)))),
                trans(sym(cells_nth(v, n, o, k, below)), sym(xs.nth_put_window_before(i, bytes, k, before, start))))),
            Inr(from) => match k.lt_or_ge(bytes.len() + i) {
                Inl(within) => {
                    let parts: (k = (k - i) + i) = omega(from);
                    let at: (o + k = o + i + (k - i)) = omega(from);
                    trans(here, trans(cong_fn<Nat, Option<BitVec(8)>>(λ p => Some(w(p)), at),
                        trans(inside(k - i, omega(from, within)),
                            trans(sym(xs.nth_put_window_inside(i, bytes, k - i, omega(from, within), start)),
                                cong_fn<Nat, Option<BitVec(8)>>(λ p => xs.put_window(i, bytes).nth(p), sym(parts))))))
                },
                Inr(past) => {
                    let parts: (k = (k - (bytes.len() + i)) + (bytes.len() + i)) = omega(past);
                    trans(here, trans(cong_fn<BitVec(8), Option<BitVec(8)>>(λ c => Some(c), outside(o + k, Inr(omega(past)))),
                        trans(sym(cells_nth(v, n, o, k, below)),
                            trans(cong_fn<Nat, Option<BitVec(8)>>(λ p => xs.nth(p), parts),
                                trans(sym(xs.nth_put_window_after(i, bytes, k - (bytes.len() + i), start)),
                                    cong_fn<Nat, Option<BitVec(8)>>(λ p => xs.put_window(i, bytes).nth(p), sym(parts)))))))
                },
            },
        }
    })
}

// Bytes stored inside their buffer: the buffers the cells keep, with those
// bytes written over it.
theorem Layout::buffers_span(self layout: Layout, r: DataRegion, env: Env, v: Nat → BitVec(8),
    kept: (b, cap: Nat) → layout.capacities.nth(b) = Some(cap) → env.buffer(b) = cells_at(v, layout.buffer_offset(b), cap),
    buf, cap: Nat, found: layout.capacities.nth(buf) = Some(cap), i: Nat, below: i < cap, bytes: List<BitVec(8)>, fits: bytes.len() + i <= cap):
    (b, cb: Nat) → layout.capacities.nth(b) = Some(cb) →
    Env(env.words, store_span(env.buffers, buf, i, bytes), env.args).buffer(b) =
        cells_at(r.stored_cells(v, layout.buffer_offset(buf) + i, bytes), layout.buffer_offset(b), cb) {
    let o = layout.buffer_offset(buf);
    let q = o + i;
    let w = r.stored_cells(v, q, bytes);
    let after = Env(env.words, store_span(env.buffers, buf, i, bytes), env.args);
    λ b cb found_b => match b.eq_dec(buf) {
        Inl(here) => {
            let cap_same: (cb = cap) = Option::some_inj(cb, cap, trans(sym(found_b), j(sym(here), λ x _ => layout.capacities.nth(x) = Some(cap), found)));
            let some: (i < env.buffer(buf).len()) = j(sym(kept(buf, cap, found)), λ xs _ => i < xs.len(),
                j(sym(cells_len(v, cap, o)), λ m _ => i < m, below));
            let updated: (cells_at(w, o, cap) = cells_at(v, o, cap).put_window(i, bytes)) = cells_put_window(v, w, cap, o, i, bytes, fits,
                λ t short => {
                    let present = bytes.nth_present(t, short);
                    trans(cong_fn<BitVec(8), Option<BitVec(8)>>(λ c => Some(c), r.cells_inside(v, q, bytes, t, present.witness, present.proof)),
                        sym(present.proof))
                },
                λ p away => r.cells_outside(v, q, bytes, p, away));
            let stored: (after.buffer(buf) = cells_at(w, o, cap)) = trans(env.buffer_spanned_here(buf, i, bytes, some),
                trans(cong_fn<List<BitVec(8)>, List<BitVec(8)>>(λ xs => xs.put_window(i, bytes), kept(buf, cap, found)), sym(updated)));
            j(sym(here), λ x _ => after.buffer(x) = cells_at(w, layout.buffer_offset(x), cb),
                j(sym(cap_same), λ k _ => after.buffer(buf) = cells_at(w, o, k), stored))
        },
        Inr(other) => {
            let o_b = layout.buffer_offset(b);
            let away: ((t: Nat) → t < cb → (o_b + t < q) ∨ (q + bytes.len() <= o_b + t)) = λ t short => match b.lt_or_ge(buf) {
                Inl(under) => {
                    let gap = layout.buffer_apart(b, cb, buf, found_b, under);
                    Inl(omega(gap, short))
                },
                Inr(over) => {
                    let gap = layout.buffer_apart(buf, cap, b, found, omega(over, other));
                    Inr(omega(gap, fits))
                },
            };
            trans(env.buffer_spanned_other(buf, i, bytes, b, other),
                trans(kept(b, cb, found_b), cells_agree(v, w, cb, o_b, λ t short => sym(r.cells_outside(v, q, bytes, o_b + t, away(t, short))))))
        },
    }
}

// A byte stored inside its buffer: the buffers the cells keep, with that
// byte set.
theorem Layout::buffers_byte(self layout: Layout, r: DataRegion, env: Env, v: Nat → BitVec(8),
    kept: (b, cap: Nat) → layout.capacities.nth(b) = Some(cap) → env.buffer(b) = cells_at(v, layout.buffer_offset(b), cap),
    buf, cap: Nat, found: layout.capacities.nth(buf) = Some(cap), i: Nat, below: i < cap, c: BitVec(8)):
    (b, cb: Nat) → layout.capacities.nth(b) = Some(cb) →
    Env(env.words, store_byte(env.buffers, buf, i, c), env.args).buffer(b) =
        cells_at(r.stored_cells(v, layout.buffer_offset(buf) + i, [c]), layout.buffer_offset(b), cb) {
    let o = layout.buffer_offset(buf);
    let q = o + i;
    let w = r.stored_cells(v, q, [c]);
    let after = Env(env.words, store_byte(env.buffers, buf, i, c), env.args);
    let apart = λ (p: Nat) (ne: p ≠ q) => r.cells_outside(v, q, [c], p, match p.lt_or_ge(q) {
        Inl(under) => Inl(under),
        Inr(over) => {
            let past: (q + 1 <= p) = omega(over, ne);
            Inr(past)
        },
    });
    λ b cb found_b => match b.eq_dec(buf) {
        Inl(here) => {
            let cap_same: (cb = cap) = Option::some_inj(cb, cap, trans(sym(found_b), j(sym(here), λ x _ => layout.capacities.nth(x) = Some(cap), found)));
            let updated: (cells_at(w, o, cap) = cells_at(v, o, cap).update(i, λ _ => c)) = cells_update(v, w, c, cap, o, i, below,
                r.cells_inside(v, q, [c], 0, c, refl), apart);
            let stored: (after.buffer(buf) = cells_at(w, o, cap)) = trans(env.buffer_stored_here(buf, i, c),
                trans(cong_fn<List<BitVec(8)>, List<BitVec(8)>>(λ bytes => bytes.update(i, λ _ => c), kept(buf, cap, found)), sym(updated)));
            j(sym(here), λ x _ => after.buffer(x) = cells_at(w, layout.buffer_offset(x), cb),
                j(sym(cap_same), λ k _ => after.buffer(buf) = cells_at(w, o, k), stored))
        },
        Inr(other) => {
            let o_b = layout.buffer_offset(b);
            let away: ((t: Nat) → t < cb → o_b + t ≠ q) = λ t short => match b.lt_or_ge(buf) {
                Inl(under) => {
                    let gap = layout.buffer_apart(b, cb, buf, found_b, under);
                    λ same => false_elim(omega(gap, short, same))
                },
                Inr(over) => {
                    let gap = layout.buffer_apart(buf, cap, b, found, omega(over, other));
                    λ same => false_elim(omega(gap, below, same))
                },
            };
            trans(env.buffer_stored_other(buf, i, c, b, other),
                trans(kept(b, cb, found_b), cells_agree(v, w, cb, o_b, λ t short => sym(apart(o_b + t, away(t, short))))))
        },
    }
}

// A byte stored inside its buffer keeps the environment with that byte set.
theorem Layout::keeps_byte(self layout: Layout, r: DataRegion, env: Env, v: Nat → BitVec(8), keeps: layout.Keeps(env, v),
    buf, cap: Nat, found: layout.capacities.nth(buf) = Some(cap), i: Nat, below: i < cap, c: BitVec(8)):
    layout.Keeps(Env(env.words, store_byte(env.buffers, buf, i, c), env.args), r.stored_cells(v, layout.buffer_offset(buf) + i, [c])) {
    let q = layout.buffer_offset(buf) + i;
    let w = r.stored_cells(v, q, [c]);
    let ends = layout.buffer_end(buf, cap, found);
    let words = λ (k: Nat) (inside: k < layout.words) => trans(cong_fn<BitVec(64), Nat>(λ x => x.toNat(), word_in_agree(w, v, layout.frame_cell(k), λ t short =>
        r.cells_outside(v, q, [c], layout.frame_cell(k) + t, {
            let past: (q + 1 <= layout.frame_cell(k) + t) = omega(below, ends, layout.scratch_below_size(), layout.frame_cell_at(k));
            Inr(past)
        }))),
        keeps.left(k, inside));
    ⟨words, layout.buffers_byte(r, env, v, keeps.right, buf, cap, found, i, below, c)⟩
}

// The byte stored at its address: the environment placed with it set.
theorem Target::placed_byte(self t: Target, env: Env, m: X86Memory(t.r.profile), placed: t.Placed(env, m), buf, cap: Nat,
    found: t.caps.nth(buf) = Some(cap), i: Nat, below: i < cap, c: BitVec(8)):
    t.Placed(Env(env.words, store_byte(env.buffers, buf, i, c), env.args), t.r.profile.store(m, next_rip(t.r.low, t.layout().buffer_offset(buf) + i), [c])) {
    let v = placed.cells;
    let o = t.layout().buffer_offset(buf);
    let fits: (o + i + 1 <= t.r.size) = omega(t.layout().buffer_end(buf, cap, found), t.scratch_fits(), below);
    let stack: (t.layout().stack_offset() = t.layout().scratch_offset() + (t.caps.largest() + 1)) = refl;
    let under: (o + i + 1 <= t.layout().stack_offset()) = omega(t.layout().buffer_end(buf, cap, found), stack, below);
    Placement(cells := t.r.stored_cells(v, o + i, [c]),
        holds := t.r.store_holds(v, m, placed.holds, o + i, [c], fits),
        keeps := t.layout().keeps_byte(t.r, env, v, placed.keeps, buf, cap, found, i, below, c),
        stacked := t.stacked_store(env, v, m, o + i, [c], under, placed.stacked))
}

// A store past the buffer's end leaves the environment placed as it was.
theorem Target::placed_past(self t: Target, env: Env, m: X86Memory(t.r.profile), placed: t.Placed(env, m), buf, cap: Nat,
    found: t.caps.nth(buf) = Some(cap), i: Nat, past: cap <= i, c: BitVec(8)):
    t.Placed(Env(env.words, store_byte(env.buffers, buf, i, c), env.args), m) {
    let v = placed.cells;
    let keeps = placed.keeps;
    let layout = t.layout();
    let after = Env(env.words, store_byte(env.buffers, buf, i, c), env.args);
    let len = layout.keeps_buffer_len(env, v, keeps, buf, cap, found);
    let same: (after.buffer(buf) = env.buffer(buf)) = trans(env.buffer_stored_here(buf, i, c),
        env.buffer(buf).update_past(i, λ _ => c, j(sym(len), λ n _ => n <= i, past)));
    Placement(cells := v, holds := placed.holds, keeps := ⟨λ k inside => keeps.left(k, inside), λ b cb found_b => match b.eq_dec(buf) {
        Inl(here) => (j(sym(here), λ x _ => layout.capacities.nth(x) = Some(cb) → after.buffer(x) = cells_at(v, layout.buffer_offset(x), cb),
            λ found_here => trans(same, keeps.right(buf, cb, found_here))))(found_b),
        Inr(other) => trans(env.buffer_stored_other(buf, i, c, b, other), keeps.right(b, cb, found_b)),
    }⟩, stacked := placed.stacked)
}

// The same over the words held: a byte store leaves every word as it was.
theorem Target::held_byte(self t: Target, live: List<Nat>, env: Env, g: Gprs, m: X86Memory(t.r.profile), held: t.Held(live, env, g, m), buf, cap: Nat,
    found: t.caps.nth(buf) = Some(cap), i: Nat, below: i < cap, c: BitVec(8)):
    t.Held(live, Env(env.words, store_byte(env.buffers, buf, i, c), env.args), g, t.r.profile.store(m, next_rip(t.r.low, t.layout().buffer_offset(buf) + i), [c])) {
    Hold(words := held.words, placed := t.placed_byte(env.with_words(held.words), m, held.placed, buf, cap, found, i, below, c),
        agreeing := Agreement(homes := held.agreeing.homes, frame := held.agreeing.frame, pins := held.agreeing.pins))
}

theorem Target::held_past(self t: Target, live: List<Nat>, env: Env, g: Gprs, m: X86Memory(t.r.profile), held: t.Held(live, env, g, m), buf, cap: Nat,
    found: t.caps.nth(buf) = Some(cap), i: Nat, past: cap <= i, c: BitVec(8)):
    t.Held(live, Env(env.words, store_byte(env.buffers, buf, i, c), env.args), g, m) {
    Hold(words := held.words, placed := t.placed_past(env.with_words(held.words), m, held.placed, buf, cap, found, i, past, c),
        agreeing := Agreement(homes := held.agreeing.homes, frame := held.agreeing.frame, pins := held.agreeing.pins))
}

// ---------------------------------------------------------------------------
// A byte loaded

// The byte at index `w` of a buffer, at the buffer's address plus `w`.
theorem Target::byte_address(self t: Target, buf, cap: Nat, found: t.caps.nth(buf) = Some(cap), w: BitVec(64), below: w.toNat() < cap):
    t.layout().buffer_at(buf).add(w) = next_rip(t.r.low, t.layout().buffer_offset(buf) + w.toNat()) {
    let o = t.layout().buffer_offset(buf);
    let low = t.r.low.toNat();
    let i = w.toNat();
    let fits = t.buffer_fits(buf, cap, found);
    let top = canonical_below_top();
    let ends: (o + cap <= t.r.size) = Nat::le_trans(o + cap, t.layout().scratch_offset(), t.r.size, t.layout().buffer_end(buf, cap, found), t.scratch_fits());
    let sum: (t.layout().buffer_at(buf).add(w).toNat() = (low + o) + i) =
        add_words(64, t.layout().buffer_at(buf), w, low + o, i, t.buffer_toNat(buf, cap, found), refl, omega(fits, top, below));
    let regrouped: ((low + o) + i = low + (o + i)) = omega();
    trans(sym(word_of_nat_toNat(64, t.layout().buffer_at(buf).add(w))),
        trans(cong_fn<Nat, BitVec(64)>(λ k => word_of_nat(64, k), trans(sum, regrouped)), t.cell_address(o + i, omega(ends, below))))
}

// A capacity is a word's number.
theorem Target::cap_word(self t: Target, buf, cap: Nat, found: t.caps.nth(buf) = Some(cap)): BitVec::ofNat(cap, n := 64).toNat() = cap {
    let fits = t.buffer_fits(buf, cap, found);
    let top = canonical_below_top();
    BitVec::toNat_ofNat(64, cap, omega(fits, top))
}

// An unsigned comparison of an index with a capacity, read from the
// borrow.
theorem Target::index_past(self t: Target, buf, cap: Nat, found: t.caps.nth(buf) = Some(cap), w: BitVec(64),
    no: w.borrow_sub_bit(BitVec::ofNat(cap)) = False): cap <= w.toNat() {
    let bound = BitVec::ofNat(cap, n := 64).toNat();
    let not_below: (bound <= w.toNat()) = w.toNat().le_of_not_lt(bound,
        λ (lt: w.toNat() < bound) => absurd(trans(sym(no), BitVec::borrow_sub_bit_of_borrow(64, w, BitVec::ofNat(cap), lt))));
    omega(not_below, t.cap_word(buf, cap, found))
}

theorem Target::index_below(self t: Target, buf, cap: Nat, found: t.caps.nth(buf) = Some(cap), w: BitVec(64),
    yes: w.borrow_sub_bit(BitVec::ofNat(cap)) = True): w.toNat() < cap {
    let lt: (w.toNat() < BitVec::ofNat(cap, n := 64).toNat()) = BitVec::borrow_sub_of_bit_true(64, w, BitVec::ofNat(cap), yes);
    omega(lt, t.cap_word(buf, cap, found))
}

// What the load of a byte needs: the words held, and what follows with the
// byte at the word `index` of buffer `buf` in RAX, zero past the end.
theorem Target::byte_before(self t: Target, live, out: List<Nat>, env: Env, buf, index, cap, names: Nat,
    inside: t.layout().word_fits(index).IsTrue(), holds: Mem(index, live), found: t.caps.nth(buf) = Some(cap),
    post: MachineState<X86Memory(t.r.profile)> → Type, s: MachineState<X86Memory(t.r.profile)>, held: t.Held(live, env, s.gprs, s.memory),
    next: (h: Gprs) → read_gpr(Rax, h) = byte_word(buffer_byte(env.buffers, buf, env.word(index).toNat())) → t.Held(live, env, h, s.memory) →
        (f: Flags) → (rip: BitVec(64)) → post(MachineState(h, f, rip, s.memory))):
    Emission(t.layout(), [], out).from(names).byte(buf, index, cap).code.before(Run(t, [], out, live, env), post)(s) {
    let layout = t.layout();
    let w = env.word(index);
    let i = w.toNat();
    let o = layout.buffer_offset(buf);
    let bit = w.borrow_sub_bit(BitVec::ofNat(cap));
    let placed = held.placed;
    let v = placed.cells;
    Fetches(fits := inside, reads := holds, held := held, after := λ f rip => {
        let compared = execute_block_normal([MovRI(Rdx, BitVec::ofNat(cap)), MovRI(Rax, BitVec::ofNat(0)), CmpRR(Rcx, Rdx)],
            MachineState(write_gpr(Rcx, w, write_gpr(Rbx, t.rbx_known([], env, index), s.gprs)), f, rip, s.memory));
        Branches(
            // At or past the end: zero.
            taken := λ over rip2 => {
                let past = t.index_past(buf, cap, found, w, Bool::clear_of_not(bit, !bit, refl, over));
                let len = layout.keeps_buffer_len(env.with_words(held.words), v, placed.keeps, buf, cap, found);
                let none: (env.buffer(buf).nth(i) = None) = env.buffer(buf).nth_past_end(i, j(sym(len), λ k _ => k <= i, past));
                let zero: (buffer_byte(env.buffers, buf, i) = BitVec::zero()) = trans(env.buffer_byte_is(buf, i), env.buffer(buf).get_or_none(i, BitVec::zero(), none));
                next(compared.gprs, sym(cong_fn<BitVec(8), BitVec(64)>(λ c => byte_word(c), zero)), held, compared.flags, rip2)
            },
            // Below it: the cell the environment keeps there.
            straight := λ under rip2 => {
                let below = t.index_below(buf, cap, found, w, Bool::set_of_not(bit, !bit, refl, under));
                let ends: (o + cap <= t.r.size) = Nat::le_trans(o + cap, layout.scratch_offset(), t.r.size, layout.buffer_end(buf, cap, found), t.scratch_fits());
                let cell = j(sym(t.byte_address(buf, cap, found, w, below)),
                    λ a _ => (a.toNat() < Nat::pow(2, 47)) ∧ (t.site().data.read(s.memory, a) = Some(v(o + i))),
                    t.read_cell(v, s.memory, placed.holds, o + i, omega(ends, below)));
                let byte_is: (buffer_byte(env.buffers, buf, i) = v(o + i)) = trans(env.buffer_byte_is(buf, i),
                    trans(cong_fn<List<BitVec(8)>, BitVec(8)>(λ bytes => bytes.get_or(i, BitVec::zero()), placed.keeps.right(buf, cap, found)),
                        cells_at(v, o, cap).get_or_some(i, BitVec::zero(), v(o + i), cells_nth(v, cap, o, i, below))));
                let loaded = byte_load_after(ByteLoad(Rax, Rbx), v(o + i),
                    execute_block_normal([MovRI(Rbx, layout.buffer_at(buf)), AddRR(Rbx, Rcx)], MachineState(compared.gprs, compared.flags, rip2, s.memory)));
                LoadsByte(byte := v(o + i), low := cell.left, read := cell.right,
                    after := next(loaded.gprs, cong_fn<BitVec(8), BitVec(64)>(λ c => byte_word(c), sym(byte_is)), held, loaded.flags, loaded.rip))
            },
            defined := refl)
    })
}

theorem Prog::within_byte(self p: Prog, cx: Emission, node: Node, cap, names: Nat): p.Within(p.byte(cx, node, cap, names).prog) {
    match node { _ => cx.from(names).node(node, cap).cut().code.extends(cx, p) }
}

// The byte put in the word `output`'s home: the environment with it set is
// the one the claim after reads.
theorem Target::goes_loads(self t: Target, live, out: List<Nat>, env, other: Env, p: Prog, output, buf, index, cap, names: Nat,
    inside_output: t.layout().word_fits(output).IsTrue(), inside_index: t.layout().word_fits(index).IsTrue(), holds: Mem(index, live),
    sub: (i: Nat) → Mem(i, out) → i ≠ output → Mem(i, live), apart: t.homes.apart(output, out).IsTrue(), found: t.caps.nth(buf) = Some(cap),
    within: p.byte(Emission(t.layout(), [], out), BufferLoad(output, buf, index), cap, names).prog.Within(t.program), tree: ITree<BitVec(64)>(Events::linux()),
    same: env.set_word(output, byte_word(buffer_byte(env.buffers, buf, env.word(index).toNat()))) = other,
    next: t.At(prog_len(p.byte(Emission(t.layout(), [], out), BufferLoad(output, buf, index), cap, names).prog), out, tree, other)): t.At(prog_len(p), live, tree, env) {
    let r = Run(t, [], out, live, env);
    let code = r.cx().from(names).byte(buf, index, cap).code;
    let loaded = code.onto(r.cx(), p);
    let kept: r.State() → Type = λ x => t.Held(live, env, x.gprs, x.memory) ∧ (env.set_word(output, read_gpr(Rax, x.gprs)) = other);
    let stored: t.Goes(prog_len(loaded), tree, kept) = t.goes_result(live, out, env, other, loaded, output, inside_output, sub, apart, within, tree, next);
    t.goes_weaken(code.goes(r, p, loaded.word_from_within(t.layout(), out, output, Rax, t.program, within), tree, kept, stored),
        λ s held => t.byte_before(live, out, env, buf, index, cap, names, inside_index, holds, found, kept, s, held,
            λ h rax held_h f rip => ⟨held_h, trans(cong_fn<BitVec(64), Env>(λ x => env.set_word(output, x), rax), same)⟩))
}

// ---------------------------------------------------------------------------
// A byte stored

// The environment with the word `value`'s low byte at the word `index` of
// buffer `buf`, as the source stores it.
fn Env::store_at(self env: Env, buf, index, value: Nat) → Env {
    Env(env.words, store_byte(env.buffers, buf, env.word(index).toNat(), low_byte(env.word(value))), env.args)
}

// What the store of a byte needs: the words held, in memory the code is
// resident in. After it the environment the source stores is held, nothing
// stored past the end.
theorem Target::put_byte_before(self t: Target, live, out: List<Nat>, env: Env, buf, index, value, cap, names: Nat,
    inside_index: t.layout().word_fits(index).IsTrue(), inside_value: t.layout().word_fits(value).IsTrue(), holds_index: Mem(index, live), holds_value: Mem(value, live),
    found: t.caps.nth(buf) = Some(cap), s: MachineState<X86Memory(t.r.profile)>, held: t.Held(live, env, s.gprs, s.memory), resident: t.site().Resident(s.memory)):
    Emission(t.layout(), [], out).from(names).put_byte(buf, index, value, cap).code.before(Run(t, [], out, live, env),
        λ u => t.Held(live, env.store_at(buf, index, value), u.gprs, u.memory))(s) {
    let layout = t.layout();
    let w = env.word(index);
    let i = w.toNat();
    let o = layout.buffer_offset(buf);
    let c = low_byte(env.word(value));
    let after = env.store_at(buf, index, value);
    let bit = w.borrow_sub_bit(BitVec::ofNat(cap));
    Fetches(fits := inside_index, reads := holds_index, held := held, after := λ f rip => Branches(
        taken := λ over rip2 => t.held_past(live, env, s.gprs, s.memory, held, buf, cap, found, i,
            t.index_past(buf, cap, found, w, Bool::clear_of_not(bit, !bit, refl, over)), c),
        straight := λ under rip2 => Fetches(fits := inside_value, reads := holds_value, held := held, after := λ f2 rip3 => {
            let below = t.index_below(buf, cap, found, w, Bool::set_of_not(bit, !bit, refl, under));
            let ends: (o + cap <= t.r.size) = Nat::le_trans(o + cap, layout.scratch_offset(), t.r.size, layout.buffer_end(buf, cap, found), t.scratch_fits());
            let fits: (o + i + 1 <= t.r.size) = omega(ends, below);
            let at = t.byte_address(buf, cap, found, w, below);
            StoresByte(plain := refl,
                writable := j(sym(at), λ a _ => t.io().writable(s.memory, a, 1), t.writable(s.memory, o + i, 1, fits)),
                resident := j(sym(at), λ a _ => t.site().Resident(t.r.profile.store(s.memory, a, [c])), t.store_resident(s.memory, o + i, [c], fits, resident)),
                after := j(sym(at), λ a _ => t.Held(live, after, s.gprs, t.r.profile.store(s.memory, a, [c])),
                    t.held_byte(live, env, s.gprs, s.memory, held, buf, cap, found, i, below, c)))
        }),
        defined := refl))
}

// The byte stored, then read back to the word `output`.
theorem Target::goes_stores(self t: Target, live, out: List<Nat>, env, other: Env, p: Prog, output, buf, index, value, cap, names: Nat,
    inside_output: t.layout().word_fits(output).IsTrue(), inside_index: t.layout().word_fits(index).IsTrue(), inside_value: t.layout().word_fits(value).IsTrue(),
    holds_index: Mem(index, live), holds_value: Mem(value, live), sub: (i: Nat) → Mem(i, out) → i ≠ output → Mem(i, live),
    apart: t.homes.apart(output, out).IsTrue(), found: t.caps.nth(buf) = Some(cap),
    within: p.byte(Emission(t.layout(), [], out), BufferStore(output, buf, index, value), cap, names).prog.Within(t.program), tree: ITree<BitVec(64)>(Events::linux()),
    same: env.store_at(buf, index, value).set_word(output,
        byte_word(buffer_byte(env.store_at(buf, index, value).buffers, buf, env.word(index).toNat()))) = other,
    next: t.At(prog_len(p.byte(Emission(t.layout(), [], out), BufferStore(output, buf, index, value), cap, names).prog), out, tree, other)): t.At(prog_len(p), live, tree, env) {
    let r = Run(t, [], out, live, env);
    let after = env.store_at(buf, index, value);
    let code = r.cx().from(names).put_byte(buf, index, value, cap).code;
    let stored = code.onto(r.cx(), p);
    let read_back = BufferLoad(output, buf, index);
    let loaded: t.At(prog_len(stored), live, tree, after) = t.goes_loads(live, out, after, other, stored, output, buf, index, cap, names + 1,
        inside_output, inside_index, holds_index, sub, apart, found, within, tree, same, next);
    let w_stored = Prog::within_trans(stored.within_byte(r.cx(), read_back, cap, names + 1), within);
    λ s here resident held => code.goes(r, p, w_stored, tree, λ u => t.Held(live, after, u.gprs, u.memory), loaded)(s, here, resident,
        t.put_byte_before(live, out, env, buf, index, value, cap, names, inside_index, inside_value, holds_index, holds_value, found, s, held, resident))
}

// ---------------------------------------------------------------------------
// A dataflow leaf

// What a leaf computes, as `Env::compute` runs a `Dataflow` region.
fn Env::computes(self env: Env, nodes: List<Node>) → Env {
    let after = run_nodes(nodes, env.valuation(), env.buffers);
    Env(env.words, after.buffers, env.args).settle(after.values, nodes_write_ports(nodes))
}

theorem Env::computes_load(self env: Env, output, buf, index: Nat):
    env.set_word(output, byte_word(buffer_byte(env.buffers, buf, env.word(index).toNat()))) = env.computes([BufferLoad(output, buf, index)]) {
    cong_fn<BitVec(64), Env>(λ x => env.set_word(output, x),
        sym(Valuation::set_here(env.valuation(), output, load_value(env.buffers, buf, index, env.valuation()), 64)))
}

theorem Env::computes_store(self env: Env, output, buf, index, value: Nat):
    env.store_at(buf, index, value).set_word(output, byte_word(buffer_byte(env.store_at(buf, index, value).buffers, buf, env.word(index).toNat()))) =
        env.computes([BufferStore(output, buf, index, value)]) {
    let after = env.store_at(buf, index, value);
    cong_fn<BitVec(64), Env>(λ x => after.set_word(output, x),
        sym(Valuation::set_here(env.valuation(), output, load_value(after.buffers, buf, index, env.valuation()), 64)))
}

theorem Prog::within_byte_node(self p: Prog, layout: Layout, out: List<Nat>, names: Nat, c: Compiled): (node: Node) →
    p.byte_node(layout, out, node, names) = Some(c) → p.Within(c.prog) {
    λ node => match node {
        BufferLoad(output, buf, index) => λ emitted => {
            cases emitted as fit, found(cap);
            p.within_byte(Emission(layout, [], out), BufferLoad(output, buf, index), cap, names)
        },
        BufferStore(output, buf, index, value) => λ emitted => {
            cases emitted as fit, found(cap);
            p.within_byte(Emission(layout, [], out), BufferStore(output, buf, index, value), cap, names)
        },
        _ => λ none => absurd(none),
    }
}

// A byte node's code: on with the environment the leaf computes, from the
// node's reads and what is live after it.
theorem Target::goes_byte_node(self t: Target, out: List<Nat>, env: Env, p: Prog, names: Nat, c: Compiled, tree: ITree<BitVec(64)>(Events::linux())):
    (node: Node) → t.homes.apart(node_output(node).id, out).IsTrue() →
    p.byte_node(t.layout(), out, node, names) = Some(c) → c.prog.Within(t.program) → t.At(prog_len(c.prog), out, tree, env.computes([node])) →
    t.At(prog_len(p), live_before(function_ir_eval::Node::reads(node), node_output(node).id, out), tree, env) {
    let layout = t.layout();
    λ node => match node {
        BufferLoad(output, buf, index) => λ apart emitted => {
            cases emitted as fit, found(cap);
            let ok = Bool::both(j(sym(fit), λ v _ => v.IsTrue(), trivial));
            λ within next => t.goes_loads(live_before([index], output, out), out, env, env.computes([BufferLoad(output, buf, index)]), p, output, buf, index, cap, names,
                layout.word_inside(output, ok.left), layout.word_inside(index, known), live_before_reads([index], output, out, index, Inl(refl)),
                λ i m ne => live_before_keeps([index], output, out, i, m, ne), apart, found, within, tree,
                env.computes_load(output, buf, index), next)
        },
        BufferStore(output, buf, index, value) => λ apart emitted => {
            cases emitted as fit, found(cap);
            let ok = Bool::both(j(sym(fit), λ v _ => v.IsTrue(), trivial));
            λ within next => t.goes_stores(live_before([index, value], output, out), out, env, env.computes([BufferStore(output, buf, index, value)]), p, output, buf, index, value, cap, names,
                layout.word_inside(output, ok.left), layout.word_inside(index, known), layout.word_inside(value, known),
                live_before_reads([index, value], output, out, index, Inl(refl)),
                live_before_reads([index, value], output, out, value, Inr(Inl(refl))),
                λ i m ne => live_before_keeps([index, value], output, out, i, m, ne), apart, found, within, tree,
                env.computes_store(output, buf, index, value), next)
        },
        _ => λ _ none => absurd(none),
    }
}

// ---------------------------------------------------------------------------
// Initial bytes

theorem Prog::within_byte_init(self p: Prog, layout: Layout, buf, i: Nat, c: BitVec(8)): p.Within(p.byte_init(layout, buf, i, c)) {
    let movs: List<Instruction> = [MovRI(Rbx, layout.byte_at(buf, i)), MovRI(Rax, byte_word(c))];
    p.within_step(then(p, Block(movs)), 0, StoreByte(ByteStore(Rbx, Rax)), p.within_then(0, Block(movs)))
}

theorem Prog::within_bytes_init(layout: Layout, buf: Nat, bytes: List<BitVec(8)>): (room, i: Nat) → (p: Prog) →
    p.Within(p.bytes_init(layout, bytes, room, buf, i)) {
    match bytes {
        Nil => λ room i p => p.within_self(),
        Cons(c, rest) => λ room => match room {
            Zero => λ i p => p.within_self(),
            Succ(r) => λ i p => Prog::within_trans(p.within_byte_init(layout, buf, i, c), Prog::within_bytes_init(layout, buf, rest, r, Succ(i), p.byte_init(layout, buf, i, c))),
        },
    }
}

theorem Prog::within_inits(layout: Layout, buffers: List<Buffer>): (buf: Nat) → (p: Prog) → p.Within(p.inits(layout, buffers, buf)) {
    match buffers {
        Nil => λ buf p => p.within_self(),
        Cons(b, rest) => λ buf p => {
            let filled = p.bytes_init(layout, b.initial, b.capacity, buf, 0);
            Prog::within_trans(Prog::within_bytes_init(layout, buf, b.initial, b.capacity, 0, p),
                Prog::within_inits(layout, rest, Succ(buf), filled))
        },
    }
}

// Byte `c` stored at index `i` of buffer `buf`, inside it.
theorem Target::goes_byte_init(self t: Target, live: List<Nat>, env: Env, p: Prog, buf, cap: Nat, found: t.caps.nth(buf) = Some(cap), i: Nat, below: i < cap,
    c: BitVec(8), within: p.byte_init(t.layout(), buf, i, c).Within(t.program), tree: ITree<BitVec(64)>(Events::linux()),
    next: t.At(prog_len(p.byte_init(t.layout(), buf, i, c)), live, tree, Env(env.words, store_byte(env.buffers, buf, i, c), env.args))): t.At(prog_len(p), live, tree, env) {
    let layout = t.layout();
    let o = layout.buffer_offset(buf);
    let movs: List<Instruction> = [MovRI(Rbx, layout.byte_at(buf, i)), MovRI(Rax, byte_word(c))];
    let moved = then(p, Block(movs));
    let store = ByteStore(Rbx, Rax);
    let after = Env(env.words, store_byte(env.buffers, buf, i, c), env.args);
    let post = λ (u: MachineState<X86Memory(t.r.profile)>) => t.Held(live, after, u.gprs, u.memory);
    let wrote = t.goes_store_byte(moved, 0, store, within, tree, post, next);
    let pre_store = λ (u: MachineState<X86Memory(t.r.profile)>) => (store_base_plain(store.base) = True) ∧
        (t.writes().writable(u.memory, read_gpr(store.base, u.gprs), 1) ∧
        (t.site().Resident(byte_store_after(t.writes(), store, u).memory) ∧ post(byte_store_after(t.writes(), store, u))));
    let blocked = t.goes_block(p, 0, movs, moved.within_before(0, StoreByte(store), t.program, within), tree, pre_store, wrote);
    let ends: (o + cap <= t.r.size) = Nat::le_trans(o + cap, layout.scratch_offset(), t.r.size, layout.buffer_end(buf, cap, found), t.scratch_fits());
    let fits: (o + i + 1 <= t.r.size) = omega(ends, below);
    let at: (layout.byte_at(buf, i) = next_rip(t.r.low, o + i)) = t.at_rip(o + i);
    let byte: (imm_byte0(byte_word(c)) = c) = BitVec::split_concat_low(8, 56, c, BitVec::zero());
    λ s here resident held => {
        let writable = j(sym(at), λ a _ => t.io().writable(s.memory, a, 1), t.writable(s.memory, o + i, 1, fits));
        let kept = j(sym(at), λ a _ => t.site().Resident(t.r.profile.store(s.memory, a, [imm_byte0(byte_word(c))])),
            j(sym(byte), λ x _ => t.site().Resident(t.r.profile.store(s.memory, next_rip(t.r.low, o + i), [x])),
                t.store_resident(s.memory, o + i, [c], fits, resident)));
        let placed = j(sym(at), λ a _ => t.Held(live, after, s.gprs, t.r.profile.store(s.memory, a, [imm_byte0(byte_word(c))])),
            j(sym(byte), λ x _ => t.Held(live, after, s.gprs, t.r.profile.store(s.memory, next_rip(t.r.low, o + i), [x])),
                t.held_byte(live, env, s.gprs, s.memory, held, buf, cap, found, i, below, c)));
        blocked(s, here, resident, ⟨refl, ⟨writable, ⟨kept, placed⟩⟩⟩)
    }
}

// Bytes stored past a buffer's end leave the environment held as it was.
theorem Target::held_stored_past(self t: Target, live: List<Nat>, buf, cap: Nat, found: t.caps.nth(buf) = Some(cap), bytes: List<BitVec(8)>):
    (i: Nat) → (env: Env) → (g: Gprs) → (m: X86Memory(t.r.profile)) → cap <= i → t.Held(live, env, g, m) →
    t.Held(live, Env(env.words, bytes.stored(buf, i, env.buffers), env.args), g, m) {
    match bytes {
        Nil => λ i env g m past held => held,
        Cons(c, rest) => λ i env g m past held =>
            t.held_stored_past(live, buf, cap, found, rest, Succ(i), Env(env.words, store_byte(env.buffers, buf, i, c), env.args), g, m, omega(past),
                t.held_past(live, env, g, m, held, buf, cap, found, i, past, c)),
    }
}

// A buffer's initial bytes stored from index `i`, `room` of its capacity
// left: on with them stored, those past the end dropped.
theorem Target::goes_bytes_init(self t: Target, live: List<Nat>, buf, cap: Nat, found: t.caps.nth(buf) = Some(cap), tree: ITree<BitVec(64)>(Events::linux()),
    bytes: List<BitVec(8)>): (room, i: Nat) → (p: Prog) → (env: Env) → i + room = cap →
    p.bytes_init(t.layout(), bytes, room, buf, i).Within(t.program) →
    t.At(prog_len(p.bytes_init(t.layout(), bytes, room, buf, i)), live, tree, Env(env.words, bytes.stored(buf, i, env.buffers), env.args)) →
    t.At(prog_len(p), live, tree, env) {
    let layout = t.layout();
    match bytes {
        Nil => λ room i p env _ within next => next,
        Cons(c, rest) => λ room => match room {
            Zero => λ i p env sum within next => {
                let stored = Cons(c, rest);
                t.goes_weaken(next,
                    λ u held => t.held_stored_past(live, buf, cap, found, stored, i, env, u.gprs, u.memory, omega(sum), held))
            },
            Succ(r) => λ i p env sum within next => {
                let one = p.byte_init(layout, buf, i, c);
                let w_one = Prog::within_trans(Prog::within_bytes_init(layout, buf, rest, r, Succ(i), one), within);
                let rest_goes = t.goes_bytes_init(live, buf, cap, found, tree, rest, r, Succ(i), one, Env(env.words, store_byte(env.buffers, buf, i, c), env.args), omega(sum), within, next);
                t.goes_byte_init(live, env, p, buf, cap, found, i, omega(sum), c, w_one, tree, rest_goes)
            },
        },
    }
}

// Every buffer's initial bytes stored, buffer `buf` first, the capacities
// from `buf` on those of `buffers`.
theorem Target::goes_inits(self t: Target, live: List<Nat>, tree: ITree<BitVec(64)>(Events::linux()), buffers: List<Buffer>): (buf: Nat) → (p: Prog) → (env: Env) →
    ((k: Nat) → t.caps.nth(buf + k) = buffers.map(λ (b: Buffer) => b.capacity).nth(k)) →
    p.inits(t.layout(), buffers, buf).Within(t.program) →
    t.At(prog_len(p.inits(t.layout(), buffers, buf)), live, tree, Env(env.words, initial_stores(buffers, buf, env.buffers), env.args)) →
    t.At(prog_len(p), live, tree, env) {
    let layout = t.layout();
    match buffers {
        Nil => λ buf p env _ within next => next,
        Cons(b, rest) => λ buf p env caps within next => {
            let filled = p.bytes_init(layout, b.initial, b.capacity, buf, 0);
            let w_filled = Prog::within_trans(Prog::within_inits(layout, rest, Succ(buf), filled), within);
            let caps_rest = λ (k: Nat) => {
                let shifted: (buf + Succ(k) = Succ(buf) + k) = omega();
                trans(cong_fn<Nat, Option<Nat>>(λ x => t.caps.nth(x), sym(shifted)), caps(Succ(k)))
            };
            let after = Env(env.words, b.initial.stored(buf, 0, env.buffers), env.args);
            let rest_goes = t.goes_inits(live, tree, rest, Succ(buf), filled, after, caps_rest, within, next);
            t.goes_bytes_init(live, buf, b.capacity, caps(0), tree, b.initial, b.capacity, 0, p, env, omega(), w_filled, rest_goes)
        },
    }
}

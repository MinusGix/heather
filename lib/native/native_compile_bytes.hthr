// Byte nodes and initial bytes compiled (issues/native-source-bytes.md): a
// leaf of one `BufferLoad` or `BufferStore` runs as `Env::compute` says, and
// the stores at entry leave the region holding the source's start.
//
// A byte the code stores lands in its buffer's range, so the environment
// stays placed with that one byte of the buffer set (`Layout::keeps_byte`);
// an index the CMP finds past the capacity stores nothing, and the source's
// store, an update past the buffer's end, leaves it as it was
// (`Target::placed_past`). A load reads the cell the environment keeps at
// the buffer's offset plus the index (`cells_nth`), or zero past the end.
import native_source;
import native_compile;
import native_compile_facts;
import native_compile_region;
import native_compile_steps;
import native_compile_segments;
import native_compile_calls;
import native_compile_leaf;
import function_ir;
import function_ir_eval;
import function_ir_state;
import linux_trees;
import linux_x86_64_byte_memory;
import itree;
import x86_64;
import x86_64_block;
import x86_64_asm;
import x86_64_asm_runs;
import x86_64_data_read;
import x86_64_store;
import x86_64_byte_memory;
import memory;
import bitvec;
import bitvec_nat;
import bool;
import list;
import logic;
import nat;
import option;
import omega;

// ---------------------------------------------------------------------------
// A buffer's bytes after one is stored

// The cells with `bytes` stored from `q`, as the region's store leaves them.
fn DataRegion::stored_cells(self r: DataRegion, v: Nat → BitVec(8), q: Nat, bytes: List<BitVec(8)>) → Nat → BitVec(8) {
    r.buffer(v).set_span(q, bytes.to_vector()).cells
}

// A byte node reads the buffer the environment names.
theorem Env::buffer_byte_is(self env: Env, buf, i: Nat): buffer_byte(env.buffers, buf, i) = env.buffer(buf).get_or(i, BitVec::zero()) {
    match env.buffers.nth(buf) as λ o => (match o as λ _ => BitVec(8) {
                None => BitVec::zero(),
                Some(bytes) => match bytes.nth(i) as λ _ => BitVec(8) { None => BitVec::zero(), Some(byte) => byte },
            }) = (match o as λ _ => List<BitVec(8)> { None => Nil, Some(bytes) => bytes }).get_or(i, BitVec::zero()) {
        None => refl,
        Some(_) => refl,
    }
}

theorem Env::buffer_stored_here(self env: Env, buf, i: Nat, c: BitVec(8)):
    Env(env.words, store_byte(env.buffers, buf, i, c)).buffer(buf) = env.buffer(buf).update(i, λ _ => c) {
    let f = λ (bytes: List<BitVec(8)>) => bytes.update(i, λ _ => c);
    (match env.buffers.nth(buf) as λ o => env.buffers.nth(buf) = o →
            (match env.buffers.update(buf, f).nth(buf) as λ _ => List<BitVec(8)> { None => Nil, Some(bytes) => bytes }) =
            (match o as λ _ => List<BitVec(8)> { None => Nil, Some(bytes) => bytes }).update(i, λ _ => c) {
        None => λ none => j(sym(env.buffers.nth_update_none(buf, f, none)),
            λ x _ => (match x as λ _ => List<BitVec(8)> { None => Nil, Some(bytes) => bytes }) = Nil.update(i, λ _ => c), refl),
        Some(bytes) => λ some => j(sym(env.buffers.nth_update_here(buf, f, bytes, some)),
            λ x _ => (match x as λ _ => List<BitVec(8)> { None => Nil, Some(bytes) => bytes }) = bytes.update(i, λ _ => c), refl),
    })(refl)
}

theorem Env::buffer_stored_other(self env: Env, buf, i: Nat, c: BitVec(8), b: Nat, ne: b ≠ buf):
    Env(env.words, store_byte(env.buffers, buf, i, c)).buffer(b) = env.buffer(b) {
    cong_fn<Option<List<BitVec(8)>>, List<BitVec(8)>>(λ o => match o { None => Nil, Some(bytes) => bytes },
        env.buffers.nth_update_other(buf, λ (bytes: List<BitVec(8)>) => bytes.update(i, λ _ => c), b, ne))
}

// Cells that differ only at `o + i`, where they hold `c`: the list with `c`
// at `i`.
theorem cells_update(v, w: Nat → BitVec(8), c: BitVec(8), n: Nat): (o, i: Nat) → i < n → w(o + i) = c →
    ((p: Nat) → p ≠ o + i → w(p) = v(p)) → cells_at(w, o, n) = cells_at(v, o, n).update(i, λ _ => c) {
    match n {
        Zero => λ o i below => false_elim(omega(below)),
        Succ(k, ih) => λ o i => match i {
            Zero => λ _ here other => eq2(λ (x: BitVec(8)) (rest: List<BitVec(8)>) => Cons(x, rest), here,
                cells_agree(w, v, k, Succ(o), λ t _ => other(Succ(o) + t, λ same => false_elim(omega(same))))),
            Succ(l) => λ below here other => eq2(λ (x: BitVec(8)) (rest: List<BitVec(8)>) => Cons(x, rest),
                other(o, λ same => false_elim(omega(same))),
                ih(Succ(o), l, below, trans(cong_fn<Nat, BitVec(8)>(λ p => w(p), Nat::add_succ_left(o, l)), here),
                    λ p ne => other(p, λ same => ne(trans(same, sym(Nat::add_succ_left(o, l))))))),
        },
    }
}

// A byte stored inside its buffer keeps the environment with that byte set.
theorem Layout::keeps_byte(self layout: Layout, r: DataRegion, env: Env, v: Nat → BitVec(8), keeps: layout.Keeps(env, v),
    buf, cap: Nat, found: layout.capacities.nth(buf) = Some(cap), i: Nat, below: i < cap, c: BitVec(8)):
    layout.Keeps(Env(env.words, store_byte(env.buffers, buf, i, c)), r.stored_cells(v, layout.buffer_offset(buf) + i, [c])) {
    let o = layout.buffer_offset(buf);
    let q = o + i;
    let w = r.stored_cells(v, q, [c]);
    let ends = layout.buffer_end(buf, cap, found);
    let after = Env(env.words, store_byte(env.buffers, buf, i, c));
    let apart = λ (p: Nat) (ne: p ≠ q) => r.cells_outside(v, q, [c], p, match p.lt_or_ge(q) {
        Inl(under) => Inl(under),
        Inr(over) => {
            let past: (q + 1 <= p) = omega(over, ne);
            Inr(past)
        },
    });
    let words = λ (k: Nat) (inside: k < word_slots()) => trans(cong_fn<BitVec(64), Nat>(λ x => x.toNat(), word_in_agree(w, v, 8 * k, λ t short =>
        r.cells_outside(v, q, [c], 8 * k + t, Inl(omega(layout.word_below_buffers(k, t, inside, short), layout.buffers_after_words(buf)))))),
        keeps.left(k, inside));
    ⟨words, λ b cb found_b => match b.eq_dec(buf) {
        Inl(here) => {
            let cap_same: (cb = cap) = Option::some_inj(cb, cap, trans(sym(found_b), j(sym(here), λ x _ => layout.capacities.nth(x) = Some(cap), found)));
            let updated: (cells_at(w, o, cap) = cells_at(v, o, cap).update(i, λ _ => c)) = cells_update(v, w, c, cap, o, i, below,
                r.cells_inside(v, q, [c], 0, c, refl), apart);
            let stored: (after.buffer(buf) = cells_at(w, o, cap)) = trans(env.buffer_stored_here(buf, i, c),
                trans(cong_fn<List<BitVec(8)>, List<BitVec(8)>>(λ bytes => bytes.update(i, λ _ => c), keeps.right(buf, cap, found)), sym(updated)));
            j(sym(here), λ x _ => after.buffer(x) = cells_at(w, layout.buffer_offset(x), cb),
                j(sym(cap_same), λ k _ => after.buffer(buf) = cells_at(w, o, k), stored))
        },
        Inr(other) => {
            let o_b = layout.buffer_offset(b);
            let away: ((t: Nat) → t < cb → o_b + t ≠ q) = λ t short => match b.lt_or_ge(buf) {
                Inl(under) => {
                    let gap = layout.buffer_apart(b, cb, buf, found_b, under);
                    λ same => false_elim(omega(gap, short, same))
                },
                Inr(over) => {
                    let gap = layout.buffer_apart(buf, cap, b, found, omega(over, other));
                    λ same => false_elim(omega(gap, below, same))
                },
            };
            trans(env.buffer_stored_other(buf, i, c, b, other),
                trans(keeps.right(b, cb, found_b), cells_agree(v, w, cb, o_b, λ t short => sym(apart(o_b + t, away(t, short))))))
        },
    }⟩
}

// The byte stored at its address: the environment placed with it set.
theorem Target::placed_byte(self t: Target, env: Env, m: X86Memory(t.r.profile), placed: t.Placed(env, m), buf, cap: Nat,
    found: t.caps.nth(buf) = Some(cap), i: Nat, below: i < cap, c: BitVec(8)):
    t.Placed(Env(env.words, store_byte(env.buffers, buf, i, c)), t.r.profile.store(m, next_rip(t.r.low, t.layout().buffer_offset(buf) + i), [c])) {
    let v = placed.witness;
    let o = t.layout().buffer_offset(buf);
    let fits: (o + i + 1 <= t.r.size) = omega(t.layout().buffer_end(buf, cap, found), t.scratch_fits(), below);
    Exists(t.r.stored_cells(v, o + i, [c]),
        ⟨t.r.store_holds(v, m, placed.proof.left, o + i, [c], fits),
         t.layout().keeps_byte(t.r, env, v, placed.proof.right, buf, cap, found, i, below, c)⟩)
}

// A store past the buffer's end leaves the environment placed as it was.
theorem Target::placed_past(self t: Target, env: Env, m: X86Memory(t.r.profile), placed: t.Placed(env, m), buf, cap: Nat,
    found: t.caps.nth(buf) = Some(cap), i: Nat, past: cap <= i, c: BitVec(8)):
    t.Placed(Env(env.words, store_byte(env.buffers, buf, i, c)), m) {
    let v = placed.witness;
    let keeps = placed.proof.right;
    let layout = t.layout();
    let after = Env(env.words, store_byte(env.buffers, buf, i, c));
    let len = layout.keeps_buffer_len(env, v, keeps, buf, cap, found);
    let same: (after.buffer(buf) = env.buffer(buf)) = trans(env.buffer_stored_here(buf, i, c),
        env.buffer(buf).update_past(i, λ _ => c, j(sym(len), λ n _ => n <= i, past)));
    Exists(v, ⟨placed.proof.left, ⟨λ k inside => keeps.left(k, inside), λ b cb found_b => match b.eq_dec(buf) {
        Inl(here) => (j(sym(here), λ x _ => layout.capacities.nth(x) = Some(cb) → after.buffer(x) = cells_at(v, layout.buffer_offset(x), cb),
            λ found_here => trans(same, keeps.right(buf, cb, found_here))))(found_b),
        Inr(other) => trans(env.buffer_stored_other(buf, i, c, b, other), keeps.right(b, cb, found_b)),
    }⟩⟩)
}

// ---------------------------------------------------------------------------
// A byte loaded

// The byte at index `w` of a buffer, at the buffer's address plus `w`.
theorem Target::byte_address(self t: Target, buf, cap: Nat, found: t.caps.nth(buf) = Some(cap), w: BitVec(64), below: w.toNat() < cap):
    t.layout().buffer_at(buf).add(w) = next_rip(t.r.low, t.layout().buffer_offset(buf) + w.toNat()) {
    let o = t.layout().buffer_offset(buf);
    let low = t.r.low.toNat();
    let i = w.toNat();
    let fits = t.buffer_fits(buf, cap, found);
    let top = canonical_below_top();
    let ends: (o + cap <= t.r.size) = Nat::le_trans(o + cap, t.layout().scratch_offset(), t.r.size, t.layout().buffer_end(buf, cap, found), t.scratch_fits());
    let sum: (t.layout().buffer_at(buf).add(w).toNat() = (low + o) + i) =
        add_words(64, t.layout().buffer_at(buf), w, low + o, i, t.buffer_toNat(buf, cap, found), refl, omega(fits, top, below));
    let regrouped: ((low + o) + i = low + (o + i)) = omega();
    trans(sym(word_of_nat_toNat(64, t.layout().buffer_at(buf).add(w))),
        trans(cong_fn<Nat, BitVec(64)>(λ k => word_of_nat(64, k), trans(sum, regrouped)), t.cell_address(o + i, omega(ends, below))))
}

// A capacity is a word's number.
theorem Target::cap_word(self t: Target, buf, cap: Nat, found: t.caps.nth(buf) = Some(cap)): BitVec::ofNat(cap, n := 64).toNat() = cap {
    let fits = t.buffer_fits(buf, cap, found);
    let top = canonical_below_top();
    BitVec::toNat_ofNat(64, cap, omega(fits, top))
}

theorem Prog::byte_to_within(self p: Prog, layout: Layout, buf, index, cap, skip: Nat, program: Prog,
    within: p.byte_to(layout, buf, index, cap, skip).Within(program)): p.Within(program) {
    let w0 = p.word_to(layout, index, Rcx);
    let cmp = then(w0, Block([MovRI(Rdx, BitVec::ofNat(cap)), MovRI(Rax, BitVec::ofNat(0)), CmpRR(Rcx, Rdx)]));
    let jcc = then(cmp, Jcc(AE, skip));
    let addr = then(jcc, Block([MovRI(Rbx, layout.buffer_at(buf)), AddRR(Rbx, Rcx)]));
    let loaded = then(addr, LoadByte(ByteLoad(Rax, Rbx)));
    let w_loaded = loaded.within_before(skip, Block([]), program, within);
    let w_addr = addr.within_before(0, LoadByte(ByteLoad(Rax, Rbx)), program, w_loaded);
    let w_jcc = jcc.within_before(0, Block([MovRI(Rbx, layout.buffer_at(buf)), AddRR(Rbx, Rcx)]), program, w_addr);
    let w_cmp = cmp.within_before(0, Jcc(AE, skip), program, w_jcc);
    p.word_to_within(layout, index, Rcx, program, w0.within_before(0, Block([MovRI(Rdx, BitVec::ofNat(cap)), MovRI(Rax, BitVec::ofNat(0)), CmpRR(Rcx, Rdx)]), program, w_cmp))
}

// The byte at the word `index` of buffer `buf` in RAX, zero past the end.
theorem Target::goes_byte_to(self t: Target, env: Env, p: Prog, buf, index, cap, n: Nat, inside: index < word_slots(),
    found: t.caps.nth(buf) = Some(cap), within: p.byte_to(t.layout(), buf, index, cap, Succ(n)).Within(t.program),
    tree: ITree<BitVec(64)>(Events::linux()), q: Gprs → X86Memory(t.r.profile) → Type,
    next: t.GoesR(prog_len(p.byte_to(t.layout(), buf, index, cap, Succ(n))), tree, q)):
    t.GoesR(prog_len(p), tree, λ (g: Gprs) (m: X86Memory(t.r.profile)) => t.Placed(env, m) ∧
        ((h: Gprs) → read_gpr(Rax, h) = byte_word(buffer_byte(env.buffers, buf, env.word(index).toNat())) → q(h, m))) {
    let layout = t.layout();
    let w = env.word(index);
    let i = w.toNat();
    let o = layout.buffer_offset(buf);
    let wanted = byte_word(buffer_byte(env.buffers, buf, i));
    let then_q = λ (m: X86Memory(t.r.profile)) => (h: Gprs) → read_gpr(Rax, h) = wanted → q(h, m);
    let set: List<Instruction> = [MovRI(Rdx, BitVec::ofNat(cap)), MovRI(Rax, BitVec::ofNat(0)), CmpRR(Rcx, Rdx)];
    let adds: List<Instruction> = [MovRI(Rbx, layout.buffer_at(buf)), AddRR(Rbx, Rcx)];
    let w0 = p.word_to(layout, index, Rcx);
    let cmp = then(w0, Block(set));
    let jcc = then(cmp, Jcc(AE, Succ(n)));
    let addr = then(jcc, Block(adds));
    let loaded = then(addr, LoadByte(ByteLoad(Rax, Rbx)));
    let w_loaded = loaded.within_before(Succ(n), Block([]), t.program, within);
    let w_addr = addr.within_before(0, LoadByte(ByteLoad(Rax, Rbx)), t.program, w_loaded);
    let w_jcc = jcc.within_before(0, Block(adds), t.program, w_addr);
    let w_cmp = cmp.within_before(0, Jcc(AE, Succ(n)), t.program, w_jcc);
    let w_w0 = w0.within_before(0, Block(set), t.program, w_cmp);
    let post = λ (u: MachineState<X86Memory(t.r.profile)>) => q(u.gprs, u.memory);
    let read = t.goes_load_byte(addr, 0, ByteLoad(Rax, Rbx), w_loaded, tree, post, next);
    let pre_load: MachineState<X86Memory(t.r.profile)> → Type = λ u => Exists<BitVec(8)>(λ byte =>
        (read_gpr(Rbx, u.gprs).toNat() < Nat::pow(2, 47)) ∧
        ((t.site().data.read(u.memory, read_gpr(Rbx, u.gprs)) = Some(byte)) ∧ post(byte_load_after(ByteLoad(Rax, Rbx), byte, u))));
    let added = t.goes_block(jcc, 0, adds, w_addr, tree, pre_load, read);
    let pre = λ (g: Gprs) (f: Flags) (m: X86Memory(t.r.profile)) => t.Placed(env, m) ∧ ((read_gpr(Rcx, g) = w) ∧
        ((read_gpr(Rax, g) = BitVec::ofNat(0)) ∧ ((f.cf = w.borrow_sub_bit(BitVec::ofNat(cap))) ∧ then_q(m))));
    let cap_is = t.cap_word(buf, cap, found);
    let len = λ (m: X86Memory(t.r.profile)) (placed: t.Placed(env, m)) => layout.keeps_buffer_len(env, placed.witness, placed.proof.right, buf, cap, found);
    let lands = t.program.lands_jcc(t.laid, w_jcc.witness, cmp, 0, AE, n, w_jcc.proof, within.witness, loaded, Block([]), within.proof);
    let jumped = t.io().goes_jcc(t.program, t.origin, t.code_fits(), w_jcc.witness, cmp, 0, AE, Succ(n), w_jcc.proof, prog_len(loaded), lands, tree, pre,
        λ u here resident held => {
            let hp = held.left;
            let cf: (u.flags.cf = False) = Bool::clear_of_not(u.flags.cf, !u.flags.cf, refl, held.right);
            let no: (w.borrow_sub_bit(BitVec::ofNat(cap)) = False) = trans(sym(hp.right.right.right.left), cf);
            let past: (cap <= i) = {
                let not_below: (BitVec::ofNat(cap, n := 64).toNat() <= i) = i.le_of_not_lt(BitVec::ofNat(cap, n := 64).toNat(),
                    λ (lt: i < BitVec::ofNat(cap, n := 64).toNat()) => absurd(trans(sym(no), BitVec::borrow_sub_bit_of_borrow(64, w, BitVec::ofNat(cap), lt))));
                omega(not_below, cap_is)
            };
            let none: (env.buffer(buf).nth(i) = None) = env.buffer(buf).nth_past_end(i, j(sym(len(u.memory, hp.left)), λ k _ => k <= i, past));
            let zero: (buffer_byte(env.buffers, buf, i) = BitVec::zero()) = trans(env.buffer_byte_is(buf, i), env.buffer(buf).get_or_none(i, BitVec::zero(), none));
            let rax: (read_gpr(Rax, u.gprs) = wanted) = trans(hp.right.right.left, sym(cong_fn<BitVec(8), BitVec(64)>(λ c => byte_word(c), zero)));
            next(u, here, resident, hp.right.right.right.right(u.gprs, rax))
        },
        λ u here resident held => {
            let hp = held.left;
            let v = hp.left.witness;
            let cf: (u.flags.cf = True) = Bool::set_of_not(u.flags.cf, !u.flags.cf, refl, held.right);
            let yes: (w.borrow_sub_bit(BitVec::ofNat(cap)) = True) = trans(sym(hp.right.right.right.left), cf);
            let below: (i < cap) = {
                let lt: (i < BitVec::ofNat(cap, n := 64).toNat()) = BitVec::borrow_sub_of_bit_true(64, w, BitVec::ofNat(cap), yes);
                omega(lt, cap_is)
            };
            let ends: (o + cap <= t.r.size) = Nat::le_trans(o + cap, layout.scratch_offset(), t.r.size, layout.buffer_end(buf, cap, found), t.scratch_fits());
            let cell = t.read_cell(v, u.memory, hp.left.proof.left, o + i, omega(ends, below));
            let at: (layout.buffer_at(buf).add(read_gpr(Rcx, u.gprs)) = next_rip(t.r.low, o + i)) =
                trans(cong_fn<BitVec(64), BitVec(64)>(λ x => layout.buffer_at(buf).add(x), hp.right.left), t.byte_address(buf, cap, found, w, below));
            let byte_is: (buffer_byte(env.buffers, buf, i) = v(o + i)) = trans(env.buffer_byte_is(buf, i),
                trans(cong_fn<List<BitVec(8)>, BitVec(8)>(λ bytes => bytes.get_or(i, BitVec::zero()), hp.left.proof.right.right(buf, cap, found)),
                    cells_at(v, o, cap).get_or_some(i, BitVec::zero(), v(o + i), cells_nth(v, cap, o, i, below))));
            let rax: (byte_word(v(o + i)) = wanted) = cong_fn<BitVec(8), BitVec(64)>(λ c => byte_word(c), sym(byte_is));
            let s1 = execute_block_normal(adds, u);
            let reads = j(sym(at), λ a _ => (a.toNat() < Nat::pow(2, 47)) ∧ (t.site().data.read(u.memory, a) = Some(v(o + i))), cell);
            let ok: post(byte_load_after(ByteLoad(Rax, Rbx), v(o + i), s1)) = hp.right.right.right.right(byte_load_after(ByteLoad(Rax, Rbx), v(o + i), s1).gprs, rax);
            added(u, here, resident, Exists(v(o + i), ⟨reads.left, ⟨reads.right, ok⟩⟩))
        });
    let compared = t.goes_block(w0, 0, set, w_cmp, tree, λ (u: MachineState<X86Memory(t.r.profile)>) => pre(u.gprs, u.flags, u.memory), jumped);
    let loads = t.goes_word_to(env, p, index, Rcx, inside, w_w0, tree,
        λ (g: Gprs) (m: X86Memory(t.r.profile)) => t.Placed(env, m) ∧ ((read_gpr(Rcx, g) = w) ∧ then_q(m)),
        λ u here resident held => compared(u, here, resident,
            ⟨held.left, ⟨held.right.left, ⟨refl, ⟨cong_fn<BitVec(64), Bool>(λ x => x.borrow_sub_bit(BitVec::ofNat(cap)), held.right.left), held.right.right⟩⟩⟩⟩));
    λ s here resident held => loads(s, here, resident, ⟨held.left, ⟨held.left, ⟨refl, held.right⟩⟩⟩)
}

theorem Prog::loads_within(self p: Prog, layout: Layout, output, buf, index, cap, names: Nat, program: Prog,
    within: p.loads(layout, output, buf, index, cap, names).Within(program)): p.Within(program) {
    let b = p.byte_to(layout, buf, index, cap, Succ(names));
    p.byte_to_within(layout, buf, index, cap, Succ(names), program, b.word_from_within(layout, output, Rax, program, within))
}

// The byte stored to the word `output`: the environment with it set is the
// one the claim after reads.
theorem Target::goes_loads(self t: Target, env, other: Env, p: Prog, output, buf, index, cap, names: Nat,
    inside_output: output < word_slots(), inside_index: index < word_slots(), found: t.caps.nth(buf) = Some(cap),
    within: p.loads(t.layout(), output, buf, index, cap, names).Within(t.program), tree: ITree<BitVec(64)>(Events::linux()),
    same: env.set_word(output, byte_word(buffer_byte(env.buffers, buf, env.word(index).toNat()))) = other,
    next: t.At(prog_len(p.loads(t.layout(), output, buf, index, cap, names)), tree, other)): t.At(prog_len(p), tree, env) {
    let b = p.byte_to(t.layout(), buf, index, cap, Succ(names));
    let stored = t.goes_result(env, other, b, output, inside_output, within, tree, next);
    let loaded = t.goes_byte_to(env, p, buf, index, cap, names, inside_index, found, b.word_from_within(t.layout(), output, Rax, t.program, within), tree,
        λ (g: Gprs) (m: X86Memory(t.r.profile)) => t.Placed(env, m) ∧ (env.set_word(output, read_gpr(Rax, g)) = other), stored);
    λ s here resident held => loaded(s, here, resident,
        ⟨held, λ h rax => ⟨held, trans(cong_fn<BitVec(64), Env>(λ x => env.set_word(output, x), rax), same)⟩⟩)
}

// ---------------------------------------------------------------------------
// A byte stored

// The environment with the word `value`'s low byte at the word `index` of
// buffer `buf`, as the source stores it.
fn Env::store_at(self env: Env, buf, index, value: Nat) → Env {
    Env(env.words, store_byte(env.buffers, buf, env.word(index).toNat(), low_byte(env.word(value))))
}

theorem Prog::byte_from_within(self p: Prog, layout: Layout, buf, index, value, cap, skip: Nat, program: Prog,
    within: p.byte_from(layout, buf, index, value, cap, skip).Within(program)): p.Within(program) {
    let w0 = p.word_to(layout, index, Rcx);
    let set: List<Instruction> = [MovRI(Rdx, BitVec::ofNat(cap)), CmpRR(Rcx, Rdx)];
    let adds: List<Instruction> = [MovRI(Rbx, layout.buffer_at(buf)), AddRR(Rbx, Rcx)];
    let cmp = then(w0, Block(set));
    let jcc = then(cmp, Jcc(AE, skip));
    let wv = jcc.word_to(layout, value, Rax);
    let addr = then(wv, Block(adds));
    let stored = then(addr, StoreByte(ByteStore(Rbx, Rax)));
    let w_stored = stored.within_before(skip, Block([]), program, within);
    let w_addr = addr.within_before(0, StoreByte(ByteStore(Rbx, Rax)), program, w_stored);
    let w_wv = wv.within_before(0, Block(adds), program, w_addr);
    let w_jcc = jcc.word_to_within(layout, value, Rax, program, w_wv);
    let w_cmp = cmp.within_before(0, Jcc(AE, skip), program, w_jcc);
    p.word_to_within(layout, index, Rcx, program, w0.within_before(0, Block(set), program, w_cmp))
}

// The word `value`'s low byte stored at the word `index` of buffer `buf`,
// nothing stored past the end: on with the environment the source stores.
theorem Target::goes_byte_from(self t: Target, env: Env, p: Prog, buf, index, value, cap, n: Nat,
    inside_index: index < word_slots(), inside_value: value < word_slots(), found: t.caps.nth(buf) = Some(cap),
    within: p.byte_from(t.layout(), buf, index, value, cap, Succ(n)).Within(t.program), tree: ITree<BitVec(64)>(Events::linux()),
    next: t.At(prog_len(p.byte_from(t.layout(), buf, index, value, cap, Succ(n))), tree, env.store_at(buf, index, value))):
    t.At(prog_len(p), tree, env) {
    let layout = t.layout();
    let w = env.word(index);
    let i = w.toNat();
    let o = layout.buffer_offset(buf);
    let c = low_byte(env.word(value));
    let after = env.store_at(buf, index, value);
    let set: List<Instruction> = [MovRI(Rdx, BitVec::ofNat(cap)), CmpRR(Rcx, Rdx)];
    let adds: List<Instruction> = [MovRI(Rbx, layout.buffer_at(buf)), AddRR(Rbx, Rcx)];
    let w0 = p.word_to(layout, index, Rcx);
    let cmp = then(w0, Block(set));
    let jcc = then(cmp, Jcc(AE, Succ(n)));
    let wv = jcc.word_to(layout, value, Rax);
    let addr = then(wv, Block(adds));
    let stored = then(addr, StoreByte(ByteStore(Rbx, Rax)));
    let w_stored = stored.within_before(Succ(n), Block([]), t.program, within);
    let w_addr = addr.within_before(0, StoreByte(ByteStore(Rbx, Rax)), t.program, w_stored);
    let w_wv = wv.within_before(0, Block(adds), t.program, w_addr);
    let w_jcc = jcc.word_to_within(layout, value, Rax, t.program, w_wv);
    let w_cmp = cmp.within_before(0, Jcc(AE, Succ(n)), t.program, w_jcc);
    let w_w0 = w0.within_before(0, Block(set), t.program, w_cmp);
    let post = λ (u: MachineState<X86Memory(t.r.profile)>) => t.Placed(after, u.memory);
    let store = ByteStore(Rbx, Rax);
    let wrote = t.goes_store_byte(addr, 0, store, w_stored, tree, post, next);
    let pre_store = λ (u: MachineState<X86Memory(t.r.profile)>) => (store_base_plain(store.base) = True) ∧
        (t.writes().writable(u.memory, read_gpr(store.base, u.gprs), 1) ∧
        (t.site().Resident(byte_store_after(t.writes(), store, u).memory) ∧ post(byte_store_after(t.writes(), store, u))));
    let added = t.goes_block(wv, 0, adds, w_addr, tree, pre_store, wrote);
    let ends: (o + cap <= t.r.size) = Nat::le_trans(o + cap, layout.scratch_offset(), t.r.size, layout.buffer_end(buf, cap, found), t.scratch_fits());
    let q_v = λ (g: Gprs) (m: X86Memory(t.r.profile)) => t.Placed(env, m) ∧ ((read_gpr(Rcx, g) = w) ∧ ((read_gpr(Rax, g) = env.word(value)) ∧ (i < cap)));
    let valued = t.goes_word_to(env, jcc, value, Rax, inside_value, w_wv, tree, q_v, λ u here resident held => {
        let placed = held.left;
        let below = held.right.right.right;
        let fits: (o + i + 1 <= t.r.size) = omega(ends, below);
        let at: (layout.buffer_at(buf).add(read_gpr(Rcx, u.gprs)) = next_rip(t.r.low, o + i)) =
            trans(cong_fn<BitVec(64), BitVec(64)>(λ x => layout.buffer_at(buf).add(x), held.right.left), t.byte_address(buf, cap, found, w, below));
        let byte = imm_byte0(read_gpr(Rax, u.gprs));
        let writable = j(sym(at), λ a _ => t.io().writable(u.memory, a, 1), t.writable(u.memory, o + i, 1, fits));
        let kept = j(sym(at), λ a _ => t.site().Resident(t.r.profile.store(u.memory, a, [byte])),
            t.store_resident(u.memory, o + i, [byte], fits, resident));
        let placed_after: t.Placed(after, t.r.profile.store(u.memory, next_rip(t.r.low, o + i), [byte])) =
            j(sym(held.right.right.left), λ x _ => t.Placed(after, t.r.profile.store(u.memory, next_rip(t.r.low, o + i), [imm_byte0(x)])),
                t.placed_byte(env, u.memory, placed, buf, cap, found, i, below, c));
        let placed_at = j(sym(at), λ a _ => t.Placed(after, t.r.profile.store(u.memory, a, [byte])), placed_after);
        added(u, here, resident, ⟨refl, ⟨writable, ⟨kept, placed_at⟩⟩⟩)
    });
    let pre = λ (g: Gprs) (f: Flags) (m: X86Memory(t.r.profile)) => t.Placed(env, m) ∧ ((read_gpr(Rcx, g) = w) ∧
        (f.cf = w.borrow_sub_bit(BitVec::ofNat(cap))));
    let cap_is = t.cap_word(buf, cap, found);
    let lands = t.program.lands_jcc(t.laid, w_jcc.witness, cmp, 0, AE, n, w_jcc.proof, within.witness, stored, Block([]), within.proof);
    let jumped = t.io().goes_jcc(t.program, t.origin, t.code_fits(), w_jcc.witness, cmp, 0, AE, Succ(n), w_jcc.proof, prog_len(stored), lands, tree, pre,
        λ u here resident held => {
            let hp = held.left;
            let cf: (u.flags.cf = False) = Bool::clear_of_not(u.flags.cf, !u.flags.cf, refl, held.right);
            let no: (w.borrow_sub_bit(BitVec::ofNat(cap)) = False) = trans(sym(hp.right.right), cf);
            let past: (cap <= i) = {
                let not_below: (BitVec::ofNat(cap, n := 64).toNat() <= i) = i.le_of_not_lt(BitVec::ofNat(cap, n := 64).toNat(),
                    λ (lt: i < BitVec::ofNat(cap, n := 64).toNat()) => absurd(trans(sym(no), BitVec::borrow_sub_bit_of_borrow(64, w, BitVec::ofNat(cap), lt))));
                omega(not_below, cap_is)
            };
            next(u, here, resident, t.placed_past(env, u.memory, hp.left, buf, cap, found, i, past, c))
        },
        λ u here resident held => {
            let hp = held.left;
            let cf: (u.flags.cf = True) = Bool::set_of_not(u.flags.cf, !u.flags.cf, refl, held.right);
            let yes: (w.borrow_sub_bit(BitVec::ofNat(cap)) = True) = trans(sym(hp.right.right), cf);
            let lt: (i < BitVec::ofNat(cap, n := 64).toNat()) = BitVec::borrow_sub_of_bit_true(64, w, BitVec::ofNat(cap), yes);
            let below: (i < cap) = omega(lt, cap_is);
            valued(u, here, resident, ⟨hp.left, ⟨hp.left, ⟨hp.right.left, ⟨refl, below⟩⟩⟩⟩)
        });
    let compared = t.goes_block(w0, 0, set, w_cmp, tree, λ (u: MachineState<X86Memory(t.r.profile)>) => pre(u.gprs, u.flags, u.memory), jumped);
    let indexed = t.goes_word_to(env, p, index, Rcx, inside_index, w_w0, tree,
        λ (g: Gprs) (m: X86Memory(t.r.profile)) => t.Placed(env, m) ∧ (read_gpr(Rcx, g) = w),
        λ u here resident held => compared(u, here, resident,
            ⟨held.left, ⟨held.right, cong_fn<BitVec(64), Bool>(λ x => x.borrow_sub_bit(BitVec::ofNat(cap)), held.right)⟩⟩));
    λ s here resident held => indexed(s, here, resident, ⟨held, ⟨held, refl⟩⟩)
}

theorem Prog::stores_within(self p: Prog, layout: Layout, output, buf, index, value, cap, names: Nat, program: Prog,
    within: p.stores(layout, output, buf, index, value, cap, names).Within(program)): p.Within(program) {
    let b = p.byte_from(layout, buf, index, value, cap, Succ(names));
    p.byte_from_within(layout, buf, index, value, cap, Succ(names), program, b.loads_within(layout, output, buf, index, cap, Succ(names), program, within))
}

// The byte stored, then read back to the word `output`.
theorem Target::goes_stores(self t: Target, env, other: Env, p: Prog, output, buf, index, value, cap, names: Nat,
    inside_output: output < word_slots(), inside_index: index < word_slots(), inside_value: value < word_slots(),
    found: t.caps.nth(buf) = Some(cap), within: p.stores(t.layout(), output, buf, index, value, cap, names).Within(t.program),
    tree: ITree<BitVec(64)>(Events::linux()),
    same: env.store_at(buf, index, value).set_word(output,
        byte_word(buffer_byte(env.store_at(buf, index, value).buffers, buf, env.word(index).toNat()))) = other,
    next: t.At(prog_len(p.stores(t.layout(), output, buf, index, value, cap, names)), tree, other)): t.At(prog_len(p), tree, env) {
    let b = p.byte_from(t.layout(), buf, index, value, cap, Succ(names));
    let loaded = t.goes_loads(env.store_at(buf, index, value), other, b, output, buf, index, cap, Succ(names), inside_output, inside_index, found,
        within, tree, same, next);
    t.goes_byte_from(env, p, buf, index, value, cap, names, inside_index, inside_value, found,
        b.loads_within(t.layout(), output, buf, index, cap, Succ(names), t.program, within), tree, loaded)
}

// ---------------------------------------------------------------------------
// A dataflow leaf

// What a leaf computes, as `Env::compute` runs a `Dataflow` region.
fn Env::computes(self env: Env, nodes: List<Node>) → Env {
    let after = run_nodes(nodes, env.valuation(), env.buffers);
    Env(env.words, after.buffers).settle(after.values, nodes_write_ports(nodes))
}

theorem Env::computes_load(self env: Env, output, buf, index: Nat):
    env.set_word(output, byte_word(buffer_byte(env.buffers, buf, env.word(index).toNat()))) = env.computes([BufferLoad(output, buf, index)]) {
    cong_fn<BitVec(64), Env>(λ x => env.set_word(output, x),
        sym(Valuation::set_here(env.valuation(), output, load_value(env.buffers, buf, index, env.valuation()), 64)))
}

theorem Env::computes_store(self env: Env, output, buf, index, value: Nat):
    env.store_at(buf, index, value).set_word(output, byte_word(buffer_byte(env.store_at(buf, index, value).buffers, buf, env.word(index).toNat()))) =
        env.computes([BufferStore(output, buf, index, value)]) {
    let after = env.store_at(buf, index, value);
    cong_fn<BitVec(64), Env>(λ x => after.set_word(output, x),
        sym(Valuation::set_here(env.valuation(), output, load_value(after.buffers, buf, index, env.valuation()), 64)))
}

theorem Prog::within_byte_node(self p: Prog, layout: Layout, names: Nat, c: Compiled): (node: Node) →
    p.byte_node(layout, node, names) = Some(c) → p.Within(c.prog) {
    λ node => match node {
        BufferLoad(output, buf, index) => match words_fit([output, index]) {
            False => λ none => absurd(none),
            True => match layout.capacities.nth(buf) {
                None => λ none => absurd(none),
                Some(cap) => λ same => {
                    let q = p.loads(layout, output, buf, index, cap, names);
                    j(Option::some_inj(Compiled(q, Succ(names)), c, same), λ x _ => p.Within(x.prog),
                        p.loads_within(layout, output, buf, index, cap, names, q, Exists(0, refl)))
                },
            },
        },
        BufferStore(output, buf, index, value) => match words_fit([output, index, value]) {
            False => λ none => absurd(none),
            True => match layout.capacities.nth(buf) {
                None => λ none => absurd(none),
                Some(cap) => λ same => {
                    let q = p.stores(layout, output, buf, index, value, cap, names);
                    j(Option::some_inj(Compiled(q, Succ(Succ(names))), c, same), λ x _ => p.Within(x.prog),
                        p.stores_within(layout, output, buf, index, value, cap, names, q, Exists(0, refl)))
                },
            },
        },
        _ => λ none => absurd(none),
    }
}

// A byte node's code: on with the environment the leaf computes.
theorem Target::goes_byte_node(self t: Target, env: Env, p: Prog, names: Nat, c: Compiled, tree: ITree<BitVec(64)>(Events::linux())): (node: Node) →
    p.byte_node(t.layout(), node, names) = Some(c) → c.prog.Within(t.program) → t.At(prog_len(c.prog), tree, env.computes([node])) →
    t.At(prog_len(p), tree, env) {
    let layout = t.layout();
    λ node => match node {
        BufferLoad(output, buf, index) => (match words_fit([output, index]) as λ b => words_fit([output, index]) = b → (match b {
                False => None,
                True => match layout.capacities.nth(buf) { None => None, Some(cap) => Some(Compiled(p.loads(layout, output, buf, index, cap, names), Succ(names))) },
            }) = Some(c) → c.prog.Within(t.program) → t.At(prog_len(c.prog), tree, env.computes([BufferLoad(output, buf, index)])) → t.At(prog_len(p), tree, env) {
            False => λ _ none => absurd(none),
            True => λ fit => {
                let ok = Bool::is_true_and(word_fits(output), word_fits(index) && True, j(sym(fit), λ v _ => v.IsTrue(), trivial));
                let ok2 = Bool::is_true_and(word_fits(index), True, ok.right);
                (match t.caps.nth(buf) as λ o => t.caps.nth(buf) = o →
                        (match o { None => None, Some(cap) => Some(Compiled(p.loads(layout, output, buf, index, cap, names), Succ(names))) }) = Some(c) →
                        c.prog.Within(t.program) → t.At(prog_len(c.prog), tree, env.computes([BufferLoad(output, buf, index)])) → t.At(prog_len(p), tree, env) {
                    None => λ _ none => absurd(none),
                    Some(cap) => λ found same => j(Option::some_inj(Compiled(p.loads(layout, output, buf, index, cap, names), Succ(names)), c, same),
                        λ x _ => x.prog.Within(t.program) → t.At(prog_len(x.prog), tree, env.computes([BufferLoad(output, buf, index)])) → t.At(prog_len(p), tree, env),
                        λ within next => t.goes_loads(env, env.computes([BufferLoad(output, buf, index)]), p, output, buf, index, cap, names,
                            word_fits_inside(output, ok.left), word_fits_inside(index, ok2.left), found, within, tree, env.computes_load(output, buf, index), next)),
                })(refl)
            },
        })(refl),
        BufferStore(output, buf, index, value) => (match words_fit([output, index, value]) as λ b => words_fit([output, index, value]) = b → (match b {
                False => None,
                True => match layout.capacities.nth(buf) {
                    None => None,
                    Some(cap) => Some(Compiled(p.stores(layout, output, buf, index, value, cap, names), Succ(Succ(names)))),
                },
            }) = Some(c) → c.prog.Within(t.program) → t.At(prog_len(c.prog), tree, env.computes([BufferStore(output, buf, index, value)])) →
            t.At(prog_len(p), tree, env) {
            False => λ _ none => absurd(none),
            True => λ fit => {
                let ok = Bool::is_true_and(word_fits(output), word_fits(index) && (word_fits(value) && True), j(sym(fit), λ v _ => v.IsTrue(), trivial));
                let ok2 = Bool::is_true_and(word_fits(index), word_fits(value) && True, ok.right);
                let ok3 = Bool::is_true_and(word_fits(value), True, ok2.right);
                (match t.caps.nth(buf) as λ o => t.caps.nth(buf) = o →
                        (match o { None => None, Some(cap) => Some(Compiled(p.stores(layout, output, buf, index, value, cap, names), Succ(Succ(names)))) }) = Some(c) →
                        c.prog.Within(t.program) → t.At(prog_len(c.prog), tree, env.computes([BufferStore(output, buf, index, value)])) →
                        t.At(prog_len(p), tree, env) {
                    None => λ _ none => absurd(none),
                    Some(cap) => λ found same => j(Option::some_inj(Compiled(p.stores(layout, output, buf, index, value, cap, names), Succ(Succ(names))), c, same),
                        λ x _ => x.prog.Within(t.program) → t.At(prog_len(x.prog), tree, env.computes([BufferStore(output, buf, index, value)])) →
                            t.At(prog_len(p), tree, env),
                        λ within next => t.goes_stores(env, env.computes([BufferStore(output, buf, index, value)]), p, output, buf, index, value, cap, names,
                            word_fits_inside(output, ok.left), word_fits_inside(index, ok2.left), word_fits_inside(value, ok3.left), found, within, tree,
                            env.computes_store(output, buf, index, value), next)),
                })(refl)
            },
        })(refl),
        _ => λ none => absurd(none),
    }
}

theorem Prog::within_single(self p: Prog, layout: Layout, names: Nat, c: Compiled): (nodes: List<Node>) →
    p.single(layout, nodes, names) = Some(c) → p.Within(c.prog) {
    λ nodes => match nodes {
        Nil => λ none => absurd(none),
        Cons(node, rest) => match rest {
            Nil => p.within_byte_node(layout, names, c, node),
            Cons(_, _) => λ none => absurd(none),
        },
    }
}

theorem Target::goes_single(self t: Target, env: Env, p: Prog, names: Nat, c: Compiled, tree: ITree<BitVec(64)>(Events::linux())): (nodes: List<Node>) →
    p.single(t.layout(), nodes, names) = Some(c) → c.prog.Within(t.program) → t.At(prog_len(c.prog), tree, env.computes(nodes)) →
    t.At(prog_len(p), tree, env) {
    λ nodes => match nodes {
        Nil => λ none => absurd(none),
        Cons(node, rest) => match rest as λ r => p.single(t.layout(), Cons(node, r), names) = Some(c) → c.prog.Within(t.program) →
                t.At(prog_len(c.prog), tree, env.computes(Cons(node, r))) → t.At(prog_len(p), tree, env) {
            Nil => t.goes_byte_node(env, p, names, c, tree, node),
            Cons(_, _) => λ none => absurd(none),
        },
    }
}

// Where a leaf's code starts, within it.
theorem Prog::within_computes(self p: Prog, layout: Layout, nodes: List<Node>, names: Nat, c: Compiled,
    emitted: p.computes(layout, nodes, names) = Some(c)): p.Within(c.prog) {
    (match nodes_pure(nodes) as λ b => (match b {
            True => match p.leaf(layout, nodes) { None => None, Some(q) => Some(Compiled(q, names)) },
            False => p.single(layout, nodes, names),
        }) = Some(c) → p.Within(c.prog) {
        True => (match p.leaf(layout, nodes) as λ o => p.leaf(layout, nodes) = o →
                (match o { None => None, Some(q) => Some(Compiled(q, names)) }) = Some(c) → p.Within(c.prog) {
            None => λ _ none => absurd(none),
            Some(q) => λ leafed same => j(Option::some_inj(Compiled(q, names), c, same), λ x _ => p.Within(x.prog), p.within_leaf(layout, nodes, q, leafed)),
        })(refl),
        False => p.within_single(layout, names, c, nodes),
    })(emitted)
}

// What a leaf's code claims: from its start, on from its end with the
// environment the source computes.
theorem Target::goes_computes(self t: Target, env: Env, p: Prog, nodes: List<Node>, names: Nat, c: Compiled,
    emitted: p.computes(t.layout(), nodes, names) = Some(c), within: c.prog.Within(t.program), tree: ITree<BitVec(64)>(Events::linux()),
    next: t.At(prog_len(c.prog), tree, env.computes(nodes))): t.At(prog_len(p), tree, env) {
    let layout = t.layout();
    (match nodes_pure(nodes) as λ b => nodes_pure(nodes) = b → (match b {
            True => match p.leaf(layout, nodes) { None => None, Some(q) => Some(Compiled(q, names)) },
            False => p.single(layout, nodes, names),
        }) = Some(c) → t.At(prog_len(p), tree, env) {
        True => λ pure => (match p.leaf(layout, nodes) as λ o => p.leaf(layout, nodes) = o →
                (match o { None => None, Some(q) => Some(Compiled(q, names)) }) = Some(c) → t.At(prog_len(p), tree, env) {
            None => λ _ none => absurd(none),
            Some(q) => λ leafed same => {
                let c_is = Option::some_inj(Compiled(q, names), c, same);
                let w_q: q.Within(t.program) = j(sym(c_is), λ x _ => x.prog.Within(t.program), within);
                let next_q: t.At(prog_len(q), tree, env.computes(nodes)) = j(sym(c_is), λ x _ => t.At(prog_len(x.prog), tree, env.computes(nodes)), next);
                let ran = run_nodes_pure(nodes, j(sym(pure), λ v _ => v.IsTrue(), trivial), env.valuation(), env.buffers);
                t.goes_leaf(env, p, q, nodes, leafed, w_q, tree,
                    j(ran, λ s _ => t.At(prog_len(q), tree, Env(env.words, s.buffers).settle(s.values, nodes_write_ports(nodes))), next_q))
            },
        })(refl),
        False => λ _ single => t.goes_single(env, p, names, c, tree, nodes, single, within, next),
    })(refl)(emitted)
}

// ---------------------------------------------------------------------------
// Initial bytes

theorem Prog::within_byte_init(self p: Prog, layout: Layout, buf, i: Nat, c: BitVec(8)): p.Within(p.byte_init(layout, buf, i, c)) {
    let movs: List<Instruction> = [MovRI(Rbx, layout.byte_at(buf, i)), MovRI(Rax, byte_word(c))];
    p.within_step(then(p, Block(movs)), 0, StoreByte(ByteStore(Rbx, Rax)), p.within_then(0, Block(movs)))
}

theorem Prog::within_bytes_init(layout: Layout, buf: Nat, bytes: List<BitVec(8)>): (room, i: Nat) → (p: Prog) →
    p.Within(p.bytes_init(layout, bytes, room, buf, i)) {
    match bytes {
        Nil => λ room i p => p.within_self(),
        Cons(c, rest) => λ room => match room {
            Zero => λ i p => p.within_self(),
            Succ(r) => λ i p => p.within_trans(p.byte_init(layout, buf, i, c), p.byte_init(layout, buf, i, c).bytes_init(layout, rest, r, buf, Succ(i)),
                p.within_byte_init(layout, buf, i, c), Prog::within_bytes_init(layout, buf, rest, r, Succ(i), p.byte_init(layout, buf, i, c))),
        },
    }
}

theorem Prog::within_inits(layout: Layout, buffers: List<Buffer>): (buf: Nat) → (p: Prog) → p.Within(p.inits(layout, buffers, buf)) {
    match buffers {
        Nil => λ buf p => p.within_self(),
        Cons(b, rest) => λ buf p => {
            let filled = p.bytes_init(layout, b.initial, b.capacity, buf, 0);
            p.within_trans(filled, filled.inits(layout, rest, Succ(buf)), Prog::within_bytes_init(layout, buf, b.initial, b.capacity, 0, p),
                Prog::within_inits(layout, rest, Succ(buf), filled))
        },
    }
}

// Byte `c` stored at index `i` of buffer `buf`, inside it.
theorem Target::goes_byte_init(self t: Target, env: Env, p: Prog, buf, cap: Nat, found: t.caps.nth(buf) = Some(cap), i: Nat, below: i < cap,
    c: BitVec(8), within: p.byte_init(t.layout(), buf, i, c).Within(t.program), tree: ITree<BitVec(64)>(Events::linux()),
    next: t.At(prog_len(p.byte_init(t.layout(), buf, i, c)), tree, Env(env.words, store_byte(env.buffers, buf, i, c)))): t.At(prog_len(p), tree, env) {
    let layout = t.layout();
    let o = layout.buffer_offset(buf);
    let movs: List<Instruction> = [MovRI(Rbx, layout.byte_at(buf, i)), MovRI(Rax, byte_word(c))];
    let moved = then(p, Block(movs));
    let store = ByteStore(Rbx, Rax);
    let after = Env(env.words, store_byte(env.buffers, buf, i, c));
    let post = λ (u: MachineState<X86Memory(t.r.profile)>) => t.Placed(after, u.memory);
    let wrote = t.goes_store_byte(moved, 0, store, within, tree, post, next);
    let pre_store = λ (u: MachineState<X86Memory(t.r.profile)>) => (store_base_plain(store.base) = True) ∧
        (t.writes().writable(u.memory, read_gpr(store.base, u.gprs), 1) ∧
        (t.site().Resident(byte_store_after(t.writes(), store, u).memory) ∧ post(byte_store_after(t.writes(), store, u))));
    let blocked = t.goes_block(p, 0, movs, moved.within_before(0, StoreByte(store), t.program, within), tree, pre_store, wrote);
    let ends: (o + cap <= t.r.size) = Nat::le_trans(o + cap, layout.scratch_offset(), t.r.size, layout.buffer_end(buf, cap, found), t.scratch_fits());
    let fits: (o + i + 1 <= t.r.size) = omega(ends, below);
    let at: (layout.byte_at(buf, i) = next_rip(t.r.low, o + i)) = t.at_rip(o + i, omega(fits));
    let byte: (imm_byte0(byte_word(c)) = c) = BitVec::split_concat_low(8, 56, c, BitVec::zero());
    λ s here resident held => {
        let writable = j(sym(at), λ a _ => t.io().writable(s.memory, a, 1), t.writable(s.memory, o + i, 1, fits));
        let kept = j(sym(at), λ a _ => t.site().Resident(t.r.profile.store(s.memory, a, [imm_byte0(byte_word(c))])),
            j(sym(byte), λ x _ => t.site().Resident(t.r.profile.store(s.memory, next_rip(t.r.low, o + i), [x])),
                t.store_resident(s.memory, o + i, [c], fits, resident)));
        let placed = j(sym(at), λ a _ => t.Placed(after, t.r.profile.store(s.memory, a, [imm_byte0(byte_word(c))])),
            j(sym(byte), λ x _ => t.Placed(after, t.r.profile.store(s.memory, next_rip(t.r.low, o + i), [x])),
                t.placed_byte(env, s.memory, held, buf, cap, found, i, below, c)));
        blocked(s, here, resident, ⟨refl, ⟨writable, ⟨kept, placed⟩⟩⟩)
    }
}

// Bytes stored past a buffer's end leave the environment placed as it was.
theorem Target::placed_stored_past(self t: Target, buf, cap: Nat, found: t.caps.nth(buf) = Some(cap), bytes: List<BitVec(8)>):
    (i: Nat) → (env: Env) → (m: X86Memory(t.r.profile)) → cap <= i → t.Placed(env, m) →
    t.Placed(Env(env.words, bytes.stored(buf, i, env.buffers)), m) {
    match bytes {
        Nil => λ i env m past placed => placed,
        Cons(c, rest) => λ i env m past placed =>
            t.placed_stored_past(buf, cap, found, rest, Succ(i), Env(env.words, store_byte(env.buffers, buf, i, c)), m, omega(past), t.placed_past(env, m, placed, buf, cap, found, i, past, c)),
    }
}

// A buffer's initial bytes stored from index `i`, `room` of its capacity
// left: on with them stored, those past the end dropped.
theorem Target::goes_bytes_init(self t: Target, buf, cap: Nat, found: t.caps.nth(buf) = Some(cap), tree: ITree<BitVec(64)>(Events::linux()),
    bytes: List<BitVec(8)>): (room, i: Nat) → (p: Prog) → (env: Env) → i + room = cap →
    p.bytes_init(t.layout(), bytes, room, buf, i).Within(t.program) →
    t.At(prog_len(p.bytes_init(t.layout(), bytes, room, buf, i)), tree, Env(env.words, bytes.stored(buf, i, env.buffers))) →
    t.At(prog_len(p), tree, env) {
    let layout = t.layout();
    match bytes {
        Nil => λ room i p env _ within next => next,
        Cons(c, rest) => λ room => match room {
            Zero => λ i p env sum within next => {
                let stored = Cons(c, rest);
                t.goes_weaken(prog_len(p), tree, λ (u: MachineState<X86Memory(t.r.profile)>) => t.Placed(Env(env.words, stored.stored(buf, i, env.buffers)), u.memory),
                    λ (u: MachineState<X86Memory(t.r.profile)>) => t.Placed(env, u.memory), next,
                    λ u placed => t.placed_stored_past(buf, cap, found, stored, i, env, u.memory, omega(sum), placed))
            },
            Succ(r) => λ i p env sum within next => {
                let one = p.byte_init(layout, buf, i, c);
                let w_one = one.within_trans(one.bytes_init(layout, rest, r, buf, Succ(i)), t.program,
                    Prog::within_bytes_init(layout, buf, rest, r, Succ(i), one), within);
                let rest_goes = t.goes_bytes_init(buf, cap, found, tree, rest, r, Succ(i), one, Env(env.words, store_byte(env.buffers, buf, i, c)), omega(sum), within, next);
                t.goes_byte_init(env, p, buf, cap, found, i, omega(sum), c, w_one, tree, rest_goes)
            },
        },
    }
}

// Every buffer's initial bytes stored, buffer `buf` first, the capacities
// from `buf` on those of `buffers`.
theorem Target::goes_inits(self t: Target, tree: ITree<BitVec(64)>(Events::linux()), buffers: List<Buffer>): (buf: Nat) → (p: Prog) → (env: Env) →
    ((k: Nat) → t.caps.nth(buf + k) = buffers.map(λ (b: Buffer) => b.capacity).nth(k)) →
    p.inits(t.layout(), buffers, buf).Within(t.program) →
    t.At(prog_len(p.inits(t.layout(), buffers, buf)), tree, Env(env.words, initial_stores(buffers, buf, env.buffers))) →
    t.At(prog_len(p), tree, env) {
    let layout = t.layout();
    match buffers {
        Nil => λ buf p env _ within next => next,
        Cons(b, rest) => λ buf p env caps within next => {
            let filled = p.bytes_init(layout, b.initial, b.capacity, buf, 0);
            let w_filled = filled.within_trans(filled.inits(layout, rest, Succ(buf)), t.program, Prog::within_inits(layout, rest, Succ(buf), filled), within);
            let caps_rest = λ (k: Nat) => {
                let shifted: (buf + Succ(k) = Succ(buf) + k) = omega();
                trans(cong_fn<Nat, Option<Nat>>(λ x => t.caps.nth(x), sym(shifted)), caps(Succ(k)))
            };
            let after = Env(env.words, b.initial.stored(buf, 0, env.buffers));
            let rest_goes = t.goes_inits(tree, rest, Succ(buf), filled, after, caps_rest, within, next);
            t.goes_bytes_init(buf, b.capacity, caps(0), tree, b.initial, b.capacity, 0, p, env, omega(), w_filled, rest_goes)
        },
    }
}

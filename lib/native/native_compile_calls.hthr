// The calls a statement makes, compiled (issues/native-effect-source-compiler.md,
// round S3.2): what a read's and a write's code ask Linux, and how each
// answer Linux may give lands in the environment as the source decodes it
// (`CallShape::answer`).
//
// A call's code clamps its operands with CMP and a JB, as the source's
// `min`s do; the lemmas read each clamp as the `min` it computes. A write
// sends its buffer's bytes in place; a read lands in the scratch range and
// is copied into its buffer only when it succeeds.
import native_source;
import native_compile;
import native_compile_facts;
import native_compile_region;
import native_compile_homes;
import native_alloc;
import native_compile_steps;
import native_compile_segments;
import native_compile_claims;
import function_ir_pass;
import function_ir_eval;
import linux_calls;
import linux_trees;
import linux_x86_64_io;
import linux_x86_64_byte_memory;
import linux_x86_64_sim;
import itree;
import x86_64;
import x86_64_block;
import x86_64_data_read;
import x86_64_fetched_code;
import x86_64_store;
import x86_64_byte_memory;
import x86_64_asm;
import x86_64_asm_runs;
import memory;
import bitvec;
import bitvec_nat;
import bool;
import list;
import logic;
import nat;
import option;
import omega;

// ---------------------------------------------------------------------------
// Clamps as `min`

// CMP and a JB: kept where it is below the bound, the bound where not.
theorem BitVec::clamp_kept(v, b: BitVec(64), borrow: v.borrow_sub_bit(b) = True): v.toNat().min(b.toNat()) = v.toNat() {
    let below: (v.toNat() < b.toNat()) = BitVec::borrow_sub_of_bit_true(64, v, b, borrow);
    Nat::min_eq_l(v.toNat(), b.toNat(), Nat::le_of_lt(v.toNat(), b.toNat(), below))
}

theorem BitVec::clamp_bound(v, b: BitVec(64), no: v.borrow_sub_bit(b) = False): v.toNat().min(b.toNat()) = b.toNat() {
    Nat::min_eq_r(v.toNat(), b.toNat(), v.toNat().le_of_not_lt(b.toNat(),
        λ (below: v.toNat() < b.toNat()) => absurd(trans(sym(no), BitVec::borrow_sub_bit_of_borrow(64, v, b, below)))))
}

// A word's number, as the machine reads the word.
theorem Target::word_number(self t: Target, env: Env, m: X86Memory(t.r.profile), placed: t.Placed(env, m), i: Nat, inside: i < t.words):
    env.word(i).toNat() = env.number(i) {
    BitVec::toNat_ofNat(64, env.number(i), t.layout().keeps_number_fits(env, placed.witness, placed.proof.right.left, i, inside))
}

// A number below the canonical boundary is below a word's and a signed
// word's bounds.
theorem canonical_lt_word(n: Nat, below: n <= Nat::pow(2, 47)): n < Nat::pow(2, 64) {
    Nat::le_trans(Succ(n), Succ(Nat::pow(2, 47)), Nat::pow(2, 64), Nat::le_succ_succ(n, Nat::pow(2, 47), below), canonical_below_top())
}

theorem canonical_lt_signed(n: Nat, below: n <= Nat::pow(2, 47)): n < Nat::pow(2, 63) {
    Nat::le_trans(Succ(n), Succ(Nat::pow(2, 47)), Nat::pow(2, 63), Nat::le_succ_succ(n, Nat::pow(2, 47), below),
        Nat::leb_sound(Succ(Nat::pow(2, 47)), Nat::pow(2, 63), trivial))
}

// A number below the canonical boundary as a word.
theorem canonical_word(n: Nat, below: n <= Nat::pow(2, 47)): BitVec::ofNat(n, n := 64).toNat() = n {
    BitVec::toNat_ofNat(64, n, canonical_lt_word(n, below))
}

// ---------------------------------------------------------------------------
// A buffer in place

// A buffer and what lies past it fit below the canonical boundary.
theorem Target::buffer_fits(self t: Target, buf, cap: Nat, found: t.caps.nth(buf) = Some(cap)):
    t.r.low.toNat() + (t.layout().buffer_offset(buf) + cap) <= Nat::pow(2, 47) {
    let bo = t.layout().buffer_offset(buf);
    let inside: (bo + cap <= t.r.size) = Nat::le_trans(bo + cap, t.layout().scratch_offset(), t.r.size, t.layout().buffer_end(buf, cap, found), t.scratch_fits());
    Nat::le_trans(t.r.low.toNat() + (bo + cap), t.r.low.toNat() + t.r.size, Nat::pow(2, 47),
        t.r.low.toNat().add_le_mono_l(bo + cap, t.r.size, inside), t.r.canonical)
}

// A buffer's address, as a number.
theorem Target::buffer_toNat(self t: Target, buf, cap: Nat, found: t.caps.nth(buf) = Some(cap)):
    t.layout().buffer_at(buf).toNat() = t.r.low.toNat() + t.layout().buffer_offset(buf) {
    let bo = t.layout().buffer_offset(buf);
    trans(cong_fn<BitVec(64), Nat>(λ a => a.toNat(), t.buffer_rip(buf)),
        t.r.toNat_at(bo, Nat::le_trans(bo, t.layout().scratch_offset(), t.r.size,
            bo.le_of_add_le(cap, t.layout().scratch_offset(), t.layout().buffer_end(buf, cap, found)), t.scratch_fits())))
}

// An address counted by value is the region's own spelling of it.
theorem Target::cell_address(self t: Target, q: Nat, inside: q <= t.r.size):
    word_of_nat(64, t.r.low.toNat() + q) = next_rip(t.r.low, q) {
    trans(cong_fn<Nat, BitVec(64)>(λ k => word_of_nat(64, k), sym(t.r.toNat_at(q, inside))), word_of_nat_toNat(64, next_rip(t.r.low, q)))
}

// The bytes of a span, as cells of the region.
theorem Target::span_cells(self t: Target, env: Env, v: Nat → BitVec(8), keeps: t.layout().Keeps(env, v), buf, cap: Nat,
    found: t.caps.nth(buf) = Some(cap), from, len: Nat):
    span(env.buffer(buf), from, len) = cells_at(v, t.layout().buffer_offset(buf) + from, len.min(cap - from)) {
    let o = t.layout().buffer_offset(buf);
    trans(cong_fn<List<BitVec(8)>, List<BitVec(8)>>(λ bytes => span(bytes, from, len), keeps.right(buf, cap, found)),
        trans(cong_fn<List<BitVec(8)>, List<BitVec(8)>>(λ bytes => bytes.take(len), cells_drop(v, cap, o, from)),
            cells_take(v, cap - from, o + from, len)))
}

theorem Target::span_len(self t: Target, env: Env, m: X86Memory(t.r.profile), placed: t.Placed(env, m), buf, cap: Nat,
    found: t.caps.nth(buf) = Some(cap), from, len: Nat): span(env.buffer(buf), from, len).len() = len.min(cap - from) {
    trans(cong_fn<List<BitVec(8)>, Nat>(λ bytes => bytes.len(), t.span_cells(env, placed.witness, placed.proof.right.left, buf, cap, found, from, len)),
        cells_len(placed.witness, len.min(cap - from), t.layout().buffer_offset(buf) + from))
}

// A write sends its span from where it sits: from the buffer's address
// past the clamped offset.
theorem Target::writes_from(self t: Target, env: Env, m: X86Memory(t.r.profile), placed: t.Placed(env, m), buf, cap: Nat,
    found: t.caps.nth(buf) = Some(cap), from, len: Nat, base: BitVec(64),
    at: base.toNat() = t.r.low.toNat() + (t.layout().buffer_offset(buf) + from.min(cap))):
    LinuxWritesFrom(t.io(), m, base, span(env.buffer(buf), from, len)) {
    let v = placed.witness;
    let o = t.layout().buffer_offset(buf);
    let k = len.min(cap - from);
    let cells = t.span_cells(env, v, placed.proof.right.left, buf, cap, found, from, len);
    λ i byte got => {
        let found_cell: (cells_at(v, o + from, k).nth(i) = Some(byte)) = j(cells, λ bytes _ => bytes.nth(i) = Some(byte), got);
        let below: (i < k) = j(cells_len(v, k, o + from), λ n _ => i < n, cells_at(v, o + from, k).nth_some_below(i, byte, found_cell));
        let ahead: (from + i < cap) = from.add_lt_of_lt_sub(i, cap, Nat::le_trans(Succ(i), k, cap - from, below, len.min_le_r(cap - from)));
        let clamped: (from.min(cap) = from) = Nat::min_eq_l(from, cap, Nat::le_of_lt(from, cap, from.lt_of_add_lt(i, cap, ahead)));
        let is: (byte = v(o + from + i)) = Option::some_inj(byte, v(o + from + i),
            trans(sym(found_cell), cells_nth(v, k, o + from, i, below)));
        let q = o + from + i;
        let in_buffer: (o + (from + i) < o + cap) = o.add_le_mono_l(Succ(from + i), cap, ahead);
        let inside: (q < t.r.size) = j(sym(o.add_assoc(from, i)), λ x _ => x < t.r.size,
            Nat::le_trans(Succ(o + (from + i)), o + cap, t.r.size, in_buffer,
                Nat::le_trans(o + cap, t.layout().scratch_offset(), t.r.size, t.layout().buffer_end(buf, cap, found), t.scratch_fits())));
        let summed: (base.toNat() + i = t.r.low.toNat() + q) = trans(
            cong_fn<Nat, Nat>(λ x => x + i, trans(at, cong_fn<Nat, Nat>(λ x => t.r.low.toNat() + (o + x), clamped))),
            t.r.low.toNat().add_assoc(o + from, i));
        let address: (word_of_nat(64, base.toNat() + i) = next_rip(t.r.low, q)) = trans(
            cong_fn<Nat, BitVec(64)>(λ n => word_of_nat(64, n), summed), t.cell_address(q, Nat::le_of_lt(q, t.r.size, inside)));
        let cell = t.read_cell(v, m, placed.proof.left, q, inside).right;
        trans(cong_fn<BitVec(64), Option<BitVec(8)>>(λ a => t.r.profile.read(m, a), address),
            trans(cell, cong_fn<BitVec(8), Option<BitVec(8)>>(λ b => Some(b), sym(is))))
    }
}

// A buffer's capacity is below the canonical boundary…
theorem Target::cap_canonical(self t: Target, buf, cap: Nat, found: t.caps.nth(buf) = Some(cap)): cap <= Nat::pow(2, 47) {
    let bo = t.layout().buffer_offset(buf);
    Nat::le_trans(cap, t.r.low.toNat() + (bo + cap), Nat::pow(2, 47),
        Nat::le_trans(cap, bo + cap, t.r.low.toNat() + (bo + cap), bo.le_add_r(cap), t.r.low.toNat().le_add_r(bo + cap)),
        t.buffer_fits(buf, cap, found))
}

// … so a count a word holds.
theorem Target::cap_small(self t: Target, buf, cap: Nat, found: t.caps.nth(buf) = Some(cap)): cap < Nat::pow(2, 64) {
    canonical_lt_word(cap, t.cap_canonical(buf, cap, found))
}

// At the request: RDX the span's length, RSI where it sits, and the span
// no longer than the buffer.
theorem Target::writes_request(self t: Target, env: Env, m: X86Memory(t.r.profile), placed: t.Placed(env, m), buf, cap: Nat,
    found: t.caps.nth(buf) = Some(cap), from, len: Nat, r8, rdx: BitVec(64),
    at_r8: r8.toNat() = from.min(cap), at_rdx: rdx.toNat() = len.min(cap - from.min(cap))):
    (rdx.toNat() = span(env.buffer(buf), from, len).len()) ∧
    (LinuxWritesFrom(t.io(), m, t.layout().buffer_at(buf).add(r8), span(env.buffer(buf), from, len)) ∧
     (span(env.buffer(buf), from, len).len() <= cap)) {
    let layout = t.layout();
    let base = layout.buffer_at(buf).add(r8);
    let fits = t.buffer_fits(buf, cap, found);
    let short: (from.min(cap) <= cap) = from.min_le_r(cap);
    let summed: (base.toNat() = (t.r.low.toNat() + layout.buffer_offset(buf)) + from.min(cap)) =
        add_words(64, layout.buffer_at(buf), r8, t.r.low.toNat() + layout.buffer_offset(buf), from.min(cap),
            t.buffer_toNat(buf, cap, found), at_r8, canonical_lt_word((t.r.low.toNat() + layout.buffer_offset(buf)) + from.min(cap),
                j(sym(t.r.low.toNat().add_assoc(layout.buffer_offset(buf), from.min(cap))), λ x _ => x <= Nat::pow(2, 47),
                    Nat::le_trans(t.r.low.toNat() + (layout.buffer_offset(buf) + from.min(cap)), t.r.low.toNat() + (layout.buffer_offset(buf) + cap),
                        Nat::pow(2, 47), t.r.low.toNat().add_le_mono_l(layout.buffer_offset(buf) + from.min(cap), layout.buffer_offset(buf) + cap,
                            layout.buffer_offset(buf).add_le_mono_l(from.min(cap), cap, short)), fits))));
    let base_at: (base.toNat() = t.r.low.toNat() + (layout.buffer_offset(buf) + from.min(cap))) =
        trans(summed, t.r.low.toNat().add_assoc(layout.buffer_offset(buf), from.min(cap)));
    let long = t.span_len(env, m, placed, buf, cap, found, from, len);
    let counted: (rdx.toNat() = span(env.buffer(buf), from, len).len()) = trans(at_rdx,
        trans(cong_fn<Nat, Nat>(λ x => len.min(x), Nat::sub_min(cap, from)), sym(long)));
    let sent: (span(env.buffer(buf), from, len).len() <= cap) = j(sym(long), λ x _ => x <= cap,
        Nat::le_trans(len.min(cap - from), cap - from, cap, len.min_le_r(cap - from), cap.sub_le(from)));
    ⟨counted, ⟨t.writes_from(env, m, placed, buf, cap, found, from, len, base, base_at), sent⟩⟩
}

// ---------------------------------------------------------------------------
// A window of a buffer

// The part of a buffer of `cap` bytes a read or a write may touch: R8 the
// offset clamped to the capacity, R9 the room past it, RDX the length
// clamped to that room.
fn Fragment::window(at, len, cap, names: Nat) → Fragment {
    Both(Fetch(at, R8), Both(Place(0, Block([MovRI(R9, BitVec::ofNat(cap))])), Both(Fragment::clamp(R8, R9, names),
        Both(Place(0, Block([SubRR(R9, R8)])), Both(Fetch(len, Rdx), Fragment::clamp(Rdx, R9, names + 1))))))
}

// What a window needs: the two words held, and what follows it with the
// offset and the count clamped.
theorem Run::window_before(self r: Run, at, len, cap, names: Nat, post: r.State() → Type, s: r.State(),
    held: r.t.Held(r.live, r.env, s.gprs, s.memory),
    in_at: r.t.layout().word_fits(at).IsTrue(), reads_at: r.env.Reads(r.known, r.live, at),
    in_len: r.t.layout().word_fits(len).IsTrue(), reads_len: r.env.Reads(r.known, r.live, len), small: cap < Nat::pow(2, 64),
    next: (offset, count: BitVec(64)) → offset.toNat() = r.env.number(at).min(cap) → count.toNat() = r.env.number(len).min(cap - r.env.number(at).min(cap)) →
        (f: Flags) → (rip: BitVec(64)) → post(MachineState(write_gpr(Rdx, count, write_gpr(Rbx, r.t.rbx_known(r.known, r.env, len),
            write_gpr(R9, BitVec::ofNat(cap).sub(offset), write_gpr(R8, offset, s.gprs)))), f, rip, s.memory))):
    Fragment::window(at, len, cap, names).before(r, post)(s) {
    let t = r.t;
    let env = r.env;
    let m = s.memory;
    let clamped = env.number(at).min(cap);
    let bound = BitVec::ofNat(cap, n := 64);
    let bound_is: (bound.toNat() = cap) = BitVec::toNat_ofNat(64, cap, small);
    let at_is = t.reads_number(r.live, env, s.gprs, m, held, r.known, at, reads_at, in_at);
    let len_is = t.reads_number(r.live, env, s.gprs, m, held, r.known, len, reads_len, in_len);
    let counted = Both(Place(0, Block([SubRR(R9, R8)])), Both(Fetch(len, Rdx), Fragment::clamp(Rdx, R9, names + 1)));
    let g2 = write_gpr(R9, bound, write_gpr(R8, env.word(at), write_gpr(Rbx, t.rbx_known(r.known, env, at), s.gprs)));
    Fetches(fits := in_at, reads := reads_at, held := held, after := λ f rip =>
    // The offset: the word clamped to the capacity.
    Fragment::clamp_before(r, R8, R9, names, counted.before(r, post), MachineState(g2, f, rip, m), λ offset is_offset f rip => {
        let at_offset: (offset.toNat() = clamped) = trans(is_offset, eq2(λ (x: Nat) (y: Nat) => x.min(y), at_is, bound_is));
        let order: (offset.toNat() <= bound.toNat()) = j(sym(bound_is), λ n _ => offset.toNat() <= n,
            j(sym(at_offset), λ n _ => n <= cap, env.number(at).min_le_r(cap)));
        let room: (bound.sub(offset).toNat() = cap - clamped) = trans(toNat_sub(64, bound, offset, order), eq2(λ (x: Nat) (y: Nat) => x - y, bound_is, at_offset));
        let g4 = write_gpr(Rdx, env.word(len), write_gpr(Rbx, t.rbx_known(r.known, env, len), write_gpr(R9, bound.sub(offset), write_gpr(R8, offset, g2))));
        Fetches(fits := in_len, reads := reads_len, held := held, after := λ f rip =>
        // The count: the length clamped to what is left past the offset.
        Fragment::clamp_before(r, Rdx, R9, names + 1, post, MachineState(g4, f, rip, m), λ count is_count f rip =>
            next(offset, count, at_offset, trans(is_count, eq2(λ (x: Nat) (y: Nat) => x.min(y), len_is, room)), f, rip)))
    }))
}

// ---------------------------------------------------------------------------
// A write

// What a write's code claims: from the statement's start, write(fd, buffer
// + min(from, capacity), min(len, capacity - that)), and on from its end
// with each answer decoded into the environment.
theorem Target::goes_writes(self t: Target, out: List<Nat>, env: Env, p: Prog, known: List<Fact>, knows: env.Knows(known), fd, buf, from, len, result, cap, names: Nat,
    in_fd: t.layout().word_fits(fd).IsTrue(), in_from: t.layout().word_fits(from).IsTrue(), in_len: t.layout().word_fits(len).IsTrue(), in_result: t.layout().word_fits(result).IsTrue(),
    found: t.caps.nth(buf) = Some(cap), apart: t.homes.apart(result, out).IsTrue(),
    within: p.writes(t.layout(), known, out, fd, buf, from, len, result, cap, names).prog.Within(t.program),
    tree: WriteResult → ITree<BitVec(64)>(Events::linux()),
    next: (a: WriteResult) → LinuxCmd::Answers(Writes(fd, buf, from, len, result).cmd(env), a) →
        t.At(prog_len(p.writes(t.layout(), known, out, fd, buf, from, len, result, cap, names).prog), out, tree(a), Writes(fd, buf, from, len, result).answer(env, a))):
    t.At(prog_len(p), live_before(known.unknown([fd, from, len]), result, out), Vis(Writes(fd, buf, from, len, result).cmd(env), tree), env) {
    let ids: List<Nat> = [fd, from, len];
    let r = t.calling(known, out, env, ids, result);
    let reads = λ (id: Nat) (m: Mem(id, ids)) => t.calling_reads(known, out, env, knows, ids, result, id, m);
    let shape = Writes(fd, buf, from, len, result);
    // The request: the buffer's address past the offset, the call's number, the descriptor.
    let request = Both(Place(0, Block([MovRI(Rsi, t.layout().buffer_at(buf)), AddRR(Rsi, R8), MovRI(Rax, BitVec::ofNat(1))])), Fetch(fd, Rdi));
    let code = Both(Fragment::window(from, len, cap, names), request);
    t.goes_weaken(r.goes_asked(code, p, shape, result, in_result, λ i m ne => t.calling_keeps(known, out, env, ids, result, i, m, ne), apart, within, tree, next), λ s held =>
        r.window_before(from, len, cap, names, request.before(r, r.Asks(shape, result)), s, held, in_from, reads(from, Inr(Inl(refl))), in_len, reads(len, Inr(Inr(Inl(refl)))),
            t.cap_small(buf, cap, found), λ offset count at_offset at_count f rip => {
                let wanted = t.writes_request(env.with_words(held.witness), s.memory, held.proof.left, buf, cap, found, env.number(from), env.number(len),
                    offset, count, at_offset, at_count);
                Fetches(fits := in_fd, reads := reads(fd, Inl(refl)), held := held, after := λ f rip => ⟨⟨⟨refl, ⟨refl, ⟨wanted.left, wanted.right.left⟩⟩⟩, trivial⟩,
                    λ resident a => match a {
                        Wrote(wrote) => λ answers junk leaves rcx r11 => ⟨resident, ⟨answers, ⟨held,
                            cong_fn<BitVec(64), Env>(λ w => env.set_word(result, w), word_of_nat_eq_ofNat(64, wrote))⟩⟩⟩,
                        WriteFailed(errno) => λ answers junk leaves rcx r11 => ⟨resident, ⟨answers, ⟨held,
                            cong_fn<BitVec(64), Env>(λ w => env.set_word(result, w), sym(source_errno_word(errno, answers)))⟩⟩⟩,
                    }⟩)
            }))
}

// The buffer's address past an offset inside it.
theorem Target::buffer_past(self t: Target, buf, cap: Nat, found: t.caps.nth(buf) = Some(cap), a: Nat, inside: a <= cap,
    r: BitVec(64), at_r: r.toNat() = a): t.layout().buffer_at(buf).add(r) = next_rip(t.r.low, t.layout().buffer_offset(buf) + a) {
    let layout = t.layout();
    let bo = layout.buffer_offset(buf);
    let low = t.r.low.toNat();
    let fits = t.buffer_fits(buf, cap, found);
    let summed: (layout.buffer_at(buf).add(r).toNat() = (low + bo) + a) = add_words(64, layout.buffer_at(buf), r, low + bo, a,
        t.buffer_toNat(buf, cap, found), at_r, canonical_lt_word((low + bo) + a, omega(fits, inside)));
    let q_in: (bo + a <= t.r.size) = omega(layout.buffer_end(buf, cap, found), t.scratch_fits(), inside);
    trans(sym(word_of_nat_toNat(64, layout.buffer_at(buf).add(r))),
        trans(cong_fn<Nat, BitVec(64)>(λ k => word_of_nat(64, k), trans(summed, low.add_assoc(bo, a))), t.cell_address(bo + a, q_in)))
}

// ---------------------------------------------------------------------------
// A read's bytes copied into their buffer

theorem next_rip_succ(x: BitVec(64), k: Nat): next_rip(x, Succ(k)) = next_rip(x, k).add(BitVec::ofNat(1)) {
    BitVec::iter_add_eq_add(64, next_rip(x, k), BitVec::ofNat(1))
}

// Where the copy has got to: `i` bytes copied from the scratch range into
// the buffer past offset `a`, the cells as they were (`v`) outside those
// copied, the command line kept.
record Copying(t: Target, v: Nat → BitVec(8), buf, a, i: Nat, bytes: List<BitVec(8)>, m: X86Memory(t.r.profile)) {
    cells: Nat → BitVec(8),
    holds: t.r.Holds(cells, m),
    outside: (q: Nat) → ((q < t.layout().buffer_offset(buf) + a) ∨ ((t.layout().buffer_offset(buf) + a) + i <= q)) → cells(q) = v(q),
    inside: (k: Nat) → (c: BitVec(8)) → k < i → bytes.nth(k) = Some(c) → cells((t.layout().buffer_offset(buf) + a) + k) = c,
    stacking: t.Stacking(cells, m),
}

// The loop's invariant at its head: R8 the count copied, RSI and RDI past
// it in the two ranges, RAX the count to copy, the home registers as they
// were (`vals`).
record CopyAt(t: Target, v: Nat → BitVec(8), buf, a: Nat, bytes: List<BitVec(8)>, i: Nat, vals: List<BitVec(64)>, g: Gprs, m: X86Memory(t.r.profile)) {
    within: i <= bytes.len(),
    count: read_gpr(R8, g) = word_of_nat(64, i),
    source: read_gpr(Rsi, g) = next_rip(t.r.low, t.layout().scratch_offset() + i),
    dest: read_gpr(Rdi, g) = next_rip(t.r.low, (t.layout().buffer_offset(buf) + a) + i),
    total: read_gpr(Rax, g) = word_of_nat(64, bytes.len()),
    copying: Copying(t, v, buf, a, i, bytes, m),
    homes: home_values(g) = vals,
}

// What the store and the three adds leave: the invariant one byte further,
// the store allowed and the code still resident.
fn Target::Stored(self t: Target, v: Nat → BitVec(8), buf, a: Nat, bytes: List<BitVec(8)>, i: Nat, vals: List<BitVec(64)>, s: MachineState<X86Memory(t.r.profile)>) → Type {
    (store_base_plain(Rdi) = True) ∧
    (t.writes().writable(s.memory, read_gpr(Rdi, s.gprs), 1) ∧
    (t.site().Resident(byte_store_after(t.writes(), ByteStore(Rdi, Rdx), s).memory) ∧
     CopyAt(t, v, buf, a, bytes, Succ(i), vals,
        execute_block_normal([AddRI8(Rsi, BitVec::ofNat(1)), AddRI8(Rdi, BitVec::ofNat(1)), AddRI8(R8, BitVec::ofNat(1))],
            byte_store_after(t.writes(), ByteStore(Rdi, Rdx), s)).gprs,
        execute_block_normal([AddRI8(Rsi, BitVec::ofNat(1)), AddRI8(Rdi, BitVec::ofNat(1)), AddRI8(R8, BitVec::ofNat(1))],
            byte_store_after(t.writes(), ByteStore(Rdi, Rdx), s)).memory)))
}

// The byte the copy stores lies inside the region.
theorem Target::byte_fits(self t: Target, buf, cap: Nat, found: t.caps.nth(buf) = Some(cap), a: Nat, bytes: List<BitVec(8)>, short: a + bytes.len() <= cap,
    i: Nat, below: i < bytes.len()): ((t.layout().buffer_offset(buf) + a) + i) + 1 <= t.r.size {
    omega(t.layout().buffer_end(buf, cap, found), t.scratch_fits(), short, below)
}

// …and below the RSP slot.
theorem Target::byte_below_stack(self t: Target, buf, cap: Nat, found: t.caps.nth(buf) = Some(cap), a: Nat, bytes: List<BitVec(8)>, short: a + bytes.len() <= cap,
    i: Nat, below: i < bytes.len()): ((t.layout().buffer_offset(buf) + a) + i) + 1 <= t.layout().stack_offset() {
    let ends = t.layout().buffer_end(buf, cap, found);
    let stack: (t.layout().scratch_offset() <= t.layout().stack_offset()) = t.layout().scratch_offset().le_add_l(t.caps.largest() + 1);
    omega(ends, stack, short, below)
}

// The invariant one byte further, over the cells and registers the byte's
// load, store and adds leave.
theorem Target::copy_again(self t: Target, v: Nat → BitVec(8), buf, cap: Nat, found: t.caps.nth(buf) = Some(cap), a: Nat,
    bytes: List<BitVec(8)>, short: a + bytes.len() <= cap,
    landed: (k: Nat) → (c: BitVec(8)) → bytes.nth(k) = Some(c) → v(t.layout().scratch_offset() + k) = c,
    i: Nat, below: i < bytes.len(), vals: List<BitVec(64)>, g: Gprs, f: Flags, rip: BitVec(64), m: X86Memory(t.r.profile),
    at: CopyAt(t, v, buf, a, bytes, i, vals, g, m)):
    CopyAt(t, v, buf, a, bytes, Succ(i), vals, execute_block_normal([AddRI8(Rsi, BitVec::ofNat(1)), AddRI8(Rdi, BitVec::ofNat(1)), AddRI8(R8, BitVec::ofNat(1))],
        MachineState(write_gpr(Rdx, at.copying.cells(t.layout().scratch_offset() + i).zero_extend(56), g), f, rip,
            t.r.profile.store(m, next_rip(t.r.low, (t.layout().buffer_offset(buf) + a) + i), [imm_byte0(at.copying.cells(t.layout().scratch_offset() + i).zero_extend(56))]))).gprs,
        t.r.profile.store(m, next_rip(t.r.low, (t.layout().buffer_offset(buf) + a) + i), [imm_byte0(at.copying.cells(t.layout().scratch_offset() + i).zero_extend(56))])) {
    let layout = t.layout();
    let was = at.copying;
    let w = was.cells;
    let bo = layout.buffer_offset(buf) + a;
    let so = layout.scratch_offset();
    let ends = layout.buffer_end(buf, cap, found);
    let fits = t.scratch_fits();
    let byte = w(so + i);
    let stored_byte = imm_byte0(byte.zero_extend(56));
    let byte_back: (stored_byte = byte) = BitVec::truncate_zero_extend(8, 56, byte);
    let one: List<BitVec(8)> = [stored_byte];
    let fits_one: ((bo + i) + 1 <= t.r.size) = t.byte_fits(buf, cap, found, a, bytes, short, i, below);
    let w2 = t.r.buffer(w).set_span(bo + i, one.to_vector()).cells;
    let from_scratch: (byte = v(so + i)) = was.outside(so + i, Inr(omega(ends, short)));
    CopyAt(within := below,
        count := trans(cong_fn<BitVec(64), BitVec(64)>(λ x => x.add(BitVec::ofNat(1)), at.count), sym(word_of_nat_succ(i))),
        source := trans(cong_fn<BitVec(64), BitVec(64)>(λ x => x.add(BitVec::ofNat(1)), at.source), sym(next_rip_succ(t.r.low, so + i))),
        dest := trans(cong_fn<BitVec(64), BitVec(64)>(λ x => x.add(BitVec::ofNat(1)), at.dest), sym(next_rip_succ(t.r.low, bo + i))),
        total := at.total, homes := at.homes,
        copying := Copying(cells := w2, holds := t.r.store_holds(w, m, was.holds, bo + i, one, fits_one),
            outside := λ q away => trans(t.r.cells_outside(w, bo + i, one, q, match away {
                    Inl(under) => Inl(Nat::le_trans(Succ(q), bo, bo + i, under, bo.le_add_l(i))),
                    Inr(over) => {
                        let past: ((bo + i) + 1 <= q) = over;
                        Inr(past)
                    },
                }), was.outside(q, match away {
                    Inl(under) => Inl(under),
                    Inr(over) => Inr(Nat::le_trans(bo + i, Succ(bo + i), q, Nat::le_succ_r(bo + i, bo + i, (bo + i).le_refl()), over)),
                })),
             inside := λ k c early got => match k.lt_or_ge(i) {
                Inl(before) => trans(t.r.cells_outside(w, bo + i, one, bo + k, Inl(bo.add_le_mono_l(Succ(k), i, before))),
                    was.inside(k, c, before, got)),
                Inr(late) => {
                    let here_k: (i = k) = Nat::le_antisym(i, k, late, Nat::le_of_succ_succ(k, i, early));
                    let got_i: (bytes.nth(i) = Some(c)) = j(sym(here_k), λ x _ => bytes.nth(x) = Some(c), got);
                    let at_i: (w2(bo + i) = c) = trans(t.r.cells_inside(w, bo + i, one, 0, stored_byte, refl),
                        trans(byte_back, trans(from_scratch, landed(i, c, got_i))));
                    j(here_k, λ x _ => w2(bo + x) = c, at_i)
                },
             }, stacking := t.stacking_store(w, m, bo + i, one, t.byte_below_stack(buf, cap, found, a, bytes, short, i, below), was.stacking)))
}

// One byte of the copy: from the invariant with bytes left, the byte the
// load reads, and its store, allowed, leaving the invariant one further.
theorem Target::copy_byte(self t: Target, v: Nat → BitVec(8), buf, cap: Nat, found: t.caps.nth(buf) = Some(cap), a: Nat,
    bytes: List<BitVec(8)>, short: a + bytes.len() <= cap,
    landed: (k: Nat) → (c: BitVec(8)) → bytes.nth(k) = Some(c) → v(t.layout().scratch_offset() + k) = c,
    i: Nat, below: i < bytes.len(), vals: List<BitVec(64)>, u: MachineState<X86Memory(t.r.profile)>, resident: t.site().Resident(u.memory),
    at: CopyAt(t, v, buf, a, bytes, i, vals, u.gprs, u.memory)):
    Exists<BitVec(8)>(λ byte => (read_gpr(Rsi, u.gprs).toNat() < Nat::pow(2, 47)) ∧
        ((t.site().data.read(u.memory, read_gpr(Rsi, u.gprs)) = Some(byte)) ∧
         t.Stored(v, buf, a, bytes, i, vals, byte_load_after(ByteLoad(Rdx, Rsi), byte, u)))) {
    let layout = t.layout();
    let bo = layout.buffer_offset(buf) + a;
    let n_cap: (bytes.len() <= cap) = omega(short);
    let so = layout.scratch_offset();
    let g = u.gprs;
    let m = u.memory;
    let copying = at.copying;
    let w = copying.cells;
    let holds = copying.holds;
    let ends = layout.buffer_end(buf, cap, found);
    let room = layout.scratch_holds(buf, cap, found);
    let fits = t.scratch_fits();
    let sizes: (layout.stack_offset() <= t.r.size) = layout.stack_offset().le_of_add_le(8, t.r.size, t.stack_fits());
    let byte = w(so + i);
    let cell = t.read_cell(w, m, holds, so + i, Nat::le_trans(Succ(so + i), so + cap, t.r.size,
        so.add_le_mono_l(Succ(i), cap, Nat::le_trans(Succ(i), bytes.len(), cap, below, n_cap)),
        Nat::le_trans(so + cap, layout.stack_offset(), t.r.size, room, sizes)));
    let rsi = at.source;
    let rdi = at.dest;
    let one: List<BitVec(8)> = [imm_byte0(byte.zero_extend(56))];
    let g1 = write_gpr(Rdx, byte.zero_extend(56), g);
    let fits_one: ((bo + i) + 1 <= t.r.size) = t.byte_fits(buf, cap, found, a, bytes, short, i, below);
    let rip2 = next_rip(next_rip(u.rip, byte_load_bytes(ByteLoad(Rdx, Rsi)).len()), 3);
    let again = t.copy_again(v, buf, cap, found, a, bytes, short, landed, i, below, vals, g, u.flags, rip2, m, at);
    let target = next_rip(t.r.low, bo + i);
    let landing = λ (x: BitVec(64)) => t.writes().writable(m, x, 1) ∧
        (t.site().Resident(t.r.profile.store(m, x, one)) ∧
         CopyAt(t, v, buf, a, bytes, Succ(i), vals, execute_block_normal([AddRI8(Rsi, BitVec::ofNat(1)), AddRI8(Rdi, BitVec::ofNat(1)), AddRI8(R8, BitVec::ofNat(1))],
                MachineState(g1, u.flags, rip2, t.r.profile.store(m, x, one))).gprs,
            t.r.profile.store(m, x, one)));
    let landed_here: landing(target) = ⟨t.writable(m, bo + i, 1, fits_one), ⟨t.store_resident(m, bo + i, one, fits_one, resident), again⟩⟩;
    let landed_there: landing(read_gpr(Rdi, g)) = j(sym(rdi), λ x _ => landing(x), landed_here);
    Exists(byte, ⟨j(sym(rsi), λ x _ => x.toNat() < Nat::pow(2, 47), cell.left),
        ⟨j(sym(rsi), λ x _ => t.r.profile.read(m, x) = Some(byte), cell.right), ⟨refl, landed_there⟩⟩⟩)
}

// The head with every byte copied: the environment placed with the buffer
// filled from the offset.
theorem Target::copy_filled(self t: Target, env: Env, v: Nat → BitVec(8), keeps: t.layout().Keeps(env, v), same: env.args = t.args, buf, cap: Nat,
    found: t.caps.nth(buf) = Some(cap), a: Nat, bytes: List<BitVec(8)>, short: a + bytes.len() <= cap, i: Nat, all: i = bytes.len(),
    vals: List<BitVec(64)>, g: Gprs, m: X86Memory(t.r.profile), at: CopyAt(t, v, buf, a, bytes, i, vals, g, m)):
    t.Placed(env.set_buffer(buf, fill_at(env.buffer(buf), a, bytes)), m) {
    let copying = at.copying;
    let w = copying.cells;
    Exists(w, ⟨copying.holds, ⟨t.layout().keeps_fill_at(env, v, w, keeps, buf, cap, found, a, bytes, short,
        λ q away => copying.outside(q, match away { Inl(under) => Inl(under), Inr(over) => Inr(j(sym(all), λ x _ => (t.layout().buffer_offset(buf) + a) + x <= q, over)) }),
        λ k c got => copying.inside(k, c, j(sym(all), λ x _ => k < x, bytes.nth_some_below(k, c, got)), got)),
        ⟨same, copying.stacking⟩⟩⟩)
}

// With every byte copied, R8 equals RAX, so the JE is taken.
theorem Target::copy_ends(self t: Target, v: Nat → BitVec(8), buf, a: Nat, bytes: List<BitVec(8)>, i: Nat, all: i = bytes.len(),
    vals: List<BitVec(64)>, g: Gprs, m: X86Memory(t.r.profile), at: CopyAt(t, v, buf, a, bytes, i, vals, g, m), zf: Bool,
    is: zf = is_zero_bits(64, read_gpr(R8, g).sub(read_gpr(Rax, g))), clear: zf = False): False {
    let n = bytes.len();
    let same: (word_of_nat(64, i) = word_of_nat(64, n)) = cong_fn<Nat, BitVec(64)>(λ x => word_of_nat(64, x), all);
    let zero: (is_zero_bits(64, read_gpr(R8, g).sub(read_gpr(Rax, g))) = True) =
        trans(eq2(λ (x: BitVec(64)) (y: BitVec(64)) => is_zero_bits(64, x.sub(y)), trans(at.count, same), at.total),
            zero_bits_sub_self(64, word_of_nat(64, n)));
    absurd(trans(sym(zero), trans(sym(is), clear)))
}

// With bytes left, R8 is not RAX, so the JE falls through.
theorem Target::copy_goes_on(self t: Target, v: Nat → BitVec(8), buf, cap: Nat, found: t.caps.nth(buf) = Some(cap), a: Nat,
    bytes: List<BitVec(8)>, short: a + bytes.len() <= cap, i: Nat, below: i < bytes.len(),
    vals: List<BitVec(64)>, g: Gprs, m: X86Memory(t.r.profile), at: CopyAt(t, v, buf, a, bytes, i, vals, g, m), zf: Bool,
    is: zf = is_zero_bits(64, read_gpr(R8, g).sub(read_gpr(Rax, g))), set: zf = True): False {
    let n = bytes.len();
    let n_cap: (n <= cap) = omega(short);
    let n_small: (n < Nat::pow(2, 64)) = Nat::le_trans(Succ(n), Succ(cap), Nat::pow(2, 64), Nat::le_succ_succ(n, cap, n_cap),
        t.cap_small(buf, cap, found));
    let equal: (read_gpr(R8, g) = read_gpr(Rax, g)) = eq_of_zero_bits_sub(64, read_gpr(R8, g), read_gpr(Rax, g), trans(sym(is), set));
    let words: (word_of_nat(64, i) = word_of_nat(64, n)) = trans(sym(at.count), trans(equal, at.total));
    let counts: (i = n) = trans(sym(toNat_word_of_nat(64, i, Nat::lt_trans(i, n, Nat::pow(2, 64), below, n_small))),
        trans(cong_fn<BitVec(64), Nat>(λ x => x.toNat(), words), toNat_word_of_nat(64, n, n_small)));
    false_elim(Nat::lt_irrefl(n, j(counts, λ x _ => x < n, below)))
}

// The head with every byte copied: the live words held with the buffer
// filled from the offset.
theorem Target::copy_held(self t: Target, live: List<Nat>, env: Env, words: List<Nat>, v: Nat → BitVec(8), keeps: t.layout().Keeps(env.with_words(words), v),
    same: env.args = t.args, vals: List<BitVec(64)>, agrees: t.Agreeing(live, env, words, vals), buf, cap: Nat,
    found: t.caps.nth(buf) = Some(cap), a: Nat, bytes: List<BitVec(8)>, short: a + bytes.len() <= cap, i: Nat, all: i = bytes.len(),
    g: Gprs, m: X86Memory(t.r.profile), at: CopyAt(t, v, buf, a, bytes, i, vals, g, m)):
    t.Held(live, env.set_buffer(buf, fill_at(env.buffer(buf), a, bytes)), g, m) {
    Exists(words, ⟨t.copy_filled(env.with_words(words), v, keeps, same, buf, cap, found, a, bytes, short, i, all, vals, g, m, at),
        j(sym(at.homes), λ vs _ => t.Agreeing(live, env.set_buffer(buf, fill_at(env.buffer(buf), a, bytes)), words, vs), agrees)⟩)
}

// What follows a read's SYSCALL, after the TEST of its result: out where it
// failed, otherwise the walks set (RDI past the offset in R9)…
fn Fragment::copy_enter(layout: Layout, buf, out: Nat) → Fragment {
    Both(Leave(S, out), Place(0, Block([MovRI(R8, BitVec::ofNat(0)), MovRI(Rsi, layout.scratch_at()), MovRI(Rdi, layout.buffer_at(buf)), AddRR(Rdi, R9)])))
}

// …and a round of the copy: out at the count, otherwise the byte loaded
// and stored, and the count, RSI and RDI one further.
fn Fragment::copy_in(out: Nat) → Fragment {
    Both(Place(0, Block([CmpRR(R8, Rax)])), Both(Leave(E, out),
    Both(Place(0, LoadByte(ByteLoad(Rdx, Rsi))), Both(Place(0, StoreByte(ByteStore(Rdi, Rdx))),
         Place(0, Block([AddRI8(Rsi, BitVec::ofNat(1)), AddRI8(Rdi, BitVec::ofNat(1)), AddRI8(R8, BitVec::ofNat(1))]))))))
}

fn Fragment::read_back(layout: Layout, buf, names: Nat) → Fragment {
    Cycle(names + 2, Fragment::copy_enter(layout, buf, names + 4), Fragment::copy_in(names + 4))
}

// A read's code after its SYSCALL: the TEST, the copy, the result kept.
fn Prog::read_back(self asked: Prog, layout: Layout, out: List<Nat>, buf, result, names: Nat) → Prog {
    Both(Both(Place(0, Block([TestRR(Rax, Rax)])), Fragment::read_back(layout, buf, names)), Keep(result, Rax)).onto(Emission(layout, [], out), asked)
}

// What a round needs is the invariant: with `i` bytes copied and `n` to go
// it leaves with the buffer filled from the offset and RAX the count, or
// comes round with one more.
theorem Run::copy_round(self r: Run, words: List<Nat>, v: Nat → BitVec(8), keeps: r.t.layout().Keeps(r.env.with_words(words), v), same: r.env.args = r.t.args,
    vals: List<BitVec(64)>, agrees: r.t.Agreeing(r.live, r.env, words, vals), buf, cap: Nat, found: r.t.caps.nth(buf) = Some(cap), a: Nat,
    bytes: List<BitVec(8)>, short: a + bytes.len() <= cap,
    landed: (k: Nat) → (c: BitVec(8)) → bytes.nth(k) = Some(c) → v(r.t.layout().scratch_offset() + k) = c,
    o, n: Nat, s: r.State(), resident: r.t.site().Resident(s.memory), i: Nat, left: i + n = bytes.len(),
    at: CopyAt(r.t, v, buf, a, bytes, i, vals, s.gprs, s.memory)):
    Fragment::copy_in(Succ(o)).inside(r, λ _ _ _ _ => False, Some(o),
        λ u => r.t.Held(r.live, r.env.set_buffer(buf, fill_at(r.env.buffer(buf), a, bytes)), u.gprs, u.memory) ∧ (read_gpr(Rax, u.gprs) = word_of_nat(64, bytes.len())),
        λ u => Exists<Nat>(λ k => (k < n) ∧ Exists<Nat>(λ i2 => (i2 + k = bytes.len()) ∧ CopyAt(r.t, v, buf, a, bytes, i2, vals, u.gprs, u.memory))))(s) {
    let t = r.t;
    let g = s.gprs;
    let m = s.memory;
    let zf = is_zero_bits(64, read_gpr(R8, g).sub(read_gpr(Rax, g)));
    let compared = execute_block_normal([CmpRR(R8, Rax)], s);
    Leaves(out := refl,
        // At the count: every byte is copied.
        taken := λ at_count rip => match i.lt_or_ge(bytes.len()) {
            Inl(below) => false_elim(t.copy_goes_on(v, buf, cap, found, a, bytes, short, i, below, vals, g, m, at, zf, refl, at_count)),
            Inr(over) => ⟨t.copy_held(r.live, r.env, words, v, keeps, same, vals, agrees, buf, cap, found, a, bytes, short, i,
                Nat::le_antisym(i, bytes.len(), at.within, over), g, m, at), at.total⟩,
        },
        // Otherwise one byte, and one further.
        straight := λ before_count rip => match i.lt_or_ge(bytes.len()) {
            Inr(over) => false_elim(t.copy_ends(v, buf, a, bytes, i, Nat::le_antisym(i, bytes.len(), at.within, over), vals, g, m, at, zf, refl, before_count)),
            Inl(below) => {
                let fewer = Nat::one_fewer(i, n, bytes.len(), left, below);
                let byte = t.copy_byte(v, buf, cap, found, a, bytes, short, landed, i, below, vals, MachineState(g, compared.flags, rip, m), resident, at);
                let stored = byte.proof.right.right;
                LoadsByte(byte := byte.witness, low := byte.proof.left, read := byte.proof.right.left, after :=
                    StoresByte(plain := stored.left, writable := stored.right.left, resident := stored.right.right.left, after :=
                        Exists(fewer.witness, ⟨fewer.proof.left, Exists(Succ(i), ⟨fewer.proof.right, stored.right.right.right⟩)⟩)))
            },
        },
        defined := refl)
}

// ---------------------------------------------------------------------------
// A read

// The environment placed, and a read's bytes landed in the scratch range.
fn Target::Landed(self t: Target, env: Env, bytes: List<BitVec(8)>, m: X86Memory(t.r.profile)) → Type {
    Exists<Nat → BitVec(8)>(λ v => t.r.Holds(v, m) ∧ (t.layout().Keeps(env, v) ∧ (t.Stacked(env, v, m) ∧
        ((k: Nat) → (c: BitVec(8)) → bytes.nth(k) = Some(c) → v(t.layout().scratch_offset() + k) = c))))
}

theorem Target::landed_placed(self t: Target, env: Env, bytes: List<BitVec(8)>, m: X86Memory(t.r.profile), landed: t.Landed(env, bytes, m)):
    t.Placed(env, m) {
    Exists(landed.witness, ⟨landed.proof.left, ⟨landed.proof.right.left, landed.proof.right.right.left⟩⟩)
}

// Bytes stored to the scratch range land there and keep the environment.
theorem Target::landed_store(self t: Target, env: Env, m: X86Memory(t.r.profile), placed: t.Placed(env, m), bytes: List<BitVec(8)>,
    short: bytes.len() <= t.caps.largest()): t.Landed(env, bytes, t.r.profile.store(m, t.layout().scratch_at(), bytes)) {
    let v = placed.witness;
    let so = t.layout().scratch_offset();
    let sizes: (so + t.caps.largest() <= t.r.size) = t.scratch_room();
    let fits: (so + bytes.len() <= t.r.size) = Nat::le_trans(so + bytes.len(), so + t.caps.largest(), t.r.size,
        so.add_le_mono_l(bytes.len(), t.caps.largest(), short), sizes);
    let below: (so + bytes.len() <= t.layout().stack_offset()) = Nat::le_trans(so + bytes.len(), so + t.caps.largest(), t.layout().stack_offset(),
        so.add_le_mono_l(bytes.len(), t.caps.largest(), short), t.layout().scratch_below_stack());
    j(sym(t.scratch_rip()), λ x _ => t.Landed(env, bytes, t.r.profile.store(m, x, bytes)),
        Exists(t.r.buffer(v).set_span(so, bytes.to_vector()).cells, ⟨t.r.store_holds(v, m, placed.proof.left, so, bytes, fits),
            ⟨t.layout().keeps_agree(env, v, t.r.buffer(v).set_span(so, bytes.to_vector()).cells, placed.proof.right.left,
                λ q away => t.r.cells_outside(v, so, bytes, q, match away {
                    Inl(under) => Inl(under),
                    Inr(over) => Inr(omega(over, below, t.layout().stack_below_size())),
                })),
             ⟨t.stacked_store(env, v, m, so, bytes, below, placed.proof.right.right),
              λ k c got => t.r.cells_inside(v, so, bytes, k, c, got)⟩⟩⟩))
}

// The live words held, and a read's bytes landed in the scratch range.
fn Target::HeldLanded(self t: Target, live: List<Nat>, env: Env, bytes: List<BitVec(8)>, g: Gprs, m: X86Memory(t.r.profile)) → Type {
    Exists<List<Nat>>(λ words => t.Landed(env.with_words(words), bytes, m) ∧ t.Agreeing(live, env, words, home_values(g)))
}

// After a read that succeeded: TEST finds the count nonnegative, the bytes
// are copied in from the offset in R9, and the count is put in the
// result's home.
theorem Target::goes_read_back_ok(self t: Target, live, out: List<Nat>, env: Env, asked: Prog, buf, cap: Nat, found: t.caps.nth(buf) = Some(cap),
    a, result: Nat, in_result: t.layout().word_fits(result).IsTrue(), names: Nat,
    sub: (i: Nat) → Mem(i, out) → i ≠ result → Mem(i, live), apart: t.homes.apart(result, out).IsTrue(),
    within: asked.read_back(t.layout(), out, buf, result, names).Within(t.program),
    bytes: List<BitVec(8)>, short: a + bytes.len() <= cap, tree: ITree<BitVec(64)>(Events::linux()),
    next: t.At(prog_len(asked.read_back(t.layout(), out, buf, result, names)), out, tree,
        env.set_buffer(buf, fill_at(env.buffer(buf), a, bytes)).set_word(result, count_word(bytes.len())))):
    t.GoesR(prog_len(asked), tree, λ (g: Gprs) (m: X86Memory(t.r.profile)) =>
        t.HeldLanded(live, env, bytes, g, m) ∧ ((read_gpr(Rax, g) = word_of_nat(64, bytes.len())) ∧ (read_gpr(R9, g).toNat() = a))) {
    let layout = t.layout();
    let n = bytes.len();
    let r = Run(t, [], out, live, env);
    let tested = then(asked, Block([TestRR(Rax, Rax)]));
    let back = Fragment::read_back(layout, buf, names);
    let labelled = back.onto(r.cx(), tested);
    let w_labelled = labelled.word_from_within(layout, out, result, Rax, t.program, within);
    let w_tested: tested.Within(t.program) = Prog::within_trans(back.extends(r.cx(), tested), w_labelled);
    let n_cap: (n <= cap) = omega(short);
    let a_cap: (a <= cap) = omega(short);
    let canonical: (n <= Nat::pow(2, 47)) = Nat::le_trans(n, cap, Nat::pow(2, 47), n_cap, t.cap_canonical(buf, cap, found));
    let small: (n < Nat::pow(2, 63)) = canonical_lt_signed(n, canonical);
    let n_small: (n < Nat::pow(2, 64)) = canonical_lt_word(n, canonical);
    let filled = env.set_buffer(buf, fill_at(env.buffer(buf), a, bytes));
    // The count put in the result's home.
    let stored = t.goes_result(live, out, filled, filled.set_word(result, count_word(n)), labelled, result, in_result, sub, apart, within, tree, next);
    let copied: r.State() → Type = λ s => t.Held(live, filled, s.gprs, s.memory) ∧ (read_gpr(Rax, s.gprs) = word_of_nat(64, n));
    let at_done: t.Goes(prog_len(labelled), tree, copied) = t.goes_weaken(stored,
        λ s held => ⟨held.left, trans(cong_fn<BitVec(64), Env>(λ w => filled.set_word(result, w), held.right),
            cong_fn<BitVec(64), Env>(λ w => filled.set_word(result, w), word_of_nat_eq_ofNat(64, n)))⟩);
    λ u here resident held => {
        let kept = held.left;
        let landed = kept.proof.left;
        let words = kept.witness;
        let v = landed.witness;
        let vals = home_values(u.gprs);
        // The copy: `i` bytes copied and `k` to go, round its loop.
        let copying: Nat → Gprs → X86Memory(t.r.profile) → Type = λ k g m => Exists<Nat>(λ i => (i + k = n) ∧ CopyAt(t, v, buf, a, bytes, i, vals, g, m));
        let enter = Fragment::copy_enter(layout, buf, names + 4);
        let looped = Fragment::goes_loop(r, tested, names + 2, enter, Fragment::copy_in(names + 4), tree, copied, copying, w_labelled, at_done,
            λ k s resident2 at => r.copy_round(words, v, landed.proof.right.left, landed.proof.right.right.left.left, vals, kept.proof.right, buf, cap, found, a, bytes, short,
                landed.proof.right.right.right, names + 3, k, s, resident2, at.witness, at.proof.left, at.proof.right));
        let rax = held.right.left;
        let value: (read_gpr(Rax, u.gprs).toNat() = n) = trans(cong_fn<BitVec(64), Nat>(λ x => x.toNat(), rax), toNat_word_of_nat(64, n, n_small));
        let clear = test_self_nonnegative(read_gpr(Rax, u.gprs), j(sym(value), λ x _ => x < Nat::pow(2, 63), small));
        // The TEST finds the count nonnegative, so the JS falls through to the walks set with nothing copied.
        t.goes_block(asked, 0, [TestRR(Rax, Rax)], w_tested, tree,
            enter.inside(r, λ _ => copying, Some(names + 3), copied, λ w => Exists<Nat>(λ k => copying(k, w.gprs, w.memory))), looped)(u, here, resident,
            Leaves(out := refl, taken := λ negative rip => absurd(trans(sym(clear), negative)),
                straight := λ fine rip => Exists(n, Exists(0, ⟨n.add_left_zero(),
                    CopyAt(within := trivial, count := refl, source := t.scratch_rip(),
                        dest := t.buffer_past(buf, cap, found, a, a_cap, read_gpr(R9, u.gprs), held.right.right), total := rax, homes := refl,
                        copying := Copying(cells := v, holds := landed.proof.left, outside := λ q _ => refl,
                            inside := λ k c early _ => false_elim(k.not_succ_le_zero(early)), stacking := landed.proof.right.right.left.right))⟩)), defined := refl))
    }
}

// After a read that failed: TEST finds the negated errno negative, the JS
// skips the copy, and the errno is put in the result's home.
theorem Target::goes_read_back_failed(self t: Target, live, out: List<Nat>, env: Env, asked: Prog, buf, result: Nat, in_result: t.layout().word_fits(result).IsTrue(), names: Nat,
    sub: (i: Nat) → Mem(i, out) → i ≠ result → Mem(i, live), apart: t.homes.apart(result, out).IsTrue(),
    within: asked.read_back(t.layout(), out, buf, result, names).Within(t.program),
    e: Nat, error: Errno(e), tree: ITree<BitVec(64)>(Events::linux()),
    next: t.At(prog_len(asked.read_back(t.layout(), out, buf, result, names)), out, tree, env.set_word(result, native_source::errno_word(e)))):
    t.GoesR(prog_len(asked), tree, λ (g: Gprs) (m: X86Memory(t.r.profile)) =>
        t.Held(live, env, g, m) ∧ (read_gpr(Rax, g) = linux_x86_64_io::errno_word(e))) {
    let layout = t.layout();
    let r = Run(t, [], out, live, env);
    let tested = then(asked, Block([TestRR(Rax, Rax)]));
    let back = Fragment::read_back(layout, buf, names);
    let labelled = back.onto(r.cx(), tested);
    let w_labelled = labelled.word_from_within(layout, out, result, Rax, t.program, within);
    let w_tested: tested.Within(t.program) = Prog::within_trans(back.extends(r.cx(), tested), w_labelled);
    let word = linux_x86_64_io::errno_word(e);
    let other = env.set_word(result, native_source::errno_word(e));
    let stored = t.goes_result(live, out, env, other, labelled, result, in_result, sub, apart, within, tree, next);
    let skipped: r.State() → Type = λ s => t.Held(live, env, s.gprs, s.memory) ∧ (env.set_word(result, read_gpr(Rax, s.gprs)) = other);
    // The copy is never entered.
    let never: Nat → Gprs → X86Memory(t.r.profile) → Type = λ _ _ _ => False;
    let enter = Fragment::copy_enter(layout, buf, names + 4);
    let looped = Fragment::goes_loop(r, tested, names + 2, enter, Fragment::copy_in(names + 4), tree, skipped, never, w_labelled, stored,
        λ k s resident at => false_elim(at));
    // The TEST finds the negated errno negative, so the JS is taken.
    t.goes_weaken(t.goes_block(asked, 0, [TestRR(Rax, Rax)], w_tested, tree,
            enter.inside(r, λ _ => never, Some(names + 3), skipped, λ w => Exists<Nat>(λ k => never(k, w.gprs, w.memory))), looped),
        λ u held => {
            let set = test_self_negative(read_gpr(Rax, u.gprs), j(sym(held.right), λ x _ => Nat::pow(2, 63) <= x.toNat(), errno_negative(e, error)));
            Leaves(out := refl, taken := λ negative rip => ⟨held.left, trans(cong_fn<BitVec(64), Env>(λ w => env.set_word(result, w), held.right),
                    cong_fn<BitVec(64), Env>(λ w => env.set_word(result, w), sym(source_errno_word(e, error))))⟩,
                straight := λ fine rip => absurd(trans(sym(set), fine)), defined := refl)
        })
}

// A read asks for at most what its buffer holds past the offset, which is
// its capacity less the offset clamped to it, so the bytes it lands end
// inside the buffer.
theorem Target::reads_most(self t: Target, env: Env, m: X86Memory(t.r.profile), placed: t.Placed(env, m), buf, cap: Nat,
    found: t.caps.nth(buf) = Some(cap), at, n: Nat):
    (n.min(env.buffer(buf).len() - at) = n.min(cap - at.min(cap))) ∧ (at.min(cap) + n.min(env.buffer(buf).len() - at) <= cap) {
    let buffer_len = t.layout().keeps_buffer_len(env, placed.witness, placed.proof.right.left, buf, cap, found);
    let asked: (n.min(env.buffer(buf).len() - at) = n.min(cap - at.min(cap))) = trans(cong_fn<Nat, Nat>(λ x => n.min(x - at), buffer_len),
        cong_fn<Nat, Nat>(λ x => n.min(x), sym(Nat::sub_min(cap, at))));
    let clamped = at.min(cap);
    let within: (clamped + n.min(cap - clamped) <= cap) = omega(n.min_le_r(cap - clamped), at.min_le_r(cap));
    ⟨asked, j(sym(asked), λ x _ => clamped + x <= cap, within)⟩
}

// A count within a buffer's capacity fits the scratch range.
theorem Target::under_largest(self t: Target, buf, cap: Nat, found: t.caps.nth(buf) = Some(cap), k, n: Nat,
    le: k <= n, below: n <= cap): k <= t.caps.largest() {
    Nat::le_trans(k, cap, t.caps.largest(), Nat::le_trans(k, n, cap, le, below), t.caps.largest_nth(buf, cap, found))
}

// And what the scratch range holds lies inside the region.
theorem Target::scratch_inside(self t: Target, k: Nat, short: k <= t.caps.largest()): t.layout().scratch_offset() + k <= t.r.size {
    let sizes: (t.layout().scratch_offset() + t.caps.largest() <= t.r.size) = t.scratch_room();
    Nat::le_trans(t.layout().scratch_offset() + k, t.layout().scratch_offset() + t.caps.largest(), t.r.size,
        t.layout().scratch_offset().add_le_mono_l(k, t.caps.largest(), short), sizes)
}

// What a read's code claims: from the statement's start, read(fd, scratch,
// min(len, capacity - min(at, capacity))), and on from its end with each
// answer decoded into the environment.
theorem Target::goes_reads(self t: Target, out: List<Nat>, env: Env, p: Prog, known: List<Fact>, knows: env.Knows(known), fd, buf, at, len, result, cap, names: Nat,
    in_fd: t.layout().word_fits(fd).IsTrue(), in_at: t.layout().word_fits(at).IsTrue(), in_len: t.layout().word_fits(len).IsTrue(), in_result: t.layout().word_fits(result).IsTrue(),
    found: t.caps.nth(buf) = Some(cap), apart: t.homes.apart(result, out).IsTrue(),
    within: p.reads(t.layout(), known, out, fd, buf, at, len, result, cap, names).prog.Within(t.program),
    tree: ReadResult → ITree<BitVec(64)>(Events::linux()),
    next: (a: ReadResult) → LinuxCmd::Answers(Reads(fd, buf, at, len, result).cmd(env), a) →
        t.At(prog_len(p.reads(t.layout(), known, out, fd, buf, at, len, result, cap, names).prog), out, tree(a), Reads(fd, buf, at, len, result).answer(env, a))):
    t.At(prog_len(p), live_before(known.unknown([fd, at, len]), result, out), Vis(Reads(fd, buf, at, len, result).cmd(env), tree), env) {
    let layout = t.layout();
    let ids: List<Nat> = [fd, at, len];
    let r = t.calling(known, out, env, ids, result);
    let live = r.live;
    let reads = λ (id: Nat) (m: Mem(id, ids)) => t.calling_reads(known, out, env, knows, ids, result, id, m);
    let sub = λ (i: Nat) (m: Mem(i, out)) (ne: i ≠ result) => t.calling_keeps(known, out, env, ids, result, i, m, ne);
    let shape = Reads(fd, buf, at, len, result);
    let c = shape.cmd(env);
    let clamped = env.number(at).min(cap);
    let most = env.number(len).min(env.buffer(buf).len() - env.number(at));
    // The request: the offset kept in R9, the scratch range, the call's number, the descriptor.
    let request = Both(Place(0, Block([MovRR(R9, R8), MovRI(Rsi, layout.scratch_at()), MovRI(Rax, BitVec::ofNat(0))])), Fetch(fd, Rdi));
    let code = Both(Fragment::window(at, len, cap, names), request);
    let ready = code.onto(r.cx(), p);
    let asked = then(ready, Syscall);
    let back = Both(Place(0, Block([TestRR(Rax, Rax)])), Fragment::read_back(layout, buf, names));
    let labelled = back.onto(r.cx(), asked);
    let w_labelled = labelled.word_from_within(layout, out, result, Rax, t.program, within);
    let w_asked: asked.Within(t.program) = Prog::within_trans(back.extends(r.cx(), asked), w_labelled);
    // The SYSCALL, each answer on from where it leaves the machine: R9
    // still the clamped offset.
    let after: ReadResult → MachineState<X86Memory(t.r.profile)> → Type = λ a u => LinuxCmd::Answers(c, a) ∧ match a as λ _ => Type {
        ReadBytes(bytes) => t.HeldLanded(live, env, bytes, u.gprs, u.memory) ∧
            ((read_gpr(Rax, u.gprs) = word_of_nat(64, bytes.len())) ∧ (read_gpr(R9, u.gprs).toNat() = clamped)),
        ReadFailed(e) => t.Held(live, env, u.gprs, u.memory) ∧ (read_gpr(Rax, u.gprs) = linux_x86_64_io::errno_word(e)),
    };
    let called = t.io().goes_call(t.program, t.origin, t.code_fits(), w_asked.witness, ready, 0, w_asked.proof, c, tree, after,
        λ a => match a {
            ReadBytes(bytes) => λ u here resident held => {
                let kept = held.right.left;
                let placed = t.landed_placed(env.with_words(kept.witness), bytes, u.memory, kept.proof.left);
                let most_is = t.reads_most(env.with_words(kept.witness), u.memory, placed, buf, cap, found, env.number(at), env.number(len));
                let short: (clamped + bytes.len() <= cap) = Nat::le_trans(clamped + bytes.len(), clamped + most, cap,
                    clamped.add_le_mono_l(bytes.len(), most, held.left), most_is.right);
                let buffer_len: (env.buffer(buf).len() = cap) =
                    layout.keeps_buffer_len(env.with_words(kept.witness), placed.witness, placed.proof.right.left, buf, cap, found);
                let lands: (fill_at(env.buffer(buf), env.number(at), bytes) = fill_at(env.buffer(buf), clamped, bytes)) =
                    trans(fill_at_within(env.buffer(buf), bytes, env.number(at)),
                        cong_fn<Nat, List<BitVec(8)>>(λ k => fill_at(env.buffer(buf), env.number(at).min(k), bytes), buffer_len));
                t.goes_read_back_ok(live, out, env, asked, buf, cap, found, clamped, result, in_result, names, sub, apart, within, bytes, short, tree(ReadBytes(bytes)),
                    j(lands, λ x _ => t.At(prog_len(asked.read_back(layout, out, buf, result, names)), out, tree(ReadBytes(bytes)),
                        env.set_buffer(buf, x).set_word(result, count_word(bytes.len()))), next(ReadBytes(bytes), held.left)),
                    u, here, resident, held.right)
            },
            ReadFailed(e) => λ u here resident held => t.goes_read_back_failed(live, out, env, asked, buf, result, in_result, names, sub, apart, within, e, held.left,
                tree(ReadFailed(e)), next(ReadFailed(e), held.left), u, here, resident, held.right),
        });
    let call_pre = λ (s: MachineState<X86Memory(t.r.profile)>) => LinuxRequests(t.io(), s, c) ∧
        (t.site().Resident(s.memory) → (a: ReadResult) → LinuxCmd::Answers(c, a) → LinuxResumes(t.io(), s, c, a, λ u =>
            t.site().Resident(u.memory) ∧ after(a, u)));
    t.goes_weaken(code.goes(r, p, ready.within_before(0, Syscall, t.program, w_asked), Vis(c, tree), call_pre, called), λ s held =>
        r.window_before(at, len, cap, names, request.before(r, call_pre), s, held, in_at, reads(at, Inr(Inl(refl))), in_len, reads(len, Inr(Inr(Inl(refl)))),
            t.cap_small(buf, cap, found), λ offset count at_offset at_count f rip => {
            let m = s.memory;
            let kept = held;
            let words = kept.witness;
            let placed = kept.proof.left;
            let so = layout.scratch_offset();
            let most_is = t.reads_most(env.with_words(words), m, placed, buf, cap, found, env.number(at), env.number(len));
            let most_cap: (most <= cap) = Nat::le_trans(most, clamped + most, cap, clamped.le_add_r(most), most_is.right);
            let asks = trans(at_count, sym(most_is.left));
            let to = sym(t.scratch_rip());
            let resides = λ (bytes: List<BitVec(8)>) (fits: so + bytes.len() <= t.r.size) (resident: t.site().Resident(m)) =>
                j(to, λ x _ => t.site().Resident(t.r.profile.store(m, x, bytes)), t.store_resident(m, so, bytes, fits, resident));
            let room_at = j(to, λ x _ => t.io().writable(m, x, most),
                t.writable(m, so, most, t.scratch_inside(most, t.under_largest(buf, cap, found, most, most, most.le_refl(), most_cap))));
            Fetches(fits := in_fd, reads := reads(fd, Inl(refl)), held := held, after := λ f rip => ⟨⟨⟨refl, ⟨refl, asks⟩⟩, room_at⟩,
                λ resident a => match a {
                    ReadBytes(bytes) => λ answers junk leaves rcx r11 => {
                        let short = t.under_largest(buf, cap, found, bytes.len(), most, answers, most_cap);
                        ⟨resides(bytes, t.scratch_inside(bytes.len(), short), resident),
                            ⟨answers, ⟨Exists(words, ⟨t.landed_store(env.with_words(words), m, placed, bytes, short), kept.proof.right⟩), ⟨refl, at_offset⟩⟩⟩⟩
                    },
                    ReadFailed(_) => λ answers junk leaves rcx r11 => {
                        let short = t.under_largest(buf, cap, found, junk.len(), most, leaves, most_cap);
                        ⟨resides(junk, t.scratch_inside(junk.len(), short), resident),
                            ⟨answers, ⟨Exists(words, ⟨t.landed_placed(env.with_words(words), junk, t.r.profile.store(m, layout.scratch_at(), junk),
                                t.landed_store(env.with_words(words), m, placed, junk, short)), kept.proof.right⟩), refl⟩⟩⟩
                    },
                }⟩)
        }))
}

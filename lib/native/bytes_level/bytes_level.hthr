// The bytes level (docs/language/ownership-design.md §17.2, §17.3;
// issues/bytes-level-language.md): FunctionIR's word operations beside
// memory reached through references, one meaning, and validity by kinds.
//
// - A value is a word or a reference (reference_cells' `Value`: a block and
//   a byte offset); a length is a word beside a reference. A function's ids
//   hold its values (`Locals`): its words in a FunctionIR valuation, so the
//   word operations run as FunctionIR's evaluator runs them, and its
//   references beside them. An id that was never given a reference holds
//   none, and reading one there has no meaning.
// - Nodes (`Instr`): a FunctionIR node that touches no buffer (`Compute`),
//   and through a reference a load and a store of 1, 2, 4 or 8 bytes, a
//   load and a store of a reference, an offset, and a typed range copy. No
//   node names a buffer by number. Each memory node is one of
//   bytes_memory's operations, so where it answers is that operation's
//   site fact.
// - Regions (`Body`): a leaf of nodes, a sequence, a branch on a one-bit
//   word, a call, and a loop of at most `bound` passes, FunctionIR's
//   structured shapes (function_ir's `StructuredRegion`, whose lowering
//   the bytes level's will reuse; the issue's log has the reading). A loop
//   pass runs on ids of its own, given its state and the passes left, as
//   FunctionIR's does.
// - One meaning: `run(p, f, args, heap)` answers `Some(Answer(words,
//   heap))` or nothing, nothing covering both "not defined" and "no
//   meaning". `Calls()` is what a callee answers. A program lists its
//   routines last first, each calling those after it and itself
//   `levels` deep, as FunctionIR's programs do. A call of the system
//   (`Callee::System`) is a callee kind with no calls yet: where the world
//   is designed, its model answers there and `Calls` carries it.
// - `Refines(p, q)`: every answer of `p` is an answer of `q`, heaps
//   compared as they read (`Memory::Same`; there is no function
//   extensionality, and a heap's blocks are a function).
// - Validity (`Program::valid`): every id has a kind, and each node reads
//   ids of the kinds it takes, each call passes and binds the kinds its
//   callee's signature names, and each loop's state keeps its kinds. It is
//   what replaces FunctionIR's per-function `placeless`: no word node reads
//   a reference, so a word node's equation holds of the lowered values,
//   in which a reference is an address. Placelessness of the meaning
//   itself is a theorem of the language (bytes_level_renames).
import bytes_memory;
import reference_cells;
import function_ir;
import function_ir_eval;
import function_ir_state;
import bitvec;
import bool;
import list;
import logic;
import nat;
import option;

// ---------------------------------------------------------------------------
// Kinds and ids

inductive ValueKind { WordKind, RefKind }

fn ValueKind::same(self a: ValueKind, b: ValueKind) → Bool {
    match a { WordKind => match b { WordKind => True, RefKind => False }, RefKind => match b { WordKind => False, RefKind => True } }
}

// An id and the kind of value it holds.
record Typed { id: Nat, kind: ValueKind }

fn word_id(id: Nat) → Typed { Typed(id, WordKind) }

fn ref_id(id: Nat) → Typed { Typed(id, RefKind) }

// ---------------------------------------------------------------------------
// A function's values

record Locals { words: Valuation(), refs: Nat → Option<Loc> }

fn Locals::empty() → Locals { Locals(Valuation::zero(), λ (_: Nat) => None) }

fn Locals::word(self l: Locals, id: Nat) → BitVec(64) { l.words(64, id) }

fn Locals::set_word(self l: Locals, id: Nat, value: (w: Nat) → BitVec(w)) → Locals { Locals(Valuation::set(l.words, id, value), l.refs) }

fn Locals::set_ref(self l: Locals, id: Nat, loc: Loc) → Locals {
    Locals(l.words, λ (y: Nat) => match y.same(id) { True => Some(loc), False => l.refs(y) })
}

// The value at an id, read as its kind says.
fn Locals::read(self l: Locals, v: Typed) → Option<Value> {
    match v.kind { WordKind => Some(Word(l.word(v.id))), RefKind => l.refs(v.id).map(λ (loc: Loc) => Ref(loc)) }
}

fn read_values(vs: List<Typed>, l: Locals) → Option<List<Value>> {
    match vs {
        Nil => Some(Nil),
        Cons(v, rest) => l.read(v).and_then(λ (x: Value) => read_values(rest, l).and_then(λ (xs: List<Value>) => Some(Cons(x, xs)))),
    }
}

// A value bound at an id of its kind; nothing at one of the other kind.
fn Locals::bind(self l: Locals, v: Typed, value: Value) → Option<Locals> {
    match v.kind {
        WordKind => match value { Word(w) => Some(l.set_word(v.id, word_value(w))), Ref(_) => None },
        RefKind => match value { Word(_) => None, Ref(loc) => Some(l.set_ref(v.id, loc)) },
    }
}

// Values bound one for one; nothing where the counts differ.
fn bind_values(vs: List<Typed>, values: List<Value>, l: Locals) → Option<Locals> {
    match vs {
        Nil => match values { Nil => Some(l), Cons(_, _) => None },
        Cons(v, rest) => match values {
            Nil => None,
            Cons(x, xs) => l.bind(v, x).and_then(λ (bound: Locals) => bind_values(rest, xs, bound)),
        },
    }
}

// Where a run is: its values and memory.
record Config { locals: Locals, memory: Memory }

// ---------------------------------------------------------------------------
// Nodes

// `place`, `target` and `source` name references; `bytes` is a load's or a
// store's width in bytes (1, 2, 4 or 8, validity's); every other operand
// names a word.
inductive Instr {
    // A FunctionIR node that touches no buffer, run as FunctionIR evaluates
    // it (function_ir_eval's `Node::step`), where its operands meet its
    // requirement (a divisor not zero).
    Compute(node: Node),
    // The `bytes` bytes at `place`, holding no reference, as a word: the
    // first the least significant.
    Load(bytes: Nat, output: Nat, place: Nat),
    // The low `bytes` bytes of the word `value` (read at `8 * bytes` bits)
    // stored at `place`.
    Store(bytes: Nat, place: Nat, value: Nat),
    LoadRef(output: Nat, place: Nat),
    StoreRef(place: Nat, value: Nat),
    // The reference `amount` bytes past `place`.
    Offset(output: Nat, place: Nat, amount: Nat),
    // The `length` bytes at `source`, references and all, written at
    // `target`.
    Copy(target: Nat, source: Nat, length: Nat),
}

fn Instr::step(self instr: Instr, c: Config) → Option<Config> {
    match instr {
        Compute(node) => match node.pure() && node.defined(c.locals.words) {
            False => None,
            True => Some(Config(Locals(node.step(c.locals.words), c.locals.refs), c.memory)),
        },
        Load(bytes, output, place) => c.locals.refs(place).and_then(λ (loc: Loc) =>
            c.memory.load(loc, bytes).and_then(λ (x: Nat) => Some(Config(c.locals.set_word(output, λ (w: Nat) => BitVec::ofNat(x)), c.memory)))),
        Store(bytes, place, value) => c.locals.refs(place).and_then(λ (loc: Loc) =>
            c.memory.store(loc, word_piece(bytes, c.locals.words(8 * bytes, value))).and_then(λ (m: Memory) => Some(Config(c.locals, m)))),
        LoadRef(output, place) => c.locals.refs(place).and_then(λ (loc: Loc) =>
            c.memory.load_ref(loc).and_then(λ (target: Loc) => Some(Config(c.locals.set_ref(output, target), c.memory)))),
        StoreRef(place, value) => c.locals.refs(place).and_then(λ (loc: Loc) => c.locals.refs(value).and_then(λ (target: Loc) =>
            c.memory.store_ref(loc, target).and_then(λ (m: Memory) => Some(Config(c.locals, m))))),
        Offset(output, place, amount) => c.locals.refs(place).and_then(λ (loc: Loc) =>
            Some(Config(c.locals.set_ref(output, Loc(loc.block, loc.offset + c.locals.word(amount).toNat())), c.memory))),
        Copy(target, source, length) => c.locals.refs(target).and_then(λ (to: Loc) => c.locals.refs(source).and_then(λ (from: Loc) =>
            c.memory.copy(to, from, c.locals.word(length).toNat()).and_then(λ (m: Memory) => Some(Config(c.locals, m))))),
    }
}

fn run_instrs(instrs: List<Instr>, c: Config) → Option<Config> {
    match instrs { Nil => Some(c), Cons(instr, rest) => instr.step(c).and_then(λ (after: Config) => run_instrs(rest, after)) }
}

// ---------------------------------------------------------------------------
// Regions, routines, programs

// What the world answers (docs/language/ownership-design.md §17.3: a
// system call is one more kind of callee). No call yet: its design is
// separate, and its cases land here with their model.
inductive Syscall {}

inductive Callee { Local(index: Nat), System(call: Syscall) }

inductive Body {
    Leaf(instrs: List<Instr>),
    Seq(first: Body, rest: Body),
    // `yes` where the one-bit word `condition` is set, `no` where it is not.
    Branch(condition: Nat, yes: Body, no: Body),
    // The callee on the values at `arguments`, its answer's values bound at
    // `results`.
    Call(callee: Callee, arguments: List<Typed>, results: List<Typed>),
    // At most `bound` passes. The values at `inputs` start the state; each
    // pass binds it to `parameters` and the passes left, counted down from
    // `bound`, to `count`, all on ids of its own, and runs `body`; the bit
    // `exit` set ends the loop with the values at `next`, which are
    // otherwise the next pass's state. The final state is bound at
    // `outputs`, and the bit `exhausted` says the passes ran out first.
    Loop(inputs: List<Typed>, bound: Nat, parameters: List<Typed>, count: Nat, body: Body, exit: Nat, next: List<Typed>,
        outputs: List<Typed>, exhausted: Nat),
}

record Answer { words: List<Value>, heap: Memory }

// What the callees of a program answer: routine `f` on values and a heap.
fn Calls() → Type { Nat → List<Value> → Memory → Option<Answer> }

fn no_calls() → Calls() { λ _ _ _ => None }

fn Callee::answer(self callee: Callee, calls: Calls(), args: List<Value>, heap: Memory) → Option<Answer> {
    match callee { Local(f) => calls(f, args, heap), System(call) => match call {} }
}

// How a loop ends: its state, whether its passes ran out, and memory.
record Ended { state: List<Value>, exhausted: Bool, memory: Memory }

// A pass's own ids: the state at its parameters, the passes left at
// `count`.
fn pass_locals(parameters: List<Typed>, count, remaining: Nat, state: List<Value>) → Option<Locals> {
    bind_values(parameters, state, Locals::empty().set_word(count, word_value(BitVec::ofNat(remaining))))
}

fn loop_run(step: Config → Option<Config>, parameters: List<Typed>, count, exit: Nat, next: List<Typed>, remaining: Nat) →
    List<Value> → Memory → Option<Ended> {
    match remaining {
        Zero => λ state m => Some(Ended(state, True, m)),
        Succ(rest) => λ state m => pass_locals(parameters, count, rest + 1, state).and_then(λ (l: Locals) =>
            step(Config(l, m)).and_then(λ (after: Config) => read_values(next, after.locals).and_then(λ (later: List<Value>) =>
                match after.locals.words(1, exit).head_bit() {
                    False => loop_run(step, parameters, count, exit, next, rest, later, after.memory),
                    True => Some(Ended(later, False, after.memory)),
                }))),
    }
}

fn Body::run(self body: Body, calls: Calls(), c: Config) → Option<Config> {
    match body {
        Leaf(instrs) => run_instrs(instrs, c),
        Seq(first, rest) => first.run(calls, c).and_then(λ (mid: Config) => rest.run(calls, mid)),
        Branch(condition, yes, no) => match c.locals.words(1, condition).head_bit() { True => yes.run(calls, c), False => no.run(calls, c) },
        Call(callee, arguments, results) => read_values(arguments, c.locals).and_then(λ (args: List<Value>) =>
            callee.answer(calls, args, c.memory).and_then(λ (answer: Answer) =>
                bind_values(results, answer.words, c.locals).and_then(λ (l: Locals) => Some(Config(l, answer.heap))))),
        Loop(inputs, bound, parameters, count, inner, exit, next, outputs, exhausted) => read_values(inputs, c.locals).and_then(λ (state: List<Value>) =>
            loop_run(λ (pass: Config) => inner.run(calls, pass), parameters, count, exit, next, c.locals.word(bound).toNat(), state, c.memory)
                .and_then(λ (end: Ended) => bind_values(outputs, end.state, c.locals).and_then(λ (l: Locals) =>
                    Some(Config(l.set_word(exhausted, bit_value(end.exhausted)), end.memory))))),
    }
}

// A routine: its parameters, its body, and the ids it answers.
// `levels`: how deep its calls of itself are answered (FunctionIR's
// `Function.levels`); at the last level a call of itself answers nothing.
record Routine { parameters: List<Typed>, body: Body, results: List<Typed>, levels: Nat := 0 }

// Routine `f` is the one with `f` routines after it.
record Program { routines: List<Routine> }

fn Routine::call(self routine: Routine, calls: Calls(), args: List<Value>, heap: Memory) → Option<Answer> {
    bind_values(routine.parameters, args, Locals::empty()).and_then(λ (l: Locals) => routine.body.run(calls, Config(l, heap)).and_then(λ (after: Config) =>
        read_values(routine.results, after.locals).and_then(λ (words: List<Value>) => Some(Answer(words, after.memory)))))
}

// `below` with routine `k` answered by `own`.
fn tie_calls(below: Calls(), k: Nat, own: List<Value> → Memory → Option<Answer>) → Calls() {
    λ (f: Nat) => match f.same(k) { True => own, False => below(f) }
}

// Routine `k` over `below`, `depth` levels deep.
fn deep_calls(routine: Routine, below: Calls(), k, depth: Nat) → List<Value> → Memory → Option<Answer> {
    match depth {
        Zero => λ _ _ => None,
        Succ(d) => λ args heap => routine.call(tie_calls(below, k, deep_calls(routine, below, k, d)), args, heap),
    }
}

// What a program's routines answer, each over the ones after it.
fn program_calls(routines: List<Routine>) → Calls() {
    match routines {
        Nil => no_calls(),
        Cons(routine, rest) => tie_calls(program_calls(rest), rest.len(), deep_calls(routine, program_calls(rest), rest.len(), routine.levels + 1)),
    }
}

// The meaning.
fn run(p: Program, f: Nat, args: List<Value>, heap: Memory) → Option<Answer> { program_calls(p.routines, f, args, heap) }

// ---------------------------------------------------------------------------
// Refinement

// Two memories read alike: the same bytes, the same entries, the same
// blocks writable.
fn Memory::Same(self a: Memory, b: Memory) → Type {
    ((c: Nat) → b.heap.bytes(c) = a.heap.bytes(c)) ∧ (((c: Nat) → b.written(c) = a.written(c)) ∧
        ((e: Entry) → (Mem(e, a.heap.shadow) → Mem(e, b.heap.shadow)) ∧ (Mem(e, b.heap.shadow) → Mem(e, a.heap.shadow))))
}

fn Answer::Same(self a: Answer, b: Answer) → Type { (b.words = a.words) ∧ a.heap.Same(b.heap) }

// Every answer of `p` is an answer of `q`.
fn Refines(p, q: Program) → Type {
    (f: Nat) → (args: List<Value>) → (heap: Memory) → (a: Answer) → run(p, f, args, heap) = Some(a) →
        Exists<Answer>(λ b => (run(q, f, args, heap) = Some(b)) ∧ a.Same(b))
}

theorem Memory::same_refl(self a: Memory): a.Same(a) { ⟨λ c => refl, ⟨λ c => refl, λ e => ⟨λ m => m, λ m => m⟩⟩⟩ }

theorem Memory::same_trans(self a: Memory, b, c: Memory, ab: a.Same(b), bc: b.Same(c)): a.Same(c) {
    ⟨λ x => trans(bc.left(x), ab.left(x)), ⟨λ x => trans(bc.right.left(x), ab.right.left(x)),
        λ e => ⟨λ m => (bc.right.right(e)).left((ab.right.right(e)).left(m)), λ m => (ab.right.right(e)).right((bc.right.right(e)).right(m))⟩⟩⟩
}

theorem refines_refl(p: Program): Refines(p, p) {
    λ f args heap a ran => Exists(a, ⟨ran, ⟨refl, a.heap.same_refl()⟩⟩)
}

theorem refines_trans(p, q, s: Program, pq: Refines(p, q), qs: Refines(q, s)): Refines(p, s) {
    λ f args heap a ran => {
        let mid = pq(f, args, heap, a, ran);
        let last = qs(f, args, heap, mid.witness, mid.proof.left);
        Exists(last.witness, ⟨last.proof.left, ⟨trans(last.proof.right.left, mid.proof.right.left),
            a.heap.same_trans(mid.witness.heap, last.witness.heap, mid.proof.right.right, last.proof.right.right)⟩⟩)
    }
}

// ---------------------------------------------------------------------------
// Validity: kinds

// The ids bound so far and their kinds, the latest first.
fn kind_of(kinds: List<Typed>, id: Nat) → Option<ValueKind> {
    match kinds { Nil => None, Cons(v, rest) => match v.id.same(id) { True => Some(v.kind), False => kind_of(rest, id) } }
}

fn has_kind(kinds: List<Typed>, id: Nat, kind: ValueKind) → Bool {
    match kind_of(kinds, id) { None => False, Some(k) => k.same(kind) }
}

fn has_kinds(kinds: List<Typed>, vs: List<Typed>) → Bool {
    match vs { Nil => True, Cons(v, rest) => has_kind(kinds, v.id, v.kind) && has_kinds(kinds, rest) }
}

fn words_bound(kinds: List<Typed>, ids: List<Nat>) → Bool {
    match ids { Nil => True, Cons(id, rest) => has_kind(kinds, id, WordKind) && words_bound(kinds, rest) }
}

// An id bound at a kind: refused where it already holds the other kind.
fn bind_kind(kinds: List<Typed>, v: Typed) → Option<List<Typed>> {
    match kind_of(kinds, v.id) { None => Some(Cons(v, kinds)), Some(k) => match k.same(v.kind) { True => Some(kinds), False => None } }
}

fn bind_kinds(kinds: List<Typed>, vs: List<Typed>) → Option<List<Typed>> {
    match vs { Nil => Some(kinds), Cons(v, rest) => match bind_kind(kinds, v) { None => None, Some(more) => bind_kinds(more, rest) } }
}

fn kinds_of(vs: List<Typed>) → List<ValueKind> {
    match vs { Nil => Nil, Cons(v, rest) => Cons(v.kind, kinds_of(rest)) }
}

fn same_kinds(a, b: List<ValueKind>) → Bool {
    match a {
        Nil => match b { Nil => True, Cons(_, _) => False },
        Cons(x, xs) => match b { Nil => False, Cons(y, ys) => x.same(y) && same_kinds(xs, ys) },
    }
}

// A load's or a store's width.
fn width_ok(bytes: Nat) → Bool { bytes.same(1) || (bytes.same(2) || (bytes.same(4) || bytes.same(8))) }

fn when_ok(ok: Bool, kinds: List<Typed>) → Option<List<Typed>> { match ok { False => None, True => Some(kinds) } }

// What a node needs of the kinds bound before it, and what it binds.
fn Instr::check(self instr: Instr, kinds: List<Typed>) → Option<List<Typed>> {
    match instr {
        Compute(node) => match node.pure() && words_bound(kinds, node.reads()) {
            False => None,
            True => bind_kind(kinds, word_id(node_output(node).id)),
        },
        Load(bytes, output, place) => match width_ok(bytes) && has_kind(kinds, place, RefKind) {
            False => None,
            True => bind_kind(kinds, word_id(output)),
        },
        Store(bytes, place, value) => when_ok(width_ok(bytes) && (has_kind(kinds, place, RefKind) && has_kind(kinds, value, WordKind)), kinds),
        LoadRef(output, place) => match has_kind(kinds, place, RefKind) { False => None, True => bind_kind(kinds, ref_id(output)) },
        StoreRef(place, value) => when_ok(has_kind(kinds, place, RefKind) && has_kind(kinds, value, RefKind), kinds),
        Offset(output, place, amount) => match has_kind(kinds, place, RefKind) && has_kind(kinds, amount, WordKind) {
            False => None,
            True => bind_kind(kinds, ref_id(output)),
        },
        Copy(target, source, length) =>
            when_ok(has_kind(kinds, target, RefKind) && (has_kind(kinds, source, RefKind) && has_kind(kinds, length, WordKind)), kinds),
    }
}

fn check_instrs(instrs: List<Instr>, kinds: List<Typed>) → Option<List<Typed>> {
    match instrs { Nil => Some(kinds), Cons(instr, rest) => match instr.check(kinds) { None => None, Some(after) => check_instrs(rest, after) } }
}

// What a routine takes and answers, by kind.
record Signature { parameters: List<ValueKind>, results: List<ValueKind> }

fn Routine::signature(self routine: Routine) → Signature { Signature(kinds_of(routine.parameters), kinds_of(routine.results)) }

fn Callee::fits(self callee: Callee, signatures: Nat → Option<Signature>, arguments, results: List<Typed>) → Bool {
    match callee {
        Local(f) => match signatures(f) {
            None => False,
            Some(s) => same_kinds(kinds_of(arguments), s.parameters) && same_kinds(kinds_of(results), s.results),
        },
        System(call) => match call {},
    }
}

// What both arms bound alike.
fn meet_kinds(yes, no: List<Typed>) → List<Typed> { yes.filter(λ (v: Typed) => has_kind(no, v.id, v.kind)) }

fn Body::check(self body: Body, signatures: Nat → Option<Signature>, kinds: List<Typed>) → Option<List<Typed>> {
    match body {
        Leaf(instrs) => check_instrs(instrs, kinds),
        Seq(first, rest) => match first.check(signatures, kinds) { None => None, Some(mid) => rest.check(signatures, mid) },
        Branch(condition, yes, no) => match has_kind(kinds, condition, WordKind) {
            False => None,
            True => match yes.check(signatures, kinds) {
                None => None,
                Some(after_yes) => match no.check(signatures, kinds) { None => None, Some(after_no) => Some(meet_kinds(after_yes, after_no)) },
            },
        },
        Call(callee, arguments, results) => match has_kinds(kinds, arguments) && callee.fits(signatures, arguments, results) {
            False => None,
            True => bind_kinds(kinds, results),
        },
        Loop(inputs, bound, parameters, count, inner, exit, next, outputs, exhausted) =>
            match has_kinds(kinds, inputs) && (has_kind(kinds, bound, WordKind) && (same_kinds(kinds_of(inputs), kinds_of(parameters)) &&
                (same_kinds(kinds_of(next), kinds_of(parameters)) && same_kinds(kinds_of(outputs), kinds_of(parameters))))) {
                False => None,
                True => match bind_kinds([word_id(count)], parameters) {
                    None => None,
                    Some(start) => match inner.check(signatures, start) {
                        None => None,
                        Some(after) => match has_kinds(after, next) && has_kind(after, exit, WordKind) {
                            False => None,
                            True => match bind_kinds(kinds, outputs) { None => None, Some(bound_out) => bind_kind(bound_out, word_id(exhausted)) },
                        },
                    },
                },
            },
    }
}

fn Routine::valid(self routine: Routine, signatures: Nat → Option<Signature>) → Bool {
    match bind_kinds([], routine.parameters) {
        None => False,
        Some(start) => match routine.body.check(signatures, start) { None => False, Some(after) => has_kinds(after, routine.results) },
    }
}

// The signatures of a program's routines by number.
fn program_signatures(routines: List<Routine>) → Nat → Option<Signature> {
    match routines {
        Nil => λ _ => None,
        Cons(routine, rest) => λ (f: Nat) => match f.same(rest.len()) { True => Some(routine.signature()), False => program_signatures(rest, f) },
    }
}

// Each routine valid over its own signature and those after it.
fn routines_valid(routines: List<Routine>) → Bool {
    match routines { Nil => True, Cons(routine, rest) => routine.valid(program_signatures(Cons(routine, rest))) && routines_valid(rest) }
}

fn Program::valid(self p: Program) → Bool { routines_valid(p.routines) }

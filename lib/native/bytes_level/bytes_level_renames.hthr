// Placelessness of the bytes level, proved once for the language
// (docs/language/ownership-design.md §17.3, §17.6; issues/bytes-level-language.md):
// a run of a program on a heap whose blocks are renamed, its arguments'
// references and its fixed block facts renamed alike, is the run renamed
// (`run_renames`), at every fuel; so the words it answers, how it ends and
// the world it leaves are the same under any renaming (`run_words_alike`).
//
// No operation observes which block a reference names beyond following
// it: a word node reads words only, a memory node reads the block it is
// given (bytes_memory's `take_renames`, `put_renames`), an offset moves
// within its block, and a system call's command is words and bytes, never
// a reference (validity's kinds), so a renaming is the identity on the
// world. The proof follows the meaning's own structure: each step is a
// `then` of `Ran` or an `and_then` of `Option`, and a few lemmas carry a
// relation across one. What a call answers is placeless where its callees
// are (`CallsRenamed`), and a program's table is, fuel by fuel.
import bytes_level::{run};
import bytes_memory;
import reference_cells;
import function_ir;
import function_ir_eval;
import linux_calls;
import linux_world;
import bitvec;
import bool;
import list;
import logic;
import nat;
import option;

// ---------------------------------------------------------------------------
// Renamed values, configurations, answers

fn rename_values(r: Renaming, vs: List<Value>) → List<Value> {
    match vs { Nil => Nil, Cons(v, rest) => Cons(v.rename(r), rename_values(r, rest)) }
}

// `renamed` holds the same words, and each reference renamed.
record LocalsRenamed(r: Renaming, l, renamed: Locals) {
    words: renamed.words = l.words,
    refs: (x: Nat) → renamed.refs(x) = l.refs(x).map(λ (t: Loc) => t.rename(r)),
}

record ConfigRenamed(r: Renaming, c, renamed: Config) {
    locals: LocalsRenamed(r, c.locals, renamed.locals),
    memory: MemoryRenamed(r, c.memory, renamed.memory),
    io: renamed.io = c.io,
}

record AnswerRenamed(r: Renaming, a, renamed: Answer) {
    words: renamed.words = rename_values(r, a.words),
    heap: MemoryRenamed(r, a.heap, renamed.heap),
    io: renamed.io = a.io,
}

record EndedRenamed(r: Renaming, e, renamed: Ended) {
    state: renamed.state = rename_values(r, e.state),
    memory: MemoryRenamed(r, e.memory, renamed.memory),
    io: renamed.io = e.io,
}

fn locals_renamed(r: Renaming) → Locals → Locals → Type { λ (a: Locals) (b: Locals) => LocalsRenamed(r, a, b) }

fn config_renamed(r: Renaming) → Config → Config → Type { λ (a: Config) (b: Config) => ConfigRenamed(r, a, b) }

fn answer_renamed(r: Renaming) → Answer → Answer → Type { λ (a: Answer) (b: Answer) => AnswerRenamed(r, a, b) }

fn ended_renamed(r: Renaming) → Ended → Ended → Type { λ (a: Ended) (b: Ended) => EndedRenamed(r, a, b) }

// ---------------------------------------------------------------------------
// Outcomes alike

// Both done and related, both exited alike, both going in one world, or
// both stuck.
fn RanRelated<T>(R: T → T → Type, a, b: Ran<T>) → Type {
    match a {
        Done(x) => match b { Done(y) => R(x, y), Exited(_, _) => False, Going(_) => False, Stuck => False },
        Exited(status, io) => match b { Done(_) => False, Exited(status2, io2) => (status2 = status) ∧ (io2 = io), Going(_) => False, Stuck => False },
        Going(io) => match b { Done(_) => False, Exited(_, _) => False, Going(io2) => io2 = io, Stuck => False },
        Stuck => match b { Done(_) => False, Exited(_, _) => False, Going(_) => False, Stuck => True },
    }
}

theorem ran_then<A, T>(Ra: A → A → Type, R: T → T → Type, {a, b: Ran<A>}, rel: RanRelated<A>(Ra, a, b), {k, k2: A → Ran<T>},
    each: (x, y: A) → Ra(x, y) → RanRelated<T>(R, k(x), k2(y))): RanRelated<T>(R, a.then(k), b.then(k2)) {
    (match a as λ a0 => (b0: Ran<A>) → RanRelated<A>(Ra, a0, b0) → RanRelated<T>(R, a0.then(k), b0.then(k2)) {
        Done(x) => λ b0 => match b0 as λ bb => RanRelated<A>(Ra, Done(x), bb) → RanRelated<T>(R, k(x), bb.then(k2)) {
            Done(y) => λ h => each(x, y, h),
            Exited(_, _) => λ never => false_elim(never),
            Going(_) => λ never => false_elim(never),
            Stuck => λ never => false_elim(never),
        },
        Exited(status, io) => λ b0 => match b0 as λ bb => RanRelated<A>(Ra, Exited(status, io), bb) → RanRelated<T>(R, Exited(status, io), bb.then(k2)) {
            Done(_) => λ never => false_elim(never),
            Exited(_, _) => λ h => h,
            Going(_) => λ never => false_elim(never),
            Stuck => λ never => false_elim(never),
        },
        Going(io) => λ b0 => match b0 as λ bb => RanRelated<A>(Ra, Going(io), bb) → RanRelated<T>(R, Going(io), bb.then(k2)) {
            Done(_) => λ never => false_elim(never),
            Exited(_, _) => λ never => false_elim(never),
            Going(_) => λ h => h,
            Stuck => λ never => false_elim(never),
        },
        Stuck => λ b0 => match b0 as λ bb => RanRelated<A>(Ra, Stuck, bb) → RanRelated<T>(R, Stuck, bb.then(k2)) {
            Done(_) => λ never => false_elim(never),
            Exited(_, _) => λ never => false_elim(never),
            Going(_) => λ never => false_elim(never),
            Stuck => λ _ => trivial,
        },
    })(b, rel)
}

theorem ran_of_related<A>(Ra: A → A → Type, {o, o2: Option<A>}, rel: Related<A>(Ra, o, o2)): RanRelated<A>(Ra, Ran::of(o), Ran::of(o2)) {
    (match o as λ a => (b: Option<A>) → Related<A>(Ra, a, b) → RanRelated<A>(Ra, Ran::of(a), Ran::of(b)) {
        None => λ b => match b as λ bb => Related<A>(Ra, None, bb) → RanRelated<A>(Ra, Stuck, Ran::of(bb)) {
            None => λ _ => trivial,
            Some(_) => λ never => false_elim(never),
        },
        Some(x) => λ b => match b as λ bb => Related<A>(Ra, Some(x), bb) → RanRelated<A>(Ra, Done(x), Ran::of(bb)) {
            None => λ never => false_elim(never),
            Some(_) => λ h => h,
        },
    })(o2, rel)
}

theorem ran_of_then<A, T>(Ra: A → A → Type, R: T → T → Type, {o, o2: Option<A>}, rel: Related<A>(Ra, o, o2), {k, k2: A → Ran<T>},
    each: (x, y: A) → Ra(x, y) → RanRelated<T>(R, k(x), k2(y))): RanRelated<T>(R, Ran::of(o).then(k), Ran::of(o2).then(k2)) {
    ran_then(Ra, R, ran_of_related(Ra, rel), each)
}

// The second the first renamed by `g`.
theorem ran_of_map_then<A, T>(R: T → T → Type, g: A → A, {o, o2: Option<A>}, same: o2 = o.map(g), {k, k2: A → Ran<T>},
    each: (x: A) → RanRelated<T>(R, k(x), k2(g(x)))): RanRelated<T>(R, Ran::of(o).then(k), Ran::of(o2).then(k2)) {
    rewrite(same, match o as λ a => RanRelated<T>(R, Ran::of(a).then(k), Ran::of(a.map(g)).then(k2)) { None => trivial, Some(x) => each(x) })
}

// The second the first.
theorem ran_of_same_then<A, T>(R: T → T → Type, {o, o2: Option<A>}, same: o2 = o, {k, k2: A → Ran<T>},
    each: (x: A) → RanRelated<T>(R, k(x), k2(x))): RanRelated<T>(R, Ran::of(o).then(k), Ran::of(o2).then(k2)) {
    rewrite(same, match o as λ a => RanRelated<T>(R, Ran::of(a).then(k), Ran::of(a).then(k2)) { None => trivial, Some(x) => each(x) })
}

// ---------------------------------------------------------------------------
// Locals

theorem LocalsRenamed::read({r: Renaming}, {l, renamed: Locals}, self rel: LocalsRenamed(r, l, renamed), v: Typed):
    renamed.read(v) = l.read(v).map(λ (x: Value) => x.rename(r)) {
    match v.kind as λ k =>
        (match k { WordKind => Some(Word(renamed.words(64, v.id))), RefKind => renamed.refs(v.id).map(λ (loc: Loc) => Ref(loc)) }) =
            (match k { WordKind => Some(Word(l.words(64, v.id))), RefKind => l.refs(v.id).map(λ (loc: Loc) => Ref(loc)) }).map(λ (x: Value) => x.rename(r)) {
        WordKind => rewrite(rel.words, refl),
        RefKind => rewrite(rel.refs(v.id), match l.refs(v.id) {
            None => refl,
            Some(_) => refl,
        }),
    }
}

fn values_renamed(r: Renaming) → List<Value> → List<Value> → Type { λ (a: List<Value>) (b: List<Value>) => b = rename_values(r, a) }

theorem read_values_related(r: Renaming, vs: List<Typed>, l, renamed: Locals, rel: LocalsRenamed(r, l, renamed)):
    Related<List<Value>>(values_renamed(r), read_values(vs, l), read_values(vs, renamed)) {
    match vs {
        Nil => refl,
        Cons(v, rest) => related_map_then(values_renamed(r), λ (x: Value) => x.rename(r), rel.read(v), λ x =>
            related_then(values_renamed(r), values_renamed(r), read_values_related(r, rest, l, renamed, rel), λ xs ys h =>
                j(sym(h), λ zs _ => Related<List<Value>>(values_renamed(r), Some(Cons(x, xs)), Some(Cons(x.rename(r), zs))), refl))),
    }
}

theorem read_values_renames(r: Renaming, vs: List<Typed>, l, renamed: Locals, rel: LocalsRenamed(r, l, renamed)):
    read_values(vs, renamed) = read_values(vs, l).map(λ (xs: List<Value>) => rename_values(r, xs)) {
    related_eq_map(λ (xs: List<Value>) => rename_values(r, xs), read_values_related(r, vs, l, renamed, rel))
}

theorem LocalsRenamed::set_word({r: Renaming}, {l, renamed: Locals}, self rel: LocalsRenamed(r, l, renamed), id: Nat, value: (w: Nat) → BitVec(w)):
    LocalsRenamed(r, l.set_word(id, value), renamed.set_word(id, value)) {
    LocalsRenamed(words := cong_fn<Valuation(), Valuation()>(λ ws => Valuation::set(ws, id, value), rel.words), refs := rel.refs)
}

theorem LocalsRenamed::set_ref({r: Renaming}, {l, renamed: Locals}, self rel: LocalsRenamed(r, l, renamed), id: Nat, loc: Loc):
    LocalsRenamed(r, l.set_ref(id, loc), renamed.set_ref(id, loc.rename(r))) {
    LocalsRenamed(
        words := rel.words,
        refs := λ y => match y.same(id) {
            True => refl,
            False => rel.refs(y),
        },
    )
}

theorem LocalsRenamed::bind({r: Renaming}, {l, renamed: Locals}, self rel: LocalsRenamed(r, l, renamed), v: Typed, x: Value):
    Related<Locals>(locals_renamed(r), l.bind(v, x), renamed.bind(v, x.rename(r))) {
    match v.kind {
        WordKind => match x { Word(w) => rel.set_word(v.id, word_value(w)), Ref(_) => trivial },
        RefKind => match x { Word(_) => trivial, Ref(loc) => rel.set_ref(v.id, loc) },
    }
}

theorem bind_values_renames(r: Renaming, vs: List<Typed>): (values: List<Value>) → (l, renamed: Locals) → LocalsRenamed(r, l, renamed) →
    Related<Locals>(locals_renamed(r), bind_values(vs, values, l), bind_values(vs, rename_values(r, values), renamed)) {
    match vs {
        Nil => λ values l renamed rel => match values { Nil => rel, Cons(_, _) => trivial },
        Cons(v, rest) => λ values l renamed rel => match values {
            Nil => trivial,
            Cons(x, xs) => related_then(locals_renamed(r), locals_renamed(r), rel.bind(v, x),
                λ a b h => bind_values_renames(r, rest, xs, a, b, h)),
        },
    }
}

// Locals with no reference are their own renaming.
theorem LocalsRenamed::words_only(r: Renaming, words: Valuation()): LocalsRenamed(r, Locals(words, λ (_: Nat) => None), Locals(words, λ (_: Nat) => None)) {
    LocalsRenamed(words := refl, refs := λ x => refl)
}

// ---------------------------------------------------------------------------
// Nodes

// A configuration with the same words and world, its references and memory
// renamed, its blocks renamed alike.
theorem Instr::step_renames_at(self instr: Instr, r: Renaming, blocks, blocks2: Blocks, written: BlocksRenamed(r, blocks, blocks2), c: Config,
    refs: Nat → Option<Loc>, m: Memory, refs_renamed: (x: Nat) → refs(x) = c.locals.refs(x).map(λ (t: Loc) => t.rename(r)),
    memory: MemoryRenamed(r, c.memory, m)):
    Related<Config>(config_renamed(r), instr.step(blocks, c), instr.step(blocks2, Config(Locals(c.locals.words, refs), m, c.io))) {
    let l = Locals(c.locals.words, refs);
    let locals: LocalsRenamed(r, c.locals, l) = LocalsRenamed(words := refl, refs := refs_renamed);
    let rename = λ (t: Loc) => t.rename(r);
    match instr {
        Compute(node) => match node.pure() && node.defined(c.locals.words) as λ v =>
            Related<Config>(config_renamed(r), match v { False => None, True => Some(Config(Locals(node.step(c.locals.words), c.locals.refs), c.memory, c.io)) },
                match v { False => None, True => Some(Config(Locals(node.step(c.locals.words), refs), m, c.io)) }) {
            False => trivial,
            True => ConfigRenamed(locals := LocalsRenamed(words := refl, refs := refs_renamed), memory := memory, io := refl),
        },
        Load(bytes, output, place) => related_map_then(config_renamed(r), rename, refs_renamed(place), λ loc =>
            related_same_then(config_renamed(r), c.memory.load_renames(r, m, memory, loc, bytes), λ x =>
                ConfigRenamed(locals := locals.set_word(output, λ (w: Nat) => BitVec::ofNat(x)), memory := memory, io := refl))),
        Store(bytes, place, value) => related_map_then(config_renamed(r), rename, refs_renamed(place), λ loc =>
            related_then(memory_renamed(r), config_renamed(r),
                c.memory.store_renames(blocks, r, m, blocks2, memory, written, loc, word_piece(bytes, c.locals.words(8 * bytes, value))),
                λ a b h => ConfigRenamed(locals := locals, memory := h, io := refl))),
        LoadRef(output, place) => related_map_then(config_renamed(r), rename, refs_renamed(place), λ loc =>
            related_map_then(config_renamed(r), rename, c.memory.load_ref_renames(r, m, memory, loc), λ target =>
                ConfigRenamed(locals := locals.set_ref(output, target), memory := memory, io := refl))),
        StoreRef(place, value) => related_map_then(config_renamed(r), rename, refs_renamed(place), λ loc =>
            related_map_then(config_renamed(r), rename, refs_renamed(value), λ target =>
                related_then(memory_renamed(r), config_renamed(r), c.memory.store_ref_renames(blocks, r, m, blocks2, memory, written, loc, target),
                    λ a b h => ConfigRenamed(locals := locals, memory := h, io := refl)))),
        Offset(output, place, amount) => related_map_then(config_renamed(r), rename, refs_renamed(place), λ loc =>
            ConfigRenamed(locals := locals.set_ref(output, Loc(loc.block, loc.offset + c.locals.word(amount).toNat())), memory := memory, io := refl)),
        Copy(target, source, length) => related_map_then(config_renamed(r), rename, refs_renamed(target), λ to =>
            related_map_then(config_renamed(r), rename, refs_renamed(source), λ from =>
                related_then(memory_renamed(r), config_renamed(r),
                    c.memory.copy_renames(blocks, r, m, blocks2, memory, written, to, from, c.locals.word(length).toNat()),
                    λ a b h => ConfigRenamed(locals := locals, memory := h, io := refl)))),
    }
}

// The step of a renamed configuration is the renamed step.
theorem Instr::step_renames(self instr: Instr, r: Renaming, blocks, blocks2: Blocks, written: BlocksRenamed(r, blocks, blocks2), c, renamed: Config,
    rel: ConfigRenamed(r, c, renamed)): Related<Config>(config_renamed(r), instr.step(blocks, c), instr.step(blocks2, renamed)) {
    j(sym(rel.locals.words), λ ws _ => Related<Config>(config_renamed(r), instr.step(blocks, c),
            instr.step(blocks2, Config(Locals(ws, renamed.locals.refs), renamed.memory, renamed.io))),
        j(sym(rel.io), λ o _ => Related<Config>(config_renamed(r), instr.step(blocks, c),
                instr.step(blocks2, Config(Locals(c.locals.words, renamed.locals.refs), renamed.memory, o))),
            instr.step_renames_at(r, blocks, blocks2, written, c, renamed.locals.refs, renamed.memory, rel.locals.refs, rel.memory)))
}

theorem run_instrs_renames(r: Renaming, blocks, blocks2: Blocks, written: BlocksRenamed(r, blocks, blocks2), instrs: List<Instr>):
    (c, renamed: Config) → ConfigRenamed(r, c, renamed) →
    Related<Config>(config_renamed(r), run_instrs(blocks, instrs, c), run_instrs(blocks2, instrs, renamed)) {
    match instrs {
        Nil => λ c renamed rel => rel,
        Cons(instr, rest) => λ c renamed rel => related_then(config_renamed(r), config_renamed(r), instr.step_renames(r, blocks, blocks2, written, c, renamed, rel),
            λ a b h => run_instrs_renames(r, blocks, blocks2, written, rest, a, b, h)),
    }
}

// ---------------------------------------------------------------------------
// System calls: the command is words and bytes, so the world is the same

theorem rename_pointers_none(r: Renaming, pointers: List<Pointer>): no_pointers(rename_pointers(r, pointers)) = no_pointers(pointers) {
    match pointers { Nil => refl, Cons(_, _) => refl }
}

theorem read_landed_renames(r: Renaming, blocks, blocks2: Blocks, written: BlocksRenamed(r, blocks, blocks2), c: Config, refs: Nat → Option<Loc>,
    m: Memory, locals: LocalsRenamed(r, c.locals, Locals(c.locals.words, refs)), memory: MemoryRenamed(r, c.memory, m), fd: BitVec(64), loc: Loc,
    n, result: Nat, answer: ReadResult):
    RanRelated<Config>(config_renamed(r), read_landed(blocks, c, fd, loc, n, result, answer),
        read_landed(blocks2, Config(Locals(c.locals.words, refs), m, c.io), fd, loc.rename(r), n, result, answer)) {
    match answer {
        ReadBytes(bytes) => ran_of_then(memory_renamed(r), config_renamed(r),
            c.memory.put_renames(blocks, r, m, blocks2, memory, written, loc, Piece::plain(bytes.take(n))),
            λ a b h => ConfigRenamed(locals := locals.set_word(result, word_value(count_word(bytes.take(n).len()))), memory := h, io := refl)),
        ReadFailed(errno) => ran_of_then(memory_renamed(r), config_renamed(r), c.memory.put_renames(blocks, r, m, blocks2, memory, written, loc, Piece::undefined(n)),
            λ a b h => ConfigRenamed(locals := locals.set_word(result, word_value(errno_word(errno))), memory := h, io := refl)),
    }
}

theorem SysCall::run_alike_at(self call: SysCall, r: Renaming, blocks, blocks2: Blocks, written: BlocksRenamed(r, blocks, blocks2), c: Config,
    refs: Nat → Option<Loc>, m: Memory, refs_renamed: (x: Nat) → refs(x) = c.locals.refs(x).map(λ (t: Loc) => t.rename(r)),
    memory: MemoryRenamed(r, c.memory, m)):
    RanRelated<Config>(config_renamed(r), call.run(blocks, c), call.run(blocks2, Config(Locals(c.locals.words, refs), m, c.io))) {
    let c2 = Config(Locals(c.locals.words, refs), m, c.io);
    let locals: LocalsRenamed(r, c.locals, Locals(c.locals.words, refs)) = LocalsRenamed(words := refl, refs := refs_renamed);
    match call {
        Read(fd, buf, len, result) => ran_of_map_then(config_renamed(r), λ (t: Loc) => t.rename(r), refs_renamed(buf), λ loc => {
            let n = c.locals.word(len).toNat();
            let open: (c2.memory.open(blocks2, loc.rename(r), n) = c.memory.open(blocks, loc, n)) =
                Bool::and_cong(written.writes(loc.block), Bool::and_cong(memory.fits(loc, n), Bool::and_cong(memory.whole(loc, n),
                    trans(cong_fn<List<Entry>, Bool>(λ sh => no_pointers(range_pointers(sh, r.there(loc.block), loc.offset, n)), memory.shadow),
                        trans(cong_fn<List<Pointer>, Bool>(λ ps => no_pointers(ps), rename_range_pointers(r, loc.block, loc.offset, n, c.memory.heap.shadow)),
                            rename_pointers_none(r, range_pointers(c.memory.heap.shadow, loc.block, loc.offset, n)))))));
            j(sym(open), λ v _ => RanRelated<Config>(config_renamed(r), read_into(blocks, c, c.locals.word(fd), loc, n, result),
                    match v { False => Stuck, True => read_landed(blocks2, c2, c.locals.word(fd), loc.rename(r), n, result,
                        c.io.world(c.io.past, ReadCmd(c.locals.word(fd), n))) }),
                match c.memory.open(blocks, loc, n) as λ v => RanRelated<Config>(config_renamed(r),
                        match v { False => Stuck, True => read_landed(blocks, c, c.locals.word(fd), loc, n, result, c.io.world(c.io.past, ReadCmd(c.locals.word(fd), n))) },
                        match v { False => Stuck, True => read_landed(blocks2, c2, c.locals.word(fd), loc.rename(r), n, result,
                            c.io.world(c.io.past, ReadCmd(c.locals.word(fd), n))) }) {
                    False => trivial,
                    True => read_landed_renames(r, blocks, blocks2, written, c, refs, m, locals, memory, c.locals.word(fd), loc, n, result,
                        c.io.world(c.io.past, ReadCmd(c.locals.word(fd), n))),
                })
        }),
        Write(fd, buf, len, result) => ran_of_map_then(config_renamed(r), λ (t: Loc) => t.rename(r), refs_renamed(buf), λ loc =>
            ran_of_same_then(config_renamed(r), c.memory.read_bytes_renames(r, m, memory, loc, c.locals.word(len).toNat()), λ bytes =>
                match c.io.world(c.io.past, WriteCmd(c.locals.word(fd), bytes)) as λ answer =>
                    RanRelated<Config>(config_renamed(r), write_landed(c, c.locals.word(fd), bytes, result, answer), write_landed(c2, c.locals.word(fd), bytes, result, answer)) {
                    Wrote(count) => ConfigRenamed(locals := locals.set_word(result, word_value(count_word(count))), memory := memory, io := refl),
                    WriteFailed(errno) => ConfigRenamed(locals := locals.set_word(result, word_value(errno_word(errno))), memory := memory, io := refl),
                })),
    }
}

theorem SysCall::run_alike(self call: SysCall, r: Renaming, blocks, blocks2: Blocks, written: BlocksRenamed(r, blocks, blocks2), c, renamed: Config,
    rel: ConfigRenamed(r, c, renamed)): RanRelated<Config>(config_renamed(r), call.run(blocks, c), call.run(blocks2, renamed)) {
    j(sym(rel.locals.words), λ ws _ => RanRelated<Config>(config_renamed(r), call.run(blocks, c),
            call.run(blocks2, Config(Locals(ws, renamed.locals.refs), renamed.memory, renamed.io))),
        j(sym(rel.io), λ o _ => RanRelated<Config>(config_renamed(r), call.run(blocks, c),
                call.run(blocks2, Config(Locals(c.locals.words, renamed.locals.refs), renamed.memory, o))),
            call.run_alike_at(r, blocks, blocks2, written, c, renamed.locals.refs, renamed.memory, rel.locals.refs, rel.memory)))
}

// ---------------------------------------------------------------------------
// Loops

// A pass's ids, from a renamed state.
theorem pass_locals_renames(r: Renaming, parameters: List<Typed>, state: List<Value>):
    Related<Locals>(locals_renamed(r), pass_locals(parameters, state), pass_locals(parameters, rename_values(r, state))) {
    bind_values_renames(r, parameters, state, Locals::empty(), Locals::empty(), LocalsRenamed::words_only(r, Valuation::zero()))
}

// The loop's passes, each a renamed step, from a renamed state.
theorem loop_run_renames(r: Renaming, step, step2: Nat → Config → Ran<Config>,
    steps: (n: Nat) → (c, renamed: Config) → ConfigRenamed(r, c, renamed) → RanRelated<Config>(config_renamed(r), step(n, c), step2(n, renamed)),
    parameters: List<Typed>, exit: Nat, next: List<Typed>, fuel: Nat):
    (state: List<Value>) → (m, renamed: Memory) → (io, io2: Io) → MemoryRenamed(r, m, renamed) → io2 = io →
    RanRelated<Ended>(ended_renamed(r), loop_run(step, parameters, exit, next, fuel, state, m, io),
        loop_run(step2, parameters, exit, next, fuel, rename_values(r, state), renamed, io2)) {
    match fuel {
        Zero => λ state m renamed io io2 rel same => same,
        Succ(rest) => λ state m renamed io io2 rel same => ran_of_then(locals_renamed(r), ended_renamed(r), pass_locals_renames(r, parameters, state),
            λ l l2 hl => ran_then(config_renamed(r), ended_renamed(r), steps(rest, Config(l, m, io), Config(l2, renamed, io2), ConfigRenamed(locals := hl, memory := rel, io := same)),
                λ after after2 h => ran_of_map_then(ended_renamed(r), λ (xs: List<Value>) => rename_values(r, xs),
                    read_values_renames(r, next, after.locals, after2.locals, h.locals), λ later =>
                        j(sym(h.locals.words), λ ws _ => RanRelated<Ended>(ended_renamed(r),
                                match after.locals.words(1, exit).head_bit() {
                                    False => loop_run(step, parameters, exit, next, rest, later, after.memory, after.io),
                                    True => Done(Ended(later, after.memory, after.io)),
                                },
                                match ws(1, exit).head_bit() {
                                    False => loop_run(step2, parameters, exit, next, rest, rename_values(r, later), after2.memory, after2.io),
                                    True => Done(Ended(rename_values(r, later), after2.memory, after2.io)),
                                }),
                            match after.locals.words(1, exit).head_bit() as λ v => RanRelated<Ended>(ended_renamed(r),
                                    match v {
                                        False => loop_run(step, parameters, exit, next, rest, later, after.memory, after.io),
                                        True => Done(Ended(later, after.memory, after.io)),
                                    },
                                    match v {
                                        False => loop_run(step2, parameters, exit, next, rest, rename_values(r, later), after2.memory, after2.io),
                                        True => Done(Ended(rename_values(r, later), after2.memory, after2.io)),
                                    }) {
                                False => loop_run_renames(r, step, step2, steps, parameters, exit, next, rest, later, after.memory, after2.memory, after.io,
                                    after2.io, h.memory, h.io),
                                True => EndedRenamed(state := refl, memory := h.memory, io := h.io),
                            })))),
    }
}

// ---------------------------------------------------------------------------
// Regions

// Two tables of calls alike: on renamed values, a renamed heap and one
// world, renamed answers.
fn CallsRenamed(r: Renaming, calls, calls2: Calls()) → Type {
    (f: Nat) → (args: List<Value>) → (m, renamed: Memory) → MemoryRenamed(r, m, renamed) → (io, io2: Io) → io2 = io →
        RanRelated<Answer>(answer_renamed(r), calls(f, args, m, io), calls2(f, rename_values(r, args), renamed, io2))
}

theorem Body::run_renames(self body: Body, r: Renaming, blocks, blocks2: Blocks, written: BlocksRenamed(r, blocks, blocks2), calls, calls2: Calls(),
    called: CallsRenamed(r, calls, calls2)): (fuel: Nat) → (c, renamed: Config) → ConfigRenamed(r, c, renamed) →
    RanRelated<Config>(config_renamed(r), body.run(blocks, calls, fuel, c), body.run(blocks2, calls2, fuel, renamed)) {
    match body {
        Leaf(instrs) => λ fuel c renamed rel => ran_of_related(config_renamed(r), run_instrs_renames(r, blocks, blocks2, written, instrs, c, renamed, rel)),
        Seq(first, rest) => λ fuel c renamed rel => ran_then(config_renamed(r), config_renamed(r),
            first.run_renames(r, blocks, blocks2, written, calls, calls2, called, fuel, c, renamed, rel),
            λ a b h => rest.run_renames(r, blocks, blocks2, written, calls, calls2, called, fuel, a, b, h)),
        Branch(condition, yes, no) => λ fuel c renamed rel =>
            j(sym(rel.locals.words), λ ws _ => RanRelated<Config>(config_renamed(r),
                    match c.locals.words(1, condition).head_bit() { True => yes.run(blocks, calls, fuel, c), False => no.run(blocks, calls, fuel, c) },
                    match ws(1, condition).head_bit() { True => yes.run(blocks2, calls2, fuel, renamed), False => no.run(blocks2, calls2, fuel, renamed) }),
                match c.locals.words(1, condition).head_bit() as λ v => RanRelated<Config>(config_renamed(r),
                        match v { True => yes.run(blocks, calls, fuel, c), False => no.run(blocks, calls, fuel, c) },
                        match v { True => yes.run(blocks2, calls2, fuel, renamed), False => no.run(blocks2, calls2, fuel, renamed) }) {
                    True => yes.run_renames(r, blocks, blocks2, written, calls, calls2, called, fuel, c, renamed, rel),
                    False => no.run_renames(r, blocks, blocks2, written, calls, calls2, called, fuel, c, renamed, rel),
                }),
        Call(callee, arguments, results) => λ fuel c renamed rel => ran_of_map_then(config_renamed(r), λ (xs: List<Value>) => rename_values(r, xs),
            read_values_renames(r, arguments, c.locals, renamed.locals, rel.locals), λ args =>
                ran_then(answer_renamed(r), config_renamed(r), called(callee, args, c.memory, renamed.memory, rel.memory, c.io, renamed.io, rel.io),
                    λ a b h => rewrite(h.words, ran_of_then(locals_renamed(r), config_renamed(r),
                        bind_values_renames(r, results, a.words, c.locals, renamed.locals, rel.locals),
                        λ l l2 hl => ConfigRenamed(locals := hl, memory := h.heap, io := h.io))))),
        Loop(inputs, parameters, inner, exit, next, outputs) => λ fuel c renamed rel =>
            ran_of_map_then(config_renamed(r), λ (xs: List<Value>) => rename_values(r, xs), read_values_renames(r, inputs, c.locals, renamed.locals, rel.locals),
                λ state => ran_then(ended_renamed(r), config_renamed(r),
                    loop_run_renames(r, λ (n: Nat) (pass: Config) => inner.run(blocks, calls, n, pass), λ (n: Nat) (pass: Config) => inner.run(blocks2, calls2, n, pass),
                        λ n a b h => inner.run_renames(r, blocks, blocks2, written, calls, calls2, called, n, a, b, h),
                        parameters, exit, next, fuel, state, c.memory, renamed.memory, c.io, renamed.io, rel.memory, rel.io),
                    λ end end2 h => rewrite(h.state, ran_of_then(locals_renamed(r), config_renamed(r),
                        bind_values_renames(r, outputs, end.state, c.locals, renamed.locals, rel.locals),
                        λ l l2 hl => ConfigRenamed(locals := hl, memory := h.memory, io := h.io))))),
        Sys(call) => λ fuel c renamed rel => call.run_alike(r, blocks, blocks2, written, c, renamed, rel),
        Exit(status) => λ fuel c renamed rel => ⟨cong_fn<Valuation(), BitVec(64)>(λ ws => ws(64, status), rel.locals.words), rel.io⟩,
    }
}

// ---------------------------------------------------------------------------
// Routines and programs

theorem Routine::call_renames(self routine: Routine, r: Renaming, blocks, blocks2: Blocks, written: BlocksRenamed(r, blocks, blocks2),
    calls, calls2: Calls(), called: CallsRenamed(r, calls, calls2), fuel: Nat, args: List<Value>, m, renamed: Memory, rel: MemoryRenamed(r, m, renamed),
    io, io2: Io, same: io2 = io):
    RanRelated<Answer>(answer_renamed(r), routine.call(blocks, calls, fuel, args, m, io), routine.call(blocks2, calls2, fuel, rename_values(r, args), renamed, io2)) {
    ran_of_then(locals_renamed(r), answer_renamed(r),
        bind_values_renames(r, routine.parameters, args, Locals::empty(), Locals::empty(), LocalsRenamed::words_only(r, Valuation::zero())),
        λ l l2 hl => ran_then(config_renamed(r), answer_renamed(r),
            routine.body.run_renames(r, blocks, blocks2, written, calls, calls2, called, fuel, Config(l, m, io), Config(l2, renamed, io2),
                ConfigRenamed(locals := hl, memory := rel, io := same)),
            λ after after2 h => ran_of_map_then(answer_renamed(r), λ (xs: List<Value>) => rename_values(r, xs),
                read_values_renames(r, routine.results, after.locals, after2.locals, h.locals),
                λ words => AnswerRenamed(words := refl, heap := h.memory, io := h.io))))
}

theorem program_renames(routines: List<Routine>, r: Renaming, blocks, blocks2: Blocks, written: BlocksRenamed(r, blocks, blocks2), fuel: Nat):
    CallsRenamed(r, program_calls(routines, blocks, fuel), program_calls(routines, blocks2, fuel)) {
    match fuel {
        Zero => λ f args m renamed rel io io2 same => same,
        Succ(rest) => λ f args m renamed rel io io2 same => match routines.nth(f) as λ o => RanRelated<Answer>(answer_renamed(r),
                match o { None => Stuck, Some(routine) => routine.call(blocks, program_calls(routines, blocks, rest), rest, args, m, io) },
                match o { None => Stuck, Some(routine) => routine.call(blocks2, program_calls(routines, blocks2, rest), rest, rename_values(r, args), renamed, io2) }) {
            None => trivial,
            Some(routine) => routine.call_renames(r, blocks, blocks2, written, program_calls(routines, blocks, rest), program_calls(routines, blocks2, rest),
                program_renames(routines, r, blocks, blocks2, written, rest), rest, args, m, renamed, rel, io, io2, same),
        },
    }
}

// A run on a renamed heap, its arguments' references and its blocks
// renamed alike, is the run renamed: the meaning is unchanged by renaming
// blocks, at every fuel.
theorem run_renames(r: Renaming, p: Program, blocks, blocks2: Blocks, written: BlocksRenamed(r, blocks, blocks2), fuel, f: Nat, args: List<Value>,
    heap, renamed: Memory, rel: MemoryRenamed(r, heap, renamed), io: Io):
    RanRelated<Answer>(answer_renamed(r), run(p, blocks, fuel, f, args, heap, io), run(p, blocks2, fuel, f, rename_values(r, args), renamed, io)) {
    program_renames(p.routines, r, blocks, blocks2, written, fuel, f, args, heap, renamed, rel, io, io, refl)
}

// ---------------------------------------------------------------------------
// What a run shows

fn Value::word_part(self v: Value) → Option<BitVec(64)> { match v { Word(w) => Some(w), Ref(_) => None } }

fn word_parts(vs: List<Value>) → List<Option<BitVec(64)>> { match vs { Nil => Nil, Cons(v, rest) => Cons(v.word_part(), word_parts(rest)) } }

theorem word_parts_rename(r: Renaming, vs: List<Value>): word_parts(rename_values(r, vs)) = word_parts(vs) {
    match vs {
        Nil => refl,
        Cons(v, rest) => {
            let unfolded: (Cons(v.rename(r).word_part(), word_parts(rename_values(r, rest))) = Cons(v.word_part(), word_parts(rest))) =
                rewrite(word_parts_rename(r, rest), match v {
                    Word(_) => refl,
                    Ref(_) => refl,
                });
            unfolded
        },
    }
}

// What a run shows of itself apart from where its blocks are: the words it
// answers and the world it leaves, or how it exited, or the world so far.
record Shown { words: List<Option<BitVec(64)>>, io: Io }

fn shown(o: Ran<Answer>) → Ran<Shown> { o.then(λ (a: Answer) => Done(Shown(word_parts(a.words), a.io))) }

theorem related_shown(r: Renaming): (a, b: Ran<Answer>) → RanRelated<Answer>(answer_renamed(r), a, b) → shown(b) = shown(a) {
    λ a => match a {
        Done(x) => λ b => match b as λ bb => RanRelated<Answer>(answer_renamed(r), Done(x), bb) → shown(bb) = Done(Shown(word_parts(x.words), x.io)) {
            Done(y) => λ h => rewrite(h.words, word_parts_rename(r, x.words), h.io, refl),
            Exited(_, _) => λ never => false_elim(never),
            Going(_) => λ never => false_elim(never),
            Stuck => λ never => false_elim(never),
        },
        Exited(status, io) => λ b => match b as λ bb => RanRelated<Answer>(answer_renamed(r), Exited(status, io), bb) → shown(bb) = Exited(status, io) {
            Done(_) => λ never => false_elim(never),
            Exited(status2, io2) => λ h => rewrite(h.left, h.right, refl),
            Going(_) => λ never => false_elim(never),
            Stuck => λ never => false_elim(never),
        },
        Going(io) => λ b => match b as λ bb => RanRelated<Answer>(answer_renamed(r), Going(io), bb) → shown(bb) = Going(io) {
            Done(_) => λ never => false_elim(never),
            Exited(_, _) => λ never => false_elim(never),
            Going(io2) => λ (h: io2 = io) => rewrite(h, refl),
            Stuck => λ never => false_elim(never),
        },
        Stuck => λ b => match b as λ bb => RanRelated<Answer>(answer_renamed(r), Stuck, bb) → shown(bb) = Stuck {
            Done(_) => λ never => false_elim(never),
            Exited(_, _) => λ never => false_elim(never),
            Going(_) => λ never => false_elim(never),
            Stuck => λ _ => refl,
        },
    }
}

// So the words a run answers, how it ends and the world it leaves are the
// same under any renaming of the blocks it starts with, at every fuel.
theorem run_words_alike(r: Renaming, p: Program, blocks, blocks2: Blocks, written: BlocksRenamed(r, blocks, blocks2), fuel, f: Nat, args: List<Value>,
    heap, renamed: Memory, rel: MemoryRenamed(r, heap, renamed), io: Io):
    shown(run(p, blocks2, fuel, f, rename_values(r, args), renamed, io)) = shown(run(p, blocks, fuel, f, args, heap, io)) {
    related_shown(r, run(p, blocks, fuel, f, args, heap, io), run(p, blocks2, fuel, f, rename_values(r, args), renamed, io),
        run_renames(r, p, blocks, blocks2, written, fuel, f, args, heap, renamed, rel, io))
}

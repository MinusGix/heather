// The bytes level lowered to x86 (docs/language/ownership-design.md §17.6,
// issues/bytes-level-lowering.md): its nodes' code, each proved once over
// the frame and call theorems' memory clause at the contract's heap.
//
// - The clause (`heap_in`): the heap is injected into memory under the one
//   lending of `Site::Meets` (x86_64_memory_contract's `Injected`), its law
//   the loan's (`Loan::stable_injected`). The code of a node is proved as
//   `EmitsBy` of function_ir_lower_calls at state type `Heap` and this
//   clause, so the generic sequence, branch, call, loop and function
//   theorems there are cited at it, never restated.
// - The register invariant is FunctionIR's, unchanged (`File::Represents`,
//   `Held`), over one valuation for a routine's scope: a word id holds its
//   word, a reference id its target's address (`Value::lower`). The kind
//   does not reach the register file: a reference is held as a word, and a
//   node's facts say which word (`Locals::Agrees`, below).
// - A node's facts (`Instr::Holds`) are its meaning at that valuation over
//   the heap before and after it: a word node's FunctionIR equation, and a
//   memory node's take or put at the reference's location. Each memory node
//   lowers to one instruction through the register holding the reference's
//   address, proved from the contract's lemma for its operation at its width
//   (`Injected::byte_read`, `dword_read`, `word_read`, `ref_read`;
//   `Loan::store_injected`, `store_ref_injected`) and the node's site fact,
//   which is its meaning being defined.
import bytes_memory;
import bytes_level;
import x86_64_memory_contract;
import x86_64_call_contract;
import function_ir;
import function_ir_eval;
import function_ir_state;
import function_ir_lower;
import function_ir_lower_structured;
import function_ir_lower_reads;
import function_ir_lower_calls;
import linux_world;
import linux_x86_64_io;
import x86_64;
import x86_64_block;
import x86_64_fetch;
import x86_64_data_read;
import x86_64_fetched_code;
import x86_64_layout;
import x86_64_store;
import x86_64_stack;
import x86_64_kept;
import x86_64_asm;
import x86_64_asm_runs;
import x86_64_stack_runs;
import bitvec;
import bool;
import list;
import logic;
import nat;
import option;
import omega;

// ---------------------------------------------------------------------------
// Words of bytes, as the machine reads them

// A byte past a list's end reads zero.
theorem byte_at_past(bytes: List<BitVec(8)>): (k: Nat) → bytes.len() <= k → byte_at(bytes, k) = BitVec::zero() {
    match bytes {
        Nil => λ k _ => refl,
        Cons(_, rest) => λ k past => match k {
            Zero => false_elim(omega(past)),
            Succ(j) => byte_at_past(rest, j, omega(past)),
        },
    }
}

// One byte, zero-extended: `MOVZX`.
theorem word_of_one(bytes: List<BitVec(8)>, len: bytes.len() = 1): word_of_bytes(bytes) = byte_at(bytes, 0).zero_extend(56) {
    let z = λ (k: Nat) (low: 1 <= k) => byte_at_past(bytes, k, omega(len, low));
    rewrite(z(1, trivial), z(2, trivial), z(3, trivial), z(4, trivial), z(5, trivial), z(6, trivial), z(7, trivial), refl)
}

// Four bytes, their doubleword zero-extended: `MOV r32`.
theorem word_of_four(bytes: List<BitVec(8)>, len: bytes.len() = 4):
    word_of_bytes(bytes) = imm32_from_bytes(byte_at(bytes, 0), byte_at(bytes, 1), byte_at(bytes, 2), byte_at(bytes, 3)).zero_extend(32) {
    let z = λ (k: Nat) (low: 4 <= k) => byte_at_past(bytes, k, omega(len, low));
    rewrite(z(4, trivial), z(5, trivial), z(6, trivial), z(7, trivial), refl)
}

// ---------------------------------------------------------------------------
// The memory clause

// The heap is injected into memory over the lending's spans.
fn heap_in<M>(data: ByteReadAccess<M>, spans: Spans) → Heap → M → Type {
    λ (heap: Heap) (memory: M) => Injected<M>(data, spans, heap, memory)
}

// Its law, from the loan.
theorem heap_in_stable<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, stack: Stack<M>(fetch, data), top: Nat, spans: Spans,
    loan: Loan<M>(fetch, data, stack, top, spans)): stack.ClauseStable(top, heap_in<M>(data, spans)) {
    λ heap => loan.stable_injected(top, top.le_refl(), heap)
}

// What a node's code proves: `EmitsBy` at the heap and its injection.
fn EmitsHeap<M>(saves: Nat, site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, values: Valuation(), d: Nat,
    s0: MachineState<M>, prog: Prog, file: File, facts: Type, before, after: Heap, out: Emitted) → Type {
    EmitsBy<M, Heap>(saves, site, stack, spans, heap_in<M>(site.data, spans), values, d, s0, prog, file, facts, before, after, out)
}

// ---------------------------------------------------------------------------
// Loads

// A load's meaning at the valuation: `place` holds a reference's address,
// the `n` plain, defined bytes there are read, and `output` is their word.
fn Loads(spans: Spans, values: Valuation(), heap: Heap, n, output, place: Nat) → Type {
    Exists<Loc>(λ loc => (values(64, place) = loc.address(spans)) ∧
        Exists<List<BitVec(8)>>(λ bytes => (heap.read_bytes(loc, n) = Some(bytes)) ∧ (values(64, output) = word_of_bytes(bytes))))
}

// A word written into a register the body may write, memory untouched: the
// file names it, and the trail is kept.
theorem written_leaves<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, saves: Nat, stack: Stack<M>(fetch, data), spans: Spans,
    Mem: Heap → M → Type, values: Valuation(), d: Nat, s0: MachineState<M>, now: Heap, file: File, destination: Gpr, output: Nat,
    x: BitVec(64), apart: destination.apart(body_kept(saves)).IsTrue(), s: MachineState<M>, flags: Flags, rip: BitVec(64),
    rep: file.Represents(values, s.gprs), trailed: stack.TrailedBy(saves, spans, Mem, d, s0, now, s), named: values(64, output) = x):
    file.write(destination, Some(Held(output, Word))).Represents(values, write_gpr(destination, x, s.gprs)) ∧
        stack.TrailedBy(saves, spans, Mem, d, s0, now, MachineState(write_gpr(destination, x, s.gprs), flags, rip, s.memory)) {
    ⟨file.represents_write(values, s.gprs, destination, Some(Held(output, Word)), x, rep, named),
     ⟨kept_trans(body_kept(saves), s0.gprs, s.gprs, write_gpr(destination, x, s.gprs), trailed.left,
        kept_write(body_kept(saves), destination, x, s.gprs, apart)), trailed.right⟩⟩
}

// Where a load's facts hold, the base register holds the address of a
// location whose bytes are in their span: the register, the location and
// the contract's injection, read off the state the code starts in.
theorem Loads::at<M>(spans: Spans, values: Valuation(), heap: Heap, place: Nat, file: File, base: Gpr, found: FoundAt(file, Held(place, Word), base),
    gprs: Gprs, rep: file.Represents(values, gprs), loc: Loc, addressed: values(64, place) = loc.address(spans)): read_gpr(base, gprs) = loc.address(spans) {
    trans(sym(found.rep(values, gprs, rep)), addressed)
}

// `n` bytes inside a span lie below the canonical boundary.
theorem Loan::below<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, {stack: Stack<M>(fetch, data)}, {top: Nat}, {spans: Spans},
    self loan: Loan<M>(fetch, data, stack, top, spans), loc: Loc, n: Nat, fits: loc.offset + n <= spans.size(loc.block)):
    loc.address(spans).toNat() + n <= Nat::pow(2, 47) {
    loan.canonical_at(loc.block, loc.offset, n, fits)
}

// The pre- and postcondition every node's code is proved between.
fn HeapPre<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, saves: Nat, stack: Stack<M>(fetch, data), spans: Spans, values: Valuation(),
    d: Nat, s0: MachineState<M>, file: File, facts: Type, now: Heap) → MachineState<M> → Type {
    λ (s: MachineState<M>) => (file.Represents(values, s.gprs) ∧ facts) ∧ stack.TrailedBy(saves, spans, heap_in<M>(data, spans), d, s0, now, s)
}

// A byte loaded: `MOVZX destination, byte [base]`.
theorem load_byte_emits<M>(saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), top: Nat,
    spans: Spans, loan: Loan<M>(site.fetch, site.data, stack, top, spans), values: Valuation(), d: Nat, s0: MachineState<M>, prog: Prog,
    file: File, output, place: Nat, base, destination: Gpr, found: FoundAt(file, Held(place, Word), base),
    apart: destination.apart(body_kept(saves)).IsTrue(), placement: List<Place>, names: Nat, heap: Heap):
    EmitsHeap<M>(saves, site, stack, spans, values, d, s0, prog, file, Loads(spans, values, heap, 1, output, place), heap, heap,
        Emitted(At(prog, 0, LoadByte(ByteLoad(destination, base))), file.write(destination, Some(Held(output, Word))), placement, names)) {
    let load = ByteLoad(destination, base);
    let out_file = file.write(destination, Some(Held(output, Word)));
    let facts = Loads(spans, values, heap, 1, output, place);
    ⟨prog.within_then(0, LoadByte(load)),
     λ within => site.moves_load_byte(stack.writes, site.program.laid_out_fits(laid), within.witness, prog, 0, load, within.proof,
        HeapPre<M>(saves, stack, spans, values, d, s0, file, facts, heap),
        λ (t: MachineState<M>) => out_file.Represents(values, t.gprs) ∧ stack.TrailedBy(saves, spans, heap_in<M>(site.data, spans), d, s0, heap, t),
        λ s held => {
            let loads = held.left.right;
            let loc = loads.witness;
            let bytes = loads.proof.right.witness;
            let read = loads.proof.right.proof.left;
            let inj: Injected<M>(site.data, spans, heap, s.memory) = held.right.right.right;
            let got = inj.byte_read(loc, bytes, read);
            let at = Loads::at<M>(spans, values, heap, place, file, base, found, s.gprs, held.left.left, loc, loads.proof.left);
            let low = loan.below(loc, 1, got.left);
            let byte = byte_at(bytes, 0);
            Exists(byte, ⟨j(sym(at), λ x _ => x.toNat() < Nat::pow(2, 47), omega(low)),
                ⟨j(sym(at), λ x _ => site.data.read(s.memory, x) = Some(byte), got.right),
                 written_leaves<M>(saves, stack, spans, heap_in<M>(site.data, spans), values, d, s0, heap, file, destination, output, byte.zero_extend(56),
                    apart, s, s.flags, next_rip(s.rip, byte_load_bytes(load).len()), held.left.left, held.right,
                    trans(loads.proof.right.proof.right, word_of_one(bytes, heap.read_bytes_len(loc, 1, bytes, read))))⟩⟩)
        })⟩
}

// Four bytes loaded: `MOV destination32, dword [base]`.
theorem load_dword_emits<M>(saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), top: Nat,
    spans: Spans, loan: Loan<M>(site.fetch, site.data, stack, top, spans), values: Valuation(), d: Nat, s0: MachineState<M>, prog: Prog,
    file: File, output, place: Nat, base, destination: Gpr, found: FoundAt(file, Held(place, Word), base),
    apart: destination.apart(body_kept(saves)).IsTrue(), placement: List<Place>, names: Nat, heap: Heap):
    EmitsHeap<M>(saves, site, stack, spans, values, d, s0, prog, file, Loads(spans, values, heap, 4, output, place), heap, heap,
        Emitted(At(prog, 0, asm_dword_load(DwordLoad(destination, base))), file.write(destination, Some(Held(output, Word))), placement, names)) {
    let load = DwordLoad(destination, base);
    let out_file = file.write(destination, Some(Held(output, Word)));
    let facts = Loads(spans, values, heap, 4, output, place);
    ⟨prog.within_then(0, asm_dword_load(load)),
     λ within => site.moves_dword_load(stack.writes, site.program.laid_out_fits(laid), within.witness, prog, 0, load, within.proof,
        HeapPre<M>(saves, stack, spans, values, d, s0, file, facts, heap),
        λ (t: MachineState<M>) => out_file.Represents(values, t.gprs) ∧ stack.TrailedBy(saves, spans, heap_in<M>(site.data, spans), d, s0, heap, t),
        λ s held => {
            let loads = held.left.right;
            let loc = loads.witness;
            let bytes = loads.proof.right.witness;
            let read = loads.proof.right.proof.left;
            let inj: Injected<M>(site.data, spans, heap, s.memory) = held.right.right.right;
            let got = inj.dword_read(loc, bytes, read);
            let at = Loads::at<M>(spans, values, heap, place, file, base, found, s.gprs, held.left.left, loc, loads.proof.left);
            let dword = imm32_from_bytes(byte_at(bytes, 0), byte_at(bytes, 1), byte_at(bytes, 2), byte_at(bytes, 3));
            Exists(dword, ⟨j(sym(at), λ x _ => x.toNat() + 4 <= Nat::pow(2, 47), loan.below(loc, 4, got.left)),
                ⟨j(sym(at), λ x _ => read_dword(site.data, s.memory, x) = Some(dword), got.right),
                 written_leaves<M>(saves, stack, spans, heap_in<M>(site.data, spans), values, d, s0, heap, file, destination, output, dword.zero_extend(32),
                    apart, s, s.flags, next_rip(s.rip, dword_load_bytes(load).len()), held.left.left, held.right,
                    trans(loads.proof.right.proof.right, word_of_four(bytes, heap.read_bytes_len(loc, 4, bytes, read))))⟩⟩)
        })⟩
}

// Eight bytes loaded: `MOV destination, qword [base]`.
theorem load_word_emits<M>(saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), top: Nat,
    spans: Spans, loan: Loan<M>(site.fetch, site.data, stack, top, spans), values: Valuation(), d: Nat, s0: MachineState<M>, prog: Prog,
    file: File, output, place: Nat, base, destination: Gpr, found: FoundAt(file, Held(place, Word), base),
    apart: destination.apart(body_kept(saves)).IsTrue(), placement: List<Place>, names: Nat, heap: Heap):
    EmitsHeap<M>(saves, site, stack, spans, values, d, s0, prog, file, Loads(spans, values, heap, 8, output, place), heap, heap,
        Emitted(At(prog, 0, Load(WordLoad(destination, base))), file.write(destination, Some(Held(output, Word))), placement, names)) {
    let load = WordLoad(destination, base);
    let out_file = file.write(destination, Some(Held(output, Word)));
    let facts = Loads(spans, values, heap, 8, output, place);
    ⟨prog.within_then(0, Load(load)),
     λ within => site.moves_word_load(stack.writes, site.program.laid_out_fits(laid), within.witness, prog, 0, load, within.proof,
        HeapPre<M>(saves, stack, spans, values, d, s0, file, facts, heap),
        λ (t: MachineState<M>) => out_file.Represents(values, t.gprs) ∧ stack.TrailedBy(saves, spans, heap_in<M>(site.data, spans), d, s0, heap, t),
        λ s held => {
            let loads = held.left.right;
            let loc = loads.witness;
            let bytes = loads.proof.right.witness;
            let read = loads.proof.right.proof.left;
            let inj: Injected<M>(site.data, spans, heap, s.memory) = held.right.right.right;
            let got = inj.word_read(loc, bytes, read);
            let at = Loads::at<M>(spans, values, heap, place, file, base, found, s.gprs, held.left.left, loc, loads.proof.left);
            let word = word_of_bytes(bytes);
            Exists(word, ⟨j(sym(at), λ x _ => x.toNat() + 8 <= Nat::pow(2, 47), loan.below(loc, 8, got.left)),
                ⟨j(sym(at), λ x _ => read_word(site.data, s.memory, x) = Some(word), got.right),
                 written_leaves<M>(saves, stack, spans, heap_in<M>(site.data, spans), values, d, s0, heap, file, destination, output, word,
                    apart, s, s.flags, next_rip(s.rip, word_load_bytes(load).len()), held.left.left, held.right, loads.proof.right.proof.right)⟩⟩)
        })⟩
}

// A reference's load's meaning: `place` holds a reference's address, a
// reference is held at its eight bytes, and `output` is its target's
// address.
fn LoadsRef(spans: Spans, values: Valuation(), heap: Heap, output, place: Nat) → Type {
    Exists<Loc>(λ loc => (values(64, place) = loc.address(spans)) ∧
        Exists<Loc>(λ target => (heap.load_ref(loc) = Some(target)) ∧ (values(64, output) = target.address(spans))))
}

// A reference loaded: the same `MOV` as a word's, reading its target's
// address (`Injected::ref_read`).
theorem load_ref_emits<M>(saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), top: Nat,
    spans: Spans, loan: Loan<M>(site.fetch, site.data, stack, top, spans), values: Valuation(), d: Nat, s0: MachineState<M>, prog: Prog,
    file: File, output, place: Nat, base, destination: Gpr, found: FoundAt(file, Held(place, Word), base),
    apart: destination.apart(body_kept(saves)).IsTrue(), placement: List<Place>, names: Nat, heap: Heap):
    EmitsHeap<M>(saves, site, stack, spans, values, d, s0, prog, file, LoadsRef(spans, values, heap, output, place), heap, heap,
        Emitted(At(prog, 0, Load(WordLoad(destination, base))), file.write(destination, Some(Held(output, Word))), placement, names)) {
    let load = WordLoad(destination, base);
    let out_file = file.write(destination, Some(Held(output, Word)));
    let facts = LoadsRef(spans, values, heap, output, place);
    ⟨prog.within_then(0, Load(load)),
     λ within => site.moves_word_load(stack.writes, site.program.laid_out_fits(laid), within.witness, prog, 0, load, within.proof,
        HeapPre<M>(saves, stack, spans, values, d, s0, file, facts, heap),
        λ (t: MachineState<M>) => out_file.Represents(values, t.gprs) ∧ stack.TrailedBy(saves, spans, heap_in<M>(site.data, spans), d, s0, heap, t),
        λ s held => {
            let loads = held.left.right;
            let loc = loads.witness;
            let target = loads.proof.right.witness;
            let inj: Injected<M>(site.data, spans, heap, s.memory) = held.right.right.right;
            let got = inj.ref_read(loc, target, loads.proof.right.proof.left);
            let at = Loads::at<M>(spans, values, heap, place, file, base, found, s.gprs, held.left.left, loc, loads.proof.left);
            let word = target.address(spans);
            Exists(word, ⟨j(sym(at), λ x _ => x.toNat() + 8 <= Nat::pow(2, 47), loan.below(loc, 8, got.left)),
                ⟨j(sym(at), λ x _ => read_word(site.data, s.memory, x) = Some(word), got.right),
                 written_leaves<M>(saves, stack, spans, heap_in<M>(site.data, spans), values, d, s0, heap, file, destination, output, word,
                    apart, s, s.flags, next_rip(s.rip, word_load_bytes(load).len()), held.left.left, held.right, loads.proof.right.proof.right)⟩⟩)
        })⟩
}

// ---------------------------------------------------------------------------
// Stores

// A store's meaning at the valuation: `place` holds a reference's address,
// and the low `n` bytes of the word `value` are put there.
fn Stores(spans: Spans, values: Valuation(), blocks: Blocks, heap, after: Heap, n, place, value: Nat) → Type {
    Exists<Loc>(λ loc => (values(64, place) = loc.address(spans)) ∧
        (heap.put(blocks.written, loc, Piece::plain(low_bytes(n, values(64, value)))) = Some(after)))
}

// A reference's store's: `place` holds a reference's address and `value`
// its target's, and the reference is put there.
fn StoresRef(spans: Spans, values: Valuation(), blocks: Blocks, heap, after: Heap, place, value: Nat) → Type {
    Exists<Loc>(λ loc => (values(64, place) = loc.address(spans)) ∧
        Exists<Loc>(λ target => (values(64, value) = target.address(spans)) ∧ (heap.put(blocks.written, loc, Piece::reference(target)) = Some(after))))
}

// Bytes the run puts at `loc` are a store the lending allows: writable, the
// code kept, and after it the trail is kept with the heap the put leaves
// injected. The registers are untouched.
theorem stored_leaves<M>(saves: Nat, site: Site<M>, stack: Stack<M>(site.fetch, site.data), top: Nat, spans: Spans,
    loan: Loan<M>(site.fetch, site.data, stack, top, spans), blocks: Blocks, lent: blocks.Lent(spans), values: Valuation(), d: Nat,
    s0: MachineState<M>, heap, after: Heap, loc: Loc, bytes: List<BitVec(8)>, some: 1 <= bytes.len(), put: heap.put(blocks.written, loc, Piece::plain(bytes)) = Some(after),
    s: MachineState<M>, resident: site.Resident(s.memory),
    trailed: stack.TrailedBy(saves, spans, heap_in<M>(site.data, spans), d, s0, heap, s), flags: Flags, rip: BitVec(64)):
    stack.writes.writable(s.memory, loc.address(spans), bytes.len()) ∧
        (site.Resident(stack.writes.store(s.memory, loc.address(spans), bytes)) ∧
            stack.TrailedBy(saves, spans, heap_in<M>(site.data, spans), d, s0, after,
                MachineState(s.gprs, flags, rip, stack.writes.store(s.memory, loc.address(spans), bytes)))) {
    let inj: Injected<M>(site.data, spans, heap, s.memory) = trailed.right.right;
    let facts = heap.put_lent(blocks, spans, lent, inj.sizes, loc, Piece::plain(bytes), after, put);
    let written = facts.left;
    let span_fits: (loc.offset + bytes.len() <= spans.size(loc.block)) = facts.right.left;
    let ok: (heap.fits(loc, bytes.len()) = True) = heap.put_some(blocks.written, loc, Piece::plain(bytes), after, put).right.left;
    let inside: (loc.offset < spans.size(loc.block)) = omega(span_fits, some);
    ⟨loan.writable(s.memory, loc.block, loc.offset, written, inside, bytes, span_fits),
     ⟨loan.keeps_code(s.memory, loc.block, loc.offset, written, inside, bytes, span_fits, assemble(no_fills(), site.program, site.last),
        next_rip(site.origin, 0), resident),
      ⟨trailed.left,
       ⟨stack.wrote_in_trans(d, spans, s0.memory, s.memory, stack.writes.store(s.memory, loc.address(spans), bytes), trailed.right.left,
            stack.wrote_in_store(d, spans, s.memory, loc.block, loc.offset, written, inside, bytes, span_fits)),
        j(facts.right.right, λ a _ => Injected<M>(site.data, spans, a, stack.writes.store(s.memory, loc.address(spans), bytes)),
            loan.store_injected(heap, s.memory, inj, loc, written, inside, bytes, ok))⟩⟩⟩⟩
}

// A byte stored: `MOV byte [base], source8`.
theorem store_byte_emits<M>(saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), top: Nat,
    spans: Spans, loan: Loan<M>(site.fetch, site.data, stack, top, spans), blocks: Blocks, lent: blocks.Lent(spans), values: Valuation(), d: Nat,
    s0: MachineState<M>, prog: Prog, file: File, place, value: Nat, base, source: Gpr, at_place: FoundAt(file, Held(place, Word), base),
    at_value: FoundAt(file, Held(value, Word), source), plain: store_base_plain(base) = True, placement: List<Place>, names: Nat, heap, after: Heap):
    EmitsHeap<M>(saves, site, stack, spans, values, d, s0, prog, file, Stores(spans, values, blocks, heap, after, 1, place, value), heap, after,
        Emitted(At(prog, 0, StoreByte(ByteStore(base, source))), file, placement, names)) {
    let store = ByteStore(base, source);
    let facts = Stores(spans, values, blocks, heap, after, 1, place, value);
    ⟨prog.within_then(0, StoreByte(store)),
     λ within => site.moves_store_byte(stack.writes, site.program.laid_out_fits(laid), within.witness, prog, 0, store, within.proof,
        HeapPre<M>(saves, stack, spans, values, d, s0, file, facts, heap),
        λ (t: MachineState<M>) => file.Represents(values, t.gprs) ∧ stack.TrailedBy(saves, spans, heap_in<M>(site.data, spans), d, s0, after, t),
        λ s held resident => {
            let stores = held.left.right;
            let loc = stores.witness;
            let at = Loads::at<M>(spans, values, heap, place, file, base, at_place, s.gprs, held.left.left, loc, stores.proof.left);
            let word: (values(64, value) = read_gpr(source, s.gprs)) = at_value.rep(values, s.gprs, held.left.left);
            let rip = next_rip(s.rip, 3);
            let goal = λ (x: BitVec(64)) (w: BitVec(64)) => stack.writes.writable(s.memory, x, 1) ∧
                (site.Resident(stack.writes.store(s.memory, x, low_bytes(1, w))) ∧
                    (file.Represents(values, s.gprs) ∧ stack.TrailedBy(saves, spans, heap_in<M>(site.data, spans), d, s0, after,
                        MachineState(s.gprs, s.flags, rip, stack.writes.store(s.memory, x, low_bytes(1, w))))));
            let left = stored_leaves<M>(saves, site, stack, top, spans, loan, blocks, lent, values, d, s0, heap, after, loc,
                low_bytes(1, values(64, value)), Nat::le_refl(1), stores.proof.right, s, resident, held.right, s.flags, rip);
            let done: goal(loc.address(spans), values(64, value)) = ⟨left.left, ⟨left.right.left, ⟨held.left.left, left.right.right⟩⟩⟩;
            ⟨plain, j(word, λ w _ => goal(read_gpr(base, s.gprs), w), j(sym(at), λ x _ => goal(x, values(64, value)), done))⟩
        })⟩
}

// Four bytes stored: `MOV dword [base], source32`.
theorem store_dword_emits<M>(saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), top: Nat,
    spans: Spans, loan: Loan<M>(site.fetch, site.data, stack, top, spans), blocks: Blocks, lent: blocks.Lent(spans), values: Valuation(), d: Nat,
    s0: MachineState<M>, prog: Prog, file: File, place, value: Nat, base, source: Gpr, at_place: FoundAt(file, Held(place, Word), base),
    at_value: FoundAt(file, Held(value, Word), source), plain: store_base_plain(base) = True, placement: List<Place>, names: Nat, heap, after: Heap):
    EmitsHeap<M>(saves, site, stack, spans, values, d, s0, prog, file, Stores(spans, values, blocks, heap, after, 4, place, value), heap, after,
        Emitted(At(prog, 0, asm_dword_store(DwordStore(base, source))), file, placement, names)) {
    let store = DwordStore(base, source);
    let facts = Stores(spans, values, blocks, heap, after, 4, place, value);
    ⟨prog.within_then(0, asm_dword_store(store)),
     λ within => site.moves_dword_store(stack.writes, site.program.laid_out_fits(laid), within.witness, prog, 0, store, within.proof,
        HeapPre<M>(saves, stack, spans, values, d, s0, file, facts, heap),
        λ (t: MachineState<M>) => file.Represents(values, t.gprs) ∧ stack.TrailedBy(saves, spans, heap_in<M>(site.data, spans), d, s0, after, t),
        λ s held resident => {
            let stores = held.left.right;
            let loc = stores.witness;
            let at = Loads::at<M>(spans, values, heap, place, file, base, at_place, s.gprs, held.left.left, loc, stores.proof.left);
            let word: (values(64, value) = read_gpr(source, s.gprs)) = at_value.rep(values, s.gprs, held.left.left);
            let rip = next_rip(s.rip, 3);
            let goal = λ (x: BitVec(64)) (w: BitVec(64)) => stack.writes.writable(s.memory, x, 4) ∧
                (site.Resident(stack.writes.store(s.memory, x, low_bytes(4, w))) ∧
                    (file.Represents(values, s.gprs) ∧ stack.TrailedBy(saves, spans, heap_in<M>(site.data, spans), d, s0, after,
                        MachineState(s.gprs, s.flags, rip, stack.writes.store(s.memory, x, low_bytes(4, w))))));
            let left = stored_leaves<M>(saves, site, stack, top, spans, loan, blocks, lent, values, d, s0, heap, after, loc,
                low_bytes(4, values(64, value)), omega(), stores.proof.right, s, resident, held.right, s.flags, rip);
            let done: goal(loc.address(spans), values(64, value)) = ⟨left.left, ⟨left.right.left, ⟨held.left.left, left.right.right⟩⟩⟩;
            ⟨plain, j(word, λ w _ => goal(read_gpr(base, s.gprs), w), j(sym(at), λ x _ => goal(x, values(64, value)), done))⟩
        })⟩
}

// Eight bytes stored: `MOV qword [base], source`.
theorem store_word_emits<M>(saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), top: Nat,
    spans: Spans, loan: Loan<M>(site.fetch, site.data, stack, top, spans), blocks: Blocks, lent: blocks.Lent(spans), values: Valuation(), d: Nat,
    s0: MachineState<M>, prog: Prog, file: File, place, value: Nat, base, source: Gpr, at_place: FoundAt(file, Held(place, Word), base),
    at_value: FoundAt(file, Held(value, Word), source), plain: store_base_plain(base) = True, placement: List<Place>, names: Nat, heap, after: Heap):
    EmitsHeap<M>(saves, site, stack, spans, values, d, s0, prog, file, Stores(spans, values, blocks, heap, after, 8, place, value), heap, after,
        Emitted(At(prog, 0, asm_word_store(WordStore(base, source))), file, placement, names)) {
    let store = WordStore(base, source);
    let facts = Stores(spans, values, blocks, heap, after, 8, place, value);
    ⟨prog.within_then(0, asm_word_store(store)),
     λ within => site.moves_word_store(stack.writes, site.program.laid_out_fits(laid), within.witness, prog, 0, store, within.proof,
        HeapPre<M>(saves, stack, spans, values, d, s0, file, facts, heap),
        λ (t: MachineState<M>) => file.Represents(values, t.gprs) ∧ stack.TrailedBy(saves, spans, heap_in<M>(site.data, spans), d, s0, after, t),
        λ s held resident => {
            let stores = held.left.right;
            let loc = stores.witness;
            let at = Loads::at<M>(spans, values, heap, place, file, base, at_place, s.gprs, held.left.left, loc, stores.proof.left);
            let word: (values(64, value) = read_gpr(source, s.gprs)) = at_value.rep(values, s.gprs, held.left.left);
            let rip = next_rip(s.rip, 3);
            let goal = λ (x: BitVec(64)) (w: BitVec(64)) => stack.writes.writable(s.memory, x, 8) ∧
                (site.Resident(stack.writes.store(s.memory, x, low_bytes(8, w))) ∧
                    (file.Represents(values, s.gprs) ∧ stack.TrailedBy(saves, spans, heap_in<M>(site.data, spans), d, s0, after,
                        MachineState(s.gprs, s.flags, rip, stack.writes.store(s.memory, x, low_bytes(8, w))))));
            let left = stored_leaves<M>(saves, site, stack, top, spans, loan, blocks, lent, values, d, s0, heap, after, loc,
                low_bytes(8, values(64, value)), omega(), stores.proof.right, s, resident, held.right, s.flags, rip);
            let done: goal(loc.address(spans), values(64, value)) = ⟨left.left, ⟨left.right.left, ⟨held.left.left, left.right.right⟩⟩⟩;
            ⟨plain, j(word, λ w _ => goal(read_gpr(base, s.gprs), w), j(sym(at), λ x _ => goal(x, values(64, value)), done))⟩
        })⟩
}

// A reference the run puts at `loc` is the machine's store of its
// target's address: the same store as a word's, the shadow telling
// (`Loan::store_ref_injected`).
theorem stored_ref_leaves<M>(saves: Nat, site: Site<M>, stack: Stack<M>(site.fetch, site.data), top: Nat, spans: Spans,
    loan: Loan<M>(site.fetch, site.data, stack, top, spans), blocks: Blocks, lent: blocks.Lent(spans), values: Valuation(), d: Nat,
    s0: MachineState<M>, heap, after: Heap, loc, target: Loc, put: heap.put(blocks.written, loc, Piece::reference(target)) = Some(after),
    s: MachineState<M>, resident: site.Resident(s.memory),
    trailed: stack.TrailedBy(saves, spans, heap_in<M>(site.data, spans), d, s0, heap, s), flags: Flags, rip: BitVec(64)):
    stack.writes.writable(s.memory, loc.address(spans), 8) ∧
        (site.Resident(stack.writes.store(s.memory, loc.address(spans), word_bytes(target.address(spans)))) ∧
            stack.TrailedBy(saves, spans, heap_in<M>(site.data, spans), d, s0, after,
                MachineState(s.gprs, flags, rip, stack.writes.store(s.memory, loc.address(spans), word_bytes(target.address(spans)))))) {
    let bytes = word_bytes(target.address(spans));
    let inj: Injected<M>(site.data, spans, heap, s.memory) = trailed.right.right;
    let facts = heap.put_lent(blocks, spans, lent, inj.sizes, loc, Piece::reference(target), after, put);
    let written = facts.left;
    let span_fits: (loc.offset + 8 <= spans.size(loc.block)) = facts.right.left;
    let ok: (heap.fits(loc, 8) = True) = heap.put_some(blocks.written, loc, Piece::reference(target), after, put).right.left;
    let inside: (loc.offset < spans.size(loc.block)) = omega(span_fits);
    ⟨loan.writable(s.memory, loc.block, loc.offset, written, inside, bytes, span_fits),
     ⟨loan.keeps_code(s.memory, loc.block, loc.offset, written, inside, bytes, span_fits, assemble(no_fills(), site.program, site.last),
        next_rip(site.origin, 0), resident),
      ⟨trailed.left,
       ⟨stack.wrote_in_trans(d, spans, s0.memory, s.memory, stack.writes.store(s.memory, loc.address(spans), bytes), trailed.right.left,
            stack.wrote_in_store(d, spans, s.memory, loc.block, loc.offset, written, inside, bytes, span_fits)),
        j(facts.right.right, λ a _ => Injected<M>(site.data, spans, a, stack.writes.store(s.memory, loc.address(spans), bytes)),
            loan.store_ref_injected(heap, s.memory, inj, loc, written, ok, target))⟩⟩⟩⟩
}

// A reference stored: `MOV qword [base], source`, the source holding its
// target's address.
theorem store_ref_emits<M>(saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), top: Nat,
    spans: Spans, loan: Loan<M>(site.fetch, site.data, stack, top, spans), blocks: Blocks, lent: blocks.Lent(spans), values: Valuation(), d: Nat,
    s0: MachineState<M>, prog: Prog, file: File, place, value: Nat, base, source: Gpr, at_place: FoundAt(file, Held(place, Word), base),
    at_value: FoundAt(file, Held(value, Word), source), plain: store_base_plain(base) = True, placement: List<Place>, names: Nat, heap, after: Heap):
    EmitsHeap<M>(saves, site, stack, spans, values, d, s0, prog, file, StoresRef(spans, values, blocks, heap, after, place, value), heap, after,
        Emitted(At(prog, 0, asm_word_store(WordStore(base, source))), file, placement, names)) {
    let store = WordStore(base, source);
    let facts = StoresRef(spans, values, blocks, heap, after, place, value);
    ⟨prog.within_then(0, asm_word_store(store)),
     λ within => site.moves_word_store(stack.writes, site.program.laid_out_fits(laid), within.witness, prog, 0, store, within.proof,
        HeapPre<M>(saves, stack, spans, values, d, s0, file, facts, heap),
        λ (t: MachineState<M>) => file.Represents(values, t.gprs) ∧ stack.TrailedBy(saves, spans, heap_in<M>(site.data, spans), d, s0, after, t),
        λ s held resident => {
            let stores = held.left.right;
            let loc = stores.witness;
            let target = stores.proof.right.witness;
            let at = Loads::at<M>(spans, values, heap, place, file, base, at_place, s.gprs, held.left.left, loc, stores.proof.left);
            let word: (target.address(spans) = read_gpr(source, s.gprs)) =
                trans(sym(stores.proof.right.proof.left), at_value.rep(values, s.gprs, held.left.left));
            let rip = next_rip(s.rip, 3);
            let goal = λ (x: BitVec(64)) (w: BitVec(64)) => stack.writes.writable(s.memory, x, 8) ∧
                (site.Resident(stack.writes.store(s.memory, x, word_bytes(w))) ∧
                    (file.Represents(values, s.gprs) ∧ stack.TrailedBy(saves, spans, heap_in<M>(site.data, spans), d, s0, after,
                        MachineState(s.gprs, s.flags, rip, stack.writes.store(s.memory, x, word_bytes(w))))));
            let left = stored_ref_leaves<M>(saves, site, stack, top, spans, loan, blocks, lent, values, d, s0, heap, after, loc, target,
                stores.proof.right.proof.right, s, resident, held.right, s.flags, rip);
            let done: goal(loc.address(spans), target.address(spans)) = ⟨left.left, ⟨left.right.left, ⟨held.left.left, left.right.right⟩⟩⟩;
            ⟨plain, j(word, λ w _ => goal(read_gpr(base, s.gprs), w), j(sym(at), λ x _ => goal(x, target.address(spans)), done))⟩
        })⟩
}

// ---------------------------------------------------------------------------
// An offset is a word node

// An offset's meaning at the valuation: `place` holds a reference's address,
// and `output` the address `amount` bytes on in its block.
fn Offsets(spans: Spans, values: Valuation(), output, place, amount: Nat) → Type {
    Exists<Loc>(λ loc => (values(64, place) = loc.address(spans)) ∧
        (values(64, output) = Loc(loc.block, loc.offset + values(64, amount).toNat()).address(spans)))
}

// Where it holds, so does the word node adding the two words: a reference
// is its target's address, and `amount` bytes on is `amount` added. So an
// offset is lowered as FunctionIR's `ADD`.
theorem offset_adds(spans: Spans, values: Valuation(), output, place, amount: Nat, offsets: Offsets(spans, values, output, place, amount)):
    NodeHolds(values, Add(64, output, place, amount)) {
    let loc = offsets.witness;
    let a = values(64, amount);
    trans(offsets.proof.right,
        trans(sym(rip_compose(spans.at(loc.block), loc.offset, a.toNat())),
            trans(cong_fn<BitVec(64), BitVec(64)>(λ x => next_rip(x, a.toNat()), sym(offsets.proof.left)),
                BitVec::iter_add_eq_add(64, values(64, place), a))))
}

// ---------------------------------------------------------------------------
// A block of word nodes

// Word nodes as FunctionIR lowers them (`lower_nodes`), as one block the
// body's kept registers survive, or nothing.
fn emit_word_nodes(saves: Nat, prog: Prog, file: File, nodes: List<Node>, placement: List<Place>, names: Nat) → Option<Emitted> {
    match lower_nodes(nodes, placement, file) {
        None => None,
        Some(l) => match leaves_all(l.code, body_kept(saves)) {
            False => None,
            True => Some(Emitted(At(prog, 0, Asm::of_code(l.code)), l.file, skip_nodes(nodes, placement), names)),
        },
    }
}

// Proved by FunctionIR's theorems for them, unedited.
theorem emit_word_nodes_emits<M>(saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data),
    spans: Spans, values: Valuation(), d: Nat, s0: MachineState<M>, prog: Prog, file: File, nodes: List<Node>, placement: List<Place>, names: Nat,
    now: Heap):
    MayEmitBy<M, Heap>(saves, site, stack, spans, heap_in<M>(site.data, spans), values, d, s0, prog, file, NodesHold(values, nodes), now, now,
        emit_word_nodes(saves, prog, file, nodes, placement, names)) {
    (match lower_nodes(nodes, placement, file) as λ lowered =>
        MayKeep<M>(values, file, NodesHold(values, nodes), lowered) →
        MayGuard<M>(values, file, NodesHold(values, nodes), lowered) →
        MayEmitBy<M, Heap>(saves, site, stack, spans, heap_in<M>(site.data, spans), values, d, s0, prog, file, NodesHold(values, nodes), now, now,
            match lowered {
                None => None,
                Some(l) => match leaves_all(l.code, body_kept(saves)) {
                    False => None,
                    True => Some(Emitted(At(prog, 0, Asm::of_code(l.code)), l.file, skip_nodes(nodes, placement), names)),
                },
            }) {
        None => λ _ _ => trivial,
        Some(lowered) => λ keeps guards => match left: leaves_all(lowered.code, body_kept(saves)) {
            False => trivial,
            True => pure_emits<M, Heap>(saves, site, laid, stack, spans, heap_in<M>(site.data, spans), values, d, s0, prog, file,
                NodesHold(values, nodes), lowered, keeps, guards, is_true_of_eq(leaves_all(lowered.code, body_kept(saves)), left),
                skip_nodes(nodes, placement), names, now),
        },
    })(lower_nodes_keeps<M>(values, nodes, placement, file), lower_nodes_guards<M>(values, nodes, placement, file))
}

// ---------------------------------------------------------------------------
// Each node's code

fn MayEmitHeap<M>(saves: Nat, site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, values: Valuation(), d: Nat,
    s0: MachineState<M>, prog: Prog, file: File, facts: Type, before, after: Heap, out: Option<Emitted>) → Type {
    MayEmitBy<M, Heap>(saves, site, stack, spans, heap_in<M>(site.data, spans), values, d, s0, prog, file, facts, before, after, out)
}

// A load at its width: one byte, four or eight; any other is refused (a
// two-byte load waits for the machine's `MOVZX r, word`).
fn emit_load(prog: Prog, file: File, output, place: Nat, destination, base: Gpr, bytes: Nat, later: List<Place>, names: Nat) → Option<Emitted> {
    match bytes.same(1) {
        True => Some(Emitted(At(prog, 0, LoadByte(ByteLoad(destination, base))), file.write(destination, Some(Held(output, Word))), later, names)),
        False => match bytes.same(4) {
            True => Some(Emitted(At(prog, 0, asm_dword_load(DwordLoad(destination, base))), file.write(destination, Some(Held(output, Word))), later,
                names)),
            False => match bytes.same(8) {
                True => Some(Emitted(At(prog, 0, Load(WordLoad(destination, base))), file.write(destination, Some(Held(output, Word))), later, names)),
                False => None,
            },
        },
    }
}

theorem emit_load_emits<M>(saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), top: Nat,
    spans: Spans, loan: Loan<M>(site.fetch, site.data, stack, top, spans), values: Valuation(), d: Nat, s0: MachineState<M>, prog: Prog,
    file: File, output, place: Nat, base, destination: Gpr, found: FoundAt(file, Held(place, Word), base),
    apart: destination.apart(body_kept(saves)).IsTrue(), bytes: Nat, later: List<Place>, names: Nat, heap: Heap):
    MayEmitHeap<M>(saves, site, stack, spans, values, d, s0, prog, file, Loads(spans, values, heap, bytes, output, place), heap, heap,
        emit_load(prog, file, output, place, destination, base, bytes, later, names)) {
    let out_file = file.write(destination, Some(Held(output, Word)));
    let at = λ (n: Nat) (e: bytes.same(n) = True) (out: Emitted)
        (emits: EmitsHeap<M>(saves, site, stack, spans, values, d, s0, prog, file, Loads(spans, values, heap, n, output, place), heap, heap, out)) =>
        j(sym(bytes.same_sound(n, e)), λ k _ => EmitsHeap<M>(saves, site, stack, spans, values, d, s0, prog, file, Loads(spans, values, heap, k, output, place),
            heap, heap, out), emits);
    (match bytes.same(1) as λ v => bytes.same(1) = v → MayEmitHeap<M>(saves, site, stack, spans, values, d, s0, prog, file,
            Loads(spans, values, heap, bytes, output, place), heap, heap, match v {
                True => Some(Emitted(At(prog, 0, LoadByte(ByteLoad(destination, base))), out_file, later, names)),
                False => match bytes.same(4) {
                    True => Some(Emitted(At(prog, 0, asm_dword_load(DwordLoad(destination, base))), out_file, later, names)),
                    False => match bytes.same(8) {
                        True => Some(Emitted(At(prog, 0, Load(WordLoad(destination, base))), out_file, later, names)),
                        False => None,
                    },
                },
            }) {
        True => λ e => at(1, e, Emitted(At(prog, 0, LoadByte(ByteLoad(destination, base))), out_file, later, names),
            load_byte_emits<M>(saves, site, laid, stack, top, spans, loan, values, d, s0, prog, file, output, place, base, destination, found, apart,
                later, names, heap)),
        False => λ _ => (match bytes.same(4) as λ v => bytes.same(4) = v → MayEmitHeap<M>(saves, site, stack, spans, values, d, s0, prog, file,
                Loads(spans, values, heap, bytes, output, place), heap, heap, match v {
                    True => Some(Emitted(At(prog, 0, asm_dword_load(DwordLoad(destination, base))), out_file, later, names)),
                    False => match bytes.same(8) {
                        True => Some(Emitted(At(prog, 0, Load(WordLoad(destination, base))), out_file, later, names)),
                        False => None,
                    },
                }) {
            True => λ e => at(4, e, Emitted(At(prog, 0, asm_dword_load(DwordLoad(destination, base))), out_file, later, names),
                load_dword_emits<M>(saves, site, laid, stack, top, spans, loan, values, d, s0, prog, file, output, place, base, destination, found, apart,
                    later, names, heap)),
            False => λ _ => (match bytes.same(8) as λ v => bytes.same(8) = v → MayEmitHeap<M>(saves, site, stack, spans, values, d, s0, prog, file,
                    Loads(spans, values, heap, bytes, output, place), heap, heap, match v {
                        True => Some(Emitted(At(prog, 0, Load(WordLoad(destination, base))), out_file, later, names)),
                        False => None,
                    }) {
                True => λ e => at(8, e, Emitted(At(prog, 0, Load(WordLoad(destination, base))), out_file, later, names),
                    load_word_emits<M>(saves, site, laid, stack, top, spans, loan, values, d, s0, prog, file, output, place, base, destination, found,
                        apart, later, names, heap)),
                False => λ _ => trivial,
            })(refl),
        })(refl),
    })(refl)
}

// A store at its width, through a base the encoding takes plainly.
fn emit_store(prog: Prog, file: File, base, source: Gpr, bytes: Nat, later: List<Place>, names: Nat) → Option<Emitted> {
    match store_base_plain(base) {
        False => None,
        True => match bytes.same(1) {
            True => Some(Emitted(At(prog, 0, StoreByte(ByteStore(base, source))), file, later, names)),
            False => match bytes.same(4) {
                True => Some(Emitted(At(prog, 0, asm_dword_store(DwordStore(base, source))), file, later, names)),
                False => match bytes.same(8) {
                    True => Some(Emitted(At(prog, 0, asm_word_store(WordStore(base, source))), file, later, names)),
                    False => None,
                },
            },
        },
    }
}

theorem emit_store_emits<M>(saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), top: Nat,
    spans: Spans, loan: Loan<M>(site.fetch, site.data, stack, top, spans), blocks: Blocks, lent: blocks.Lent(spans), values: Valuation(), d: Nat,
    s0: MachineState<M>, prog: Prog, file: File, place, value: Nat, base, source: Gpr, at_place: FoundAt(file, Held(place, Word), base),
    at_value: FoundAt(file, Held(value, Word), source), bytes: Nat, later: List<Place>, names: Nat, heap, after: Heap):
    MayEmitHeap<M>(saves, site, stack, spans, values, d, s0, prog, file, Stores(spans, values, blocks, heap, after, bytes, place, value), heap, after,
        emit_store(prog, file, base, source, bytes, later, names)) {
    let at = λ (n: Nat) (e: bytes.same(n) = True) (out: Emitted)
        (emits: EmitsHeap<M>(saves, site, stack, spans, values, d, s0, prog, file, Stores(spans, values, blocks, heap, after, n, place, value), heap,
            after, out)) =>
        j(sym(bytes.same_sound(n, e)), λ k _ => EmitsHeap<M>(saves, site, stack, spans, values, d, s0, prog, file,
            Stores(spans, values, blocks, heap, after, k, place, value), heap, after, out), emits);
    match plain: store_base_plain(base) {
        False => trivial,
        True => match one: bytes.same(1) {
            True => at(1, one, Emitted(At(prog, 0, StoreByte(ByteStore(base, source))), file, later, names),
                store_byte_emits<M>(saves, site, laid, stack, top, spans, loan, blocks, lent, values, d, s0, prog, file, place, value, base, source,
                    at_place, at_value, plain, later, names, heap, after)),
            False => match four: bytes.same(4) {
                True => at(4, four, Emitted(At(prog, 0, asm_dword_store(DwordStore(base, source))), file, later, names),
                    store_dword_emits<M>(saves, site, laid, stack, top, spans, loan, blocks, lent, values, d, s0, prog, file, place, value, base, source,
                        at_place, at_value, plain, later, names, heap, after)),
                False => match eight: bytes.same(8) {
                    True => at(8, eight, Emitted(At(prog, 0, asm_word_store(WordStore(base, source))), file, later, names),
                        store_word_emits<M>(saves, site, laid, stack, top, spans, loan, blocks, lent, values, d, s0, prog, file, place, value, base,
                            source, at_place, at_value, plain, later, names, heap, after)),
                    False => trivial,
                },
            },
        },
    }
}

// A register the placement names for a node's word, one the body may write.
fn Place::destination(self p: Place, saves: Nat) → Option<Gpr> {
    match p {
        Into(register) => match register.apart(body_kept(saves)) { False => None, True => Some(register) },
        _ => None,
    }
}

theorem Place::destination_apart(self p: Place, saves: Nat, register: Gpr, named: p.destination(saves) = Some(register)):
    register.apart(body_kept(saves)).IsTrue() {
    match p {
        Into(r) => match a: r.apart(body_kept(saves)) {
            False => absurd(named),
            True => is_true_of_eq(register.apart(body_kept(saves)),
                j(Option::some_inj(r, register, named), λ x _ => x.apart(body_kept(saves)) = True, a)),
        },
        Folded => absurd(named),
        Saving(_) => absurd(named),
        CallSlots(_) => absurd(named),
        Spilling(_) => absurd(named),
        Short(_) => absurd(named),
    }
}

// A load through the register the file says holds the reference, into the
// register the placement names.
fn emit_load_at(saves: Nat, prog: Prog, file: File, output, place, bytes: Nat, placement: List<Place>, names: Nat) → Option<Emitted> {
    match placement {
        Nil => None,
        Cons(p, later) => match p.destination(saves) {
            None => None,
            Some(destination) => match file.find(Held(place, Word)) {
                None => None,
                Some(found) => emit_load(prog, file, output, place, destination, found.register, bytes, later, names),
            },
        },
    }
}

theorem emit_load_at_emits<M>(saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), top: Nat,
    spans: Spans, loan: Loan<M>(site.fetch, site.data, stack, top, spans), values: Valuation(), d: Nat, s0: MachineState<M>, prog: Prog,
    file: File, output, place, bytes: Nat, placement: List<Place>, names: Nat, heap: Heap):
    MayEmitHeap<M>(saves, site, stack, spans, values, d, s0, prog, file, Loads(spans, values, heap, bytes, output, place), heap, heap,
        emit_load_at(saves, prog, file, output, place, bytes, placement, names)) {
    match placement {
        Nil => trivial,
        Cons(p, later) => match named: p.destination(saves) {
            None => trivial,
            Some(destination) => match file.find(Held(place, Word)) {
                None => trivial,
                Some(found) => emit_load_emits<M>(saves, site, laid, stack, top, spans, loan, values, d, s0, prog, file, output, place, found.register,
                    destination, found.at, p.destination_apart(saves, destination, named), bytes, later, names, heap),
            },
        },
    }
}

// A reference loaded likewise, as a word.
fn emit_load_ref_at(saves: Nat, prog: Prog, file: File, output, place: Nat, placement: List<Place>, names: Nat) → Option<Emitted> {
    match placement {
        Nil => None,
        Cons(p, later) => match p.destination(saves) {
            None => None,
            Some(destination) => match file.find(Held(place, Word)) {
                None => None,
                Some(found) => Some(Emitted(At(prog, 0, Load(WordLoad(destination, found.register))), file.write(destination, Some(Held(output, Word))),
                    later, names)),
            },
        },
    }
}

theorem emit_load_ref_at_emits<M>(saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data),
    top: Nat, spans: Spans, loan: Loan<M>(site.fetch, site.data, stack, top, spans), values: Valuation(), d: Nat, s0: MachineState<M>, prog: Prog,
    file: File, output, place: Nat, placement: List<Place>, names: Nat, heap: Heap):
    MayEmitHeap<M>(saves, site, stack, spans, values, d, s0, prog, file, LoadsRef(spans, values, heap, output, place), heap, heap,
        emit_load_ref_at(saves, prog, file, output, place, placement, names)) {
    match placement {
        Nil => trivial,
        Cons(p, later) => match named: p.destination(saves) {
            None => trivial,
            Some(destination) => match file.find(Held(place, Word)) {
                None => trivial,
                Some(found) => load_ref_emits<M>(saves, site, laid, stack, top, spans, loan, values, d, s0, prog, file, output, place, found.register,
                    destination, found.at, p.destination_apart(saves, destination, named), later, names, heap),
            },
        },
    }
}

// A store from the register holding the word through the one holding the
// reference; the placement's entry for it is passed over.
fn emit_store_at(prog: Prog, file: File, place, value, bytes: Nat, placement: List<Place>, names: Nat) → Option<Emitted> {
    match placement {
        Nil => None,
        Cons(skipped, later) => match file.find(Held(place, Word)) {
            None => None,
            Some(base) => match file.find(Held(value, Word)) {
                None => None,
                Some(source) => emit_store(prog, file, base.register, source.register, bytes, later, names),
            },
        },
    }
}

theorem emit_store_at_emits<M>(saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data),
    top: Nat, spans: Spans, loan: Loan<M>(site.fetch, site.data, stack, top, spans), blocks: Blocks, lent: blocks.Lent(spans), values: Valuation(),
    d: Nat, s0: MachineState<M>, prog: Prog, file: File, place, value, bytes: Nat, placement: List<Place>, names: Nat, heap, after: Heap):
    MayEmitHeap<M>(saves, site, stack, spans, values, d, s0, prog, file, Stores(spans, values, blocks, heap, after, bytes, place, value), heap, after,
        emit_store_at(prog, file, place, value, bytes, placement, names)) {
    let facts = Stores(spans, values, blocks, heap, after, bytes, place, value);
    match placement {
        Nil => trivial,
        Cons(skipped, later) => (match file.find(Held(place, Word)) as λ o => MayEmitHeap<M>(saves, site, stack, spans, values, d, s0, prog, file, facts,
                heap, after, match o {
                    None => None,
                    Some(base) => match file.find(Held(value, Word)) {
                        None => None,
                        Some(source) => emit_store(prog, file, base.register, source.register, bytes, later, names),
                    },
                }) {
            None => trivial,
            Some(base) => (match file.find(Held(value, Word)) as λ o => MayEmitHeap<M>(saves, site, stack, spans, values, d, s0, prog, file, facts,
                    heap, after, match o { None => None, Some(source) => emit_store(prog, file, base.register, source.register, bytes, later, names) }) {
                None => trivial,
                Some(source) => emit_store_emits<M>(saves, site, laid, stack, top, spans, loan, blocks, lent, values, d, s0, prog, file, place, value,
                    base.register, source.register, base.at, source.at, bytes, later, names, heap, after),
            }),
        }),
    }
}

fn emit_store_ref_at(prog: Prog, file: File, place, value: Nat, placement: List<Place>, names: Nat) → Option<Emitted> {
    match placement {
        Nil => None,
        Cons(skipped, later) => match file.find(Held(place, Word)) {
            None => None,
            Some(base) => match file.find(Held(value, Word)) {
                None => None,
                Some(source) => match store_base_plain(base.register) {
                    False => None,
                    True => Some(Emitted(At(prog, 0, asm_word_store(WordStore(base.register, source.register))), file, later, names)),
                },
            },
        },
    }
}

theorem emit_store_ref_at_emits<M>(saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data),
    top: Nat, spans: Spans, loan: Loan<M>(site.fetch, site.data, stack, top, spans), blocks: Blocks, lent: blocks.Lent(spans), values: Valuation(),
    d: Nat, s0: MachineState<M>, prog: Prog, file: File, place, value: Nat, placement: List<Place>, names: Nat, heap, after: Heap):
    MayEmitHeap<M>(saves, site, stack, spans, values, d, s0, prog, file, StoresRef(spans, values, blocks, heap, after, place, value), heap, after,
        emit_store_ref_at(prog, file, place, value, placement, names)) {
    let facts = StoresRef(spans, values, blocks, heap, after, place, value);
    match placement {
        Nil => trivial,
        Cons(skipped, later) => (match file.find(Held(place, Word)) as λ o => MayEmitHeap<M>(saves, site, stack, spans, values, d, s0, prog, file, facts,
                heap, after, match o {
                    None => None,
                    Some(base) => match file.find(Held(value, Word)) {
                        None => None,
                        Some(source) => match store_base_plain(base.register) {
                            False => None,
                            True => Some(Emitted(At(prog, 0, asm_word_store(WordStore(base.register, source.register))), file, later, names)),
                        },
                    },
                }) {
            None => trivial,
            Some(base) => (match file.find(Held(value, Word)) as λ o => MayEmitHeap<M>(saves, site, stack, spans, values, d, s0, prog, file, facts,
                    heap, after, match o {
                        None => None,
                        Some(source) => match store_base_plain(base.register) {
                            False => None,
                            True => Some(Emitted(At(prog, 0, asm_word_store(WordStore(base.register, source.register))), file, later, names)),
                        },
                    }) {
                None => trivial,
                Some(source) => match plain: store_base_plain(base.register) {
                    False => trivial,
                    True => store_ref_emits<M>(saves, site, laid, stack, top, spans, loan, blocks, lent, values, d, s0, prog, file, place, value,
                        base.register, source.register, base.at, source.at, plain, later, names, heap, after),
                },
            }),
        }),
    }
}

// ---------------------------------------------------------------------------
// A node, and a leaf of them

// A node's meaning at the valuation, from the heap `before` to `after`.
fn Instr::Holds(self instr: Instr, spans: Spans, blocks: Blocks, values: Valuation(), before, after: Heap) → Type {
    match instr {
        Compute(node) => NodeHolds(values, node) ∧ (after = before),
        Load(bytes, output, place) => Loads(spans, values, before, bytes, output, place) ∧ (after = before),
        Store(bytes, place, value) => Stores(spans, values, blocks, before, after, bytes, place, value),
        LoadRef(output, place) => LoadsRef(spans, values, before, output, place) ∧ (after = before),
        StoreRef(place, value) => StoresRef(spans, values, blocks, before, after, place, value),
        Offset(output, place, amount) => Offsets(spans, values, output, place, amount) ∧ (after = before),
        Copy(target, source, length) => Exists<Loc>(λ to => (values(64, target) = to.address(spans)) ∧ Exists<Loc>(λ from =>
            (values(64, source) = from.address(spans)) ∧ (before.copy(blocks.written, to, from, values(64, length).toNat()) = Some(after)))),
    }
}

// A node's code: a word node as FunctionIR's (an offset is its `ADD`),
// and a memory node as one instruction. A typed copy is not lowered yet.
fn Instr::emit(self instr: Instr, saves: Nat, prog: Prog, file: File, placement: List<Place>, names: Nat) → Option<Emitted> {
    match instr {
        Compute(node) => emit_word_nodes(saves, prog, file, [node], placement, names),
        Load(bytes, output, place) => emit_load_at(saves, prog, file, output, place, bytes, placement, names),
        Store(bytes, place, value) => emit_store_at(prog, file, place, value, bytes, placement, names),
        LoadRef(output, place) => emit_load_ref_at(saves, prog, file, output, place, placement, names),
        StoreRef(place, value) => emit_store_ref_at(prog, file, place, value, placement, names),
        Offset(output, place, amount) => emit_word_nodes(saves, prog, file, [Add(64, output, place, amount)], placement, names),
        Copy(_, _, _) => None,
    }
}

// The node's code meets its meaning.
theorem Instr::emit_emits<M>(self instr: Instr, saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data),
    top: Nat, spans: Spans, loan: Loan<M>(site.fetch, site.data, stack, top, spans), blocks: Blocks, lent: blocks.Lent(spans), values: Valuation(),
    d: Nat, s0: MachineState<M>, prog: Prog, file: File, placement: List<Place>, names: Nat, before, after: Heap):
    MayEmitHeap<M>(saves, site, stack, spans, values, d, s0, prog, file, instr.Holds(spans, blocks, values, before, after), before, after,
        instr.emit(saves, prog, file, placement, names)) {
    let mem = heap_in<M>(site.data, spans);
    match instr {
        Compute(node) => may_emit_by_still<M, Heap>(saves, site, stack, spans, mem, values, d, s0, prog, file,
            NodeHolds(values, node) ∧ (after = before), before, after, λ h => h.right, emit_word_nodes(saves, prog, file, [node], placement, names),
            may_emit_by_weaken<M, Heap>(saves, site, stack, spans, mem, values, d, s0, prog, file, NodesHold(values, [node]),
                NodeHolds(values, node) ∧ (after = before), λ h => ⟨h.left, trivial⟩, before, before,
                emit_word_nodes(saves, prog, file, [node], placement, names),
                emit_word_nodes_emits<M>(saves, site, laid, stack, spans, values, d, s0, prog, file, [node], placement, names, before))),
        Load(bytes, output, place) => may_emit_by_still<M, Heap>(saves, site, stack, spans, mem, values, d, s0, prog, file,
            Loads(spans, values, before, bytes, output, place) ∧ (after = before), before, after, λ h => h.right,
            emit_load_at(saves, prog, file, output, place, bytes, placement, names),
            may_emit_by_weaken<M, Heap>(saves, site, stack, spans, mem, values, d, s0, prog, file, Loads(spans, values, before, bytes, output, place),
                Loads(spans, values, before, bytes, output, place) ∧ (after = before), λ h => h.left, before, before,
                emit_load_at(saves, prog, file, output, place, bytes, placement, names),
                emit_load_at_emits<M>(saves, site, laid, stack, top, spans, loan, values, d, s0, prog, file, output, place, bytes, placement, names,
                    before))),
        Store(bytes, place, value) => emit_store_at_emits<M>(saves, site, laid, stack, top, spans, loan, blocks, lent, values, d, s0, prog, file, place,
            value, bytes, placement, names, before, after),
        LoadRef(output, place) => may_emit_by_still<M, Heap>(saves, site, stack, spans, mem, values, d, s0, prog, file,
            LoadsRef(spans, values, before, output, place) ∧ (after = before), before, after, λ h => h.right,
            emit_load_ref_at(saves, prog, file, output, place, placement, names),
            may_emit_by_weaken<M, Heap>(saves, site, stack, spans, mem, values, d, s0, prog, file, LoadsRef(spans, values, before, output, place),
                LoadsRef(spans, values, before, output, place) ∧ (after = before), λ h => h.left, before, before,
                emit_load_ref_at(saves, prog, file, output, place, placement, names),
                emit_load_ref_at_emits<M>(saves, site, laid, stack, top, spans, loan, values, d, s0, prog, file, output, place, placement, names, before))),
        StoreRef(place, value) => emit_store_ref_at_emits<M>(saves, site, laid, stack, top, spans, loan, blocks, lent, values, d, s0, prog, file, place,
            value, placement, names, before, after),
        Offset(output, place, amount) => may_emit_by_still<M, Heap>(saves, site, stack, spans, mem, values, d, s0, prog, file,
            Offsets(spans, values, output, place, amount) ∧ (after = before), before, after, λ h => h.right,
            emit_word_nodes(saves, prog, file, [Add(64, output, place, amount)], placement, names),
            may_emit_by_weaken<M, Heap>(saves, site, stack, spans, mem, values, d, s0, prog, file, NodesHold(values, [Add(64, output, place, amount)]),
                Offsets(spans, values, output, place, amount) ∧ (after = before),
                λ h => ⟨offset_adds(spans, values, output, place, amount, h.left), trivial⟩, before, before,
                emit_word_nodes(saves, prog, file, [Add(64, output, place, amount)], placement, names),
                emit_word_nodes_emits<M>(saves, site, laid, stack, spans, values, d, s0, prog, file, [Add(64, output, place, amount)], placement, names,
                    before))),
        Copy(_, _, _) => trivial,
    }
}

// A leaf's meaning: its nodes one after another, each from the heap the
// one before left.
fn InstrsHold(spans: Spans, blocks: Blocks, values: Valuation(), instrs: List<Instr>, before, after: Heap) → Type {
    match instrs {
        Nil => after = before,
        Cons(instr, rest) => Exists<Heap>(λ mid => instr.Holds(spans, blocks, values, before, mid) ∧ InstrsHold(spans, blocks, values, rest, mid, after)),
    }
}

// A leaf's code: its nodes' one after another.
fn emit_instrs(saves: Nat, prog: Prog, file: File, instrs: List<Instr>, placement: List<Place>, names: Nat) → Option<Emitted> {
    match instrs {
        Nil => Some(Emitted(prog, file, placement, names)),
        Cons(instr, rest) => match instr.emit(saves, prog, file, placement, names) {
            None => None,
            Some(first) => emit_instrs(saves, first.prog, first.file, rest, first.placement, first.names),
        },
    }
}

// No code: where the facts say the state is the same, the run is empty.
theorem emits_none<M, S>(saves: Nat, site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, Mem: S → M → Type, values: Valuation(),
    d: Nat, s0: MachineState<M>, prog: Prog, file: File, placement: List<Place>, names: Nat, before, after: S):
    EmitsBy<M, S>(saves, site, stack, spans, Mem, values, d, s0, prog, file, after = before, before, after, Emitted(prog, file, placement, names)) {
    ⟨prog.within_self(), λ within => site.moves_refl(stack.writes, prog_len(prog),
        λ (s: MachineState<M>) => (file.Represents(values, s.gprs) ∧ (after = before)) ∧ stack.TrailedBy(saves, spans, Mem, d, s0, before, s),
        λ (t: MachineState<M>) => file.Represents(values, t.gprs) ∧ stack.TrailedBy(saves, spans, Mem, d, s0, after, t),
        λ s held => ⟨held.left.left, j(sym(held.left.right), λ a _ => stack.TrailedBy(saves, spans, Mem, d, s0, a, s), held.right)⟩)⟩
}

// A leaf's code meets its meaning: each node's theorem, composed by the
// generic sequence (`may_emit_by_seq`).
theorem emit_instrs_emits<M>(saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data),
    top: Nat, spans: Spans, loan: Loan<M>(site.fetch, site.data, stack, top, spans), blocks: Blocks, lent: blocks.Lent(spans), values: Valuation(),
    d: Nat, s0: MachineState<M>, instrs: List<Instr>): (prog: Prog) → (file: File) → (placement: List<Place>) → (names: Nat) → (before, after: Heap) →
    MayEmitHeap<M>(saves, site, stack, spans, values, d, s0, prog, file, InstrsHold(spans, blocks, values, instrs, before, after), before, after,
        emit_instrs(saves, prog, file, instrs, placement, names)) {
    let mem = heap_in<M>(site.data, spans);
    match instrs {
        Nil => λ prog file placement names before after =>
            emits_none<M, Heap>(saves, site, stack, spans, mem, values, d, s0, prog, file, placement, names, before, after),
        Cons(instr, rest) => λ prog file placement names before after =>
            (match instr.emit(saves, prog, file, placement, names) as λ o =>
                ((mid: Heap) → MayEmitHeap<M>(saves, site, stack, spans, values, d, s0, prog, file, instr.Holds(spans, blocks, values, before, mid), before,
                    mid, o)) →
                MayEmitHeap<M>(saves, site, stack, spans, values, d, s0, prog, file, InstrsHold(spans, blocks, values, Cons(instr, rest), before, after),
                    before, after, match o { None => None, Some(first) => emit_instrs(saves, first.prog, first.file, rest, first.placement, first.names) }) {
                None => λ _ => trivial,
                Some(first) => λ first_emits => may_emit_by_seq<M, Heap>(saves, site, stack, spans, mem, values, d, s0, prog, file,
                    λ (mid: Heap) => instr.Holds(spans, blocks, values, before, mid), λ (mid: Heap) => InstrsHold(spans, blocks, values, rest, mid, after),
                    before, after, first, first_emits, emit_instrs(saves, first.prog, first.file, rest, first.placement, first.names),
                    λ mid => emit_instrs_emits<M>(saves, site, laid, stack, top, spans, loan, blocks, lent, values, d, s0, rest, first.prog, first.file,
                        first.placement, first.names, mid, after)),
            })(λ mid => instr.emit_emits<M>(saves, site, laid, stack, top, spans, loan, blocks, lent, values, d, s0, prog, file, placement, names, before,
                mid)),
    }
}

// ---------------------------------------------------------------------------
// The register invariant at the lowered values

// An id of its kind lowers, under the valuation, as the run's locals hold
// it: a word at every width as itself, a reference as its target's
// address. The registers then hold what the file says of the valuation
// (`File::Represents`), with no mention of kinds.
fn Typed::Lowers(self v: Typed, spans: Spans, values: Valuation(), l: Locals) → Type {
    match v.kind {
        WordKind => (w: Nat) → values(w, v.id) = l.words(w, v.id),
        RefKind => Exists<Loc>(λ loc => (l.refs(v.id) = Some(loc)) ∧ (values(64, v.id) = loc.address(spans))),
    }
}

// The valuation agrees with the locals at every id validity has bound.
fn Locals::Agrees(self l: Locals, spans: Spans, values: Valuation(), kinds: List<Typed>) → Type {
    match kinds { Nil => True, Cons(v, rest) => v.Lowers(spans, values, l) ∧ l.Agrees(spans, values, rest) }
}

theorem ValueKind::same_sound(self a: ValueKind, b: ValueKind, same: a.same(b) = True): a = b {
    match a {
        WordKind => match b { WordKind => refl, RefKind => absurd(same) },
        RefKind => match b { WordKind => absurd(same), RefKind => refl },
    }
}

// What an id is bound at, the first entry for it says, and the locals
// agree there.
theorem Locals::agrees_at(self l: Locals, spans: Spans, values: Valuation(), id: Nat, kind: ValueKind, kinds: List<Typed>):
    has_kind(kinds, id, kind) = True → l.Agrees(spans, values, kinds) → Typed(id, kind).Lowers(spans, values, l) {
    match kinds {
        Nil => λ never _ => absurd(never),
        Cons(v, rest) => λ has agrees => match s: v.id.same(id) {
            True => {
                let same_id: (v.id = id) = v.id.same_sound(id, s);
                let same_kind: (v.kind = kind) = v.kind.same_sound(kind, has);
                j(same_id, λ x _ => Typed(x, kind).Lowers(spans, values, l),
                    j(same_kind, λ k _ => Typed(v.id, k).Lowers(spans, values, l), agrees.left))
            },
            False => Locals::agrees_at(l, spans, values, id, kind, rest, has, agrees.right),
        },
    }
}

// A word read at every width; a reference read as its location.
theorem Locals::agrees_word(self l: Locals, spans: Spans, values: Valuation(), kinds: List<Typed>, id: Nat, has: has_kind(kinds, id, WordKind) = True,
    agrees: l.Agrees(spans, values, kinds)): (w: Nat) → values(w, id) = l.words(w, id) {
    l.agrees_at(spans, values, id, WordKind, kinds, has, agrees)
}

theorem Locals::agrees_ref(self l: Locals, spans: Spans, values: Valuation(), kinds: List<Typed>, id: Nat, has: has_kind(kinds, id, RefKind) = True,
    agrees: l.Agrees(spans, values, kinds)): Exists<Loc>(λ loc => (l.refs(id) = Some(loc)) ∧ (values(64, id) = loc.address(spans))) {
    l.agrees_at(spans, values, id, RefKind, kinds, has, agrees)
}

// An id bound is had at its kind.
theorem bind_kind_has(v: Typed): (kinds, after: List<Typed>) → bind_kind(kinds, v) = Some(after) → has_kind(after, v.id, v.kind) = True {
    λ kinds after bound => (match kind_of(kinds, v.id) as λ o => kind_of(kinds, v.id) = o →
            (match o { None => Some(Cons(v, kinds)), Some(k) => match k.same(v.kind) { True => Some(kinds), False => None } }) = Some(after) →
            has_kind(after, v.id, v.kind) = True {
        None => λ _ some => j(Option::some_inj(Cons(v, kinds), after, some), λ a _ => has_kind(a, v.id, v.kind) = True,
            j(sym(v.id.same_self()), λ b _ => (match match b { True => Some(v.kind), False => kind_of(kinds, v.id) } { None => False, Some(k) => k.same(v.kind) }) = True,
                match v.kind { WordKind => refl, RefKind => refl })),
        Some(k) => λ found => match s: k.same(v.kind) {
            True => λ some => j(Option::some_inj(kinds, after, some), λ a _ => has_kind(a, v.id, v.kind) = True,
                j(sym(found), λ o _ => (match o { None => False, Some(k2) => k2.same(v.kind) }) = True, s)),
            False => λ never => absurd(never),
        },
    })(refl, bound)
}

// Every id a word node reads is a word.
theorem words_bound_mem(kinds: List<Typed>, ids: List<Nat>): words_bound(kinds, ids) = True → (id: Nat) → Mem(id, ids) →
    has_kind(kinds, id, WordKind) = True {
    match ids {
        Nil => λ _ id never => false_elim(never),
        Cons(first, rest) => λ bound id m => {
            let parts = Bool::and_true_parts(has_kind(kinds, first, WordKind), words_bound(kinds, rest), bound);
            match m {
                Inl(here) => j(sym(here), λ x _ => has_kind(kinds, x, WordKind) = True, parts.left),
                Inr(later) => words_bound_mem(kinds, rest, parts.right, id, later),
            }
        },
    }
}

// ---------------------------------------------------------------------------
// A node's run is its meaning at the valuation
//
// Where the valuation agrees with the locals at the kinds bound before a
// node and with those after it at the kinds it binds, the node's step is
// its `Instr::Holds`: validity's kinds are what make a word node's operands
// the valuation's, and a reference's address the register's word.

theorem compute_holds(node: Node, blocks: Blocks, spans: Spans, values: Valuation(), kinds, bound: List<Typed>, c, after: Config,
    checked: Compute(node).check(kinds) = Some(bound), stepped: Compute(node).step(blocks, c) = Some(after),
    agrees: c.locals.Agrees(spans, values, kinds), later: after.locals.Agrees(spans, values, bound)):
    NodeHolds(values, node) ∧ (after.memory = c.memory) {
    let out = node_output(node).id;
    let made = Some(Config(Locals(node.step(c.locals.words), c.locals.refs), c.memory, c.io));
    match ok: node.pure() && words_bound(kinds, function_ir_eval::Node::reads(node)) {
        False => absurd(j(ok, λ v _ => (match v { False => None, True => bind_kind(kinds, word_id(out)) }) = Some(bound), checked)),
        True => match def: node.pure() && node.defined(c.locals.words) {
            False => absurd(j(def, λ v _ => (match v { False => None, True => made }) = Some(after), stepped)),
            True => {
                let ran: (made = Some(after)) = j(def, λ v _ => (match v { False => None, True => made }) = Some(after), stepped);
                let e: (Config(Locals(node.step(c.locals.words), c.locals.refs), c.memory, c.io) = after) = Option::some_inj(
                    Config(Locals(node.step(c.locals.words), c.locals.refs), c.memory, c.io), after, ran);
                let bind: (bind_kind(kinds, word_id(out)) = Some(bound)) =
                    j(ok, λ v _ => (match v { False => None, True => bind_kind(kinds, word_id(out)) }) = Some(bound), checked);
                let at_after = after.locals.agrees_word(spans, values, bound, out, bind_kind_has(word_id(out), kinds, bound, bind), later);
                let reads = Bool::and_true_parts(node.pure(), words_bound(kinds, function_ir_eval::Node::reads(node)), ok).right;
                let at_output = λ (w: Nat) => trans(at_after(w), trans(cong_fn<Config, BitVec(w)>(λ x => x.locals.words(w, out), sym(e)),
                    Valuation::set_here(c.locals.words, out, node.value(c.locals.words), w)));
                let kept = λ (w: Nat) (id: Nat) (m: Mem(id, function_ir_eval::Node::reads(node))) =>
                    c.locals.agrees_word(spans, values, kinds, id, words_bound_mem(kinds, function_ir_eval::Node::reads(node), reads, id, m), agrees, w);
                let defined = is_true_of_eq(node.defined(c.locals.words), Bool::and_true_parts(node.pure(), node.defined(c.locals.words), def).right);
                ⟨node.holds_of(c.locals.words, values, Nil, at_output, kept, defined), cong_fn<Config, Heap>(λ x => x.memory, sym(e))⟩
            },
        },
    }
}

// A reference read where validity says one is bound: the valuation's word
// at it is the address of the location the locals hold.
theorem Locals::ref_at(self l: Locals, spans: Spans, values: Valuation(), kinds: List<Typed>, id: Nat, has: has_kind(kinds, id, RefKind) = True,
    agrees: l.Agrees(spans, values, kinds), loc: Loc, held: l.refs(id) = Some(loc)): values(64, id) = loc.address(spans) {
    let got = l.agrees_ref(spans, values, kinds, id, has, agrees);
    let same: (got.witness = loc) = Option::some_inj(got.witness, loc, trans(sym(got.proof.left), held));
    j(same, λ x _ => values(64, id) = x.address(spans), got.proof.right)
}

// A word bound by a node: the valuation's word at it is what the node set.
theorem Locals::word_set(self l: Locals, spans: Spans, values: Valuation(), bound: List<Typed>, out: Nat, has: has_kind(bound, out, WordKind) = True,
    agrees: l.Agrees(spans, values, bound), before: Locals, word: BitVec(64), set: before.set_word(out, word_value(word)) = l): values(64, out) = word {
    trans(l.agrees_word(spans, values, bound, out, has, agrees, 64),
        trans(cong_fn<Locals, BitVec(64)>(λ x => x.words(64, out), sym(set)), Valuation::set_here(before.words, out, word_value(word), 64)))
}

theorem load_holds(bytes, output, place: Nat, blocks: Blocks, spans: Spans, values: Valuation(), kinds, bound: List<Typed>, c, after: Config,
    checked: Instr::Load(bytes, output, place).check(kinds) = Some(bound), stepped: Instr::Load(bytes, output, place).step(blocks, c) = Some(after),
    agrees: c.locals.Agrees(spans, values, kinds), later: after.locals.Agrees(spans, values, bound)):
    Loads(spans, values, c.memory, bytes, output, place) ∧ (after.memory = c.memory) {
    let first = Option::and_then_some(c.locals.refs(place), λ (loc: Loc) =>
        c.memory.load(loc, bytes).and_then(λ (x: BitVec(64)) => Some(Config(c.locals.set_word(output, word_value(x)), c.memory, c.io))), after, stepped);
    let loc = first.witness;
    let second = Option::and_then_some(c.memory.load(loc, bytes), λ (x: BitVec(64)) => Some(Config(c.locals.set_word(output, word_value(x)), c.memory, c.io)),
        after, first.proof.right);
    let x = second.witness;
    let e: (Config(c.locals.set_word(output, word_value(x)), c.memory, c.io) = after) =
        Option::some_inj(Config(c.locals.set_word(output, word_value(x)), c.memory, c.io), after, second.proof.right);
    let read = c.memory.load_some(loc, bytes, x, second.proof.left);
    match ok: width_ok(bytes) && has_kind(kinds, place, RefKind) {
        False => absurd(j(ok, λ v _ => (match v { False => None, True => bind_kind(kinds, word_id(output)) }) = Some(bound), checked)),
        True => {
            let bind: (bind_kind(kinds, word_id(output)) = Some(bound)) =
                j(ok, λ v _ => (match v { False => None, True => bind_kind(kinds, word_id(output)) }) = Some(bound), checked);
            let has = Bool::and_true_parts(width_ok(bytes), has_kind(kinds, place, RefKind), ok).right;
            let named: (values(64, output) = x) = after.locals.word_set(spans, values, bound, output, bind_kind_has(word_id(output), kinds, bound, bind),
                later, c.locals, x, cong_fn<Config, Locals>(λ y => y.locals, e));
            ⟨Exists(loc, ⟨c.locals.ref_at(spans, values, kinds, place, has, agrees, loc, first.proof.left),
                Exists(read.witness, ⟨read.proof.left, trans(named, sym(read.proof.right))⟩)⟩),
             cong_fn<Config, Heap>(λ y => y.memory, sym(e))⟩
        },
    }
}

theorem store_holds(bytes, place, value: Nat, blocks: Blocks, spans: Spans, values: Valuation(), kinds, bound: List<Typed>, c, after: Config,
    checked: Instr::Store(bytes, place, value).check(kinds) = Some(bound), stepped: Instr::Store(bytes, place, value).step(blocks, c) = Some(after),
    agrees: c.locals.Agrees(spans, values, kinds)): Stores(spans, values, blocks, c.memory, after.memory, bytes, place, value) {
    let piece = λ (w: BitVec(64)) => Piece::plain(low_bytes(bytes, w));
    let first = Option::and_then_some(c.locals.refs(place), λ (loc: Loc) =>
        c.memory.put(blocks.written, loc, piece(c.locals.word(value))).and_then(λ (m: Heap) => Some(Config(c.locals, m, c.io))), after, stepped);
    let loc = first.witness;
    let second = Option::and_then_some(c.memory.put(blocks.written, loc, piece(c.locals.word(value))), λ (m: Heap) => Some(Config(c.locals, m, c.io)),
        after, first.proof.right);
    let e: (Config(c.locals, second.witness, c.io) = after) = Option::some_inj(Config(c.locals, second.witness, c.io), after, second.proof.right);
    let ok = width_ok(bytes) && (has_kind(kinds, place, RefKind) && has_kind(kinds, value, WordKind));
    match yes: ok {
        False => absurd(j(yes, λ v _ => (match v { False => None, True => Some(kinds) }) = Some(bound), checked)),
        True => {
            let parts = Bool::and_true_parts(has_kind(kinds, place, RefKind), has_kind(kinds, value, WordKind),
                Bool::and_true_parts(width_ok(bytes), has_kind(kinds, place, RefKind) && has_kind(kinds, value, WordKind), yes).right);
            let word: (values(64, value) = c.locals.word(value)) = c.locals.agrees_word(spans, values, kinds, value, parts.right, agrees, 64);
            Exists(loc, ⟨c.locals.ref_at(spans, values, kinds, place, parts.left, agrees, loc, first.proof.left),
                j(sym(word), λ w _ => c.memory.put(blocks.written, loc, piece(w)) = Some(after.memory),
                    trans(second.proof.left, cong_fn<Config, Option<Heap>>(λ y => Some(y.memory), e)))⟩)
        },
    }
}

// A reference bound by a node: the valuation's word at it is the address
// of what the node set.
theorem Locals::ref_set(self l: Locals, spans: Spans, values: Valuation(), bound: List<Typed>, out: Nat, has: has_kind(bound, out, RefKind) = True,
    agrees: l.Agrees(spans, values, bound), before: Locals, target: Loc, set: before.set_ref(out, target) = l): values(64, out) = target.address(spans) {
    l.ref_at(spans, values, bound, out, has, agrees, target,
        trans(cong_fn<Locals, Option<Loc>>(λ x => x.refs(out), sym(set)),
            j(sym(out.same_self()), λ b _ => (match b { True => Some(target), False => before.refs(out) }) = Some(target), refl)))
}

theorem load_ref_holds(output, place: Nat, blocks: Blocks, spans: Spans, values: Valuation(), kinds, bound: List<Typed>, c, after: Config,
    checked: Instr::LoadRef(output, place).check(kinds) = Some(bound), stepped: Instr::LoadRef(output, place).step(blocks, c) = Some(after),
    agrees: c.locals.Agrees(spans, values, kinds), later: after.locals.Agrees(spans, values, bound)):
    LoadsRef(spans, values, c.memory, output, place) ∧ (after.memory = c.memory) {
    let first = Option::and_then_some(c.locals.refs(place), λ (loc: Loc) =>
        c.memory.load_ref(loc).and_then(λ (target: Loc) => Some(Config(c.locals.set_ref(output, target), c.memory, c.io))), after, stepped);
    let loc = first.witness;
    let second = Option::and_then_some(c.memory.load_ref(loc), λ (target: Loc) => Some(Config(c.locals.set_ref(output, target), c.memory, c.io)),
        after, first.proof.right);
    let target = second.witness;
    let e: (Config(c.locals.set_ref(output, target), c.memory, c.io) = after) =
        Option::some_inj(Config(c.locals.set_ref(output, target), c.memory, c.io), after, second.proof.right);
    match ok: has_kind(kinds, place, RefKind) {
        False => absurd(j(ok, λ v _ => (match v { False => None, True => bind_kind(kinds, ref_id(output)) }) = Some(bound), checked)),
        True => {
            let bind: (bind_kind(kinds, ref_id(output)) = Some(bound)) =
                j(ok, λ v _ => (match v { False => None, True => bind_kind(kinds, ref_id(output)) }) = Some(bound), checked);
            ⟨Exists(loc, ⟨c.locals.ref_at(spans, values, kinds, place, ok, agrees, loc, first.proof.left),
                Exists(target, ⟨second.proof.left, after.locals.ref_set(spans, values, bound, output, bind_kind_has(ref_id(output), kinds, bound, bind),
                    later, c.locals, target, cong_fn<Config, Locals>(λ y => y.locals, e))⟩)⟩),
             cong_fn<Config, Heap>(λ y => y.memory, sym(e))⟩
        },
    }
}

theorem store_ref_holds(place, value: Nat, blocks: Blocks, spans: Spans, values: Valuation(), kinds, bound: List<Typed>, c, after: Config,
    checked: Instr::StoreRef(place, value).check(kinds) = Some(bound), stepped: Instr::StoreRef(place, value).step(blocks, c) = Some(after),
    agrees: c.locals.Agrees(spans, values, kinds)): StoresRef(spans, values, blocks, c.memory, after.memory, place, value) {
    let first = Option::and_then_some(c.locals.refs(place), λ (loc: Loc) => c.locals.refs(value).and_then(λ (target: Loc) =>
        c.memory.put(blocks.written, loc, Piece::reference(target)).and_then(λ (m: Heap) => Some(Config(c.locals, m, c.io)))), after, stepped);
    let loc = first.witness;
    let second = Option::and_then_some(c.locals.refs(value), λ (target: Loc) =>
        c.memory.put(blocks.written, loc, Piece::reference(target)).and_then(λ (m: Heap) => Some(Config(c.locals, m, c.io))), after, first.proof.right);
    let target = second.witness;
    let third = Option::and_then_some(c.memory.put(blocks.written, loc, Piece::reference(target)), λ (m: Heap) => Some(Config(c.locals, m, c.io)),
        after, second.proof.right);
    let e: (Config(c.locals, third.witness, c.io) = after) = Option::some_inj(Config(c.locals, third.witness, c.io), after, third.proof.right);
    match ok: has_kind(kinds, place, RefKind) && has_kind(kinds, value, RefKind) {
        False => absurd(j(ok, λ v _ => (match v { False => None, True => Some(kinds) }) = Some(bound), checked)),
        True => {
            let parts = Bool::and_true_parts(has_kind(kinds, place, RefKind), has_kind(kinds, value, RefKind), ok);
            Exists(loc, ⟨c.locals.ref_at(spans, values, kinds, place, parts.left, agrees, loc, first.proof.left),
                Exists(target, ⟨c.locals.ref_at(spans, values, kinds, value, parts.right, agrees, target, second.proof.left),
                    trans(third.proof.left, cong_fn<Config, Option<Heap>>(λ y => Some(y.memory), e))⟩)⟩)
        },
    }
}

theorem offset_holds(output, place, amount: Nat, blocks: Blocks, spans: Spans, values: Valuation(), kinds, bound: List<Typed>, c, after: Config,
    checked: Instr::Offset(output, place, amount).check(kinds) = Some(bound),
    stepped: Instr::Offset(output, place, amount).step(blocks, c) = Some(after),
    agrees: c.locals.Agrees(spans, values, kinds), later: after.locals.Agrees(spans, values, bound)):
    Offsets(spans, values, output, place, amount) ∧ (after.memory = c.memory) {
    let moved = λ (loc: Loc) (a: BitVec(64)) => Loc(loc.block, loc.offset + a.toNat());
    let first = Option::and_then_some(c.locals.refs(place), λ (loc: Loc) =>
        Some(Config(c.locals.set_ref(output, moved(loc, c.locals.word(amount))), c.memory, c.io)), after, stepped);
    let loc = first.witness;
    let e: (Config(c.locals.set_ref(output, moved(loc, c.locals.word(amount))), c.memory, c.io) = after) =
        Option::some_inj(Config(c.locals.set_ref(output, moved(loc, c.locals.word(amount))), c.memory, c.io), after, first.proof.right);
    match ok: has_kind(kinds, place, RefKind) && has_kind(kinds, amount, WordKind) {
        False => absurd(j(ok, λ v _ => (match v { False => None, True => bind_kind(kinds, ref_id(output)) }) = Some(bound), checked)),
        True => {
            let bind: (bind_kind(kinds, ref_id(output)) = Some(bound)) =
                j(ok, λ v _ => (match v { False => None, True => bind_kind(kinds, ref_id(output)) }) = Some(bound), checked);
            let parts = Bool::and_true_parts(has_kind(kinds, place, RefKind), has_kind(kinds, amount, WordKind), ok);
            let word: (values(64, amount) = c.locals.word(amount)) = c.locals.agrees_word(spans, values, kinds, amount, parts.right, agrees, 64);
            let at: (values(64, output) = moved(loc, c.locals.word(amount)).address(spans)) =
                after.locals.ref_set(spans, values, bound, output, bind_kind_has(ref_id(output), kinds, bound, bind), later, c.locals,
                    moved(loc, c.locals.word(amount)), cong_fn<Config, Locals>(λ y => y.locals, e));
            ⟨Exists(loc, ⟨c.locals.ref_at(spans, values, kinds, place, parts.left, agrees, loc, first.proof.left),
                j(sym(word), λ a _ => values(64, output) = moved(loc, a).address(spans), at)⟩),
             cong_fn<Config, Heap>(λ y => y.memory, sym(e))⟩
        },
    }
}

theorem copy_holds(target, source, length: Nat, blocks: Blocks, spans: Spans, values: Valuation(), kinds, bound: List<Typed>, c, after: Config,
    checked: Instr::Copy(target, source, length).check(kinds) = Some(bound),
    stepped: Instr::Copy(target, source, length).step(blocks, c) = Some(after), agrees: c.locals.Agrees(spans, values, kinds)):
    Instr::Copy(target, source, length).Holds(spans, blocks, values, c.memory, after.memory) {
    let n = λ (w: BitVec(64)) => w.toNat();
    let first = Option::and_then_some(c.locals.refs(target), λ (to: Loc) => c.locals.refs(source).and_then(λ (from: Loc) =>
        c.memory.copy(blocks.written, to, from, n(c.locals.word(length))).and_then(λ (m: Heap) => Some(Config(c.locals, m, c.io)))), after, stepped);
    let to = first.witness;
    let second = Option::and_then_some(c.locals.refs(source), λ (from: Loc) =>
        c.memory.copy(blocks.written, to, from, n(c.locals.word(length))).and_then(λ (m: Heap) => Some(Config(c.locals, m, c.io))), after,
        first.proof.right);
    let from = second.witness;
    let third = Option::and_then_some(c.memory.copy(blocks.written, to, from, n(c.locals.word(length))), λ (m: Heap) => Some(Config(c.locals, m, c.io)),
        after, second.proof.right);
    let e: (Config(c.locals, third.witness, c.io) = after) = Option::some_inj(Config(c.locals, third.witness, c.io), after, third.proof.right);
    match ok: has_kind(kinds, target, RefKind) && (has_kind(kinds, source, RefKind) && has_kind(kinds, length, WordKind)) {
        False => absurd(j(ok, λ v _ => (match v { False => None, True => Some(kinds) }) = Some(bound), checked)),
        True => {
            let parts = Bool::and_true_parts(has_kind(kinds, target, RefKind), has_kind(kinds, source, RefKind) && has_kind(kinds, length, WordKind), ok);
            let rest = Bool::and_true_parts(has_kind(kinds, source, RefKind), has_kind(kinds, length, WordKind), parts.right);
            let word: (values(64, length) = c.locals.word(length)) = c.locals.agrees_word(spans, values, kinds, length, rest.right, agrees, 64);
            Exists(to, ⟨c.locals.ref_at(spans, values, kinds, target, parts.left, agrees, to, first.proof.left),
                Exists(from, ⟨c.locals.ref_at(spans, values, kinds, source, rest.left, agrees, from, second.proof.left),
                    j(sym(word), λ w _ => c.memory.copy(blocks.written, to, from, n(w)) = Some(after.memory),
                        trans(third.proof.left, cong_fn<Config, Option<Heap>>(λ y => Some(y.memory), e)))⟩)⟩)
        },
    }
}

// Every node: its step, where the valuation agrees before and after, is
// its meaning.
theorem Instr::holds_of(self instr: Instr, blocks: Blocks, spans: Spans, values: Valuation(), kinds, bound: List<Typed>, c, after: Config,
    checked: instr.check(kinds) = Some(bound), stepped: instr.step(blocks, c) = Some(after),
    agrees: c.locals.Agrees(spans, values, kinds), later: after.locals.Agrees(spans, values, bound)):
    instr.Holds(spans, blocks, values, c.memory, after.memory) {
    match instr {
        Compute(node) => compute_holds(node, blocks, spans, values, kinds, bound, c, after, checked, stepped, agrees, later),
        Load(bytes, output, place) => load_holds(bytes, output, place, blocks, spans, values, kinds, bound, c, after, checked, stepped, agrees, later),
        Store(bytes, place, value) => store_holds(bytes, place, value, blocks, spans, values, kinds, bound, c, after, checked, stepped, agrees),
        LoadRef(output, place) => load_ref_holds(output, place, blocks, spans, values, kinds, bound, c, after, checked, stepped, agrees, later),
        StoreRef(place, value) => store_ref_holds(place, value, blocks, spans, values, kinds, bound, c, after, checked, stepped, agrees),
        Offset(output, place, amount) => offset_holds(output, place, amount, blocks, spans, values, kinds, bound, c, after, checked, stepped, agrees, later),
        Copy(target, source, length) => copy_holds(target, source, length, blocks, spans, values, kinds, bound, c, after, checked, stepped, agrees),
    }
}

// The valuation agrees with a leaf's run at every node: with the locals
// at the kinds bound so far, before each node and after the last.
fn RunAgrees(spans: Spans, values: Valuation(), blocks: Blocks, instrs: List<Instr>, kinds: List<Typed>, c: Config) → Type {
    match instrs {
        Nil => c.locals.Agrees(spans, values, kinds),
        Cons(instr, rest) => c.locals.Agrees(spans, values, kinds) ∧ ((bound: List<Typed>) → instr.check(kinds) = Some(bound) → (mid: Config) →
            instr.step(blocks, c) = Some(mid) → RunAgrees(spans, values, blocks, rest, bound, mid)),
    }
}

theorem run_agrees_now(spans: Spans, values: Valuation(), blocks: Blocks, instrs: List<Instr>, kinds: List<Typed>, c: Config):
    RunAgrees(spans, values, blocks, instrs, kinds, c) → c.locals.Agrees(spans, values, kinds) {
    match instrs { Nil => λ a => a, Cons(_, _) => λ a => a.left }
}

// A leaf's run, where the valuation agrees with it, is the leaf's meaning:
// the facts its code is proved under (`emit_instrs_emits`).
theorem run_instrs_holds(blocks: Blocks, spans: Spans, values: Valuation(), instrs: List<Instr>): (kinds, bound: List<Typed>) → (c, after: Config) →
    check_instrs(instrs, kinds) = Some(bound) → run_instrs(blocks, instrs, c) = Some(after) → RunAgrees(spans, values, blocks, instrs, kinds, c) →
    InstrsHold(spans, blocks, values, instrs, c.memory, after.memory) {
    match instrs {
        Nil => λ kinds bound c after checked ran agrees => cong_fn<Config, Heap>(λ y => y.memory, sym(Option::some_inj(c, after, ran))),
        Cons(instr, rest) => λ kinds bound c after checked ran agrees => {
            let checked_first = Option::and_then_some(instr.check(kinds), λ (k: List<Typed>) => check_instrs(rest, k), bound, checked);
            let ran_first = Option::and_then_some(instr.step(blocks, c), λ (m: Config) => run_instrs(blocks, rest, m), after, ran);
            let mid = ran_first.witness;
            let k = checked_first.witness;
            let next = agrees.right(k, checked_first.proof.left, mid, ran_first.proof.left);
            Exists(mid.memory, ⟨instr.holds_of(blocks, spans, values, kinds, k, c, mid, checked_first.proof.left, ran_first.proof.left, agrees.left,
                    run_agrees_now(spans, values, blocks, rest, k, mid, next)),
                run_instrs_holds(blocks, spans, values, rest, k, bound, mid, after, checked_first.proof.right, ran_first.proof.right, next)⟩)
        },
    }
}

// ---------------------------------------------------------------------------
// Calls: what a callee answers, and what its code promises

// What routine `f` answers on values and a heap: the program's meaning at
// one fuel, the world aside (`bytes_level_routines`).
fn RoutineAnswers() → Type<1> { Nat → List<Value> → Heap → Answer → Type }

fn typed_ids(vs: List<Typed>) → List<Nat> { match vs { Nil => Nil, Cons(v, rest) => Cons(v.id, typed_ids(rest)) } }

// A routine's words as its code answers them: the first in RAX, the rest in
// `answer_registers()`. One that answers none answers zero in RAX, so that
// every call has a word there (FunctionIR's call and function theorems are
// stated with one).
fn answer_head(words: List<BitVec(64)>) → BitVec(64) { match words { Nil => BitVec::zero(), Cons(w, _) => w } }

fn answer_tail(words: List<BitVec(64)>) → List<BitVec(64)> { match words { Nil => Nil, Cons(_, rest) => rest } }

// Where a call's answer lands: its first result's id, or `spare` (an id the
// scope never binds, zero in its valuation) where it has none; and the rest.
fn call_result(results: List<Typed>, spare: Nat) → Nat { match results { Nil => spare, Cons(v, _) => v.id } }

fn call_also(results: List<Typed>) → List<Nat> { match results { Nil => Nil, Cons(_, rest) => typed_ids(rest) } }

// A call at the valuation: the arguments `args` are the words at its
// arguments' ids, lowered, the answer `a`'s words land where the call says,
// and the heap after it is the answer's.
fn CallLands(spans: Spans, values: Valuation(), spare: Nat, arguments, results: List<Typed>, args: List<Value>, a: Answer, after: Heap) → Type {
    (lower_values(spans, args) = words_of(values, typed_ids(arguments))) ∧
        (((answer_head(lower_values(spans, a.words)) = values(64, call_result(results, spare))) ∧
            (answer_tail(lower_values(spans, a.words)) = words_of(values, call_also(results)))) ∧ (a.heap = after))
}

// Routine `f` entered on `args` over `heap` at stack offset `i`: the
// arguments passed lowered, room below for its frames, the lending's words
// above, and the heap injected.
fn RoutinePre<M>(site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, rooms: Nat → Nat, top, f: Nat, args: List<Value>,
    heap: Heap) → Nat → MachineState<M> → Type {
    λ i s => (stack.Passed(lower_values(spans, args), i, s) ∧ (rooms(f) <= i)) ∧ ((i + 8 <= top) ∧ Injected<M>(site.data, spans, heap, s.memory))
}

// And returned with `a`: its words in the answer registers, the callee-saved
// registers kept, its stores inside the lending, and its heap injected.
fn RoutinePost<M>(site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, a: Answer) → Nat → MachineState<M> → MachineState<M> → Type {
    λ i s t => Answered(answer_head(lower_values(spans, a.words)), answer_tail(lower_values(spans, a.words)), t.gprs) ∧
        (Kept(callee_kept(), s.gprs, t.gprs) ∧ (stack.WroteIn(i, spans, s.memory, t.memory) ∧ Injected<M>(site.data, spans, a.heap, t.memory)))
}

// Every routine below `bound`, wherever it answers, returns so at its label.
fn CalleesReturn<M>(site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, rooms: Nat → Nat, top, bound: Nat, answers: RoutineAnswers()) → Type {
    (f: Nat) → f + 1 <= bound → (args: List<Value>) → (heap: Heap) → (a: Answer) → answers(f, args, heap, a) →
        site.Returns(stack, asm_labels(site.program)(f + 1), RoutinePre<M>(site, stack, spans, rooms, top, f, args, heap), RoutinePost<M>(site, stack, spans, a))
}

// Whether a region calls, and that every call of a routine below `bound`
// has its room and the call's 24 bytes in `avail` (FunctionIR's
// `StructuredRegion::Fits`).
fn Body::calls(self body: Body) → Bool {
    match body {
        Leaf(_) => False,
        Seq(first, rest) => first.calls() || rest.calls(),
        Branch(_, yes, no) => yes.calls() || no.calls(),
        Call(_, _, _) => True,
        Loop(_, _, inner, _, _, _) => inner.calls(),
        Sys(_) => False,
        Exit(_) => False,
    }
}

fn Body::Fits(self body: Body, rooms: Nat → Nat, bound, avail: Nat) → Type {
    match body {
        Leaf(_) => True,
        Seq(first, rest) => first.Fits(rooms, bound, avail) ∧ rest.Fits(rooms, bound, avail),
        Branch(_, yes, no) => yes.Fits(rooms, bound, avail) ∧ no.Fits(rooms, bound, avail),
        Call(callee, _, _) => callee + 1 <= bound → rooms(callee) + 24 <= avail,
        Loop(_, _, inner, _, _, _) => inner.Fits(rooms, bound, avail),
        Sys(_) => True,
        Exit(_) => True,
    }
}

// The room a region's calls ask below a frame.
fn Body::callee_room(self body: Body, rooms: Nat → Nat) → Nat {
    match body {
        Leaf(_) => 0,
        Seq(first, rest) => first.callee_room(rooms).max(rest.callee_room(rooms)),
        Branch(_, yes, no) => yes.callee_room(rooms).max(no.callee_room(rooms)),
        Call(callee, _, _) => rooms(callee) + 24,
        Loop(_, _, inner, _, _, _) => inner.callee_room(rooms),
        Sys(_) => 0,
        Exit(_) => 0,
    }
}

// The CALL of a call whose callee answers `a` on `args`: the callee's
// return (`CalleesReturn`) is its contract for `call_step_by`, cited as
// stated at the heap's clause. Its precondition is the caller's clause and
// the words passed; its postcondition gives the answer's words where the
// call lands them and the answer's heap injected.
theorem call_heap_step<M>(saved: List<Gpr>, slots: Nat, eight: saved.len() <= 8, slotted: saved.len() <= slots, site: Site<M>,
    laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), top: Nat, spans: Spans,
    loan: Loan<M>(site.fetch, site.data, stack, top, spans), rooms: Nat → Nat, bound, avail: Nat, answers: RoutineAnswers(),
    callees: CalleesReturn<M>(site, stack, spans, rooms, top, bound, answers), values: Valuation(), spare: Nat, d: Nat, s0: MachineState<M>,
    room: avail <= d, fits: d + 8 * slots <= stack.size, under: (d + 8 * slots) + 8 <= top, prog: Prog, callee: Nat, deep: 24 <= d,
    below: callee + 1 <= bound, fit: rooms(callee) + 24 <= avail, count: Nat, few: count <= 2, arguments, results: List<Typed>, before, after: Heap,
    args: List<Value>, a: Answer, answered: answers(callee, args, before, a), lands: CallLands(spans, values, spare, arguments, results, args, a, after),
    g0: Gprs, k: Nat, at: asm_back(site.program, k) = At(prog, 0, CallTo(callee + 1))):
    site.Moves(stack.writes, prog_len(prog), prog_len(prog) + 5,
        λ (x: MachineState<M>) => stack.ArgsReadyBy(saved, spans, heap_in<M>(site.data, spans), d, slots, s0, before, g0, count,
            words_of(values, typed_ids(arguments)), x),
        λ (t: MachineState<M>) => stack.CalledBy(saved, spans, heap_in<M>(site.data, spans), d, slots, s0, after, g0, count,
            values(64, call_result(results, spare)), words_of(values, call_also(results)), t)) {
    let i = (d - 8 * count) - 8;
    let low: (rooms(callee) <= i) = { omega };
    let high: (i + 8 <= top) = { omega };
    call_step_by<M, Heap>(saved, slots, eight, slotted, site, laid, stack, top, spans, heap_in<M>(site.data, spans), loan,
        heap_in_stable<M>(stack, top, spans, loan), d, s0, fits, under, prog, callee, deep, count, few, words_of(values, typed_ids(arguments)),
        values(64, call_result(results, spare)), words_of(values, call_also(results)), before, after,
        RoutinePre<M>(site, stack, spans, rooms, top, callee, args, before), RoutinePost<M>(site, stack, spans, a),
        callees(callee, below, args, before, a, answered),
        λ u passed inj => ⟨⟨j(sym(lands.left), λ ws _ => stack.Passed(ws, i, u), passed), low⟩, ⟨high, inj⟩⟩,
        λ u t inj post => ⟨⟨trans(post.left.left, lands.right.left.left),
            j(lands.right.left.right, λ ws _ => ArgsIn(ws, answer_registers(), t.gprs), post.left.right)⟩,
            ⟨post.right.left, ⟨post.right.right.left, j(lands.right.right, λ h _ => Injected<M>(site.data, spans, h, t.memory), post.right.right.right)⟩⟩⟩,
        g0, k, at)
}

// ---------------------------------------------------------------------------
// The plain loop: its meaning at the valuation and its code

// A plain loop's passes at fuel `n`: each from the state's words, at a
// valuation of its own whose parameters they are (a pass is its own scope),
// its body's facts from the heap it starts at to the one it leaves; the
// exit bit set ends with the next words, clear goes round at one fuel less.
// At no fuel nothing ends.
fn PassesHold(Pass: Valuation() → Heap → Heap → Type, parameters: List<Typed>, exit: Nat, next: List<Typed>, n: Nat, state: List<BitVec(64)>, from: Heap,
    final: List<BitVec(64)>, to: Heap) → Type {
    match n {
        Zero => False,
        Succ(m) => Exists<Valuation()>(λ v => (words_of(v, typed_ids(parameters)) = state) ∧ Exists<Heap>(λ mid => Pass(v, from, mid) ∧
            match v(1, exit).head_bit() as λ _ => Type {
                True => (final = words_of(v, typed_ids(next))) ∧ (to = mid),
                False => PassesHold(Pass, parameters, exit, next, m, words_of(v, typed_ids(next)), mid, final, to),
            })),
    }
}

// The registers a loop's state is held in, one `Into` place each, and the
// places after them.
record LoopTaken { registers: List<Gpr>, rest: List<Place> }

fn state_registers(placement: List<Place>, count: Nat) → Option<LoopTaken> {
    match count {
        Zero => Some(LoopTaken([], placement)),
        Succ(more) => match placement {
            Nil => None,
            Cons(p, rest) => match p {
                Into(r) => match state_registers(rest, more) { None => None, Some(t) => Some(LoopTaken(Cons(r, t.registers), t.rest)) },
                Folded => None,
                Saving(_) => None,
                CallSlots(_) => None,
                Spilling(_) => None,
                Short(_) => None,
            },
        },
    }
}

// The entry: the inputs moved into the state's registers, and the file a
// pass starts from (its parameters there, nothing else).
record PlainEntry { code: List<Instruction>, head: File }

fn File::plain_entry(self file: File, saves: Nat, inputs, parameters: List<Nat>, registers: List<Gpr>) → Option<PlainEntry> {
    match file.move_outputs(word_ports(inputs), registers) {
        None => None,
        Some(moves) => match moves.file.outputs_check(word_ports(inputs), registers) && leaves_all(moves.code, body_kept(saves)) {
            False => None,
            True => match input_file(word_ports(parameters), registers) { None => None, Some(head) => Some(PlainEntry(moves.code, head)) },
        },
    }
}

// The code after a pass: the exit bit's test, a jump to C where it is
// clear; where set the next words moved into the state's registers and a
// jump to J; at C the same moves and a jump to the head H; then J. Labels:
// H is `names + 1`, C `names + 2`, J `names + 3`.
fn plain_jumped(pass: Prog, test: Test, moves: List<Instruction>, names: Nat, short: List<Nat>) → Prog {
    At(At(pass.branched_by(test, names + 2, shorts(short, names + 2)), 0, Block(moves)), 0, jmp_item(shorts(short, names + 3), names + 3))
}

fn plain_back(pass: Prog, test: Test, moves: List<Instruction>, names: Nat, short: List<Nat>) → Prog {
    At(At(plain_jumped(pass, test, moves, names, short), names + 2, Block([])), 0, Block(moves))
}

fn plain_again(pass: Prog, test: Test, moves: List<Instruction>, names: Nat, short: List<Nat>) → Prog {
    At(plain_back(pass, test, moves, names, short), 0, jmp_item(shorts(short, names + 1), names + 1))
}

fn plain_done(pass: Prog, test: Test, moves: List<Instruction>, names: Nat, short: List<Nat>) → Prog {
    At(plain_again(pass, test, moves, names, short), names + 3, Block([]))
}

fn plain_head(prog: Prog, code: List<Instruction>, names: Nat) → Prog { At(At(prog, 0, Block(code)), names + 1, Block([])) }

// After the pass: refused where the exit bit has no test, the next words do
// not all reach the state's registers, or the moves touch a register the
// body keeps. The file after the loop has its outputs in those registers.
fn Emitted::plain_close(self pass: Emitted, saves: Nat, registers: List<Gpr>, exit: Nat, next, outputs: List<Nat>, names: Nat, short: List<Nat>) →
    Option<Emitted> {
    match pass.file.branch_test(exit) {
        None => None,
        Some(tested) => match pass.file.move_outputs(word_ports(next), registers) {
            None => None,
            Some(moves) => match moves.file.outputs_check(word_ports(next), registers) && leaves_all(moves.code, body_kept(saves)) {
                False => None,
                True => match input_file(word_ports(outputs), registers) {
                    None => None,
                    Some(out) => Some(Emitted(plain_done(pass.prog, tested.test, moves.code, names, short), out, pass.placement, pass.names)),
                },
            },
        },
    }
}

// ---------------------------------------------------------------------------
// Sequences, branches and calls

// A region's meaning at the valuation, from the heap `before` to `after`:
// a leaf's nodes, a sequence through a heap between, the arm the
// condition's bit picks, and a call: the values at its arguments, lowered,
// are the valuation's words there, the callee answers them (`answers`, what
// the program's routines answer at the fuel the call is made with), and its
// answer's words, lowered, are the words at its results (`CallLands`); a
// plain loop's passes at some fuel (`PassesHold`). System calls and exits are
// not lowered yet and mean nothing here.
fn Body::Holds(self body: Body, spans: Spans, blocks: Blocks, values: Valuation(), answers: RoutineAnswers(), spare: Nat, before, after: Heap) → Type {
    match body {
        Leaf(instrs) => InstrsHold(spans, blocks, values, instrs, before, after),
        Seq(first, rest) => Exists<Heap>(λ mid => first.Holds(spans, blocks, values, answers, spare, before, mid) ∧
            rest.Holds(spans, blocks, values, answers, spare, mid, after)),
        Branch(condition, yes, no) => match values(1, condition).head_bit() {
            True => yes.Holds(spans, blocks, values, answers, spare, before, after),
            False => no.Holds(spans, blocks, values, answers, spare, before, after),
        },
        Call(callee, arguments, results) => Exists<List<Value>>(λ args => Exists<Answer>(λ a =>
            answers(callee, args, before, a) ∧ CallLands(spans, values, spare, arguments, results, args, a, after))),
        Loop(inputs, parameters, inner, exit, next, outputs) => Exists<Nat>(λ n => PassesHold(λ (v: Valuation()) (from: Heap) (to: Heap) =>
            inner.Holds(spans, blocks, v, answers, spare, from, to), parameters, exit, next, n, words_of(values, typed_ids(inputs)), before,
            words_of(values, typed_ids(outputs)), after)),
        Sys(_) => False,
        Exit(_) => False,
    }
}

// How a run stops short of done at a fuel (docs/language/ownership-design.md
// §17.7): still going with the world so far, or exited with a status and
// the world. The going side and the exited side of the lowering are one
// development over it: the same facts, read off the same runs, and the same
// code theorems, at a stop.
inductive Stop { StopGoing(io: Io), StopExited(status: BitVec(64), io: Io) }

fn Ran::stopped<T>(self r: Ran<T>) → Option<Stop> {
    match r { Done(_) => None, Exited(status, io) => Some(StopExited(status, io)), Going(io) => Some(StopGoing(io)), Stuck(_) => None }
}

// The world at the stop.
fn Stop::world(self x: Stop) → Io { match x { StopGoing(io) => io, StopExited(_, io) => io } }

// What a loop out of fuel is, at the stop: going, it is the stop; exited,
// it is not.
fn Stop::Zero(self x: Stop) → Type { match x { StopGoing(_) => True, StopExited(_, _) => False } }

// What an exit with the word `w` is, at the stop.
fn Stop::Exits(self x: Stop, w: BitVec(64)) → Type { match x { StopGoing(_) => False, StopExited(status, _) => w = status } }

// The machine steps the code is claimed to take by the stop: going at
// `n`, the `n` turns and calls the fuel paid for; exited, none.
fn Stop::least(self x: Stop, n: Nat) → Nat { match x { StopGoing(_) => n, StopExited(_, _) => 0 } }

// The state the code reaches at the stop, the world aside (no system call
// is made on the way): going, any; exited, at the exit call with the status.
fn Stop::Reached<M>(self x: Stop, site: Site<M>, stack: Stack<M>(site.fetch, site.data)) → Running<M, True> → Type {
    match x {
        StopGoing(_) => λ (_: Running<M, True>) => True,
        StopExited(status, _) => λ (r: Running<M, True>) => LinuxSyscallAt(site.linux(stack), r.state) ∧ LinuxExits(r.state, status),
    }
}

theorem Stop::least_le(self x: Stop, n: Nat): x.least(n) <= n { match x { StopGoing(_) => n.le_refl(), StopExited(_, _) => trivial } }

theorem Stop::least_succ(self x: Stop, n: Nat): x.least(Succ(n)) <= 1 + x.least(n) {
    match x { StopGoing(_) => { omega }, StopExited(_, _) => trivial }
}

theorem Stop::least_pred(self x: Stop, n: Nat): x.least(n) <= 1 + x.least(n.pred()) {
    match n { Zero => { let low = x.least_le(0); omega }, Succ(m) => x.least_succ(m) }
}

theorem Stop::least_mono(self x: Stop, n, m: Nat, le: n <= m): x.least(n) <= x.least(m) {
    match x { StopGoing(_) => le, StopExited(_, _) => trivial }
}

theorem Stop::reached_zero<M>(self x: Stop, site: Site<M>, stack: Stack<M>(site.fetch, site.data), zero: x.Zero(), r: Running<M, True>):
    x.Reached(site, stack)(r) {
    (match x as λ y => y.Zero() → y.Reached(site, stack)(r) { StopGoing(_) => λ _ => trivial, StopExited(_, _) => λ never => false_elim(never) })(zero)
}

// A run that is going at `io` stops at `x` only where `x` is that.
theorem Stop::zero_of(self x: Stop, io: Io, e: Some(StopGoing(io)) = Some(x)): x.Zero() {
    j(Option::some_inj(StopGoing(io), x, e), λ y _ => y.Zero(), trivial)
}

theorem Ran::then_stopped<T, U>(r: Ran<T>, k: T → Ran<U>, x: Stop): r.then(k).stopped() = Some(x) →
    (r.stopped() = Some(x)) ∨ Exists<T>(λ a => (r = Done(a)) ∧ (k(a).stopped() = Some(x))) {
    match r {
        Done(a) => λ h => Inr(Exists(a, ⟨refl, h⟩)),
        Exited(_, _) => λ h => Inl(h),
        Going(_) => λ h => Inl(h),
        Stuck(_) => λ h => absurd(h),
    }
}

// What is read off a value and then done never stops short.
theorem Ran::done_not_stopped<T, U>(o: Option<T>, io: Io, k: T → U, x: Stop, stopped: Ran::of(o, io).then(λ (v: T) => Done(k(v))).stopped() = Some(x)):
    False {
    match o { None => absurd(stopped), Some(_) => absurd(stopped) }
}

theorem Ran::of_stopped<T>(o: Option<T>, io: Io, x: Stop): Ran::of(o, io).stopped() = Some(x) → False {
    match o { None => λ h => absurd(h), Some(_) => λ h => absurd(h) }
}

// What the routines answer that stop at `x`, as `answers` is what they
// answer done: routine `f` on values and a heap, stopped at the fuel the
// call is made with.
fn RoutineStops() → Type<1> { Nat → List<Value> → Heap → Type }

// A loop stopped, from `state` over `from`: the first pass at `fuel`, its
// own valuation binding the state to the parameters, stopped itself; or
// done, its exit bit clear, and `later` from the state it leaves (the
// passes after a turn, as `loop_later` runs them). Out of fuel, `zero`.
fn PassStop(Pass: Valuation() → Heap → Heap → Type, PassStops: Valuation() → Nat → Heap → Type, parameters: List<Typed>, exit: Nat, next: List<Typed>,
    fuel: Nat, later: List<BitVec(64)> → Heap → Type, state: List<BitVec(64)>, from: Heap) → Type {
    Exists<Valuation()>(λ v => (words_of(v, typed_ids(parameters)) = state) ∧ (PassStops(v, fuel, from) ∨
        Exists<Heap>(λ mid => Pass(v, from, mid) ∧ ((v(1, exit).head_bit() = False) ∧ later(words_of(v, typed_ids(next)), mid)))))
}

fn LaterStop(Pass: Valuation() → Heap → Heap → Type, PassStops: Valuation() → Nat → Heap → Type, parameters: List<Typed>, exit: Nat, next: List<Typed>,
    zero: Type, fuel: Nat) → List<BitVec(64)> → Heap → Type {
    match fuel {
        Zero => λ state from => zero,
        Succ(rest) => λ state from => PassStop(Pass, PassStops, parameters, exit, next, rest, LaterStop(Pass, PassStops, parameters, exit, next, zero, rest),
            state, from),
    }
}

fn PassesStop(Pass: Valuation() → Heap → Heap → Type, PassStops: Valuation() → Nat → Heap → Type, parameters: List<Typed>, exit: Nat, next: List<Typed>,
    zero: Type, fuel: Nat, state: List<BitVec(64)>, from: Heap) → Type {
    PassStop(Pass, PassStops, parameters, exit, next, fuel, LaterStop(Pass, PassStops, parameters, exit, next, zero, fuel), state, from)
}

// A region's run stopped at `x` at `fuel`, at the valuation, from `before`:
// a sequence's first part stopped, or done and its rest stopped from where
// it left; the arm the bit picks stopped; a call to a routine stopped on the
// valuation's words at its arguments; a loop's passes stopped, a loop out of
// fuel being `x.Zero()`; an exit with the word at its status, `x.Exits`. A
// leaf never stops.
fn Body::Stops(self body: Body, spans: Spans, blocks: Blocks, values: Valuation(), answers: RoutineAnswers(), goes: RoutineStops(), x: Stop, spare: Nat,
    fuel: Nat, before: Heap) → Type {
    match body {
        Leaf(_) => False,
        Seq(first, rest) => first.Stops(spans, blocks, values, answers, goes, x, spare, fuel, before) ∨
            Exists<Heap>(λ mid => first.Holds(spans, blocks, values, answers, spare, before, mid) ∧
                rest.Stops(spans, blocks, values, answers, goes, x, spare, fuel, mid)),
        Branch(condition, yes, no) => match values(1, condition).head_bit() {
            True => yes.Stops(spans, blocks, values, answers, goes, x, spare, fuel, before),
            False => no.Stops(spans, blocks, values, answers, goes, x, spare, fuel, before),
        },
        Call(callee, arguments, _) => Exists<List<Value>>(λ args =>
            (lower_values(spans, args) = words_of(values, typed_ids(arguments))) ∧ goes(callee, args, before)),
        Loop(inputs, parameters, inner, exit, next, _) => PassesStop(λ (v: Valuation()) (from: Heap) (to: Heap) =>
                inner.Holds(spans, blocks, v, answers, spare, from, to),
            λ (v: Valuation()) (k: Nat) (from: Heap) => inner.Stops(spans, blocks, v, answers, goes, x, spare, k, from), parameters, exit, next, x.Zero(),
            fuel, words_of(values, typed_ids(inputs)), before),
        Sys(_) => False,
        Exit(status) => x.Exits(values(64, status)),
    }
}

// A call's code: FunctionIR's (`File::emit_call`, lending no buffers),
// proved by `File::emit_call_steps_by` at the heap's clause with each CALL
// by `call_heap_step`.
theorem call_heap_emits<M>(saves, slots: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data),
    top: Nat, spans: Spans, loan: Loan<M>(site.fetch, site.data, stack, top, spans), rooms: Nat → Nat, bound, avail: Nat, answers: RoutineAnswers(),
    callees: CalleesReturn<M>(site, stack, spans, rooms, top, bound, answers), blocks: Blocks, values: Valuation(), spare: Nat, d: Nat,
    s0: MachineState<M>, rsp0: read_gpr(Rsp, s0.gprs) = stack.at(d), room: avail <= d, deep: 24 <= d, fits: d + 8 * slots <= stack.size,
    under: (d + 8 * slots) + 8 <= top, prog: Prog, file: File, callee: Nat, arguments, results: List<Typed>,
    fit: callee + 1 <= bound → rooms(callee) + 24 <= avail, placement: List<Place>, names: Nat, before, after: Heap):
    MayEmitHeap<M>(saves, site, stack, spans, values, d + 8 * slots, s0, prog, file,
        Body::Call(callee, arguments, results).Holds(spans, blocks, values, answers, spare, before, after), before, after,
        file.emit_call(slots, prog, callee, typed_ids(arguments), call_result(results, spare), call_also(results), placement, names, bound, [], [])) {
    file.emit_call_steps_by<M, Heap>(saves, slots, site, laid, stack, top, bound, spans, heap_in<M>(site.data, spans),
        heap_in_stable<M>(stack, top, spans, loan), values, d, s0, rsp0, fits, under, deep, prog, callee, typed_ids(arguments),
        call_result(results, spare), call_also(results), placement, names, [], [],
        Body::Call(callee, arguments, results).Holds(spans, blocks, values, answers, spare, before, after), before, after,
        λ eight slotted below _ count few moved facts g0 _ _ k at => call_heap_step<M>(call_saves(placement), slots, eight, slotted, site, laid, stack, top,
            spans, loan, rooms, bound, avail, answers, callees, values, spare, d, s0, room, fits, under, moved, callee, deep, below, fit(below), count, few,
            arguments, results, before, after, facts.witness, facts.proof.witness, facts.proof.proof.left, facts.proof.proof.right, g0, k, at))
}

// An exit's code: the status, from the register the file says holds it,
// into RDI, sixty (`exit`) into RAX, and SYSCALL (Linux's `LinuxExits`).
// The code after it is never reached, and the file is left as it was.
fn exit_code(register: Gpr) → List<Instruction> { [MovRR(Rdi, register), MovRI(Rax, BitVec::ofNat(60))] }

fn emit_exit(prog: Prog, file: File, status: Nat, placement: List<Place>, names: Nat) → Option<Emitted> {
    match file.find(Held(status, Word)) {
        None => None,
        Some(found) => Some(Emitted(At(At(prog, 0, Block(exit_code(found.register))), 0, Syscall), file, placement, names)),
    }
}

// Code whose facts cannot hold: only its extent.
theorem emit_exit_emits<M>(saves: Nat, site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, values: Valuation(), d: Nat,
    s0: MachineState<M>, prog: Prog, file: File, status: Nat, placement: List<Place>, names: Nat, before, after: Heap):
    MayEmitHeap<M>(saves, site, stack, spans, values, d, s0, prog, file, False, before, after, emit_exit(prog, file, status, placement, names)) {
    match file.find(Held(status, Word)) as λ o => MayEmitHeap<M>(saves, site, stack, spans, values, d, s0, prog, file, False, before, after, match o {
        None => None,
        Some(found) => Some(Emitted(At(At(prog, 0, Block(exit_code(found.register))), 0, Syscall), file, placement, names)),
    }) {
        None => trivial,
        Some(found) => ⟨Exists(2, refl), λ within => site.moves_absurd(stack.writes, prog_len(prog),
            prog_len(At(At(prog, 0, Block(exit_code(found.register))), 0, Syscall)),
            λ (s: MachineState<M>) => (file.Represents(values, s.gprs) ∧ False) ∧
                stack.TrailedBy(saves, spans, heap_in<M>(site.data, spans), d, s0, before, s),
            λ (t: MachineState<M>) => file.Represents(values, t.gprs) ∧ stack.TrailedBy(saves, spans, heap_in<M>(site.data, spans), d, s0, after, t),
            λ s held => held.left.right)⟩,
    }
}

// A region's code: a leaf's nodes; a sequence's parts one after the other;
// a branch as FunctionIR's conditional (the test of its bit, or of the
// comparison the file knows it to be, the first arm, a jump to the join,
// the second arm, the join, where only what both arms' files agree on
// survives: `File::branch_test`, `File::meet`); a call as FunctionIR's,
// lending no buffers, of a routine below `bound`, its frame's `slots`
// call slots. `short` names the labels whose jumps take their short form.
fn Body::emit(self body: Body, saves, slots: Nat, short: List<Nat>, bound, spare: Nat, prog: Prog, file: File, placement: List<Place>, names: Nat) →
    Option<Emitted> {
    match body {
        Leaf(instrs) => emit_instrs(saves, prog, file, instrs, placement, names),
        Seq(first, rest) => match first.emit(saves, slots, short, bound, spare, prog, file, placement, names) {
            None => None,
            Some(done) => rest.emit(saves, slots, short, bound, spare, done.prog, done.file, done.placement, done.names),
        },
        Branch(condition, yes, no) => match file.branch_test(condition) {
            None => None,
            Some(tested) => match yes.emit(saves, slots, short, bound, spare, prog.branched_by(tested.test, names + 1, shorts(short, names + 1)),
                file.know(Truth(condition)), placement, names + 2) {
                None => None,
                Some(left) => match no.emit(saves, slots, short, bound, spare, left.prog.else_label_by(names + 1, names + 2, shorts(short, names + 2)),
                    file.know(Falsity(condition)), left.placement, left.names) {
                    None => None,
                    Some(right) => Some(Emitted(right.prog.join_label(names + 2), left.file.meet(right.file, file.known), right.placement, right.names)),
                },
            },
        },
        Call(callee, arguments, results) =>
            file.emit_call(slots, prog, callee, typed_ids(arguments), call_result(results, spare), call_also(results), placement, names, bound, [], []),
        Loop(inputs, parameters, inner, exit, next, outputs) => match state_registers(placement, typed_ids(parameters).len()) {
            None => None,
            Some(taken) => match file.plain_entry(saves, typed_ids(inputs), typed_ids(parameters), taken.registers) {
                None => None,
                Some(entry) => match inner.emit(saves, slots, short, bound, spare, plain_head(prog, entry.code, names), entry.head, taken.rest, names + 4) {
                    None => None,
                    Some(pass) => pass.plain_close(saves, taken.registers, exit, typed_ids(next), typed_ids(outputs), names, short),
                },
            },
        },
        Sys(_) => None,
        Exit(status) => emit_exit(prog, file, status, placement, names),
    }
}

// ---------------------------------------------------------------------------
// The plain loop's code meets its meaning

// The exit bit set, after a pass: the test falls through, the next words
// move into the state's registers, JMP J.
theorem plain_leaves<M>(saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), keep: M → Type,
    s0: MachineState<M>, pass: Prog, file: File, test: Test, exit: Nat, moves: List<Instruction>, ids: List<Nat>, registers: List<Gpr>, names: Nat,
    short: List<Nat>, jumped_in: plain_jumped(pass, test, moves, names, short).Within(site.program),
    c_lands: asm_target(site.program, names + 2) = prog_len(plain_jumped(pass, test, moves, names, short)),
    j_at: Nat, j_lands: asm_target(site.program, names + 3) = j_at, values: Valuation(),
    selects: (g: Gprs) → file.Represents(values, g) → test.taken(g) = !values(1, exit).head_bit(),
    into: MovesInto<M>(saves, values, file, ids, registers, moves), set: values(1, exit).head_bit() = True):
    site.Moves(stack.writes, prog_len(pass), j_at,
        λ (s: MachineState<M>) => stack.LoopPassed(saves, keep, s0, file, values)(s.gprs, s.memory),
        λ (t: MachineState<M>) => stack.LoopAt(saves, keep, s0, registers, words_of(values, ids))(t.gprs, t.memory)) {
    let program = site.program;
    let fits = program.laid_out_fits(laid);
    let lands = program.laid_out_lands(laid);
    let c_name = names + 2;
    let j_name = names + 3;
    let short_c = shorts(short, c_name);
    let short_j = shorts(short, j_name);
    let left = pass.branched_by(test, c_name, short_c);
    let leave = At(left, 0, Block(moves));
    let jumped = plain_jumped(pass, test, moves, names, short);
    let leave_in = leave.within_before(0, jmp_item(short_j, j_name), program, jumped_in);
    let left_in = left.within_before(0, Block(moves), program, leave_in);
    let tested = pass.tested(test);
    let test_in = tested.within_before(0, jcc_item(short_c, test.cc(), c_name), program, left_in);
    let else_lands = j(c_lands, λ target _ => JccLands(asm_labels(program), prog_len(tested), short_c, test.cc(), c_name, target),
        jcc_item_lands(asm_labels(program), left_in.witness, program, tested, 0, short_c, test.cc(), c_name, lands, left_in.proof));
    let jump_lands = j(j_lands, λ target _ => JmpLands(asm_labels(program), prog_len(leave), short_j, j_name, target),
        jmp_item_lands(asm_labels(program), jumped_in.witness, program, leave, 0, short_j, j_name, lands, jumped_in.proof));
    let pre = stack.LoopPassed(saves, keep, s0, file, values);
    let post = stack.LoopAt(saves, keep, s0, registers, words_of(values, ids));
    site.moves_test_by(stack.writes, fits, pass, test, c_name, short_c, test_in.witness, test_in.proof, left_in.witness, left_in.proof,
        prog_len(jumped), else_lands, j_at, pre, λ (t: MachineState<M>) => post(t.gprs, t.memory),
        site.moves_trans(stack.writes, prog_len(left), prog_len(leave), j_at,
            λ (s: MachineState<M>) => pre(s.gprs, s.memory) ∧ test.taken(s.gprs) = False,
            λ (s: MachineState<M>) => post(s.gprs, s.memory), λ (t: MachineState<M>) => post(t.gprs, t.memory),
            site.moves_weaken(stack.writes, prog_len(left), prog_len(leave), λ (s: MachineState<M>) => pre(s.gprs, s.memory),
                λ (t: MachineState<M>) => post(t.gprs, t.memory),
                λ (s: MachineState<M>) => pre(s.gprs, s.memory) ∧ test.taken(s.gprs) = False,
                λ (t: MachineState<M>) => post(t.gprs, t.memory),
                site.moves_block(stack.writes, fits, leave_in.witness, left, 0, moves, leave_in.proof,
                    program.block_reads_at(laid, leave_in.witness, left, 0, moves, leave_in.proof), pre, post,
                    λ s memory held => {
                        let ran = into(s, held.left);
                        ⟨ran.left, ⟨kept_trans(body_kept(saves), s0.gprs, s.gprs, execute_block_normal(moves, s).gprs, held.right.left, ran.right),
                            held.right.right⟩⟩
                    }),
                λ s held => held.left, λ t held => held),
            site.moves_jump_item(stack.writes, fits, jumped_in.witness, leave, 0, short_j, j_name, jumped_in.proof, j_at, jump_lands, post)),
        site.moves_absurd(stack.writes, prog_len(jumped), j_at,
            λ (s: MachineState<M>) => pre(s.gprs, s.memory) ∧ test.taken(s.gprs) = True,
            λ (t: MachineState<M>) => post(t.gprs, t.memory),
            λ s held => {
                let bad: (True = False) = trans(sym(held.right), trans(selects(s.gprs, held.left.left), cong_fn<Bool, Bool>(λ b => !b, set)));
                absurd(bad)
            }))
}

// The exit bit clear: `loop_turns` (the test jumps to C, the moves there),
// then JMP H.
theorem plain_turns<M>(saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), keep: M → Type,
    s0: MachineState<M>, pass: Prog, file: File, test: Test, exit: Nat, moves: List<Instruction>, ids: List<Nat>, registers: List<Gpr>, names: Nat,
    short: List<Nat>, again_in: plain_again(pass, test, moves, names, short).Within(site.program),
    c_lands: asm_target(site.program, names + 2) = prog_len(plain_jumped(pass, test, moves, names, short)),
    h_at: Nat, h_lands: asm_target(site.program, names + 1) = h_at, values: Valuation(),
    selects: (g: Gprs) → file.Represents(values, g) → test.taken(g) = !values(1, exit).head_bit(),
    into: MovesInto<M>(saves, values, file, ids, registers, moves), clear: values(1, exit).head_bit() = False):
    site.Moves(stack.writes, prog_len(pass), h_at,
        λ (s: MachineState<M>) => stack.LoopPassed(saves, keep, s0, file, values)(s.gprs, s.memory),
        λ (t: MachineState<M>) => stack.LoopAt(saves, keep, s0, registers, words_of(values, ids))(t.gprs, t.memory)) {
    let program = site.program;
    let back = plain_back(pass, test, moves, names, short);
    let short_h = shorts(short, names + 1);
    let back_in = back.within_before(0, jmp_item(short_h, names + 1), program, again_in);
    let jump_lands = j(h_lands, λ target _ => JmpLands(asm_labels(program), prog_len(back), short_h, names + 1, target),
        jmp_item_lands(asm_labels(program), again_in.witness, program, back, 0, short_h, names + 1, program.laid_out_lands(laid), again_in.proof));
    let post = stack.LoopAt(saves, keep, s0, registers, words_of(values, ids));
    site.moves_trans(stack.writes, prog_len(pass), prog_len(back), h_at,
        λ (s: MachineState<M>) => stack.LoopPassed(saves, keep, s0, file, values)(s.gprs, s.memory),
        λ (s: MachineState<M>) => post(s.gprs, s.memory), λ (t: MachineState<M>) => post(t.gprs, t.memory),
        loop_turns<M>(saves, site, laid, stack, keep, s0, pass, file, test, exit, moves, ids, registers, plain_jumped(pass, test, moves, names, short),
            names + 2, shorts(short, names + 2), Exists(2, refl), back_in, c_lands, values, selects, into, clear),
        site.moves_jump_item(stack.writes, program.laid_out_fits(laid), again_in.witness, back, 0, short_h, names + 1, again_in.proof, h_at, jump_lands,
            post))
}

// A label's item is empty.
theorem label_len(p: Prog, name: Nat): prog_len(At(p, name, Block([]))) = prog_len(p) { refl }

// The loop's head over the state `now` leaves: the state's words in their
// registers, the trail over `now`.
fn PlainAt<M>(saves: Nat, site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, w: Nat, s0: MachineState<M>, registers: List<Gpr>,
    state: List<BitVec(64)>, now: Heap) → MachineState<M> → Type {
    λ (s: MachineState<M>) => stack.LoopAt(saves, λ (x: M) => stack.TrailBy(spans, heap_in<M>(site.data, spans), w, s0.memory, now, x), s0, registers,
        state)(s.gprs, s.memory)
}

// Where the loop's labels land, read off the code once.
record PlainLabels<M>(site: Site<M>, prog: Prog, code: List<Instruction>, pass: Prog, test: Test, moves: List<Instruction>, names: Nat,
    short: List<Nat>) {
    again_in: plain_again(pass, test, moves, names, short).Within(site.program),
    jumped_in: plain_jumped(pass, test, moves, names, short).Within(site.program),
    c_lands: asm_target(site.program, names + 2) = prog_len(plain_jumped(pass, test, moves, names, short)),
    h_lands: asm_target(site.program, names + 1) = prog_len(At(prog, 0, Block(code))),
    j_lands: asm_target(site.program, names + 3) = prog_len(plain_again(pass, test, moves, names, short)),
}

theorem plain_labels<M>(site: Site<M>, laid: site.program.laid_out().IsTrue(), prog: Prog, code: List<Instruction>, pass: Prog, test: Test,
    moves: List<Instruction>, names: Nat, short: List<Nat>, head_pass: plain_head(prog, code, names).Within(pass),
    done_in: plain_done(pass, test, moves, names, short).Within(site.program)): PlainLabels<M>(site, prog, code, pass, test, moves, names, short) {
    let program = site.program;
    let unique = program.laid_out_unique(laid);
    let jumped = plain_jumped(pass, test, moves, names, short);
    let again = plain_again(pass, test, moves, names, short);
    let again_in: again.Within(program) = again.within_before(names + 3, Block([]), program, done_in);
    let c_in: At(jumped, names + 2, Block([])).Within(program) = Prog::within_trans(Exists(2, refl), again_in);
    let head_in: plain_head(prog, code, names).Within(program) = Prog::within_trans(head_pass, Prog::within_trans(Exists(8, refl), done_in));
    PlainLabels(again_in := again_in, jumped_in := Prog::within_trans(Exists(3, refl), again_in),
        c_lands := label_target(c_in.witness, program, jumped, names + 1, Block([]), unique, c_in.proof),
        h_lands := label_target(head_in.witness, program, At(prog, 0, Block(code)), names, Block([]), unique, head_in.proof),
        j_lands := label_target(done_in.witness, program, again, names + 2, Block([]), unique, done_in.proof))
}

// One pass from the head: its body, then out to J or round to H.
theorem plain_step<M>(saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), spans: Spans,
    Pass: Valuation() → Heap → Heap → Type, w: Nat, s0: MachineState<M>, prog: Prog, code: List<Instruction>, head: File, registers: List<Gpr>,
    parameters: List<Typed>, exit: Nat, next: List<Typed>, names: Nat, short: List<Nat>, pass: Emitted, test: Test, moves: List<Instruction>,
    labels: PlainLabels<M>(site, prog, code, pass.prog, test, moves, names, short),
    head_ok: (v: Valuation()) → (g: Gprs) → ArgsIn(words_of(v, typed_ids(parameters)), registers, g) → head.Represents(v, g),
    pass_emits: (v: Valuation()) → (from, to: Heap) →
        EmitsHeap<M>(saves, site, stack, spans, v, w, s0, plain_head(prog, code, names), head, Pass(v, from, to), from, to, pass),
    pass_in: pass.prog.Within(site.program),
    selects: (v: Valuation()) → (g: Gprs) → pass.file.Represents(v, g) → test.taken(g) = !v(1, exit).head_bit(),
    into: (v: Valuation()) → MovesInto<M>(saves, v, pass.file, typed_ids(next), registers, moves),
    final: List<BitVec(64)>, after: Heap, m: Nat, state: List<BitVec(64)>, now: Heap, v: Valuation(),
    eq: words_of(v, typed_ids(parameters)) = state, mid: Heap, passed: Pass(v, now, mid),
    rest: match v(1, exit).head_bit() {
        True => (final = words_of(v, typed_ids(next))) ∧ (after = mid),
        False => PassesHold(Pass, parameters, exit, next, m, words_of(v, typed_ids(next)), mid, final, after),
    }):
    site.Moves(stack.writes, prog_len(At(prog, 0, Block(code))), prog_len(plain_again(pass.prog, test, moves, names, short)),
        PlainAt<M>(saves, site, stack, spans, w, s0, registers, state, now), PlainAt<M>(saves, site, stack, spans, w, s0, registers, final, after)) ∨
    Exists<List<BitVec(64)>>(λ later => Exists<Heap>(λ left => PassesHold(Pass, parameters, exit, next, m, later, left, final, after) ∧
        site.Moves(stack.writes, prog_len(At(prog, 0, Block(code))), prog_len(At(prog, 0, Block(code))),
            PlainAt<M>(saves, site, stack, spans, w, s0, registers, state, now), PlainAt<M>(saves, site, stack, spans, w, s0, registers, later, left)))) {
    let h_at = prog_len(At(prog, 0, Block(code)));
    let j_at = prog_len(plain_again(pass.prog, test, moves, names, short));
    let keep_mid = λ (x: M) => stack.TrailBy(spans, heap_in<M>(site.data, spans), w, s0.memory, mid, x);
    let passed_at = λ (t: MachineState<M>) => stack.LoopPassed(saves, keep_mid, s0, pass.file, v)(t.gprs, t.memory);
    let ran = loop_body_runs_by<M, Heap>(saves, site, stack, spans, heap_in<M>(site.data, spans), Pass, w, s0, plain_head(prog, code, names), head,
        registers, typed_ids(parameters), head_ok, v, now, mid, pass, pass_emits(v, now, mid), pass_in, passed);
    let start = j(eq, λ x _ => site.Moves(stack.writes, h_at, prog_len(pass.prog), PlainAt<M>(saves, site, stack, spans, w, s0, registers, x, now),
        passed_at), ran);
    (match v(1, exit).head_bit() as λ b => v(1, exit).head_bit() = b →
        (match b {
            True => (final = words_of(v, typed_ids(next))) ∧ (after = mid),
            False => PassesHold(Pass, parameters, exit, next, m, words_of(v, typed_ids(next)), mid, final, after),
        }) →
        site.Moves(stack.writes, h_at, j_at, PlainAt<M>(saves, site, stack, spans, w, s0, registers, state, now),
            PlainAt<M>(saves, site, stack, spans, w, s0, registers, final, after)) ∨
        Exists<List<BitVec(64)>>(λ later => Exists<Heap>(λ left => PassesHold(Pass, parameters, exit, next, m, later, left, final, after) ∧
            site.Moves(stack.writes, h_at, h_at, PlainAt<M>(saves, site, stack, spans, w, s0, registers, state, now),
                PlainAt<M>(saves, site, stack, spans, w, s0, registers, later, left)))) {
        True => λ set done => {
            let out = plain_leaves<M>(saves, site, laid, stack, keep_mid, s0, pass.prog, pass.file, test, exit, moves, typed_ids(next), registers, names, short,
                labels.jumped_in, labels.c_lands, j_at, labels.j_lands, v, selects(v), into(v), set);
            Inl(site.moves_trans(stack.writes, h_at, prog_len(pass.prog), j_at, PlainAt<M>(saves, site, stack, spans, w, s0, registers, state, now),
                passed_at, PlainAt<M>(saves, site, stack, spans, w, s0, registers, final, after), start,
                j(sym(done.right), λ h _ => site.Moves(stack.writes, prog_len(pass.prog), j_at, passed_at,
                        PlainAt<M>(saves, site, stack, spans, w, s0, registers, final, h)),
                    j(sym(done.left), λ f _ => site.Moves(stack.writes, prog_len(pass.prog), j_at, passed_at,
                        PlainAt<M>(saves, site, stack, spans, w, s0, registers, f, mid)), out))))
        },
        False => λ clear later => Inr(Exists(words_of(v, typed_ids(next)), Exists(mid, ⟨later,
            site.moves_trans(stack.writes, h_at, prog_len(pass.prog), h_at, PlainAt<M>(saves, site, stack, spans, w, s0, registers, state, now), passed_at,
                PlainAt<M>(saves, site, stack, spans, w, s0, registers, words_of(v, typed_ids(next)), mid), start,
                plain_turns<M>(saves, site, laid, stack, keep_mid, s0, pass.prog, pass.file, test, exit, moves, typed_ids(next), registers, names, short,
                    labels.again_in, labels.c_lands, h_at, labels.h_lands, v, selects(v), into(v), clear))⟩))),
    })(refl, rest)
}

// The passes, by induction on the fuel (`Site::loop_iterates`).
theorem plain_passes<M>(saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), spans: Spans,
    Pass: Valuation() → Heap → Heap → Type, w: Nat, s0: MachineState<M>, prog: Prog, code: List<Instruction>, head: File, registers: List<Gpr>,
    parameters: List<Typed>, exit: Nat, next: List<Typed>, names: Nat, short: List<Nat>, pass: Emitted, test: Test, moves: List<Instruction>,
    labels: PlainLabels<M>(site, prog, code, pass.prog, test, moves, names, short),
    head_ok: (v: Valuation()) → (g: Gprs) → ArgsIn(words_of(v, typed_ids(parameters)), registers, g) → head.Represents(v, g),
    pass_emits: (v: Valuation()) → (from, to: Heap) →
        EmitsHeap<M>(saves, site, stack, spans, v, w, s0, plain_head(prog, code, names), head, Pass(v, from, to), from, to, pass),
    pass_in: pass.prog.Within(site.program),
    selects: (v: Valuation()) → (g: Gprs) → pass.file.Represents(v, g) → test.taken(g) = !v(1, exit).head_bit(),
    into: (v: Valuation()) → MovesInto<M>(saves, v, pass.file, typed_ids(next), registers, moves),
    final: List<BitVec(64)>, after: Heap, n: Nat, state: List<BitVec(64)>, now: Heap,
    ran: PassesHold(Pass, parameters, exit, next, n, state, now, final, after)):
    site.Moves(stack.writes, prog_len(At(prog, 0, Block(code))), prog_len(plain_again(pass.prog, test, moves, names, short)),
        PlainAt<M>(saves, site, stack, spans, w, s0, registers, state, now), PlainAt<M>(saves, site, stack, spans, w, s0, registers, final, after)) {
    site.loop_iterates<M, Heap>(stack.writes, prog_len(At(prog, 0, Block(code))), prog_len(plain_again(pass.prog, test, moves, names, short)),
        λ (_: Nat) (st: List<BitVec(64)>) (at: Heap) => PlainAt<M>(saves, site, stack, spans, w, s0, registers, st, at),
        PlainAt<M>(saves, site, stack, spans, w, s0, registers, final, after),
        λ (k: Nat) (st: List<BitVec(64)>) (at: Heap) => PassesHold(Pass, parameters, exit, next, k, st, at, final, after),
        λ st at never => false_elim(never),
        λ k st at holds => plain_step<M>(saves, site, laid, stack, spans, Pass, w, s0, prog, code, head, registers, parameters, exit, next, names, short, pass,
            test, moves, labels, head_ok, pass_emits, pass_in, selects, into, final, after, k, st, at, holds.witness, holds.proof.left,
            holds.proof.right.witness, holds.proof.right.proof.left, holds.proof.right.proof.right),
        n, state, now, ran)
}

// The loop: the entry's moves, the passes, and the outputs in the state's
// registers at J.
theorem plain_loop_emits<M>(saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), spans: Spans,
    Pass: Valuation() → Heap → Heap → Type, values: Valuation(), w: Nat, s0: MachineState<M>, prog: Prog, file: File, inputs, parameters: List<Typed>,
    exit: Nat, next, outputs: List<Typed>, names: Nat, short: List<Nat>, registers: List<Gpr>, entry: PlainEntry,
    entered: MovesInto<M>(saves, values, file, typed_ids(inputs), registers, entry.code),
    head_ok: (v: Valuation()) → (g: Gprs) → ArgsIn(words_of(v, typed_ids(parameters)), registers, g) → entry.head.Represents(v, g),
    pass: Emitted,
    pass_emits: (v: Valuation()) → (from, to: Heap) →
        EmitsHeap<M>(saves, site, stack, spans, v, w, s0, plain_head(prog, entry.code, names), entry.head, Pass(v, from, to), from, to, pass),
    tested: Tested(pass.file, exit), moves: List<Instruction>, into: (v: Valuation()) → MovesInto<M>(saves, v, pass.file, typed_ids(next), registers, moves),
    out: File, out_ok: (g: Gprs) → ArgsIn(words_of(values, typed_ids(outputs)), registers, g) → out.Represents(values, g), before, after: Heap):
    EmitsHeap<M>(saves, site, stack, spans, values, w, s0, prog, file,
        Exists<Nat>(λ n => PassesHold(Pass, parameters, exit, next, n, words_of(values, typed_ids(inputs)), before, words_of(values, typed_ids(outputs)),
            after)),
        before, after, Emitted(plain_done(pass.prog, tested.test, moves, names, short), out, pass.placement, pass.names)) {
    let program = site.program;
    let code = entry.code;
    let test = tested.test;
    let head_pass: plain_head(prog, code, names).Within(pass.prog) = (pass_emits(values, before, before)).left;
    let facts: Type = Exists<Nat>(λ n => PassesHold(Pass, parameters, exit, next, n, words_of(values, typed_ids(inputs)), before,
        words_of(values, typed_ids(outputs)), after));
    let pre = λ (g: Gprs) (m: M) => (file.Represents(values, g) ∧ facts) ∧
        (Kept(body_kept(saves), s0.gprs, g) ∧ stack.TrailBy(spans, heap_in<M>(site.data, spans), w, s0.memory, before, m));
    let into_head: prog.Within(plain_head(prog, code, names)) = Exists(2, refl);
    let pass_done: pass.prog.Within(plain_done(pass.prog, test, moves, names, short)) = Exists(8, refl);
    ⟨Prog::within_trans(into_head, Prog::within_trans(head_pass, pass_done)),
     λ within s here resident held => {
        let labels = plain_labels<M>(site, laid, prog, code, pass.prog, test, moves, names, short, head_pass, within);
        let pass_in: pass.prog.Within(program) = Prog::within_trans(Exists(8, refl), within);
        let entered_in: At(prog, 0, Block(code)).Within(program) = Prog::within_trans(Exists(1, refl), Prog::within_trans(head_pass, pass_in));
        let entry_run = site.moves_block(stack.writes, program.laid_out_fits(laid), entered_in.witness, prog, 0, code, entered_in.proof,
            program.block_reads_at(laid, entered_in.witness, prog, 0, code, entered_in.proof), pre,
            λ (g: Gprs) (m: M) => stack.LoopAt(saves, λ (x: M) => stack.TrailBy(spans, heap_in<M>(site.data, spans), w, s0.memory, before, x), s0,
                registers, words_of(values, typed_ids(inputs)))(g, m),
            λ x memory held_x => {
                let ran = entered(x, held_x.left.left);
                ⟨ran.left, ⟨kept_trans(body_kept(saves), s0.gprs, x.gprs, execute_block_normal(code, x).gprs, held_x.right.left, ran.right),
                    held_x.right.right⟩⟩
            });
        let passes = plain_passes<M>(saves, site, laid, stack, spans, Pass, w, s0, prog, code, entry.head, registers, parameters, exit, next, names, short,
            pass, test, moves, labels, head_ok, pass_emits, pass_in, tested.selects, into, words_of(values, typed_ids(outputs)), after,
            held.left.right.witness, words_of(values, typed_ids(inputs)), before, held.left.right.proof);
        let got = site.moves_trans(stack.writes, prog_len(prog), prog_len(At(prog, 0, Block(code))), prog_len(plain_again(pass.prog, test, moves, names, short)),
            λ (x: MachineState<M>) => pre(x.gprs, x.memory), PlainAt<M>(saves, site, stack, spans, w, s0, registers, words_of(values, typed_ids(inputs)), before),
            PlainAt<M>(saves, site, stack, spans, w, s0, registers, words_of(values, typed_ids(outputs)), after), entry_run, passes)(s, here, resident, held);
        let t = got.witness;
        let at = got.proof.right.right.right;
        Exists(t, ⟨got.proof.left, ⟨got.proof.right.left, ⟨got.proof.right.right.left, ⟨out_ok(t.gprs, at.left), at.right⟩⟩⟩⟩)
     }⟩
}

// The entry's moves and the head's file.
fn MayPlainEntry<M>(saves: Nat, values: Valuation(), file: File, inputs, parameters: List<Nat>, registers: List<Gpr>, out: Option<PlainEntry>) → Type {
    out.All(λ (entry: PlainEntry) => MovesInto<M>(saves, values, file, inputs, registers, entry.code) ∧
        ((v: Valuation()) → (g: Gprs) → ArgsIn(words_of(v, parameters), registers, g) → entry.head.Represents(v, g)))
}

theorem plain_entry_sound<M>(saves: Nat, values: Valuation(), file: File, inputs, parameters: List<Nat>, registers: List<Gpr>):
    MayPlainEntry<M>(saves, values, file, inputs, parameters, registers, file.plain_entry(saves, inputs, parameters, registers)) {
    (match file.move_outputs(word_ports(inputs), registers) as λ o => MayKeep<M>(values, file, True, o) →
        MayPlainEntry<M>(saves, values, file, inputs, parameters, registers, match o {
            None => None,
            Some(moves) => match moves.file.outputs_check(word_ports(inputs), registers) && leaves_all(moves.code, body_kept(saves)) {
                False => None,
                True => match input_file(word_ports(parameters), registers) { None => None, Some(head) => Some(PlainEntry(moves.code, head)) },
            },
        }) {
        None => λ _ => trivial,
        Some(moves) => λ keeps => match checked: moves.file.outputs_check(word_ports(inputs), registers) && leaves_all(moves.code, body_kept(saves)) {
            False => trivial,
            True => {
                let parts = Bool::is_true_and(moves.file.outputs_check(word_ports(inputs), registers), leaves_all(moves.code, body_kept(saves)),
                    is_true_of_eq(moves.file.outputs_check(word_ports(inputs), registers) && leaves_all(moves.code, body_kept(saves)), checked));
                (match input_file(word_ports(parameters), registers) as λ o =>
                    ((v: Valuation()) → (g: Gprs) → PortsAt(v, word_ports(parameters), registers, g) → o.All(λ (f: File) => f.Represents(v, g))) →
                    MayPlainEntry<M>(saves, values, file, inputs, parameters, registers, match o { None => None, Some(head) => Some(PlainEntry(moves.code, head)) }) {
                    None => λ _ => trivial,
                    Some(head) => λ head_ok => ⟨moves_into<M>(saves, values, file, inputs, registers, moves, keeps, parts.left, parts.right),
                        λ v g args => head_ok(v, g, args_ports(v, parameters, registers, g, args))⟩,
                })(λ v g placed => input_file_represents(v, g, word_ports(parameters), registers, placed))
            },
        },
    })(move_outputs_keeps<M>(values, word_ports(inputs), file, registers))
}

// After the pass, as `Emitted::plain_close` checks it.
theorem plain_close_emits<M>(saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), spans: Spans,
    Pass: Valuation() → Heap → Heap → Type, values: Valuation(), w: Nat, s0: MachineState<M>, prog: Prog, file: File, inputs, parameters: List<Typed>,
    exit: Nat, next, outputs: List<Typed>, names: Nat, short: List<Nat>, registers: List<Gpr>, entry: PlainEntry,
    entry_ok: MovesInto<M>(saves, values, file, typed_ids(inputs), registers, entry.code) ∧
        ((v: Valuation()) → (g: Gprs) → ArgsIn(words_of(v, typed_ids(parameters)), registers, g) → entry.head.Represents(v, g)),
    pass: Emitted,
    pass_emits: (v: Valuation()) → (from, to: Heap) →
        EmitsHeap<M>(saves, site, stack, spans, v, w, s0, plain_head(prog, entry.code, names), entry.head, Pass(v, from, to), from, to, pass),
    before, after: Heap):
    MayEmitHeap<M>(saves, site, stack, spans, values, w, s0, prog, file,
        Exists<Nat>(λ n => PassesHold(Pass, parameters, exit, next, n, words_of(values, typed_ids(inputs)), before, words_of(values, typed_ids(outputs)),
            after)),
        before, after, pass.plain_close(saves, registers, exit, typed_ids(next), typed_ids(outputs), names, short)) {
    let facts: Type = Exists<Nat>(λ n => PassesHold(Pass, parameters, exit, next, n, words_of(values, typed_ids(inputs)), before,
        words_of(values, typed_ids(outputs)), after));
    let nexts = word_ports(typed_ids(next));
    let outs = word_ports(typed_ids(outputs));
    match pass.file.branch_test(exit) as λ t => MayEmitHeap<M>(saves, site, stack, spans, values, w, s0, prog, file, facts, before, after, match t {
            None => None,
            Some(tested) => match pass.file.move_outputs(nexts, registers) {
                None => None,
                Some(moves) => match moves.file.outputs_check(nexts, registers) && leaves_all(moves.code, body_kept(saves)) {
                    False => None,
                    True => match input_file(outs, registers) {
                        None => None,
                        Some(out) => Some(Emitted(plain_done(pass.prog, tested.test, moves.code, names, short), out, pass.placement, pass.names)),
                    },
                },
            },
        }) {
        None => trivial,
        Some(tested) => (match pass.file.move_outputs(nexts, registers) as λ o => ((v: Valuation()) → MayKeep<M>(v, pass.file, True, o)) →
            MayEmitHeap<M>(saves, site, stack, spans, values, w, s0, prog, file, facts, before, after, match o {
                None => None,
                Some(moves) => match moves.file.outputs_check(nexts, registers) && leaves_all(moves.code, body_kept(saves)) {
                    False => None,
                    True => match input_file(outs, registers) {
                        None => None,
                        Some(out) => Some(Emitted(plain_done(pass.prog, tested.test, moves.code, names, short), out, pass.placement, pass.names)),
                    },
                },
            }) {
            None => λ _ => trivial,
            Some(moves) => λ keeps => match checked: moves.file.outputs_check(nexts, registers) && leaves_all(moves.code, body_kept(saves)) {
                False => trivial,
                True => {
                    let parts = Bool::is_true_and(moves.file.outputs_check(nexts, registers), leaves_all(moves.code, body_kept(saves)),
                        is_true_of_eq(moves.file.outputs_check(nexts, registers) && leaves_all(moves.code, body_kept(saves)), checked));
                    (match input_file(outs, registers) as λ o =>
                        ((g: Gprs) → PortsAt(values, outs, registers, g) → o.All(λ (f: File) => f.Represents(values, g))) →
                        MayEmitHeap<M>(saves, site, stack, spans, values, w, s0, prog, file, facts, before, after, match o {
                            None => None,
                            Some(out) => Some(Emitted(plain_done(pass.prog, tested.test, moves.code, names, short), out, pass.placement, pass.names)),
                        }) {
                        None => λ _ => trivial,
                        Some(out) => λ out_ok => plain_loop_emits<M>(saves, site, laid, stack, spans, Pass, values, w, s0, prog, file, inputs, parameters, exit,
                            next, outputs, names, short, registers, entry, entry_ok.left, entry_ok.right, pass, pass_emits, tested, moves.code,
                            λ v => moves_into<M>(saves, v, pass.file, typed_ids(next), registers, moves, keeps(v), parts.left, parts.right), out,
                            λ g args => out_ok(g, args_ports(values, typed_ids(outputs), registers, g, args)), before, after),
                    })(λ g placed => input_file_represents(values, g, outs, registers, placed))
                },
            },
        })(λ v => move_outputs_keeps<M>(v, nexts, pass.file, registers)),
    }
}

// The loop's code, as `Body::emit` checks it, from its body's emission at
// every valuation (`inner_emits`, the region theorem at the pass's).
theorem loop_heap_emits<M>(saves, slots: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data),
    spans: Spans, blocks: Blocks, answers: RoutineAnswers(), values: Valuation(), spare, w: Nat, s0: MachineState<M>, short: List<Nat>, bound: Nat,
    inputs, parameters: List<Typed>, inner: Body, exit: Nat, next, outputs: List<Typed>, prog: Prog, file: File, placement: List<Place>, names: Nat,
    before, after: Heap,
    inner_emits: (start: Prog) → (head: File) → (rest: List<Place>) → (v: Valuation()) → (from, to: Heap) →
        MayEmitHeap<M>(saves, site, stack, spans, v, w, s0, start, head, inner.Holds(spans, blocks, v, answers, spare, from, to), from, to,
            inner.emit(saves, slots, short, bound, spare, start, head, rest, names + 4))):
    MayEmitHeap<M>(saves, site, stack, spans, values, w, s0, prog, file,
        Body::Loop(inputs, parameters, inner, exit, next, outputs).Holds(spans, blocks, values, answers, spare, before, after), before, after,
        match state_registers(placement, typed_ids(parameters).len()) {
            None => None,
            Some(taken) => match file.plain_entry(saves, typed_ids(inputs), typed_ids(parameters), taken.registers) {
                None => None,
                Some(entry) => match inner.emit(saves, slots, short, bound, spare, plain_head(prog, entry.code, names), entry.head, taken.rest, names + 4) {
                    None => None,
                    Some(pass) => pass.plain_close(saves, taken.registers, exit, typed_ids(next), typed_ids(outputs), names, short),
                },
            },
        }) {
    let Pass = λ (v: Valuation()) (from: Heap) (to: Heap) => inner.Holds(spans, blocks, v, answers, spare, from, to);
    let facts = Body::Loop(inputs, parameters, inner, exit, next, outputs).Holds(spans, blocks, values, answers, spare, before, after);
    match state_registers(placement, typed_ids(parameters).len()) as λ o => MayEmitHeap<M>(saves, site, stack, spans, values, w, s0, prog, file, facts,
            before, after, match o {
                None => None,
                Some(taken) => match file.plain_entry(saves, typed_ids(inputs), typed_ids(parameters), taken.registers) {
                    None => None,
                    Some(entry) => match inner.emit(saves, slots, short, bound, spare, plain_head(prog, entry.code, names), entry.head, taken.rest, names + 4) {
                        None => None,
                        Some(pass) => pass.plain_close(saves, taken.registers, exit, typed_ids(next), typed_ids(outputs), names, short),
                    },
                },
            }) {
        None => trivial,
        Some(taken) => (match file.plain_entry(saves, typed_ids(inputs), typed_ids(parameters), taken.registers) as λ e =>
            MayPlainEntry<M>(saves, values, file, typed_ids(inputs), typed_ids(parameters), taken.registers, e) →
            MayEmitHeap<M>(saves, site, stack, spans, values, w, s0, prog, file, facts, before, after, match e {
                None => None,
                Some(entry) => match inner.emit(saves, slots, short, bound, spare, plain_head(prog, entry.code, names), entry.head, taken.rest, names + 4) {
                    None => None,
                    Some(pass) => pass.plain_close(saves, taken.registers, exit, typed_ids(next), typed_ids(outputs), names, short),
                },
            }) {
            None => λ _ => trivial,
            Some(entry) => λ entry_ok => (match inner.emit(saves, slots, short, bound, spare, plain_head(prog, entry.code, names), entry.head, taken.rest,
                    names + 4) as λ e =>
                ((v: Valuation()) → (from, to: Heap) → MayEmitHeap<M>(saves, site, stack, spans, v, w, s0, plain_head(prog, entry.code, names), entry.head,
                    Pass(v, from, to), from, to, e)) →
                MayEmitHeap<M>(saves, site, stack, spans, values, w, s0, prog, file, facts, before, after, match e {
                    None => None,
                    Some(pass) => pass.plain_close(saves, taken.registers, exit, typed_ids(next), typed_ids(outputs), names, short),
                }) {
                None => λ _ => trivial,
                Some(pass) => λ pass_emits => plain_close_emits<M>(saves, site, laid, stack, spans, Pass, values, w, s0, prog, file, inputs, parameters, exit, next,
                    outputs, names, short, taken.registers, entry, entry_ok, pass, pass_emits, before, after),
            })(λ v from to => inner_emits(plain_head(prog, entry.code, names), entry.head, taken.rest, v, from, to)),
        })(plain_entry_sound<M>(saves, values, file, typed_ids(inputs), typed_ids(parameters), taken.registers)),
    }
}

// The branch: the generic conditional (`branch_emits_by`), the bit picking
// the arm's facts.
theorem branch_heap_emits<M>(saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data),
    spans: Spans, blocks: Blocks, values: Valuation(), answers: RoutineAnswers(), spare: Nat, d: Nat, s0: MachineState<M>, prog: Prog, file: File,
    condition: Nat, yes, no: Body, before, after: Heap, tested: Tested(file, condition), names: Nat, short: List<Nat>, left, right: Emitted,
    yes_emits: EmitsHeap<M>(saves, site, stack, spans, values, d, s0, prog.branched_by(tested.test, names + 1, shorts(short, names + 1)),
        file.know(Truth(condition)), yes.Holds(spans, blocks, values, answers, spare, before, after), before, after, left),
    no_emits: EmitsHeap<M>(saves, site, stack, spans, values, d, s0, left.prog.else_label_by(names + 1, names + 2, shorts(short, names + 2)),
        file.know(Falsity(condition)), no.Holds(spans, blocks, values, answers, spare, before, after), before, after, right)):
    EmitsHeap<M>(saves, site, stack, spans, values, d, s0, prog, file,
        Body::Branch(condition, yes, no).Holds(spans, blocks, values, answers, spare, before, after),
        before, after, Emitted(right.prog.join_label(names + 2), left.file.meet(right.file, file.known), right.placement, right.names)) {
    let picked = λ (b: Bool) => match b {
        True => yes.Holds(spans, blocks, values, answers, spare, before, after),
        False => no.Holds(spans, blocks, values, answers, spare, before, after),
    };
    let bit = values(1, condition).head_bit();
    branch_emits_by<M, Heap>(saves, site, laid, stack, spans, heap_in<M>(site.data, spans), values, d, s0, prog, file, condition, picked(bit),
        yes.Holds(spans, blocks, values, answers, spare, before, after), no.Holds(spans, blocks, values, answers, spare, before, after), before, after,
        tested, names, short, left, right, yes_emits, no_emits,
        λ h clear => j(function_ir_lower_calls::not_false(bit, clear), λ b _ => picked(b), h),
        λ h set => j(function_ir_lower_calls::not_true(bit, set), λ b _ => picked(b), h))
}

// A region's code meets its meaning, for every heap before and after: its
// calls against their callees' returns (`callees`), its frame at `d` with
// `slots` call slots below it where it calls (`Stack::CallFrame`), the
// body's own offset `w`.
theorem Body::emit_emits<M>(self body: Body, saves, slots: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(),
    stack: Stack<M>(site.fetch, site.data), top: Nat, spans: Spans, loan: Loan<M>(site.fetch, site.data, stack, top, spans), blocks: Blocks,
    lent: blocks.Lent(spans), rooms: Nat → Nat, bound, avail: Nat, answers: RoutineAnswers(),
    callees: CalleesReturn<M>(site, stack, spans, rooms, top, bound, answers), values: Valuation(), spare: Nat, d, w: Nat, s0: MachineState<M>,
    framing: body.calls().IsTrue() → stack.CallFrame(top, avail, d, slots, w, s0), short: List<Nat>):
    body.Fits(rooms, bound, avail) → (prog: Prog) → (file: File) → (placement: List<Place>) → (names: Nat) → (before, after: Heap) →
    MayEmitHeap<M>(saves, site, stack, spans, values, w, s0, prog, file, body.Holds(spans, blocks, values, answers, spare, before, after), before, after,
        body.emit(saves, slots, short, bound, spare, prog, file, placement, names)) {
    let mem = heap_in<M>(site.data, spans);
    match body {
        Leaf(instrs) => λ shallow prog file placement names before after =>
            emit_instrs_emits<M>(saves, site, laid, stack, top, spans, loan, blocks, lent, values, w, s0, instrs, prog, file, placement, names, before,
                after),
        Seq(first, rest) => λ shallow prog file placement names before after =>
            (match first.emit(saves, slots, short, bound, spare, prog, file, placement, names) as λ o =>
                ((mid: Heap) → MayEmitHeap<M>(saves, site, stack, spans, values, w, s0, prog, file,
                    first.Holds(spans, blocks, values, answers, spare, before, mid), before, mid, o)) →
                MayEmitHeap<M>(saves, site, stack, spans, values, w, s0, prog, file,
                    Body::Seq(first, rest).Holds(spans, blocks, values, answers, spare, before, after), before, after,
                    match o { None => None, Some(done) => rest.emit(saves, slots, short, bound, spare, done.prog, done.file, done.placement, done.names) }) {
                None => λ _ => trivial,
                Some(done) => λ first_emits => may_emit_by_seq<M, Heap>(saves, site, stack, spans, mem, values, w, s0, prog, file,
                    λ (mid: Heap) => first.Holds(spans, blocks, values, answers, spare, before, mid),
                    λ (mid: Heap) => rest.Holds(spans, blocks, values, answers, spare, mid, after),
                    before, after, done, first_emits, rest.emit(saves, slots, short, bound, spare, done.prog, done.file, done.placement, done.names),
                    λ mid => Body::emit_emits<M>(rest, saves, slots, site, laid, stack, top, spans, loan, blocks, lent, rooms, bound, avail, answers, callees,
                        values, spare, d, w, s0, λ c => framing(Bool::is_true_or_r(first.calls(), rest.calls(), c)), short, shallow.right, done.prog,
                        done.file, done.placement, done.names, mid, after)),
            })(λ mid => Body::emit_emits<M>(first, saves, slots, site, laid, stack, top, spans, loan, blocks, lent, rooms, bound, avail, answers, callees,
                values, spare, d, w, s0, λ c => framing(Bool::is_true_or_l(first.calls(), rest.calls(), c)), short, shallow.left, prog, file, placement,
                names, before, mid)),
        Branch(condition, yes, no) => λ shallow prog file placement names before after =>
            (match file.branch_test(condition) as λ o => MayEmitHeap<M>(saves, site, stack, spans, values, w, s0, prog, file,
                    Body::Branch(condition, yes, no).Holds(spans, blocks, values, answers, spare, before, after), before, after, match o {
                        None => None,
                        Some(tested) => match yes.emit(saves, slots, short, bound, spare, prog.branched_by(tested.test, names + 1, shorts(short, names + 1)),
                            file.know(Truth(condition)), placement, names + 2) {
                            None => None,
                            Some(left) => match no.emit(saves, slots, short, bound, spare,
                                left.prog.else_label_by(names + 1, names + 2, shorts(short, names + 2)), file.know(Falsity(condition)), left.placement,
                                left.names) {
                                None => None,
                                Some(right) => Some(Emitted(right.prog.join_label(names + 2), left.file.meet(right.file, file.known), right.placement,
                                    right.names)),
                            },
                        },
                    }) {
                None => trivial,
                Some(tested) => {
                    let yes_prog = prog.branched_by(tested.test, names + 1, shorts(short, names + 1));
                    (match yes.emit(saves, slots, short, bound, spare, yes_prog, file.know(Truth(condition)), placement, names + 2) as λ o =>
                        MayEmitHeap<M>(saves, site, stack, spans, values, w, s0, yes_prog, file.know(Truth(condition)),
                            yes.Holds(spans, blocks, values, answers, spare, before, after), before, after, o) →
                        MayEmitHeap<M>(saves, site, stack, spans, values, w, s0, prog, file,
                            Body::Branch(condition, yes, no).Holds(spans, blocks, values, answers, spare, before, after), before, after, match o {
                                None => None,
                                Some(left) => match no.emit(saves, slots, short, bound, spare,
                                    left.prog.else_label_by(names + 1, names + 2, shorts(short, names + 2)), file.know(Falsity(condition)), left.placement,
                                    left.names) {
                                    None => None,
                                    Some(right) => Some(Emitted(right.prog.join_label(names + 2), left.file.meet(right.file, file.known), right.placement,
                                        right.names)),
                                },
                            }) {
                        None => λ _ => trivial,
                        Some(left) => λ yes_emits => {
                            let no_prog = left.prog.else_label_by(names + 1, names + 2, shorts(short, names + 2));
                            (match no.emit(saves, slots, short, bound, spare, no_prog, file.know(Falsity(condition)), left.placement, left.names) as λ o =>
                                MayEmitHeap<M>(saves, site, stack, spans, values, w, s0, no_prog, file.know(Falsity(condition)),
                                    no.Holds(spans, blocks, values, answers, spare, before, after), before, after, o) →
                                MayEmitHeap<M>(saves, site, stack, spans, values, w, s0, prog, file,
                                    Body::Branch(condition, yes, no).Holds(spans, blocks, values, answers, spare, before, after), before, after, match o {
                                        None => None,
                                        Some(right) => Some(Emitted(right.prog.join_label(names + 2), left.file.meet(right.file, file.known),
                                            right.placement, right.names)),
                                    }) {
                                None => λ _ => trivial,
                                Some(right) => λ no_emits => branch_heap_emits<M>(saves, site, laid, stack, spans, blocks, values, answers, spare, w, s0, prog,
                                    file, condition, yes, no, before, after, tested, names, short, left, right, yes_emits, no_emits),
                            })(Body::emit_emits<M>(no, saves, slots, site, laid, stack, top, spans, loan, blocks, lent, rooms, bound, avail, answers, callees,
                                values, spare, d, w, s0, λ c => framing(Bool::is_true_or_r(yes.calls(), no.calls(), c)), short, shallow.right, no_prog,
                                file.know(Falsity(condition)), left.placement, left.names, before, after))
                        },
                    })(Body::emit_emits<M>(yes, saves, slots, site, laid, stack, top, spans, loan, blocks, lent, rooms, bound, avail, answers, callees,
                        values, spare, d, w, s0, λ c => framing(Bool::is_true_or_l(yes.calls(), no.calls(), c)), short, shallow.left, yes_prog,
                        file.know(Truth(condition)), placement, names + 2, before, after))
                },
            }),
        Call(callee, arguments, results) => λ shallow prog file placement names before after => {
            let frame = framing(trivial);
            j(frame.right.right.right.left, λ x _ => MayEmitHeap<M>(saves, site, stack, spans, values, x, s0, prog, file,
                    Body::Call(callee, arguments, results).Holds(spans, blocks, values, answers, spare, before, after), before, after,
                    file.emit_call(slots, prog, callee, typed_ids(arguments), call_result(results, spare), call_also(results), placement, names, bound, [], [])),
                call_heap_emits<M>(saves, slots, site, laid, stack, top, spans, loan, rooms, bound, avail, answers, callees, blocks, values, spare, d, s0,
                    frame.left, frame.right.left, frame.right.right.left, frame.right.right.right.right.left, frame.right.right.right.right.right, prog, file,
                    callee, arguments, results, shallow, placement, names, before, after))
        },
        Loop(inputs, parameters, inner, exit, next, outputs) => λ shallow prog file placement names before after =>
            loop_heap_emits<M>(saves, slots, site, laid, stack, spans, blocks, answers, values, spare, w, s0, short, bound, inputs, parameters, inner, exit,
                next, outputs, prog, file, placement, names, before, after,
                λ start head rest v from to => Body::emit_emits<M>(inner, saves, slots, site, laid, stack, top, spans, loan, blocks, lent, rooms, bound, avail,
                    answers, callees, v, spare, d, w, s0, framing, short, shallow, start, head, rest, names + 4, from, to)),
        Sys(_) => λ shallow prog file placement names before after => trivial,
        Exit(status) => λ shallow prog file placement names before after =>
            emit_exit_emits<M>(saves, site, stack, spans, values, w, s0, prog, file, status, placement, names, before, after),
    }
}

// ---------------------------------------------------------------------------
// The code of a run stopped short (docs/language/ownership-design.md §17.7)
//
// What a region's code proves of a run stopped at `x` (`Stop`): from the
// region's start, at no system call, the state the stop reads
// (`Stop::Reached`: going, any; exited, at the exit call) with at least
// `least` machine steps, counted where the fuel was spent (each turn's
// jump and each CALL; going asks the fuel's count, exited none). The world,
// at no system call, is the one it started in. A claim at the kernel of no
// system call, at the world `True`.

fn StopsHeap<M>(x: Stop, saves: Nat, site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, values: Valuation(), d: Nat, s0: MachineState<M>,
    prog: Prog, file: File, facts: Type, before: Heap, least: Nat, out: Emitted) → Type {
    prog.Within(out.prog) ∧ (out.prog.Within(site.program) →
        site.Claims(stack.writes, Kernel::none<M, True>(), 0, least, prog_len(prog),
            λ (r: Running<M, True>) => ((file.Represents(values, r.state.gprs) ∧ facts) ∧
                stack.TrailedBy(saves, spans, heap_in<M>(site.data, spans), d, s0, before, r.state)) ∧ True,
            x.Reached(site, stack)))
}

fn MayStopHeap<M>(x: Stop, saves: Nat, site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, values: Valuation(), d: Nat, s0: MachineState<M>,
    prog: Prog, file: File, facts: Type, before: Heap, least: Nat, out: Option<Emitted>) → Type {
    out.All(λ (emitted: Emitted) => StopsHeap<M>(x, saves, site, stack, spans, values, d, s0, prog, file, facts, before, least, emitted))
}

// Every routine below `bound` stopped at `x`, on the runs `goes` says,
// performs the stop's state with at least `least` machine steps from its
// entry.
fn CalleesStop<M>(x: Stop, site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, rooms: Nat → Nat, top, bound: Nat, goes: RoutineStops(), least: Nat) → Type {
    (f: Nat) → f + 1 <= bound → (args: List<Value>) → (heap: Heap) → goes(f, args, heap) →
        site.EntersClaim(stack, Kernel::none<M, True>(), 0, least, asm_labels(site.program)(f + 1),
            λ (i: Nat) (s: Running<M, True>) => RoutinePre<M>(site, stack, spans, rooms, top, f, args, heap)(i, s.state) ∧ True,
            λ (_: Nat) (_: Running<M, True>) (_: BitVec(64)) (t: Running<M, True>) => x.Reached(site, stack)(t))
}

// The heap's clause where a run may have left it: `Some` the heap injected,
// `None` nothing. The call sequence's claim at it, from `Some(before)` to
// `None`, cannot arrive past the call: so it is a claim of reaching the
// CALL.
fn heap_left<M>(data: ByteReadAccess<M>, spans: Spans) → Option<Heap> → M → Type {
    λ (o: Option<Heap>) (memory: M) => match o { None => True, Some(heap) => Injected<M>(data, spans, heap, memory) }
}

theorem heap_left_stable<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, stack: Stack<M>(fetch, data), top: Nat, spans: Spans,
    loan: Loan<M>(fetch, data, stack, top, spans)): stack.ClauseStable(top, heap_left<M>(data, spans)) {
    λ o => match o {
        None => λ memory k low word held => trivial,
        Some(heap) => loan.stable_injected(top, top.le_refl(), heap),
    }
}

// The kernel that, at a CALL, hands the code to a callee whose run from
// there makes at least `least` machine steps: the call sequence's claim at
// it is a claim of the caller's code going on into the callee.
fn into_callee<M>(x: Stop, site: Site<M>, stack: Stack<M>(site.fetch, site.data), least: Nat) → Kernel<M, True> {
    Kernel(λ (r: Running<M, True>) (P: Running<M, True> → Type) => site.Performs(stack.writes, Kernel::none<M, True>(), x.Reached(site, stack), 0, least,
        Running<M, True>(r.state, trivial)), λ r P Q implies handed => handed)
}

// A call stopped: the call's code to its CALL, the CALL, counted, and
// the callee's run, stopped.
theorem call_heap_stops<M>(x: Stop, saves, slots: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data),
    top: Nat, spans: Spans, loan: Loan<M>(site.fetch, site.data, stack, top, spans), rooms: Nat → Nat, bound, avail: Nat, goes: RoutineStops(), least: Nat,
    callees: CalleesStop<M>(x, site, stack, spans, rooms, top, bound, goes, least), blocks: Blocks, values: Valuation(), spare: Nat, d: Nat,
    s0: MachineState<M>, rsp0: read_gpr(Rsp, s0.gprs) = stack.at(d), room: avail <= d, deep: 24 <= d, fits: d + 8 * slots <= stack.size,
    under: (d + 8 * slots) + 8 <= top, prog: Prog, file: File, callee: Nat, arguments, results: List<Typed>,
    fit: callee + 1 <= bound → rooms(callee) + 24 <= avail, placement: List<Place>, names: Nat, before: Heap):
    MayStopHeap<M>(x, saves, site, stack, spans, values, d + 8 * slots, s0, prog, file,
        Exists<List<Value>>(λ args => (lower_values(spans, args) = words_of(values, typed_ids(arguments))) ∧ goes(callee, args, before)), before, 1 + least,
        file.emit_call(slots, prog, callee, typed_ids(arguments), call_result(results, spare), call_also(results), placement, names, bound, [], [])) {
    let Facts: Type = Exists<List<Value>>(λ (args: List<Value>) => (lower_values(spans, args) = words_of(values, typed_ids(arguments))) ∧ goes(callee, args, before));
    let mem = heap_left<M>(site.data, spans);
    let World = λ (o: Option<Heap>) (_: True) => o = Some(before);
    let kernel = into_callee<M>(x, site, stack, 1 + least);
    let none = Kernel::none<M, True>();
    let chain = file.emit_call_steps_claim<M, Option<Heap>, True>(saves, slots, site, laid, stack, top, bound, spans, mem, World, kernel, 1, 0,
        heap_left_stable<M>(stack, top, spans, loan), values, d, s0, rsp0, fits, under, deep, prog, callee, typed_ids(arguments),
        call_result(results, spare), call_also(results), placement, names, [], [], Facts, Some(before), None,
        λ eight slotted below lends count few moved facts g0 rep rsp k at u0 here resident held => {
            let i = (d - 8 * count) - 8;
            let low: (rooms(callee) <= i) = { let f = fit(below); omega };
            let high: (i + 8 <= top) = { omega };
            let room8: (i + 8 <= stack.size) = { omega };
            let displacement = asm_jump_of(asm_labels(site.program), prog_len(moved), CallTo(callee + 1));
            let handed = site.claims_call_by(stack, none, site.program.laid_out_fits(laid), k, moved, 0, callee + 1, at, asm_labels(site.program)(callee + 1),
                call_lands(asm_labels(site.program), k, site.program, moved, 0, callee + 1, site.program.laid_out_lands(laid), at), 0, least,
                λ (j2: Nat) (u: Running<M, True>) => RoutinePre<M>(site, stack, spans, rooms, top, callee, facts.witness, before)(j2, u.state) ∧ True,
                λ (_: Nat) (_: Running<M, True>) (_: BitVec(64)) (t: Running<M, True>) => x.Reached(site, stack)(t),
                callees(callee, below, facts.witness, before, facts.proof.right),
                λ (y: Running<M, True>) => stack.ArgsReadyBy(call_saves(placement), spans, mem, d, slots, s0, Some(before), g0, count,
                    words_of(values, typed_ids(arguments)), y.state) ∧ True,
                x.Reached(site, stack), λ _ => i,
                λ y ready => {
                    let pushed = call_pushes<M, Option<Heap>>(call_saves(placement), slots, eight, slotted, site, stack, top, spans, mem,
                        heap_left_stable<M>(stack, top, spans, loan), d, s0, fits, under, deep, count, few, words_of(values, typed_ids(arguments)), Some(before),
                        g0, displacement, y.state, ready.left);
                    ⟨pushed.left, ⟨room8, ⟨⟨⟨j(sym(facts.proof.left), λ ws _ => stack.Passed(ws, i, call_near_after(stack.writes, displacement, y.state)),
                        pushed.right.right.right), low⟩, ⟨high, pushed.right.right.left.right⟩⟩, trivial⟩⟩⟩
                },
                λ y t _ _ reached => reached)(Running<M, True>(u0.state, trivial), here, resident, ⟨held.left, trivial⟩);
            Exists(u0.state, Exists(0, ⟨refl, Inr(handed)⟩))
        });
    (match file.emit_call(slots, prog, callee, typed_ids(arguments), call_result(results, spare), call_also(results), placement, names, bound, [], []) as λ o =>
        MayEmitClaim<M, Option<Heap>, True>(saves, site, stack, spans, mem, World, kernel, 1, 0, values, d + 8 * slots, s0, prog, file, Facts, Some(before), None, o) →
        MayStopHeap<M>(x, saves, site, stack, spans, values, d + 8 * slots, s0, prog, file, Facts, before, 1 + least, o) {
        None => λ _ => trivial,
        Some(out) => λ emits => ⟨emits.left, λ within r here resident held => {
            let p = emits.right(within)(Running<M, True>(r.state, trivial), here, resident, ⟨held.left, refl⟩);
            match p.proof.proof.right {
                Inl(arrived) => {
                    let never: (None<Heap> = Some(before)) = arrived.right.right.right;
                    absurd(never)
                },
                Inr(handed) => site.performs_after(stack.writes, none, x.Reached(site, stack), 0, 1 + least, r, p.witness,
                    Exists(p.proof.witness, p.proof.proof.left), handed),
            }
        }⟩,
    })(chain)
}

// A branch stopped: the test, then the arm its bit picks, stopped.
theorem branch_heap_stops<M>(x: Stop, saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data),
    spans: Spans, values: Valuation(), d: Nat, s0: MachineState<M>, prog: Prog, file: File, condition: Nat, Yes, No: Type, before: Heap, least: Nat,
    tested: Tested(file, condition), names: Nat, short: List<Nat>, left, right: Emitted,
    yes_goes: StopsHeap<M>(x, saves, site, stack, spans, values, d, s0, prog.branched_by(tested.test, names + 1, shorts(short, names + 1)),
        file.know(Truth(condition)), Yes, before, least, left),
    no_goes: StopsHeap<M>(x, saves, site, stack, spans, values, d, s0, left.prog.else_label_by(names + 1, names + 2, shorts(short, names + 2)),
        file.know(Falsity(condition)), No, before, least, right),
    left_within: prog.branched_by(tested.test, names + 1, shorts(short, names + 1)).Within(left.prog),
    right_within: left.prog.else_label_by(names + 1, names + 2, shorts(short, names + 2)).Within(right.prog)):
    StopsHeap<M>(x, saves, site, stack, spans, values, d, s0, prog, file, match values(1, condition).head_bit() { True => Yes, False => No }, before, least,
        Emitted(right.prog.join_label(names + 2), left.file.meet(right.file, file.known), right.placement, right.names)) {
    let test = tested.test;
    let else_name = names + 1;
    let join_name = names + 2;
    let short_jcc = shorts(short, else_name);
    let short_jmp = shorts(short, join_name);
    let branched = prog.branched_by(test, else_name, short_jcc);
    let jumped = At(left.prog, 0, jmp_item(short_jmp, join_name));
    let second = left.prog.else_label_by(else_name, join_name, short_jmp);
    let to_branch = prog.within_step(prog.tested(test), 0, jcc_item(short_jcc, test.cc(), else_name),
        prog.within_then(0, Block([test.instruction()])));
    let to_second = prog.within_step(jumped, else_name, Block([]),
        prog.within_step(left.prog, 0, jmp_item(short_jmp, join_name), Prog::within_trans(to_branch, left_within)));
    let picked = λ (b: Bool) => match b { True => Yes, False => No };
    let pre = λ (g: Gprs) (m: M) (_: True) => ((file.Represents(values, g) ∧ picked(values(1, condition).head_bit())) ∧
        (Kept(body_kept(saves), s0.gprs, g) ∧ stack.TrailBy(spans, heap_in<M>(site.data, spans), d, s0.memory, before, m))) ∧ True;
    ⟨prog.within_step(right.prog, join_name, Block([]), Prog::within_trans(to_second, right_within)),
     λ within => {
        let program = site.program;
        let labels = asm_labels(program);
        let unique = program.laid_out_unique(laid);
        let lands = program.laid_out_lands(laid);
        let no_in = right.prog.within_before(join_name, Block([]), program, within);
        let second_in = Prog::within_trans(right_within, no_in);
        let jumped_in = jumped.within_before(else_name, Block([]), program, second_in);
        let yes_in = left.prog.within_before(0, jmp_item(short_jmp, join_name), program, jumped_in);
        let branched_in = Prog::within_trans(left_within, yes_in);
        let tested_in = prog.tested(test).within_before(0, jcc_item(short_jcc, test.cc(), else_name), program, branched_in);
        let else_lands = j(label_target(second_in.witness, program, jumped, names, Block([]), unique, second_in.proof),
            λ to _ => JccLands(labels, prog_len(prog.tested(test)), short_jcc, test.cc(), else_name, to),
            jcc_item_lands(labels, branched_in.witness, program, prog.tested(test), 0, short_jcc, test.cc(), else_name, lands, branched_in.proof));
        let selects = tested.selects(values);
        site.claims_test_by(stack.writes, Kernel::none<M, True>(), program.laid_out_fits(laid), prog, test, else_name, short_jcc, tested_in.witness,
            tested_in.proof, branched_in.witness, branched_in.proof, prog_len(left.prog) + asm_len(jmp_item(short_jmp, join_name)), else_lands, 0, least,
            pre, x.Reached(site, stack),
            site.claims_weaken(stack.writes, Kernel::none<M, True>(), 0, least, prog_len(branched),
                λ (r: Running<M, True>) => ((file.know(Truth(condition)).Represents(values, r.state.gprs) ∧ Yes) ∧
                    stack.TrailedBy(saves, spans, heap_in<M>(site.data, spans), d, s0, before, r.state)) ∧ True,
                x.Reached(site, stack),
                λ (r: Running<M, True>) => pre(r.state.gprs, r.state.memory, r.io) ∧ test.taken(r.state.gprs) = False,
                x.Reached(site, stack),
                yes_goes.right(yes_in),
                λ r held => {
                    let clear: (!values(1, condition).head_bit() = False) = trans(sym(selects(r.state.gprs, held.left.left.left.left)), held.right);
                    let bit = function_ir_lower_calls::not_false(values(1, condition).head_bit(), clear);
                    ⟨⟨⟨file.represents_know(values, r.state.gprs, Truth(condition), held.left.left.left.left, bit),
                        j(bit, λ b _ => picked(b), held.left.left.left.right)⟩, held.left.left.right⟩, trivial⟩
                },
                λ t done => done),
            site.claims_weaken(stack.writes, Kernel::none<M, True>(), 0, least, prog_len(second),
                λ (r: Running<M, True>) => ((file.know(Falsity(condition)).Represents(values, r.state.gprs) ∧ No) ∧
                    stack.TrailedBy(saves, spans, heap_in<M>(site.data, spans), d, s0, before, r.state)) ∧ True,
                x.Reached(site, stack),
                λ (r: Running<M, True>) => pre(r.state.gprs, r.state.memory, r.io) ∧ test.taken(r.state.gprs) = True,
                x.Reached(site, stack),
                no_goes.right(no_in),
                λ r held => {
                    let set: (!values(1, condition).head_bit() = True) = trans(sym(selects(r.state.gprs, held.left.left.left.left)), held.right);
                    let bit = function_ir_lower_calls::not_true(values(1, condition).head_bit(), set);
                    ⟨⟨⟨file.represents_know(values, r.state.gprs, Falsity(condition), held.left.left.left.left, bit),
                        j(bit, λ b _ => picked(b), held.left.left.left.right)⟩, held.left.left.right⟩, trivial⟩
                },
                λ t done => done))
     }⟩
}

// The turn round as a claim: the test falls to C, the next words move into
// the state's registers, and the JMP to the head, the one step the fuel
// pays for.
theorem plain_turns_claim<M>(saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), keep: M → Type,
    s0: MachineState<M>, pass: Prog, file: File, test: Test, exit: Nat, moves: List<Instruction>, ids: List<Nat>, registers: List<Gpr>, names: Nat,
    short: List<Nat>, again_in: plain_again(pass, test, moves, names, short).Within(site.program),
    c_lands: asm_target(site.program, names + 2) = prog_len(plain_jumped(pass, test, moves, names, short)),
    h_at: Nat, h_lands: asm_target(site.program, names + 1) = h_at, values: Valuation(),
    selects: (g: Gprs) → file.Represents(values, g) → test.taken(g) = !values(1, exit).head_bit(),
    into: MovesInto<M>(saves, values, file, ids, registers, moves), clear: values(1, exit).head_bit() = False):
    site.Claims(stack.writes, Kernel::none<M, True>(), 0, 1, prog_len(pass),
        λ (r: Running<M, True>) => stack.LoopPassed(saves, keep, s0, file, values)(r.state.gprs, r.state.memory) ∧ True,
        site.Arrived(h_at, λ (t: Running<M, True>) => stack.LoopAt(saves, keep, s0, registers, words_of(values, ids))(t.state.gprs, t.state.memory) ∧ True)) {
    let program = site.program;
    let back = plain_back(pass, test, moves, names, short);
    let short_h = shorts(short, names + 1);
    let back_in = back.within_before(0, jmp_item(short_h, names + 1), program, again_in);
    let jump_lands = j(h_lands, λ target _ => JmpLands(asm_labels(program), prog_len(back), short_h, names + 1, target),
        jmp_item_lands(asm_labels(program), again_in.witness, program, back, 0, short_h, names + 1, program.laid_out_lands(laid), again_in.proof));
    let post = stack.LoopAt(saves, keep, s0, registers, words_of(values, ids));
    let none = Kernel::none<M, True>();
    site.claims_after_moves(stack.writes, none, 0, 1, prog_len(pass), prog_len(back),
        λ (s: MachineState<M>) => stack.LoopPassed(saves, keep, s0, file, values)(s.gprs, s.memory),
        λ (s: MachineState<M>) => post(s.gprs, s.memory), λ (_: True) => True,
        site.Arrived(h_at, λ (t: Running<M, True>) => post(t.state.gprs, t.state.memory) ∧ True),
        loop_turns<M>(saves, site, laid, stack, keep, s0, pass, file, test, exit, moves, ids, registers, plain_jumped(pass, test, moves, names, short),
            names + 2, shorts(short, names + 2), Exists(2, refl), back_in, c_lands, values, selects, into, clear),
        site.claims_weaken(stack.writes, none, 0, 1, prog_len(back),
            λ (r: Running<M, True>) => post(r.state.gprs, r.state.memory),
            site.Arrived(h_at, λ (t: Running<M, True>) => post(t.state.gprs, t.state.memory)),
            λ (r: Running<M, True>) => post(r.state.gprs, r.state.memory) ∧ True,
            site.Arrived(h_at, λ (t: Running<M, True>) => post(t.state.gprs, t.state.memory) ∧ True),
            site.claims_jump_item(stack.writes, none, program.laid_out_fits(laid), again_in.witness, back, 0, short_h, names + 1, again_in.proof, h_at,
                jump_lands, λ (g: Gprs) (m: M) (_: True) => post(g, m)),
            λ r held => held.left, λ t arrived => ⟨arrived.left, ⟨arrived.right, trivial⟩⟩))
}

// The head's claim at a loop stopped, from the state `state` over
// `now`: at least `least` machine steps.
fn PlainStops<M>(x: Stop, saves: Nat, site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, w: Nat, s0: MachineState<M>, registers: List<Gpr>,
    h_at, least: Nat, state: List<BitVec(64)>, now: Heap) → Type {
    site.Claims(stack.writes, Kernel::none<M, True>(), 0, least, h_at,
        λ (r: Running<M, True>) => PlainAt<M>(saves, site, stack, spans, w, s0, registers, state, now)(r.state) ∧ True, x.Reached(site, stack))
}

// One pass from the head, stopped: the pass itself, or done, the turn
// round, and what follows from the head (`later`, at least `least`).
theorem plain_pass_stops<M>(x: Stop, saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), spans: Spans,
    Pass: Valuation() → Heap → Heap → Type, PassStops: Valuation() → Nat → Heap → Type, w: Nat, s0: MachineState<M>, prog: Prog, code: List<Instruction>,
    head: File, registers: List<Gpr>, parameters: List<Typed>, exit: Nat, next: List<Typed>, names: Nat, short: List<Nat>, pass: Emitted, test: Test,
    moves: List<Instruction>, labels: PlainLabels<M>(site, prog, code, pass.prog, test, moves, names, short),
    head_ok: (v: Valuation()) → (g: Gprs) → ArgsIn(words_of(v, typed_ids(parameters)), registers, g) → head.Represents(v, g),
    pass_emits: (v: Valuation()) → (from, to: Heap) →
        EmitsHeap<M>(saves, site, stack, spans, v, w, s0, plain_head(prog, code, names), head, Pass(v, from, to), from, to, pass),
    cap: Nat, pass_stops: (v: Valuation()) → (k: Nat) → k <= cap → (from: Heap) →
        StopsHeap<M>(x, saves, site, stack, spans, v, w, s0, plain_head(prog, code, names), head, PassStops(v, k, from), from, x.least(k), pass),
    pass_in: pass.prog.Within(site.program),
    selects: (v: Valuation()) → (g: Gprs) → pass.file.Represents(v, g) → test.taken(g) = !v(1, exit).head_bit(),
    into: (v: Valuation()) → MovesInto<M>(saves, v, pass.file, typed_ids(next), registers, moves),
    fuel: Nat, Later: List<BitVec(64)> → Heap → Type, least: Nat,
    later: (st: List<BitVec(64)>) → (at: Heap) → Later(st, at) →
        PlainStops<M>(x, saves, site, stack, spans, w, s0, registers, prog_len(At(prog, 0, Block(code))), least, st, at),
    enough: x.least(fuel) <= 1 + least, capped: fuel <= cap, state: List<BitVec(64)>, now: Heap, ran: PassStop(Pass, PassStops, parameters, exit, next, fuel, Later, state, now)):
    PlainStops<M>(x, saves, site, stack, spans, w, s0, registers, prog_len(At(prog, 0, Block(code))), x.least(fuel), state, now) {
    let h_at = prog_len(At(prog, 0, Block(code)));
    let none = Kernel::none<M, True>();
    let v = ran.witness;
    let eq: (words_of(v, typed_ids(parameters)) = state) = ran.proof.left;
    match ran.proof.right {
        Inl(going) => λ r here resident held => pass_stops(v, fuel, capped, now).right(pass_in)(r, here, resident,
            ⟨⟨⟨head_ok(v, r.state.gprs, j(sym(eq), λ x _ => ArgsIn(x, registers, r.state.gprs), held.left.left)), going⟩, held.left.right⟩, trivial⟩),
        Inr(done) => {
            let mid = done.witness;
            let keep_mid = λ (x: M) => stack.TrailBy(spans, heap_in<M>(site.data, spans), w, s0.memory, mid, x);
            let passed_at = λ (t: MachineState<M>) => stack.LoopPassed(saves, keep_mid, s0, pass.file, v)(t.gprs, t.memory);
            let ran_body = loop_body_runs_by<M, Heap>(saves, site, stack, spans, heap_in<M>(site.data, spans), Pass, w, s0, plain_head(prog, code, names), head,
                registers, typed_ids(parameters), head_ok, v, now, mid, pass, pass_emits(v, now, mid), pass_in, done.proof.left);
            let start = j(eq, λ x _ => site.Moves(stack.writes, h_at, prog_len(pass.prog), PlainAt<M>(saves, site, stack, spans, w, s0, registers, x, now),
                passed_at), ran_body);
            let turn = plain_turns_claim<M>(saves, site, laid, stack, keep_mid, s0, pass.prog, pass.file, test, exit, moves, typed_ids(next), registers, names,
                short, labels.again_in, labels.c_lands, h_at, labels.h_lands, v, selects(v), into(v), done.proof.right.left);
            let onward = site.claims_trans(stack.writes, none, 0, 1, 0, least, prog_len(pass.prog), h_at,
                λ (r: Running<M, True>) => passed_at(r.state) ∧ True,
                λ (t: Running<M, True>) => PlainAt<M>(saves, site, stack, spans, w, s0, registers, words_of(v, typed_ids(next)), mid)(t.state) ∧ True,
                x.Reached(site, stack), turn, later(words_of(v, typed_ids(next)), mid, done.proof.right.right));
            site.claims_loosen(stack.writes, none, 0 + 0, 1 + least, 0, x.least(fuel), h_at,
                λ (r: Running<M, True>) => PlainAt<M>(saves, site, stack, spans, w, s0, registers, state, now)(r.state) ∧ True, x.Reached(site, stack),
                enough,
                site.claims_after_moves(stack.writes, none, 0 + 0, 1 + least, h_at, prog_len(pass.prog),
                    PlainAt<M>(saves, site, stack, spans, w, s0, registers, state, now), passed_at, λ (_: True) => True, x.Reached(site, stack),
                    start, onward))
        },
    }
}

// The passes from the head, stopped at `fuel`: at least `fuel`
// machine steps, by induction on it.
theorem plain_passes_stops<M>(x: Stop, saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), spans: Spans,
    Pass: Valuation() → Heap → Heap → Type, PassStops: Valuation() → Nat → Heap → Type, w: Nat, s0: MachineState<M>, prog: Prog, code: List<Instruction>,
    head: File, registers: List<Gpr>, parameters: List<Typed>, exit: Nat, next: List<Typed>, names: Nat, short: List<Nat>, pass: Emitted, test: Test,
    moves: List<Instruction>, labels: PlainLabels<M>(site, prog, code, pass.prog, test, moves, names, short),
    head_ok: (v: Valuation()) → (g: Gprs) → ArgsIn(words_of(v, typed_ids(parameters)), registers, g) → head.Represents(v, g),
    pass_emits: (v: Valuation()) → (from, to: Heap) →
        EmitsHeap<M>(saves, site, stack, spans, v, w, s0, plain_head(prog, code, names), head, Pass(v, from, to), from, to, pass),
    cap: Nat, pass_stops: (v: Valuation()) → (k: Nat) → k <= cap → (from: Heap) →
        StopsHeap<M>(x, saves, site, stack, spans, v, w, s0, plain_head(prog, code, names), head, PassStops(v, k, from), from, x.least(k), pass),
    pass_in: pass.prog.Within(site.program),
    selects: (v: Valuation()) → (g: Gprs) → pass.file.Represents(v, g) → test.taken(g) = !v(1, exit).head_bit(),
    into: (v: Valuation()) → MovesInto<M>(saves, v, pass.file, typed_ids(next), registers, moves), fuel: Nat):
    fuel <= cap → (state: List<BitVec(64)>) → (now: Heap) → PassesStop(Pass, PassStops, parameters, exit, next, x.Zero(), fuel, state, now) →
    PlainStops<M>(x, saves, site, stack, spans, w, s0, registers, prog_len(At(prog, 0, Block(code))), x.least(fuel), state, now) {
    match fuel {
        Zero => λ capped state now ran => plain_pass_stops<M>(x, saves, site, laid, stack, spans, Pass, PassStops, w, s0, prog, code, head, registers, parameters, exit,
            next, names, short, pass, test, moves, labels, head_ok, pass_emits, cap, pass_stops, pass_in, selects, into, 0,
            LaterStop(Pass, PassStops, parameters, exit, next, x.Zero(), 0), 0,
            λ st at zero r here resident held => Exists(r.state, Exists(0, ⟨refl, ⟨trivial, x.reached_zero(site, stack, zero, Running<M, True>(r.state, r.io))⟩⟩)),
            { let low = x.least_le(0); omega }, capped, state, now, ran),
        Succ(rest) => λ capped state now ran => plain_pass_stops<M>(x, saves, site, laid, stack, spans, Pass, PassStops, w, s0, prog, code, head, registers, parameters,
            exit, next, names, short, pass, test, moves, labels, head_ok, pass_emits, cap, pass_stops, pass_in, selects, into, Succ(rest),
            LaterStop(Pass, PassStops, parameters, exit, next, x.Zero(), Succ(rest)), x.least(rest),
            plain_passes_stops<M>(x, saves, site, laid, stack, spans, Pass, PassStops, w, s0, prog, code, head, registers, parameters, exit, next, names, short,
                pass, test, moves, labels, head_ok, pass_emits, cap, pass_stops, pass_in, selects, into, rest, { omega }), x.least_succ(rest), capped, state, now, ran),
    }
}

// A plain loop stopped: the entry's moves, then the passes from the
// head, at least the loop's fuel.
theorem plain_loop_stops<M>(x: Stop, saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), spans: Spans,
    Pass: Valuation() → Heap → Heap → Type, PassStops: Valuation() → Nat → Heap → Type, values: Valuation(), w: Nat, s0: MachineState<M>, prog: Prog,
    file: File, inputs, parameters: List<Typed>, exit: Nat, next: List<Typed>, names: Nat, short: List<Nat>, registers: List<Gpr>, entry: PlainEntry,
    entered: MovesInto<M>(saves, values, file, typed_ids(inputs), registers, entry.code),
    head_ok: (v: Valuation()) → (g: Gprs) → ArgsIn(words_of(v, typed_ids(parameters)), registers, g) → entry.head.Represents(v, g),
    pass: Emitted,
    pass_emits: (v: Valuation()) → (from, to: Heap) →
        EmitsHeap<M>(saves, site, stack, spans, v, w, s0, plain_head(prog, entry.code, names), entry.head, Pass(v, from, to), from, to, pass),
    cap: Nat, pass_stops: (v: Valuation()) → (k: Nat) → k <= cap → (from: Heap) →
        StopsHeap<M>(x, saves, site, stack, spans, v, w, s0, plain_head(prog, entry.code, names), entry.head, PassStops(v, k, from), from, x.least(k), pass),
    tested: Tested(pass.file, exit), moves: List<Instruction>, into: (v: Valuation()) → MovesInto<M>(saves, v, pass.file, typed_ids(next), registers, moves),
    out: File, before: Heap, fuel: Nat, capped: fuel <= cap):
    StopsHeap<M>(x, saves, site, stack, spans, values, w, s0, prog, file,
        PassesStop(Pass, PassStops, parameters, exit, next, x.Zero(), fuel, words_of(values, typed_ids(inputs)), before), before, x.least(fuel),
        Emitted(plain_done(pass.prog, tested.test, moves, names, short), out, pass.placement, pass.names)) {
    let program = site.program;
    let code = entry.code;
    let test = tested.test;
    let none = Kernel::none<M, True>();
    let head_pass: plain_head(prog, code, names).Within(pass.prog) = (pass_emits(values, before, before)).left;
    let facts: Type = PassesStop(Pass, PassStops, parameters, exit, next, x.Zero(), fuel, words_of(values, typed_ids(inputs)), before);
    let pre = λ (g: Gprs) (m: M) => (file.Represents(values, g) ∧ facts) ∧
        (Kept(body_kept(saves), s0.gprs, g) ∧ stack.TrailBy(spans, heap_in<M>(site.data, spans), w, s0.memory, before, m));
    let into_head: prog.Within(plain_head(prog, code, names)) = Exists(2, refl);
    let pass_done: pass.prog.Within(plain_done(pass.prog, test, moves, names, short)) = Exists(8, refl);
    ⟨Prog::within_trans(into_head, Prog::within_trans(head_pass, pass_done)),
     λ within r here resident held => {
        let labels = plain_labels<M>(site, laid, prog, code, pass.prog, test, moves, names, short, head_pass, within);
        let pass_in: pass.prog.Within(program) = Prog::within_trans(Exists(8, refl), within);
        let entered_in: At(prog, 0, Block(code)).Within(program) = Prog::within_trans(Exists(1, refl), Prog::within_trans(head_pass, pass_in));
        let entry_run = site.moves_block(stack.writes, program.laid_out_fits(laid), entered_in.witness, prog, 0, code, entered_in.proof,
            program.block_reads_at(laid, entered_in.witness, prog, 0, code, entered_in.proof), pre,
            λ (g: Gprs) (m: M) => stack.LoopAt(saves, λ (x: M) => stack.TrailBy(spans, heap_in<M>(site.data, spans), w, s0.memory, before, x), s0,
                registers, words_of(values, typed_ids(inputs)))(g, m),
            λ x memory held_x => {
                let ran = entered(x, held_x.left.left);
                ⟨ran.left, ⟨kept_trans(body_kept(saves), s0.gprs, x.gprs, execute_block_normal(code, x).gprs, held_x.right.left, ran.right),
                    held_x.right.right⟩⟩
            });
        let passes = plain_passes_stops<M>(x, saves, site, laid, stack, spans, Pass, PassStops, w, s0, prog, code, entry.head, registers, parameters, exit, next,
            names, short, pass, test, moves, labels, head_ok, pass_emits, cap, pass_stops, pass_in, tested.selects, into, fuel, capped,
            words_of(values, typed_ids(inputs)), before, held.left.left.right);
        site.claims_after_moves(stack.writes, none, 0, x.least(fuel), prog_len(prog), prog_len(At(prog, 0, Block(code))),
            λ (x: MachineState<M>) => pre(x.gprs, x.memory),
            PlainAt<M>(saves, site, stack, spans, w, s0, registers, words_of(values, typed_ids(inputs)), before), λ (_: True) => True,
            x.Reached(site, stack), entry_run, passes)(r, here, resident, held)
     }⟩
}

// A loop stopped, as `Emitted::plain_close` checks it.
theorem plain_close_stops<M>(x: Stop, saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), spans: Spans,
    Pass: Valuation() → Heap → Heap → Type, PassStops: Valuation() → Nat → Heap → Type, values: Valuation(), w: Nat, s0: MachineState<M>, prog: Prog, file: File, inputs, parameters: List<Typed>,
    exit: Nat, next, outputs: List<Typed>, names: Nat, short: List<Nat>, registers: List<Gpr>, entry: PlainEntry,
    entry_ok: MovesInto<M>(saves, values, file, typed_ids(inputs), registers, entry.code) ∧
        ((v: Valuation()) → (g: Gprs) → ArgsIn(words_of(v, typed_ids(parameters)), registers, g) → entry.head.Represents(v, g)),
    pass: Emitted,
    pass_emits: (v: Valuation()) → (from, to: Heap) →
        EmitsHeap<M>(saves, site, stack, spans, v, w, s0, plain_head(prog, entry.code, names), entry.head, Pass(v, from, to), from, to, pass),
    cap: Nat, pass_stops: (v: Valuation()) → (k: Nat) → k <= cap → (from: Heap) →
        StopsHeap<M>(x, saves, site, stack, spans, v, w, s0, plain_head(prog, entry.code, names), entry.head, PassStops(v, k, from), from, x.least(k), pass),
    before: Heap, fuel: Nat, capped: fuel <= cap):
    MayStopHeap<M>(x, saves, site, stack, spans, values, w, s0, prog, file,
        PassesStop(Pass, PassStops, parameters, exit, next, x.Zero(), fuel, words_of(values, typed_ids(inputs)), before), before, x.least(fuel),
        pass.plain_close(saves, registers, exit, typed_ids(next), typed_ids(outputs), names, short)) {
    let facts: Type = PassesStop(Pass, PassStops, parameters, exit, next, x.Zero(), fuel, words_of(values, typed_ids(inputs)), before);
    let nexts = word_ports(typed_ids(next));
    let outs = word_ports(typed_ids(outputs));
    match pass.file.branch_test(exit) as λ t => MayStopHeap<M>(x, saves, site, stack, spans, values, w, s0, prog, file, facts, before, x.least(fuel), match t {
            None => None,
            Some(tested) => match pass.file.move_outputs(nexts, registers) {
                None => None,
                Some(moves) => match moves.file.outputs_check(nexts, registers) && leaves_all(moves.code, body_kept(saves)) {
                    False => None,
                    True => match input_file(outs, registers) {
                        None => None,
                        Some(out) => Some(Emitted(plain_done(pass.prog, tested.test, moves.code, names, short), out, pass.placement, pass.names)),
                    },
                },
            },
        }) {
        None => trivial,
        Some(tested) => (match pass.file.move_outputs(nexts, registers) as λ o => ((v: Valuation()) → MayKeep<M>(v, pass.file, True, o)) →
            MayStopHeap<M>(x, saves, site, stack, spans, values, w, s0, prog, file, facts, before, x.least(fuel), match o {
                None => None,
                Some(moves) => match moves.file.outputs_check(nexts, registers) && leaves_all(moves.code, body_kept(saves)) {
                    False => None,
                    True => match input_file(outs, registers) {
                        None => None,
                        Some(out) => Some(Emitted(plain_done(pass.prog, tested.test, moves.code, names, short), out, pass.placement, pass.names)),
                    },
                },
            }) {
            None => λ _ => trivial,
            Some(moves) => λ keeps => match checked: moves.file.outputs_check(nexts, registers) && leaves_all(moves.code, body_kept(saves)) {
                False => trivial,
                True => {
                    let parts = Bool::is_true_and(moves.file.outputs_check(nexts, registers), leaves_all(moves.code, body_kept(saves)),
                        is_true_of_eq(moves.file.outputs_check(nexts, registers) && leaves_all(moves.code, body_kept(saves)), checked));
                    (match input_file(outs, registers) as λ o =>
                        ((g: Gprs) → PortsAt(values, outs, registers, g) → o.All(λ (f: File) => f.Represents(values, g))) →
                        MayStopHeap<M>(x, saves, site, stack, spans, values, w, s0, prog, file, facts, before, x.least(fuel), match o {
                            None => None,
                            Some(out) => Some(Emitted(plain_done(pass.prog, tested.test, moves.code, names, short), out, pass.placement, pass.names)),
                        }) {
                        None => λ _ => trivial,
                        Some(out) => λ out_ok => plain_loop_stops<M>(x, saves, site, laid, stack, spans, Pass, PassStops, values, w, s0, prog, file, inputs, parameters,
                            exit, next, names, short, registers, entry, entry_ok.left, entry_ok.right, pass, pass_emits, cap, pass_stops, tested, moves.code,
                            λ v => moves_into<M>(saves, v, pass.file, typed_ids(next), registers, moves, keeps(v), parts.left, parts.right), out,
                            before, fuel, capped),
                    })(λ g placed => input_file_represents(values, g, outs, registers, placed))
                },
            },
        })(λ v => move_outputs_keeps<M>(v, nexts, pass.file, registers)),
    }
}

// The loop's code stopped, as `Body::emit` checks it.
theorem loop_heap_stops<M>(x: Stop, saves, slots: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data),
    spans: Spans, blocks: Blocks, answers: RoutineAnswers(), goes: RoutineStops(), values: Valuation(), spare, w: Nat, s0: MachineState<M>, short: List<Nat>, bound: Nat,
    inputs, parameters: List<Typed>, inner: Body, exit: Nat, next, outputs: List<Typed>, prog: Prog, file: File, placement: List<Place>, names: Nat,
    before: Heap, cap: Nat, fuel: Nat, capped: fuel <= cap,
    inner_emits: (start: Prog) → (head: File) → (rest: List<Place>) → (v: Valuation()) → (from, to: Heap) →
        MayEmitHeap<M>(saves, site, stack, spans, v, w, s0, start, head, inner.Holds(spans, blocks, v, answers, spare, from, to), from, to,
            inner.emit(saves, slots, short, bound, spare, start, head, rest, names + 4)),
    inner_goes: (start: Prog) → (head: File) → (rest: List<Place>) → (v: Valuation()) → (k: Nat) → k <= cap → (from: Heap) →
        MayStopHeap<M>(x, saves, site, stack, spans, v, w, s0, start, head, inner.Stops(spans, blocks, v, answers, goes, x, spare, k, from), from, x.least(k),
            inner.emit(saves, slots, short, bound, spare, start, head, rest, names + 4))):
    MayStopHeap<M>(x, saves, site, stack, spans, values, w, s0, prog, file,
        Body::Loop(inputs, parameters, inner, exit, next, outputs).Stops(spans, blocks, values, answers, goes, x, spare, fuel, before), before, x.least(fuel),
        match state_registers(placement, typed_ids(parameters).len()) {
            None => None,
            Some(taken) => match file.plain_entry(saves, typed_ids(inputs), typed_ids(parameters), taken.registers) {
                None => None,
                Some(entry) => match inner.emit(saves, slots, short, bound, spare, plain_head(prog, entry.code, names), entry.head, taken.rest, names + 4) {
                    None => None,
                    Some(pass) => pass.plain_close(saves, taken.registers, exit, typed_ids(next), typed_ids(outputs), names, short),
                },
            },
        }) {
    let Pass = λ (v: Valuation()) (from: Heap) (to: Heap) => inner.Holds(spans, blocks, v, answers, spare, from, to);
    let PassStops = λ (v: Valuation()) (k: Nat) (from: Heap) => inner.Stops(spans, blocks, v, answers, goes, x, spare, k, from);
    let facts = Body::Loop(inputs, parameters, inner, exit, next, outputs).Stops(spans, blocks, values, answers, goes, x, spare, fuel, before);
    match state_registers(placement, typed_ids(parameters).len()) as λ o => MayStopHeap<M>(x, saves, site, stack, spans, values, w, s0, prog, file, facts,
            before, x.least(fuel), match o {
                None => None,
                Some(taken) => match file.plain_entry(saves, typed_ids(inputs), typed_ids(parameters), taken.registers) {
                    None => None,
                    Some(entry) => match inner.emit(saves, slots, short, bound, spare, plain_head(prog, entry.code, names), entry.head, taken.rest, names + 4) {
                        None => None,
                        Some(pass) => pass.plain_close(saves, taken.registers, exit, typed_ids(next), typed_ids(outputs), names, short),
                    },
                },
            }) {
        None => trivial,
        Some(taken) => (match file.plain_entry(saves, typed_ids(inputs), typed_ids(parameters), taken.registers) as λ e =>
            MayPlainEntry<M>(saves, values, file, typed_ids(inputs), typed_ids(parameters), taken.registers, e) →
            MayStopHeap<M>(x, saves, site, stack, spans, values, w, s0, prog, file, facts, before, x.least(fuel), match e {
                None => None,
                Some(entry) => match inner.emit(saves, slots, short, bound, spare, plain_head(prog, entry.code, names), entry.head, taken.rest, names + 4) {
                    None => None,
                    Some(pass) => pass.plain_close(saves, taken.registers, exit, typed_ids(next), typed_ids(outputs), names, short),
                },
            }) {
            None => λ _ => trivial,
            Some(entry) => λ entry_ok => (match inner.emit(saves, slots, short, bound, spare, plain_head(prog, entry.code, names), entry.head, taken.rest,
                    names + 4) as λ e =>
                ((v: Valuation()) → (from, to: Heap) → MayEmitHeap<M>(saves, site, stack, spans, v, w, s0, plain_head(prog, entry.code, names), entry.head,
                    Pass(v, from, to), from, to, e)) →
                ((v: Valuation()) → (k: Nat) → k <= cap → (from: Heap) → MayStopHeap<M>(x, saves, site, stack, spans, v, w, s0, plain_head(prog, entry.code, names),
                    entry.head, PassStops(v, k, from), from, x.least(k), e)) →
                MayStopHeap<M>(x, saves, site, stack, spans, values, w, s0, prog, file, facts, before, x.least(fuel), match e {
                    None => None,
                    Some(pass) => pass.plain_close(saves, taken.registers, exit, typed_ids(next), typed_ids(outputs), names, short),
                }) {
                None => λ _ _ => trivial,
                Some(pass) => λ pass_emits pass_stops => plain_close_stops<M>(x, saves, site, laid, stack, spans, Pass, PassStops, values, w, s0, prog, file, inputs,
                    parameters, exit, next, outputs, names, short, taken.registers, entry, entry_ok, pass, pass_emits, cap, pass_stops, before, fuel, capped),
            })(λ v from to => inner_emits(plain_head(prog, entry.code, names), entry.head, taken.rest, v, from, to),
                λ v k le from => inner_goes(plain_head(prog, entry.code, names), entry.head, taken.rest, v, k, le, from)),
        })(plain_entry_sound<M>(saves, values, file, typed_ids(inputs), typed_ids(parameters), taken.registers)),
    }
}

// Code whose facts say it cannot be going: only its extent.
theorem stops_of_absurd<M>(x: Stop, saves: Nat, site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, values: Valuation(), d: Nat,
    s0: MachineState<M>, prog: Prog, file: File, Facts: Type, before, after: Heap, least: Nat, out: Option<Emitted>,
    emits: MayEmitHeap<M>(saves, site, stack, spans, values, d, s0, prog, file, Facts, before, after, out)):
    MayStopHeap<M>(x, saves, site, stack, spans, values, d, s0, prog, file, False, before, least, out) {
    (match out as λ o => MayEmitHeap<M>(saves, site, stack, spans, values, d, s0, prog, file, Facts, before, after, o) →
        MayStopHeap<M>(x, saves, site, stack, spans, values, d, s0, prog, file, False, before, least, o) {
        None => λ _ => trivial,
        Some(emitted) => λ em => ⟨em.left, λ within r here resident held => false_elim(held.left.left.right)⟩,
    })(emits)
}

// A sequence stopped: its first part stopped, or done and its rest stopped
// from where the first left it.
theorem may_stop_seq<M>(x: Stop, saves: Nat, site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, values: Valuation(), d: Nat,
    s0: MachineState<M>, prog: Prog, file: File, First: Type, Held, Rest: Heap → Type, before: Heap, least: Nat, done: Emitted,
    first_emits: (mid: Heap) → EmitsHeap<M>(saves, site, stack, spans, values, d, s0, prog, file, Held(mid), before, mid, done),
    first_goes: StopsHeap<M>(x, saves, site, stack, spans, values, d, s0, prog, file, First, before, least, done), out: Option<Emitted>,
    rest_goes: (mid: Heap) → MayStopHeap<M>(x, saves, site, stack, spans, values, d, s0, done.prog, done.file, Rest(mid), mid, least, out)):
    MayStopHeap<M>(x, saves, site, stack, spans, values, d, s0, prog, file, First ∨ Exists<Heap>(λ (mid: Heap) => Held(mid) ∧ Rest(mid)), before, least, out) {
    let none = Kernel::none<M, True>();
    let mem = heap_in<M>(site.data, spans);
    (match out as λ o => ((mid: Heap) → MayStopHeap<M>(x, saves, site, stack, spans, values, d, s0, done.prog, done.file, Rest(mid), mid, least, o)) →
        MayStopHeap<M>(x, saves, site, stack, spans, values, d, s0, prog, file, First ∨ Exists<Heap>(λ (mid: Heap) => Held(mid) ∧ Rest(mid)), before, least, o) {
        None => λ _ => trivial,
        Some(emitted) => λ rest => {
            let tail: done.prog.Within(emitted.prog) = rest(before).left;
            ⟨Prog::within_trans(first_goes.left, tail), λ within r here resident held =>
                match held.left.left.right as λ _ => site.Performs(stack.writes, none, x.Reached(site, stack), 0, least, r) {
                    Inl(going) => first_goes.right(Prog::within_trans(tail, within))(r, here, resident,
                        ⟨⟨⟨held.left.left.left, going⟩, held.left.right⟩, trivial⟩),
                    Inr(ex) => {
                        let mid = ex.witness;
                        site.claims_after_moves(stack.writes, none, 0, least, prog_len(prog), prog_len(done.prog),
                            λ (x: MachineState<M>) => (file.Represents(values, x.gprs) ∧ Held(mid)) ∧ stack.TrailedBy(saves, spans, mem, d, s0, before, x),
                            λ (t: MachineState<M>) => done.file.Represents(values, t.gprs) ∧ stack.TrailedBy(saves, spans, mem, d, s0, mid, t),
                            λ (_: True) => True, x.Reached(site, stack),
                            first_emits(mid).right(Prog::within_trans(tail, within)),
                            λ u u_here u_resident u_held => rest(mid).right(within)(u, u_here, u_resident,
                                ⟨⟨⟨u_held.left.left, ex.proof.right⟩, u_held.left.right⟩, trivial⟩))(r, here, resident,
                            ⟨⟨⟨held.left.left.left, ex.proof.left⟩, held.left.right⟩, trivial⟩)
                    },
                }⟩
        },
    })(rest_goes)
}

// Fewer steps claimed.
theorem may_stop_loosen<M>(x: Stop, saves: Nat, site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, values: Valuation(), d: Nat,
    s0: MachineState<M>, prog: Prog, file: File, Facts: Type, before: Heap, least, fewer: Nat, le: fewer <= least, out: Option<Emitted>,
    goes: MayStopHeap<M>(x, saves, site, stack, spans, values, d, s0, prog, file, Facts, before, least, out)):
    MayStopHeap<M>(x, saves, site, stack, spans, values, d, s0, prog, file, Facts, before, fewer, out) {
    (match out as λ o => MayStopHeap<M>(x, saves, site, stack, spans, values, d, s0, prog, file, Facts, before, least, o) →
        MayStopHeap<M>(x, saves, site, stack, spans, values, d, s0, prog, file, Facts, before, fewer, o) {
        None => λ _ => trivial,
        Some(emitted) => λ g => ⟨g.left, λ within => site.claims_loosen(stack.writes, Kernel::none<M, True>(), 0, least, 0, fewer, prog_len(prog),
            λ (r: Running<M, True>) => ((file.Represents(values, r.state.gprs) ∧ Facts) ∧
                stack.TrailedBy(saves, spans, heap_in<M>(site.data, spans), d, s0, before, r.state)) ∧ True,
            x.Reached(site, stack), le, g.right(within))⟩,
    })(goes)
}

// An exit, at the stop: exited with its status, the code reaches the
// SYSCALL with sixty in RAX and the status in RDI, counting nothing; going,
// an exit is never reached.
theorem exit_stops<M>(x: Stop, saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data),
    spans: Spans, values: Valuation(), d: Nat, s0: MachineState<M>, prog: Prog, file: File, status: Nat, placement: List<Place>, names: Nat,
    before: Heap, fuel: Nat):
    MayStopHeap<M>(x, saves, site, stack, spans, values, d, s0, prog, file, x.Exits(values(64, status)), before, x.least(fuel),
        emit_exit(prog, file, status, placement, names)) {
    match file.find(Held(status, Word)) as λ o => MayStopHeap<M>(x, saves, site, stack, spans, values, d, s0, prog, file, x.Exits(values(64, status)), before,
        x.least(fuel), match o {
            None => None,
            Some(found) => Some(Emitted(At(At(prog, 0, Block(exit_code(found.register))), 0, Syscall), file, placement, names)),
        }) {
        None => trivial,
        Some(found) => {
            let code = exit_code(found.register);
            let block = At(prog, 0, Block(code));
            let fits = site.program.laid_out_fits(laid);
            ⟨Exists(2, refl), λ within => (match x as λ y => site.Claims(stack.writes, Kernel::none<M, True>(), 0, y.least(fuel), prog_len(prog),
                    λ (r: Running<M, True>) => ((file.Represents(values, r.state.gprs) ∧ y.Exits(values(64, status))) ∧
                        stack.TrailedBy(saves, spans, heap_in<M>(site.data, spans), d, s0, before, r.state)) ∧ True, y.Reached(site, stack)) {
                StopGoing(_) => λ r here resident held => false_elim(held.left.left.right),
                StopExited(st, o) => λ r here resident held => {
                    let block_in: block.Within(site.program) = Prog::within_trans(Exists(1, refl), within);
                    let moved = site.moves_block(stack.writes, fits, block_in.witness, prog, 0, code, block_in.proof,
                        site.program.block_reads_at(laid, block_in.witness, prog, 0, code, block_in.proof),
                        λ (g: Gprs) (_: M) => file.Represents(values, g) ∧ (values(64, status) = st),
                        λ (g: Gprs) (_: M) => (read_gpr(Rax, g) = BitVec::ofNat(60)) ∧ (read_gpr(Rdi, g) = st),
                        λ s memory held_s => ⟨refl, trans(sym(found.at.rep(values, s.gprs, held_s.left)), held_s.right)⟩);
                    let got = moved(r.state, here, resident, ⟨held.left.left.left, held.left.left.right⟩);
                    let t = got.witness;
                    site.performs_steps(stack.writes, Kernel::none<M, True>(), StopExited(st, o).Reached(site, stack), r, t, got.proof.left,
                        ⟨site.item_fetched(fits, t, got.proof.right.right.left, within.witness, block, 0, Syscall, within.proof, got.proof.right.left),
                         got.proof.right.right.right⟩)
                },
            })⟩
        },
    }
}

// A region's code stopped at `x`: from its start, the stop's state with
// at least `x.least` of the fuel its run was given, at most `cap`, the
// routines it calls stopping with at least `callee_least` from their
// entries, a CALL being one step more; an exit by `exit_stops`.
theorem Body::emit_stops<M>(self body: Body, x: Stop, saves, slots: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(),
    stack: Stack<M>(site.fetch, site.data), top: Nat, spans: Spans, loan: Loan<M>(site.fetch, site.data, stack, top, spans), blocks: Blocks,
    lent: blocks.Lent(spans), rooms: Nat → Nat, bound, avail: Nat, answers: RoutineAnswers(),
    callees: CalleesReturn<M>(site, stack, spans, rooms, top, bound, answers), goes: RoutineStops(), callee_least: Nat,
    callees_stop: CalleesStop<M>(x, site, stack, spans, rooms, top, bound, goes, callee_least), cap: Nat, covered: x.least(cap) <= 1 + callee_least,
    values: Valuation(), spare: Nat, d, w: Nat, s0: MachineState<M>, framing: body.calls().IsTrue() → stack.CallFrame(top, avail, d, slots, w, s0),
    short: List<Nat>):
    body.Fits(rooms, bound, avail) → (prog: Prog) → (file: File) → (placement: List<Place>) → (names: Nat) → (fuel: Nat) → fuel <= cap →
    (before: Heap) →
    MayStopHeap<M>(x, saves, site, stack, spans, values, w, s0, prog, file, body.Stops(spans, blocks, values, answers, goes, x, spare, fuel, before), before,
        x.least(fuel), body.emit(saves, slots, short, bound, spare, prog, file, placement, names)) {
    match body {
        Leaf(instrs) => λ shallow prog file placement names fuel capped before =>
            stops_of_absurd<M>(x, saves, site, stack, spans, values, w, s0, prog, file, InstrsHold(spans, blocks, values, instrs, before, before), before, before,
                x.least(fuel), emit_instrs(saves, prog, file, instrs, placement, names),
                emit_instrs_emits<M>(saves, site, laid, stack, top, spans, loan, blocks, lent, values, w, s0, instrs, prog, file, placement, names, before,
                    before)),
        Seq(first, rest) => λ shallow prog file placement names fuel capped before => {
            let first_framing = λ (c: first.calls().IsTrue()) => framing(Bool::is_true_or_l(first.calls(), rest.calls(), c));
            (match first.emit(saves, slots, short, bound, spare, prog, file, placement, names) as λ o =>
                ((mid: Heap) → MayEmitHeap<M>(saves, site, stack, spans, values, w, s0, prog, file,
                    first.Holds(spans, blocks, values, answers, spare, before, mid), before, mid, o)) →
                MayStopHeap<M>(x, saves, site, stack, spans, values, w, s0, prog, file, first.Stops(spans, blocks, values, answers, goes, x, spare, fuel, before),
                    before, x.least(fuel), o) →
                MayStopHeap<M>(x, saves, site, stack, spans, values, w, s0, prog, file,
                    Body::Seq(first, rest).Stops(spans, blocks, values, answers, goes, x, spare, fuel, before), before, x.least(fuel),
                    match o { None => None, Some(done) => rest.emit(saves, slots, short, bound, spare, done.prog, done.file, done.placement, done.names) }) {
                None => λ _ _ => trivial,
                Some(done) => λ first_emits first_goes => may_stop_seq<M>(x, saves, site, stack, spans, values, w, s0, prog, file,
                    first.Stops(spans, blocks, values, answers, goes, x, spare, fuel, before),
                    λ (mid: Heap) => first.Holds(spans, blocks, values, answers, spare, before, mid),
                    λ (mid: Heap) => rest.Stops(spans, blocks, values, answers, goes, x, spare, fuel, mid), before, x.least(fuel), done, first_emits, first_goes,
                    rest.emit(saves, slots, short, bound, spare, done.prog, done.file, done.placement, done.names),
                    λ mid => Body::emit_stops<M>(rest, x, saves, slots, site, laid, stack, top, spans, loan, blocks, lent, rooms, bound, avail, answers, callees,
                        goes, callee_least, callees_stop, cap, covered, values, spare, d, w, s0,
                        λ c => framing(Bool::is_true_or_r(first.calls(), rest.calls(), c)), short, shallow.right, done.prog, done.file, done.placement,
                        done.names, fuel, capped, mid)),
            })(λ mid => Body::emit_emits<M>(first, saves, slots, site, laid, stack, top, spans, loan, blocks, lent, rooms, bound, avail, answers, callees,
                    values, spare, d, w, s0, first_framing, short, shallow.left, prog, file, placement, names, before, mid),
                Body::emit_stops<M>(first, x, saves, slots, site, laid, stack, top, spans, loan, blocks, lent, rooms, bound, avail, answers, callees, goes,
                    callee_least, callees_stop, cap, covered, values, spare, d, w, s0, first_framing, short, shallow.left, prog, file, placement, names, fuel,
                    capped, before))
        },
        Branch(condition, yes, no) => λ shallow prog file placement names fuel capped before =>
            (match file.branch_test(condition) as λ o => MayStopHeap<M>(x, saves, site, stack, spans, values, w, s0, prog, file,
                    Body::Branch(condition, yes, no).Stops(spans, blocks, values, answers, goes, x, spare, fuel, before), before, x.least(fuel), match o {
                        None => None,
                        Some(tested) => match yes.emit(saves, slots, short, bound, spare, prog.branched_by(tested.test, names + 1, shorts(short, names + 1)),
                            file.know(Truth(condition)), placement, names + 2) {
                            None => None,
                            Some(left) => match no.emit(saves, slots, short, bound, spare,
                                left.prog.else_label_by(names + 1, names + 2, shorts(short, names + 2)), file.know(Falsity(condition)), left.placement,
                                left.names) {
                                None => None,
                                Some(right) => Some(Emitted(right.prog.join_label(names + 2), left.file.meet(right.file, file.known), right.placement,
                                    right.names)),
                            },
                        },
                    }) {
                None => trivial,
                Some(tested) => {
                    let yes_prog = prog.branched_by(tested.test, names + 1, shorts(short, names + 1));
                    (match yes.emit(saves, slots, short, bound, spare, yes_prog, file.know(Truth(condition)), placement, names + 2) as λ o =>
                        MayStopHeap<M>(x, saves, site, stack, spans, values, w, s0, yes_prog, file.know(Truth(condition)),
                            yes.Stops(spans, blocks, values, answers, goes, x, spare, fuel, before), before, x.least(fuel), o) →
                        MayStopHeap<M>(x, saves, site, stack, spans, values, w, s0, prog, file,
                            Body::Branch(condition, yes, no).Stops(spans, blocks, values, answers, goes, x, spare, fuel, before), before, x.least(fuel), match o {
                                None => None,
                                Some(left) => match no.emit(saves, slots, short, bound, spare,
                                    left.prog.else_label_by(names + 1, names + 2, shorts(short, names + 2)), file.know(Falsity(condition)), left.placement,
                                    left.names) {
                                    None => None,
                                    Some(right) => Some(Emitted(right.prog.join_label(names + 2), left.file.meet(right.file, file.known), right.placement,
                                        right.names)),
                                },
                            }) {
                        None => λ _ => trivial,
                        Some(left) => λ yes_goes => {
                            let no_prog = left.prog.else_label_by(names + 1, names + 2, shorts(short, names + 2));
                            (match no.emit(saves, slots, short, bound, spare, no_prog, file.know(Falsity(condition)), left.placement, left.names) as λ o =>
                                MayStopHeap<M>(x, saves, site, stack, spans, values, w, s0, no_prog, file.know(Falsity(condition)),
                                    no.Stops(spans, blocks, values, answers, goes, x, spare, fuel, before), before, x.least(fuel), o) →
                                MayStopHeap<M>(x, saves, site, stack, spans, values, w, s0, prog, file,
                                    Body::Branch(condition, yes, no).Stops(spans, blocks, values, answers, goes, x, spare, fuel, before), before, x.least(fuel), match o {
                                        None => None,
                                        Some(right) => Some(Emitted(right.prog.join_label(names + 2), left.file.meet(right.file, file.known),
                                            right.placement, right.names)),
                                    }) {
                                None => λ _ => trivial,
                                Some(right) => λ no_goes => branch_heap_stops<M>(x, saves, site, laid, stack, spans, values, w, s0, prog, file, condition,
                                    yes.Stops(spans, blocks, values, answers, goes, x, spare, fuel, before),
                                    no.Stops(spans, blocks, values, answers, goes, x, spare, fuel, before), before, x.least(fuel), tested, names, short, left, right,
                                    yes_goes, no_goes, yes_goes.left, no_goes.left),
                            })(Body::emit_stops<M>(no, x, saves, slots, site, laid, stack, top, spans, loan, blocks, lent, rooms, bound, avail, answers, callees,
                                goes, callee_least, callees_stop, cap, covered, values, spare, d, w, s0,
                                λ c => framing(Bool::is_true_or_r(yes.calls(), no.calls(), c)), short, shallow.right, no_prog, file.know(Falsity(condition)),
                                left.placement, left.names, fuel, capped, before))
                        },
                    })(Body::emit_stops<M>(yes, x, saves, slots, site, laid, stack, top, spans, loan, blocks, lent, rooms, bound, avail, answers, callees, goes,
                        callee_least, callees_stop, cap, covered, values, spare, d, w, s0, λ c => framing(Bool::is_true_or_l(yes.calls(), no.calls(), c)),
                        short, shallow.left, yes_prog, file.know(Truth(condition)), placement, names + 2, fuel, capped, before))
                },
            }),
        Call(callee, arguments, results) => λ shallow prog file placement names fuel capped before => {
            let frame = framing(trivial);
            let out = file.emit_call(slots, prog, callee, typed_ids(arguments), call_result(results, spare), call_also(results), placement, names, bound, [],
                []);
            let Facts: Type = Body::Call(callee, arguments, results).Stops(spans, blocks, values, answers, goes, x, spare, fuel, before);
            may_stop_loosen<M>(x, saves, site, stack, spans, values, w, s0, prog, file, Facts, before, 1 + callee_least, x.least(fuel), { let mono = x.least_mono(fuel, cap, capped); omega }, out,
                j(frame.right.right.right.left, λ y _ => MayStopHeap<M>(x, saves, site, stack, spans, values, y, s0, prog, file, Facts, before, 1 + callee_least,
                        out),
                    call_heap_stops<M>(x, saves, slots, site, laid, stack, top, spans, loan, rooms, bound, avail, goes, callee_least, callees_stop, blocks, values,
                        spare, d, s0, frame.left, frame.right.left, frame.right.right.left, frame.right.right.right.right.left,
                        frame.right.right.right.right.right, prog, file, callee, arguments, results, shallow, placement, names, before)))
        },
        Loop(inputs, parameters, inner, exit, next, outputs) => λ shallow prog file placement names fuel capped before =>
            loop_heap_stops<M>(x, saves, slots, site, laid, stack, spans, blocks, answers, goes, values, spare, w, s0, short, bound, inputs, parameters, inner,
                exit, next, outputs, prog, file, placement, names, before, cap, fuel, capped,
                λ start head rest v from to => Body::emit_emits<M>(inner, saves, slots, site, laid, stack, top, spans, loan, blocks, lent, rooms, bound, avail,
                    answers, callees, v, spare, d, w, s0, framing, short, shallow, start, head, rest, names + 4, from, to),
                λ start head rest v k le from => Body::emit_stops<M>(inner, x, saves, slots, site, laid, stack, top, spans, loan, blocks, lent, rooms, bound,
                    avail, answers, callees, goes, callee_least, callees_stop, cap, covered, v, spare, d, w, s0, framing, short, shallow, start, head, rest,
                    names + 4, k, le, from)),
        Sys(_) => λ shallow prog file placement names fuel capped before => trivial,
        Exit(status) => λ shallow prog file placement names fuel capped before =>
            exit_stops<M>(x, saves, site, laid, stack, spans, values, w, s0, prog, file, status, placement, names, before, fuel),
    }
}

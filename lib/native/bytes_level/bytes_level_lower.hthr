// The bytes level lowered to x86 (docs/language/ownership-design.md §17.6,
// issues/bytes-level-lowering.md): its nodes' code, each proved once over
// the frame and call theorems' memory clause at the contract's heap.
//
// - The clause (`heap_in`): the heap is injected into memory under the one
//   lending of `Site::Meets` (x86_64_memory_contract's `Injected`), its law
//   the loan's (`Loan::stable_injected`). The code of a node is proved as
//   `EmitsBy` of function_ir_lower_calls at state type `Heap` and this
//   clause, so the generic sequence, branch, call, loop and function
//   theorems there are cited at it, never restated.
// - The register invariant is FunctionIR's, unchanged (`File::Represents`,
//   `Held`), over one valuation for a routine's scope: a word id holds its
//   word, a reference id its target's address (`Value::lower`). The kind
//   does not reach the register file: a reference is held as a word, and a
//   node's facts say which word (`Locals::Agrees`, below).
// - A node's facts (`Instr::Holds`) are its meaning at that valuation over
//   the heap before and after it: a word node's FunctionIR equation, and a
//   memory node's take or put at the reference's location. Each memory node
//   lowers to one instruction through the register holding the reference's
//   address, proved from the contract's lemma for its operation at its width
//   (`Injected::byte_read`, `dword_read`, `word_read`, `ref_read`;
//   `Loan::store_injected`, `store_ref_injected`) and the node's site fact,
//   which is its meaning being defined.
import bytes_memory;
import bytes_level;
import x86_64_memory_contract;
import x86_64_call_contract;
import function_ir;
import function_ir_eval;
import function_ir_state;
import function_ir_lower;
import function_ir_lower_structured;
import function_ir_lower_reads;
import function_ir_lower_calls;
import linux_world;
import linux_calls;
import linux_x86_64_io;
import x86_64;
import x86_64_block;
import x86_64_fetch;
import x86_64_data_read;
import x86_64_fetched_code;
import x86_64_layout;
import x86_64_store;
import x86_64_stack;
import x86_64_kept;
import x86_64_asm;
import x86_64_asm_runs;
import x86_64_stack_runs;
import bitvec;
import bitvec_signed;
import bool;
import list;
import logic;
import nat;
import option;
import omega;

// ---------------------------------------------------------------------------
// Words of bytes, as the machine reads them

// A byte past a list's end reads zero.
theorem byte_at_past(bytes: List<BitVec(8)>): (k: Nat) → bytes.len() <= k → byte_at(bytes, k) = BitVec::zero() {
    match bytes {
        Nil => λ k _ => refl,
        Cons(_, rest) => λ k past => match k {
            Zero => false_elim(omega(past)),
            Succ(j) => byte_at_past(rest, j, omega(past)),
        },
    }
}

// One byte, zero-extended: `MOVZX`.
theorem word_of_one(bytes: List<BitVec(8)>, len: bytes.len() = 1): word_of_bytes(bytes) = byte_at(bytes, 0).zero_extend(56) {
    let z = λ (k: Nat) (low: 1 <= k) => byte_at_past(bytes, k, omega(len, low));
    rewrite(z(1, trivial), z(2, trivial), z(3, trivial), z(4, trivial), z(5, trivial), z(6, trivial), z(7, trivial), refl)
}

// Four bytes or fewer, their doubleword zero-extended.
theorem word_of_few(bytes: List<BitVec(8)>, few: bytes.len() <= 4):
    word_of_bytes(bytes) = imm32_from_bytes(byte_at(bytes, 0), byte_at(bytes, 1), byte_at(bytes, 2), byte_at(bytes, 3)).zero_extend(32) {
    let z = λ (k: Nat) (low: 4 <= k) => byte_at_past(bytes, k, omega(few, low));
    rewrite(z(4, trivial), z(5, trivial), z(6, trivial), z(7, trivial), refl)
}

// Four bytes: `MOV r32`.
theorem word_of_four(bytes: List<BitVec(8)>, len: bytes.len() = 4):
    word_of_bytes(bytes) = imm32_from_bytes(byte_at(bytes, 0), byte_at(bytes, 1), byte_at(bytes, 2), byte_at(bytes, 3)).zero_extend(32) {
    word_of_few(bytes, omega(len))
}

// Read from four bytes or fewer, a word is its 32-bit view widened.
theorem word_of_bytes_round(bytes: List<BitVec(8)>, few: bytes.len() <= 4): word_of_bytes(bytes).resize(32).resize(64) = word_of_bytes(bytes) {
    let low = imm32_from_bytes(byte_at(bytes, 0), byte_at(bytes, 1), byte_at(bytes, 2), byte_at(bytes, 3));
    let wide: (word_of_bytes(bytes) = low.resize(64)) = trans(word_of_few(bytes, few), sym(BitVec::resize_zero_extend(32, 32, low)));
    j(sym(wide), λ y _ => y.resize(32).resize(64) = y, cong_fn<BitVec(32), BitVec(64)>(λ y => y.resize(64), BitVec::resize_round_trip(32, 64, omega(), low)))
}

// ---------------------------------------------------------------------------
// The memory clause

// The heap is injected into memory over the lending's spans.
fn heap_in<M>(data: ByteReadAccess<M>, spans: Spans) → Heap → M → Type {
    λ (heap: Heap) (memory: M) => Injected<M>(data, spans, heap, memory)
}

// Its law, from the loan.
theorem heap_in_stable<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, stack: Stack<M>(fetch, data), top: Nat, spans: Spans,
    loan: Loan<M>(fetch, data, stack, top, spans)): stack.ClauseStable(top, heap_in<M>(data, spans)) {
    λ heap => loan.stable_injected(top, top.le_refl(), heap)
}

// What a node's code proves: `EmitsBy` at the heap and its injection.
fn EmitsHeap<M>(saves: Nat, site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, values: Valuation(), d: Nat,
    s0: MachineState<M>, prog: Prog, file: File, facts: Type, before, after: Heap, out: Emitted) → Type {
    EmitsBy<M, Heap>(saves, site, stack, spans, heap_in<M>(site.data, spans), values, d, s0, prog, file, facts, before, after, out)
}

// ---------------------------------------------------------------------------
// The world beside the heap (docs/language/ownership-design.md §17.7)
//
// A region's code is proved at the state `Now`, the heap and the world: the
// heap injected into memory as before (`now_in`), and the machine's world
// the state's (`NowWorld`). The claim is at Linux (`Site::linux_kernel`),
// counting the system calls the region makes as the exchanges its world
// gained (`calls_between`): each records one (`Site::linux_performs_exact`).

record Now { heap: Heap, io: Io }

fn now_in<M>(data: ByteReadAccess<M>, spans: Spans) → Now → M → Type { λ (now: Now) (memory: M) => Injected<M>(data, spans, now.heap, memory) }

theorem now_in_stable<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, stack: Stack<M>(fetch, data), top: Nat, spans: Spans,
    loan: Loan<M>(fetch, data, stack, top, spans)): stack.ClauseStable(top, now_in<M>(data, spans)) {
    λ now => loan.stable_injected(top, top.le_refl(), now.heap)
}

fn NowWorld() → Now → Io → Type { λ (now: Now) (w: Io) => (w = now.io) ∧ w.Answerable() }

fn calls_between(before, after: Now) → Nat { after.io.past.len() - before.io.past.len() }

theorem calls_between_is(before, after: Now): calls_between(before, after) = after.io.past.len() - before.io.past.len() { refl }

// Histories in order: `mid` between `before` and `after`, by length.
fn Between(before, mid, after: Now) → Type {
    (before.io.past.len() <= mid.io.past.len()) ∧ (mid.io.past.len() <= after.io.past.len())
}

// What a region's code proves: `EmitsClaim` at the heap and the world, at
// Linux, as many system calls as the world gained, no bound on steps.
fn EmitsLinux<M>(saves: Nat, site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, values: Valuation(), d: Nat, s0: MachineState<M>,
    prog: Prog, file: File, facts: Type, before, after: Now, out: Emitted) → Type {
    EmitsClaim<M, Now, Io>(saves, site, stack, spans, now_in<M>(site.data, spans), NowWorld(), site.linux_kernel(stack), calls_between(before, after), 0,
        values, d, s0, prog, file, facts, before, after, out)
}

fn MayEmitLinux<M>(saves: Nat, site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, values: Valuation(), d: Nat, s0: MachineState<M>,
    prog: Prog, file: File, facts: Type, before, after: Now, out: Option<Emitted>) → Type {
    out.All(λ (emitted: Emitted) => EmitsLinux<M>(saves, site, stack, spans, values, d, s0, prog, file, facts, before, after, emitted))
}

// The pre- and postcondition of a region's claim at `Now`.
fn NowPre<M>(saves: Nat, site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, values: Valuation(), d: Nat, s0: MachineState<M>,
    file: File, facts: Type, now: Now) → Running<M, Io> → Type {
    λ (r: Running<M, Io>) => ((file.Represents(values, r.state.gprs) ∧ facts) ∧ stack.TrailedBy(saves, spans, now_in<M>(site.data, spans), d, s0, now, r.state)) ∧
        NowWorld()(now, r.io)
}

fn NowPost<M>(saves: Nat, site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, values: Valuation(), d: Nat, s0: MachineState<M>,
    to: Nat, file: File, now: Now) → Running<M, Io> → Type {
    site.Arrived(to, λ (t: Running<M, Io>) => (file.Represents(values, t.state.gprs) ∧ stack.TrailedBy(saves, spans, now_in<M>(site.data, spans), d, s0, now,
        t.state)) ∧ NowWorld()(now, t.io))
}

// A count proved under a fact that fixes it.
theorem Site::claims_recount<M, W>(self site: Site<M>, writes: ByteWrites<M>, kernel: Kernel<M, W>, calls, calls2, least, from: Nat,
    pre, goal: Running<M, W> → Type, same: (r: Running<M, W>) → pre(r) → calls = calls2, claims: site.Claims(writes, kernel, calls, least, from, pre, goal)):
    site.Claims(writes, kernel, calls2, least, from, pre, goal) {
    λ r here resident held => j(same(r, held), λ k _ => site.Performs(writes, kernel, goal, k, least, r), claims(r, here, resident, held))
}

// Any count, read off the worlds: a claim at Linux from `before`'s world to
// `after`'s makes `calls_between(before, after)` system calls.
theorem Site::claims_exact<M>(self site: Site<M>, stack: Stack<M>(site.fetch, site.data), calls, least, from: Nat, pre, goal: Running<M, Io> → Type,
    before, after: Now, starts: (r: Running<M, Io>) → pre(r) → r.io = before.io, pins: (t: Running<M, Io>) → goal(t) → t.io = after.io,
    claims: site.Claims(stack.writes, site.linux_kernel(stack), calls, least, from, pre, goal)):
    site.Claims(stack.writes, site.linux_kernel(stack), calls_between(before, after), least, from, pre, goal) {
    λ r here resident held => {
        let p = claims(r, here, resident, held);
        let grown = site.linux_performs_grows(stack, goal, after.io, pins, calls, least, r, p);
        let lens: (r.io.past.len() = before.io.past.len()) = cong_fn<Io, Nat>(λ w => w.past.len(), starts(r, held));
        let count = calls_between_is(before, after);
        site.linux_performs_exact(stack, goal, after.io, pins, calls, least, r, calls_between(before, after), { omega }, p)
    }
}

theorem emits_linux_exact<M>(saves: Nat, site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, values: Valuation(), d: Nat,
    s0: MachineState<M>, prog: Prog, file: File, facts: Type, before, after: Now, out: Emitted, calls: Nat,
    emits: EmitsClaim<M, Now, Io>(saves, site, stack, spans, now_in<M>(site.data, spans), NowWorld(), site.linux_kernel(stack), calls, 0, values, d, s0,
        prog, file, facts, before, after, out)):
    EmitsLinux<M>(saves, site, stack, spans, values, d, s0, prog, file, facts, before, after, out) {
    ⟨emits.left, λ within => site.claims_exact(stack, calls, 0, prog_len(prog),
        NowPre<M>(saves, site, stack, spans, values, d, s0, file, facts, before),
        NowPost<M>(saves, site, stack, spans, values, d, s0, prog_len(out.prog), out.file, after), before, after,
        λ r held => held.right.left, λ t arrived => arrived.right.right.left, emits.right(within))⟩
}

// A node's code, proved at the heap, at `Now`: no system call, the world
// kept.
theorem emits_linux_of_heap<M>(saves: Nat, site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, values: Valuation(), d: Nat,
    s0: MachineState<M>, prog: Prog, file: File, facts: Type, before, after: Now, out: Emitted,
    emits: EmitsHeap<M>(saves, site, stack, spans, values, d, s0, prog, file, facts, before.heap, after.heap, out)):
    EmitsLinux<M>(saves, site, stack, spans, values, d, s0, prog, file, facts ∧ (after.io = before.io), before, after, out) {
    ⟨emits.left, λ within r here resident held => {
        let same: (after.io = before.io) = held.left.left.right.right;
        let zero: (calls_between(before, after) = 0) = {
            let lens = cong_fn<Io, Nat>(λ w => w.past.len(), same);
            let count = calls_between_is(before, after);
            omega
        };
        let m = emits.right(within)(r.state, here, resident, ⟨⟨held.left.left.left, held.left.left.right.left⟩, held.left.right⟩);
        j(sym(zero), λ k _ => site.Performs(stack.writes, site.linux_kernel(stack),
                NowPost<M>(saves, site, stack, spans, values, d, s0, prog_len(out.prog), out.file, after), k, 0, r),
            site.performs_steps(stack.writes, site.linux_kernel(stack), NowPost<M>(saves, site, stack, spans, values, d, s0, prog_len(out.prog), out.file, after),
                r, m.witness, m.proof.left, ⟨⟨m.proof.right.left, m.proof.right.right.left⟩, ⟨m.proof.right.right.right, ⟨trans(held.right.left, sym(same)), held.right.right⟩⟩⟩))
    }⟩
}

// ---------------------------------------------------------------------------
// The ceiling (docs/language/ownership-design.md §17.10, step 3)
//
// A routine's regions are proved at the escaping kernel: Linux, with the
// out-of-room stop carried as a kernel step owing nothing after it
// (`Kernel::escaping`), so FunctionIR's composition lemmas compose them as
// they are. An escape spends a call, so a region's count cannot be the
// exchanges its world gained; every region of one routine's proof is
// counted instead to one ceiling, the world `top` no state of the run gets
// past (the outcome's), and one more for the escape: `|top| + 1`. Each part
// of a sequence, each arm and each pass is counted so, the sum read back to
// it by `Site::claims_ceiling` (the escaping kernel's `escaping_ceiling`).
// A region's facts carry that its world after is a prefix of `top`
// (`Ceiling::Under`), and the escape that the stop's world is
// (`Ceiling::Esc`).

record Ceiling<M> { esc: Running<M, Io> → Type, top: Io }

fn Ceiling::Esc<M>(self c: Ceiling<M>) → Running<M, Io> → Type { λ (t: Running<M, Io>) => c.esc(t) ∧ Extends(c.top.past, t.io.past) }

fn Ceiling::count<M>(self c: Ceiling<M>) → Nat { c.top.past.len() + 1 }

fn Ceiling::Under<M>(self c: Ceiling<M>, now: Now) → Type { Extends(c.top.past, now.io.past) }

fn Site::ceiling<M>(self site: Site<M>, stack: Stack<M>(site.fetch, site.data), c: Ceiling<M>) → Kernel<M, Io> { site.linux_escaping(stack, c.Esc()) }

theorem Ceiling::under_len<M>(self c: Ceiling<M>, now: Now, w: Io, same: w = now.io, under: c.Under(now)): w.past.len() <= c.top.past.len() {
    j(sym(same), λ x _ => x.past.len() <= c.top.past.len(), extends_len(c.top.past, now.io.past, under))
}

// Under a later world, under an earlier one.
theorem Ceiling::under_extends<M>(self c: Ceiling<M>, later, earlier: Now, under: c.Under(later), grown: Extends(later.io.past, earlier.io.past)):
    c.Under(earlier) {
    extends_trans(c.top.past, later.io.past, earlier.io.past, under, grown)
}

// Linux resumes wherever it does, at the escaping kernel.
theorem Site::linux_in_ceiling<M>(self site: Site<M>, stack: Stack<M>(site.fetch, site.data), c: Ceiling<M>):
    (r: Running<M, Io>) → (P: Running<M, Io> → Type) → site.linux_kernel(stack).resumes(r, P) → site.ceiling(stack, c).resumes(r, P) {
    λ r P called => Inl(called)
}

// Any count, read back to the ceiling where every goal state is under it.
theorem Site::claims_ceiling<M>(self site: Site<M>, stack: Stack<M>(site.fetch, site.data), c: Ceiling<M>, calls, least, from: Nat,
    pre, goal: Running<M, Io> → Type, bounded: (r: Running<M, Io>) → pre(r) → (t: Running<M, Io>) → goal(t) → t.io.past.len() <= c.top.past.len(),
    claims: site.Claims(stack.writes, site.ceiling(stack, c), calls, least, from, pre, goal)):
    site.Claims(stack.writes, site.ceiling(stack, c), c.count(), least, from, pre, goal) {
    λ r here resident held => site.escaping_ceiling(stack, goal, c.Esc(), c.top,
        λ t reached => match reached {
            Inl(g) => bounded(r, held, t, g),
            Inr(e) => extends_len(c.top.past, t.io.past, e.right),
        }, calls, least, r, c.count(), { let k: (c.count() = c.top.past.len() + 1) = refl; omega }, claims(r, here, resident, held))
}

// A claim whose goal is never reached claims any bound: every branch ends
// where its kernel takes it.
theorem Site::performs_never<M, W>(self site: Site<M>, writes: ByteWrites<M>, kernel: Kernel<M, W>, goal: Running<M, W> → Type,
    never: (t: Running<M, W>) → goal(t) → False, calls: Nat): (least, more: Nat) → (from: Running<M, W>) →
    site.Performs(writes, kernel, goal, calls, least, from) → site.Performs(writes, kernel, goal, calls, more, from) {
    match calls {
        Zero => λ least more from p => false_elim(never(Running(p.witness, from.io),
            reach_goal<M, W>(goal, least, p.proof.witness, Running(p.witness, from.io), p.proof.proof.right).right)),
        Succ(k) => λ least more from p => match p.proof.proof.right {
            Inl(reach) => false_elim(never(Running(p.witness, from.io), reach_goal<M, W>(goal, least, p.proof.witness, Running(p.witness, from.io), reach).right)),
            Inr(called) => Exists(p.witness, Exists(p.proof.witness, ⟨p.proof.proof.left, Inr(kernel.monotone(Running(p.witness, from.io),
                λ (u: Running<M, W>) => site.Performs(writes, kernel, goal, k, least - p.proof.witness, u),
                λ (u: Running<M, W>) => site.Performs(writes, kernel, goal, k, more - p.proof.witness, u),
                λ u q => site.performs_never(writes, kernel, goal, never, k, least - p.proof.witness, more - p.proof.witness, u, q), called))⟩)),
        },
    }
}

// What a region's code proves: `EmitsClaim` at the heap and the world, at
// the ceiling's kernel and count, no bound on steps, its world after under
// the ceiling.
fn EmitsNow<M>(saves: Nat, site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, c: Ceiling<M>, values: Valuation(), d: Nat,
    s0: MachineState<M>, prog: Prog, file: File, facts: Type, before, after: Now, out: Emitted) → Type {
    EmitsClaim<M, Now, Io>(saves, site, stack, spans, now_in<M>(site.data, spans), NowWorld(), site.ceiling(stack, c), c.count(), 0,
        values, d, s0, prog, file, facts ∧ c.Under(after), before, after, out)
}

fn MayEmitNow<M>(saves: Nat, site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, c: Ceiling<M>, values: Valuation(), d: Nat,
    s0: MachineState<M>, prog: Prog, file: File, facts: Type, before, after: Now, out: Option<Emitted>) → Type {
    out.All(λ (emitted: Emitted) => EmitsNow<M>(saves, site, stack, spans, c, values, d, s0, prog, file, facts, before, after, emitted))
}

// Any count at the ceiling's kernel, read back to the ceiling.
theorem emits_now_ceiling<M>(saves: Nat, site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, c: Ceiling<M>, values: Valuation(), d: Nat,
    s0: MachineState<M>, prog: Prog, file: File, facts: Type, before, after: Now, out: Emitted, calls: Nat,
    emits: EmitsClaim<M, Now, Io>(saves, site, stack, spans, now_in<M>(site.data, spans), NowWorld(), site.ceiling(stack, c), calls, 0, values, d, s0,
        prog, file, facts ∧ c.Under(after), before, after, out)):
    EmitsNow<M>(saves, site, stack, spans, c, values, d, s0, prog, file, facts, before, after, out) {
    ⟨emits.left, λ within => site.claims_ceiling(stack, c, calls, 0, prog_len(prog),
        NowPre<M>(saves, site, stack, spans, values, d, s0, file, facts ∧ c.Under(after), before),
        NowPost<M>(saves, site, stack, spans, values, d, s0, prog_len(out.prog), out.file, after),
        λ r held t arrived => c.under_len(after, t.io, arrived.right.right.left, held.left.left.right.right), emits.right(within))⟩
}

// A region proved at Linux, at the ceiling: the kernel widened, the count
// read back.
theorem emits_now_of_linux<M>(saves: Nat, site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, c: Ceiling<M>, values: Valuation(), d: Nat,
    s0: MachineState<M>, prog: Prog, file: File, facts: Type, before, after: Now, out: Emitted,
    emits: EmitsLinux<M>(saves, site, stack, spans, values, d, s0, prog, file, facts, before, after, out)):
    EmitsNow<M>(saves, site, stack, spans, c, values, d, s0, prog, file, facts, before, after, out) {
    let goal = NowPost<M>(saves, site, stack, spans, values, d, s0, prog_len(out.prog), out.file, after);
    emits_now_ceiling<M>(saves, site, stack, spans, c, values, d, s0, prog, file, facts, before, after, out, calls_between(before, after),
        ⟨emits.left, λ within r here resident held => site.performs_or_kernel(stack.writes, site.linux_kernel(stack), site.ceiling(stack, c), goal,
            λ (_: Running<M, Io>) => False, site.linux_in_ceiling(stack, c), calls_between(before, after), 0, r,
            emits.right(within)(r, here, resident, ⟨⟨⟨held.left.left.left, held.left.left.right.left⟩, held.left.right⟩, held.right⟩))⟩)
}

theorem may_emit_now_of_linux<M>(saves: Nat, site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, c: Ceiling<M>, values: Valuation(),
    d: Nat, s0: MachineState<M>, prog: Prog, file: File, facts: Type, before, after: Now, out: Option<Emitted>):
    MayEmitLinux<M>(saves, site, stack, spans, values, d, s0, prog, file, facts, before, after, out) →
    MayEmitNow<M>(saves, site, stack, spans, c, values, d, s0, prog, file, facts, before, after, out) {
    match out {
        None => λ _ => trivial,
        Some(e) => λ emits => emits_now_of_linux<M>(saves, site, stack, spans, c, values, d, s0, prog, file, facts, before, after, e, emits),
    }
}

// ---------------------------------------------------------------------------
// Loads

// The kind a word is held at for an access's view (`view_ok`): `Word` at
// 64, `Narrow(view)` at any other width.
fn view_kind(view: Nat) → Kind { match view.same(64) { True => Word, False => Narrow(view) } }

// A register holding a word at its view's kind holds the view's word.
theorem view_word_held(values: Valuation(), view, id: Nat, word: BitVec(64)):
    Held(id, view_kind(view)).Rep(values, word) → view_word(values, view, id) = word {
    match view.same(64) as λ b => Held(id, match b { True => Word, False => Narrow(view) }).Rep(values, word) →
        (match b { True => values(64, id), False => values(view, id).resize(64) }) = word {
        True => λ r => r,
        False => λ r => r,
    }
}

// A load's meaning at the valuation: `place` holds a reference's address,
// the `n` plain, defined bytes there are read, and `output` is held at its
// view's kind as their word.
fn Loads(spans: Spans, values: Valuation(), heap: Heap, n, view, output, place: Nat) → Type {
    Exists<Loc>(λ loc => (values(64, place) = loc.address(spans)) ∧
        Exists<List<BitVec(8)>>(λ bytes => (heap.read_bytes(loc, n) = Some(bytes)) ∧ Held(output, view_kind(view)).Rep(values, word_of_bytes(bytes))))
}

// A word written into a register the body may write, memory untouched: the
// file names it, and the trail is kept.
theorem written_leaves<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, saves: Nat, stack: Stack<M>(fetch, data), spans: Spans,
    Mem: Heap → M → Type, values: Valuation(), d: Nat, s0: MachineState<M>, now: Heap, file: File, destination: Gpr, output: Nat, kind: Kind,
    x: BitVec(64), apart: destination.apart(body_kept(saves)).IsTrue(), s: MachineState<M>, flags: Flags, rip: BitVec(64),
    rep: file.Represents(values, s.gprs), trailed: stack.TrailedBy(saves, spans, Mem, d, s0, now, s), named: Held(output, kind).Rep(values, x)):
    file.write(destination, Some(Held(output, kind))).Represents(values, write_gpr(destination, x, s.gprs)) ∧
        stack.TrailedBy(saves, spans, Mem, d, s0, now, MachineState(write_gpr(destination, x, s.gprs), flags, rip, s.memory)) {
    ⟨file.represents_write(values, s.gprs, destination, Some(Held(output, kind)), x, rep, named),
     ⟨kept_trans(body_kept(saves), s0.gprs, s.gprs, write_gpr(destination, x, s.gprs), trailed.left,
        kept_write(body_kept(saves), destination, x, s.gprs, apart)), trailed.right⟩⟩
}

// Where a load's facts hold, the base register holds the address of a
// location whose bytes are in their span: the register, the location and
// the contract's injection, read off the state the code starts in.
theorem Loads::at<M>(spans: Spans, values: Valuation(), heap: Heap, place: Nat, file: File, base: Gpr, found: FoundAt(file, Held(place, Word), base),
    gprs: Gprs, rep: file.Represents(values, gprs), loc: Loc, addressed: values(64, place) = loc.address(spans)): read_gpr(base, gprs) = loc.address(spans) {
    trans(sym(found.rep(values, gprs, rep)), addressed)
}

// `n` bytes inside a span lie below the canonical boundary.
theorem Loan::below<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, {stack: Stack<M>(fetch, data)}, {top: Nat}, {spans: Spans},
    self loan: Loan<M>(fetch, data, stack, top, spans), loc: Loc, n: Nat, fits: loc.offset + n <= spans.size(loc.block)):
    loc.address(spans).toNat() + n <= Nat::pow(2, 47) {
    loan.canonical_at(loc.block, loc.offset, n, fits)
}

// The pre- and postcondition every node's code is proved between.
fn HeapPre<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, saves: Nat, stack: Stack<M>(fetch, data), spans: Spans, values: Valuation(),
    d: Nat, s0: MachineState<M>, file: File, facts: Type, now: Heap) → MachineState<M> → Type {
    λ (s: MachineState<M>) => (file.Represents(values, s.gprs) ∧ facts) ∧ stack.TrailedBy(saves, spans, heap_in<M>(data, spans), d, s0, now, s)
}

// A byte loaded: `MOVZX destination, byte [base]`.
theorem load_byte_emits<M>(saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), top: Nat,
    spans: Spans, loan: Loan<M>(site.fetch, site.data, stack, top, spans), values: Valuation(), d: Nat, s0: MachineState<M>, prog: Prog,
    file: File, view, output, place: Nat, base, destination: Gpr, found: FoundAt(file, Held(place, Word), base),
    apart: destination.apart(body_kept(saves)).IsTrue(), placement: List<Place>, names: Nat, heap: Heap):
    EmitsHeap<M>(saves, site, stack, spans, values, d, s0, prog, file, Loads(spans, values, heap, 1, view, output, place), heap, heap,
        Emitted(At(prog, 0, LoadByte(ByteLoad(destination, base))), file.write(destination, Some(Held(output, view_kind(view)))), placement, names)) {
    let load = ByteLoad(destination, base);
    let out_file = file.write(destination, Some(Held(output, view_kind(view))));
    let facts = Loads(spans, values, heap, 1, view, output, place);
    ⟨prog.within_then(0, LoadByte(load)),
     λ within => site.moves_load_byte(stack.writes, site.program.laid_out_fits(laid), within.witness, prog, 0, load, within.proof,
        HeapPre<M>(saves, stack, spans, values, d, s0, file, facts, heap),
        λ (t: MachineState<M>) => out_file.Represents(values, t.gprs) ∧ stack.TrailedBy(saves, spans, heap_in<M>(site.data, spans), d, s0, heap, t),
        λ s held => {
            let loads = held.left.right;
            let loc = loads.witness;
            let bytes = loads.proof.right.witness;
            let read = loads.proof.right.proof.left;
            let inj: Injected<M>(site.data, spans, heap, s.memory) = held.right.right.right;
            let got = inj.byte_read(loc, bytes, read);
            let at = Loads::at<M>(spans, values, heap, place, file, base, found, s.gprs, held.left.left, loc, loads.proof.left);
            let low = loan.below(loc, 1, got.left);
            let byte = byte_at(bytes, 0);
            Exists(byte, ⟨j(sym(at), λ x _ => x.toNat() < Nat::pow(2, 47), omega(low)),
                ⟨j(sym(at), λ x _ => site.data.read(s.memory, x) = Some(byte), got.right),
                 written_leaves<M>(saves, stack, spans, heap_in<M>(site.data, spans), values, d, s0, heap, file, destination, output, view_kind(view), byte.zero_extend(56),
                    apart, s, s.flags, next_rip(s.rip, byte_load_bytes(load).len()), held.left.left, held.right,
                    j(word_of_one(bytes, heap.read_bytes_len(loc, 1, bytes, read)), λ x _ => Held(output, view_kind(view)).Rep(values, x),
                        loads.proof.right.proof.right))⟩⟩)
        })⟩
}

// Four bytes loaded: `MOV destination32, dword [base]`.
theorem load_dword_emits<M>(saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), top: Nat,
    spans: Spans, loan: Loan<M>(site.fetch, site.data, stack, top, spans), values: Valuation(), d: Nat, s0: MachineState<M>, prog: Prog,
    file: File, view, output, place: Nat, base, destination: Gpr, found: FoundAt(file, Held(place, Word), base),
    apart: destination.apart(body_kept(saves)).IsTrue(), placement: List<Place>, names: Nat, heap: Heap):
    EmitsHeap<M>(saves, site, stack, spans, values, d, s0, prog, file, Loads(spans, values, heap, 4, view, output, place), heap, heap,
        Emitted(At(prog, 0, asm_dword_load(DwordLoad(destination, base))), file.write(destination, Some(Held(output, view_kind(view)))), placement, names)) {
    let load = DwordLoad(destination, base);
    let out_file = file.write(destination, Some(Held(output, view_kind(view))));
    let facts = Loads(spans, values, heap, 4, view, output, place);
    ⟨prog.within_then(0, asm_dword_load(load)),
     λ within => site.moves_dword_load(stack.writes, site.program.laid_out_fits(laid), within.witness, prog, 0, load, within.proof,
        HeapPre<M>(saves, stack, spans, values, d, s0, file, facts, heap),
        λ (t: MachineState<M>) => out_file.Represents(values, t.gprs) ∧ stack.TrailedBy(saves, spans, heap_in<M>(site.data, spans), d, s0, heap, t),
        λ s held => {
            let loads = held.left.right;
            let loc = loads.witness;
            let bytes = loads.proof.right.witness;
            let read = loads.proof.right.proof.left;
            let inj: Injected<M>(site.data, spans, heap, s.memory) = held.right.right.right;
            let got = inj.dword_read(loc, bytes, read);
            let at = Loads::at<M>(spans, values, heap, place, file, base, found, s.gprs, held.left.left, loc, loads.proof.left);
            let dword = imm32_from_bytes(byte_at(bytes, 0), byte_at(bytes, 1), byte_at(bytes, 2), byte_at(bytes, 3));
            Exists(dword, ⟨j(sym(at), λ x _ => x.toNat() + 4 <= Nat::pow(2, 47), loan.below(loc, 4, got.left)),
                ⟨j(sym(at), λ x _ => read_dword(site.data, s.memory, x) = Some(dword), got.right),
                 written_leaves<M>(saves, stack, spans, heap_in<M>(site.data, spans), values, d, s0, heap, file, destination, output, view_kind(view), dword.zero_extend(32),
                    apart, s, s.flags, next_rip(s.rip, dword_load_bytes(load).len()), held.left.left, held.right,
                    j(word_of_four(bytes, heap.read_bytes_len(loc, 4, bytes, read)), λ x _ => Held(output, view_kind(view)).Rep(values, x),
                        loads.proof.right.proof.right))⟩⟩)
        })⟩
}

// Eight bytes loaded: `MOV destination, qword [base]`.
theorem load_word_emits<M>(saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), top: Nat,
    spans: Spans, loan: Loan<M>(site.fetch, site.data, stack, top, spans), values: Valuation(), d: Nat, s0: MachineState<M>, prog: Prog,
    file: File, view, output, place: Nat, base, destination: Gpr, found: FoundAt(file, Held(place, Word), base),
    apart: destination.apart(body_kept(saves)).IsTrue(), placement: List<Place>, names: Nat, heap: Heap):
    EmitsHeap<M>(saves, site, stack, spans, values, d, s0, prog, file, Loads(spans, values, heap, 8, view, output, place), heap, heap,
        Emitted(At(prog, 0, Load(WordLoad(destination, base))), file.write(destination, Some(Held(output, view_kind(view)))), placement, names)) {
    let load = WordLoad(destination, base);
    let out_file = file.write(destination, Some(Held(output, view_kind(view))));
    let facts = Loads(spans, values, heap, 8, view, output, place);
    ⟨prog.within_then(0, Load(load)),
     λ within => site.moves_word_load(stack.writes, site.program.laid_out_fits(laid), within.witness, prog, 0, load, within.proof,
        HeapPre<M>(saves, stack, spans, values, d, s0, file, facts, heap),
        λ (t: MachineState<M>) => out_file.Represents(values, t.gprs) ∧ stack.TrailedBy(saves, spans, heap_in<M>(site.data, spans), d, s0, heap, t),
        λ s held => {
            let loads = held.left.right;
            let loc = loads.witness;
            let bytes = loads.proof.right.witness;
            let read = loads.proof.right.proof.left;
            let inj: Injected<M>(site.data, spans, heap, s.memory) = held.right.right.right;
            let got = inj.word_read(loc, bytes, read);
            let at = Loads::at<M>(spans, values, heap, place, file, base, found, s.gprs, held.left.left, loc, loads.proof.left);
            let word = word_of_bytes(bytes);
            Exists(word, ⟨j(sym(at), λ x _ => x.toNat() + 8 <= Nat::pow(2, 47), loan.below(loc, 8, got.left)),
                ⟨j(sym(at), λ x _ => read_word(site.data, s.memory, x) = Some(word), got.right),
                 written_leaves<M>(saves, stack, spans, heap_in<M>(site.data, spans), values, d, s0, heap, file, destination, output, view_kind(view), word,
                    apart, s, s.flags, next_rip(s.rip, word_load_bytes(load).len()), held.left.left, held.right, loads.proof.right.proof.right)⟩⟩)
        })⟩
}

// A reference's load's meaning: `place` holds a reference's address, a
// reference is held at its eight bytes, and `output` is its target's
// address.
fn LoadsRef(spans: Spans, values: Valuation(), heap: Heap, output, place: Nat) → Type {
    Exists<Loc>(λ loc => (values(64, place) = loc.address(spans)) ∧
        Exists<Loc>(λ target => (heap.load_ref(loc) = Some(target)) ∧ (values(64, output) = target.address(spans))))
}

// A reference loaded: the same `MOV` as a word's, reading its target's
// address (`Injected::ref_read`).
theorem load_ref_emits<M>(saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), top: Nat,
    spans: Spans, loan: Loan<M>(site.fetch, site.data, stack, top, spans), values: Valuation(), d: Nat, s0: MachineState<M>, prog: Prog,
    file: File, output, place: Nat, base, destination: Gpr, found: FoundAt(file, Held(place, Word), base),
    apart: destination.apart(body_kept(saves)).IsTrue(), placement: List<Place>, names: Nat, heap: Heap):
    EmitsHeap<M>(saves, site, stack, spans, values, d, s0, prog, file, LoadsRef(spans, values, heap, output, place), heap, heap,
        Emitted(At(prog, 0, Load(WordLoad(destination, base))), file.write(destination, Some(Held(output, Word))), placement, names)) {
    let load = WordLoad(destination, base);
    let out_file = file.write(destination, Some(Held(output, Word)));
    let facts = LoadsRef(spans, values, heap, output, place);
    ⟨prog.within_then(0, Load(load)),
     λ within => site.moves_word_load(stack.writes, site.program.laid_out_fits(laid), within.witness, prog, 0, load, within.proof,
        HeapPre<M>(saves, stack, spans, values, d, s0, file, facts, heap),
        λ (t: MachineState<M>) => out_file.Represents(values, t.gprs) ∧ stack.TrailedBy(saves, spans, heap_in<M>(site.data, spans), d, s0, heap, t),
        λ s held => {
            let loads = held.left.right;
            let loc = loads.witness;
            let target = loads.proof.right.witness;
            let inj: Injected<M>(site.data, spans, heap, s.memory) = held.right.right.right;
            let got = inj.ref_read(loc, target, loads.proof.right.proof.left);
            let at = Loads::at<M>(spans, values, heap, place, file, base, found, s.gprs, held.left.left, loc, loads.proof.left);
            let word = target.address(spans);
            Exists(word, ⟨j(sym(at), λ x _ => x.toNat() + 8 <= Nat::pow(2, 47), loan.below(loc, 8, got.left)),
                ⟨j(sym(at), λ x _ => read_word(site.data, s.memory, x) = Some(word), got.right),
                 written_leaves<M>(saves, stack, spans, heap_in<M>(site.data, spans), values, d, s0, heap, file, destination, output, Word, word,
                    apart, s, s.flags, next_rip(s.rip, word_load_bytes(load).len()), held.left.left, held.right, loads.proof.right.proof.right)⟩⟩)
        })⟩
}

// ---------------------------------------------------------------------------
// Stores

// A store's meaning at the valuation: `place` holds a reference's address,
// and the low `n` bytes of `value`'s view at width `view` are put there.
fn Stores(spans: Spans, values: Valuation(), blocks: Blocks, heap, after: Heap, n, view, place, value: Nat) → Type {
    Exists<Loc>(λ loc => (values(64, place) = loc.address(spans)) ∧
        (heap.put(blocks.written, loc, Piece::plain(low_bytes(n, view_word(values, view, value)))) = Some(after)))
}

// A reference's store's: `place` holds a reference's address and `value`
// its target's, and the reference is put there.
fn StoresRef(spans: Spans, values: Valuation(), blocks: Blocks, heap, after: Heap, place, value: Nat) → Type {
    Exists<Loc>(λ loc => (values(64, place) = loc.address(spans)) ∧
        Exists<Loc>(λ target => (values(64, value) = target.address(spans)) ∧ (heap.put(blocks.written, loc, Piece::reference(target)) = Some(after))))
}

// Bytes the run puts at `loc` are a store the lending allows: writable, the
// code kept, and after it the trail is kept with the heap the put leaves
// injected. The registers are untouched.
theorem stored_leaves<M>(saves: Nat, site: Site<M>, stack: Stack<M>(site.fetch, site.data), top: Nat, spans: Spans,
    loan: Loan<M>(site.fetch, site.data, stack, top, spans), blocks: Blocks, lent: blocks.Lent(spans), values: Valuation(), d: Nat,
    s0: MachineState<M>, heap, after: Heap, loc: Loc, bytes: List<BitVec(8)>, some: 1 <= bytes.len(), put: heap.put(blocks.written, loc, Piece::plain(bytes)) = Some(after),
    s: MachineState<M>, resident: site.Resident(s.memory),
    trailed: stack.TrailedBy(saves, spans, heap_in<M>(site.data, spans), d, s0, heap, s), flags: Flags, rip: BitVec(64)):
    stack.writes.writable(s.memory, loc.address(spans), bytes.len()) ∧
        (site.Resident(stack.writes.store(s.memory, loc.address(spans), bytes)) ∧
            stack.TrailedBy(saves, spans, heap_in<M>(site.data, spans), d, s0, after,
                MachineState(s.gprs, flags, rip, stack.writes.store(s.memory, loc.address(spans), bytes)))) {
    let inj: Injected<M>(site.data, spans, heap, s.memory) = trailed.right.right;
    let facts = heap.put_lent(blocks, spans, lent, inj.sizes, loc, Piece::plain(bytes), after, put);
    let written = facts.left;
    let span_fits: (loc.offset + bytes.len() <= spans.size(loc.block)) = facts.right.left;
    let ok: (heap.fits(loc, bytes.len()) = True) = heap.put_some(blocks.written, loc, Piece::plain(bytes), after, put).right.left;
    let inside: (loc.offset < spans.size(loc.block)) = omega(span_fits, some);
    ⟨loan.writable(s.memory, loc.block, loc.offset, written, inside, bytes, span_fits),
     ⟨loan.keeps_code(s.memory, loc.block, loc.offset, written, inside, bytes, span_fits, assemble(no_fills(), site.program, site.last),
        next_rip(site.origin, 0), resident),
      ⟨trailed.left,
       ⟨stack.wrote_in_trans(d, spans, s0.memory, s.memory, stack.writes.store(s.memory, loc.address(spans), bytes), trailed.right.left,
            stack.wrote_in_store(d, spans, s.memory, loc.block, loc.offset, written, inside, bytes, span_fits)),
        j(facts.right.right, λ a _ => Injected<M>(site.data, spans, a, stack.writes.store(s.memory, loc.address(spans), bytes)),
            loan.store_injected(heap, s.memory, inj, loc, written, inside, bytes, ok))⟩⟩⟩⟩
}

// A byte stored: `MOV byte [base], source8`.
theorem store_byte_emits<M>(saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), top: Nat,
    spans: Spans, loan: Loan<M>(site.fetch, site.data, stack, top, spans), blocks: Blocks, lent: blocks.Lent(spans), values: Valuation(), d: Nat,
    s0: MachineState<M>, prog: Prog, file: File, view, place, value: Nat, base, source: Gpr, at_place: FoundAt(file, Held(place, Word), base),
    at_value: FoundAt(file, Held(value, view_kind(view)), source), plain: store_base_plain(base) = True, placement: List<Place>, names: Nat, heap, after: Heap):
    EmitsHeap<M>(saves, site, stack, spans, values, d, s0, prog, file, Stores(spans, values, blocks, heap, after, 1, view, place, value), heap, after,
        Emitted(At(prog, 0, StoreByte(ByteStore(base, source))), file, placement, names)) {
    let store = ByteStore(base, source);
    let facts = Stores(spans, values, blocks, heap, after, 1, view, place, value);
    ⟨prog.within_then(0, StoreByte(store)),
     λ within => site.moves_store_byte(stack.writes, site.program.laid_out_fits(laid), within.witness, prog, 0, store, within.proof,
        HeapPre<M>(saves, stack, spans, values, d, s0, file, facts, heap),
        λ (t: MachineState<M>) => file.Represents(values, t.gprs) ∧ stack.TrailedBy(saves, spans, heap_in<M>(site.data, spans), d, s0, after, t),
        λ s held resident => {
            let stores = held.left.right;
            let loc = stores.witness;
            let at = Loads::at<M>(spans, values, heap, place, file, base, at_place, s.gprs, held.left.left, loc, stores.proof.left);
            let word: (view_word(values, view, value) = read_gpr(source, s.gprs)) =
                view_word_held(values, view, value, read_gpr(source, s.gprs), at_value.rep(values, s.gprs, held.left.left));
            let rip = next_rip(s.rip, 3);
            let goal = λ (x: BitVec(64)) (w: BitVec(64)) => stack.writes.writable(s.memory, x, 1) ∧
                (site.Resident(stack.writes.store(s.memory, x, low_bytes(1, w))) ∧
                    (file.Represents(values, s.gprs) ∧ stack.TrailedBy(saves, spans, heap_in<M>(site.data, spans), d, s0, after,
                        MachineState(s.gprs, s.flags, rip, stack.writes.store(s.memory, x, low_bytes(1, w))))));
            let left = stored_leaves<M>(saves, site, stack, top, spans, loan, blocks, lent, values, d, s0, heap, after, loc,
                low_bytes(1, view_word(values, view, value)), Nat::le_refl(1), stores.proof.right, s, resident, held.right, s.flags, rip);
            let done: goal(loc.address(spans), view_word(values, view, value)) = ⟨left.left, ⟨left.right.left, ⟨held.left.left, left.right.right⟩⟩⟩;
            ⟨plain, j(word, λ w _ => goal(read_gpr(base, s.gprs), w), j(sym(at), λ x _ => goal(x, view_word(values, view, value)), done))⟩
        })⟩
}

// Four bytes stored: `MOV dword [base], source32`.
theorem store_dword_emits<M>(saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), top: Nat,
    spans: Spans, loan: Loan<M>(site.fetch, site.data, stack, top, spans), blocks: Blocks, lent: blocks.Lent(spans), values: Valuation(), d: Nat,
    s0: MachineState<M>, prog: Prog, file: File, view, place, value: Nat, base, source: Gpr, at_place: FoundAt(file, Held(place, Word), base),
    at_value: FoundAt(file, Held(value, view_kind(view)), source), plain: store_base_plain(base) = True, placement: List<Place>, names: Nat, heap, after: Heap):
    EmitsHeap<M>(saves, site, stack, spans, values, d, s0, prog, file, Stores(spans, values, blocks, heap, after, 4, view, place, value), heap, after,
        Emitted(At(prog, 0, asm_dword_store(DwordStore(base, source))), file, placement, names)) {
    let store = DwordStore(base, source);
    let facts = Stores(spans, values, blocks, heap, after, 4, view, place, value);
    ⟨prog.within_then(0, asm_dword_store(store)),
     λ within => site.moves_dword_store(stack.writes, site.program.laid_out_fits(laid), within.witness, prog, 0, store, within.proof,
        HeapPre<M>(saves, stack, spans, values, d, s0, file, facts, heap),
        λ (t: MachineState<M>) => file.Represents(values, t.gprs) ∧ stack.TrailedBy(saves, spans, heap_in<M>(site.data, spans), d, s0, after, t),
        λ s held resident => {
            let stores = held.left.right;
            let loc = stores.witness;
            let at = Loads::at<M>(spans, values, heap, place, file, base, at_place, s.gprs, held.left.left, loc, stores.proof.left);
            let word: (view_word(values, view, value) = read_gpr(source, s.gprs)) =
                view_word_held(values, view, value, read_gpr(source, s.gprs), at_value.rep(values, s.gprs, held.left.left));
            let rip = next_rip(s.rip, 3);
            let goal = λ (x: BitVec(64)) (w: BitVec(64)) => stack.writes.writable(s.memory, x, 4) ∧
                (site.Resident(stack.writes.store(s.memory, x, low_bytes(4, w))) ∧
                    (file.Represents(values, s.gprs) ∧ stack.TrailedBy(saves, spans, heap_in<M>(site.data, spans), d, s0, after,
                        MachineState(s.gprs, s.flags, rip, stack.writes.store(s.memory, x, low_bytes(4, w))))));
            let left = stored_leaves<M>(saves, site, stack, top, spans, loan, blocks, lent, values, d, s0, heap, after, loc,
                low_bytes(4, view_word(values, view, value)), omega(), stores.proof.right, s, resident, held.right, s.flags, rip);
            let done: goal(loc.address(spans), view_word(values, view, value)) = ⟨left.left, ⟨left.right.left, ⟨held.left.left, left.right.right⟩⟩⟩;
            ⟨plain, j(word, λ w _ => goal(read_gpr(base, s.gprs), w), j(sym(at), λ x _ => goal(x, view_word(values, view, value)), done))⟩
        })⟩
}

// Eight bytes stored: `MOV qword [base], source`.
theorem store_word_emits<M>(saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), top: Nat,
    spans: Spans, loan: Loan<M>(site.fetch, site.data, stack, top, spans), blocks: Blocks, lent: blocks.Lent(spans), values: Valuation(), d: Nat,
    s0: MachineState<M>, prog: Prog, file: File, view, place, value: Nat, base, source: Gpr, at_place: FoundAt(file, Held(place, Word), base),
    at_value: FoundAt(file, Held(value, view_kind(view)), source), plain: store_base_plain(base) = True, placement: List<Place>, names: Nat, heap, after: Heap):
    EmitsHeap<M>(saves, site, stack, spans, values, d, s0, prog, file, Stores(spans, values, blocks, heap, after, 8, view, place, value), heap, after,
        Emitted(At(prog, 0, asm_word_store(WordStore(base, source))), file, placement, names)) {
    let store = WordStore(base, source);
    let facts = Stores(spans, values, blocks, heap, after, 8, view, place, value);
    ⟨prog.within_then(0, asm_word_store(store)),
     λ within => site.moves_word_store(stack.writes, site.program.laid_out_fits(laid), within.witness, prog, 0, store, within.proof,
        HeapPre<M>(saves, stack, spans, values, d, s0, file, facts, heap),
        λ (t: MachineState<M>) => file.Represents(values, t.gprs) ∧ stack.TrailedBy(saves, spans, heap_in<M>(site.data, spans), d, s0, after, t),
        λ s held resident => {
            let stores = held.left.right;
            let loc = stores.witness;
            let at = Loads::at<M>(spans, values, heap, place, file, base, at_place, s.gprs, held.left.left, loc, stores.proof.left);
            let word: (view_word(values, view, value) = read_gpr(source, s.gprs)) =
                view_word_held(values, view, value, read_gpr(source, s.gprs), at_value.rep(values, s.gprs, held.left.left));
            let rip = next_rip(s.rip, 3);
            let goal = λ (x: BitVec(64)) (w: BitVec(64)) => stack.writes.writable(s.memory, x, 8) ∧
                (site.Resident(stack.writes.store(s.memory, x, low_bytes(8, w))) ∧
                    (file.Represents(values, s.gprs) ∧ stack.TrailedBy(saves, spans, heap_in<M>(site.data, spans), d, s0, after,
                        MachineState(s.gprs, s.flags, rip, stack.writes.store(s.memory, x, low_bytes(8, w))))));
            let left = stored_leaves<M>(saves, site, stack, top, spans, loan, blocks, lent, values, d, s0, heap, after, loc,
                low_bytes(8, view_word(values, view, value)), omega(), stores.proof.right, s, resident, held.right, s.flags, rip);
            let done: goal(loc.address(spans), view_word(values, view, value)) = ⟨left.left, ⟨left.right.left, ⟨held.left.left, left.right.right⟩⟩⟩;
            ⟨plain, j(word, λ w _ => goal(read_gpr(base, s.gprs), w), j(sym(at), λ x _ => goal(x, view_word(values, view, value)), done))⟩
        })⟩
}

// A reference the run puts at `loc` is the machine's store of its
// target's address: the same store as a word's, the shadow telling
// (`Loan::store_ref_injected`).
theorem stored_ref_leaves<M>(saves: Nat, site: Site<M>, stack: Stack<M>(site.fetch, site.data), top: Nat, spans: Spans,
    loan: Loan<M>(site.fetch, site.data, stack, top, spans), blocks: Blocks, lent: blocks.Lent(spans), values: Valuation(), d: Nat,
    s0: MachineState<M>, heap, after: Heap, loc, target: Loc, put: heap.put(blocks.written, loc, Piece::reference(target)) = Some(after),
    s: MachineState<M>, resident: site.Resident(s.memory),
    trailed: stack.TrailedBy(saves, spans, heap_in<M>(site.data, spans), d, s0, heap, s), flags: Flags, rip: BitVec(64)):
    stack.writes.writable(s.memory, loc.address(spans), 8) ∧
        (site.Resident(stack.writes.store(s.memory, loc.address(spans), word_bytes(target.address(spans)))) ∧
            stack.TrailedBy(saves, spans, heap_in<M>(site.data, spans), d, s0, after,
                MachineState(s.gprs, flags, rip, stack.writes.store(s.memory, loc.address(spans), word_bytes(target.address(spans)))))) {
    let bytes = word_bytes(target.address(spans));
    let inj: Injected<M>(site.data, spans, heap, s.memory) = trailed.right.right;
    let facts = heap.put_lent(blocks, spans, lent, inj.sizes, loc, Piece::reference(target), after, put);
    let written = facts.left;
    let span_fits: (loc.offset + 8 <= spans.size(loc.block)) = facts.right.left;
    let ok: (heap.fits(loc, 8) = True) = heap.put_some(blocks.written, loc, Piece::reference(target), after, put).right.left;
    let inside: (loc.offset < spans.size(loc.block)) = omega(span_fits);
    ⟨loan.writable(s.memory, loc.block, loc.offset, written, inside, bytes, span_fits),
     ⟨loan.keeps_code(s.memory, loc.block, loc.offset, written, inside, bytes, span_fits, assemble(no_fills(), site.program, site.last),
        next_rip(site.origin, 0), resident),
      ⟨trailed.left,
       ⟨stack.wrote_in_trans(d, spans, s0.memory, s.memory, stack.writes.store(s.memory, loc.address(spans), bytes), trailed.right.left,
            stack.wrote_in_store(d, spans, s.memory, loc.block, loc.offset, written, inside, bytes, span_fits)),
        j(facts.right.right, λ a _ => Injected<M>(site.data, spans, a, stack.writes.store(s.memory, loc.address(spans), bytes)),
            loan.store_ref_injected(heap, s.memory, inj, loc, written, ok, target))⟩⟩⟩⟩
}

// A reference stored: `MOV qword [base], source`, the source holding its
// target's address.
theorem store_ref_emits<M>(saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), top: Nat,
    spans: Spans, loan: Loan<M>(site.fetch, site.data, stack, top, spans), blocks: Blocks, lent: blocks.Lent(spans), values: Valuation(), d: Nat,
    s0: MachineState<M>, prog: Prog, file: File, place, value: Nat, base, source: Gpr, at_place: FoundAt(file, Held(place, Word), base),
    at_value: FoundAt(file, Held(value, Word), source), plain: store_base_plain(base) = True, placement: List<Place>, names: Nat, heap, after: Heap):
    EmitsHeap<M>(saves, site, stack, spans, values, d, s0, prog, file, StoresRef(spans, values, blocks, heap, after, place, value), heap, after,
        Emitted(At(prog, 0, asm_word_store(WordStore(base, source))), file, placement, names)) {
    let store = WordStore(base, source);
    let facts = StoresRef(spans, values, blocks, heap, after, place, value);
    ⟨prog.within_then(0, asm_word_store(store)),
     λ within => site.moves_word_store(stack.writes, site.program.laid_out_fits(laid), within.witness, prog, 0, store, within.proof,
        HeapPre<M>(saves, stack, spans, values, d, s0, file, facts, heap),
        λ (t: MachineState<M>) => file.Represents(values, t.gprs) ∧ stack.TrailedBy(saves, spans, heap_in<M>(site.data, spans), d, s0, after, t),
        λ s held resident => {
            let stores = held.left.right;
            let loc = stores.witness;
            let target = stores.proof.right.witness;
            let at = Loads::at<M>(spans, values, heap, place, file, base, at_place, s.gprs, held.left.left, loc, stores.proof.left);
            let word: (target.address(spans) = read_gpr(source, s.gprs)) =
                trans(sym(stores.proof.right.proof.left), at_value.rep(values, s.gprs, held.left.left));
            let rip = next_rip(s.rip, 3);
            let goal = λ (x: BitVec(64)) (w: BitVec(64)) => stack.writes.writable(s.memory, x, 8) ∧
                (site.Resident(stack.writes.store(s.memory, x, word_bytes(w))) ∧
                    (file.Represents(values, s.gprs) ∧ stack.TrailedBy(saves, spans, heap_in<M>(site.data, spans), d, s0, after,
                        MachineState(s.gprs, s.flags, rip, stack.writes.store(s.memory, x, word_bytes(w))))));
            let left = stored_ref_leaves<M>(saves, site, stack, top, spans, loan, blocks, lent, values, d, s0, heap, after, loc, target,
                stores.proof.right.proof.right, s, resident, held.right, s.flags, rip);
            let done: goal(loc.address(spans), target.address(spans)) = ⟨left.left, ⟨left.right.left, ⟨held.left.left, left.right.right⟩⟩⟩;
            ⟨plain, j(word, λ w _ => goal(read_gpr(base, s.gprs), w), j(sym(at), λ x _ => goal(x, target.address(spans)), done))⟩
        })⟩
}

// ---------------------------------------------------------------------------
// An offset is a word node

// An offset's meaning at the valuation: `place` holds a reference's address,
// and `output` the address `amount` bytes on in its block.
fn Offsets(spans: Spans, values: Valuation(), output, place, amount: Nat) → Type {
    Exists<Loc>(λ loc => (values(64, place) = loc.address(spans)) ∧
        (values(64, output) = Loc(loc.block, loc.offset + values(64, amount).toNat()).address(spans)))
}

// Where it holds, so does the word node adding the two words: a reference
// is its target's address, and `amount` bytes on is `amount` added. So an
// offset is lowered as FunctionIR's `ADD`.
theorem offset_adds(spans: Spans, values: Valuation(), output, place, amount: Nat, offsets: Offsets(spans, values, output, place, amount)):
    NodeHolds(values, Add(64, output, place, amount)) {
    let loc = offsets.witness;
    let a = values(64, amount);
    trans(offsets.proof.right,
        trans(sym(rip_compose(spans.at(loc.block), loc.offset, a.toNat())),
            trans(cong_fn<BitVec(64), BitVec(64)>(λ x => next_rip(x, a.toNat()), sym(offsets.proof.left)),
                BitVec::iter_add_eq_add(64, values(64, place), a))))
}

// ---------------------------------------------------------------------------
// A block of word nodes

// Word nodes as FunctionIR lowers them (`lower_nodes`), as one block the
// body's kept registers survive, or nothing.
fn emit_word_nodes(saves: Nat, prog: Prog, file: File, nodes: List<Node>, placement: List<Place>, names: Nat) → Option<Emitted> {
    match lower_nodes(nodes, placement, file) {
        None => None,
        Some(l) => match leaves_all(l.code, body_kept(saves)) {
            False => None,
            True => Some(Emitted(At(prog, 0, Asm::of_code(l.code)), l.file, skip_nodes(nodes, placement), names)),
        },
    }
}

// Proved by FunctionIR's theorems for them, unedited.
theorem emit_word_nodes_emits<M>(saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data),
    spans: Spans, values: Valuation(), d: Nat, s0: MachineState<M>, prog: Prog, file: File, nodes: List<Node>, placement: List<Place>, names: Nat,
    now: Heap):
    MayEmitBy<M, Heap>(saves, site, stack, spans, heap_in<M>(site.data, spans), values, d, s0, prog, file, NodesHold(values, nodes), now, now,
        emit_word_nodes(saves, prog, file, nodes, placement, names)) {
    (match lower_nodes(nodes, placement, file) as λ lowered =>
        MayKeep<M>(values, file, NodesHold(values, nodes), lowered) →
        MayGuard<M>(values, file, NodesHold(values, nodes), lowered) →
        MayEmitBy<M, Heap>(saves, site, stack, spans, heap_in<M>(site.data, spans), values, d, s0, prog, file, NodesHold(values, nodes), now, now,
            match lowered {
                None => None,
                Some(l) => match leaves_all(l.code, body_kept(saves)) {
                    False => None,
                    True => Some(Emitted(At(prog, 0, Asm::of_code(l.code)), l.file, skip_nodes(nodes, placement), names)),
                },
            }) {
        None => λ _ _ => trivial,
        Some(lowered) => λ keeps guards => match left: leaves_all(lowered.code, body_kept(saves)) {
            False => trivial,
            True => pure_emits<M, Heap>(saves, site, laid, stack, spans, heap_in<M>(site.data, spans), values, d, s0, prog, file,
                NodesHold(values, nodes), lowered, keeps, guards, is_true_of_eq(leaves_all(lowered.code, body_kept(saves)), left),
                skip_nodes(nodes, placement), names, now),
        },
    })(lower_nodes_keeps<M>(values, nodes, placement, file), lower_nodes_guards<M>(values, nodes, placement, file))
}

// ---------------------------------------------------------------------------
// Each node's code

fn MayEmitHeap<M>(saves: Nat, site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, values: Valuation(), d: Nat,
    s0: MachineState<M>, prog: Prog, file: File, facts: Type, before, after: Heap, out: Option<Emitted>) → Type {
    MayEmitBy<M, Heap>(saves, site, stack, spans, heap_in<M>(site.data, spans), values, d, s0, prog, file, facts, before, after, out)
}

// A load at its width: one byte, four or eight; any other is refused (a
// two-byte load waits for the machine's `MOVZX r, word`).
fn emit_load(prog: Prog, file: File, view, output, place: Nat, destination, base: Gpr, bytes: Nat, later: List<Place>, names: Nat) → Option<Emitted> {
    match bytes.same(1) {
        True => Some(Emitted(At(prog, 0, LoadByte(ByteLoad(destination, base))), file.write(destination, Some(Held(output, view_kind(view)))), later, names)),
        False => match bytes.same(4) {
            True => Some(Emitted(At(prog, 0, asm_dword_load(DwordLoad(destination, base))), file.write(destination, Some(Held(output, view_kind(view)))), later,
                names)),
            False => match bytes.same(8) {
                True => Some(Emitted(At(prog, 0, Load(WordLoad(destination, base))), file.write(destination, Some(Held(output, view_kind(view)))), later, names)),
                False => None,
            },
        },
    }
}

theorem emit_load_emits<M>(saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), top: Nat,
    spans: Spans, loan: Loan<M>(site.fetch, site.data, stack, top, spans), values: Valuation(), d: Nat, s0: MachineState<M>, prog: Prog,
    file: File, view, output, place: Nat, base, destination: Gpr, found: FoundAt(file, Held(place, Word), base),
    apart: destination.apart(body_kept(saves)).IsTrue(), bytes: Nat, later: List<Place>, names: Nat, heap: Heap):
    MayEmitHeap<M>(saves, site, stack, spans, values, d, s0, prog, file, Loads(spans, values, heap, bytes, view, output, place), heap, heap,
        emit_load(prog, file, view, output, place, destination, base, bytes, later, names)) {
    let out_file = file.write(destination, Some(Held(output, view_kind(view))));
    let at = λ (n: Nat) (e: bytes.same(n) = True) (out: Emitted)
        (emits: EmitsHeap<M>(saves, site, stack, spans, values, d, s0, prog, file, Loads(spans, values, heap, n, view, output, place), heap, heap, out)) =>
        j(sym(bytes.same_sound(n, e)), λ k _ => EmitsHeap<M>(saves, site, stack, spans, values, d, s0, prog, file, Loads(spans, values, heap, k, view, output, place),
            heap, heap, out), emits);
    (match bytes.same(1) as λ v => bytes.same(1) = v → MayEmitHeap<M>(saves, site, stack, spans, values, d, s0, prog, file,
            Loads(spans, values, heap, bytes, view, output, place), heap, heap, match v {
                True => Some(Emitted(At(prog, 0, LoadByte(ByteLoad(destination, base))), out_file, later, names)),
                False => match bytes.same(4) {
                    True => Some(Emitted(At(prog, 0, asm_dword_load(DwordLoad(destination, base))), out_file, later, names)),
                    False => match bytes.same(8) {
                        True => Some(Emitted(At(prog, 0, Load(WordLoad(destination, base))), out_file, later, names)),
                        False => None,
                    },
                },
            }) {
        True => λ e => at(1, e, Emitted(At(prog, 0, LoadByte(ByteLoad(destination, base))), out_file, later, names),
            load_byte_emits<M>(saves, site, laid, stack, top, spans, loan, values, d, s0, prog, file, view, output, place, base, destination, found, apart,
                later, names, heap)),
        False => λ _ => (match bytes.same(4) as λ v => bytes.same(4) = v → MayEmitHeap<M>(saves, site, stack, spans, values, d, s0, prog, file,
                Loads(spans, values, heap, bytes, view, output, place), heap, heap, match v {
                    True => Some(Emitted(At(prog, 0, asm_dword_load(DwordLoad(destination, base))), out_file, later, names)),
                    False => match bytes.same(8) {
                        True => Some(Emitted(At(prog, 0, Load(WordLoad(destination, base))), out_file, later, names)),
                        False => None,
                    },
                }) {
            True => λ e => at(4, e, Emitted(At(prog, 0, asm_dword_load(DwordLoad(destination, base))), out_file, later, names),
                load_dword_emits<M>(saves, site, laid, stack, top, spans, loan, values, d, s0, prog, file, view, output, place, base, destination, found, apart,
                    later, names, heap)),
            False => λ _ => (match bytes.same(8) as λ v => bytes.same(8) = v → MayEmitHeap<M>(saves, site, stack, spans, values, d, s0, prog, file,
                    Loads(spans, values, heap, bytes, view, output, place), heap, heap, match v {
                        True => Some(Emitted(At(prog, 0, Load(WordLoad(destination, base))), out_file, later, names)),
                        False => None,
                    }) {
                True => λ e => at(8, e, Emitted(At(prog, 0, Load(WordLoad(destination, base))), out_file, later, names),
                    load_word_emits<M>(saves, site, laid, stack, top, spans, loan, values, d, s0, prog, file, view, output, place, base, destination, found,
                        apart, later, names, heap)),
                False => λ _ => trivial,
            })(refl),
        })(refl),
    })(refl)
}

// A store at its width, through a base the encoding takes plainly.
fn emit_store(prog: Prog, file: File, base, source: Gpr, bytes: Nat, later: List<Place>, names: Nat) → Option<Emitted> {
    match store_base_plain(base) {
        False => None,
        True => match bytes.same(1) {
            True => Some(Emitted(At(prog, 0, StoreByte(ByteStore(base, source))), file, later, names)),
            False => match bytes.same(4) {
                True => Some(Emitted(At(prog, 0, asm_dword_store(DwordStore(base, source))), file, later, names)),
                False => match bytes.same(8) {
                    True => Some(Emitted(At(prog, 0, asm_word_store(WordStore(base, source))), file, later, names)),
                    False => None,
                },
            },
        },
    }
}

theorem emit_store_emits<M>(saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), top: Nat,
    spans: Spans, loan: Loan<M>(site.fetch, site.data, stack, top, spans), blocks: Blocks, lent: blocks.Lent(spans), values: Valuation(), d: Nat,
    s0: MachineState<M>, prog: Prog, file: File, view, place, value: Nat, base, source: Gpr, at_place: FoundAt(file, Held(place, Word), base),
    at_value: FoundAt(file, Held(value, view_kind(view)), source), bytes: Nat, later: List<Place>, names: Nat, heap, after: Heap):
    MayEmitHeap<M>(saves, site, stack, spans, values, d, s0, prog, file, Stores(spans, values, blocks, heap, after, bytes, view, place, value), heap, after,
        emit_store(prog, file, base, source, bytes, later, names)) {
    let at = λ (n: Nat) (e: bytes.same(n) = True) (out: Emitted)
        (emits: EmitsHeap<M>(saves, site, stack, spans, values, d, s0, prog, file, Stores(spans, values, blocks, heap, after, n, view, place, value), heap,
            after, out)) =>
        j(sym(bytes.same_sound(n, e)), λ k _ => EmitsHeap<M>(saves, site, stack, spans, values, d, s0, prog, file,
            Stores(spans, values, blocks, heap, after, k, view, place, value), heap, after, out), emits);
    match plain: store_base_plain(base) {
        False => trivial,
        True => match one: bytes.same(1) {
            True => at(1, one, Emitted(At(prog, 0, StoreByte(ByteStore(base, source))), file, later, names),
                store_byte_emits<M>(saves, site, laid, stack, top, spans, loan, blocks, lent, values, d, s0, prog, file, view, place, value, base, source,
                    at_place, at_value, plain, later, names, heap, after)),
            False => match four: bytes.same(4) {
                True => at(4, four, Emitted(At(prog, 0, asm_dword_store(DwordStore(base, source))), file, later, names),
                    store_dword_emits<M>(saves, site, laid, stack, top, spans, loan, blocks, lent, values, d, s0, prog, file, view, place, value, base, source,
                        at_place, at_value, plain, later, names, heap, after)),
                False => match eight: bytes.same(8) {
                    True => at(8, eight, Emitted(At(prog, 0, asm_word_store(WordStore(base, source))), file, later, names),
                        store_word_emits<M>(saves, site, laid, stack, top, spans, loan, blocks, lent, values, d, s0, prog, file, view, place, value, base,
                            source, at_place, at_value, plain, later, names, heap, after)),
                    False => trivial,
                },
            },
        },
    }
}

// A register the placement names for a node's word, one the body may write.
fn Place::destination(self p: Place, saves: Nat) → Option<Gpr> {
    match p {
        Into(register) => match register.apart(body_kept(saves)) { False => None, True => Some(register) },
        _ => None,
    }
}

theorem Place::destination_apart(self p: Place, saves: Nat, register: Gpr, named: p.destination(saves) = Some(register)):
    register.apart(body_kept(saves)).IsTrue() {
    match p {
        Into(r) => match a: r.apart(body_kept(saves)) {
            False => absurd(named),
            True => is_true_of_eq(register.apart(body_kept(saves)),
                j(Option::some_inj(r, register, named), λ x _ => x.apart(body_kept(saves)) = True, a)),
        },
        Folded => absurd(named),
        Saving(_) => absurd(named),
        CallSlots(_) => absurd(named),
        Spilling(_) => absurd(named),
        Short(_) => absurd(named),
    }
}

// A load through the register the file says holds the reference, into the
// register the placement names.
fn emit_load_at(saves: Nat, prog: Prog, file: File, view, output, place, bytes: Nat, placement: List<Place>, names: Nat) → Option<Emitted> {
    match placement {
        Nil => None,
        Cons(p, later) => match p.destination(saves) {
            None => None,
            Some(destination) => match file.find(Held(place, Word)) {
                None => None,
                Some(found) => emit_load(prog, file, view, output, place, destination, found.register, bytes, later, names),
            },
        },
    }
}

theorem emit_load_at_emits<M>(saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), top: Nat,
    spans: Spans, loan: Loan<M>(site.fetch, site.data, stack, top, spans), values: Valuation(), d: Nat, s0: MachineState<M>, prog: Prog,
    file: File, view, output, place, bytes: Nat, placement: List<Place>, names: Nat, heap: Heap):
    MayEmitHeap<M>(saves, site, stack, spans, values, d, s0, prog, file, Loads(spans, values, heap, bytes, view, output, place), heap, heap,
        emit_load_at(saves, prog, file, view, output, place, bytes, placement, names)) {
    match placement {
        Nil => trivial,
        Cons(p, later) => match named: p.destination(saves) {
            None => trivial,
            Some(destination) => match file.find(Held(place, Word)) {
                None => trivial,
                Some(found) => emit_load_emits<M>(saves, site, laid, stack, top, spans, loan, values, d, s0, prog, file, view, output, place, found.register,
                    destination, found.at, p.destination_apart(saves, destination, named), bytes, later, names, heap),
            },
        },
    }
}

// A reference loaded likewise, as a word.
fn emit_load_ref_at(saves: Nat, prog: Prog, file: File, output, place: Nat, placement: List<Place>, names: Nat) → Option<Emitted> {
    match placement {
        Nil => None,
        Cons(p, later) => match p.destination(saves) {
            None => None,
            Some(destination) => match file.find(Held(place, Word)) {
                None => None,
                Some(found) => Some(Emitted(At(prog, 0, Load(WordLoad(destination, found.register))), file.write(destination, Some(Held(output, Word))),
                    later, names)),
            },
        },
    }
}

theorem emit_load_ref_at_emits<M>(saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data),
    top: Nat, spans: Spans, loan: Loan<M>(site.fetch, site.data, stack, top, spans), values: Valuation(), d: Nat, s0: MachineState<M>, prog: Prog,
    file: File, output, place: Nat, placement: List<Place>, names: Nat, heap: Heap):
    MayEmitHeap<M>(saves, site, stack, spans, values, d, s0, prog, file, LoadsRef(spans, values, heap, output, place), heap, heap,
        emit_load_ref_at(saves, prog, file, output, place, placement, names)) {
    match placement {
        Nil => trivial,
        Cons(p, later) => match named: p.destination(saves) {
            None => trivial,
            Some(destination) => match file.find(Held(place, Word)) {
                None => trivial,
                Some(found) => load_ref_emits<M>(saves, site, laid, stack, top, spans, loan, values, d, s0, prog, file, output, place, found.register,
                    destination, found.at, p.destination_apart(saves, destination, named), later, names, heap),
            },
        },
    }
}

// A store from the register holding the word through the one holding the
// reference; the placement's entry for it is passed over.
fn emit_store_at(prog: Prog, file: File, view, place, value, bytes: Nat, placement: List<Place>, names: Nat) → Option<Emitted> {
    match placement {
        Nil => None,
        Cons(skipped, later) => match file.find(Held(place, Word)) {
            None => None,
            Some(base) => match file.find(Held(value, view_kind(view))) {
                None => None,
                Some(source) => emit_store(prog, file, base.register, source.register, bytes, later, names),
            },
        },
    }
}

theorem emit_store_at_emits<M>(saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data),
    top: Nat, spans: Spans, loan: Loan<M>(site.fetch, site.data, stack, top, spans), blocks: Blocks, lent: blocks.Lent(spans), values: Valuation(),
    d: Nat, s0: MachineState<M>, prog: Prog, file: File, view, place, value, bytes: Nat, placement: List<Place>, names: Nat, heap, after: Heap):
    MayEmitHeap<M>(saves, site, stack, spans, values, d, s0, prog, file, Stores(spans, values, blocks, heap, after, bytes, view, place, value), heap, after,
        emit_store_at(prog, file, view, place, value, bytes, placement, names)) {
    let facts = Stores(spans, values, blocks, heap, after, bytes, view, place, value);
    match placement {
        Nil => trivial,
        Cons(skipped, later) => (match file.find(Held(place, Word)) as λ o => MayEmitHeap<M>(saves, site, stack, spans, values, d, s0, prog, file, facts,
                heap, after, match o {
                    None => None,
                    Some(base) => match file.find(Held(value, view_kind(view))) {
                        None => None,
                        Some(source) => emit_store(prog, file, base.register, source.register, bytes, later, names),
                    },
                }) {
            None => trivial,
            Some(base) => (match file.find(Held(value, view_kind(view))) as λ o => MayEmitHeap<M>(saves, site, stack, spans, values, d, s0, prog, file, facts,
                    heap, after, match o { None => None, Some(source) => emit_store(prog, file, base.register, source.register, bytes, later, names) }) {
                None => trivial,
                Some(source) => emit_store_emits<M>(saves, site, laid, stack, top, spans, loan, blocks, lent, values, d, s0, prog, file, view, place, value,
                    base.register, source.register, base.at, source.at, bytes, later, names, heap, after),
            }),
        }),
    }
}

fn emit_store_ref_at(prog: Prog, file: File, place, value: Nat, placement: List<Place>, names: Nat) → Option<Emitted> {
    match placement {
        Nil => None,
        Cons(skipped, later) => match file.find(Held(place, Word)) {
            None => None,
            Some(base) => match file.find(Held(value, Word)) {
                None => None,
                Some(source) => match store_base_plain(base.register) {
                    False => None,
                    True => Some(Emitted(At(prog, 0, asm_word_store(WordStore(base.register, source.register))), file, later, names)),
                },
            },
        },
    }
}

theorem emit_store_ref_at_emits<M>(saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data),
    top: Nat, spans: Spans, loan: Loan<M>(site.fetch, site.data, stack, top, spans), blocks: Blocks, lent: blocks.Lent(spans), values: Valuation(),
    d: Nat, s0: MachineState<M>, prog: Prog, file: File, place, value: Nat, placement: List<Place>, names: Nat, heap, after: Heap):
    MayEmitHeap<M>(saves, site, stack, spans, values, d, s0, prog, file, StoresRef(spans, values, blocks, heap, after, place, value), heap, after,
        emit_store_ref_at(prog, file, place, value, placement, names)) {
    let facts = StoresRef(spans, values, blocks, heap, after, place, value);
    match placement {
        Nil => trivial,
        Cons(skipped, later) => (match file.find(Held(place, Word)) as λ o => MayEmitHeap<M>(saves, site, stack, spans, values, d, s0, prog, file, facts,
                heap, after, match o {
                    None => None,
                    Some(base) => match file.find(Held(value, Word)) {
                        None => None,
                        Some(source) => match store_base_plain(base.register) {
                            False => None,
                            True => Some(Emitted(At(prog, 0, asm_word_store(WordStore(base.register, source.register))), file, later, names)),
                        },
                    },
                }) {
            None => trivial,
            Some(base) => (match file.find(Held(value, Word)) as λ o => MayEmitHeap<M>(saves, site, stack, spans, values, d, s0, prog, file, facts,
                    heap, after, match o {
                        None => None,
                        Some(source) => match store_base_plain(base.register) {
                            False => None,
                            True => Some(Emitted(At(prog, 0, asm_word_store(WordStore(base.register, source.register))), file, later, names)),
                        },
                    }) {
                None => trivial,
                Some(source) => match plain: store_base_plain(base.register) {
                    False => trivial,
                    True => store_ref_emits<M>(saves, site, laid, stack, top, spans, loan, blocks, lent, values, d, s0, prog, file, place, value,
                        base.register, source.register, base.at, source.at, plain, later, names, heap, after),
                },
            }),
        }),
    }
}

// ---------------------------------------------------------------------------
// A node, and a leaf of them

// A node's meaning at the valuation, from the heap `before` to `after`.
fn Instr::Holds(self instr: Instr, spans: Spans, blocks: Blocks, values: Valuation(), before, after: Heap) → Type {
    match instr {
        Compute(node) => NodeHolds(values, node) ∧ (after = before),
        Load(bytes, view, output, place) => Loads(spans, values, before, bytes, view, output, place) ∧ (after = before),
        Store(bytes, view, place, value) => Stores(spans, values, blocks, before, after, bytes, view, place, value),
        LoadRef(output, place) => LoadsRef(spans, values, before, output, place) ∧ (after = before),
        StoreRef(place, value) => StoresRef(spans, values, blocks, before, after, place, value),
        Offset(output, place, amount) => Offsets(spans, values, output, place, amount) ∧ (after = before),
        Copy(target, source, length) => Exists<Loc>(λ to => (values(64, target) = to.address(spans)) ∧ Exists<Loc>(λ from =>
            (values(64, source) = from.address(spans)) ∧ (before.copy(blocks.written, to, from, values(64, length).toNat()) = Some(after)))),
    }
}

// A node's code: a word node as FunctionIR's (an offset is its `ADD`),
// and a memory node as one instruction. A typed copy is not lowered yet.
fn Instr::emit(self instr: Instr, saves: Nat, prog: Prog, file: File, placement: List<Place>, names: Nat) → Option<Emitted> {
    match instr {
        Compute(node) => emit_word_nodes(saves, prog, file, [node], placement, names),
        Load(bytes, view, output, place) => emit_load_at(saves, prog, file, view, output, place, bytes, placement, names),
        Store(bytes, view, place, value) => emit_store_at(prog, file, view, place, value, bytes, placement, names),
        LoadRef(output, place) => emit_load_ref_at(saves, prog, file, output, place, placement, names),
        StoreRef(place, value) => emit_store_ref_at(prog, file, place, value, placement, names),
        Offset(output, place, amount) => emit_word_nodes(saves, prog, file, [Add(64, output, place, amount)], placement, names),
        Copy(_, _, _) => None,
    }
}

// The node's code meets its meaning.
theorem Instr::emit_emits<M>(self instr: Instr, saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data),
    top: Nat, spans: Spans, loan: Loan<M>(site.fetch, site.data, stack, top, spans), blocks: Blocks, lent: blocks.Lent(spans), values: Valuation(),
    d: Nat, s0: MachineState<M>, prog: Prog, file: File, placement: List<Place>, names: Nat, before, after: Heap):
    MayEmitHeap<M>(saves, site, stack, spans, values, d, s0, prog, file, instr.Holds(spans, blocks, values, before, after), before, after,
        instr.emit(saves, prog, file, placement, names)) {
    let mem = heap_in<M>(site.data, spans);
    match instr {
        Compute(node) => may_emit_by_still<M, Heap>(saves, site, stack, spans, mem, values, d, s0, prog, file,
            NodeHolds(values, node) ∧ (after = before), before, after, λ h => h.right, emit_word_nodes(saves, prog, file, [node], placement, names),
            may_emit_by_weaken<M, Heap>(saves, site, stack, spans, mem, values, d, s0, prog, file, NodesHold(values, [node]),
                NodeHolds(values, node) ∧ (after = before), λ h => ⟨h.left, trivial⟩, before, before,
                emit_word_nodes(saves, prog, file, [node], placement, names),
                emit_word_nodes_emits<M>(saves, site, laid, stack, spans, values, d, s0, prog, file, [node], placement, names, before))),
        Load(bytes, view, output, place) => may_emit_by_still<M, Heap>(saves, site, stack, spans, mem, values, d, s0, prog, file,
            Loads(spans, values, before, bytes, view, output, place) ∧ (after = before), before, after, λ h => h.right,
            emit_load_at(saves, prog, file, view, output, place, bytes, placement, names),
            may_emit_by_weaken<M, Heap>(saves, site, stack, spans, mem, values, d, s0, prog, file, Loads(spans, values, before, bytes, view, output, place),
                Loads(spans, values, before, bytes, view, output, place) ∧ (after = before), λ h => h.left, before, before,
                emit_load_at(saves, prog, file, view, output, place, bytes, placement, names),
                emit_load_at_emits<M>(saves, site, laid, stack, top, spans, loan, values, d, s0, prog, file, view, output, place, bytes, placement, names,
                    before))),
        Store(bytes, view, place, value) => emit_store_at_emits<M>(saves, site, laid, stack, top, spans, loan, blocks, lent, values, d, s0, prog, file, view, place,
            value, bytes, placement, names, before, after),
        LoadRef(output, place) => may_emit_by_still<M, Heap>(saves, site, stack, spans, mem, values, d, s0, prog, file,
            LoadsRef(spans, values, before, output, place) ∧ (after = before), before, after, λ h => h.right,
            emit_load_ref_at(saves, prog, file, output, place, placement, names),
            may_emit_by_weaken<M, Heap>(saves, site, stack, spans, mem, values, d, s0, prog, file, LoadsRef(spans, values, before, output, place),
                LoadsRef(spans, values, before, output, place) ∧ (after = before), λ h => h.left, before, before,
                emit_load_ref_at(saves, prog, file, output, place, placement, names),
                emit_load_ref_at_emits<M>(saves, site, laid, stack, top, spans, loan, values, d, s0, prog, file, output, place, placement, names, before))),
        StoreRef(place, value) => emit_store_ref_at_emits<M>(saves, site, laid, stack, top, spans, loan, blocks, lent, values, d, s0, prog, file, place,
            value, placement, names, before, after),
        Offset(output, place, amount) => may_emit_by_still<M, Heap>(saves, site, stack, spans, mem, values, d, s0, prog, file,
            Offsets(spans, values, output, place, amount) ∧ (after = before), before, after, λ h => h.right,
            emit_word_nodes(saves, prog, file, [Add(64, output, place, amount)], placement, names),
            may_emit_by_weaken<M, Heap>(saves, site, stack, spans, mem, values, d, s0, prog, file, NodesHold(values, [Add(64, output, place, amount)]),
                Offsets(spans, values, output, place, amount) ∧ (after = before),
                λ h => ⟨offset_adds(spans, values, output, place, amount, h.left), trivial⟩, before, before,
                emit_word_nodes(saves, prog, file, [Add(64, output, place, amount)], placement, names),
                emit_word_nodes_emits<M>(saves, site, laid, stack, spans, values, d, s0, prog, file, [Add(64, output, place, amount)], placement, names,
                    before))),
        Copy(_, _, _) => trivial,
    }
}

// A leaf's meaning: its nodes one after another, each from the heap the
// one before left.
fn InstrsHold(spans: Spans, blocks: Blocks, values: Valuation(), instrs: List<Instr>, before, after: Heap) → Type {
    match instrs {
        Nil => after = before,
        Cons(instr, rest) => Exists<Heap>(λ mid => instr.Holds(spans, blocks, values, before, mid) ∧ InstrsHold(spans, blocks, values, rest, mid, after)),
    }
}

// A leaf's code: its nodes' one after another.
fn emit_instrs(saves: Nat, prog: Prog, file: File, instrs: List<Instr>, placement: List<Place>, names: Nat) → Option<Emitted> {
    match instrs {
        Nil => Some(Emitted(prog, file, placement, names)),
        Cons(instr, rest) => match instr.emit(saves, prog, file, placement, names) {
            None => None,
            Some(first) => emit_instrs(saves, first.prog, first.file, rest, first.placement, first.names),
        },
    }
}

// No code: where the facts say the state is the same, the run is empty.
theorem emits_none<M, S>(saves: Nat, site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, Mem: S → M → Type, values: Valuation(),
    d: Nat, s0: MachineState<M>, prog: Prog, file: File, placement: List<Place>, names: Nat, before, after: S):
    EmitsBy<M, S>(saves, site, stack, spans, Mem, values, d, s0, prog, file, after = before, before, after, Emitted(prog, file, placement, names)) {
    ⟨prog.within_self(), λ within => site.moves_refl(stack.writes, prog_len(prog),
        λ (s: MachineState<M>) => (file.Represents(values, s.gprs) ∧ (after = before)) ∧ stack.TrailedBy(saves, spans, Mem, d, s0, before, s),
        λ (t: MachineState<M>) => file.Represents(values, t.gprs) ∧ stack.TrailedBy(saves, spans, Mem, d, s0, after, t),
        λ s held => ⟨held.left.left, j(sym(held.left.right), λ a _ => stack.TrailedBy(saves, spans, Mem, d, s0, a, s), held.right)⟩)⟩
}

// A leaf's code meets its meaning: each node's theorem, composed by the
// generic sequence (`may_emit_by_seq`).
theorem emit_instrs_emits<M>(saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data),
    top: Nat, spans: Spans, loan: Loan<M>(site.fetch, site.data, stack, top, spans), blocks: Blocks, lent: blocks.Lent(spans), values: Valuation(),
    d: Nat, s0: MachineState<M>, instrs: List<Instr>): (prog: Prog) → (file: File) → (placement: List<Place>) → (names: Nat) → (before, after: Heap) →
    MayEmitHeap<M>(saves, site, stack, spans, values, d, s0, prog, file, InstrsHold(spans, blocks, values, instrs, before, after), before, after,
        emit_instrs(saves, prog, file, instrs, placement, names)) {
    let mem = heap_in<M>(site.data, spans);
    match instrs {
        Nil => λ prog file placement names before after =>
            emits_none<M, Heap>(saves, site, stack, spans, mem, values, d, s0, prog, file, placement, names, before, after),
        Cons(instr, rest) => λ prog file placement names before after =>
            (match instr.emit(saves, prog, file, placement, names) as λ o =>
                ((mid: Heap) → MayEmitHeap<M>(saves, site, stack, spans, values, d, s0, prog, file, instr.Holds(spans, blocks, values, before, mid), before,
                    mid, o)) →
                MayEmitHeap<M>(saves, site, stack, spans, values, d, s0, prog, file, InstrsHold(spans, blocks, values, Cons(instr, rest), before, after),
                    before, after, match o { None => None, Some(first) => emit_instrs(saves, first.prog, first.file, rest, first.placement, first.names) }) {
                None => λ _ => trivial,
                Some(first) => λ first_emits => may_emit_by_seq<M, Heap>(saves, site, stack, spans, mem, values, d, s0, prog, file,
                    λ (mid: Heap) => instr.Holds(spans, blocks, values, before, mid), λ (mid: Heap) => InstrsHold(spans, blocks, values, rest, mid, after),
                    before, after, first, first_emits, emit_instrs(saves, first.prog, first.file, rest, first.placement, first.names),
                    λ mid => emit_instrs_emits<M>(saves, site, laid, stack, top, spans, loan, blocks, lent, values, d, s0, rest, first.prog, first.file,
                        first.placement, first.names, mid, after)),
            })(λ mid => instr.emit_emits<M>(saves, site, laid, stack, top, spans, loan, blocks, lent, values, d, s0, prog, file, placement, names, before,
                mid)),
    }
}

// ---------------------------------------------------------------------------
// The register invariant at the lowered values

// An id of its kind lowers, under the valuation, as the run's locals hold
// it: a word at every width as itself, a reference as its target's
// address. The registers then hold what the file says of the valuation
// (`File::Represents`), with no mention of kinds.
fn Typed::Lowers(self v: Typed, spans: Spans, values: Valuation(), l: Locals) → Type {
    match v.kind {
        WordKind => (w: Nat) → values(w, v.id) = l.words(w, v.id),
        RefKind => Exists<Loc>(λ loc => (l.refs(v.id) = Some(loc)) ∧ (values(64, v.id) = loc.address(spans))),
    }
}

// The valuation agrees with the locals at every id validity has bound.
fn Locals::Agrees(self l: Locals, spans: Spans, values: Valuation(), kinds: List<Typed>) → Type {
    match kinds { Nil => True, Cons(v, rest) => v.Lowers(spans, values, l) ∧ l.Agrees(spans, values, rest) }
}

theorem ValueKind::same_sound(self a: ValueKind, b: ValueKind, same: a.same(b) = True): a = b {
    match a {
        WordKind => match b { WordKind => refl, RefKind => absurd(same) },
        RefKind => match b { WordKind => absurd(same), RefKind => refl },
    }
}

// What an id is bound at, the first entry for it says, and the locals
// agree there.
theorem Locals::agrees_at(self l: Locals, spans: Spans, values: Valuation(), id: Nat, kind: ValueKind, kinds: List<Typed>):
    has_kind(kinds, id, kind) = True → l.Agrees(spans, values, kinds) → Typed(id, kind).Lowers(spans, values, l) {
    match kinds {
        Nil => λ never _ => absurd(never),
        Cons(v, rest) => λ has agrees => match s: v.id.same(id) {
            True => {
                let same_id: (v.id = id) = v.id.same_sound(id, s);
                let same_kind: (v.kind = kind) = v.kind.same_sound(kind, has);
                j(same_id, λ x _ => Typed(x, kind).Lowers(spans, values, l),
                    j(same_kind, λ k _ => Typed(v.id, k).Lowers(spans, values, l), agrees.left))
            },
            False => Locals::agrees_at(l, spans, values, id, kind, rest, has, agrees.right),
        },
    }
}

// A word read at every width; a reference read as its location.
theorem Locals::agrees_word(self l: Locals, spans: Spans, values: Valuation(), kinds: List<Typed>, id: Nat, has: has_kind(kinds, id, WordKind) = True,
    agrees: l.Agrees(spans, values, kinds)): (w: Nat) → values(w, id) = l.words(w, id) {
    l.agrees_at(spans, values, id, WordKind, kinds, has, agrees)
}

theorem Locals::agrees_ref(self l: Locals, spans: Spans, values: Valuation(), kinds: List<Typed>, id: Nat, has: has_kind(kinds, id, RefKind) = True,
    agrees: l.Agrees(spans, values, kinds)): Exists<Loc>(λ loc => (l.refs(id) = Some(loc)) ∧ (values(64, id) = loc.address(spans))) {
    l.agrees_at(spans, values, id, RefKind, kinds, has, agrees)
}

// An id bound is had at its kind.
theorem bind_kind_has(v: Typed): (kinds, after: List<Typed>) → bind_kind(kinds, v) = Some(after) → has_kind(after, v.id, v.kind) = True {
    λ kinds after bound => (match kind_of(kinds, v.id) as λ o => kind_of(kinds, v.id) = o →
            (match o { None => Some(Cons(v, kinds)), Some(k) => match k.same(v.kind) { True => Some(kinds), False => None } }) = Some(after) →
            has_kind(after, v.id, v.kind) = True {
        None => λ _ some => j(Option::some_inj(Cons(v, kinds), after, some), λ a _ => has_kind(a, v.id, v.kind) = True,
            j(sym(v.id.same_self()), λ b _ => (match match b { True => Some(v.kind), False => kind_of(kinds, v.id) } { None => False, Some(k) => k.same(v.kind) }) = True,
                match v.kind { WordKind => refl, RefKind => refl })),
        Some(k) => λ found => match s: k.same(v.kind) {
            True => λ some => j(Option::some_inj(kinds, after, some), λ a _ => has_kind(a, v.id, v.kind) = True,
                j(sym(found), λ o _ => (match o { None => False, Some(k2) => k2.same(v.kind) }) = True, s)),
            False => λ never => absurd(never),
        },
    })(refl, bound)
}

// Every id a word node reads is a word.
theorem words_bound_mem(kinds: List<Typed>, ids: List<Nat>): words_bound(kinds, ids) = True → (id: Nat) → Mem(id, ids) →
    has_kind(kinds, id, WordKind) = True {
    match ids {
        Nil => λ _ id never => false_elim(never),
        Cons(first, rest) => λ bound id m => {
            let parts = Bool::and_true_parts(has_kind(kinds, first, WordKind), words_bound(kinds, rest), bound);
            match m {
                Inl(here) => j(sym(here), λ x _ => has_kind(kinds, x, WordKind) = True, parts.left),
                Inr(later) => words_bound_mem(kinds, rest, parts.right, id, later),
            }
        },
    }
}

// ---------------------------------------------------------------------------
// A node's run is its meaning at the valuation
//
// Where the valuation agrees with the locals at the kinds bound before a
// node and with those after it at the kinds it binds, the node's step is
// its `Instr::Holds`: validity's kinds are what make a word node's operands
// the valuation's, and a reference's address the register's word.

theorem compute_holds(node: Node, blocks: Blocks, spans: Spans, values: Valuation(), kinds, bound: List<Typed>, c, after: Config,
    checked: Compute(node).check(kinds) = Some(bound), stepped: Compute(node).step(blocks, c) = Some(after),
    agrees: c.locals.Agrees(spans, values, kinds), later: after.locals.Agrees(spans, values, bound)):
    NodeHolds(values, node) ∧ (after.memory = c.memory) {
    let out = node_output(node).id;
    let made = Some(Config(Locals(node.step(c.locals.words), c.locals.refs), c.memory, c.io));
    match ok: node.pure() && words_bound(kinds, function_ir_eval::Node::reads(node)) {
        False => absurd(j(ok, λ v _ => (match v { False => None, True => bind_kind(kinds, word_id(out)) }) = Some(bound), checked)),
        True => match def: node.pure() && node.defined(c.locals.words) {
            False => absurd(j(def, λ v _ => (match v { False => None, True => made }) = Some(after), stepped)),
            True => {
                let ran: (made = Some(after)) = j(def, λ v _ => (match v { False => None, True => made }) = Some(after), stepped);
                let e: (Config(Locals(node.step(c.locals.words), c.locals.refs), c.memory, c.io) = after) = Option::some_inj(
                    Config(Locals(node.step(c.locals.words), c.locals.refs), c.memory, c.io), after, ran);
                let bind: (bind_kind(kinds, word_id(out)) = Some(bound)) =
                    j(ok, λ v _ => (match v { False => None, True => bind_kind(kinds, word_id(out)) }) = Some(bound), checked);
                let at_after = after.locals.agrees_word(spans, values, bound, out, bind_kind_has(word_id(out), kinds, bound, bind), later);
                let reads = Bool::and_true_parts(node.pure(), words_bound(kinds, function_ir_eval::Node::reads(node)), ok).right;
                let at_output = λ (w: Nat) => trans(at_after(w), trans(cong_fn<Config, BitVec(w)>(λ x => x.locals.words(w, out), sym(e)),
                    Valuation::set_here(c.locals.words, out, node.value(c.locals.words), w)));
                let kept = λ (w: Nat) (id: Nat) (m: Mem(id, function_ir_eval::Node::reads(node))) =>
                    c.locals.agrees_word(spans, values, kinds, id, words_bound_mem(kinds, function_ir_eval::Node::reads(node), reads, id, m), agrees, w);
                let defined = is_true_of_eq(node.defined(c.locals.words), Bool::and_true_parts(node.pure(), node.defined(c.locals.words), def).right);
                ⟨node.holds_of(c.locals.words, values, Nil, at_output, kept, defined), cong_fn<Config, Heap>(λ x => x.memory, sym(e))⟩
            },
        },
    }
}

// A reference read where validity says one is bound: the valuation's word
// at it is the address of the location the locals hold.
theorem Locals::ref_at(self l: Locals, spans: Spans, values: Valuation(), kinds: List<Typed>, id: Nat, has: has_kind(kinds, id, RefKind) = True,
    agrees: l.Agrees(spans, values, kinds), loc: Loc, held: l.refs(id) = Some(loc)): values(64, id) = loc.address(spans) {
    let got = l.agrees_ref(spans, values, kinds, id, has, agrees);
    let same: (got.witness = loc) = Option::some_inj(got.witness, loc, trans(sym(got.proof.left), held));
    j(same, λ x _ => values(64, id) = x.address(spans), got.proof.right)
}

// A word bound by a node: the valuation's word at it is what the node set.
theorem Locals::word_set(self l: Locals, spans: Spans, values: Valuation(), bound: List<Typed>, out: Nat, has: has_kind(bound, out, WordKind) = True,
    agrees: l.Agrees(spans, values, bound), before: Locals, word: BitVec(64), set: before.set_word(out, word_value(word)) = l): values(64, out) = word {
    trans(l.agrees_word(spans, values, bound, out, has, agrees, 64),
        trans(cong_fn<Locals, BitVec(64)>(λ x => x.words(64, out), sym(set)), Valuation::set_here(before.words, out, word_value(word), 64)))
}

// A loaded word held at its view's kind (`view_ok`): at 64 the word itself;
// at 32 its view widened back, which is the word, since it was read from
// four bytes or fewer.
theorem load_view_held(values: Valuation(), bytes, view, output: Nat, list: List<BitVec(8)>, len: list.len() = bytes,
    viewed: view_ok(bytes, view) = True, at_width: (w: Nat) → values(w, output) = word_value(word_of_bytes(list))(w)):
    Held(output, view_kind(view)).Rep(values, word_of_bytes(list)) {
    (match view.same(64) as λ b => (match b { True => True, False => view.same(32) && bytes.leb(4) }) = True →
            Held(output, match b { True => Word, False => Narrow(view) }).Rep(values, word_of_bytes(list)) {
        True => λ _ => at_width(64),
        False => λ narrow => {
            let parts = Bool::and_true_parts(view.same(32), bytes.leb(4), narrow);
            let is32: (view = 32) = view.same_sound(32, parts.left);
            let few: (bytes <= 4) = bytes.leb_sound(4, is_true_of_eq(bytes.leb(4), parts.right));
            j(sym(is32), λ v _ => values(v, output).resize(64) = word_of_bytes(list),
                trans(cong_fn<BitVec(32), BitVec(64)>(λ y => y.resize(64), at_width(32)), word_of_bytes_round(list, omega(len, few))))
        },
    })(viewed)
}

theorem load_holds(bytes, view, output, place: Nat, blocks: Blocks, spans: Spans, values: Valuation(), kinds, bound: List<Typed>, c, after: Config,
    checked: Instr::Load(bytes, view, output, place).check(kinds) = Some(bound),
    stepped: Instr::Load(bytes, view, output, place).step(blocks, c) = Some(after),
    agrees: c.locals.Agrees(spans, values, kinds), later: after.locals.Agrees(spans, values, bound)):
    Loads(spans, values, c.memory, bytes, view, output, place) ∧ (after.memory = c.memory) {
    let first = Option::and_then_some(c.locals.refs(place), λ (loc: Loc) =>
        c.memory.load(loc, bytes).and_then(λ (x: BitVec(64)) => Some(Config(c.locals.set_word(output, word_value(x)), c.memory, c.io))), after, stepped);
    let loc = first.witness;
    let second = Option::and_then_some(c.memory.load(loc, bytes), λ (x: BitVec(64)) => Some(Config(c.locals.set_word(output, word_value(x)), c.memory, c.io)),
        after, first.proof.right);
    let x = second.witness;
    let e: (Config(c.locals.set_word(output, word_value(x)), c.memory, c.io) = after) =
        Option::some_inj(Config(c.locals.set_word(output, word_value(x)), c.memory, c.io), after, second.proof.right);
    let read = c.memory.load_some(loc, bytes, x, second.proof.left);
    match ok: access_ok(bytes, view) && has_kind(kinds, place, RefKind) {
        False => absurd(j(ok, λ v _ => (match v { False => None, True => bind_kind(kinds, word_id(output)) }) = Some(bound), checked)),
        True => {
            let bind: (bind_kind(kinds, word_id(output)) = Some(bound)) =
                j(ok, λ v _ => (match v { False => None, True => bind_kind(kinds, word_id(output)) }) = Some(bound), checked);
            let parts = Bool::and_true_parts(access_ok(bytes, view), has_kind(kinds, place, RefKind), ok);
            let viewed = Bool::and_true_parts(width_ok(bytes), view_ok(bytes, view), parts.left).right;
            let set: (c.locals.set_word(output, word_value(x)) = after.locals) = cong_fn<Config, Locals>(λ y => y.locals, e);
            let list = read.witness;
            let at_width = λ (w: Nat) => trans(
                after.locals.agrees_word(spans, values, bound, output, bind_kind_has(word_id(output), kinds, bound, bind), later, w),
                trans(cong_fn<Locals, BitVec(w)>(λ y => y.words(w, output), sym(set)), Valuation::set_here(c.locals.words, output, word_value(x), w)));
            let held = load_view_held(values, bytes, view, output, list, c.memory.read_bytes_len(loc, bytes, list, read.proof.left), viewed,
                λ w => j(sym(read.proof.right), λ y _ => values(w, output) = word_value(y)(w), at_width(w)));
            ⟨Exists(loc, ⟨c.locals.ref_at(spans, values, kinds, place, parts.right, agrees, loc, first.proof.left),
                Exists(list, ⟨read.proof.left, held⟩)⟩),
             cong_fn<Config, Heap>(λ y => y.memory, sym(e))⟩
        },
    }
}

theorem store_holds(bytes, view, place, value: Nat, blocks: Blocks, spans: Spans, values: Valuation(), kinds, bound: List<Typed>, c, after: Config,
    checked: Instr::Store(bytes, view, place, value).check(kinds) = Some(bound),
    stepped: Instr::Store(bytes, view, place, value).step(blocks, c) = Some(after),
    agrees: c.locals.Agrees(spans, values, kinds)): Stores(spans, values, blocks, c.memory, after.memory, bytes, view, place, value) {
    let piece = λ (w: BitVec(64)) => Piece::plain(low_bytes(bytes, w));
    let first = Option::and_then_some(c.locals.refs(place), λ (loc: Loc) =>
        c.memory.put(blocks.written, loc, piece(c.locals.view(view, value))).and_then(λ (m: Heap) => Some(Config(c.locals, m, c.io))), after, stepped);
    let loc = first.witness;
    let second = Option::and_then_some(c.memory.put(blocks.written, loc, piece(c.locals.view(view, value))), λ (m: Heap) => Some(Config(c.locals, m, c.io)),
        after, first.proof.right);
    let e: (Config(c.locals, second.witness, c.io) = after) = Option::some_inj(Config(c.locals, second.witness, c.io), after, second.proof.right);
    let ok = access_ok(bytes, view) && (has_kind(kinds, place, RefKind) && has_kind(kinds, value, WordKind));
    match yes: ok {
        False => absurd(j(yes, λ v _ => (match v { False => None, True => Some(kinds) }) = Some(bound), checked)),
        True => {
            let parts = Bool::and_true_parts(has_kind(kinds, place, RefKind), has_kind(kinds, value, WordKind),
                Bool::and_true_parts(access_ok(bytes, view), has_kind(kinds, place, RefKind) && has_kind(kinds, value, WordKind), yes).right);
            let word: (view_word(values, view, value) = c.locals.view(view, value)) = view_word_agrees(values, c.locals.words, view, value,
                λ w => c.locals.agrees_word(spans, values, kinds, value, parts.right, agrees, w));
            Exists(loc, ⟨c.locals.ref_at(spans, values, kinds, place, parts.left, agrees, loc, first.proof.left),
                j(sym(word), λ w _ => c.memory.put(blocks.written, loc, piece(w)) = Some(after.memory),
                    trans(second.proof.left, cong_fn<Config, Option<Heap>>(λ y => Some(y.memory), e)))⟩)
        },
    }
}

// A reference bound by a node: the valuation's word at it is the address
// of what the node set.
theorem Locals::ref_set(self l: Locals, spans: Spans, values: Valuation(), bound: List<Typed>, out: Nat, has: has_kind(bound, out, RefKind) = True,
    agrees: l.Agrees(spans, values, bound), before: Locals, target: Loc, set: before.set_ref(out, target) = l): values(64, out) = target.address(spans) {
    l.ref_at(spans, values, bound, out, has, agrees, target,
        trans(cong_fn<Locals, Option<Loc>>(λ x => x.refs(out), sym(set)),
            j(sym(out.same_self()), λ b _ => (match b { True => Some(target), False => before.refs(out) }) = Some(target), refl)))
}

theorem load_ref_holds(output, place: Nat, blocks: Blocks, spans: Spans, values: Valuation(), kinds, bound: List<Typed>, c, after: Config,
    checked: Instr::LoadRef(output, place).check(kinds) = Some(bound), stepped: Instr::LoadRef(output, place).step(blocks, c) = Some(after),
    agrees: c.locals.Agrees(spans, values, kinds), later: after.locals.Agrees(spans, values, bound)):
    LoadsRef(spans, values, c.memory, output, place) ∧ (after.memory = c.memory) {
    let first = Option::and_then_some(c.locals.refs(place), λ (loc: Loc) =>
        c.memory.load_ref(loc).and_then(λ (target: Loc) => Some(Config(c.locals.set_ref(output, target), c.memory, c.io))), after, stepped);
    let loc = first.witness;
    let second = Option::and_then_some(c.memory.load_ref(loc), λ (target: Loc) => Some(Config(c.locals.set_ref(output, target), c.memory, c.io)),
        after, first.proof.right);
    let target = second.witness;
    let e: (Config(c.locals.set_ref(output, target), c.memory, c.io) = after) =
        Option::some_inj(Config(c.locals.set_ref(output, target), c.memory, c.io), after, second.proof.right);
    match ok: has_kind(kinds, place, RefKind) {
        False => absurd(j(ok, λ v _ => (match v { False => None, True => bind_kind(kinds, ref_id(output)) }) = Some(bound), checked)),
        True => {
            let bind: (bind_kind(kinds, ref_id(output)) = Some(bound)) =
                j(ok, λ v _ => (match v { False => None, True => bind_kind(kinds, ref_id(output)) }) = Some(bound), checked);
            ⟨Exists(loc, ⟨c.locals.ref_at(spans, values, kinds, place, ok, agrees, loc, first.proof.left),
                Exists(target, ⟨second.proof.left, after.locals.ref_set(spans, values, bound, output, bind_kind_has(ref_id(output), kinds, bound, bind),
                    later, c.locals, target, cong_fn<Config, Locals>(λ y => y.locals, e))⟩)⟩),
             cong_fn<Config, Heap>(λ y => y.memory, sym(e))⟩
        },
    }
}

theorem store_ref_holds(place, value: Nat, blocks: Blocks, spans: Spans, values: Valuation(), kinds, bound: List<Typed>, c, after: Config,
    checked: Instr::StoreRef(place, value).check(kinds) = Some(bound), stepped: Instr::StoreRef(place, value).step(blocks, c) = Some(after),
    agrees: c.locals.Agrees(spans, values, kinds)): StoresRef(spans, values, blocks, c.memory, after.memory, place, value) {
    let first = Option::and_then_some(c.locals.refs(place), λ (loc: Loc) => c.locals.refs(value).and_then(λ (target: Loc) =>
        c.memory.put(blocks.written, loc, Piece::reference(target)).and_then(λ (m: Heap) => Some(Config(c.locals, m, c.io)))), after, stepped);
    let loc = first.witness;
    let second = Option::and_then_some(c.locals.refs(value), λ (target: Loc) =>
        c.memory.put(blocks.written, loc, Piece::reference(target)).and_then(λ (m: Heap) => Some(Config(c.locals, m, c.io))), after, first.proof.right);
    let target = second.witness;
    let third = Option::and_then_some(c.memory.put(blocks.written, loc, Piece::reference(target)), λ (m: Heap) => Some(Config(c.locals, m, c.io)),
        after, second.proof.right);
    let e: (Config(c.locals, third.witness, c.io) = after) = Option::some_inj(Config(c.locals, third.witness, c.io), after, third.proof.right);
    match ok: has_kind(kinds, place, RefKind) && has_kind(kinds, value, RefKind) {
        False => absurd(j(ok, λ v _ => (match v { False => None, True => Some(kinds) }) = Some(bound), checked)),
        True => {
            let parts = Bool::and_true_parts(has_kind(kinds, place, RefKind), has_kind(kinds, value, RefKind), ok);
            Exists(loc, ⟨c.locals.ref_at(spans, values, kinds, place, parts.left, agrees, loc, first.proof.left),
                Exists(target, ⟨c.locals.ref_at(spans, values, kinds, value, parts.right, agrees, target, second.proof.left),
                    trans(third.proof.left, cong_fn<Config, Option<Heap>>(λ y => Some(y.memory), e))⟩)⟩)
        },
    }
}

theorem offset_holds(output, place, amount: Nat, blocks: Blocks, spans: Spans, values: Valuation(), kinds, bound: List<Typed>, c, after: Config,
    checked: Instr::Offset(output, place, amount).check(kinds) = Some(bound),
    stepped: Instr::Offset(output, place, amount).step(blocks, c) = Some(after),
    agrees: c.locals.Agrees(spans, values, kinds), later: after.locals.Agrees(spans, values, bound)):
    Offsets(spans, values, output, place, amount) ∧ (after.memory = c.memory) {
    let moved = λ (loc: Loc) (a: BitVec(64)) => Loc(loc.block, loc.offset + a.toNat());
    let first = Option::and_then_some(c.locals.refs(place), λ (loc: Loc) =>
        Some(Config(c.locals.set_ref(output, moved(loc, c.locals.word(amount))), c.memory, c.io)), after, stepped);
    let loc = first.witness;
    let e: (Config(c.locals.set_ref(output, moved(loc, c.locals.word(amount))), c.memory, c.io) = after) =
        Option::some_inj(Config(c.locals.set_ref(output, moved(loc, c.locals.word(amount))), c.memory, c.io), after, first.proof.right);
    match ok: has_kind(kinds, place, RefKind) && has_kind(kinds, amount, WordKind) {
        False => absurd(j(ok, λ v _ => (match v { False => None, True => bind_kind(kinds, ref_id(output)) }) = Some(bound), checked)),
        True => {
            let bind: (bind_kind(kinds, ref_id(output)) = Some(bound)) =
                j(ok, λ v _ => (match v { False => None, True => bind_kind(kinds, ref_id(output)) }) = Some(bound), checked);
            let parts = Bool::and_true_parts(has_kind(kinds, place, RefKind), has_kind(kinds, amount, WordKind), ok);
            let word: (values(64, amount) = c.locals.word(amount)) = c.locals.agrees_word(spans, values, kinds, amount, parts.right, agrees, 64);
            let at: (values(64, output) = moved(loc, c.locals.word(amount)).address(spans)) =
                after.locals.ref_set(spans, values, bound, output, bind_kind_has(ref_id(output), kinds, bound, bind), later, c.locals,
                    moved(loc, c.locals.word(amount)), cong_fn<Config, Locals>(λ y => y.locals, e));
            ⟨Exists(loc, ⟨c.locals.ref_at(spans, values, kinds, place, parts.left, agrees, loc, first.proof.left),
                j(sym(word), λ a _ => values(64, output) = moved(loc, a).address(spans), at)⟩),
             cong_fn<Config, Heap>(λ y => y.memory, sym(e))⟩
        },
    }
}

theorem copy_holds(target, source, length: Nat, blocks: Blocks, spans: Spans, values: Valuation(), kinds, bound: List<Typed>, c, after: Config,
    checked: Instr::Copy(target, source, length).check(kinds) = Some(bound),
    stepped: Instr::Copy(target, source, length).step(blocks, c) = Some(after), agrees: c.locals.Agrees(spans, values, kinds)):
    Instr::Copy(target, source, length).Holds(spans, blocks, values, c.memory, after.memory) {
    let n = λ (w: BitVec(64)) => w.toNat();
    let first = Option::and_then_some(c.locals.refs(target), λ (to: Loc) => c.locals.refs(source).and_then(λ (from: Loc) =>
        c.memory.copy(blocks.written, to, from, n(c.locals.word(length))).and_then(λ (m: Heap) => Some(Config(c.locals, m, c.io)))), after, stepped);
    let to = first.witness;
    let second = Option::and_then_some(c.locals.refs(source), λ (from: Loc) =>
        c.memory.copy(blocks.written, to, from, n(c.locals.word(length))).and_then(λ (m: Heap) => Some(Config(c.locals, m, c.io))), after,
        first.proof.right);
    let from = second.witness;
    let third = Option::and_then_some(c.memory.copy(blocks.written, to, from, n(c.locals.word(length))), λ (m: Heap) => Some(Config(c.locals, m, c.io)),
        after, second.proof.right);
    let e: (Config(c.locals, third.witness, c.io) = after) = Option::some_inj(Config(c.locals, third.witness, c.io), after, third.proof.right);
    match ok: has_kind(kinds, target, RefKind) && (has_kind(kinds, source, RefKind) && has_kind(kinds, length, WordKind)) {
        False => absurd(j(ok, λ v _ => (match v { False => None, True => Some(kinds) }) = Some(bound), checked)),
        True => {
            let parts = Bool::and_true_parts(has_kind(kinds, target, RefKind), has_kind(kinds, source, RefKind) && has_kind(kinds, length, WordKind), ok);
            let rest = Bool::and_true_parts(has_kind(kinds, source, RefKind), has_kind(kinds, length, WordKind), parts.right);
            let word: (values(64, length) = c.locals.word(length)) = c.locals.agrees_word(spans, values, kinds, length, rest.right, agrees, 64);
            Exists(to, ⟨c.locals.ref_at(spans, values, kinds, target, parts.left, agrees, to, first.proof.left),
                Exists(from, ⟨c.locals.ref_at(spans, values, kinds, source, rest.left, agrees, from, second.proof.left),
                    j(sym(word), λ w _ => c.memory.copy(blocks.written, to, from, n(w)) = Some(after.memory),
                        trans(third.proof.left, cong_fn<Config, Option<Heap>>(λ y => Some(y.memory), e)))⟩)⟩)
        },
    }
}

// Every node: its step, where the valuation agrees before and after, is
// its meaning.
theorem Instr::holds_of(self instr: Instr, blocks: Blocks, spans: Spans, values: Valuation(), kinds, bound: List<Typed>, c, after: Config,
    checked: instr.check(kinds) = Some(bound), stepped: instr.step(blocks, c) = Some(after),
    agrees: c.locals.Agrees(spans, values, kinds), later: after.locals.Agrees(spans, values, bound)):
    instr.Holds(spans, blocks, values, c.memory, after.memory) {
    match instr {
        Compute(node) => compute_holds(node, blocks, spans, values, kinds, bound, c, after, checked, stepped, agrees, later),
        Load(bytes, view, output, place) => load_holds(bytes, view, output, place, blocks, spans, values, kinds, bound, c, after, checked, stepped, agrees, later),
        Store(bytes, view, place, value) => store_holds(bytes, view, place, value, blocks, spans, values, kinds, bound, c, after, checked, stepped, agrees),
        LoadRef(output, place) => load_ref_holds(output, place, blocks, spans, values, kinds, bound, c, after, checked, stepped, agrees, later),
        StoreRef(place, value) => store_ref_holds(place, value, blocks, spans, values, kinds, bound, c, after, checked, stepped, agrees),
        Offset(output, place, amount) => offset_holds(output, place, amount, blocks, spans, values, kinds, bound, c, after, checked, stepped, agrees, later),
        Copy(target, source, length) => copy_holds(target, source, length, blocks, spans, values, kinds, bound, c, after, checked, stepped, agrees),
    }
}

// The valuation agrees with a leaf's run at every node: with the locals
// at the kinds bound so far, before each node and after the last.
fn RunAgrees(spans: Spans, values: Valuation(), blocks: Blocks, instrs: List<Instr>, kinds: List<Typed>, c: Config) → Type {
    match instrs {
        Nil => c.locals.Agrees(spans, values, kinds),
        Cons(instr, rest) => c.locals.Agrees(spans, values, kinds) ∧ ((bound: List<Typed>) → instr.check(kinds) = Some(bound) → (mid: Config) →
            instr.step(blocks, c) = Some(mid) → RunAgrees(spans, values, blocks, rest, bound, mid)),
    }
}

theorem run_agrees_now(spans: Spans, values: Valuation(), blocks: Blocks, instrs: List<Instr>, kinds: List<Typed>, c: Config):
    RunAgrees(spans, values, blocks, instrs, kinds, c) → c.locals.Agrees(spans, values, kinds) {
    match instrs { Nil => λ a => a, Cons(_, _) => λ a => a.left }
}

// A leaf's run, where the valuation agrees with it, is the leaf's meaning:
// the facts its code is proved under (`emit_instrs_emits`).
theorem run_instrs_holds(blocks: Blocks, spans: Spans, values: Valuation(), instrs: List<Instr>): (kinds, bound: List<Typed>) → (c, after: Config) →
    check_instrs(instrs, kinds) = Some(bound) → run_instrs(blocks, instrs, c) = Some(after) → RunAgrees(spans, values, blocks, instrs, kinds, c) →
    InstrsHold(spans, blocks, values, instrs, c.memory, after.memory) {
    match instrs {
        Nil => λ kinds bound c after checked ran agrees => cong_fn<Config, Heap>(λ y => y.memory, sym(Option::some_inj(c, after, ran))),
        Cons(instr, rest) => λ kinds bound c after checked ran agrees => {
            let checked_first = Option::and_then_some(instr.check(kinds), λ (k: List<Typed>) => check_instrs(rest, k), bound, checked);
            let ran_first = Option::and_then_some(instr.step(blocks, c), λ (m: Config) => run_instrs(blocks, rest, m), after, ran);
            let mid = ran_first.witness;
            let k = checked_first.witness;
            let next = agrees.right(k, checked_first.proof.left, mid, ran_first.proof.left);
            Exists(mid.memory, ⟨instr.holds_of(blocks, spans, values, kinds, k, c, mid, checked_first.proof.left, ran_first.proof.left, agrees.left,
                    run_agrees_now(spans, values, blocks, rest, k, mid, next)),
                run_instrs_holds(blocks, spans, values, rest, k, bound, mid, after, checked_first.proof.right, ran_first.proof.right, next)⟩)
        },
    }
}

// ---------------------------------------------------------------------------
// Calls: what a callee answers, and what its code promises

// What routine `f` answers on values and a heap: the program's meaning at
// one fuel, the world aside (`bytes_level_routines`).
fn RoutineAnswers() → Type<1> { Nat → List<Value> → Heap → Io → Answer → Type }

fn typed_ids(vs: List<Typed>) → List<Nat> { match vs { Nil => Nil, Cons(v, rest) => Cons(v.id, typed_ids(rest)) } }

// A routine's words as its code answers them: the first in RAX, the rest in
// `answer_registers()`. One that answers none answers zero in RAX, so that
// every call has a word there (FunctionIR's call and function theorems are
// stated with one).
fn answer_head(words: List<BitVec(64)>) → BitVec(64) { match words { Nil => BitVec::zero(), Cons(w, _) => w } }

fn answer_tail(words: List<BitVec(64)>) → List<BitVec(64)> { match words { Nil => Nil, Cons(_, rest) => rest } }

// Where a call's answer lands: its first result's id, or `spare` (an id the
// scope never binds, zero in its valuation) where it has none; and the rest.
fn call_result(results: List<Typed>, spare: Nat) → Nat { match results { Nil => spare, Cons(v, _) => v.id } }

fn call_also(results: List<Typed>) → List<Nat> { match results { Nil => Nil, Cons(_, rest) => typed_ids(rest) } }

// A call at the valuation: the arguments `args` are the words at its
// arguments' ids, lowered, the answer `a`'s words land where the call says,
// and the heap after it is the answer's.
fn CallLands(spans: Spans, values: Valuation(), spare: Nat, arguments, results: List<Typed>, args: List<Value>, a: Answer, after: Heap) → Type {
    (lower_values(spans, args) = words_of(values, typed_ids(arguments))) ∧
        (((answer_head(lower_values(spans, a.words)) = values(64, call_result(results, spare))) ∧
            (answer_tail(lower_values(spans, a.words)) = words_of(values, call_also(results)))) ∧ (a.heap = after))
}

// Routine `f` entered on `args` over `heap` at stack offset `i`: the
// arguments passed lowered, room below for its frames, the lending's words
// above, and the heap injected.
fn RoutinePre<M>(site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, rooms: Nat → Nat, top, f: Nat, args: List<Value>,
    heap: Heap) → Nat → MachineState<M> → Type {
    λ i s => (stack.Passed(lower_values(spans, args), i, s) ∧ (rooms(f) <= i)) ∧ ((i + 8 <= top) ∧ Injected<M>(site.data, spans, heap, s.memory))
}

// And returned with `a`: its words in the answer registers, the callee-saved
// registers kept, its stores inside the lending, and its heap injected.
fn RoutinePost<M>(site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, a: Answer) → Nat → MachineState<M> → MachineState<M> → Type {
    λ i s t => Answered(answer_head(lower_values(spans, a.words)), answer_tail(lower_values(spans, a.words)), t.gprs) ∧
        (Kept(callee_kept(), s.gprs, t.gprs) ∧ (stack.WroteIn(i, spans, s.memory, t.memory) ∧ Injected<M>(site.data, spans, a.heap, t.memory)))
}

// The same with the world: entered in `io`, returned in the answer's.
fn RoutinePreNow<M>(site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, rooms: Nat → Nat, top, f: Nat, args: List<Value>,
    heap: Heap, io: Io) → Nat → Running<M, Io> → Type {
    λ (i: Nat) (s: Running<M, Io>) => RoutinePre<M>(site, stack, spans, rooms, top, f, args, heap)(i, s.state) ∧ ((s.io = io) ∧ s.io.Answerable())
}

fn RoutinePostNow<M>(site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, a: Answer) → Nat → Running<M, Io> → Running<M, Io> → Type {
    λ (i: Nat) (s: Running<M, Io>) (t: Running<M, Io>) => RoutinePost<M>(site, stack, spans, a)(i, s.state, t.state) ∧ ((t.io = a.io) ∧ t.io.Answerable())
}

// Where the code reads a floor (`floored`), RBP holds the stack's lowest
// address.
fn Stack::Floored<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data), floored: Bool, g: Gprs) → Type {
    floored.IsTrue() → read_gpr(Rbp, g) = stack.low
}

// RBP is a callee-saved register.
theorem kept_callee_rbp(a, b: Gprs, kept: Kept(callee_kept(), a, b)): read_gpr(Rbp, b) = read_gpr(Rbp, a) { kept.right.left }

// Every routine below `bound`, wherever it answers, entered at any offset
// `i`, returns so at its label or is spent as `spends` says of it there,
// counted to the ceiling of the answer's world (§17.10): at Linux with the
// stop carried as a kernel step.
fn CalleesReturn<M>(site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, rooms: Nat → Nat, floored: Bool, top, bound: Nat,
    answers: RoutineAnswers(), spends: Nat → Nat → Running<M, Io> → Type) → Type {
    (f: Nat) → f + 1 <= bound → (args: List<Value>) → (heap: Heap) → (io: Io) → (a: Answer) → answers(f, args, heap, io, a) → (i: Nat) →
        site.ReturnsClaim(stack, site.ceiling(stack, Ceiling<M>(spends(f, i), a.io)), Ceiling<M>(spends(f, i), a.io).count(), 0,
            asm_labels(site.program)(f + 1),
            λ (k: Nat) (s: Running<M, Io>) => RoutinePreNow<M>(site, stack, spans, rooms, top, f, args, heap, io)(k, s) ∧
                ((k = i) ∧ stack.Floored(floored, s.state.gprs)),
            RoutinePostNow<M>(site, stack, spans, a))
}

// What a region's answers say of the worlds: each answer's extends the
// world its call was made in (the meaning's `HistoryExtends`).
fn AnswersExtend(answers: RoutineAnswers()) → Type {
    (f: Nat) → (args: List<Value>) → (heap: Heap) → (io: Io) → (a: Answer) → answers(f, args, heap, io, a) → Extends(a.io.past, io.past)
}

// The guarded callees of the routine being emitted, the room by routine,
// and the stop's label.
record CallGuards { at: List<Nat>, rooms: Nat → Nat, stop: Nat }

fn CallGuards::none() → CallGuards { CallGuards([], λ (_: Nat) => 0, 0) }

fn among(ids: List<Nat>, id: Nat) → Bool { match ids { Nil => False, Cons(x, rest) => x.same(id) || among(rest, id) } }

fn CallGuards::guards(self g: CallGuards, callee: Nat) → Bool { among(g.at, callee) }

// What a guarded call to `callee` needs below the frame: the table's own
// term for a call, its 24 bytes (at most two words on the stack, which is
// all FunctionIR's call passes there, and the return address) and the
// callee's room (§17.10: the call's own count of stack words is
// FunctionIR's, not visible where its CALL is proved, so the guard asks the
// most any call asks).
fn CallGuards::need(self g: CallGuards, callee: Nat) → Nat { 24 + g.rooms(callee) }

// Whether a region calls, and that every call of a routine below `bound`
// has its room and the call's 24 bytes in `avail` (FunctionIR's
// `StructuredRegion::Fits`).
fn Body::calls(self body: Body) → Bool {
    match body {
        Leaf(_) => False,
        Seq(first, rest) => first.calls() || rest.calls(),
        Branch(_, yes, no) => yes.calls() || no.calls(),
        Call(_, _, _) => True,
        Loop(_, _, inner, _, _, _) => inner.calls(),
        Sys(_) => False,
        Exit(_) => False,
    }
}

fn Body::Fits(self body: Body, rooms: Nat → Nat, bound, avail: Nat) → Type {
    match body {
        Leaf(_) => True,
        Seq(first, rest) => first.Fits(rooms, bound, avail) ∧ rest.Fits(rooms, bound, avail),
        Branch(_, yes, no) => yes.Fits(rooms, bound, avail) ∧ no.Fits(rooms, bound, avail),
        Call(callee, _, _) => callee + 1 <= bound → rooms(callee) + 24 <= avail,
        Loop(_, _, inner, _, _, _) => inner.Fits(rooms, bound, avail),
        Sys(_) => True,
        Exit(_) => True,
    }
}

// The same against the table by routine (§17.10): a guarded call asks
// nothing of the caller's room, its guard checking the callee's when it
// runs.
fn Body::FitsBy(self body: Body, guards: List<Nat>, rooms: Nat → Nat, bound, avail: Nat) → Type {
    match body {
        Leaf(_) => True,
        Seq(first, rest) => first.FitsBy(guards, rooms, bound, avail) ∧ rest.FitsBy(guards, rooms, bound, avail),
        Branch(_, yes, no) => yes.FitsBy(guards, rooms, bound, avail) ∧ no.FitsBy(guards, rooms, bound, avail),
        Call(callee, _, _) => match among(guards, callee) { True => True, False => rooms(callee) + 24 <= avail },
        Loop(_, _, inner, _, _, _) => inner.FitsBy(guards, rooms, bound, avail),
        Sys(_) => True,
        Exit(_) => True,
    }
}

// The room a region's calls ask below a frame.
fn Body::callee_room(self body: Body, rooms: Nat → Nat) → Nat {
    match body {
        Leaf(_) => 0,
        Seq(first, rest) => first.callee_room(rooms).max(rest.callee_room(rooms)),
        Branch(_, yes, no) => yes.callee_room(rooms).max(no.callee_room(rooms)),
        Call(callee, _, _) => rooms(callee) + 24,
        Loop(_, _, inner, _, _, _) => inner.callee_room(rooms),
        Sys(_) => 0,
        Exit(_) => 0,
    }
}

// A callee's claim at a kernel that resumes wherever it does.
theorem Site::returns_claim_kernel<M, W>(self site: Site<M>, stack: Stack<M>(site.fetch, site.data), kernel, wider: Kernel<M, W>,
    within: (r: Running<M, W>) → (P: Running<M, W> → Type) → kernel.resumes(r, P) → wider.resumes(r, P), calls, least, entry: Nat,
    pre: Nat → Running<M, W> → Type, post: Nat → Running<M, W> → Running<M, W> → Type,
    claim: site.ReturnsClaim(stack, kernel, calls, least, entry, pre, post)): site.ReturnsClaim(stack, wider, calls, least, entry, pre, post) {
    λ s here resident i rsp room held ret saved => site.performs_or_kernel(stack.writes, kernel, wider,
        λ (t: Running<M, W>) => (t.state.rip = ret) ∧ (site.Resident(t.state.memory) ∧ ((read_gpr(Rsp, t.state.gprs) = stack.at(i + 8)) ∧ post(i, s, t))),
        λ (_: Running<M, W>) => False, within, calls, least, s, claim(s, here, resident, i, rsp, room, held, ret, saved))
}

theorem Site::enters_claim_kernel<M, W>(self site: Site<M>, stack: Stack<M>(site.fetch, site.data), kernel, wider: Kernel<M, W>,
    within: (r: Running<M, W>) → (P: Running<M, W> → Type) → kernel.resumes(r, P) → wider.resumes(r, P), calls, least, entry: Nat,
    pre: Nat → Running<M, W> → Type, goal: Nat → Running<M, W> → BitVec(64) → Running<M, W> → Type,
    claim: site.EntersClaim(stack, kernel, calls, least, entry, pre, goal)): site.EntersClaim(stack, wider, calls, least, entry, pre, goal) {
    λ s here resident i rsp room held ret saved => site.performs_or_kernel(stack.writes, kernel, wider, goal(i, s, ret), λ (_: Running<M, W>) => False,
        within, calls, least, s, claim(s, here, resident, i, rsp, room, held, ret, saved))
}

// A callee's ceiling within the caller's: its escape the caller's
// (`carries`), its world under the caller's ceiling.
theorem Site::ceiling_within<M>(self site: Site<M>, stack: Stack<M>(site.fetch, site.data), c, inner: Ceiling<M>,
    carries: (t: Running<M, Io>) → inner.esc(t) → c.esc(t), up: Extends(c.top.past, inner.top.past)):
    (r: Running<M, Io>) → (P: Running<M, Io> → Type) → site.ceiling(stack, inner).resumes(r, P) → site.ceiling(stack, c).resumes(r, P) {
    λ r P called => match called {
        Inl(resumed) => Inl(resumed),
        Inr(escaped) => Inr(⟨carries(r, escaped.left), extends_trans(c.top.past, inner.top.past, r.io.past, up, escaped.right)⟩),
    }
}

// The CALL of a call whose callee answers `a` on `args` in the world: the
// callee's claim, entered at the offset the call gives (`CalleesReturn`),
// is its contract for `call_step_claim`, cited as stated, at the caller's
// kernel (`ceiling_within`); the count is read back to the caller's
// ceiling, the answer's world being under it.
theorem call_now_step<M>(saved: List<Gpr>, slots: Nat, eight: saved.len() <= 8, slotted: saved.len() <= slots, site: Site<M>,
    laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), top: Nat, spans: Spans,
    loan: Loan<M>(site.fetch, site.data, stack, top, spans), rooms: Nat → Nat, bound: Nat, answers: RoutineAnswers(),
    floored: Bool, spends: Nat → Nat → Running<M, Io> → Type, callees: CalleesReturn<M>(site, stack, spans, rooms, floored, top, bound, answers, spends),
    c: Ceiling<M>, values: Valuation(), spare: Nat, d: Nat, s0: MachineState<M>, fits: d + 8 * slots <= stack.size, under: (d + 8 * slots) + 8 <= top, prog: Prog,
    callee: Nat, deep: 24 <= d, below: callee + 1 <= bound, count: Nat, few: count <= 2, low: rooms(callee) <= (d - 8 * count) - 8,
    carries: (t: Running<M, Io>) → spends(callee, (d - 8 * count) - 8)(t) → c.esc(t), arguments, results: List<Typed>, before, after: Now,
    args: List<Value>, a: Answer, answered: answers(callee, args, before.heap, before.io, a),
    lands: CallLands(spans, values, spare, arguments, results, args, a, after.heap), landed: a.io = after.io, reach: c.Under(after),
    g0: Gprs, k: Nat, at: asm_back(site.program, k) = At(prog, 0, CallTo(callee + 1)), floor0: stack.Floored(floored, g0)):
    CallClaims<M, Now, Io>(site, stack, spans, now_in<M>(site.data, spans), NowWorld(), site.ceiling(stack, c), c.count(), 0,
        saved, d, slots, s0, before, after, g0, count, words_of(values, typed_ids(arguments)), values(64, call_result(results, spare)),
        words_of(values, call_also(results)), prog) {
    let i = (d - 8 * count) - 8;
    let high: (i + 8 <= top) = { omega };
    let mem = now_in<M>(site.data, spans);
    let kernel = site.ceiling(stack, c);
    let inner = Ceiling<M>(spends(callee, i), a.io);
    let callee_pre = λ (n: Nat) (u: Running<M, Io>) => RoutinePreNow<M>(site, stack, spans, rooms, top, callee, args, before.heap, before.io)(n, u) ∧
        ((n = i) ∧ stack.Floored(floored, u.state.gprs));
    let up: Extends(c.top.past, a.io.past) = j(sym(landed), λ w _ => Extends(c.top.past, w.past), reach);
    let widened = site.returns_claim_kernel<M, Io>(stack, site.ceiling(stack, inner), kernel, site.ceiling_within(stack, c, inner, carries, up),
        inner.count(), 0, asm_labels(site.program)(callee + 1), callee_pre, RoutinePostNow<M>(site, stack, spans, a),
        callees(callee, below, args, before.heap, before.io, a, answered, i));
    let pre = λ (x: Running<M, Io>) => stack.ArgsReadyBy(saved, spans, mem, d, slots, s0, before, g0, count, words_of(values, typed_ids(arguments)), x.state) ∧
        NowWorld()(before, x.io);
    let goal = site.Arrived(prog_len(prog) + 5, λ (t: Running<M, Io>) => stack.CalledBy(saved, spans, mem, d, slots, s0, after, g0, count,
        values(64, call_result(results, spare)), words_of(values, call_also(results)), t.state) ∧ NowWorld()(after, t.io));
    let stepped = call_step_claim_kept<M, Now, Io>(saved, slots, eight, slotted, site, laid, stack, top, spans, mem, NowWorld(), kernel, loan,
        now_in_stable<M>(stack, top, spans, loan), d, s0, fits, under, prog, callee, deep, count, few, words_of(values, typed_ids(arguments)),
        values(64, call_result(results, spare)), words_of(values, call_also(results)), before, after, inner.count(), 0, callee_pre,
        RoutinePostNow<M>(site, stack, spans, a), widened, g0,
        λ u passed inj world kept => ⟨⟨⟨⟨j(sym(lands.left), λ ws _ => stack.Passed(ws, i, u.state), passed), low⟩, ⟨high, inj⟩⟩, world⟩,
            ⟨refl, λ fl => trans(kept_callee_rbp(g0, u.state.gprs, kept), floor0(fl))⟩⟩,
        λ u t inj world post => ⟨⟨⟨trans(post.left.left.left, lands.right.left.left),
            j(lands.right.left.right, λ ws _ => ArgsIn(ws, answer_registers(), t.state.gprs), post.left.left.right)⟩,
            ⟨post.left.right.left, ⟨post.left.right.right.left, j(lands.right.right, λ h _ => Injected<M>(site.data, spans, h, t.state.memory),
                post.left.right.right.right)⟩⟩⟩, ⟨trans(post.right.left, landed), post.right.right⟩⟩,
        k, at);
    site.claims_ceiling(stack, c, inner.count() + 0, 0, prog_len(prog), pre, goal,
        λ r held t arrived => c.under_len(after, t.io, arrived.right.right.left, reach),
        site.claims_loosen(stack.writes, kernel, inner.count(), 1 + 0, 0, 0, prog_len(prog), pre, goal, trivial, stepped))
}

// ---------------------------------------------------------------------------
// The plain loop: its meaning at the valuation and its code

// A plain loop's passes at fuel `n`: each from the state's words, at a
// valuation of its own whose parameters they are (a pass is its own scope),
// its body's facts from the heap it starts at to the one it leaves; the
// exit bit set ends with the next words, clear goes round at one fuel less.
// At no fuel nothing ends.
fn PassesHold(Pass: Valuation() → Now → Now → Type, parameters: List<Typed>, exit: Nat, next: List<Typed>, n: Nat, state: List<BitVec(64)>, from: Now,
    final: List<BitVec(64)>, to: Now) → Type {
    match n {
        Zero => False,
        Succ(m) => Exists<Valuation()>(λ v => (words_of(v, typed_ids(parameters)) = state) ∧ Exists<Now>(λ mid => Pass(v, from, mid) ∧
            match v(1, exit).head_bit() as λ _ => Type {
                True => (final = words_of(v, typed_ids(next))) ∧ (to = mid),
                False => PassesHold(Pass, parameters, exit, next, m, words_of(v, typed_ids(next)), mid, final, to),
            })),
    }
}

// The registers a loop's state is held in, one `Into` place each, and the
// places after them.
record LoopTaken { registers: List<Gpr>, rest: List<Place> }

fn state_registers(placement: List<Place>, count: Nat) → Option<LoopTaken> {
    match count {
        Zero => Some(LoopTaken([], placement)),
        Succ(more) => match placement {
            Nil => None,
            Cons(p, rest) => match p {
                Into(r) => match state_registers(rest, more) { None => None, Some(t) => Some(LoopTaken(Cons(r, t.registers), t.rest)) },
                Folded => None,
                Saving(_) => None,
                CallSlots(_) => None,
                Spilling(_) => None,
                Short(_) => None,
            },
        },
    }
}

// The entry: the inputs moved into the state's registers, and the file a
// pass starts from (its parameters there, nothing else).
record PlainEntry { code: List<Instruction>, head: File }

fn File::plain_entry(self file: File, saves: Nat, inputs, parameters: List<Nat>, registers: List<Gpr>) → Option<PlainEntry> {
    match file.move_outputs(word_ports(inputs), registers) {
        None => None,
        Some(moves) => match moves.file.outputs_check(word_ports(inputs), registers) && leaves_all(moves.code, body_kept(saves)) {
            False => None,
            True => match input_file(word_ports(parameters), registers) { None => None, Some(head) => Some(PlainEntry(moves.code, head)) },
        },
    }
}

// The code after a pass: the next words moved into the state's registers,
// the exit bit's test, a jump forward to J where it is set, and a jump back
// to the head H; then J. A pass that goes on falls through the test and
// takes the one jump back, the step the fuel pays for; one that exits takes
// the test's jump, the outputs already in the state's registers. `test` is
// the exit bit's (taken where it is clear) and the code tests its negation.
// Labels: H is `names + 1`, J `names + 3`.
fn plain_moved(pass: Prog, moves: List<Instruction>) → Prog { At(pass, 0, Block(moves)) }

fn plain_tested(pass: Prog, test: Test, moves: List<Instruction>, names: Nat, short: List<Nat>) → Prog {
    plain_moved(pass, moves).branched_by(test.negated(), names + 3, shorts(short, names + 3))
}

fn plain_again(pass: Prog, test: Test, moves: List<Instruction>, names: Nat, short: List<Nat>) → Prog {
    At(plain_tested(pass, test, moves, names, short), 0, jmp_item(shorts(short, names + 1), names + 1))
}

fn plain_done(pass: Prog, test: Test, moves: List<Instruction>, names: Nat, short: List<Nat>) → Prog {
    At(plain_again(pass, test, moves, names, short), names + 3, Block([]))
}

fn plain_head(prog: Prog, code: List<Instruction>, names: Nat) → Prog { At(At(prog, 0, Block(code)), names + 1, Block([])) }

// After the pass: refused where the next words do not all reach the state's
// registers, the moves touch a register the body keeps, or the exit bit has
// no test in the file after the moves. The file after the loop has its
// outputs in those registers.
fn Emitted::plain_close(self pass: Emitted, saves: Nat, registers: List<Gpr>, exit: Nat, next, outputs: List<Nat>, names: Nat, short: List<Nat>) →
    Option<Emitted> {
    match pass.file.move_outputs(word_ports(next), registers) {
        None => None,
        Some(moves) => match moves.file.outputs_check(word_ports(next), registers) && leaves_all(moves.code, body_kept(saves)) {
            False => None,
            True => match moves.file.branch_test(exit) {
                None => None,
                Some(tested) => match input_file(word_ports(outputs), registers) {
                    None => None,
                    Some(out) => Some(Emitted(plain_done(pass.prog, tested.test, moves.code, names, short), out, pass.placement, pass.names)),
                },
            },
        },
    }
}

// ---------------------------------------------------------------------------
// Sequences, branches and calls

theorem may_emit_linux_of_heap<M>(saves: Nat, site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, values: Valuation(), d: Nat,
    s0: MachineState<M>, prog: Prog, file: File, facts: Type, before, after: Now, out: Option<Emitted>,
    emits: MayEmitHeap<M>(saves, site, stack, spans, values, d, s0, prog, file, facts, before.heap, after.heap, out)):
    MayEmitLinux<M>(saves, site, stack, spans, values, d, s0, prog, file, facts ∧ (after.io = before.io), before, after, out) {
    (match out as λ o => MayEmitHeap<M>(saves, site, stack, spans, values, d, s0, prog, file, facts, before.heap, after.heap, o) →
        MayEmitLinux<M>(saves, site, stack, spans, values, d, s0, prog, file, facts ∧ (after.io = before.io), before, after, o) {
        None => λ _ => trivial,
        Some(e) => λ em => emits_linux_of_heap<M>(saves, site, stack, spans, values, d, s0, prog, file, facts, before, after, e, em),
    })(emits)
}

// ---------------------------------------------------------------------------
// System calls (docs/language/ownership-design.md §17.7)
//
// A `Sys` lowers to the Linux call: its three words moved into RDI, RSI and
// RDX as a call's arguments are (`File::call_moves`, judged by
// `outputs_check`), the call's number into RAX, and SYSCALL. The step is
// the kernel's (`Site::linux_resumes`): for every answer the world gives and
// every way Linux resumes, the answer is in RAX and RCX and R11 hold what
// Linux left, so the file after forgets both. A read's window lies in a
// written span (`Spans::Window`); the code stays resident through the
// kernel's store (`Site::resumes_resident`), and the clause is
// re-established here from the loan's laws: the bytes a read returns are the
// heap's put (`Loan::store_injected`), and junk a failed read leaves lies
// under bytes the heap now calls undefined (`Injected::undefined_change`).

fn SysCall::number(self call: SysCall) → Nat { match call { Read(_, _, _, _) => 0, Write(_, _, _, _) => 1 } }

fn SysCall::words(self call: SysCall) → List<Nat> { match call { Read(fd, buf, len, _) => [fd, buf, len], Write(fd, buf, len, _) => [fd, buf, len] } }

fn SysCall::result(self call: SysCall) → Nat { match call { Read(_, _, _, result) => result, Write(_, _, _, result) => result } }

fn sys_registers() → List<Gpr> { [Rdi, Rsi, Rdx] }

fn sys_number_code(call: SysCall) → List<Instruction> { [MovRI(Rax, BitVec::ofNat(call.number()))] }

// The file once Linux has answered: the result in RAX, RCX and R11 unknown.
fn sys_after(file: File, result: Nat) → File { file.write(Rax, Some(Held(result, Word))).write(Rcx, None).write(R11, None) }

fn sys_prog(prog: Prog, moves: List<Instruction>, call: SysCall) → Prog {
    At(At(At(prog, 0, Block(moves)), 0, Block(sys_number_code(call))), 0, Syscall)
}

// RAX, RCX and R11 are none the body keeps.
fn sys_clear(saves: Nat) → Bool { Rax.apart(body_kept(saves)) && (Rcx.apart(body_kept(saves)) && R11.apart(body_kept(saves))) }

// What the call clobbers and the file still holds there is moved to a free
// spare first, so that a value live in RAX, RCX or R11 survives the call:
// the moves are judged by the file after them, as the arguments' are.
fn keep_port(slot: Option<Held>) → List<Port> {
    match slot {
        None => [],
        Some(held) => match held.kind { Word => [Port(held.id, 64)], Bit => [Port(held.id, 1)], Narrow(_) => [], Low(_) => [] },
    }
}

fn sys_kept(file: File) → List<Port> { keep_port(file.at(Rax)) ++ (keep_port(file.at(Rcx)) ++ keep_port(file.at(R11))) }

fn sys_spares(file: File) → List<Gpr> { [R8, R9, R10].filter(λ (r: Gpr) => file.at(r).is_none()) }

fn sys_entries(file: File, call: SysCall) → List<Port> { sys_kept(file) ++ ArgumentMove::ports(file.call_moves(call.words())) }

fn sys_targets(file: File, call: SysCall) → List<Gpr> {
    sys_spares(file).take(sys_kept(file).len()) ++ ArgumentMove::registers(file.call_moves(call.words()))
}

fn emit_sys(saves: Nat, prog: Prog, file: File, call: SysCall, placement: List<Place>, names: Nat) → Option<Emitted> {
    match file.move_outputs(sys_entries(file, call), sys_targets(file, call)) {
        None => None,
        Some(moves) => match moves.file.outputs_check(word_ports(call.words()), sys_registers()) &&
            (leaves_all(moves.code, body_kept(saves)) && sys_clear(saves)) {
            False => None,
            True => Some(Emitted(sys_prog(prog, moves.code, call), sys_after(moves.file.write(Rax, None), call.result()), placement, names)),
        },
    }
}

// What a read's answer leaves: the bytes put at the window's start, or the
// window undefined; and the result's word.
fn ReadLands(blocks: Blocks, before, after: Heap, loc: Loc, n: Nat, word: BitVec(64), answer: ReadResult) → Type {
    match answer {
        ReadBytes(bytes) => (before.put(blocks.written, loc, Piece::plain(bytes.take(n))) = Some(after)) ∧ (word = count_word(bytes.take(n).len())),
        ReadFailed(errno) => (before.put(blocks.written, loc, Piece::undefined(n)) = Some(after)) ∧ (word = bytes_level::errno_word(errno)),
    }
}

fn WriteLands(word: BitVec(64), answer: WriteResult) → Type {
    match answer { Wrote(count) => word = count_word(count), WriteFailed(errno) => word = bytes_level::errno_word(errno) }
}

// A system call's meaning at the valuation: the reference's location, the
// window open or the bytes read, the world's answer landed, and the
// exchange recorded. That the answer is one Linux may give is the world's
// (`NowWorld`).
fn SysCall::Lands(self call: SysCall, spans: Spans, blocks: Blocks, values: Valuation(), before, after: Now) → Type {
    match call {
        Read(fd, buf, len, result) => Exists<Loc>(λ loc => (values(64, buf) = loc.address(spans)) ∧
            ((before.heap.open(blocks, loc, values(64, len).toNat()) = True) ∧
                (ReadLands(blocks, before.heap, after.heap, loc, values(64, len).toNat(), values(64, result),
                    before.io.answer(ReadCmd(values(64, fd), values(64, len).toNat()))) ∧
                 (after.io = before.io.exchanged(ReadCmd(values(64, fd), values(64, len).toNat()),
                    before.io.answer(ReadCmd(values(64, fd), values(64, len).toNat()))))))),
        Write(fd, buf, len, result) => Exists<Loc>(λ loc => (values(64, buf) = loc.address(spans)) ∧ Exists<List<BitVec(8)>>(λ bytes =>
            (before.heap.read_bytes(loc, values(64, len).toNat()) = Some(bytes)) ∧
                ((WriteLands(values(64, result), before.io.answer(WriteCmd(values(64, fd), bytes))) ∧ (after.heap = before.heap)) ∧
                 (after.io = before.io.exchanged(WriteCmd(values(64, fd), bytes), before.io.answer(WriteCmd(values(64, fd), bytes))))))),
    }
}

// The language's words for an answer are Linux's.
theorem count_word_linux(n: Nat): count_word(n) = bitvec_nat::word_of_nat(64, n) { sym(bitvec_nat::word_of_nat_eq_ofNat(64, n)) }

theorem errno_word_linux(e: Nat, error: Errno(e)): bytes_level::errno_word(e) = linux_x86_64_io::errno_word(e) {
    let high: (e <= 4095) = error.right;
    let wide: (4096 < Nat::pow(2, 64)) = Nat::leb_sound(4097, Nat::pow(2, 64), trivial);
    trans(BitVec::neg_eq_ofNat(64, BitVec::ofNat(e)),
        cong_fn<Nat, BitVec(64)>(λ x => BitVec::ofNat(Nat::pow(2, 64) - x), BitVec::toNat_ofNat(64, e, { omega })))
}

// An address a byte on, as Linux counts addresses.
theorem rip_word(a: BitVec(64), t: Nat): next_rip(a, t) = bitvec_nat::word_of_nat(64, a.toNat() + t) {
    trans(cong_fn<BitVec(64), BitVec(64)>(λ x => next_rip(x, t), sym(bitvec_nat::word_of_nat_toNat(64, a))),
        rip_compose(BitVec::zero(n := 64), a.toNat(), t))
}

// What Linux leaves in the registers: the answer in RAX, RCX and R11 as it
// pleases. The file after holds the result in RAX, and the body's registers
// are kept.
theorem sys_answered_regs<M>(saves: Nat, values: Valuation(), file: File, result: Nat, s0: MachineState<M>, clear: sys_clear(saves).IsTrue(),
    g: Gprs, word, rcx, r11: BitVec(64), rep: file.Represents(values, g), named: values(64, result) = word, kept: Kept(body_kept(saves), s0.gprs, g)):
    sys_after(file, result).Represents(values, write_gpr(R11, r11, write_gpr(Rcx, rcx, write_gpr(Rax, word, g)))) ∧
        Kept(body_kept(saves), s0.gprs, write_gpr(R11, r11, write_gpr(Rcx, rcx, write_gpr(Rax, word, g)))) {
    let parts = Bool::is_true_and(Rax.apart(body_kept(saves)), Rcx.apart(body_kept(saves)) && R11.apart(body_kept(saves)), clear);
    let rest = Bool::is_true_and(Rcx.apart(body_kept(saves)), R11.apart(body_kept(saves)), parts.right);
    let g1 = write_gpr(Rax, word, g);
    let g2 = write_gpr(Rcx, rcx, g1);
    let f1 = file.write(Rax, Some(Held(result, Word)));
    let f2 = f1.write(Rcx, None);
    ⟨f2.represents_write(values, g2, R11, None, r11, f1.represents_write(values, g1, Rcx, None, rcx,
            file.represents_write(values, g, Rax, Some(Held(result, Word)), word, rep, named), trivial), trivial),
     kept_trans(body_kept(saves), s0.gprs, g, write_gpr(R11, r11, g2), kept,
        kept_trans(body_kept(saves), g, g1, write_gpr(R11, r11, g2), kept_write(body_kept(saves), Rax, word, g, parts.left),
            kept_trans(body_kept(saves), g1, g2, write_gpr(R11, r11, g2), kept_write(body_kept(saves), Rcx, rcx, g1, rest.left),
                kept_write(body_kept(saves), R11, r11, g2, rest.right))))⟩
}

// Linux's answer to a write, and to a read: the word in RAX and, for a
// read, the bytes stored at RSI.
fn write_rax(a: WriteResult) → BitVec(64) {
    match a { Wrote(count) => bitvec_nat::word_of_nat(64, count), WriteFailed(errno) => linux_x86_64_io::errno_word(errno) }
}

fn read_rax(a: ReadResult) → BitVec(64) {
    match a { ReadBytes(bytes) => bitvec_nat::word_of_nat(64, bytes.len()), ReadFailed(errno) => linux_x86_64_io::errno_word(errno) }
}

fn read_stored(a: ReadResult, junk: List<BitVec(8)>) → List<BitVec(8)> { match a { ReadBytes(bytes) => bytes, ReadFailed(_) => junk } }

theorem write_answered<M>(io: LinuxIo<M>, at: MachineState<M>, fd: BitVec(64), bytes: List<BitVec(8)>, a: WriteResult, junk: List<BitVec(8)>,
    rcx, r11: BitVec(64)): linux_answered(io, at, WriteCmd(fd, bytes), a, junk, rcx, r11) = linux_write_return(at, write_rax(a), rcx, r11) {
    match a { Wrote(_) => refl, WriteFailed(_) => refl }
}

theorem read_answered<M>(io: LinuxIo<M>, at: MachineState<M>, fd: BitVec(64), max: Nat, a: ReadResult, junk: List<BitVec(8)>, rcx, r11: BitVec(64)):
    linux_answered(io, at, ReadCmd(fd, max), a, junk, rcx, r11) =
        MachineState(gprs := write_gpr(R11, r11, write_gpr(Rcx, rcx, write_gpr(Rax, read_rax(a), at.gprs))), flags := syscall_flags(),
            rip := next_rip(at.rip, 2), memory := io.store(at.memory, read_gpr(Rsi, at.gprs), read_stored(a, junk))) {
    match a { ReadBytes(_) => refl, ReadFailed(_) => refl }
}

// The result's word, as the language has it, is the one Linux leaves.
theorem write_word_lands(word: BitVec(64), fd: BitVec(64), bytes: List<BitVec(8)>, a: WriteResult, answers: LinuxCmd::Answers(WriteCmd(fd, bytes), a),
    lands: WriteLands(word, a)): word = write_rax(a) {
    (match a as λ b => LinuxCmd::Answers(WriteCmd(fd, bytes), b) → WriteLands(word, b) → word = write_rax(b) {
        Wrote(count) => λ _ named => trans(named, count_word_linux(count)),
        WriteFailed(errno) => λ error named => trans(named, errno_word_linux(errno, error)),
    })(answers, lands)
}

theorem read_word_lands(blocks: Blocks, before, after: Heap, loc: Loc, n: Nat, word: BitVec(64), fd: BitVec(64), a: ReadResult,
    answers: LinuxCmd::Answers(ReadCmd(fd, n), a), lands: ReadLands(blocks, before, after, loc, n, word, a)): word = read_rax(a) {
    (match a as λ b => LinuxCmd::Answers(ReadCmd(fd, n), b) → ReadLands(blocks, before, after, loc, n, word, b) → word = read_rax(b) {
        ReadBytes(bytes) => λ few landed => trans(landed.right, trans(cong_fn<List<BitVec(8)>, BitVec(64)>(λ xs => count_word(xs.len()), bytes.take_all(n, few)),
            count_word_linux(bytes.len()))),
        ReadFailed(errno) => λ error landed => trans(landed.right, errno_word_linux(errno, error)),
    })(answers, lands)
}

// The bytes a write sends are the heap's at the reference's location.
theorem write_sends<M>(io: LinuxIo<M>, spans: Spans, heap: Heap, memory: M, inj: Injected<M>(io.data, spans, heap, memory), loc: Loc, n: Nat,
    bytes: List<BitVec(8)>, read: heap.read_bytes(loc, n) = Some(bytes)): LinuxWritesFrom(io, memory, loc.address(spans), bytes) {
    λ i byte got => {
        let reads = inj.reads(loc, n, bytes, read);
        let len: (bytes.len() = n) = heap.read_bytes_len(loc, n, bytes, read);
        let below: (i < bytes.len()) = bytes.nth_some_below(i, byte, got);
        trans(cong_fn<BitVec(64), Option<BitVec(8)>>(λ y => io.data.read(memory, y), sym(rip_word(loc.address(spans), i))),
            trans(reads.right(i, { omega }), got))
    }
}

// Every flag of an undefined piece is set.
theorem undefined_at_all(n: Nat): (t: Nat) → t < n → undefined_at(List::replicate(True, n), t) = True {
    match n {
        Zero => λ t short => false_elim({ omega }),
        Succ(m) => λ t => match t { Zero => λ _ => refl, Succ(u) => λ short => undefined_at_all(m, u, { omega }) },
    }
}

// An injection holds of a heap with more bytes undefined.
theorem injected_undefining<M>(data: ByteReadAccess<M>, spans: Spans, heap: Heap, memory: M, inj: Injected<M>(data, spans, heap, memory),
    other: Heap, same: (b: Nat) → other.bytes(b) = heap.bytes(b), shadow: other.shadow = heap.shadow,
    defined: (b, k: Nat) → other.undefined(b, k) = False → heap.undefined(b, k) = False): Injected<M>(data, spans, other, memory) {
    Injected(
        sizes := λ b => trans(cong_fn<List<BitVec(8)>, Nat>(λ l => l.len(), same(b)), inj.sizes(b)),
        bytes := λ b k inside none undefined => trans(inj.bytes(b, k, inside, trans(cong_fn<List<Pointer>, Bool>(λ sh => covered(sh, b, k), sym(shadow)), none),
                defined(b, k, undefined)),
            cong_fn<List<BitVec(8)>, Option<BitVec(8)>>(λ l => l.nth(k), sym(same(b)))),
        refs := j(sym(shadow), λ sh _ => Every(sh, λ (e: Pointer) => e.Held(data, spans, memory)), inj.refs),
    )
}

// The bytes a read returns, stored into its window from a byte inside a
// written span: a store the lending allows, and the heap with them put is
// injected.
theorem read_bytes_kept<M>(site: Site<M>, stack: Stack<M>(site.fetch, site.data), top: Nat, spans: Spans,
    loan: Loan<M>(site.fetch, site.data, stack, top, spans), blocks: Blocks, lent: blocks.Lent(spans), d: Nat, heap, after: Heap, memory: M,
    inj: Injected<M>(site.data, spans, heap, memory), loc: Loc, inside: loc.offset < spans.size(loc.block), n: Nat, bytes: List<BitVec(8)>,
    few: bytes.len() <= n, put: heap.put(blocks.written, loc, Piece::plain(bytes.take(n))) = Some(after)):
    stack.WroteIn(d, spans, memory, stack.writes.store(memory, loc.address(spans), bytes)) ∧
        Injected<M>(site.data, spans, after, stack.writes.store(memory, loc.address(spans), bytes)) {
    let taken = bytes.take(n);
    let facts = heap.put_lent(blocks, spans, lent, inj.sizes, loc, Piece::plain(taken), after, put);
    let ok = heap.put_some(blocks.written, loc, Piece::plain(taken), after, put).right.left;
    let all: (taken = bytes) = bytes.take_all(n, few);
    j(all, λ xs _ => stack.WroteIn(d, spans, memory, stack.writes.store(memory, loc.address(spans), xs)) ∧
            Injected<M>(site.data, spans, after, stack.writes.store(memory, loc.address(spans), xs)),
        ⟨stack.wrote_in_store(d, spans, memory, loc.block, loc.offset, facts.left, inside, taken, facts.right.left),
         j(facts.right.right, λ h _ => Injected<M>(site.data, spans, h, stack.writes.store(memory, loc.address(spans), taken)),
            loan.store_injected(heap, memory, inj, loc, facts.left, inside, taken, ok))⟩)
}

// Junk a failed read left in its window, no longer than it: a store the
// lending allows, and the heap with the window undefined is injected. The
// window is first stored zero, the heap's own bytes there
// (`Loan::store_injected`), called undefined, and then whatever Linux left
// read instead (`Injected::undefined_change`): outside the window memory is
// as it was, and inside it no byte is defined or covered.
theorem read_failed_kept<M>(site: Site<M>, stack: Stack<M>(site.fetch, site.data), top: Nat, spans: Spans,
    loan: Loan<M>(site.fetch, site.data, stack, top, spans), blocks: Blocks, lent: blocks.Lent(spans), d: Nat, heap, after: Heap, memory: M,
    inj: Injected<M>(site.data, spans, heap, memory), loc: Loc, inside: loc.offset < spans.size(loc.block), n: Nat, junk: List<BitVec(8)>,
    few: junk.len() <= n, put: heap.put(blocks.written, loc, Piece::undefined(n)) = Some(after)):
    stack.WroteIn(d, spans, memory, stack.writes.store(memory, loc.address(spans), junk)) ∧
        Injected<M>(site.data, spans, after, stack.writes.store(memory, loc.address(spans), junk)) {
    let b = loc.block;
    let k = loc.offset;
    let zeros = List::replicate(BitVec::zero(n := 8), n);
    let piece = Piece::undefined(n);
    let facts = heap.put_lent(blocks, spans, lent, inj.sizes, loc, piece, after, put);
    let ok = heap.put_some(blocks.written, loc, piece, after, put).right.left;
    let zlen: (zeros.len() = n) = List::len_replicate(BitVec::zero(n := 8), n);
    let zfits: (k + zeros.len() <= spans.size(b)) = facts.right.left;
    let jfits: (k + junk.len() <= spans.size(b)) = { omega };
    let zeroed = stack.writes.store(memory, loc.address(spans), zeros);
    let other = stack.writes.store(memory, loc.address(spans), junk);
    let placed = heap.placed(loc, piece);
    let inj1 = loan.store_injected(heap, memory, inj, loc, facts.left, inside, zeros, ok);
    let inj2 = injected_undefining<M>(site.data, spans, heap.store(loc, zeros), zeroed, inj1, placed, λ c => refl, refl, λ c i und =>
        trans(heap.placed_undefined_at(loc, Piece::plain(zeros), c, i),
            (match within(b, k, zeros.len(), c, i) as λ v =>
                (match v { True => undefined_at(List::replicate(True, n), i - k), False => heap.undefined(c, i) }) = False →
                (match v { True => undefined_at(Nil, i - k), False => heap.undefined(c, i) }) = False {
                True => λ _ => refl,
                False => λ h => h,
            })(trans(sym(heap.placed_undefined_at(loc, piece, c, i)), und))));
    let uncovered = λ (t: Nat) (short: t < zeros.len()) =>
        unheld_uncovered(b, k, zeros.len(), t, short, cleared(heap.shadow, b, k, zeros.len()), every_cleared_apart(b, k, zeros.len(), heap.shadow));
    let inj3 = inj2.undefined_change(other, λ c i short either => {
        let outside = λ (side: (b ≠ c) ∨ ((i < k) ∨ (k + n <= i))) =>
            trans(loan.apart(memory, b, k, facts.left, inside, junk, jfits, c, i, short, match side {
                    Inl(differs) => Inl(differs),
                    Inr(order) => Inr(match order { Inl(below) => Inl(below), Inr(above) => Inr({ omega }) }),
                }),
                sym(loan.apart(memory, b, k, facts.left, inside, zeros, zfits, c, i, short, match side {
                    Inl(differs) => Inl(differs),
                    Inr(order) => Inr(match order { Inl(below) => Inl(below), Inr(above) => Inr({ omega }) }),
                })));
        match b.eq_dec(c) {
            Inr(differs) => outside(Inl(differs)),
            Inl(same) => match i.lt_or_ge(k) {
                Inl(below) => outside(Inr(Inl(below))),
                Inr(from) => match i.lt_or_ge(k + n) {
                    Inr(past) => outside(Inr(Inr(past))),
                    Inl(within_window) => {
                        let t = i - k;
                        let at: (k + t = i) = { omega };
                        let tz: (t < zeros.len()) = { omega };
                        let tn: (t < n) = { omega };
                        let moved = j(sym(same), λ x _ => (covered(placed.shadow, x, i) = True) ∨ (placed.undefined(x, i) = False), either);
                        let moved2 = j(sym(at), λ y _ => (covered(placed.shadow, b, y) = True) ∨ (placed.undefined(b, y) = False), moved);
                        let flag: (placed.undefined(b, k + t) = True) = trans(heap.placed_undefined_inside(loc, piece, t, tz), undefined_at_all(n, t, tn));
                        match moved2 {
                            Inl(cov) => absurd(trans(sym(cov), uncovered(t, tz))),
                            Inr(def) => absurd(trans(sym(flag), def)),
                        }
                    },
                },
            },
        }
    });
    ⟨stack.wrote_in_store(d, spans, memory, b, k, facts.left, inside, junk, jfits),
     j(facts.right.right, λ h _ => Injected<M>(site.data, spans, h, other), inj3)⟩
}

// A read of no bytes into a window at its block's end, which the language
// allows as an empty slice at a list's end is allowed: no loan law reaches
// that address, and the stack's writes' own law does (`stack.empty`,
// `ByteWrites::EmptyRange`: a store of no bytes changes nothing and needs no
// room).
theorem nil_of_short<A>(xs: List<A>): xs.len() <= 0 → xs = Nil {
    match xs { Nil => λ _ => refl, Cons(_, _) => λ short => false_elim(short) }
}

// A piece of no bytes placed anywhere the heap fits it: the same memory
// injects the heap after.
theorem injected_placed_nothing<M>(data: ByteReadAccess<M>, spans: Spans, heap: Heap, memory: M, inj: Injected<M>(data, spans, heap, memory),
    loc: Loc, piece: Piece, empty: piece.bytes.len() = 0, none: pointers_of(piece.slots, loc.block, loc.offset) = Nil,
    fits: heap.fits(loc, piece.bytes.len()) = True): Injected<M>(data, spans, heap.placed(loc, piece), memory) {
    let b = loc.block;
    let k = loc.offset;
    let n = piece.bytes.len();
    let parts = heap.fits_parts(loc, n, fits);
    let outside = λ (c: Nat) (i: Nat) => match i.lt_or_ge(k) as λ _ => (b ≠ c) ∨ ((i < k) ∨ (k + n <= i)) {
        Inl(below) => Inr(Inl(below)),
        Inr(from) => Inr(Inr({ omega })),
    };
    Injected(
        sizes := λ c => trans(heap.placed_len(loc, piece, parts.left, c), inj.sizes(c)),
        bytes := λ c i short uncovered defined => {
            let side = outside(c, i);
            let cleared_none: (covered(cleared(heap.shadow, b, k, n), c, i) = False) =
                j(none, λ ps _ => covered(ps ++ cleared(heap.shadow, b, k, n), c, i) = False, uncovered);
            let old: (covered(heap.shadow, c, i) = False) = match uncovered_after_clearing(b, k, n, c, i, heap.shadow, parts.right, cleared_none) {
                Inl(stored) => false_elim({ let lo = stored.right.left; let hi = stored.right.right; omega }),
                Inr(was) => was,
            };
            trans(inj.bytes(c, i, short, old, trans(sym(heap.placed_undefined_outside(loc, piece, c, i, side)), defined)),
                sym(heap.placed_outside(loc, piece, parts.left, c, i, side)))
        },
        refs := j(sym(none), λ ps _ => Every(ps ++ cleared(heap.shadow, b, k, n), λ (e: Pointer) => e.Held(data, spans, memory)),
            every_cleared(λ (e: Pointer) => e.Held(data, spans, memory), b, k, n, heap.shadow, inj.refs)),
    )
}

// A read of no bytes: Linux stores nothing, whatever it answers.
theorem read_stored_empty(fd: BitVec(64), n: Nat, zero: n = 0, a: ReadResult, junk: List<BitVec(8)>, answers: LinuxCmd::Answers(ReadCmd(fd, n), a),
    leaves: LinuxLeaves(ReadCmd(fd, n), a, junk)): read_stored(a, junk) = Nil {
    (match a as λ r => LinuxCmd::Answers(ReadCmd(fd, n), r) → LinuxLeaves(ReadCmd(fd, n), r, junk) → read_stored(r, junk) = Nil {
        ReadBytes(bytes) => λ few _ => nil_of_short(bytes, { omega }),
        ReadFailed(_) => λ _ few => nil_of_short(junk, { omega }),
    })(answers, leaves)
}

// And the heap it puts is injected by the same memory.
theorem read_empty_injected<M>(data: ByteReadAccess<M>, spans: Spans, blocks: Blocks, heap, after: Heap, memory: M,
    inj: Injected<M>(data, spans, heap, memory), loc: Loc, fd: BitVec(64), n: Nat, zero: n = 0, word: BitVec(64), a: ReadResult,
    answers: LinuxCmd::Answers(ReadCmd(fd, n), a), lands: ReadLands(blocks, heap, after, loc, n, word, a)): Injected<M>(data, spans, after, memory) {
    (match a as λ r => LinuxCmd::Answers(ReadCmd(fd, n), r) → ReadLands(blocks, heap, after, loc, n, word, r) → Injected<M>(data, spans, after, memory) {
        ReadBytes(bytes) => λ few landed => {
            let piece = Piece::plain(bytes.take(n));
            let put = heap.put_some(blocks.written, loc, piece, after, landed.left);
            let all: (bytes.take(n) = bytes) = bytes.take_all(n, few);
            let len: (bytes.take(n).len() = bytes.len()) = cong_fn<List<BitVec(8)>, Nat>(λ xs => xs.len(), all);
            j(put.right.right, λ h _ => Injected<M>(data, spans, h, memory),
                injected_placed_nothing<M>(data, spans, heap, memory, inj, loc, piece, { omega }, refl, put.right.left))
        },
        ReadFailed(_) => λ _ landed => {
            let piece = Piece::undefined(n);
            let put = heap.put_some(blocks.written, loc, piece, after, landed.left);
            let len: (List::replicate(BitVec::zero(n := 8), n).len() = n) = List::len_replicate(BitVec::zero(n := 8), n);
            j(put.right.right, λ h _ => Injected<M>(data, spans, h, memory),
                injected_placed_nothing<M>(data, spans, heap, memory, inj, loc, piece, { omega }, refl, put.right.left))
        },
    })(answers, lands)
}

// Inside its span, either answer's store, as `read_bytes_kept` and
// `read_failed_kept` have it.
theorem read_kept<M>(site: Site<M>, stack: Stack<M>(site.fetch, site.data), top: Nat, spans: Spans,
    loan: Loan<M>(site.fetch, site.data, stack, top, spans), blocks: Blocks, lent: blocks.Lent(spans), d: Nat, heap, after: Heap, memory: M,
    inj: Injected<M>(site.data, spans, heap, memory), loc: Loc, inside: loc.offset < spans.size(loc.block), fd: BitVec(64), n: Nat, word: BitVec(64),
    a: ReadResult, answers: LinuxCmd::Answers(ReadCmd(fd, n), a), lands: ReadLands(blocks, heap, after, loc, n, word, a), junk: List<BitVec(8)>,
    leaves: LinuxLeaves(ReadCmd(fd, n), a, junk)):
    stack.WroteIn(d, spans, memory, stack.writes.store(memory, loc.address(spans), read_stored(a, junk))) ∧
        Injected<M>(site.data, spans, after, stack.writes.store(memory, loc.address(spans), read_stored(a, junk))) {
    (match a as λ r => LinuxCmd::Answers(ReadCmd(fd, n), r) → ReadLands(blocks, heap, after, loc, n, word, r) → LinuxLeaves(ReadCmd(fd, n), r, junk) →
        stack.WroteIn(d, spans, memory, stack.writes.store(memory, loc.address(spans), read_stored(r, junk))) ∧
            Injected<M>(site.data, spans, after, stack.writes.store(memory, loc.address(spans), read_stored(r, junk))) {
        ReadBytes(bytes) => λ few landed _ =>
            read_bytes_kept<M>(site, stack, top, spans, loan, blocks, lent, d, heap, after, memory, inj, loc, inside, n, bytes, few, landed.left),
        ReadFailed(_) => λ _ landed few =>
            read_failed_kept<M>(site, stack, top, spans, loan, blocks, lent, d, heap, after, memory, inj, loc, inside, n, junk, few, landed.left),
    })(answers, lands, leaves)
}

// A region's meaning at the valuation, from the heap and world `before` to
// `after`: a leaf's nodes, the world kept; a sequence through a state
// between, whose history lies between the two; the arm the condition's bit
// picks; and a call: the values at its arguments, lowered, are the
// valuation's words there, the callee answers them in the world (`answers`,
// what the program's routines answer at the fuel the call is made with), and
// its answer's words, lowered, are the words at its results (`CallLands`),
// its world the one after; a plain loop's passes at some fuel
// (`PassesHold`); a system call's answer landed (`SysCall::Lands`). An
// exit is never done: it means nothing here.
fn Body::Holds(self body: Body, spans: Spans, blocks: Blocks, values: Valuation(), answers: RoutineAnswers(), spare: Nat, before, after: Now) → Type {
    match body {
        Leaf(instrs) => InstrsHold(spans, blocks, values, instrs, before.heap, after.heap) ∧ (after.io = before.io),
        Seq(first, rest) => Exists<Now>(λ mid => (first.Holds(spans, blocks, values, answers, spare, before, mid) ∧
            rest.Holds(spans, blocks, values, answers, spare, mid, after)) ∧ Between(before, mid, after)),
        Branch(condition, yes, no) => match values(1, condition).head_bit() {
            True => yes.Holds(spans, blocks, values, answers, spare, before, after),
            False => no.Holds(spans, blocks, values, answers, spare, before, after),
        },
        Call(callee, arguments, results) => Exists<List<Value>>(λ args => Exists<Answer>(λ a =>
            answers(callee, args, before.heap, before.io, a) ∧ (CallLands(spans, values, spare, arguments, results, args, a, after.heap) ∧ (a.io = after.io)))),
        Loop(inputs, parameters, inner, exit, next, outputs) => Exists<Nat>(λ n => PassesHold(λ (v: Valuation()) (from: Now) (to: Now) =>
            inner.Holds(spans, blocks, v, answers, spare, from, to), parameters, exit, next, n, words_of(values, typed_ids(inputs)), before,
            words_of(values, typed_ids(outputs)), after)),
        Sys(call) => call.Lands(spans, blocks, values, before, after),
        Exit(_) => False,
    }
}

// At the SYSCALL: the file after the moves, the words in RDI, RSI and RDX,
// the call's number in RAX, the call's facts and the trail.
fn SysAt<M>(saves: Nat, site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, values: Valuation(), d: Nat, s0: MachineState<M>,
    file: File, call: SysCall, facts: Type, now: Now) → MachineState<M> → Type {
    λ (s: MachineState<M>) => ((file.Represents(values, s.gprs) ∧ (ArgsIn(words_of(values, call.words()), sys_registers(), s.gprs) ∧
        (read_gpr(Rax, s.gprs) = BitVec::ofNat(call.number())))) ∧ facts) ∧ stack.TrailedBy(saves, spans, now_in<M>(site.data, spans), d, s0, now, s)
}

// A write: Linux reads the request off the registers and the bytes off the
// heap's place in memory; every way it resumes leaves the result in RAX,
// the memory as it was, and the world with the exchange recorded.
theorem sys_write_resumes<M>(saves: Nat, site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, blocks: Blocks, values: Valuation(),
    d: Nat, s0: MachineState<M>, file: File, fd, buf, len, result: Nat, before, after: Now, clear: sys_clear(saves).IsTrue(), to: Nat,
    s: MachineState<M>, fetched: LinuxSyscallAt(site.linux(stack), s), resident: site.Resident(s.memory),
    arrive: next_rip(s.rip, 2) = next_rip(site.origin, to), answerable: before.io.Answerable(),
    held: SysAt<M>(saves, site, stack, spans, values, d, s0, file, Write(fd, buf, len, result),
        SysCall::Write(fd, buf, len, result).Lands(spans, blocks, values, before, after), before)(s)):
    site.linux_resumes(stack, Running(s, before.io), NowPost<M>(saves, site, stack, spans, values, d, s0, to, sys_after(file, result), after)) {
    let lands = held.left.right;
    let loc = lands.witness;
    let got = lands.proof.right;
    let bytes = got.witness;
    let read = got.proof.left;
    let fdv = values(64, fd);
    let n = values(64, len).toNat();
    let c: LinuxCmd<Nat> = WriteCmd(fdv, bytes);
    let a = before.io.answer(c);
    let args = held.left.left.right.left;
    let trailed = held.right;
    let inj: Injected<M>(site.data, spans, before.heap, s.memory) = trailed.right.right;
    let len_is: (bytes.len() = n) = before.heap.read_bytes_len(loc, n, bytes, read);
    let rsi: (read_gpr(Rsi, s.gprs) = loc.address(spans)) = trans(args.right.left, lands.proof.left);
    let sends = j(sym(rsi), λ x _ => LinuxWritesFrom(site.linux(stack), s.memory, x, bytes),
        write_sends<M>(site.linux(stack), spans, before.heap, s.memory, inj, loc, n, bytes, read));
    let answers: LinuxCmd::Answers(c, a) = answerable(before.io.past, c);
    let word = write_word_lands(values(64, result), fdv, bytes, a, answers, got.proof.right.left.left);
    let rdx: (read_gpr(Rdx, s.gprs).toNat() = bytes.len()) = trans(cong_fn<BitVec(64), Nat>(λ x => x.toNat(), args.right.right.left), sym(len_is));
    Exists(c, ⟨⟨fetched, ⟨⟨⟨held.left.left.right.right, ⟨args.left, ⟨rdx, sends⟩⟩⟩, trivial⟩, answers⟩⟩, λ junk leaves rcx r11 => {
        let regs = sys_answered_regs<M>(saves, values, file, result, s0, clear, s.gprs, write_rax(a), rcx, r11, held.left.left.left, word, trailed.left);
        j(sym(write_answered(site.linux(stack), s, fdv, bytes, a, junk, rcx, r11)),
            λ u _ => NowPost<M>(saves, site, stack, spans, values, d, s0, to, sys_after(file, result), after)(Running(u, before.io.exchanged(c, a))),
            ⟨⟨arrive, resident⟩, ⟨⟨regs.left, ⟨regs.right, ⟨trailed.right.left,
                j(sym(got.proof.right.left.right), λ h _ => Injected<M>(site.data, spans, h, s.memory), inj)⟩⟩⟩, ⟨sym(got.proof.right.right), answerable⟩⟩⟩)
    }⟩)
}

// Where a call resumes with the result in RAX and the clause kept: the
// region's end.
theorem sys_post<M>(saves: Nat, site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, values: Valuation(), d: Nat,
    s0: MachineState<M>, file: File, result: Nat, after: Now, clear: sys_clear(saves).IsTrue(), to: Nat, s: MachineState<M>, word, rcx, r11: BitVec(64),
    memory: M, io: Io, rep: file.Represents(values, s.gprs), named: values(64, result) = word, kept: Kept(body_kept(saves), s0.gprs, s.gprs),
    wrote: stack.WroteIn(d, spans, s0.memory, memory), inj: Injected<M>(site.data, spans, after.heap, memory),
    arrive: next_rip(s.rip, 2) = next_rip(site.origin, to), resident: site.Resident(memory), world: io = after.io, answers: io.Answerable()):
    NowPost<M>(saves, site, stack, spans, values, d, s0, to, sys_after(file, result), after)(Running(MachineState(
        gprs := write_gpr(R11, r11, write_gpr(Rcx, rcx, write_gpr(Rax, word, s.gprs))), flags := syscall_flags(), rip := next_rip(s.rip, 2),
        memory := memory), io)) {
    let regs = sys_answered_regs<M>(saves, values, file, result, s0, clear, s.gprs, word, rcx, r11, rep, named, kept);
    ⟨⟨arrive, resident⟩, ⟨⟨regs.left, ⟨regs.right, ⟨wrote, inj⟩⟩⟩, ⟨world, answers⟩⟩⟩
}

// A read: Linux reads the request off the registers, its window writable
// in a written span; every way it resumes leaves the count or the errno in
// RAX, the window holding what the heap now says (the bytes, or undefined),
// the code resident and the world with the exchange recorded. A read of no
// bytes at its block's end stores nothing (`stack.empty`).
theorem sys_read_resumes<M>(saves: Nat, site: Site<M>, stack: Stack<M>(site.fetch, site.data), top: Nat, spans: Spans,
    loan: Loan<M>(site.fetch, site.data, stack, top, spans), blocks: Blocks, lent: blocks.Lent(spans),     values: Valuation(), d: Nat, s0: MachineState<M>, file: File, fd, buf, len, result: Nat, before, after: Now, clear: sys_clear(saves).IsTrue(),
    to: Nat, s: MachineState<M>, fetched: LinuxSyscallAt(site.linux(stack), s), resident: site.Resident(s.memory),
    arrive: next_rip(s.rip, 2) = next_rip(site.origin, to), answerable: before.io.Answerable(),
    held: SysAt<M>(saves, site, stack, spans, values, d, s0, file, Read(fd, buf, len, result),
        SysCall::Read(fd, buf, len, result).Lands(spans, blocks, values, before, after), before)(s)):
    site.linux_resumes(stack, Running(s, before.io), NowPost<M>(saves, site, stack, spans, values, d, s0, to, sys_after(file, result), after)) {
    let lands = held.left.right;
    let loc = lands.witness;
    let b = loc.block;
    let k = loc.offset;
    let landed = lands.proof.right.right.left;
    let world = lands.proof.right.right.right;
    let fdv = values(64, fd);
    let n = values(64, len).toNat();
    let c: LinuxCmd<Nat> = ReadCmd(fdv, n);
    let a = before.io.answer(c);
    let args = held.left.left.right.left;
    let trailed = held.right;
    let inj: Injected<M>(site.data, spans, before.heap, s.memory) = trailed.right.right;
    let rsi: (read_gpr(Rsi, s.gprs) = loc.address(spans)) = trans(args.right.left, lands.proof.left);
    let answers: LinuxCmd::Answers(c, a) = answerable(before.io.past, c);
    let word = read_word_lands(blocks, before.heap, after.heap, loc, n, values(64, result), fdv, a, answers, landed);
    let rdx: (read_gpr(Rdx, s.gprs).toNat() = n) = cong_fn<BitVec(64), Nat>(λ x => x.toNat(), args.right.right.left);
    let asks: LinuxAsks(site.linux(stack), s, c) = ⟨held.left.left.right.right, ⟨args.left, rdx⟩⟩;
    let open_parts = Bool::and_true_parts(blocks.written(b), before.heap.fits(loc, n) && no_slots(slots_within(before.heap.shadow, b, k, n)),
        lands.proof.right.left);
    let fit_parts = Bool::and_true_parts(before.heap.fits(loc, n), no_slots(slots_within(before.heap.shadow, b, k, n)), open_parts.right);
    let written: (spans.written(b) = True) = lent(b, open_parts.left);
    let fits: (k + n <= before.heap.bytes(b).len()) = before.heap.fits_parts(loc, n, fit_parts.left).left;
    let size: (before.heap.bytes(b).len() = spans.size(b)) = inj.sizes(b);
    let span_fits: (k + n <= spans.size(b)) = { omega };
    let post = λ (junk: List<BitVec(8)>) (rcx: BitVec(64)) (r11: BitVec(64)) (wrote: stack.WroteIn(d, spans, s0.memory,
            stack.writes.store(s.memory, read_gpr(Rsi, s.gprs), read_stored(a, junk))))
        (injected: Injected<M>(site.data, spans, after.heap, stack.writes.store(s.memory, read_gpr(Rsi, s.gprs), read_stored(a, junk))))
        (stays: site.Resident(stack.writes.store(s.memory, read_gpr(Rsi, s.gprs), read_stored(a, junk)))) =>
        j(sym(read_answered(site.linux(stack), s, fdv, n, a, junk, rcx, r11)),
            λ u _ => NowPost<M>(saves, site, stack, spans, values, d, s0, to, sys_after(file, result), after)(Running(u, before.io.exchanged(c, a))),
            sys_post<M>(saves, site, stack, spans, values, d, s0, file, result, after, clear, to, s, read_rax(a), rcx, r11,
                stack.writes.store(s.memory, read_gpr(Rsi, s.gprs), read_stored(a, junk)), before.io.exchanged(c, a), held.left.left.left, word,
                trailed.left, wrote, injected, arrive, stays, sym(world), answerable));
    match k.lt_or_ge(spans.size(b)) {
        Inl(inside) => {
            let window: spans.Window(s, c) = Exists(b, Exists(k, ⟨written, ⟨inside, ⟨span_fits, rsi⟩⟩⟩));
            let zeros = List::replicate(BitVec::zero(n := 8), n);
            let zlen: (zeros.len() = n) = List::len_replicate(BitVec::zero(n := 8), n);
            let open: stack.writes.writable(s.memory, read_gpr(Rsi, s.gprs), n) = j(sym(rsi), λ x _ => stack.writes.writable(s.memory, x, n),
                j(zlen, λ q _ => stack.writes.writable(s.memory, loc.address(spans), q), loan.writable(s.memory, b, k, written, inside, zeros, { omega })));
            let kept = site.resumes_resident(stack, top, spans, loan, s, c, a, answers, window, resident);
            Exists(c, ⟨⟨fetched, ⟨⟨asks, open⟩, answers⟩⟩, λ junk leaves rcx r11 => {
                let stays = j(cong_fn<MachineState<M>, M>(λ u => u.memory, read_answered(site.linux(stack), s, fdv, n, a, junk, rcx, r11)),
                    λ m _ => site.Resident(m), kept(junk, leaves, rcx, r11).right);
                let mem = j(sym(rsi), λ x _ => stack.WroteIn(d, spans, s.memory, stack.writes.store(s.memory, x, read_stored(a, junk))) ∧
                        Injected<M>(site.data, spans, after.heap, stack.writes.store(s.memory, x, read_stored(a, junk))),
                    read_kept<M>(site, stack, top, spans, loan, blocks, lent, d, before.heap, after.heap, s.memory, inj, loc, inside, fdv, n,
                        values(64, result), a, answers, landed, junk, leaves));
                post(junk, rcx, r11, stack.wrote_in_trans(d, spans, s0.memory, s.memory, stack.writes.store(s.memory, read_gpr(Rsi, s.gprs), read_stored(a, junk)),
                    trailed.right.left, mem.left), mem.right, stays)
            }⟩)
        },
        Inr(past) => {
            let zero: (n = 0) = { omega };
            let empty = λ (m: M) => stack.empty(m, read_gpr(Rsi, s.gprs));
            let open: stack.writes.writable(s.memory, read_gpr(Rsi, s.gprs), n) =
                j(sym(zero), λ q _ => stack.writes.writable(s.memory, read_gpr(Rsi, s.gprs), q), empty(s.memory).left);
            Exists(c, ⟨⟨fetched, ⟨⟨asks, open⟩, answers⟩⟩, λ junk leaves rcx r11 => {
                let nothing: (read_stored(a, junk) = Nil) = read_stored_empty(fdv, n, zero, a, junk, answers, leaves);
                let same: (stack.writes.store(s.memory, read_gpr(Rsi, s.gprs), read_stored(a, junk)) = s.memory) =
                    trans(cong_fn<List<BitVec(8)>, M>(λ xs => stack.writes.store(s.memory, read_gpr(Rsi, s.gprs), xs), nothing), empty(s.memory).right);
                post(junk, rcx, r11,
                    j(sym(same), λ m _ => stack.WroteIn(d, spans, s0.memory, m), trailed.right.left),
                    j(sym(same), λ m _ => Injected<M>(site.data, spans, after.heap, m),
                        read_empty_injected<M>(site.data, spans, blocks, before.heap, after.heap, s.memory, inj, loc, fdv, n, zero, values(64, result), a,
                            answers, landed)),
                    j(sym(same), λ m _ => site.Resident(m), resident))
            }⟩)
        },
    }
}

// Writing RAX keeps what RDI, RSI and RDX hold.
theorem sys_args_kept(words: List<BitVec(64)>, g: Gprs, x: BitVec(64)): ArgsIn(words, sys_registers(), g) → ArgsIn(words, sys_registers(), write_gpr(Rax, x, g)) {
    match words {
        Nil => λ h => h,
        Cons(_, r1) => match r1 {
            Nil => λ h => ⟨h.left, trivial⟩,
            Cons(_, r2) => match r2 {
                Nil => λ h => ⟨h.left, ⟨h.right.left, trivial⟩⟩,
                Cons(_, r3) => match r3 {
                    Nil => λ h => ⟨h.left, ⟨h.right.left, ⟨h.right.right.left, trivial⟩⟩⟩,
                    Cons(_, _) => λ h => false_elim(h.right.right.right),
                },
            },
        },
    }
}

// The call's code: the moves, the number, then the kernel's step from the
// SYSCALL (`core`, each call's lemma above). One system call, which the
// world's one new exchange counts.
theorem sys_emits_by<M>(saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), spans: Spans,
    values: Valuation(), d: Nat, s0: MachineState<M>, prog: Prog, file: File, call: SysCall, facts: Type, placement: List<Place>, names: Nat,
    before, after: Now, moves: Lowered, keeps: Keeps<M>(values, file, True, moves),
    placed: moves.file.outputs_check(word_ports(call.words()), sys_registers()).IsTrue(), leaves: leaves_all(moves.code, body_kept(saves)).IsTrue(),
    clear: sys_clear(saves).IsTrue(),
    core: (s: MachineState<M>) → LinuxSyscallAt(site.linux(stack), s) → site.Resident(s.memory) →
        next_rip(s.rip, 2) = next_rip(site.origin, prog_len(sys_prog(prog, moves.code, call))) → before.io.Answerable() →
        SysAt<M>(saves, site, stack, spans, values, d, s0, moves.file.write(Rax, None), call, facts, before)(s) →
        site.linux_resumes(stack, Running(s, before.io),
            NowPost<M>(saves, site, stack, spans, values, d, s0, prog_len(sys_prog(prog, moves.code, call)),
                sys_after(moves.file.write(Rax, None), call.result()), after))):
    EmitsLinux<M>(saves, site, stack, spans, values, d, s0, prog, file, facts, before, after,
        Emitted(sys_prog(prog, moves.code, call), sys_after(moves.file.write(Rax, None), call.result()), placement, names)) {
    let first = At(prog, 0, Block(moves.code));
    let second = At(first, 0, Block(sys_number_code(call)));
    let out = sys_prog(prog, moves.code, call);
    let out_file = sys_after(moves.file.write(Rax, None), call.result());
    let fits = site.program.laid_out_fits(laid);
    let linux = site.linux_kernel(stack);
    let ids = call.words();
    let k: BitVec(64) = BitVec::ofNat(call.number());
    let apart = Bool::is_true_and(Rax.apart(body_kept(saves)), Rcx.apart(body_kept(saves)) && R11.apart(body_kept(saves)), clear).left;
    let into = moves_into<M>(saves, values, file, ids, sys_registers(), moves, keeps, placed, leaves);
    let pre = λ (g: Gprs) (m: M) => (file.Represents(values, g) ∧ facts) ∧
        (Kept(body_kept(saves), s0.gprs, g) ∧ stack.TrailBy(spans, now_in<M>(site.data, spans), d, s0.memory, before, m));
    let middle = λ (g: Gprs) (m: M) => ((moves.file.Represents(values, g) ∧ ArgsIn(words_of(values, ids), sys_registers(), g)) ∧ facts) ∧
        (Kept(body_kept(saves), s0.gprs, g) ∧ stack.TrailBy(spans, now_in<M>(site.data, spans), d, s0.memory, before, m));
    let ready = λ (g: Gprs) (m: M) => ((moves.file.write(Rax, None).Represents(values, g) ∧ (ArgsIn(words_of(values, ids), sys_registers(), g) ∧
        (read_gpr(Rax, g) = k))) ∧ facts) ∧
        (Kept(body_kept(saves), s0.gprs, g) ∧ stack.TrailBy(spans, now_in<M>(site.data, spans), d, s0.memory, before, m));
    let goal = NowPost<M>(saves, site, stack, spans, values, d, s0, prog_len(out), out_file, after);
    let world = NowWorld()(before);
    let counted = λ (within: out.Within(site.program)) => {
        let first_in: first.Within(site.program) = Prog::within_trans(Exists(2, refl), within);
        let second_in: second.Within(site.program) = Prog::within_trans(Exists(1, refl), within);
        let moved = site.moves_block(stack.writes, fits, first_in.witness, prog, 0, moves.code, first_in.proof,
            site.program.block_reads_at(laid, first_in.witness, prog, 0, moves.code, first_in.proof), pre, middle,
            λ s m held => {
                let landed = into(s, held.left.left);
                ⟨⟨⟨keeps(s, held.left.left, trivial), landed.left⟩, held.left.right⟩,
                 ⟨kept_trans(body_kept(saves), s0.gprs, s.gprs, execute_block_normal(moves.code, s).gprs, held.right.left, landed.right), held.right.right⟩⟩
            });
        let numbered = site.moves_block(stack.writes, fits, second_in.witness, first, 0, sys_number_code(call), second_in.proof,
            site.program.block_reads_at(laid, second_in.witness, first, 0, sys_number_code(call), second_in.proof), middle, ready,
            λ s m held => ⟨⟨⟨moves.file.represents_write(values, s.gprs, Rax, None, k, held.left.left.left, trivial),
                    ⟨sys_args_kept(words_of(values, ids), s.gprs, k, held.left.left.right), refl⟩⟩, held.left.right⟩,
                ⟨kept_trans(body_kept(saves), s0.gprs, s.gprs, write_gpr(Rax, k, s.gprs), held.right.left, kept_write(body_kept(saves), Rax, k, s.gprs, apart)),
                 held.right.right⟩⟩);
        let called = site.claims_resumes(stack.writes, linux, prog_len(second),
            λ (r: Running<M, Io>) => ready(r.state.gprs, r.state.memory) ∧ world(r.io), goal,
            λ s w here resident held => j(sym(held.right.left), λ x _ => site.linux_resumes(stack, Running(s, x), goal),
                core(s, site.item_fetched(fits, s, resident, within.witness, second, 0, Syscall, within.proof, here), resident,
                    trans(cong_fn<BitVec(64), BitVec(64)>(λ x => next_rip(x, 2), here), rip_compose(site.origin, prog_len(second), 2)),
                    j(held.right.left, λ x _ => x.Answerable(), held.right.right), held.left)));
        site.claims_after_moves(stack.writes, linux, 1, 0, prog_len(prog), prog_len(first), λ (s: MachineState<M>) => pre(s.gprs, s.memory),
            λ (s: MachineState<M>) => middle(s.gprs, s.memory), world, goal, moved,
            site.claims_after_moves(stack.writes, linux, 1, 0, prog_len(first), prog_len(second), λ (s: MachineState<M>) => middle(s.gprs, s.memory),
                λ (s: MachineState<M>) => ready(s.gprs, s.memory), world, goal, numbered, called))
    };
    emits_linux_exact<M>(saves, site, stack, spans, values, d, s0, prog, file, facts, before, after, Emitted(out, out_file, placement, names), 1,
        ⟨Exists(3, refl), counted⟩)
}

// The kernel's step for either call.
theorem sys_core<M>(saves: Nat, site: Site<M>, stack: Stack<M>(site.fetch, site.data), top: Nat, spans: Spans,
    loan: Loan<M>(site.fetch, site.data, stack, top, spans), blocks: Blocks, lent: blocks.Lent(spans),     values: Valuation(), d: Nat, s0: MachineState<M>, file: File, before, after: Now, clear: sys_clear(saves).IsTrue(), to: Nat):
    (call: SysCall) → (s: MachineState<M>) → LinuxSyscallAt(site.linux(stack), s) → site.Resident(s.memory) → next_rip(s.rip, 2) = next_rip(site.origin, to) →
        before.io.Answerable() → SysAt<M>(saves, site, stack, spans, values, d, s0, file, call, call.Lands(spans, blocks, values, before, after), before)(s) →
        site.linux_resumes(stack, Running(s, before.io), NowPost<M>(saves, site, stack, spans, values, d, s0, to, sys_after(file, call.result()), after)) {
    λ call => match call {
        Read(fd, buf, len, result) => λ s fetched resident arrive answerable held => sys_read_resumes<M>(saves, site, stack, top, spans, loan, blocks, lent,
            values, d, s0, file, fd, buf, len, result, before, after, clear, to, s, fetched, resident, arrive, answerable, held),
        Write(fd, buf, len, result) => λ s fetched resident arrive answerable held => sys_write_resumes<M>(saves, site, stack, spans, blocks, values, d, s0,
            file, fd, buf, len, result, before, after, clear, to, s, fetched, resident, arrive, answerable, held),
    }
}

// A system call's code meets its meaning.
theorem sys_emits<M>(saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), top: Nat, spans: Spans,
    loan: Loan<M>(site.fetch, site.data, stack, top, spans), blocks: Blocks, lent: blocks.Lent(spans),     values: Valuation(), d: Nat, s0: MachineState<M>, prog: Prog, file: File, call: SysCall, placement: List<Place>, names: Nat, before, after: Now):
    MayEmitLinux<M>(saves, site, stack, spans, values, d, s0, prog, file, call.Lands(spans, blocks, values, before, after), before, after,
        emit_sys(saves, prog, file, call, placement, names)) {
    let facts = call.Lands(spans, blocks, values, before, after);
    let entries = sys_entries(file, call);
    let registers = sys_targets(file, call);
    (match file.move_outputs(entries, registers) as λ o => MayKeep<M>(values, file, True, o) →
        MayEmitLinux<M>(saves, site, stack, spans, values, d, s0, prog, file, facts, before, after, match o {
            None => None,
            Some(moves) => match moves.file.outputs_check(word_ports(call.words()), sys_registers()) &&
                (leaves_all(moves.code, body_kept(saves)) && sys_clear(saves)) {
                False => None,
                True => Some(Emitted(sys_prog(prog, moves.code, call), sys_after(moves.file.write(Rax, None), call.result()), placement, names)),
            },
        }) {
        None => λ _ => trivial,
        Some(moves) => λ keeps => {
            let placed = moves.file.outputs_check(word_ports(call.words()), sys_registers());
            let leaves = leaves_all(moves.code, body_kept(saves));
            (match placed && (leaves && sys_clear(saves)) as λ v => (placed && (leaves && sys_clear(saves))) = v →
                MayEmitLinux<M>(saves, site, stack, spans, values, d, s0, prog, file, facts, before, after, match v {
                    False => None,
                    True => Some(Emitted(sys_prog(prog, moves.code, call), sys_after(moves.file.write(Rax, None), call.result()), placement, names)),
                }) {
                False => λ _ => trivial,
                True => λ ok => {
                    let parts = Bool::is_true_and(placed, leaves && sys_clear(saves), Bool::is_true_of_eq(ok));
                    let rest = Bool::is_true_and(leaves, sys_clear(saves), parts.right);
                    sys_emits_by<M>(saves, site, laid, stack, spans, values, d, s0, prog, file, call, facts, placement, names, before, after, moves, keeps,
                        parts.left, rest.left, rest.right,
                        sys_core<M>(saves, site, stack, top, spans, loan, blocks, lent, values, d, s0, moves.file.write(Rax, None), before, after,
                            rest.right, prog_len(sys_prog(prog, moves.code, call)), call))
                },
            })(refl)
        },
    })(move_outputs_keeps<M>(values, entries, file, registers))
}

// How a run stops short of done at a fuel (docs/language/ownership-design.md
// §17.7): still going with the world so far, or exited with a status and
// the world. The going side and the exited side of the lowering are one
// development over it: the same facts, read off the same runs, and the same
// code theorems, at a stop.
inductive Stop { StopGoing(io: Io), StopExited(status: BitVec(64), io: Io) }

fn Ran::stopped<T>(self r: Ran<T>) → Option<Stop> {
    match r { Done(_) => None, Exited(status, io) => Some(StopExited(status, io)), Going(io) => Some(StopGoing(io)), Stuck(_) => None }
}

// The world at the stop.
fn Stop::world(self x: Stop) → Io { match x { StopGoing(io) => io, StopExited(_, io) => io } }

// What a loop out of fuel in the world `io` is, at the stop: going, it is
// the stop where `io` is its world; exited, it is not.
fn Stop::Zero(self x: Stop, io: Io) → Type { match x { StopGoing(o) => io = o, StopExited(_, _) => False } }

fn Stop::ZeroAt(self x: Stop) → Now → Type { λ (now: Now) => x.Zero(now.io) }

// What an exit with the word `w` in the world `io` is, at the stop.
fn Stop::Exits(self x: Stop, w: BitVec(64), io: Io) → Type { match x { StopGoing(_) => False, StopExited(status, o) => (w = status) ∧ (io = o) } }

// The machine steps the code is claimed to take by the stop: going at
// `n`, the `n` turns and calls the fuel paid for; exited, none.
fn Stop::least(self x: Stop, n: Nat) → Nat { match x { StopGoing(_) => n, StopExited(_, _) => 0 } }

// The state the code reaches at the stop, in its world: going, any;
// exited, at the exit call with the status.
fn Stop::Reached<M>(self x: Stop, site: Site<M>, stack: Stack<M>(site.fetch, site.data)) → Running<M, Io> → Type {
    match x {
        StopGoing(o) => λ (r: Running<M, Io>) => r.io = o,
        StopExited(status, o) => λ (r: Running<M, Io>) => (LinuxSyscallAt(site.linux(stack), r.state) ∧ LinuxExits(r.state, status)) ∧ (r.io = o),
    }
}

theorem Stop::reached_world<M>(self x: Stop, site: Site<M>, stack: Stack<M>(site.fetch, site.data), r: Running<M, Io>):
    x.Reached(site, stack)(r) → r.io = x.world() {
    match x { StopGoing(_) => λ h => h, StopExited(_, _) => λ h => h.right }
}

// The system calls from `before` to the stop: as many as its world gained.
fn Stop::calls_from(self x: Stop, before: Now) → Nat { calls_between(before, Now(before.heap, x.world())) }

theorem Stop::least_le(self x: Stop, n: Nat): x.least(n) <= n { match x { StopGoing(_) => n.le_refl(), StopExited(_, _) => trivial } }

theorem Stop::least_succ(self x: Stop, n: Nat): x.least(Succ(n)) <= 1 + x.least(n) {
    match x { StopGoing(_) => { omega }, StopExited(_, _) => trivial }
}

theorem Stop::least_pred(self x: Stop, n: Nat): x.least(n) <= 1 + x.least(n.pred()) {
    match n { Zero => { let low = x.least_le(0); omega }, Succ(m) => x.least_succ(m) }
}

theorem Stop::least_mono(self x: Stop, n, m: Nat, le: n <= m): x.least(n) <= x.least(m) {
    match x { StopGoing(_) => le, StopExited(_, _) => trivial }
}

theorem Stop::reached_zero<M>(self x: Stop, site: Site<M>, stack: Stack<M>(site.fetch, site.data), r: Running<M, Io>, zero: x.Zero(r.io)):
    x.Reached(site, stack)(r) {
    (match x as λ y => y.Zero(r.io) → y.Reached(site, stack)(r) { StopGoing(_) => λ e => e, StopExited(_, _) => λ never => false_elim(never) })(zero)
}

// A run that is going at `io` stops at `x` only where `x` is that.
theorem Stop::zero_of(self x: Stop, io: Io, e: Some(StopGoing(io)) = Some(x)): x.Zero(io) {
    j(Option::some_inj(StopGoing(io), x, e), λ y _ => y.Zero(io), refl)
}

theorem Ran::then_stopped<T, U>(r: Ran<T>, k: T → Ran<U>, x: Stop): r.then(k).stopped() = Some(x) →
    (r.stopped() = Some(x)) ∨ Exists<T>(λ a => (r = Done(a)) ∧ (k(a).stopped() = Some(x))) {
    match r {
        Done(a) => λ h => Inr(Exists(a, ⟨refl, h⟩)),
        Exited(_, _) => λ h => Inl(h),
        Going(_) => λ h => Inl(h),
        Stuck(_) => λ h => absurd(h),
    }
}

// What is read off a value and then done never stops short.
theorem Ran::done_not_stopped<T, U>(o: Option<T>, io: Io, k: T → U, x: Stop, stopped: Ran::of(o, io).then(λ (v: T) => Done(k(v))).stopped() = Some(x)):
    False {
    match o { None => absurd(stopped), Some(_) => absurd(stopped) }
}

theorem Ran::of_stopped<T>(o: Option<T>, io: Io, x: Stop): Ran::of(o, io).stopped() = Some(x) → False {
    match o { None => λ h => absurd(h), Some(_) => λ h => absurd(h) }
}

// What the routines answer that stop at `x`, as `answers` is what they
// answer done: routine `f` on values and a heap, stopped at the fuel the
// call is made with.
fn RoutineStops() → Type<1> { Nat → List<Value> → Heap → Io → Type }

// A loop stopped, from `state` over `from`: the first pass at `fuel`, its
// own valuation binding the state to the parameters, stopped itself; or
// done, its exit bit clear, and `later` from the state it leaves (the
// passes after a turn, as `loop_later` runs them). Out of fuel, `zero`.
fn PassStop(Pass: Valuation() → Now → Now → Type, PassStops: Valuation() → Nat → Now → Type, parameters: List<Typed>, exit: Nat, next: List<Typed>,
    fuel: Nat, later: List<BitVec(64)> → Now → Type, state: List<BitVec(64)>, from: Now) → Type {
    Exists<Valuation()>(λ v => (words_of(v, typed_ids(parameters)) = state) ∧ (PassStops(v, fuel, from) ∨
        Exists<Now>(λ mid => Pass(v, from, mid) ∧ ((v(1, exit).head_bit() = False) ∧ later(words_of(v, typed_ids(next)), mid)))))
}

fn LaterStop(Pass: Valuation() → Now → Now → Type, PassStops: Valuation() → Nat → Now → Type, parameters: List<Typed>, exit: Nat, next: List<Typed>,
    zero: Now → Type, fuel: Nat) → List<BitVec(64)> → Now → Type {
    match fuel {
        Zero => λ state from => zero(from),
        Succ(rest) => λ state from => PassStop(Pass, PassStops, parameters, exit, next, rest, LaterStop(Pass, PassStops, parameters, exit, next, zero, rest),
            state, from),
    }
}

fn PassesStop(Pass: Valuation() → Now → Now → Type, PassStops: Valuation() → Nat → Now → Type, parameters: List<Typed>, exit: Nat, next: List<Typed>,
    zero: Now → Type, fuel: Nat, state: List<BitVec(64)>, from: Now) → Type {
    PassStop(Pass, PassStops, parameters, exit, next, fuel, LaterStop(Pass, PassStops, parameters, exit, next, zero, fuel), state, from)
}

// A region's run stopped at `x` at `fuel`, at the valuation, from `before`:
// a sequence's first part stopped, or done and its rest stopped from where
// it left; the arm the bit picks stopped; a call to a routine stopped on the
// valuation's words at its arguments; a loop's passes stopped, a loop out of
// fuel being `x.ZeroAt()`; an exit with the word at its status, `x.Exits`. A
// leaf never stops.
fn Body::Stops(self body: Body, spans: Spans, blocks: Blocks, values: Valuation(), answers: RoutineAnswers(), goes: RoutineStops(), x: Stop, spare: Nat,
    fuel: Nat, before: Now) → Type {
    match body {
        Leaf(_) => False,
        Seq(first, rest) => first.Stops(spans, blocks, values, answers, goes, x, spare, fuel, before) ∨
            Exists<Now>(λ mid => first.Holds(spans, blocks, values, answers, spare, before, mid) ∧
                rest.Stops(spans, blocks, values, answers, goes, x, spare, fuel, mid)),
        Branch(condition, yes, no) => match values(1, condition).head_bit() {
            True => yes.Stops(spans, blocks, values, answers, goes, x, spare, fuel, before),
            False => no.Stops(spans, blocks, values, answers, goes, x, spare, fuel, before),
        },
        Call(callee, arguments, _) => Exists<List<Value>>(λ args =>
            (lower_values(spans, args) = words_of(values, typed_ids(arguments))) ∧ goes(callee, args, before.heap, before.io)),
        Loop(inputs, parameters, inner, exit, next, _) => PassesStop(λ (v: Valuation()) (from: Now) (to: Now) =>
                inner.Holds(spans, blocks, v, answers, spare, from, to),
            λ (v: Valuation()) (k: Nat) (from: Now) => inner.Stops(spans, blocks, v, answers, goes, x, spare, k, from), parameters, exit, next,
            x.ZeroAt(), fuel, words_of(values, typed_ids(inputs)), before),
        Sys(_) => False,
        Exit(status) => x.Exits(values(64, status), before.io),
    }
}

// A call's code: FunctionIR's (`File::emit_call`, lending no buffers),
// proved by `File::emit_call_steps_claim` at the ceiling with each CALL by
// `call_now_step`. Unguarded, the callee's room and the call's 24 bytes are
// in the caller's (`fit`); a callee's escape is the caller's (`carries`).
theorem call_now_emits<M>(saves, slots: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data),
    top: Nat, spans: Spans, loan: Loan<M>(site.fetch, site.data, stack, top, spans), rooms: Nat → Nat, bound, avail: Nat, answers: RoutineAnswers(),
    floored: Bool, spends: Nat → Nat → Running<M, Io> → Type, callees: CalleesReturn<M>(site, stack, spans, rooms, floored, top, bound, answers, spends), c: Ceiling<M>,
    blocks: Blocks, values: Valuation(), spare: Nat, d: Nat, s0: MachineState<M>, rsp0: read_gpr(Rsp, s0.gprs) = stack.at(d),
    floor: floored.IsTrue() → (gp: Gprs) → Kept(body_kept(saves), s0.gprs, gp) → read_gpr(Rbp, gp) = stack.low, room: avail <= d,
    fits: d + 8 * slots <= stack.size, under: (d + 8 * slots) + 8 <= top, prog: Prog, file: File, callee: Nat, arguments, results: List<Typed>,
    fit: rooms(callee) + 24 <= avail,
    carries: callee + 1 <= bound → (count: Nat) → count <= 2 → (t: Running<M, Io>) → spends(callee, (d - 8 * count) - 8)(t) → c.esc(t),
    placement: List<Place>, names: Nat, before, after: Now):
    MayEmitNow<M>(saves, site, stack, spans, c, values, d + 8 * slots, s0, prog, file,
        Body::Call(callee, arguments, results).Holds(spans, blocks, values, answers, spare, before, after), before, after,
        file.emit_call(slots, prog, callee, typed_ids(arguments), call_result(results, spare), call_also(results), placement, names, bound, [], [])) {
    let deep: (24 <= d) = { omega };
    file.emit_call_steps_claim_kept<M, Now, Io>(saves, slots, site, laid, stack, top, bound, spans, now_in<M>(site.data, spans), NowWorld(),
        site.ceiling(stack, c), c.count(), 0, now_in_stable<M>(stack, top, spans, loan), values, d, s0, rsp0, fits, under, deep, prog,
        callee, typed_ids(arguments), call_result(results, spare), call_also(results), placement, names, [], [],
        Body::Call(callee, arguments, results).Holds(spans, blocks, values, answers, spare, before, after) ∧ c.Under(after), before, after,
        λ eight slotted below _ count few moved facts g0 _ _ kept k at => call_now_step<M>(call_saves(placement), slots, eight, slotted, site, laid, stack,
            top, spans, loan, rooms, bound, answers, floored, spends, callees, c, values, spare, d, s0, fits, under, moved, callee, deep, below, count, few,
            { omega }, carries(below, count, few), arguments, results, before, after, facts.left.witness, facts.left.proof.witness,
            facts.left.proof.proof.left, facts.left.proof.proof.right.left, facts.left.proof.proof.right.right, facts.right, g0, k, at, λ fl => floor(fl, g0, kept)))
}

// An exit's code: the status, from the register the file says holds it,
// into RDI, sixty (`exit`) into RAX, and SYSCALL (Linux's `LinuxExits`).
// The code after it is never reached, and the file is left as it was.
fn exit_code(register: Gpr) → List<Instruction> { [MovRR(Rdi, register), MovRI(Rax, BitVec::ofNat(60))] }

fn emit_exit(prog: Prog, file: File, status: Nat, placement: List<Place>, names: Nat) → Option<Emitted> {
    match file.find(Held(status, Word)) {
        None => None,
        Some(found) => Some(Emitted(At(At(prog, 0, Block(exit_code(found.register))), 0, Syscall), file, placement, names)),
    }
}

// Code whose facts cannot hold: only its extent.
theorem emit_exit_emits<M>(saves: Nat, site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, values: Valuation(), d: Nat,
    s0: MachineState<M>, prog: Prog, file: File, status: Nat, placement: List<Place>, names: Nat, before, after: Now):
    MayEmitLinux<M>(saves, site, stack, spans, values, d, s0, prog, file, False, before, after, emit_exit(prog, file, status, placement, names)) {
    match file.find(Held(status, Word)) as λ o => MayEmitLinux<M>(saves, site, stack, spans, values, d, s0, prog, file, False, before, after, match o {
        None => None,
        Some(found) => Some(Emitted(At(At(prog, 0, Block(exit_code(found.register))), 0, Syscall), file, placement, names)),
    }) {
        None => trivial,
        Some(found) => ⟨Exists(2, refl), λ within => site.claims_absurd(stack.writes, site.linux_kernel(stack), calls_between(before, after), 0,
            prog_len(prog), NowPre<M>(saves, site, stack, spans, values, d, s0, file, False, before),
            NowPost<M>(saves, site, stack, spans, values, d, s0, prog_len(At(At(prog, 0, Block(exit_code(found.register))), 0, Syscall)), file, after),
            λ r held => held.left.left.right)⟩,
    }
}

// ---------------------------------------------------------------------------
// The out-of-room guard (ownership-design §17.9, §17.10)
//
// A call whose callee shares its component of the call graph is guarded:
// at the call node's start, before any of the call's code, the floor (RBP,
// `floor_register`) is subtracted from the stack pointer, the room left is
// compared with what the call needs below the frame (its words on the
// stack, the return address and the callee's room by routine), and the
// floor is added back; with less room, the JCC goes to the stop. The stop
// uses no stack (two moves and the exit's SYSCALL), so leaving RSP moved
// on that path is sound. No register is written on the path that goes on,
// so the call's code after it is FunctionIR's, unchanged.

// The most a guard's immediate holds, sign-extended.
fn guard_most() → Nat { 2147483647 }

fn guard_test(need: Nat) → Test { Compare(B, Rsp, RightImm32(BitVec::ofNat(need))) }

// RSP less the floor: the room left, which cannot wrap, the stack pointer
// being at or above the floor.
fn guard_lower() → Instruction { SubRR(Rsp, floor_register()) }

fn guard_raise() → Instruction { AddRR(Rsp, floor_register()) }

fn Prog::guarded(self prog: Prog, need, stop: Nat) → Prog {
    At(At(prog, 0, Block([guard_lower()])).branched_by(guard_test(need), stop, False), 0, Block([guard_raise()]))
}

// The stop: the reserved status (the contract's), Linux's exit; laid out
// once, after the routines.
fn stop_code() → List<Instruction> { [MovRI(Rdi, BitVec::ofNat(spent_status())), MovRI(Rax, BitVec::ofNat(60))] }

fn Prog::stopped_at(self prog: Prog, stop: Nat) → Prog { At(At(prog, stop, Block(stop_code())), 0, Syscall) }

// ---------------------------------------------------------------------------
// The guard's claim (issues/bytes-level-out-of-room.md, step 3)
//
// From the call node's start, with the floor in RBP and the stack pointer
// `d` bytes above it: where the call's need fits in `d`, the guard arrives
// after its ADD with every register as it was; otherwise it escapes, at the
// stop's SYSCALL, with the reserved status in RDI and the exit's number in
// RAX, the memory and the world as they were.

// Writing a register twice keeps the second.
theorem write_gpr_twice(register: Gpr, a, b: BitVec(64), g: Gprs): write_gpr(register, a, write_gpr(register, b, g)) = write_gpr(register, a, g) {
    match register {
        Rax => refl, Rcx => refl, Rdx => refl, Rbx => refl, Rsp => refl, Rbp => refl, Rsi => refl, Rdi => refl,
        R8 => refl, R9 => refl, R10 => refl, R11 => refl, R12 => refl, R13 => refl, R14 => refl, R15 => refl,
    }
}

// An address `k` bytes on, read as a number, where it does not wrap.
theorem rip_toNat(low: BitVec(64), k: Nat, fits: low.toNat() + k < Nat::pow(2, 64)): next_rip(low, k).toNat() = low.toNat() + k {
    let count: (BitVec::ofNat(k, n := 64).toNat() = k) = BitVec::toNat_ofNat(64, k, { omega });
    let as_add: (next_rip(low, k) = low.add(BitVec::ofNat(k))) =
        trans(BitVec::cong_iterate_increment_count(64, low, sym(count)), BitVec::iter_add_eq_add(64, low, BitVec::ofNat(k)));
    let bounded: (low.toNat() + BitVec::ofNat(k, n := 64).toNat() < Nat::pow(2, 64)) = { omega };
    trans(cong_fn<BitVec(64), Nat>(λ x => x.toNat(), as_add), trans(BitVec::toNat_add_mod(64, low, BitVec::ofNat(k)),
        trans((low.toNat() + BitVec::ofNat(k, n := 64).toNat()).mod_of_lt(Nat::pow(2, 64), bounded),
            cong_fn<Nat, Nat>(λ x => low.toNat() + x, count))))
}

// Every offset of the stack lies below the canonical boundary from its
// lowest address: an offset past it would pass the boundary's own address,
// which no stack word may be at.
theorem Stack::offset_small<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data), d: Nat,
    inside: d + 8 <= stack.size): stack.low.toNat() + d < Nat::pow(2, 47) {
    let top: (Nat::pow(2, 47) < Nat::pow(2, 64)) = Nat::leb_sound(Nat::pow(2, 47) + 1, Nat::pow(2, 64), trivial);
    let base: (stack.low.toNat() + 8 <= Nat::pow(2, 47)) = stack.canonical(0, { omega });
    match (stack.low.toNat() + d).lt_or_ge(Nat::pow(2, 47)) {
        Inl(below) => below,
        Inr(over) => {
            let gap = Nat::pow(2, 47) - stack.low.toNat();
            let at_gap: (stack.at(gap).toNat() = stack.low.toNat() + gap) = rip_toNat(stack.low, gap, { omega });
            let boundary: (stack.at(gap).toNat() + 8 <= Nat::pow(2, 47)) = stack.canonical(gap, { omega });
            false_elim({ omega })
        },
    }
}

// The room left, RSP less the floor, read as a number: `d`.
theorem Stack::room_word<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data), d: Nat,
    inside: d + 8 <= stack.size): stack.at(d).sub(stack.low).toNat() = d {
    let small = stack.offset_small(d, inside);
    let top: (Nat::pow(2, 47) < Nat::pow(2, 64)) = Nat::leb_sound(Nat::pow(2, 47) + 1, Nat::pow(2, 64), trivial);
    let as_add: (stack.at(d) = stack.low.add(BitVec::ofNat(d))) =
        trans(BitVec::cong_iterate_increment_count(64, stack.low, sym(BitVec::toNat_ofNat(64, d, { omega }))),
            BitVec::iter_add_eq_add(64, stack.low, BitVec::ofNat(d)));
    let moved: (stack.at(d).sub(stack.low) = BitVec::ofNat(d)) =
        trans(cong_fn<BitVec(64), BitVec(64)>(λ x => x.sub(stack.low), trans(as_add, BitVec::add_comm(64, stack.low, BitVec::ofNat(d)))),
            BitVec::add_sub_cancel(64, BitVec::ofNat(d), stack.low));
    trans(cong_fn<BitVec(64), Nat>(λ x => x.toNat(), moved), BitVec::toNat_ofNat(64, d, { omega }))
}

// The guard's immediate, sign-extended, is `need` where it is at most
// `guard_most()`.
theorem guard_immediate(need: Nat, most: need <= guard_most()): BitVec::ofNat(need, n := 32).sign_extend(32).toNat() = need {
    let low: (BitVec::ofNat(need, n := 32).toNat() = need) = BitVec::toNat_ofNat(32, need, { let m: (guard_most() = 2147483647) = refl; omega });
    let clear: (BitVec::ofNat(need, n := 32).sign_bit() = False) = BitVec::sign_bit_small(31, BitVec::ofNat(need, n := 32),
        j(sym(low), λ v _ => v < Nat::pow(2, 31), { let m: (guard_most() = 2147483647) = refl; omega }));
    trans(BitVec::sign_extend_clear_toNat(31, 32, BitVec::ofNat(need, n := 32), clear), low)
}

// RSP less the floor, in RSP: the guard's JCC is taken exactly where the
// room left is below the need.
fn guard_lowered(g: Gprs) → Gprs { write_gpr(Rsp, read_gpr(Rsp, g).sub(read_gpr(Rbp, g)), g) }

theorem guard_taken<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, stack: Stack<M>(fetch, data), d, need: Nat, inside: d + 8 <= stack.size,
    most: need <= guard_most(), g: Gprs, rsp: read_gpr(Rsp, g) = stack.at(d), rbp: read_gpr(Rbp, g) = stack.low):
    ((guard_test(need).taken(guard_lowered(g)) = True) → d < need) ∧ ((guard_test(need).taken(guard_lowered(g)) = False) → need <= d) {
    let left = read_gpr(Rsp, guard_lowered(g));
    let right = BitVec::ofNat(need, n := 32).sign_extend(32);
    let room: (left.toNat() = d) = trans(cong_fn<BitVec(64), Nat>(λ x => x.toNat(),
        trans(read_gpr_self(Rsp, read_gpr(Rsp, g).sub(read_gpr(Rbp, g)), g),
            trans(cong_fn<BitVec(64), BitVec(64)>(λ x => x.sub(read_gpr(Rbp, g)), rsp),
                cong_fn<BitVec(64), BitVec(64)>(λ x => stack.at(d).sub(x), rbp)))), stack.room_word(d, inside));
    let imm: (right.toNat() = need) = guard_immediate(need, most);
    let is: (guard_test(need).taken(guard_lowered(g)) = left.unsigned_lt_bit(right)) = refl;
    ⟨λ yes => { let lt = bitvec_omega::unsigned_true(64, left, right, trans(sym(is), yes)); omega },
     λ no => { let ge = bitvec_omega::unsigned_false(64, left, right, trans(sym(is), no)); omega }⟩
}

// The stop's SYSCALL, reached: resident, the reserved status and the
// exit's number in place.
fn Site::StopAt<M>(self site: Site<M>, at: Nat) → MachineState<M> → Type {
    λ t => ((t.rip = next_rip(site.origin, at)) ∧ site.Resident(t.memory)) ∧
        ((read_gpr(Rdi, t.gprs) = BitVec::ofNat(spent_status())) ∧ (read_gpr(Rax, t.gprs) = BitVec::ofNat(60)))
}

// The guard as a claim, at no system call and bound zero. Its escape is
// whatever `fires` makes of the stop reached from a start whose room is
// below the need.
theorem Site::guard_claims<M, W>(self site: Site<M>, writes: ByteWrites<M>, kernel: Kernel<M, W>, fits: FillsFit(site.program, no_fills()),
    stack: Stack<M>(site.fetch, site.data), prog: Prog, need, stop: Nat,
    lower_k: Nat, lower_at: asm_back(site.program, lower_k) = At(prog, 0, Block([guard_lower()])),
    test_k: Nat, test_at: asm_back(site.program, test_k) = At(prog, 0, Block([guard_lower()])).tested(guard_test(need)),
    branch_k: Nat, branch_at: asm_back(site.program, branch_k) = At(prog, 0, Block([guard_lower()])).branched_by(guard_test(need), stop, False),
    raise_k: Nat, raise_at: asm_back(site.program, raise_k) = prog.guarded(need, stop),
    stop_k: Nat, stop_prog: Prog, stop_at: asm_back(site.program, stop_k) = At(stop_prog, stop, Block(stop_code())),
    stop_lands: JccLands(asm_labels(site.program), prog_len(At(prog, 0, Block([guard_lower()])).tested(guard_test(need))), False, B, stop,
        prog_len(stop_prog)),
    d: Nat, inside: d + 8 <= stack.size, most: need <= guard_most(), pre: Gprs → M → W → Type, esc: Running<M, W> → Type,
    floored: (g: Gprs) → (m: M) → (w: W) → pre(g, m, w) → (read_gpr(Rsp, g) = stack.at(d)) ∧ (read_gpr(Rbp, g) = stack.low),
    fires: (r, t: Running<M, W>) → pre(r.state.gprs, r.state.memory, r.io) → t.state.memory = r.state.memory → t.io = r.io → d < need →
        site.StopAt(prog_len(stop_prog) + block_length(stop_code()), t.state) → esc(t)):
    site.ClaimsOr(writes, kernel, 0, 0, prog_len(prog), λ (r: Running<M, W>) => pre(r.state.gprs, r.state.memory, r.io),
        site.Arrived(prog_len(prog.guarded(need, stop)), λ (t: Running<M, W>) => pre(t.state.gprs, t.state.memory, t.io) ∧ (need <= d)), esc) {
    λ r here resident held => {
        let s = r.state;
        let g0 = s.gprs;
        let start = At(prog, 0, Block([guard_lower()]));
        let regs = floored(g0, s.memory, r.io, held);
        let goal = site.Arrived(prog_len(prog.guarded(need, stop)), λ (t: Running<M, W>) => pre(t.state.gprs, t.state.memory, t.io) ∧ (need <= d));
        // SUB RSP, RBP.
        let lowered = site.moves_block(writes, fits, lower_k, prog, 0, [guard_lower()], lower_at, refl,
            λ (g: Gprs) (m: M) => (g = g0) ∧ (m = s.memory), λ (g: Gprs) (m: M) => (g = guard_lowered(g0)) ∧ (m = s.memory),
            λ x m h => ⟨j(h.left, λ y _ => execute_block_normal([guard_lower()], x).gprs = guard_lowered(y), refl), h.right⟩)(s, here, resident,
            ⟨refl, refl⟩);
        let u = lowered.witness;
        let u_gprs: (u.gprs = guard_lowered(g0)) = lowered.proof.right.right.right.left;
        let u_memory: (u.memory = s.memory) = lowered.proof.right.right.right.right;
        // CMP RSP, need; JB stop.
        let found = site.test_by_steps(writes, fits, start, guard_test(need), stop, False, test_k, test_at, branch_k, branch_at, prog_len(stop_prog),
            stop_lands, u, lowered.proof.right.left, lowered.proof.right.right.left);
        let v = found.witness;
        let v_gprs: (v.gprs = guard_lowered(g0)) = trans(found.proof.right.left.left, u_gprs);
        let v_memory: (v.memory = s.memory) = trans(found.proof.right.left.right, u_memory);
        let to_v = machine_steps_trans(site.fetch, site.data, writes, s, u, v, lowered.proof.left, found.proof.left);
        let v_resident = j(sym(v_memory), λ memory _ => site.Resident(memory), resident);
        let which = guard_taken(stack, d, need, inside, most, g0, regs.left, regs.right);
        match taken: guard_test(need).taken(guard_lowered(g0)) {
            False => {
                // ADD RSP, RBP: every register back.
                let fits_d: (need <= d) = which.right(taken);
                let raised = site.moves_block(writes, fits, raise_k, start.branched_by(guard_test(need), stop, False), 0, [guard_raise()], raise_at, refl,
                    λ (g: Gprs) (m: M) => (g = guard_lowered(g0)) ∧ (m = s.memory), λ (g: Gprs) (m: M) => (g = g0) ∧ (m = s.memory),
                    λ x m h => {
                        let back: (read_gpr(Rsp, guard_lowered(g0)).add(read_gpr(Rbp, guard_lowered(g0))) = read_gpr(Rsp, g0)) =
                            BitVec::sub_add_cancel(64, read_gpr(Rsp, g0), read_gpr(Rbp, g0));
                        let restored: (write_gpr(Rsp, read_gpr(Rsp, g0), guard_lowered(g0)) = g0) =
                            trans(write_gpr_twice(Rsp, read_gpr(Rsp, g0), read_gpr(Rsp, g0).sub(read_gpr(Rbp, g0)), g0), write_gpr_held(Rsp, g0));
                        let at_x: (write_gpr(Rsp, read_gpr(Rsp, x.gprs).add(read_gpr(Rbp, x.gprs)), x.gprs) =
                            write_gpr(Rsp, read_gpr(Rsp, guard_lowered(g0)).add(read_gpr(Rbp, guard_lowered(g0))), guard_lowered(g0))) =
                            j(sym(h.left), λ y _ => write_gpr(Rsp, read_gpr(Rsp, y).add(read_gpr(Rbp, y)), y) =
                                write_gpr(Rsp, read_gpr(Rsp, guard_lowered(g0)).add(read_gpr(Rbp, guard_lowered(g0))), guard_lowered(g0)), refl);
                        ⟨trans(at_x, trans(cong_fn<BitVec(64), Gprs>(λ w => write_gpr(Rsp, w, guard_lowered(g0)), back), restored)), h.right⟩
                    })(v, found.proof.right.right.left(taken), v_resident, ⟨v_gprs, v_memory⟩);
                let t = raised.witness;
                let t_gprs: (t.gprs = g0) = raised.proof.right.right.right.left;
                let t_memory: (t.memory = s.memory) = raised.proof.right.right.right.right;
                site.performs_or_steps(writes, kernel, goal, esc, r, t, machine_steps_trans(site.fetch, site.data, writes, s, v, t, to_v, raised.proof.left),
                    ⟨⟨raised.proof.right.left, raised.proof.right.right.left⟩,
                     ⟨j(sym(t_gprs), λ g _ => pre(g, t.memory, r.io), j(sym(t_memory), λ m _ => pre(g0, m, r.io), held)), fits_d⟩⟩)
            },
            True => {
                // The stop: the status, the exit's number, the SYSCALL.
                let short: (d < need) = which.left(taken);
                let stopped = site.moves_block(writes, fits, stop_k, stop_prog, stop, stop_code(), stop_at, refl,
                    λ (g: Gprs) (m: M) => m = s.memory,
                    λ (g: Gprs) (m: M) => ((read_gpr(Rdi, g) = BitVec::ofNat(spent_status())) ∧ (read_gpr(Rax, g) = BitVec::ofNat(60))) ∧ (m = s.memory),
                    λ x m h => ⟨⟨refl, refl⟩, h⟩)(v, found.proof.right.right.right(taken), v_resident, v_memory);
                let t = stopped.witness;
                let t_memory: (t.memory = s.memory) = stopped.proof.right.right.right.right;
                let steps = machine_steps_trans(site.fetch, site.data, writes, s, v, t, to_v, stopped.proof.left);
                site.performs_or_escape(writes, kernel, goal, esc, 0, 0, r, t, steps.witness, steps.proof,
                    fires(r, Running(t, r.io), held, t_memory, refl, short,
                        ⟨⟨stopped.proof.right.left, stopped.proof.right.right.left⟩, stopped.proof.right.right.right.left⟩))
            },
        }
    }
}

// The exit at the reserved status, reached: the stop's SYSCALL as Linux
// reads it.
fn Site::SpentExit<M>(self site: Site<M>, stack: Stack<M>(site.fetch, site.data)) → Running<M, Io> → Type {
    λ (t: Running<M, Io>) => LinuxSyscallAt(site.linux(stack), t.state) ∧ LinuxExits(t.state, BitVec::ofNat(spent_status()))
}

// RBP kept by a body that saves at most five: RBP is the last a placement
// saves.
theorem kept_rbp(saves: Nat, few: saves <= 5, a, b: Gprs, kept: Kept(body_kept(saves), a, b)): read_gpr(Rbp, b) = read_gpr(Rbp, a) {
    (match saves as λ k => k <= 5 → Kept(body_kept(k), a, b) → read_gpr(Rbp, b) = read_gpr(Rbp, a) {
        Zero => λ _ h => h.right.right.right.right.right.right.left,
        Succ(s1) => match s1 {
            Zero => λ _ h => h.right.right.right.right.right.left,
            Succ(s2) => match s2 {
                Zero => λ _ h => h.right.right.right.right.left,
                Succ(s3) => match s3 {
                    Zero => λ _ h => h.right.right.right.left,
                    Succ(s4) => match s4 {
                        Zero => λ _ h => h.right.right.left,
                        Succ(s5) => match s5 {
                            Zero => λ _ h => h.right.left,
                            Succ(s6) => λ le _ => false_elim({ omega }),
                        },
                    },
                },
            },
        },
    })(few, kept)
}

// A call's code is emitted only for a callee below `bound`
// (`File::emit_call_saving`'s first test).
theorem emit_call_below(file: File, slots: Nat, prog: Prog, callee: Nat, arguments: List<Nat>, result: Nat, also: List<Nat>, placement: List<Place>,
    names, bound: Nat, counts: List<Nat>, homes: List<Lent>, out: Emitted,
    emitted: file.emit_call(slots, prog, callee, arguments, result, also, placement, names, bound, counts, homes) = Some(out)): callee + 1 <= bound {
    let rest = args_lend(homes, lent_count(counts, callee), 0, arguments) && (arguments.drop(6).len().leb(2) &&
        answer_registers().take(also.len()).clear_of(call_saves(placement)));
    let staged = file.emit_call_staged(call_saves(placement), file.write(Rsp, None), prog, callee, arguments, result, also, after_saves(placement), names);
    let tested: ((callee + 1).leb(bound).IsTrue()) = (match saves_ok(slots, call_saves(placement)) as λ b =>
        (match b { False => None, True => file.emit_call_saving(call_saves(placement), prog, callee, arguments, result, also, after_saves(placement), names,
            bound, counts, homes) }) = Some(out) → (callee + 1).leb(bound).IsTrue() {
        False => λ never => absurd(never),
        True => λ e => (match (callee + 1).leb(bound) as λ b => (match b && rest { False => None, True => staged }) = Some(out) → b.IsTrue() {
            False => λ never => absurd(never),
            True => λ _ => trivial,
        })(e),
    })(emitted);
    (callee + 1).leb_sound(bound, tested)
}

// A guarded call's code: the guard, then FunctionIR's call. Where the
// callee's room and the call's 24 bytes fit in `d` the guard goes on and
// the call is `call_now_step`'s; otherwise it is spent at the stop, the
// stop's world the call's, under the ceiling (the answer's world extends
// it, `grows`), and `spent` reads the caller's escape off it. The guard's
// call is the escaping kernel's one step more, read back to the ceiling.
theorem guarded_call_emits<M>(saves, slots: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data),
    top: Nat, spans: Spans, loan: Loan<M>(site.fetch, site.data, stack, top, spans), rooms: Nat → Nat, bound: Nat, answers: RoutineAnswers(),
    grows: AnswersExtend(answers), floored: Bool, spends: Nat → Nat → Running<M, Io> → Type,
    callees: CalleesReturn<M>(site, stack, spans, rooms, floored, top, bound, answers, spends), c: Ceiling<M>, blocks: Blocks, values: Valuation(), spare: Nat,
    d: Nat, s0: MachineState<M>, rsp0: read_gpr(Rsp, s0.gprs) = stack.at(d),
    floor: (g: Gprs) → Kept(body_kept(saves), s0.gprs, g) → read_gpr(Rbp, g) = stack.low, fits: d + 8 * slots <= stack.size,
    under: (d + 8 * slots) + 8 <= top, prog: Prog, file: File, callee: Nat, arguments, results: List<Typed>, stop_name: Nat, stop_prog: Prog,
    stop_in: stop_prog.stopped_at(stop_name + 1).Within(site.program), most: 24 + rooms(callee) <= guard_most(), before, after: Now,
    spent: callee + 1 <= bound → (args: List<Value>) → (a: Answer) → answers(callee, args, before.heap, before.io, a) → d < 24 + rooms(callee) →
        (t: Running<M, Io>) → site.SpentExit(stack)(t) → c.esc(t),
    carries: callee + 1 <= bound → (count: Nat) → count <= 2 → (t: Running<M, Io>) → spends(callee, (d - 8 * count) - 8)(t) → c.esc(t),
    placement: List<Place>, names: Nat):
    MayEmitNow<M>(saves, site, stack, spans, c, values, d + 8 * slots, s0, prog, file,
        Body::Call(callee, arguments, results).Holds(spans, blocks, values, answers, spare, before, after), before, after,
        file.emit_call(slots, prog.guarded(24 + rooms(callee), stop_name + 1), callee, typed_ids(arguments), call_result(results, spare),
            call_also(results), placement, names, bound, [], [])) {
    let need = 24 + rooms(callee);
    let stop = stop_name + 1;
    let guarded = prog.guarded(need, stop);
    let program = site.program;
    let mem = now_in<M>(site.data, spans);
    let kernel = site.ceiling(stack, c);
    let linux = site.linux_kernel(stack);
    let w = d + 8 * slots;
    let facts = Body::Call(callee, arguments, results).Holds(spans, blocks, values, answers, spare, before, after) ∧ c.Under(after);
    let pre_g = λ (g: Gprs) (m: M) (io: Io) => ((file.Represents(values, g) ∧ facts) ∧ (Kept(body_kept(saves), s0.gprs, g) ∧
        stack.TrailBy(spans, mem, w, s0.memory, before, m))) ∧ NowWorld()(before, io);
    let pre = NowPre<M>(saves, site, stack, spans, values, w, s0, file, facts, before);
    let into_guarded: prog.Within(guarded) = Exists(4, refl);
    let lower_prog = At(prog, 0, Block([guard_lower()]));
    let tested_prog = lower_prog.tested(guard_test(need));
    let branched_prog = lower_prog.branched_by(guard_test(need), stop, False);
    let block_prog = At(stop_prog, stop, Block(stop_code()));
    let call_out = file.emit_call(slots, guarded, callee, typed_ids(arguments), call_result(results, spare), call_also(results), placement, names, bound,
        [], []);
    // The guard's claim, at the escaping kernel, from the region's start to
    // the guard's end: every register, the memory and the world as they
    // were, and the need fitting; or spent.
    let guard = λ (below: callee + 1 <= bound) (within: guarded.Within(program)) => {
        let fits_prog = program.laid_out_fits(laid);
        let unique = program.laid_out_unique(laid);
        let lands = program.laid_out_lands(laid);
        let branched_in = branched_prog.within_before(0, Block([guard_raise()]), program, within);
        let tested_in = tested_prog.within_before(0, jcc_item(False, B, stop), program, branched_in);
        let lower_in = lower_prog.within_before(0, Block([guard_test(need).instruction()]), program, tested_in);
        let block_in = block_prog.within_before(0, Syscall, program, stop_in);
        let stop_lands = j(label_target(block_in.witness, program, stop_prog, stop_name, Block(stop_code()), unique, block_in.proof),
            λ to _ => JccLands(asm_labels(program), prog_len(tested_prog), False, B, stop, to),
            jcc_item_lands(asm_labels(program), branched_in.witness, program, tested_prog, 0, False, B, stop, lands, branched_in.proof));
        site.claims_escaping(stack.writes, linux, 0, 0, prog_len(prog), pre, site.Arrived(prog_len(guarded), λ (t: Running<M, Io>) =>
                pre_g(t.state.gprs, t.state.memory, t.io) ∧ (need <= d)), c.Esc(),
            site.guard_claims(stack.writes, linux, fits_prog, stack, prog, need, stop, lower_in.witness, lower_in.proof, tested_in.witness, tested_in.proof,
                branched_in.witness, branched_in.proof, within.witness, within.proof, block_in.witness, stop_prog, block_in.proof, stop_lands, d,
                { let room = loan.room; omega }, most, pre_g, c.Esc(),
                λ g m io held => ⟨trans(held.left.right.left.left, rsp0), floor(g, held.left.right.left)⟩,
                λ r t held same_memory same_io short stopped => {
                    let answered = held.left.left.right.left;
                    let a = answered.proof.witness;
                    let world: (r.io = before.io) = held.right.left;
                    let extends: Extends(a.io.past, before.io.past) = grows(callee, answered.witness, before.heap, before.io, a, answered.proof.proof.left);
                    let up: Extends(c.top.past, a.io.past) = j(sym(answered.proof.proof.right.right), λ x _ => Extends(c.top.past, x.past),
                        held.left.left.right.right);
                    let at_world: Extends(c.top.past, t.io.past) = j(sym(trans(same_io, world)), λ x _ => Extends(c.top.past, x.past),
                        extends_trans(c.top.past, a.io.past, before.io.past, up, extends));
                    let exit: site.SpentExit(stack)(t) = ⟨site.item_fetched(fits_prog, t.state, stopped.left.right, stop_in.witness, block_prog, 0, Syscall,
                        stop_in.proof, stopped.left.left), ⟨stopped.right.right, stopped.right.left⟩⟩;
                    ⟨spent(below, answered.witness, a, answered.proof.proof.left, short, t, exit), at_world⟩
                }))
    };
    let goal_of = λ (out: Emitted) => NowPost<M>(saves, site, stack, spans, values, w, s0, prog_len(out.prog), out.file, after);
    match d.lt_or_ge(need) {
        Inl(short) => (match call_out as λ o => call_out = o → Grows(guarded, o) →
            MayEmitNow<M>(saves, site, stack, spans, c, values, w, s0, prog, file,
                Body::Call(callee, arguments, results).Holds(spans, blocks, values, answers, spare, before, after), before, after, o) {
            None => λ _ _ => trivial,
            Some(out) => λ emitted grown => ⟨Prog::within_trans(into_guarded, grown), λ within => site.claims_ceiling(stack, c, 1, 0, prog_len(prog), pre,
                goal_of(out), λ r held t arrived => c.under_len(after, t.io, arrived.right.right.left, held.left.left.right.right),
                site.claims_weaken(stack.writes, kernel, 1, 0, prog_len(prog), pre, site.Arrived(prog_len(guarded), λ (t: Running<M, Io>) =>
                        pre_g(t.state.gprs, t.state.memory, t.io) ∧ (need <= d)), pre, goal_of(out),
                    guard(emit_call_below(file, slots, guarded, callee, typed_ids(arguments), call_result(results, spare), call_also(results), placement, names, bound, [], [], out, emitted), Prog::within_trans(grown, within)), λ r h => h, λ t arrived => false_elim({ let fit = arrived.right.right; omega })))⟩,
        })(refl, file.emit_call_grows(slots, guarded, callee, typed_ids(arguments), call_result(results, spare), call_also(results), placement, names, bound,
            [], [])),
        Inr(roomy) => {
            let deep: (24 <= d) = { omega };
            let main = file.emit_call_steps_claim_kept<M, Now, Io>(saves, slots, site, laid, stack, top, bound, spans, mem, NowWorld(), kernel, c.count(), 0,
                now_in_stable<M>(stack, top, spans, loan), values, d, s0, rsp0, fits, under, deep, guarded, callee, typed_ids(arguments),
                call_result(results, spare), call_also(results), placement, names, [], [], facts, before, after,
                λ eight slotted below _ count few moved held_facts g0 _ _ kept k at => call_now_step<M>(call_saves(placement), slots, eight, slotted, site, laid,
                    stack, top, spans, loan, rooms, bound, answers, floored, spends, callees, c, values, spare, d, s0, fits, under, moved, callee, deep, below, count, few,
                    { omega }, carries(below, count, few), arguments, results, before, after, held_facts.left.witness, held_facts.left.proof.witness,
                    held_facts.left.proof.proof.left, held_facts.left.proof.proof.right.left, held_facts.left.proof.proof.right.right, held_facts.right, g0,
                    k, at, λ _ => floor(g0, kept)));
            (match call_out as λ o => call_out = o → MayEmitClaim<M, Now, Io>(saves, site, stack, spans, mem, NowWorld(), kernel, c.count(), 0, values, w,
                    s0, guarded, file, facts, before, after, o) →
                MayEmitNow<M>(saves, site, stack, spans, c, values, w, s0, prog, file,
                    Body::Call(callee, arguments, results).Holds(spans, blocks, values, answers, spare, before, after), before, after, o) {
                None => λ _ _ => trivial,
                Some(out) => λ emitted emits => ⟨Prog::within_trans(into_guarded, emits.left), λ within => site.claims_ceiling(stack, c, c.count() + 1, 0 + 0,
                    prog_len(prog), pre, goal_of(out), λ r held t arrived => c.under_len(after, t.io, arrived.right.right.left, held.left.left.right.right),
                    site.claims_trans(stack.writes, kernel, 1, 0, c.count(), 0, prog_len(prog), prog_len(guarded), pre, pre, goal_of(out),
                        site.claims_weaken(stack.writes, kernel, 1, 0, prog_len(prog), pre, site.Arrived(prog_len(guarded), λ (t: Running<M, Io>) =>
                                pre_g(t.state.gprs, t.state.memory, t.io) ∧ (need <= d)), pre, site.Arrived(prog_len(guarded), pre),
                            guard(emit_call_below(file, slots, guarded, callee, typed_ids(arguments), call_result(results, spare), call_also(results), placement, names, bound, [], [], out, emitted), Prog::within_trans(emits.left, within)), λ r h => h,
                            λ t arrived => ⟨arrived.left, arrived.right.left⟩),
                        emits.right(within)))⟩,
            })(refl, main)
        },
    }
}

// A region's code: a leaf's nodes; a sequence's parts one after the other;
// a branch as FunctionIR's conditional (the test of its bit, or of the
// comparison the file knows it to be, the first arm, a jump to the join,
// the second arm, the join, where only what both arms' files agree on
// survives: `File::branch_test`, `File::meet`); a call as FunctionIR's,
// lending no buffers, of a routine below `bound`, its frame's `slots`
// call slots. `short` names the labels whose jumps take their short form.
fn Body::emit_by(self body: Body, g: CallGuards, saves, slots: Nat, short: List<Nat>, bound, spare: Nat, prog: Prog, file: File, placement: List<Place>, names: Nat) →
    Option<Emitted> {
    match body {
        Leaf(instrs) => emit_instrs(saves, prog, file, instrs, placement, names),
        Seq(first, rest) => match first.emit_by(g, saves, slots, short, bound, spare, prog, file, placement, names) {
            None => None,
            Some(done) => rest.emit_by(g, saves, slots, short, bound, spare, done.prog, done.file, done.placement, done.names),
        },
        Branch(condition, yes, no) => match file.branch_test(condition) {
            None => None,
            Some(tested) => match yes.emit_by(g, saves, slots, short, bound, spare, prog.branched_by(tested.test, names + 1, shorts(short, names + 1)),
                file.know(Truth(condition)), placement, names + 2) {
                None => None,
                Some(left) => match no.emit_by(g, saves, slots, short, bound, spare, left.prog.else_label_by(names + 1, names + 2, shorts(short, names + 2)),
                    file.know(Falsity(condition)), left.placement, left.names) {
                    None => None,
                    Some(right) => Some(Emitted(right.prog.join_label(names + 2), left.file.meet(right.file, file.known), right.placement, right.names)),
                },
            },
        },
        Call(callee, arguments, results) => match g.guards(callee) {
            False => file.emit_call(slots, prog, callee, typed_ids(arguments), call_result(results, spare), call_also(results), placement, names, bound,
                [], []),
            True => match g.need(callee).leb(guard_most()) {
                False => None,
                True => file.emit_call(slots, prog.guarded(g.need(callee), g.stop), callee, typed_ids(arguments), call_result(results, spare),
                    call_also(results), placement, names, bound, [], []),
            },
        },
        Loop(inputs, parameters, inner, exit, next, outputs) => match state_registers(placement, typed_ids(parameters).len()) {
            None => None,
            Some(taken) => match file.plain_entry(saves, typed_ids(inputs), typed_ids(parameters), taken.registers) {
                None => None,
                Some(entry) => match inner.emit_by(g, saves, slots, short, bound, spare, plain_head(prog, entry.code, names), entry.head, taken.rest, names + 4) {
                    None => None,
                    Some(pass) => pass.plain_close(saves, taken.registers, exit, typed_ids(next), typed_ids(outputs), names, short),
                },
            },
        },
        Sys(call) => emit_sys(saves, prog, file, call, placement, names),
        Exit(status) => emit_exit(prog, file, status, placement, names),
    }
}

// The emission with no guard: every program with no cycle, and every
// lemma about a region that calls no routine of its own cycle.
fn Body::emit(self body: Body, saves, slots: Nat, short: List<Nat>, bound, spare: Nat, prog: Prog, file: File, placement: List<Place>, names: Nat) →
    Option<Emitted> {
    body.emit_by(CallGuards::none(), saves, slots, short, bound, spare, prog, file, placement, names)
}

// ---------------------------------------------------------------------------
// Histories extend (of the facts a region's code is proved under)
//
// A region's facts put its world after at the end of its world before:
// each system call records one exchange, and each answer extends its
// call's world (`AnswersExtend`, the meaning's `HistoryExtends`). A part's
// world after is so under the ceiling where the whole's is.

theorem extends_exchanged(after, before: Io, cmd: LinuxCmd<Nat>, answer: cmd.Resp(), e: after = before.exchanged(cmd, answer)):
    Extends(after.past, before.past) {
    j(sym(e), λ w _ => Extends(w.past, before.past), Exists([Exchange(cmd, answer)], refl))
}

theorem SysCall::lands_extends(self call: SysCall, spans: Spans, blocks: Blocks, values: Valuation(), before, after: Now):
    call.Lands(spans, blocks, values, before, after) → Extends(after.io.past, before.io.past) {
    match call {
        Read(fd, buf, len, result) => λ h => extends_exchanged(after.io, before.io, ReadCmd(values(64, fd), values(64, len).toNat()),
            before.io.answer(ReadCmd(values(64, fd), values(64, len).toNat())), h.proof.right.right.right),
        Write(fd, buf, len, result) => λ h => extends_exchanged(after.io, before.io, WriteCmd(values(64, fd), h.proof.right.witness),
            before.io.answer(WriteCmd(values(64, fd), h.proof.right.witness)), h.proof.right.proof.right.right),
    }
}

theorem passes_extend(Pass: Valuation() → Now → Now → Type,
    grows: (v: Valuation()) → (from, to: Now) → Pass(v, from, to) → Extends(to.io.past, from.io.past), parameters: List<Typed>, exit: Nat,
    next: List<Typed>, n: Nat): (state: List<BitVec(64)>) → (from: Now) → (final: List<BitVec(64)>) → (to: Now) →
    PassesHold(Pass, parameters, exit, next, n, state, from, final, to) → Extends(to.io.past, from.io.past) {
    match n {
        Zero => λ state from final to never => false_elim(never),
        Succ(m) => λ state from final to h => {
            let v = h.witness;
            let mid = h.proof.right.witness;
            let first = grows(v, from, mid, h.proof.right.proof.left);
            (match v(1, exit).head_bit() as λ b => (match b {
                True => (final = words_of(v, typed_ids(next))) ∧ (to = mid),
                False => PassesHold(Pass, parameters, exit, next, m, words_of(v, typed_ids(next)), mid, final, to),
            }) → Extends(to.io.past, from.io.past) {
                True => λ done => j(sym(done.right), λ x _ => Extends(x.io.past, from.io.past), first),
                False => λ later => extends_trans(to.io.past, mid.io.past, from.io.past,
                    passes_extend(Pass, grows, parameters, exit, next, m, words_of(v, typed_ids(next)), mid, final, to, later), first),
            })(h.proof.right.proof.right)
        },
    }
}

theorem Body::holds_extends(self body: Body, spans: Spans, blocks: Blocks, answers: RoutineAnswers(), grows: AnswersExtend(answers), spare: Nat):
    (values: Valuation()) → (before, after: Now) → body.Holds(spans, blocks, values, answers, spare, before, after) →
    Extends(after.io.past, before.io.past) {
    match body {
        Leaf(_) => λ values before after h => j(sym(h.right), λ w _ => Extends(w.past, before.io.past), extends_refl(before.io.past)),
        Seq(first, rest) => λ values before after h => extends_trans(after.io.past, h.witness.io.past, before.io.past,
            rest.holds_extends(spans, blocks, answers, grows, spare, values, h.witness, after, h.proof.left.right),
            first.holds_extends(spans, blocks, answers, grows, spare, values, before, h.witness, h.proof.left.left)),
        Branch(condition, yes, no) => λ values before after => (match values(1, condition).head_bit() as λ b => (match b {
            True => yes.Holds(spans, blocks, values, answers, spare, before, after),
            False => no.Holds(spans, blocks, values, answers, spare, before, after),
        }) → Extends(after.io.past, before.io.past) {
            True => λ h => yes.holds_extends(spans, blocks, answers, grows, spare, values, before, after, h),
            False => λ h => no.holds_extends(spans, blocks, answers, grows, spare, values, before, after, h),
        }),
        Call(callee, arguments, results) => λ values before after h => j(h.proof.proof.right.right, λ w _ => Extends(w.past, before.io.past),
            grows(callee, h.witness, before.heap, before.io, h.proof.witness, h.proof.proof.left)),
        Loop(inputs, parameters, inner, exit, next, outputs) => λ values before after h => passes_extend(
            λ (v: Valuation()) (from: Now) (to: Now) => inner.Holds(spans, blocks, v, answers, spare, from, to),
            λ v from to p => inner.holds_extends(spans, blocks, answers, grows, spare, v, from, to, p), parameters, exit, next, h.witness,
            words_of(values, typed_ids(inputs)), before, words_of(values, typed_ids(outputs)), after, h.proof),
        Sys(call) => λ values before after h => call.lands_extends(spans, blocks, values, before, after, h),
        Exit(_) => λ values before after never => false_elim(never),
    }
}

// ---------------------------------------------------------------------------
// The plain loop's code meets its meaning

// After a pass, its moves: the next words in the state's registers, and
// the file after them describing the registers, for the exit bit's test.
fn PlainMoved<M>(saves: Nat, keep: M → Type, s0: MachineState<M>, after: File, values: Valuation(), registers: List<Gpr>, ids: List<Nat>) →
    Gprs → M → Type {
    λ g m => after.Represents(values, g) ∧ (ArgsIn(words_of(values, ids), registers, g) ∧ (Kept(body_kept(saves), s0.gprs, g) ∧ keep(m)))
}

theorem plain_moves_run<M>(saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), keep: M → Type,
    s0: MachineState<M>, pass: Prog, file, after: File, moves: List<Instruction>, ids: List<Nat>, registers: List<Gpr>,
    moved_in: plain_moved(pass, moves).Within(site.program), values: Valuation(),
    moved: (s: MachineState<M>) → file.Represents(values, s.gprs) → after.Represents(values, execute_block_normal(moves, s).gprs),
    into: MovesInto<M>(saves, values, file, ids, registers, moves)):
    site.Moves(stack.writes, prog_len(pass), prog_len(plain_moved(pass, moves)),
        λ (s: MachineState<M>) => stack.LoopPassed(saves, keep, s0, file, values)(s.gprs, s.memory),
        λ (t: MachineState<M>) => PlainMoved<M>(saves, keep, s0, after, values, registers, ids)(t.gprs, t.memory)) {
    let program = site.program;
    site.moves_block(stack.writes, program.laid_out_fits(laid), moved_in.witness, pass, 0, moves, moved_in.proof,
        program.block_reads_at(laid, moved_in.witness, pass, 0, moves, moved_in.proof), stack.LoopPassed(saves, keep, s0, file, values),
        PlainMoved<M>(saves, keep, s0, after, values, registers, ids),
        λ s memory held => {
            let ran = into(s, held.left);
            ⟨moved(s, held.left), ⟨ran.left, ⟨kept_trans(body_kept(saves), s0.gprs, s.gprs, execute_block_normal(moves, s).gprs, held.right.left, ran.right),
                held.right.right⟩⟩⟩
        })
}

// The exit bit set, after a pass: the moves, then the test's jump to J.
theorem plain_leaves<M>(saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), keep: M → Type,
    s0: MachineState<M>, pass: Prog, file, after: File, test: Test, exit: Nat, moves: List<Instruction>, ids: List<Nat>, registers: List<Gpr>,
    names: Nat, short: List<Nat>, again_in: plain_again(pass, test, moves, names, short).Within(site.program),
    j_at: Nat, j_lands: asm_target(site.program, names + 3) = j_at, values: Valuation(),
    moved: (s: MachineState<M>) → file.Represents(values, s.gprs) → after.Represents(values, execute_block_normal(moves, s).gprs),
    selects: (g: Gprs) → after.Represents(values, g) → test.taken(g) = !values(1, exit).head_bit(),
    into: MovesInto<M>(saves, values, file, ids, registers, moves), set: values(1, exit).head_bit() = True):
    site.Moves(stack.writes, prog_len(pass), j_at,
        λ (s: MachineState<M>) => stack.LoopPassed(saves, keep, s0, file, values)(s.gprs, s.memory),
        λ (t: MachineState<M>) => stack.LoopAt(saves, keep, s0, registers, words_of(values, ids))(t.gprs, t.memory)) {
    let program = site.program;
    let fits = program.laid_out_fits(laid);
    let j_name = names + 3;
    let short_j = shorts(short, j_name);
    let flipped = test.negated();
    let moved_p = plain_moved(pass, moves);
    let tested_p = plain_tested(pass, test, moves, names, short);
    let tested_in = tested_p.within_before(0, jmp_item(shorts(short, names + 1), names + 1), program, again_in);
    let test_in = moved_p.tested(flipped).within_before(0, jcc_item(short_j, flipped.cc(), j_name), program, tested_in);
    let moved_in = moved_p.within_before(0, Block([flipped.instruction()]), program, test_in);
    let out_lands = j(j_lands, λ target _ => JccLands(asm_labels(program), prog_len(moved_p.tested(flipped)), short_j, flipped.cc(), j_name, target),
        jcc_item_lands(asm_labels(program), tested_in.witness, program, moved_p.tested(flipped), 0, short_j, flipped.cc(), j_name,
            program.laid_out_lands(laid), tested_in.proof));
    let mid = PlainMoved<M>(saves, keep, s0, after, values, registers, ids);
    let post = stack.LoopAt(saves, keep, s0, registers, words_of(values, ids));
    site.moves_trans(stack.writes, prog_len(pass), prog_len(moved_p), j_at,
        λ (s: MachineState<M>) => stack.LoopPassed(saves, keep, s0, file, values)(s.gprs, s.memory),
        λ (s: MachineState<M>) => mid(s.gprs, s.memory), λ (t: MachineState<M>) => post(t.gprs, t.memory),
        plain_moves_run<M>(saves, site, laid, stack, keep, s0, pass, file, after, moves, ids, registers, moved_in, values, moved, into),
        site.moves_test_by(stack.writes, fits, moved_p, flipped, j_name, short_j, test_in.witness, test_in.proof, tested_in.witness, tested_in.proof,
            j_at, out_lands, j_at, mid, λ (t: MachineState<M>) => post(t.gprs, t.memory),
            site.moves_absurd(stack.writes, prog_len(tested_p), j_at, λ (s: MachineState<M>) => mid(s.gprs, s.memory) ∧ flipped.taken(s.gprs) = False,
                λ (t: MachineState<M>) => post(t.gprs, t.memory),
                λ s held => {
                    let bad: (False = True) = trans(sym(held.right), trans(test.negated_taken(s.gprs),
                        trans(cong_fn<Bool, Bool>(λ b => !b, trans(selects(s.gprs, held.left.left), cong_fn<Bool, Bool>(λ b => !b, set))), refl)));
                    absurd(sym(bad))
                }),
            site.moves_refl(stack.writes, j_at, λ (s: MachineState<M>) => mid(s.gprs, s.memory) ∧ flipped.taken(s.gprs) = True,
                λ (t: MachineState<M>) => post(t.gprs, t.memory), λ s held => held.left.right)))
}

// The exit bit clear, as a claim: the moves, the test falling through, and
// the JMP to the head, the one step the fuel pays for.
theorem plain_turns_claim<M, W>(saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data),
    kernel: Kernel<M, W>, World: W → Type, keep: M → Type,
    s0: MachineState<M>, pass: Prog, file, after: File, test: Test, exit: Nat, moves: List<Instruction>, ids: List<Nat>, registers: List<Gpr>,
    names: Nat, short: List<Nat>, again_in: plain_again(pass, test, moves, names, short).Within(site.program),
    h_at: Nat, h_lands: asm_target(site.program, names + 1) = h_at, values: Valuation(),
    moved: (s: MachineState<M>) → file.Represents(values, s.gprs) → after.Represents(values, execute_block_normal(moves, s).gprs),
    selects: (g: Gprs) → after.Represents(values, g) → test.taken(g) = !values(1, exit).head_bit(),
    into: MovesInto<M>(saves, values, file, ids, registers, moves), clear: values(1, exit).head_bit() = False):
    site.Claims(stack.writes, kernel, 0, 1, prog_len(pass),
        λ (r: Running<M, W>) => stack.LoopPassed(saves, keep, s0, file, values)(r.state.gprs, r.state.memory) ∧ World(r.io),
        site.Arrived(h_at, λ (t: Running<M, W>) => stack.LoopAt(saves, keep, s0, registers, words_of(values, ids))(t.state.gprs, t.state.memory) ∧ World(t.io))) {
    let program = site.program;
    let fits = program.laid_out_fits(laid);
    let j_name = names + 3;
    let short_j = shorts(short, j_name);
    let short_h = shorts(short, names + 1);
    let flipped = test.negated();
    let moved_p = plain_moved(pass, moves);
    let tested_p = plain_tested(pass, test, moves, names, short);
    let tested_in = tested_p.within_before(0, jmp_item(short_h, names + 1), program, again_in);
    let test_in = moved_p.tested(flipped).within_before(0, jcc_item(short_j, flipped.cc(), j_name), program, tested_in);
    let moved_in = moved_p.within_before(0, Block([flipped.instruction()]), program, test_in);
    let out_lands = jcc_item_lands(asm_labels(program), tested_in.witness, program, moved_p.tested(flipped), 0, short_j, flipped.cc(), j_name,
        program.laid_out_lands(laid), tested_in.proof);
    let jump_lands = j(h_lands, λ target _ => JmpLands(asm_labels(program), prog_len(tested_p), short_h, names + 1, target),
        jmp_item_lands(asm_labels(program), again_in.witness, program, tested_p, 0, short_h, names + 1, program.laid_out_lands(laid), again_in.proof));
    let mid = PlainMoved<M>(saves, keep, s0, after, values, registers, ids);
    let post = stack.LoopAt(saves, keep, s0, registers, words_of(values, ids));
    let goal = site.Arrived(h_at, λ (t: Running<M, W>) => post(t.state.gprs, t.state.memory) ∧ World(t.io));
    site.claims_after_moves(stack.writes, kernel, 0, 1, prog_len(pass), prog_len(moved_p),
        λ (s: MachineState<M>) => stack.LoopPassed(saves, keep, s0, file, values)(s.gprs, s.memory),
        λ (s: MachineState<M>) => mid(s.gprs, s.memory), World, goal,
        plain_moves_run<M>(saves, site, laid, stack, keep, s0, pass, file, after, moves, ids, registers, moved_in, values, moved, into),
        site.claims_test_by(stack.writes, kernel, fits, moved_p, flipped, j_name, short_j, test_in.witness, test_in.proof, tested_in.witness,
            tested_in.proof, asm_target(program, j_name), out_lands, 0, 1, λ (g: Gprs) (m: M) (w: W) => mid(g, m) ∧ World(w), goal,
            site.claims_weaken(stack.writes, kernel, 0, 1, prog_len(tested_p),
                λ (r: Running<M, W>) => post(r.state.gprs, r.state.memory) ∧ World(r.io), goal,
                λ (r: Running<M, W>) => (mid(r.state.gprs, r.state.memory) ∧ World(r.io)) ∧ flipped.taken(r.state.gprs) = False, goal,
                site.claims_jump_item(stack.writes, kernel, fits, again_in.witness, tested_p, 0, short_h, names + 1, again_in.proof, h_at, jump_lands,
                    λ (g: Gprs) (m: M) (w: W) => post(g, m) ∧ World(w)),
                λ r held => ⟨held.left.left.right, held.left.right⟩, λ t at => at),
            site.claims_absurd(stack.writes, kernel, 0, 1, asm_target(program, j_name),
                λ (r: Running<M, W>) => (mid(r.state.gprs, r.state.memory) ∧ World(r.io)) ∧ flipped.taken(r.state.gprs) = True, goal,
                λ r held => {
                    let bad: (True = False) = trans(sym(held.right), trans(test.negated_taken(r.state.gprs),
                        trans(cong_fn<Bool, Bool>(λ b => !b, trans(selects(r.state.gprs, held.left.left.left), cong_fn<Bool, Bool>(λ b => !b, clear))),
                            refl)));
                    absurd(bad)
                })))
}

// A label's item is empty.
theorem label_len(p: Prog, name: Nat): prog_len(At(p, name, Block([]))) = prog_len(p) { refl }

// The loop's head over the state `now` leaves: the state's words in their
// registers, the trail over `now`.
fn PlainAt<M>(saves: Nat, site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, w: Nat, s0: MachineState<M>, registers: List<Gpr>,
    state: List<BitVec(64)>, now: Now) → MachineState<M> → Type {
    λ (s: MachineState<M>) => stack.LoopAt(saves, λ (x: M) => stack.TrailBy(spans, now_in<M>(site.data, spans), w, s0.memory, now, x), s0, registers,
        state)(s.gprs, s.memory)
}

// And in the state's world.
fn PlainAtNow<M>(saves: Nat, site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, w: Nat, s0: MachineState<M>, registers: List<Gpr>,
    state: List<BitVec(64)>, now: Now) → Running<M, Io> → Type {
    λ (r: Running<M, Io>) => PlainAt<M>(saves, site, stack, spans, w, s0, registers, state, now)(r.state) ∧ NowWorld()(now, r.io)
}

// Where the loop's labels land, read off the code once.
record PlainLabels<M>(site: Site<M>, prog: Prog, code: List<Instruction>, pass: Prog, test: Test, moves: List<Instruction>, names: Nat,
    short: List<Nat>) {
    again_in: plain_again(pass, test, moves, names, short).Within(site.program),
    h_lands: asm_target(site.program, names + 1) = prog_len(At(prog, 0, Block(code))),
    j_lands: asm_target(site.program, names + 3) = prog_len(plain_again(pass, test, moves, names, short)),
}

theorem plain_labels<M>(site: Site<M>, laid: site.program.laid_out().IsTrue(), prog: Prog, code: List<Instruction>, pass: Prog, test: Test,
    moves: List<Instruction>, names: Nat, short: List<Nat>, head_pass: plain_head(prog, code, names).Within(pass),
    done_in: plain_done(pass, test, moves, names, short).Within(site.program)): PlainLabels<M>(site, prog, code, pass, test, moves, names, short) {
    let program = site.program;
    let unique = program.laid_out_unique(laid);
    let again = plain_again(pass, test, moves, names, short);
    let head_in: plain_head(prog, code, names).Within(program) = Prog::within_trans(head_pass, Prog::within_trans(Exists(5, refl), done_in));
    PlainLabels(again_in := again.within_before(names + 3, Block([]), program, done_in),
        h_lands := label_target(head_in.witness, program, At(prog, 0, Block(code)), names, Block([]), unique, head_in.proof),
        j_lands := label_target(done_in.witness, program, again, names + 2, Block([]), unique, done_in.proof))
}

// One pass from the head: its body, then out to J or round to H, at Linux
// in the pass's worlds, counting what the body counts.
theorem plain_step<M>(saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), spans: Spans, c: Ceiling<M>,
    Pass: Valuation() → Now → Now → Type, w: Nat, s0: MachineState<M>, prog: Prog, code: List<Instruction>, head: File, registers: List<Gpr>,
    parameters: List<Typed>, exit: Nat, next: List<Typed>, names: Nat, short: List<Nat>, pass: Emitted, test: Test, moves: List<Instruction>,
    labels: PlainLabels<M>(site, prog, code, pass.prog, test, moves, names, short),
    head_ok: (v: Valuation()) → (g: Gprs) → ArgsIn(words_of(v, typed_ids(parameters)), registers, g) → head.Represents(v, g),
    pass_emits: (v: Valuation()) → (from, to: Now) →
        EmitsNow<M>(saves, site, stack, spans, c, v, w, s0, plain_head(prog, code, names), head, Pass(v, from, to), from, to, pass),
    pass_in: pass.prog.Within(site.program), grows: (v: Valuation()) → (from, to: Now) → Pass(v, from, to) → Extends(to.io.past, from.io.past),
    next_file: File, moved: (v: Valuation()) → (s: MachineState<M>) → pass.file.Represents(v, s.gprs) →
        next_file.Represents(v, execute_block_normal(moves, s).gprs),
    selects: (v: Valuation()) → (g: Gprs) → next_file.Represents(v, g) → test.taken(g) = !v(1, exit).head_bit(),
    into: (v: Valuation()) → MovesInto<M>(saves, v, pass.file, typed_ids(next), registers, moves),
    final: List<BitVec(64)>, after: Now, reach: c.Under(after), m: Nat, state: List<BitVec(64)>, now: Now, v: Valuation(),
    eq: words_of(v, typed_ids(parameters)) = state, mid: Now, passed: Pass(v, now, mid),
    rest: match v(1, exit).head_bit() {
        True => (final = words_of(v, typed_ids(next))) ∧ (after = mid),
        False => PassesHold(Pass, parameters, exit, next, m, words_of(v, typed_ids(next)), mid, final, after),
    }):
    Exists<Nat>(λ count => site.Claims(stack.writes, site.ceiling(stack, c), count, 0, prog_len(At(prog, 0, Block(code))),
        PlainAtNow<M>(saves, site, stack, spans, w, s0, registers, state, now),
        site.Arrived(prog_len(plain_again(pass.prog, test, moves, names, short)), PlainAtNow<M>(saves, site, stack, spans, w, s0, registers, final, after)))) ∨
    Exists<List<BitVec(64)>>(λ later => Exists<Now>(λ left => PassesHold(Pass, parameters, exit, next, m, later, left, final, after) ∧
        Exists<Nat>(λ count => site.Claims(stack.writes, site.ceiling(stack, c), count, 0, prog_len(At(prog, 0, Block(code))),
            PlainAtNow<M>(saves, site, stack, spans, w, s0, registers, state, now),
            site.Arrived(prog_len(At(prog, 0, Block(code))), PlainAtNow<M>(saves, site, stack, spans, w, s0, registers, later, left)))))) {
    let h_at = prog_len(At(prog, 0, Block(code)));
    let j_at = prog_len(plain_again(pass.prog, test, moves, names, short));
    let kernel = site.ceiling(stack, c);
    let mem = now_in<M>(site.data, spans);
    let keep_mid = λ (x: M) => stack.TrailBy(spans, mem, w, s0.memory, mid, x);
    let passed_at = λ (t: MachineState<M>) => stack.LoopPassed(saves, keep_mid, s0, pass.file, v)(t.gprs, t.memory);
    let at_mid = λ (w2: Io) => NowWorld()(mid, w2);
    let under_mid: c.Under(mid) = (match v(1, exit).head_bit() as λ b => (match b {
        True => (final = words_of(v, typed_ids(next))) ∧ (after = mid),
        False => PassesHold(Pass, parameters, exit, next, m, words_of(v, typed_ids(next)), mid, final, after),
    }) → c.Under(mid) {
        True => λ done => j(done.right, λ x _ => c.Under(x), reach),
        False => λ later => c.under_extends(after, mid, reach, passes_extend(Pass, grows, parameters, exit, next, m, words_of(v, typed_ids(next)), mid,
            final, after, later)),
    })(rest);
    let ran = loop_body_runs_claim<M, Now, Io>(saves, site, stack, spans, mem, NowWorld(), kernel, c.count(), 0,
        λ (v2: Valuation()) (from2: Now) (to2: Now) => Pass(v2, from2, to2) ∧ c.Under(to2), w, s0,
        plain_head(prog, code, names), head, registers, typed_ids(parameters), head_ok, v, now, mid, pass, pass_emits(v, now, mid), pass_in,
        ⟨passed, under_mid⟩);
    let start = j(eq, λ x _ => site.Claims(stack.writes, kernel, c.count(), 0, h_at, PlainAtNow<M>(saves, site, stack, spans, w, s0, registers,
        x, now), site.Arrived(prog_len(pass.prog), λ (t: Running<M, Io>) => passed_at(t.state) ∧ at_mid(t.io))), ran);
    (match v(1, exit).head_bit() as λ b => v(1, exit).head_bit() = b →
        (match b {
            True => (final = words_of(v, typed_ids(next))) ∧ (after = mid),
            False => PassesHold(Pass, parameters, exit, next, m, words_of(v, typed_ids(next)), mid, final, after),
        }) →
        Exists<Nat>(λ count => site.Claims(stack.writes, kernel, count, 0, h_at, PlainAtNow<M>(saves, site, stack, spans, w, s0, registers, state, now),
            site.Arrived(j_at, PlainAtNow<M>(saves, site, stack, spans, w, s0, registers, final, after)))) ∨
        Exists<List<BitVec(64)>>(λ later => Exists<Now>(λ left => PassesHold(Pass, parameters, exit, next, m, later, left, final, after) ∧
            Exists<Nat>(λ count => site.Claims(stack.writes, kernel, count, 0, h_at, PlainAtNow<M>(saves, site, stack, spans, w, s0, registers, state, now),
                site.Arrived(h_at, PlainAtNow<M>(saves, site, stack, spans, w, s0, registers, later, left)))))) {
        True => λ set done => {
            let out = plain_leaves<M>(saves, site, laid, stack, keep_mid, s0, pass.prog, pass.file, next_file, test, exit, moves, typed_ids(next), registers, names,
                short, labels.again_in, j_at, labels.j_lands, v, moved(v), selects(v), into(v), set);
            let leave = site.claims_of_moves(stack.writes, kernel, prog_len(pass.prog), j_at, passed_at,
                PlainAt<M>(saves, site, stack, spans, w, s0, registers, words_of(v, typed_ids(next)), mid), at_mid, out);
            let both = site.claims_trans(stack.writes, kernel, c.count(), 0, 0, 0, h_at, prog_len(pass.prog),
                PlainAtNow<M>(saves, site, stack, spans, w, s0, registers, state, now), λ (t: Running<M, Io>) => passed_at(t.state) ∧ at_mid(t.io),
                site.Arrived(j_at, PlainAtNow<M>(saves, site, stack, spans, w, s0, registers, words_of(v, typed_ids(next)), mid)), start, leave);
            Inl(Exists(0 + c.count(), j(sym(done.right), λ h _ => site.Claims(stack.writes, kernel, 0 + c.count(), 0, h_at,
                    PlainAtNow<M>(saves, site, stack, spans, w, s0, registers, state, now),
                    site.Arrived(j_at, PlainAtNow<M>(saves, site, stack, spans, w, s0, registers, final, h))),
                j(sym(done.left), λ f _ => site.Claims(stack.writes, kernel, 0 + c.count(), 0, h_at,
                    PlainAtNow<M>(saves, site, stack, spans, w, s0, registers, state, now),
                    site.Arrived(j_at, PlainAtNow<M>(saves, site, stack, spans, w, s0, registers, f, mid))), both))))
        },
        False => λ clear later => {
            let turn = site.claims_loosen(stack.writes, kernel, 0, 1, 0, 0, prog_len(pass.prog), λ (r: Running<M, Io>) => passed_at(r.state) ∧ at_mid(r.io),
                site.Arrived(h_at, λ (t: Running<M, Io>) => PlainAt<M>(saves, site, stack, spans, w, s0, registers, words_of(v, typed_ids(next)), mid)(t.state) ∧
                    at_mid(t.io)), { omega },
                plain_turns_claim<M, Io>(saves, site, laid, stack, kernel, at_mid, keep_mid, s0, pass.prog, pass.file, next_file, test, exit, moves,
                    typed_ids(next), registers, names, short, labels.again_in, h_at, labels.h_lands, v, moved(v), selects(v), into(v), clear));
            Inr(Exists(words_of(v, typed_ids(next)), Exists(mid, ⟨later, Exists(0 + c.count(),
                site.claims_trans(stack.writes, kernel, c.count(), 0, 0, 0, h_at, prog_len(pass.prog),
                    PlainAtNow<M>(saves, site, stack, spans, w, s0, registers, state, now), λ (t: Running<M, Io>) => passed_at(t.state) ∧ at_mid(t.io),
                    site.Arrived(h_at, PlainAtNow<M>(saves, site, stack, spans, w, s0, registers, words_of(v, typed_ids(next)), mid)), start, turn))⟩)))
        },
    })(refl, rest)
}

// The passes, by induction on the fuel (`Site::loop_iterates_claim`), some
// number of system calls.
theorem plain_passes<M>(saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), spans: Spans, c: Ceiling<M>,
    Pass: Valuation() → Now → Now → Type, w: Nat, s0: MachineState<M>, prog: Prog, code: List<Instruction>, head: File, registers: List<Gpr>,
    parameters: List<Typed>, exit: Nat, next: List<Typed>, names: Nat, short: List<Nat>, pass: Emitted, test: Test, moves: List<Instruction>,
    labels: PlainLabels<M>(site, prog, code, pass.prog, test, moves, names, short),
    head_ok: (v: Valuation()) → (g: Gprs) → ArgsIn(words_of(v, typed_ids(parameters)), registers, g) → head.Represents(v, g),
    pass_emits: (v: Valuation()) → (from, to: Now) →
        EmitsNow<M>(saves, site, stack, spans, c, v, w, s0, plain_head(prog, code, names), head, Pass(v, from, to), from, to, pass),
    pass_in: pass.prog.Within(site.program), grows: (v: Valuation()) → (from, to: Now) → Pass(v, from, to) → Extends(to.io.past, from.io.past),
    next_file: File, moved: (v: Valuation()) → (s: MachineState<M>) → pass.file.Represents(v, s.gprs) →
        next_file.Represents(v, execute_block_normal(moves, s).gprs),
    selects: (v: Valuation()) → (g: Gprs) → next_file.Represents(v, g) → test.taken(g) = !v(1, exit).head_bit(),
    into: (v: Valuation()) → MovesInto<M>(saves, v, pass.file, typed_ids(next), registers, moves),
    final: List<BitVec(64)>, after: Now, reach: c.Under(after), n: Nat, state: List<BitVec(64)>, now: Now,
    ran: PassesHold(Pass, parameters, exit, next, n, state, now, final, after)):
    Exists<Nat>(λ count => site.Claims(stack.writes, site.ceiling(stack, c), count, 0, prog_len(At(prog, 0, Block(code))),
        PlainAtNow<M>(saves, site, stack, spans, w, s0, registers, state, now),
        site.Arrived(prog_len(plain_again(pass.prog, test, moves, names, short)), PlainAtNow<M>(saves, site, stack, spans, w, s0, registers, final, after)))) {
    site.loop_iterates_claim<M, Now, Io>(stack.writes, site.ceiling(stack, c), prog_len(At(prog, 0, Block(code))),
        λ (_: Nat) (st: List<BitVec(64)>) (at: Now) => PlainAtNow<M>(saves, site, stack, spans, w, s0, registers, st, at),
        site.Arrived(prog_len(plain_again(pass.prog, test, moves, names, short)), PlainAtNow<M>(saves, site, stack, spans, w, s0, registers, final, after)),
        λ (_: Nat) => 0,
        λ (k: Nat) (st: List<BitVec(64)>) (at: Now) => PassesHold(Pass, parameters, exit, next, k, st, at, final, after),
        λ st at never => false_elim(never),
        λ k st at holds => plain_step<M>(saves, site, laid, stack, spans, c, Pass, w, s0, prog, code, head, registers, parameters, exit, next, names, short,
            pass, test, moves, labels, head_ok, pass_emits, pass_in, grows, next_file, moved, selects, into, final, after, reach, k, st, at, holds.witness, holds.proof.left,
            holds.proof.right.witness, holds.proof.right.proof.left, holds.proof.right.proof.right),
        n, state, now, ran)
}

// The loop: the entry's moves, the passes, and the outputs in the state's
// registers at J, counted by the worlds.
theorem plain_loop_emits<M>(saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), spans: Spans, c: Ceiling<M>,
    Pass: Valuation() → Now → Now → Type, values: Valuation(), w: Nat, s0: MachineState<M>, prog: Prog, file: File, inputs, parameters: List<Typed>,
    exit: Nat, next, outputs: List<Typed>, names: Nat, short: List<Nat>, registers: List<Gpr>, entry: PlainEntry,
    entered: MovesInto<M>(saves, values, file, typed_ids(inputs), registers, entry.code),
    head_ok: (v: Valuation()) → (g: Gprs) → ArgsIn(words_of(v, typed_ids(parameters)), registers, g) → entry.head.Represents(v, g),
    pass: Emitted,
    pass_emits: (v: Valuation()) → (from, to: Now) →
        EmitsNow<M>(saves, site, stack, spans, c, v, w, s0, plain_head(prog, entry.code, names), entry.head, Pass(v, from, to), from, to, pass),
    moves: List<Instruction>, next_file: File,
    moved: (v: Valuation()) → (s: MachineState<M>) → pass.file.Represents(v, s.gprs) → next_file.Represents(v, execute_block_normal(moves, s).gprs),
    tested: Tested(next_file, exit), into: (v: Valuation()) → MovesInto<M>(saves, v, pass.file, typed_ids(next), registers, moves),
    out: File, out_ok: (g: Gprs) → ArgsIn(words_of(values, typed_ids(outputs)), registers, g) → out.Represents(values, g), before, after: Now,
    grows: (v: Valuation()) → (from, to: Now) → Pass(v, from, to) → Extends(to.io.past, from.io.past), ):
    EmitsNow<M>(saves, site, stack, spans, c, values, w, s0, prog, file,
        Exists<Nat>(λ n => PassesHold(Pass, parameters, exit, next, n, words_of(values, typed_ids(inputs)), before, words_of(values, typed_ids(outputs)),
            after)),
        before, after, Emitted(plain_done(pass.prog, tested.test, moves, names, short), out, pass.placement, pass.names)) {
    let program = site.program;
    let code = entry.code;
    let test = tested.test;
    let kernel = site.ceiling(stack, c);
    let mem = now_in<M>(site.data, spans);
    let head_pass: plain_head(prog, code, names).Within(pass.prog) = (pass_emits(values, before, before)).left;
    let facts: Type = Exists<Nat>(λ n => PassesHold(Pass, parameters, exit, next, n, words_of(values, typed_ids(inputs)), before,
        words_of(values, typed_ids(outputs)), after));
    let pre = λ (g: Gprs) (m: M) => (file.Represents(values, g) ∧ (facts ∧ c.Under(after))) ∧
        (Kept(body_kept(saves), s0.gprs, g) ∧ stack.TrailBy(spans, mem, w, s0.memory, before, m));
    let into_head: prog.Within(plain_head(prog, code, names)) = Exists(2, refl);
    let pass_done: pass.prog.Within(plain_done(pass.prog, test, moves, names, short)) = Exists(5, refl);
    let done_prog = plain_done(pass.prog, test, moves, names, short);
    let goal = NowPost<M>(saves, site, stack, spans, values, w, s0, prog_len(done_prog), out, after);
    let start_pre = NowPre<M>(saves, site, stack, spans, values, w, s0, file, facts ∧ c.Under(after), before);
    ⟨Prog::within_trans(into_head, Prog::within_trans(head_pass, pass_done)),
     λ within r here resident held => {
        let labels = plain_labels<M>(site, laid, prog, code, pass.prog, test, moves, names, short, head_pass, within);
        let pass_in: pass.prog.Within(program) = Prog::within_trans(Exists(5, refl), within);
        let entered_in: At(prog, 0, Block(code)).Within(program) = Prog::within_trans(Exists(1, refl), Prog::within_trans(head_pass, pass_in));
        let entry_run = site.moves_block(stack.writes, program.laid_out_fits(laid), entered_in.witness, prog, 0, code, entered_in.proof,
            program.block_reads_at(laid, entered_in.witness, prog, 0, code, entered_in.proof), pre,
            λ (g: Gprs) (m: M) => stack.LoopAt(saves, λ (x: M) => stack.TrailBy(spans, mem, w, s0.memory, before, x), s0,
                registers, words_of(values, typed_ids(inputs)))(g, m),
            λ x memory held_x => {
                let ran = entered(x, held_x.left.left);
                ⟨ran.left, ⟨kept_trans(body_kept(saves), s0.gprs, x.gprs, execute_block_normal(code, x).gprs, held_x.right.left, ran.right),
                    held_x.right.right⟩⟩
            });
        let passes = plain_passes<M>(saves, site, laid, stack, spans, c, Pass, w, s0, prog, code, entry.head, registers, parameters, exit, next, names,
            short, pass, test, moves, labels, head_ok, pass_emits, pass_in, grows, next_file, moved, tested.selects, into, words_of(values, typed_ids(outputs)),
            after, held.left.left.right.right, held.left.left.right.left.witness, words_of(values, typed_ids(inputs)), before,
            held.left.left.right.left.proof);
        let whole = site.claims_after_moves(stack.writes, kernel, passes.witness, 0, prog_len(prog), prog_len(At(prog, 0, Block(code))),
            λ (x: MachineState<M>) => pre(x.gprs, x.memory), PlainAt<M>(saves, site, stack, spans, w, s0, registers, words_of(values, typed_ids(inputs)), before),
            λ (w2: Io) => NowWorld()(before, w2),
            site.Arrived(prog_len(plain_again(pass.prog, test, moves, names, short)),
                PlainAtNow<M>(saves, site, stack, spans, w, s0, registers, words_of(values, typed_ids(outputs)), after)), entry_run, passes.proof);
        let ended = site.claims_weaken(stack.writes, kernel, passes.witness, 0, prog_len(prog),
            λ (x: Running<M, Io>) => pre(x.state.gprs, x.state.memory) ∧ NowWorld()(before, x.io),
            site.Arrived(prog_len(plain_again(pass.prog, test, moves, names, short)),
                PlainAtNow<M>(saves, site, stack, spans, w, s0, registers, words_of(values, typed_ids(outputs)), after)),
            start_pre, goal, whole, λ x h => ⟨⟨h.left.left, h.left.right⟩, h.right⟩,
            λ t at => ⟨at.left, ⟨⟨out_ok(t.state.gprs, at.right.left.left), at.right.left.right⟩, at.right.right⟩⟩);
        site.claims_ceiling(stack, c, passes.witness, 0, prog_len(prog), start_pre, goal,
            λ x h t at => c.under_len(after, t.io, at.right.right.left, h.left.left.right.right), ended)(r, here, resident, held)
     }⟩
}

// The entry's moves and the head's file.
fn MayPlainEntry<M>(saves: Nat, values: Valuation(), file: File, inputs, parameters: List<Nat>, registers: List<Gpr>, out: Option<PlainEntry>) → Type {
    out.All(λ (entry: PlainEntry) => MovesInto<M>(saves, values, file, inputs, registers, entry.code) ∧
        ((v: Valuation()) → (g: Gprs) → ArgsIn(words_of(v, parameters), registers, g) → entry.head.Represents(v, g)))
}

theorem plain_entry_sound<M>(saves: Nat, values: Valuation(), file: File, inputs, parameters: List<Nat>, registers: List<Gpr>):
    MayPlainEntry<M>(saves, values, file, inputs, parameters, registers, file.plain_entry(saves, inputs, parameters, registers)) {
    (match file.move_outputs(word_ports(inputs), registers) as λ o => MayKeep<M>(values, file, True, o) →
        MayPlainEntry<M>(saves, values, file, inputs, parameters, registers, match o {
            None => None,
            Some(moves) => match moves.file.outputs_check(word_ports(inputs), registers) && leaves_all(moves.code, body_kept(saves)) {
                False => None,
                True => match input_file(word_ports(parameters), registers) { None => None, Some(head) => Some(PlainEntry(moves.code, head)) },
            },
        }) {
        None => λ _ => trivial,
        Some(moves) => λ keeps => match checked: moves.file.outputs_check(word_ports(inputs), registers) && leaves_all(moves.code, body_kept(saves)) {
            False => trivial,
            True => {
                let parts = Bool::is_true_and(moves.file.outputs_check(word_ports(inputs), registers), leaves_all(moves.code, body_kept(saves)),
                    is_true_of_eq(moves.file.outputs_check(word_ports(inputs), registers) && leaves_all(moves.code, body_kept(saves)), checked));
                (match input_file(word_ports(parameters), registers) as λ o =>
                    ((v: Valuation()) → (g: Gprs) → PortsAt(v, word_ports(parameters), registers, g) → o.All(λ (f: File) => f.Represents(v, g))) →
                    MayPlainEntry<M>(saves, values, file, inputs, parameters, registers, match o { None => None, Some(head) => Some(PlainEntry(moves.code, head)) }) {
                    None => λ _ => trivial,
                    Some(head) => λ head_ok => ⟨moves_into<M>(saves, values, file, inputs, registers, moves, keeps, parts.left, parts.right),
                        λ v g args => head_ok(v, g, args_ports(v, parameters, registers, g, args))⟩,
                })(λ v g placed => input_file_represents(v, g, word_ports(parameters), registers, placed))
            },
        },
    })(move_outputs_keeps<M>(values, word_ports(inputs), file, registers))
}

// After the pass, as `Emitted::plain_close` checks it.
theorem plain_close_emits<M>(saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), spans: Spans, c: Ceiling<M>,
    Pass: Valuation() → Now → Now → Type, values: Valuation(), w: Nat, s0: MachineState<M>, prog: Prog, file: File, inputs, parameters: List<Typed>,
    exit: Nat, next, outputs: List<Typed>, names: Nat, short: List<Nat>, registers: List<Gpr>, entry: PlainEntry,
    entry_ok: MovesInto<M>(saves, values, file, typed_ids(inputs), registers, entry.code) ∧
        ((v: Valuation()) → (g: Gprs) → ArgsIn(words_of(v, typed_ids(parameters)), registers, g) → entry.head.Represents(v, g)),
    pass: Emitted,
    pass_emits: (v: Valuation()) → (from, to: Now) →
        EmitsNow<M>(saves, site, stack, spans, c, v, w, s0, plain_head(prog, entry.code, names), entry.head, Pass(v, from, to), from, to, pass),
    before, after: Now, grows: (v: Valuation()) → (from, to: Now) → Pass(v, from, to) → Extends(to.io.past, from.io.past)):
    MayEmitNow<M>(saves, site, stack, spans, c, values, w, s0, prog, file,
        Exists<Nat>(λ n => PassesHold(Pass, parameters, exit, next, n, words_of(values, typed_ids(inputs)), before, words_of(values, typed_ids(outputs)),
            after)),
        before, after, pass.plain_close(saves, registers, exit, typed_ids(next), typed_ids(outputs), names, short)) {
    let facts: Type = Exists<Nat>(λ n => PassesHold(Pass, parameters, exit, next, n, words_of(values, typed_ids(inputs)), before,
        words_of(values, typed_ids(outputs)), after));
    let nexts = word_ports(typed_ids(next));
    let outs = word_ports(typed_ids(outputs));
    (match pass.file.move_outputs(nexts, registers) as λ o => ((v: Valuation()) → MayKeep<M>(v, pass.file, True, o)) →
        MayEmitNow<M>(saves, site, stack, spans, c, values, w, s0, prog, file, facts, before, after, match o {
            None => None,
            Some(moves) => match moves.file.outputs_check(nexts, registers) && leaves_all(moves.code, body_kept(saves)) {
                False => None,
                True => match moves.file.branch_test(exit) {
                    None => None,
                    Some(tested) => match input_file(outs, registers) { None => None, Some(out) => Some(Emitted(plain_done(pass.prog, tested.test, moves.code, names, short), out, pass.placement, pass.names)) },
                },
            },
        }) {
        None => λ _ => trivial,
        Some(moves) => λ keeps => match checked: moves.file.outputs_check(nexts, registers) && leaves_all(moves.code, body_kept(saves)) {
            False => trivial,
            True => {
                let parts = Bool::is_true_and(moves.file.outputs_check(nexts, registers), leaves_all(moves.code, body_kept(saves)),
                    is_true_of_eq(moves.file.outputs_check(nexts, registers) && leaves_all(moves.code, body_kept(saves)), checked));
                match moves.file.branch_test(exit) as λ t => MayEmitNow<M>(saves, site, stack, spans, c, values, w, s0, prog, file, facts, before, after, match t {
                        None => None,
                        Some(tested) => match input_file(outs, registers) { None => None, Some(out) => Some(Emitted(plain_done(pass.prog, tested.test, moves.code, names, short), out, pass.placement, pass.names)) },
                    }) {
                    None => trivial,
                    Some(tested) => (match input_file(outs, registers) as λ o =>
                        ((g: Gprs) → PortsAt(values, outs, registers, g) → o.All(λ (f: File) => f.Represents(values, g))) →
                        MayEmitNow<M>(saves, site, stack, spans, c, values, w, s0, prog, file, facts, before, after, match o { None => None, Some(out) => Some(Emitted(plain_done(pass.prog, tested.test, moves.code, names, short), out, pass.placement, pass.names)) }) {
                        None => λ _ => trivial,
                        Some(out) => λ out_ok => plain_loop_emits<M>(saves, site, laid, stack, spans, c, Pass, values, w, s0, prog, file, inputs, parameters, exit,
                            next, outputs, names, short, registers, entry, entry_ok.left, entry_ok.right, pass, pass_emits, moves.code, moves.file,
                            λ v u rep => keeps(v)(u, rep, trivial), tested,
                            λ v => moves_into<M>(saves, v, pass.file, typed_ids(next), registers, moves, keeps(v), parts.left, parts.right), out,
                            λ g args => out_ok(g, args_ports(values, typed_ids(outputs), registers, g, args)), before, after, grows),
                    })(λ g placed => input_file_represents(values, g, outs, registers, placed)),
                }
            },
        },
    })(λ v => move_outputs_keeps<M>(v, nexts, pass.file, registers))
}

// The loop's code, as `Body::emit` checks it, from its body's emission at
// every valuation (`inner_emits`, the region theorem at the pass's).
theorem loop_heap_emits<M>(saves, slots: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data),
    spans: Spans, c: Ceiling<M>, g: CallGuards, blocks: Blocks, answers: RoutineAnswers(), grows: AnswersExtend(answers), values: Valuation(), spare, w: Nat, s0: MachineState<M>, short: List<Nat>, bound: Nat,
    inputs, parameters: List<Typed>, inner: Body, exit: Nat, next, outputs: List<Typed>, prog: Prog, file: File, placement: List<Place>, names: Nat,
    before, after: Now,
    inner_emits: (start: Prog) → (head: File) → (rest: List<Place>) → (v: Valuation()) → (from, to: Now) →
        MayEmitNow<M>(saves, site, stack, spans, c, v, w, s0, start, head, inner.Holds(spans, blocks, v, answers, spare, from, to), from, to,
            inner.emit_by(g, saves, slots, short, bound, spare, start, head, rest, names + 4))):
    MayEmitNow<M>(saves, site, stack, spans, c, values, w, s0, prog, file,
        Body::Loop(inputs, parameters, inner, exit, next, outputs).Holds(spans, blocks, values, answers, spare, before, after), before, after,
        match state_registers(placement, typed_ids(parameters).len()) {
            None => None,
            Some(taken) => match file.plain_entry(saves, typed_ids(inputs), typed_ids(parameters), taken.registers) {
                None => None,
                Some(entry) => match inner.emit_by(g, saves, slots, short, bound, spare, plain_head(prog, entry.code, names), entry.head, taken.rest, names + 4) {
                    None => None,
                    Some(pass) => pass.plain_close(saves, taken.registers, exit, typed_ids(next), typed_ids(outputs), names, short),
                },
            },
        }) {
    let Pass = λ (v: Valuation()) (from: Now) (to: Now) => inner.Holds(spans, blocks, v, answers, spare, from, to);
    let facts = Body::Loop(inputs, parameters, inner, exit, next, outputs).Holds(spans, blocks, values, answers, spare, before, after);
    match state_registers(placement, typed_ids(parameters).len()) as λ o => MayEmitNow<M>(saves, site, stack, spans, c, values, w, s0, prog, file, facts,
            before, after, match o {
                None => None,
                Some(taken) => match file.plain_entry(saves, typed_ids(inputs), typed_ids(parameters), taken.registers) {
                    None => None,
                    Some(entry) => match inner.emit_by(g, saves, slots, short, bound, spare, plain_head(prog, entry.code, names), entry.head, taken.rest, names + 4) {
                        None => None,
                        Some(pass) => pass.plain_close(saves, taken.registers, exit, typed_ids(next), typed_ids(outputs), names, short),
                    },
                },
            }) {
        None => trivial,
        Some(taken) => (match file.plain_entry(saves, typed_ids(inputs), typed_ids(parameters), taken.registers) as λ e =>
            MayPlainEntry<M>(saves, values, file, typed_ids(inputs), typed_ids(parameters), taken.registers, e) →
            MayEmitNow<M>(saves, site, stack, spans, c, values, w, s0, prog, file, facts, before, after, match e {
                None => None,
                Some(entry) => match inner.emit_by(g, saves, slots, short, bound, spare, plain_head(prog, entry.code, names), entry.head, taken.rest, names + 4) {
                    None => None,
                    Some(pass) => pass.plain_close(saves, taken.registers, exit, typed_ids(next), typed_ids(outputs), names, short),
                },
            }) {
            None => λ _ => trivial,
            Some(entry) => λ entry_ok => (match inner.emit_by(g, saves, slots, short, bound, spare, plain_head(prog, entry.code, names), entry.head, taken.rest,
                    names + 4) as λ e =>
                ((v: Valuation()) → (from, to: Now) → MayEmitNow<M>(saves, site, stack, spans, c, v, w, s0, plain_head(prog, entry.code, names), entry.head,
                    Pass(v, from, to), from, to, e)) →
                MayEmitNow<M>(saves, site, stack, spans, c, values, w, s0, prog, file, facts, before, after, match e {
                    None => None,
                    Some(pass) => pass.plain_close(saves, taken.registers, exit, typed_ids(next), typed_ids(outputs), names, short),
                }) {
                None => λ _ => trivial,
                Some(pass) => λ pass_emits => plain_close_emits<M>(saves, site, laid, stack, spans, c, Pass, values, w, s0, prog, file, inputs, parameters, exit,
                    next, outputs, names, short, taken.registers, entry, entry_ok, pass, pass_emits, before, after,
                    λ v from to h => inner.holds_extends(spans, blocks, answers, grows, spare, v, from, to, h)),
            })(λ v from to => inner_emits(plain_head(prog, entry.code, names), entry.head, taken.rest, v, from, to)),
        })(plain_entry_sound<M>(saves, values, file, typed_ids(inputs), typed_ids(parameters), taken.registers)),
    }
}

// The branch: the generic conditional (`branch_emits_by`), the bit picking
// the arm's facts, both arms at the ceiling.
theorem branch_heap_emits<M>(saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data),
    spans: Spans, c: Ceiling<M>, blocks: Blocks, values: Valuation(), answers: RoutineAnswers(), spare: Nat, d: Nat, s0: MachineState<M>, prog: Prog,
    file: File, condition: Nat, yes, no: Body, before, after: Now, tested: Tested(file, condition), names: Nat, short: List<Nat>, left, right: Emitted,
    yes_emits: EmitsNow<M>(saves, site, stack, spans, c, values, d, s0, prog.branched_by(tested.test, names + 1, shorts(short, names + 1)),
        file.know(Truth(condition)), yes.Holds(spans, blocks, values, answers, spare, before, after), before, after, left),
    no_emits: EmitsNow<M>(saves, site, stack, spans, c, values, d, s0, left.prog.else_label_by(names + 1, names + 2, shorts(short, names + 2)),
        file.know(Falsity(condition)), no.Holds(spans, blocks, values, answers, spare, before, after), before, after, right)):
    EmitsNow<M>(saves, site, stack, spans, c, values, d, s0, prog, file,
        Body::Branch(condition, yes, no).Holds(spans, blocks, values, answers, spare, before, after),
        before, after, Emitted(right.prog.join_label(names + 2), left.file.meet(right.file, file.known), right.placement, right.names)) {
    let picked = λ (b: Bool) => match b {
        True => yes.Holds(spans, blocks, values, answers, spare, before, after),
        False => no.Holds(spans, blocks, values, answers, spare, before, after),
    };
    let bit = values(1, condition).head_bit();
    branch_emits_claim<M, Now, Io>(saves, site, laid, stack, spans, now_in<M>(site.data, spans), NowWorld(), site.ceiling(stack, c),
        c.count(), 0, values, d, s0, prog, file, condition, picked(bit) ∧ c.Under(after),
        yes.Holds(spans, blocks, values, answers, spare, before, after) ∧ c.Under(after),
        no.Holds(spans, blocks, values, answers, spare, before, after) ∧ c.Under(after), before, after,
        tested, names, short, left, right, yes_emits, no_emits,
        λ h clear => ⟨j(function_ir_lower_calls::not_false(bit, clear), λ b _ => picked(b), h.left), h.right⟩,
        λ h set => ⟨j(function_ir_lower_calls::not_true(bit, set), λ b _ => picked(b), h.left), h.right⟩)
}

// A sequence: its parts through a state between, each at the ceiling, the
// first's world after under it because the rest's extends it (`grows`),
// `may_emit_claim_seq` cited as stated, and the sum read back to the
// ceiling (`emits_now_ceiling`).
theorem may_emit_now_seq<M>(saves: Nat, site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, c: Ceiling<M>, values: Valuation(), d: Nat,
    s0: MachineState<M>, prog: Prog, file: File, First, Rest: Now → Type, before, after: Now, done: Emitted,
    grows: (mid: Now) → Rest(mid) → Extends(after.io.past, mid.io.past),
    first_emits: (mid: Now) → EmitsNow<M>(saves, site, stack, spans, c, values, d, s0, prog, file, First(mid), before, mid, done), out: Option<Emitted>,
    rest_emits: (mid: Now) → MayEmitNow<M>(saves, site, stack, spans, c, values, d, s0, done.prog, done.file, Rest(mid), mid, after, out)):
    MayEmitNow<M>(saves, site, stack, spans, c, values, d, s0, prog, file,
        Exists<Now>(λ (mid: Now) => (First(mid) ∧ Rest(mid)) ∧ Between(before, mid, after)), before, after, out) {
    let k = c.count();
    let mem = now_in<M>(site.data, spans);
    let kernel = site.ceiling(stack, c);
    let First2 = λ (mid: Now) => First(mid) ∧ (Rest(mid) ∧ c.Under(after));
    let Rest2 = λ (mid: Now) => Rest(mid) ∧ c.Under(after);
    let first2 = λ (mid: Now) => emits_claim_weaken<M, Now, Io>(saves, site, stack, spans, mem, NowWorld(), kernel, k, 0, values, d, s0, prog, file,
        First(mid) ∧ c.Under(mid), First2(mid), λ h => ⟨h.left, c.under_extends(after, mid, h.right.right, grows(mid, h.right.left))⟩, before, mid, done,
        first_emits(mid));
    (match out as λ o => ((mid: Now) → MayEmitNow<M>(saves, site, stack, spans, c, values, d, s0, done.prog, done.file, Rest(mid), mid, after, o)) →
        MayEmitNow<M>(saves, site, stack, spans, c, values, d, s0, prog, file,
            Exists<Now>(λ (mid: Now) => (First(mid) ∧ Rest(mid)) ∧ Between(before, mid, after)), before, after, o) {
        None => λ _ => trivial,
        Some(e) => λ rest => {
            let both = may_emit_claim_seq<M, Now, Io>(saves, site, stack, spans, mem, NowWorld(), kernel, k, 0, k, 0, values, d, s0, prog, file, First2, Rest2,
                before, after, done, first2, Some(e), rest);
            emits_now_ceiling<M>(saves, site, stack, spans, c, values, d, s0, prog, file,
                Exists<Now>(λ (mid: Now) => (First(mid) ∧ Rest(mid)) ∧ Between(before, mid, after)), before, after, e, k + k,
                emits_claim_weaken<M, Now, Io>(saves, site, stack, spans, mem, NowWorld(), kernel, k + k, 0 + 0, values, d, s0, prog, file,
                    Exists<Now>(λ (mid: Now) => First2(mid) ∧ Rest2(mid)),
                    Exists<Now>(λ (mid: Now) => (First(mid) ∧ Rest(mid)) ∧ Between(before, mid, after)) ∧ c.Under(after),
                    λ h => Exists(h.left.witness, ⟨⟨h.left.proof.left.left, ⟨h.left.proof.left.right, h.right⟩⟩, ⟨h.left.proof.left.right, h.right⟩⟩),
                    before, after, e, both))
        },
    })(rest_emits)
}

// The frame a region's body runs in: FunctionIR's `Stack::CallFrame`
// without a call's 24 bytes, which each call has from its own room (an
// unguarded call's from the table, a guarded call's from its guard).
fn Stack::BodyFrame<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data), top, avail, d, slots, w: Nat,
    s0: MachineState<M>) → Type {
    (read_gpr(Rsp, s0.gprs) = stack.at(d)) ∧ ((avail <= d) ∧ ((d + 8 * slots = w) ∧ ((d + 8 * slots <= stack.size) ∧ ((d + 8 * slots) + 8 <= top))))
}

// The program's stop, laid out at the guards' label.
record StopLaid<M>(site: Site<M>, stop: Nat) { name: Nat, named: stop = name + 1, before: Prog, within: before.stopped_at(stop).Within(site.program) }

// A region's code meets its meaning at the ceiling `c`, for every heap
// and world before and after: its calls against their callees' claims
// (`callees`, each callee's escape the region's by `carries`), its frame
// at `d` with `slots` call slots below it where it calls
// (`Stack::BodyFrame`), the body's own offset `w`; a guarded call's guard
// reads the floor (`floor`) and jumps to the stop (`stopping`), where the
// region's escape holds (`spent`).
theorem Body::emit_emits<M>(self body: Body, g: CallGuards, saves, slots: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(),
    stack: Stack<M>(site.fetch, site.data), top: Nat, spans: Spans, loan: Loan<M>(site.fetch, site.data, stack, top, spans), blocks: Blocks,
    lent: blocks.Lent(spans), bound, avail: Nat, deep: Nat → Nat, deep_avail: Nat, answers: RoutineAnswers(), grows: AnswersExtend(answers), floored: Bool,
    spends: Nat → Nat → Running<M, Io> → Type,
    callees: CalleesReturn<M>(site, stack, spans, g.rooms, floored, top, bound, answers, spends), c: Ceiling<M>, spare: Nat, d, w: Nat, s0: MachineState<M>,
    framing: body.calls().IsTrue() → stack.BodyFrame(top, avail, d, slots, w, s0),
    floor: floored.IsTrue() → (gp: Gprs) → Kept(body_kept(saves), s0.gprs, gp) → read_gpr(Rbp, gp) = stack.low,
    guarding: (callee: Nat) → g.guards(callee) = True → floored.IsTrue(),
    stopping: (callee: Nat) → g.guards(callee) = True → StopLaid<M>(site, g.stop),
    spent: (callee: Nat) → g.guards(callee) = True → (args: List<Value>) → (heap: Heap) → (io: Io) → (a: Answer) → answers(callee, args, heap, io, a) →
        callee + 1 <= bound → deep(callee) + 24 <= deep_avail → d < 24 + g.rooms(callee) → (t: Running<M, Io>) → site.SpentExit(stack)(t) → c.esc(t),
    carries: (callee: Nat) → callee + 1 <= bound → deep(callee) + 24 <= deep_avail → (count: Nat) → count <= 2 → (t: Running<M, Io>) → spends(callee, (d - 8 * count) - 8)(t) → c.esc(t),
    short: List<Nat>):
    body.FitsBy(g.at, g.rooms, bound, avail) → body.Fits(deep, bound, deep_avail) → (values: Valuation()) → (prog: Prog) → (file: File) → (placement: List<Place>) → (names: Nat) →
    (before, after: Now) →
    MayEmitNow<M>(saves, site, stack, spans, c, values, w, s0, prog, file, body.Holds(spans, blocks, values, answers, spare, before, after), before, after,
        body.emit_by(g, saves, slots, short, bound, spare, prog, file, placement, names)) {
    match body {
        Leaf(instrs) => λ shallow deeply values prog file placement names before after =>
            may_emit_now_of_linux<M>(saves, site, stack, spans, c, values, w, s0, prog, file, InstrsHold(spans, blocks, values, instrs, before.heap, after.heap) ∧
                (after.io = before.io), before, after, emit_instrs(saves, prog, file, instrs, placement, names),
                may_emit_linux_of_heap<M>(saves, site, stack, spans, values, w, s0, prog, file, InstrsHold(spans, blocks, values, instrs, before.heap, after.heap),
                    before, after, emit_instrs(saves, prog, file, instrs, placement, names),
                    emit_instrs_emits<M>(saves, site, laid, stack, top, spans, loan, blocks, lent, values, w, s0, instrs, prog, file, placement, names,
                        before.heap, after.heap))),
        Seq(first, rest) => λ shallow deeply values prog file placement names before after =>
            (match first.emit_by(g, saves, slots, short, bound, spare, prog, file, placement, names) as λ o =>
                ((mid: Now) → MayEmitNow<M>(saves, site, stack, spans, c, values, w, s0, prog, file,
                    first.Holds(spans, blocks, values, answers, spare, before, mid), before, mid, o)) →
                MayEmitNow<M>(saves, site, stack, spans, c, values, w, s0, prog, file,
                    Body::Seq(first, rest).Holds(spans, blocks, values, answers, spare, before, after), before, after,
                    match o { None => None, Some(done) => rest.emit_by(g, saves, slots, short, bound, spare, done.prog, done.file, done.placement, done.names) }) {
                None => λ _ => trivial,
                Some(done) => λ first_emits => may_emit_now_seq<M>(saves, site, stack, spans, c, values, w, s0, prog, file,
                    λ (mid: Now) => first.Holds(spans, blocks, values, answers, spare, before, mid),
                    λ (mid: Now) => rest.Holds(spans, blocks, values, answers, spare, mid, after),
                    before, after, done, λ mid h => rest.holds_extends(spans, blocks, answers, grows, spare, values, mid, after, h), first_emits,
                    rest.emit_by(g, saves, slots, short, bound, spare, done.prog, done.file, done.placement, done.names),
                    λ mid => Body::emit_emits<M>(rest, g, saves, slots, site, laid, stack, top, spans, loan, blocks, lent, bound, avail, deep, deep_avail, answers, grows, floored, spends,
                        callees, c, spare, d, w, s0, λ x => framing(Bool::is_true_or_r(first.calls(), rest.calls(), x)), floor, guarding, stopping, spent, carries, short,
                        shallow.right, deeply.right, values, done.prog, done.file, done.placement, done.names, mid, after)),
            })(λ mid => Body::emit_emits<M>(first, g, saves, slots, site, laid, stack, top, spans, loan, blocks, lent, bound, avail, deep, deep_avail, answers, grows, floored, spends,
                callees, c, spare, d, w, s0, λ x => framing(Bool::is_true_or_l(first.calls(), rest.calls(), x)), floor, guarding, stopping, spent, carries, short,
                shallow.left, deeply.left, values, prog, file, placement, names, before, mid)),
        Branch(condition, yes, no) => λ shallow deeply values prog file placement names before after =>
            (match file.branch_test(condition) as λ o => MayEmitNow<M>(saves, site, stack, spans, c, values, w, s0, prog, file,
                    Body::Branch(condition, yes, no).Holds(spans, blocks, values, answers, spare, before, after), before, after, match o {
                        None => None,
                        Some(tested) => match yes.emit_by(g, saves, slots, short, bound, spare, prog.branched_by(tested.test, names + 1, shorts(short, names + 1)),
                            file.know(Truth(condition)), placement, names + 2) {
                            None => None,
                            Some(left) => match no.emit_by(g, saves, slots, short, bound, spare,
                                left.prog.else_label_by(names + 1, names + 2, shorts(short, names + 2)), file.know(Falsity(condition)), left.placement,
                                left.names) {
                                None => None,
                                Some(right) => Some(Emitted(right.prog.join_label(names + 2), left.file.meet(right.file, file.known), right.placement,
                                    right.names)),
                            },
                        },
                    }) {
                None => trivial,
                Some(tested) => {
                    let yes_prog = prog.branched_by(tested.test, names + 1, shorts(short, names + 1));
                    (match yes.emit_by(g, saves, slots, short, bound, spare, yes_prog, file.know(Truth(condition)), placement, names + 2) as λ o =>
                        MayEmitNow<M>(saves, site, stack, spans, c, values, w, s0, yes_prog, file.know(Truth(condition)),
                            yes.Holds(spans, blocks, values, answers, spare, before, after), before, after, o) →
                        MayEmitNow<M>(saves, site, stack, spans, c, values, w, s0, prog, file,
                            Body::Branch(condition, yes, no).Holds(spans, blocks, values, answers, spare, before, after), before, after, match o {
                                None => None,
                                Some(left) => match no.emit_by(g, saves, slots, short, bound, spare,
                                    left.prog.else_label_by(names + 1, names + 2, shorts(short, names + 2)), file.know(Falsity(condition)), left.placement,
                                    left.names) {
                                    None => None,
                                    Some(right) => Some(Emitted(right.prog.join_label(names + 2), left.file.meet(right.file, file.known), right.placement,
                                        right.names)),
                                },
                            }) {
                        None => λ _ => trivial,
                        Some(left) => λ yes_emits => {
                            let no_prog = left.prog.else_label_by(names + 1, names + 2, shorts(short, names + 2));
                            (match no.emit_by(g, saves, slots, short, bound, spare, no_prog, file.know(Falsity(condition)), left.placement, left.names) as λ o =>
                                MayEmitNow<M>(saves, site, stack, spans, c, values, w, s0, no_prog, file.know(Falsity(condition)),
                                    no.Holds(spans, blocks, values, answers, spare, before, after), before, after, o) →
                                MayEmitNow<M>(saves, site, stack, spans, c, values, w, s0, prog, file,
                                    Body::Branch(condition, yes, no).Holds(spans, blocks, values, answers, spare, before, after), before, after, match o {
                                        None => None,
                                        Some(right) => Some(Emitted(right.prog.join_label(names + 2), left.file.meet(right.file, file.known),
                                            right.placement, right.names)),
                                    }) {
                                None => λ _ => trivial,
                                Some(right) => λ no_emits => branch_heap_emits<M>(saves, site, laid, stack, spans, c, blocks, values, answers, spare, w, s0, prog,
                                    file, condition, yes, no, before, after, tested, names, short, left, right, yes_emits, no_emits),
                            })(Body::emit_emits<M>(no, g, saves, slots, site, laid, stack, top, spans, loan, blocks, lent, bound, avail, deep, deep_avail, answers, grows, floored, spends,
                                callees, c, spare, d, w, s0, λ x => framing(Bool::is_true_or_r(yes.calls(), no.calls(), x)), floor, guarding, stopping, spent, carries,
                                short, shallow.right, deeply.right, values, no_prog, file.know(Falsity(condition)), left.placement, left.names, before, after))
                        },
                    })(Body::emit_emits<M>(yes, g, saves, slots, site, laid, stack, top, spans, loan, blocks, lent, bound, avail, deep, deep_avail, answers, grows, floored, spends,
                        callees, c, spare, d, w, s0, λ x => framing(Bool::is_true_or_l(yes.calls(), no.calls(), x)), floor, guarding, stopping, spent, carries, short,
                        shallow.left, deeply.left, values, yes_prog, file.know(Truth(condition)), placement, names + 2, before, after))
                },
            }),
        Call(callee, arguments, results) => λ shallow deeply values prog file placement names before after => {
            let frame = framing(trivial);
            let facts = Body::Call(callee, arguments, results).Holds(spans, blocks, values, answers, spare, before, after);
            let unguarded = file.emit_call(slots, prog, callee, typed_ids(arguments), call_result(results, spare), call_also(results), placement, names,
                bound, [], []);
            j(frame.right.right.left, λ x _ => MayEmitNow<M>(saves, site, stack, spans, c, values, x, s0, prog, file, facts, before, after,
                    Body::Call(callee, arguments, results).emit_by(g, saves, slots, short, bound, spare, prog, file, placement, names)),
                (match among(g.at, callee) as λ b => among(g.at, callee) = b → (match b as λ _ => Type { True => True, False => g.rooms(callee) + 24 <= avail }) →
                    MayEmitNow<M>(saves, site, stack, spans, c, values, d + 8 * slots, s0, prog, file, facts, before, after, match b as λ _ => Option<Emitted> {
                        False => unguarded,
                        True => match g.need(callee).leb(guard_most()) {
                            False => None,
                            True => file.emit_call(slots, prog.guarded(g.need(callee), g.stop), callee, typed_ids(arguments), call_result(results, spare),
                                call_also(results), placement, names, bound, [], []),
                        },
                    }) {
                    False => λ _ fit => call_now_emits<M>(saves, slots, site, laid, stack, top, spans, loan, g.rooms, bound, avail, answers, floored, spends, callees,
                        c, blocks, values, spare, d, s0, frame.left, floor, frame.right.left, frame.right.right.right.left, frame.right.right.right.right, prog, file,
                        callee, arguments, results, fit, λ below2 => carries(callee, below2, deeply(below2)), placement, names, before, after),
                    True => λ guarded _ => match ok: g.need(callee).leb(guard_most()) {
                        False => trivial,
                        True => {
                            let laid_stop = stopping(callee, guarded);
                            j(sym(laid_stop.named), λ s _ => MayEmitNow<M>(saves, site, stack, spans, c, values, d + 8 * slots, s0, prog, file, facts, before,
                                    after, file.emit_call(slots, prog.guarded(g.need(callee), s), callee, typed_ids(arguments), call_result(results, spare),
                                        call_also(results), placement, names, bound, [], [])),
                                guarded_call_emits<M>(saves, slots, site, laid, stack, top, spans, loan, g.rooms, bound, answers, grows, floored, spends, callees, c,
                                    blocks, values, spare, d, s0, frame.left, floor(guarding(callee, guarded)), frame.right.right.right.left, frame.right.right.right.right, prog, file,
                                    callee, arguments, results, laid_stop.name, laid_stop.before,
                                    j(laid_stop.named, λ s _ => laid_stop.before.stopped_at(s).Within(site.program), laid_stop.within),
                                    g.need(callee).leb_sound(guard_most(), is_true_of_eq(g.need(callee).leb(guard_most()), ok)), before, after,
                                    λ below args a answered short2 => spent(callee, guarded, args, before.heap, before.io, a, answered, below, deeply(below), short2),
                                    λ below2 => carries(callee, below2, deeply(below2)), placement, names))
                        },
                    },
                })(refl, shallow))
        },
        Loop(inputs, parameters, inner, exit, next, outputs) => λ shallow deeply values prog file placement names before after =>
            loop_heap_emits<M>(saves, slots, site, laid, stack, spans, c, g, blocks, answers, grows, values, spare, w, s0, short, bound, inputs, parameters,
                inner, exit, next, outputs, prog, file, placement, names, before, after,
                λ start head rest v from to => Body::emit_emits<M>(inner, g, saves, slots, site, laid, stack, top, spans, loan, blocks, lent, bound, avail, deep, deep_avail,
                    answers, grows, floored, spends, callees, c, spare, d, w, s0, framing, floor, guarding, stopping, spent, carries, short, shallow, deeply, v, start, head, rest,
                    names + 4, from, to)),
        Sys(call) => λ shallow deeply values prog file placement names before after =>
            may_emit_now_of_linux<M>(saves, site, stack, spans, c, values, w, s0, prog, file, call.Lands(spans, blocks, values, before, after), before, after,
                emit_sys(saves, prog, file, call, placement, names),
                sys_emits<M>(saves, site, laid, stack, top, spans, loan, blocks, lent, values, w, s0, prog, file, call, placement, names, before, after)),
        Exit(status) => λ shallow deeply values prog file placement names before after =>
            may_emit_now_of_linux<M>(saves, site, stack, spans, c, values, w, s0, prog, file, False, before, after,
                emit_exit(prog, file, status, placement, names),
                emit_exit_emits<M>(saves, site, stack, spans, values, w, s0, prog, file, status, placement, names, before, after)),
    }
}

// A run stopped at `x` from a world: the stop's world extends it. Of the
// routines stopped (`goes`) as `AnswersExtend` is of those answered.
fn GoesExtend(x: Stop, goes: RoutineStops()) → Type {
    (f: Nat) → (args: List<Value>) → (heap: Heap) → (io: Io) → goes(f, args, heap, io) → Extends(x.world().past, io.past)
}

theorem Stop::zero_extends(self x: Stop, now: Now, zero: x.ZeroAt()(now)): Extends(x.world().past, now.io.past) {
    (match x as λ y => y.ZeroAt()(now) → Extends(y.world().past, now.io.past) {
        StopGoing(o) => λ e => j(e, λ w _ => Extends(w.past, now.io.past), extends_refl(now.io.past)),
        StopExited(_, _) => λ never => false_elim(never),
    })(zero)
}

theorem Stop::exits_extends(self x: Stop, word: BitVec(64), now: Now, exits: x.Exits(word, now.io)): Extends(x.world().past, now.io.past) {
    (match x as λ y => y.Exits(word, now.io) → Extends(y.world().past, now.io.past) {
        StopGoing(_) => λ never => false_elim(never),
        StopExited(_, o) => λ e => j(e.right, λ w _ => Extends(w.past, now.io.past), extends_refl(now.io.past)),
    })(exits)
}

theorem pass_stop_extends(x: Stop, Pass: Valuation() → Now → Now → Type, PassStops: Valuation() → Nat → Now → Type,
    grows: (v: Valuation()) → (from, to: Now) → Pass(v, from, to) → Extends(to.io.past, from.io.past),
    stops: (v: Valuation()) → (k: Nat) → (from: Now) → PassStops(v, k, from) → Extends(x.world().past, from.io.past),
    parameters: List<Typed>, exit: Nat, next: List<Typed>, zero: Now → Type, zeroes: (now: Now) → zero(now) → Extends(x.world().past, now.io.past),
    fuel: Nat): (state: List<BitVec(64)>) → (from: Now) →
    PassesStop(Pass, PassStops, parameters, exit, next, zero, fuel, state, from) → Extends(x.world().past, from.io.past) {
    match fuel {
        Zero => λ state from h => match h.proof.right {
            Inl(going) => stops(h.witness, 0, from, going),
            Inr(done) => extends_trans(x.world().past, done.witness.io.past, from.io.past, zeroes(done.witness, done.proof.right.right),
                grows(h.witness, from, done.witness, done.proof.left)),
        },
        Succ(rest) => λ state from h => match h.proof.right {
            Inl(going) => stops(h.witness, Succ(rest), from, going),
            Inr(done) => extends_trans(x.world().past, done.witness.io.past, from.io.past,
                pass_stop_extends(x, Pass, PassStops, grows, stops, parameters, exit, next, zero, zeroes, rest,
                    words_of(h.witness, typed_ids(next)), done.witness, done.proof.right.right),
                grows(h.witness, from, done.witness, done.proof.left)),
        },
    }
}

theorem Body::stops_extends(self body: Body, spans: Spans, blocks: Blocks, answers: RoutineAnswers(), grows: AnswersExtend(answers),
    goes: RoutineStops(), x: Stop, going: GoesExtend(x, goes), spare: Nat):
    (values: Valuation()) → (fuel: Nat) → (before: Now) → body.Stops(spans, blocks, values, answers, goes, x, spare, fuel, before) →
    Extends(x.world().past, before.io.past) {
    match body {
        Leaf(_) => λ values fuel before never => false_elim(never),
        Seq(first, rest) => λ values fuel before h => match h {
            Inl(stopped) => first.stops_extends(spans, blocks, answers, grows, goes, x, going, spare, values, fuel, before, stopped),
            Inr(done) => extends_trans(x.world().past, done.witness.io.past, before.io.past,
                rest.stops_extends(spans, blocks, answers, grows, goes, x, going, spare, values, fuel, done.witness, done.proof.right),
                first.holds_extends(spans, blocks, answers, grows, spare, values, before, done.witness, done.proof.left)),
        },
        Branch(condition, yes, no) => λ values fuel before => (match values(1, condition).head_bit() as λ b => (match b {
            True => yes.Stops(spans, blocks, values, answers, goes, x, spare, fuel, before),
            False => no.Stops(spans, blocks, values, answers, goes, x, spare, fuel, before),
        }) → Extends(x.world().past, before.io.past) {
            True => λ h => yes.stops_extends(spans, blocks, answers, grows, goes, x, going, spare, values, fuel, before, h),
            False => λ h => no.stops_extends(spans, blocks, answers, grows, goes, x, going, spare, values, fuel, before, h),
        }),
        Call(callee, arguments, _) => λ values fuel before h => going(callee, h.witness, before.heap, before.io, h.proof.right),
        Loop(inputs, parameters, inner, exit, next, _) => λ values fuel before h => pass_stop_extends(x,
            λ (v: Valuation()) (from: Now) (to: Now) => inner.Holds(spans, blocks, v, answers, spare, from, to),
            λ (v: Valuation()) (k: Nat) (from: Now) => inner.Stops(spans, blocks, v, answers, goes, x, spare, k, from),
            λ v from to p => inner.holds_extends(spans, blocks, answers, grows, spare, v, from, to, p),
            λ v k from p => inner.stops_extends(spans, blocks, answers, grows, goes, x, going, spare, v, k, from, p),
            parameters, exit, next, x.ZeroAt(), λ now z => x.zero_extends(now, z), fuel, words_of(values, typed_ids(inputs)), before, h),
        Sys(_) => λ values fuel before never => false_elim(never),
        Exit(status) => λ values fuel before h => x.exits_extends(values(64, status), before, h),
    }
}

// ---------------------------------------------------------------------------
// The code of a run stopped short (docs/language/ownership-design.md §17.7)
//
// What a region's code proves of a run stopped at `x` (`Stop`): from the
// region's start, in its world, at the stop's ceiling (its world, the
// escape `esc`), the state the stop reads (`Stop::Reached`: going, any
// state in the stop's world; exited, at the exit call with the status, in
// its world) with at least `least` machine steps, counted where the fuel
// was spent (each turn's jump and each CALL; going asks the fuel's count,
// exited none). The meaning's exit is this goal, not an escape: it is read
// off the region's facts at a bound (zero), as a going stop is, while the
// escape is the machine's and owes no bound (§17.10).

fn Stop::ceiling<M>(self x: Stop, esc: Running<M, Io> → Type) → Ceiling<M> { Ceiling<M>(esc, x.world()) }

fn StopsHeap<M>(x: Stop, esc: Running<M, Io> → Type, saves: Nat, site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans,
    values: Valuation(), d: Nat, s0: MachineState<M>, prog: Prog, file: File, facts: Type, before: Now, least: Nat, out: Emitted) → Type {
    prog.Within(out.prog) ∧ (out.prog.Within(site.program) →
        site.Claims(stack.writes, site.ceiling(stack, x.ceiling(esc)), x.ceiling(esc).count(), least, prog_len(prog),
            NowPre<M>(saves, site, stack, spans, values, d, s0, file, facts, before), x.Reached(site, stack)))
}

fn MayStopHeap<M>(x: Stop, esc: Running<M, Io> → Type, saves: Nat, site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans,
    values: Valuation(), d: Nat, s0: MachineState<M>, prog: Prog, file: File, facts: Type, before: Now, least: Nat, out: Option<Emitted>) → Type {
    out.All(λ (emitted: Emitted) => StopsHeap<M>(x, esc, saves, site, stack, spans, values, d, s0, prog, file, facts, before, least, emitted))
}

// Every routine below `bound` stopped at `x`, on the runs `goes` says,
// entered at any offset `i`, performs the stop's state with at least
// `least` machine steps from its entry, or is spent as `spends` says.
fn CalleesStop<M>(x: Stop, site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, rooms: Nat → Nat, floored: Bool, top, bound: Nat, goes: RoutineStops(),
    least: Nat, spends: Nat → Nat → Running<M, Io> → Type) → Type {
    (f: Nat) → f + 1 <= bound → (args: List<Value>) → (heap: Heap) → (io: Io) → goes(f, args, heap, io) → (i: Nat) →
        site.EntersClaim(stack, site.ceiling(stack, x.ceiling(spends(f, i))), x.ceiling(spends(f, i)).count(), least, asm_labels(site.program)(f + 1),
            λ (k: Nat) (s: Running<M, Io>) => RoutinePreNow<M>(site, stack, spans, rooms, top, f, args, heap, io)(k, s) ∧
                ((k = i) ∧ stack.Floored(floored, s.state.gprs)),
            λ (_: Nat) (_: Running<M, Io>) (_: BitVec(64)) (t: Running<M, Io>) => x.Reached(site, stack)(t))
}

// Any count of a claim of the stop, read back to its ceiling.
theorem Site::claims_stop_exact<M>(self site: Site<M>, stack: Stack<M>(site.fetch, site.data), x: Stop, esc: Running<M, Io> → Type, calls, least,
    from: Nat, pre: Running<M, Io> → Type, before: Now, starts: (r: Running<M, Io>) → pre(r) → r.io = before.io,
    claims: site.Claims(stack.writes, site.ceiling(stack, x.ceiling(esc)), calls, least, from, pre, x.Reached(site, stack))):
    site.Claims(stack.writes, site.ceiling(stack, x.ceiling(esc)), x.ceiling(esc).count(), least, from, pre, x.Reached(site, stack)) {
    site.claims_ceiling(stack, x.ceiling(esc), calls, least, from, pre, x.Reached(site, stack),
        λ r held t reached => j(sym(x.reached_world(site, stack, t, reached)), λ w _ => w.past.len() <= x.world().past.len(),
            x.world().past.len().le_refl()), claims)
}

// The clause where a run may have left it: `Some` the heap injected,
// `None` nothing. The call sequence's claim at it, from `Some(before)` to
// `None`, cannot arrive past the call: so it is a claim of reaching the
// CALL.
fn now_left<M>(data: ByteReadAccess<M>, spans: Spans) → Option<Now> → M → Type {
    λ (o: Option<Now>) (memory: M) => match o { None => True, Some(now) => Injected<M>(data, spans, now.heap, memory) }
}

theorem now_left_stable<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, stack: Stack<M>(fetch, data), top: Nat, spans: Spans,
    loan: Loan<M>(fetch, data, stack, top, spans)): stack.ClauseStable(top, now_left<M>(data, spans)) {
    λ o => match o {
        None => λ memory k low word held => trivial,
        Some(now) => loan.stable_injected(top, top.le_refl(), now.heap),
    }
}

// The kernel that, at a CALL, hands the code to a callee whose run from
// there performs the stop at Linux with `calls` system calls and at least
// `least` machine steps: the call sequence's claim at it is a claim of the
// caller's code going on into the callee.
fn into_callee<M>(x: Stop, esc: Running<M, Io> → Type, site: Site<M>, stack: Stack<M>(site.fetch, site.data), calls, least: Nat) → Kernel<M, Io> {
    Kernel(λ (r: Running<M, Io>) (P: Running<M, Io> → Type) => site.Performs(stack.writes, site.ceiling(stack, x.ceiling(esc)), x.Reached(site, stack), calls, least, r),
        λ r P Q implies handed => handed)
}

// A call stopped: the call's code to its CALL, the CALL, counted, and
// the callee's run, stopped.
theorem call_heap_stops<M>(x: Stop, esc: Running<M, Io> → Type, saves, slots: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data),
    top: Nat, spans: Spans, loan: Loan<M>(site.fetch, site.data, stack, top, spans), rooms: Nat → Nat, bound, avail: Nat, goes: RoutineStops(), least: Nat,
    floored: Bool, spends: Nat → Nat → Running<M, Io> → Type, callees: CalleesStop<M>(x, site, stack, spans, rooms, floored, top, bound, goes, least, spends),
    blocks: Blocks, values: Valuation(), spare: Nat, d: Nat, s0: MachineState<M>, rsp0: read_gpr(Rsp, s0.gprs) = stack.at(d),
    floor: floored.IsTrue() → (gp: Gprs) → Kept(body_kept(saves), s0.gprs, gp) → read_gpr(Rbp, gp) = stack.low, room: avail <= d,
    fits: d + 8 * slots <= stack.size, under: (d + 8 * slots) + 8 <= top, prog: Prog, file: File, callee: Nat, arguments, results: List<Typed>,
    fit: rooms(callee) + 24 <= avail,
    carries: callee + 1 <= bound → (count: Nat) → count <= 2 → (t: Running<M, Io>) → spends(callee, (d - 8 * count) - 8)(t) → esc(t),
    placement: List<Place>, names: Nat, before: Now):
    MayStopHeap<M>(x, esc, saves, site, stack, spans, values, d + 8 * slots, s0, prog, file,
        Exists<List<Value>>(λ args => (lower_values(spans, args) = words_of(values, typed_ids(arguments))) ∧ goes(callee, args, before.heap, before.io)),
        before, 1 + least,
        file.emit_call(slots, prog, callee, typed_ids(arguments), call_result(results, spare), call_also(results), placement, names, bound, [], [])) {
    let Facts: Type = Exists<List<Value>>(λ (args: List<Value>) => (lower_values(spans, args) = words_of(values, typed_ids(arguments))) ∧
        goes(callee, args, before.heap, before.io));
    let mem = now_left<M>(site.data, spans);
    let World = λ (o: Option<Now>) (w: Io) => (o = Some(before)) ∧ NowWorld()(before, w);
    let count = x.ceiling(esc).count();
    let kernel = into_callee<M>(x, esc, site, stack, count, 1 + least);
    let linux = site.ceiling(stack, x.ceiling(esc));
    let deep: (24 <= d) = { omega };
    let chain = file.emit_call_steps_claim_kept<M, Option<Now>, Io>(saves, slots, site, laid, stack, top, bound, spans, mem, World, kernel, 1, 0,
        now_left_stable<M>(stack, top, spans, loan), values, d, s0, rsp0, fits, under, deep, prog, callee, typed_ids(arguments),
        call_result(results, spare), call_also(results), placement, names, [], [], Facts, Some(before), None,
        λ eight slotted below lends count2 few moved facts g0 rep rsp kept k at u0 here resident held => {
            let i = (d - 8 * count2) - 8;
            let low: (rooms(callee) <= i) = { omega };
            let high: (i + 8 <= top) = { omega };
            let room8: (i + 8 <= stack.size) = { omega };
            let displacement = asm_jump_of(asm_labels(site.program), prog_len(moved), CallTo(callee + 1));
            let handed = site.claims_call_by(stack, linux, site.program.laid_out_fits(laid), k, moved, 0, callee + 1, at, asm_labels(site.program)(callee + 1),
                call_lands(asm_labels(site.program), k, site.program, moved, 0, callee + 1, site.program.laid_out_lands(laid), at), count, least,
                λ (n: Nat) (s: Running<M, Io>) => RoutinePreNow<M>(site, stack, spans, rooms, top, callee, facts.witness, before.heap, before.io)(n, s) ∧
                    ((n = i) ∧ stack.Floored(floored, s.state.gprs)),
                λ (_: Nat) (_: Running<M, Io>) (_: BitVec(64)) (t: Running<M, Io>) => x.Reached(site, stack)(t),
                site.enters_claim_kernel<M, Io>(stack, site.ceiling(stack, x.ceiling(spends(callee, i))), linux,
                    site.ceiling_within(stack, x.ceiling(esc), x.ceiling(spends(callee, i)), carries(below, count2, few), extends_refl(x.world().past)),
                    count, least, asm_labels(site.program)(callee + 1),
                    λ (n: Nat) (s: Running<M, Io>) => RoutinePreNow<M>(site, stack, spans, rooms, top, callee, facts.witness, before.heap, before.io)(n, s) ∧
                        ((n = i) ∧ stack.Floored(floored, s.state.gprs)),
                    λ (_: Nat) (_: Running<M, Io>) (_: BitVec(64)) (t: Running<M, Io>) => x.Reached(site, stack)(t),
                    callees(callee, below, facts.witness, before.heap, before.io, facts.proof.right, i)),
                λ (y: Running<M, Io>) => stack.ArgsReadyBy(call_saves(placement), spans, mem, d, slots, s0, Some(before), g0, count2,
                    words_of(values, typed_ids(arguments)), y.state) ∧ World(Some(before), y.io),
                x.Reached(site, stack), λ _ => i,
                λ y ready => {
                    let pushed = call_pushes<M, Option<Now>>(call_saves(placement), slots, eight, slotted, site, stack, top, spans, mem,
                        now_left_stable<M>(stack, top, spans, loan), d, s0, fits, under, deep, count2, few, words_of(values, typed_ids(arguments)), Some(before),
                        g0, displacement, y.state, ready.left);
                    ⟨pushed.left, ⟨room8, ⟨⟨⟨⟨j(sym(facts.proof.left), λ ws _ => stack.Passed(ws, i, call_near_after(stack.writes, displacement, y.state)),
                        pushed.right.right.right), low⟩, ⟨high, pushed.right.right.left.right⟩⟩, ready.right.right⟩,
                        ⟨refl, λ fl => trans(kept_callee_rbp(g0, call_near_after(stack.writes, displacement, y.state).gprs,
                            kept_trans(callee_kept(), g0, y.state.gprs, call_near_after(stack.writes, displacement, y.state).gprs, ready.left.right.right.left,
                                kept_past_rsp(y.state.gprs, push_address(y.state.gprs)))), floor(fl, g0, kept))⟩⟩⟩⟩
                },
                λ y t _ _ reached => reached)(Running<M, Io>(u0.state, u0.io), here, resident, held);
            Exists(u0.state, Exists(0, ⟨refl, Inr(handed)⟩))
        });
    (match file.emit_call(slots, prog, callee, typed_ids(arguments), call_result(results, spare), call_also(results), placement, names, bound, [], []) as λ o =>
        MayEmitClaim<M, Option<Now>, Io>(saves, site, stack, spans, mem, World, kernel, 1, 0, values, d + 8 * slots, s0, prog, file, Facts, Some(before), None, o) →
        MayStopHeap<M>(x, esc, saves, site, stack, spans, values, d + 8 * slots, s0, prog, file, Facts, before, 1 + least, o) {
        None => λ _ => trivial,
        Some(out) => λ emits => ⟨emits.left, λ within r here resident held => {
            let p = emits.right(within)(r, here, resident, ⟨held.left, ⟨refl, held.right⟩⟩);
            match p.proof.proof.right {
                Inl(reach) => match reach {
                    Inl(arrived) => {
                        let never: (None<Now> = Some(before)) = arrived.right.right.right.left;
                        absurd(never)
                    },
                    Inr(never) => false_elim(never),
                },
                Inr(handed) => site.performs_after(stack.writes, linux, x.Reached(site, stack), count, 1 + least, r, p.witness,
                    Exists(p.proof.witness, p.proof.proof.left), handed),
            }
        }⟩,
    })(chain)
}

// A guarded call stopped: the guard, spent where the room is short (the
// stop's world the call's, which the stopped callee's extends, `going`),
// and otherwise `call_heap_stops` at the room the guard found.
theorem guarded_call_stops<M>(x: Stop, esc: Running<M, Io> → Type, saves, slots: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(),
    stack: Stack<M>(site.fetch, site.data), top: Nat, spans: Spans, loan: Loan<M>(site.fetch, site.data, stack, top, spans), rooms: Nat → Nat,
    bound: Nat, goes: RoutineStops(), going: GoesExtend(x, goes), least: Nat, floored: Bool, spends: Nat → Nat → Running<M, Io> → Type,
    callees: CalleesStop<M>(x, site, stack, spans, rooms, floored, top, bound, goes, least, spends), blocks: Blocks, values: Valuation(), spare: Nat, d: Nat,
    s0: MachineState<M>, rsp0: read_gpr(Rsp, s0.gprs) = stack.at(d), floor: (g: Gprs) → Kept(body_kept(saves), s0.gprs, g) → read_gpr(Rbp, g) = stack.low,
    fits: d + 8 * slots <= stack.size, under: (d + 8 * slots) + 8 <= top, prog: Prog, file: File, callee: Nat, arguments, results: List<Typed>,
    stop_name: Nat, stop_prog: Prog, stop_in: stop_prog.stopped_at(stop_name + 1).Within(site.program), most: 24 + rooms(callee) <= guard_most(),
    before: Now,
    spent: callee + 1 <= bound → (args: List<Value>) → goes(callee, args, before.heap, before.io) → d < 24 + rooms(callee) → (t: Running<M, Io>) →
        site.SpentExit(stack)(t) → esc(t),
    carries: callee + 1 <= bound → (count: Nat) → count <= 2 → (t: Running<M, Io>) → spends(callee, (d - 8 * count) - 8)(t) → esc(t),
    placement: List<Place>, names: Nat):
    MayStopHeap<M>(x, esc, saves, site, stack, spans, values, d + 8 * slots, s0, prog, file,
        Exists<List<Value>>(λ args => (lower_values(spans, args) = words_of(values, typed_ids(arguments))) ∧ goes(callee, args, before.heap, before.io)),
        before, 1 + least,
        file.emit_call(slots, prog.guarded(24 + rooms(callee), stop_name + 1), callee, typed_ids(arguments), call_result(results, spare),
            call_also(results), placement, names, bound, [], [])) {
    let need = 24 + rooms(callee);
    let stop = stop_name + 1;
    let guarded = prog.guarded(need, stop);
    let program = site.program;
    let mem = now_in<M>(site.data, spans);
    let c = x.ceiling(esc);
    let kernel = site.ceiling(stack, c);
    let linux = site.linux_kernel(stack);
    let w = d + 8 * slots;
    let facts: Type = Exists<List<Value>>(λ (args: List<Value>) => (lower_values(spans, args) = words_of(values, typed_ids(arguments))) ∧
        goes(callee, args, before.heap, before.io));
    let pre_g = λ (g: Gprs) (m: M) (io: Io) => ((file.Represents(values, g) ∧ facts) ∧ (Kept(body_kept(saves), s0.gprs, g) ∧
        stack.TrailBy(spans, mem, w, s0.memory, before, m))) ∧ NowWorld()(before, io);
    let pre = NowPre<M>(saves, site, stack, spans, values, w, s0, file, facts, before);
    let into_guarded: prog.Within(guarded) = Exists(4, refl);
    let lower_prog = At(prog, 0, Block([guard_lower()]));
    let tested_prog = lower_prog.tested(guard_test(need));
    let branched_prog = lower_prog.branched_by(guard_test(need), stop, False);
    let block_prog = At(stop_prog, stop, Block(stop_code()));
    let call_out = file.emit_call(slots, guarded, callee, typed_ids(arguments), call_result(results, spare), call_also(results), placement, names, bound,
        [], []);
    let guard = λ (below: callee + 1 <= bound) (within: guarded.Within(program)) => {
        let fits_prog = program.laid_out_fits(laid);
        let unique = program.laid_out_unique(laid);
        let lands = program.laid_out_lands(laid);
        let branched_in = branched_prog.within_before(0, Block([guard_raise()]), program, within);
        let tested_in = tested_prog.within_before(0, jcc_item(False, B, stop), program, branched_in);
        let lower_in = lower_prog.within_before(0, Block([guard_test(need).instruction()]), program, tested_in);
        let block_in = block_prog.within_before(0, Syscall, program, stop_in);
        let stop_lands = j(label_target(block_in.witness, program, stop_prog, stop_name, Block(stop_code()), unique, block_in.proof),
            λ to _ => JccLands(asm_labels(program), prog_len(tested_prog), False, B, stop, to),
            jcc_item_lands(asm_labels(program), branched_in.witness, program, tested_prog, 0, False, B, stop, lands, branched_in.proof));
        site.claims_escaping(stack.writes, linux, 0, 0, prog_len(prog), pre, site.Arrived(prog_len(guarded), λ (t: Running<M, Io>) =>
                pre_g(t.state.gprs, t.state.memory, t.io) ∧ (need <= d)), c.Esc(),
            site.guard_claims(stack.writes, linux, fits_prog, stack, prog, need, stop, lower_in.witness, lower_in.proof, tested_in.witness, tested_in.proof,
                branched_in.witness, branched_in.proof, within.witness, within.proof, block_in.witness, stop_prog, block_in.proof, stop_lands, d,
                { let room = loan.room; omega }, most, pre_g, c.Esc(),
                λ g m io held => ⟨trans(held.left.right.left.left, rsp0), floor(g, held.left.right.left)⟩,
                λ r t held same_memory same_io short stopped => {
                    let called = held.left.left.right;
                    let world: (r.io = before.io) = held.right.left;
                    let at_world: Extends(x.world().past, t.io.past) = j(sym(trans(same_io, world)), λ y _ => Extends(x.world().past, y.past),
                        going(callee, called.witness, before.heap, before.io, called.proof.right));
                    let exit: site.SpentExit(stack)(t) = ⟨site.item_fetched(fits_prog, t.state, stopped.left.right, stop_in.witness, block_prog, 0, Syscall,
                        stop_in.proof, stopped.left.left), ⟨stopped.right.right, stopped.right.left⟩⟩;
                    ⟨spent(below, called.witness, called.proof.right, short, t, exit), at_world⟩
                }))
    };
    match d.lt_or_ge(need) {
        Inl(short) => (match call_out as λ o => call_out = o → Grows(guarded, o) →
            MayStopHeap<M>(x, esc, saves, site, stack, spans, values, w, s0, prog, file, facts, before, 1 + least, o) {
            None => λ _ _ => trivial,
            Some(out) => λ emitted grown => {
                let G = site.Arrived(prog_len(guarded), λ (t: Running<M, Io>) => pre_g(t.state.gprs, t.state.memory, t.io) ∧ (need <= d));
                let never: (t: Running<M, Io>) → G(t) → False = λ t arrived => { let fit = arrived.right.right; let bad: (d < d) = { omega }; Nat::lt_irrefl(d, bad) };
                ⟨Prog::within_trans(into_guarded, grown), λ within => site.claims_stop_exact(stack, x, esc, 1, 1 + least, prog_len(prog), pre, before,
                    λ r held => held.right.left, λ r here resident held => site.performs_weaken(stack.writes, kernel, G, x.Reached(site, stack),
                        λ t arrived => false_elim(never(t, arrived)), 1, 1 + least, r,
                        site.performs_never(stack.writes, kernel, G, never, 1, 0, 1 + least, r, guard(emit_call_below(file, slots, guarded, callee, typed_ids(arguments), call_result(results, spare), call_also(results), placement, names, bound, [], [], out, emitted),
                            Prog::within_trans(grown, within))(r, here, resident, held))))⟩
            },
        })(refl, file.emit_call_grows(slots, guarded, callee, typed_ids(arguments), call_result(results, spare), call_also(results), placement, names, bound,
            [], [])),
        Inr(roomy) => (match call_out as λ o => call_out = o →
            MayStopHeap<M>(x, esc, saves, site, stack, spans, values, w, s0, guarded, file, facts, before, 1 + least, o) →
            MayStopHeap<M>(x, esc, saves, site, stack, spans, values, w, s0, prog, file, facts, before, 1 + least, o) {
            None => λ _ _ => trivial,
            Some(out) => λ emitted goes_on => ⟨Prog::within_trans(into_guarded, goes_on.left), λ within => site.claims_stop_exact(stack, x, esc,
                (c.count() + 1) + 0, 1 + least, prog_len(prog), pre, before, λ r held => held.right.left,
                site.claims_loosen(stack.writes, kernel, c.count() + 1, 0 + (1 + least), 0, 1 + least, prog_len(prog), pre, x.Reached(site, stack), { omega },
                site.claims_trans(stack.writes, kernel, 1, 0, c.count(), 1 + least, prog_len(prog), prog_len(guarded), pre, pre, x.Reached(site, stack),
                    site.claims_weaken(stack.writes, kernel, 1, 0, prog_len(prog), pre, site.Arrived(prog_len(guarded), λ (t: Running<M, Io>) =>
                            pre_g(t.state.gprs, t.state.memory, t.io) ∧ (need <= d)), pre, site.Arrived(prog_len(guarded), pre),
                        guard(emit_call_below(file, slots, guarded, callee, typed_ids(arguments), call_result(results, spare), call_also(results), placement, names, bound, [], [], out, emitted), Prog::within_trans(goes_on.left, within)), λ r h => h,
                        λ t arrived => ⟨arrived.left, arrived.right.left⟩),
                    goes_on.right(within))))⟩,
        })(refl, call_heap_stops<M>(x, esc, saves, slots, site, laid, stack, top, spans, loan, rooms, bound, d, goes, least, floored, spends, callees, blocks, values,
            spare, d, s0, rsp0, λ _ => floor, d.le_refl(), fits, under, guarded, file, callee, arguments, results, { omega }, carries, placement, names, before)),
    }
}

// A branch stopped: the test, then the arm its bit picks, stopped.
theorem branch_heap_stops<M>(x: Stop, esc: Running<M, Io> → Type, saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data),
    spans: Spans, values: Valuation(), d: Nat, s0: MachineState<M>, prog: Prog, file: File, condition: Nat, Yes, No: Type, before: Now, least: Nat,
    tested: Tested(file, condition), names: Nat, short: List<Nat>, left, right: Emitted,
    yes_goes: StopsHeap<M>(x, esc, saves, site, stack, spans, values, d, s0, prog.branched_by(tested.test, names + 1, shorts(short, names + 1)),
        file.know(Truth(condition)), Yes, before, least, left),
    no_goes: StopsHeap<M>(x, esc, saves, site, stack, spans, values, d, s0, left.prog.else_label_by(names + 1, names + 2, shorts(short, names + 2)),
        file.know(Falsity(condition)), No, before, least, right),
    left_within: prog.branched_by(tested.test, names + 1, shorts(short, names + 1)).Within(left.prog),
    right_within: left.prog.else_label_by(names + 1, names + 2, shorts(short, names + 2)).Within(right.prog)):
    StopsHeap<M>(x, esc, saves, site, stack, spans, values, d, s0, prog, file, match values(1, condition).head_bit() { True => Yes, False => No }, before, least,
        Emitted(right.prog.join_label(names + 2), left.file.meet(right.file, file.known), right.placement, right.names)) {
    let test = tested.test;
    let else_name = names + 1;
    let join_name = names + 2;
    let short_jcc = shorts(short, else_name);
    let short_jmp = shorts(short, join_name);
    let branched = prog.branched_by(test, else_name, short_jcc);
    let jumped = At(left.prog, 0, jmp_item(short_jmp, join_name));
    let second = left.prog.else_label_by(else_name, join_name, short_jmp);
    let to_branch = prog.within_step(prog.tested(test), 0, jcc_item(short_jcc, test.cc(), else_name),
        prog.within_then(0, Block([test.instruction()])));
    let to_second = prog.within_step(jumped, else_name, Block([]),
        prog.within_step(left.prog, 0, jmp_item(short_jmp, join_name), Prog::within_trans(to_branch, left_within)));
    let picked = λ (b: Bool) => match b { True => Yes, False => No };
    let pre = λ (g: Gprs) (m: M) (w: Io) => ((file.Represents(values, g) ∧ picked(values(1, condition).head_bit())) ∧
        (Kept(body_kept(saves), s0.gprs, g) ∧ stack.TrailBy(spans, now_in<M>(site.data, spans), d, s0.memory, before, m))) ∧ NowWorld()(before, w);
    ⟨prog.within_step(right.prog, join_name, Block([]), Prog::within_trans(to_second, right_within)),
     λ within => {
        let program = site.program;
        let labels = asm_labels(program);
        let unique = program.laid_out_unique(laid);
        let lands = program.laid_out_lands(laid);
        let no_in = right.prog.within_before(join_name, Block([]), program, within);
        let second_in = Prog::within_trans(right_within, no_in);
        let jumped_in = jumped.within_before(else_name, Block([]), program, second_in);
        let yes_in = left.prog.within_before(0, jmp_item(short_jmp, join_name), program, jumped_in);
        let branched_in = Prog::within_trans(left_within, yes_in);
        let tested_in = prog.tested(test).within_before(0, jcc_item(short_jcc, test.cc(), else_name), program, branched_in);
        let else_lands = j(label_target(second_in.witness, program, jumped, names, Block([]), unique, second_in.proof),
            λ to _ => JccLands(labels, prog_len(prog.tested(test)), short_jcc, test.cc(), else_name, to),
            jcc_item_lands(labels, branched_in.witness, program, prog.tested(test), 0, short_jcc, test.cc(), else_name, lands, branched_in.proof));
        let selects = tested.selects(values);
        site.claims_test_by(stack.writes, site.ceiling(stack, x.ceiling(esc)), program.laid_out_fits(laid), prog, test, else_name, short_jcc, tested_in.witness,
            tested_in.proof, branched_in.witness, branched_in.proof, prog_len(left.prog) + asm_len(jmp_item(short_jmp, join_name)), else_lands, x.ceiling(esc).count(), least,
            pre, x.Reached(site, stack),
            site.claims_weaken(stack.writes, site.ceiling(stack, x.ceiling(esc)), x.ceiling(esc).count(), least, prog_len(branched),
                λ (r: Running<M, Io>) => ((file.know(Truth(condition)).Represents(values, r.state.gprs) ∧ Yes) ∧
                    stack.TrailedBy(saves, spans, now_in<M>(site.data, spans), d, s0, before, r.state)) ∧ NowWorld()(before, r.io),
                x.Reached(site, stack),
                λ (r: Running<M, Io>) => pre(r.state.gprs, r.state.memory, r.io) ∧ test.taken(r.state.gprs) = False,
                x.Reached(site, stack),
                yes_goes.right(yes_in),
                λ r held => {
                    let clear: (!values(1, condition).head_bit() = False) = trans(sym(selects(r.state.gprs, held.left.left.left.left)), held.right);
                    let bit = function_ir_lower_calls::not_false(values(1, condition).head_bit(), clear);
                    ⟨⟨⟨file.represents_know(values, r.state.gprs, Truth(condition), held.left.left.left.left, bit),
                        j(bit, λ b _ => picked(b), held.left.left.left.right)⟩, held.left.left.right⟩, held.left.right⟩
                },
                λ t done => done),
            site.claims_weaken(stack.writes, site.ceiling(stack, x.ceiling(esc)), x.ceiling(esc).count(), least, prog_len(second),
                λ (r: Running<M, Io>) => ((file.know(Falsity(condition)).Represents(values, r.state.gprs) ∧ No) ∧
                    stack.TrailedBy(saves, spans, now_in<M>(site.data, spans), d, s0, before, r.state)) ∧ NowWorld()(before, r.io),
                x.Reached(site, stack),
                λ (r: Running<M, Io>) => pre(r.state.gprs, r.state.memory, r.io) ∧ test.taken(r.state.gprs) = True,
                x.Reached(site, stack),
                no_goes.right(no_in),
                λ r held => {
                    let set: (!values(1, condition).head_bit() = True) = trans(sym(selects(r.state.gprs, held.left.left.left.left)), held.right);
                    let bit = function_ir_lower_calls::not_true(values(1, condition).head_bit(), set);
                    ⟨⟨⟨file.represents_know(values, r.state.gprs, Falsity(condition), held.left.left.left.left, bit),
                        j(bit, λ b _ => picked(b), held.left.left.left.right)⟩, held.left.left.right⟩, held.left.right⟩
                },
                λ t done => done))
     }⟩
}

// The head's claim at a loop stopped, from the state `state` over
// `now`: at least `least` machine steps.
fn PlainStops<M>(x: Stop, esc: Running<M, Io> → Type, saves: Nat, site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, w: Nat, s0: MachineState<M>, registers: List<Gpr>,
    h_at, least: Nat, state: List<BitVec(64)>, now: Now) → Type {
    site.Claims(stack.writes, site.ceiling(stack, x.ceiling(esc)), x.ceiling(esc).count(), least, h_at, PlainAtNow<M>(saves, site, stack, spans, w, s0, registers, state, now),
        x.Reached(site, stack))
}

// One pass from the head, stopped: the pass itself, or done, the turn
// round, and what follows from the head (`later`, at least `least`).
theorem plain_pass_stops<M>(x: Stop, esc: Running<M, Io> → Type, saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), spans: Spans,
    Pass: Valuation() → Now → Now → Type, PassStops: Valuation() → Nat → Now → Type, w: Nat, s0: MachineState<M>, prog: Prog, code: List<Instruction>,
    head: File, registers: List<Gpr>, parameters: List<Typed>, exit: Nat, next: List<Typed>, names: Nat, short: List<Nat>, pass: Emitted, test: Test,
    moves: List<Instruction>, labels: PlainLabels<M>(site, prog, code, pass.prog, test, moves, names, short),
    head_ok: (v: Valuation()) → (g: Gprs) → ArgsIn(words_of(v, typed_ids(parameters)), registers, g) → head.Represents(v, g),
    pass_emits: (v: Valuation()) → (from, to: Now) →
        EmitsNow<M>(saves, site, stack, spans, x.ceiling(esc), v, w, s0, plain_head(prog, code, names), head, Pass(v, from, to), from, to, pass),
    cap: Nat, pass_stops: (v: Valuation()) → (k: Nat) → k <= cap → (from: Now) →
        StopsHeap<M>(x, esc, saves, site, stack, spans, v, w, s0, plain_head(prog, code, names), head, PassStops(v, k, from), from, x.least(k), pass),
    grows: (v: Valuation()) → (from, to: Now) → Pass(v, from, to) → Extends(to.io.past, from.io.past),
    stops_ext: (v: Valuation()) → (k: Nat) → (from: Now) → PassStops(v, k, from) → Extends(x.world().past, from.io.past),
    pass_in: pass.prog.Within(site.program),
    next_file: File, moved: (v: Valuation()) → (s: MachineState<M>) → pass.file.Represents(v, s.gprs) →
        next_file.Represents(v, execute_block_normal(moves, s).gprs),
    selects: (v: Valuation()) → (g: Gprs) → next_file.Represents(v, g) → test.taken(g) = !v(1, exit).head_bit(),
    into: (v: Valuation()) → MovesInto<M>(saves, v, pass.file, typed_ids(next), registers, moves),
    fuel: Nat, Later: List<BitVec(64)> → Now → Type, least: Nat,
    later: (st: List<BitVec(64)>) → (at: Now) → Later(st, at) →
        PlainStops<M>(x, esc, saves, site, stack, spans, w, s0, registers, prog_len(At(prog, 0, Block(code))), least, st, at),
    enough: x.least(fuel) <= 1 + least, capped: fuel <= cap, state: List<BitVec(64)>, now: Now, ran: PassStop(Pass, PassStops, parameters, exit, next, fuel, Later, state, now),
    later_ext: (st: List<BitVec(64)>) → (at: Now) → Later(st, at) → Extends(x.world().past, at.io.past)):
    PlainStops<M>(x, esc, saves, site, stack, spans, w, s0, registers, prog_len(At(prog, 0, Block(code))), x.least(fuel), state, now) {
    let h_at = prog_len(At(prog, 0, Block(code)));
    let linux = site.ceiling(stack, x.ceiling(esc));
    let v = ran.witness;
    let eq: (words_of(v, typed_ids(parameters)) = state) = ran.proof.left;
    match ran.proof.right {
        Inl(going) => λ r here resident held => pass_stops(v, fuel, capped, now).right(pass_in)(r, here, resident,
            ⟨⟨⟨head_ok(v, r.state.gprs, j(sym(eq), λ ws _ => ArgsIn(ws, registers, r.state.gprs), held.left.left)), going⟩, held.left.right⟩, held.right⟩),
        Inr(done) => {
            let mid = done.witness;
            let mem = now_in<M>(site.data, spans);
            let keep_mid = λ (m: M) => stack.TrailBy(spans, mem, w, s0.memory, mid, m);
            let passed_at = λ (t: Running<M, Io>) => stack.LoopPassed(saves, keep_mid, s0, pass.file, v)(t.state.gprs, t.state.memory) ∧ NowWorld()(mid, t.io);
            let ran_body = loop_body_runs_claim<M, Now, Io>(saves, site, stack, spans, mem, NowWorld(), linux, x.ceiling(esc).count(), 0,
                λ (v2: Valuation()) (from2: Now) (to2: Now) => Pass(v2, from2, to2) ∧ x.ceiling(esc).Under(to2), w, s0,
                plain_head(prog, code, names), head, registers, typed_ids(parameters), head_ok, v, now, mid, pass, pass_emits(v, now, mid), pass_in,
                ⟨done.proof.left, later_ext(words_of(v, typed_ids(next)), mid, done.proof.right.right)⟩);
            let start = j(eq, λ ws _ => site.Claims(stack.writes, linux, x.ceiling(esc).count(), 0, h_at,
                PlainAtNow<M>(saves, site, stack, spans, w, s0, registers, ws, now), site.Arrived(prog_len(pass.prog), passed_at)), ran_body);
            let turn = plain_turns_claim<M, Io>(saves, site, laid, stack, linux, λ (io: Io) => NowWorld()(mid, io), keep_mid, s0, pass.prog, pass.file, next_file,
                test, exit, moves, typed_ids(next), registers, names, short, labels.again_in, h_at, labels.h_lands, v, moved(v), selects(v), into(v),
                done.proof.right.left);
            let onward = site.claims_trans(stack.writes, linux, 0, 1, x.ceiling(esc).count(), least, prog_len(pass.prog), h_at, passed_at,
                PlainAtNow<M>(saves, site, stack, spans, w, s0, registers, words_of(v, typed_ids(next)), mid),
                x.Reached(site, stack), turn, later(words_of(v, typed_ids(next)), mid, done.proof.right.right));
            let whole = site.claims_trans(stack.writes, linux, x.ceiling(esc).count(), 0, x.ceiling(esc).count() + 0, 1 + least, h_at, prog_len(pass.prog),
                PlainAtNow<M>(saves, site, stack, spans, w, s0, registers, state, now), passed_at, x.Reached(site, stack), start, onward);
            site.claims_stop_exact(stack, x, esc, (x.ceiling(esc).count() + 0) + x.ceiling(esc).count(), x.least(fuel), h_at,
                PlainAtNow<M>(saves, site, stack, spans, w, s0, registers, state, now), now, λ r held => held.right.left,
                site.claims_loosen(stack.writes, linux, (x.ceiling(esc).count() + 0) + x.ceiling(esc).count(), 0 + (1 + least), 0, x.least(fuel), h_at,
                    PlainAtNow<M>(saves, site, stack, spans, w, s0, registers, state, now), x.Reached(site, stack), { let e = enough; omega }, whole))
        },
    }
}

// The passes from the head, stopped at `fuel`: at least `fuel`
// machine steps, by induction on it.
theorem plain_passes_stops<M>(x: Stop, esc: Running<M, Io> → Type, saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), spans: Spans,
    Pass: Valuation() → Now → Now → Type, PassStops: Valuation() → Nat → Now → Type, w: Nat, s0: MachineState<M>, prog: Prog, code: List<Instruction>,
    head: File, registers: List<Gpr>, parameters: List<Typed>, exit: Nat, next: List<Typed>, names: Nat, short: List<Nat>, pass: Emitted, test: Test,
    moves: List<Instruction>, labels: PlainLabels<M>(site, prog, code, pass.prog, test, moves, names, short),
    head_ok: (v: Valuation()) → (g: Gprs) → ArgsIn(words_of(v, typed_ids(parameters)), registers, g) → head.Represents(v, g),
    pass_emits: (v: Valuation()) → (from, to: Now) →
        EmitsNow<M>(saves, site, stack, spans, x.ceiling(esc), v, w, s0, plain_head(prog, code, names), head, Pass(v, from, to), from, to, pass),
    cap: Nat, pass_stops: (v: Valuation()) → (k: Nat) → k <= cap → (from: Now) →
        StopsHeap<M>(x, esc, saves, site, stack, spans, v, w, s0, plain_head(prog, code, names), head, PassStops(v, k, from), from, x.least(k), pass),
    grows: (v: Valuation()) → (from, to: Now) → Pass(v, from, to) → Extends(to.io.past, from.io.past),
    stops_ext: (v: Valuation()) → (k: Nat) → (from: Now) → PassStops(v, k, from) → Extends(x.world().past, from.io.past),
    pass_in: pass.prog.Within(site.program),
    next_file: File, moved: (v: Valuation()) → (s: MachineState<M>) → pass.file.Represents(v, s.gprs) →
        next_file.Represents(v, execute_block_normal(moves, s).gprs),
    selects: (v: Valuation()) → (g: Gprs) → next_file.Represents(v, g) → test.taken(g) = !v(1, exit).head_bit(),
    into: (v: Valuation()) → MovesInto<M>(saves, v, pass.file, typed_ids(next), registers, moves), fuel: Nat):
    fuel <= cap → (state: List<BitVec(64)>) → (now: Now) → PassesStop(Pass, PassStops, parameters, exit, next, x.ZeroAt(), fuel, state, now) →
    PlainStops<M>(x, esc, saves, site, stack, spans, w, s0, registers, prog_len(At(prog, 0, Block(code))), x.least(fuel), state, now) {
    match fuel {
        Zero => λ capped state now ran => plain_pass_stops<M>(x, esc, saves, site, laid, stack, spans, Pass, PassStops, w, s0, prog, code, head, registers, parameters, exit,
            next, names, short, pass, test, moves, labels, head_ok, pass_emits, cap, pass_stops, grows, stops_ext, pass_in, next_file, moved, selects, into, 0,
            LaterStop(Pass, PassStops, parameters, exit, next, x.ZeroAt(), 0), 0,
            λ st at zero => site.claims_stop_exact(stack, x, esc, 0, 0, prog_len(At(prog, 0, Block(code))),
                PlainAtNow<M>(saves, site, stack, spans, w, s0, registers, st, at), at, λ r held => held.right.left,
                λ r here resident held => Exists(r.state, Exists(0, ⟨refl, Inl(⟨trivial,
                    x.reached_zero(site, stack, Running<M, Io>(r.state, r.io), j(sym(held.right.left), λ io _ => x.Zero(io), zero))⟩)⟩))),
            { let low = x.least_le(0); omega }, capped, state, now, ran, λ st at z => x.zero_extends(at, z)),
        Succ(rest) => λ capped state now ran => plain_pass_stops<M>(x, esc, saves, site, laid, stack, spans, Pass, PassStops, w, s0, prog, code, head, registers, parameters,
            exit, next, names, short, pass, test, moves, labels, head_ok, pass_emits, cap, pass_stops, grows, stops_ext, pass_in, next_file, moved, selects, into, Succ(rest),
            LaterStop(Pass, PassStops, parameters, exit, next, x.ZeroAt(), Succ(rest)), x.least(rest),
            plain_passes_stops<M>(x, esc, saves, site, laid, stack, spans, Pass, PassStops, w, s0, prog, code, head, registers, parameters, exit, next, names, short,
                pass, test, moves, labels, head_ok, pass_emits, cap, pass_stops, grows, stops_ext, pass_in, next_file, moved, selects, into, rest, { omega }), x.least_succ(rest), capped, state, now, ran,
            λ st at h => pass_stop_extends(x, Pass, PassStops, grows, stops_ext, parameters, exit, next, x.ZeroAt(), λ now2 z => x.zero_extends(now2, z), rest,
                st, at, h)),
    }
}

// A plain loop stopped: the entry's moves, then the passes from the
// head, at least the loop's fuel.
theorem plain_loop_stops<M>(x: Stop, esc: Running<M, Io> → Type, saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), spans: Spans,
    Pass: Valuation() → Now → Now → Type, PassStops: Valuation() → Nat → Now → Type, values: Valuation(), w: Nat, s0: MachineState<M>, prog: Prog,
    file: File, inputs, parameters: List<Typed>, exit: Nat, next: List<Typed>, names: Nat, short: List<Nat>, registers: List<Gpr>, entry: PlainEntry,
    entered: MovesInto<M>(saves, values, file, typed_ids(inputs), registers, entry.code),
    head_ok: (v: Valuation()) → (g: Gprs) → ArgsIn(words_of(v, typed_ids(parameters)), registers, g) → entry.head.Represents(v, g),
    pass: Emitted,
    pass_emits: (v: Valuation()) → (from, to: Now) →
        EmitsNow<M>(saves, site, stack, spans, x.ceiling(esc), v, w, s0, plain_head(prog, entry.code, names), entry.head, Pass(v, from, to), from, to, pass),
    cap: Nat, pass_stops: (v: Valuation()) → (k: Nat) → k <= cap → (from: Now) →
        StopsHeap<M>(x, esc, saves, site, stack, spans, v, w, s0, plain_head(prog, entry.code, names), entry.head, PassStops(v, k, from), from, x.least(k), pass),
    grows: (v: Valuation()) → (from, to: Now) → Pass(v, from, to) → Extends(to.io.past, from.io.past),
    stops_ext: (v: Valuation()) → (k: Nat) → (from: Now) → PassStops(v, k, from) → Extends(x.world().past, from.io.past),
    moves: List<Instruction>, next_file: File,
    moved: (v: Valuation()) → (s: MachineState<M>) → pass.file.Represents(v, s.gprs) → next_file.Represents(v, execute_block_normal(moves, s).gprs),
    tested: Tested(next_file, exit), into: (v: Valuation()) → MovesInto<M>(saves, v, pass.file, typed_ids(next), registers, moves),
    out: File, before: Now, fuel: Nat, capped: fuel <= cap):
    StopsHeap<M>(x, esc, saves, site, stack, spans, values, w, s0, prog, file,
        PassesStop(Pass, PassStops, parameters, exit, next, x.ZeroAt(), fuel, words_of(values, typed_ids(inputs)), before), before, x.least(fuel),
        Emitted(plain_done(pass.prog, tested.test, moves, names, short), out, pass.placement, pass.names)) {
    let program = site.program;
    let code = entry.code;
    let test = tested.test;
    let head_pass: plain_head(prog, code, names).Within(pass.prog) = (pass_emits(values, before, before)).left;
    let facts: Type = PassesStop(Pass, PassStops, parameters, exit, next, x.ZeroAt(), fuel, words_of(values, typed_ids(inputs)), before);
    let pre = λ (g: Gprs) (m: M) => (file.Represents(values, g) ∧ facts) ∧
        (Kept(body_kept(saves), s0.gprs, g) ∧ stack.TrailBy(spans, now_in<M>(site.data, spans), w, s0.memory, before, m));
    let into_head: prog.Within(plain_head(prog, code, names)) = Exists(2, refl);
    let pass_done: pass.prog.Within(plain_done(pass.prog, test, moves, names, short)) = Exists(5, refl);
    ⟨Prog::within_trans(into_head, Prog::within_trans(head_pass, pass_done)),
     λ within r here resident held => {
        let labels = plain_labels<M>(site, laid, prog, code, pass.prog, test, moves, names, short, head_pass, within);
        let pass_in: pass.prog.Within(program) = Prog::within_trans(Exists(5, refl), within);
        let entered_in: At(prog, 0, Block(code)).Within(program) = Prog::within_trans(Exists(1, refl), Prog::within_trans(head_pass, pass_in));
        let entry_run = site.moves_block(stack.writes, program.laid_out_fits(laid), entered_in.witness, prog, 0, code, entered_in.proof,
            program.block_reads_at(laid, entered_in.witness, prog, 0, code, entered_in.proof), pre,
            λ (g: Gprs) (m: M) => stack.LoopAt(saves, λ (m2: M) => stack.TrailBy(spans, now_in<M>(site.data, spans), w, s0.memory, before, m2), s0,
                registers, words_of(values, typed_ids(inputs)))(g, m),
            λ u memory held_x => {
                let ran = entered(u, held_x.left.left);
                ⟨ran.left, ⟨kept_trans(body_kept(saves), s0.gprs, u.gprs, execute_block_normal(code, u).gprs, held_x.right.left, ran.right),
                    held_x.right.right⟩⟩
            });
        let passes = plain_passes_stops<M>(x, esc, saves, site, laid, stack, spans, Pass, PassStops, w, s0, prog, code, entry.head, registers, parameters, exit, next,
            names, short, pass, test, moves, labels, head_ok, pass_emits, cap, pass_stops, grows, stops_ext, pass_in, next_file, moved, tested.selects, into, fuel, capped,
            words_of(values, typed_ids(inputs)), before, held.left.left.right);
        site.claims_after_moves(stack.writes, site.ceiling(stack, x.ceiling(esc)), x.ceiling(esc).count(), x.least(fuel), prog_len(prog),
            prog_len(At(prog, 0, Block(code))), λ (u: MachineState<M>) => pre(u.gprs, u.memory),
            PlainAt<M>(saves, site, stack, spans, w, s0, registers, words_of(values, typed_ids(inputs)), before), λ (io: Io) => NowWorld()(before, io),
            x.Reached(site, stack), entry_run, passes)(r, here, resident, ⟨held.left, held.right⟩)
     }⟩
}

// A loop stopped, as `Emitted::plain_close` checks it.
theorem plain_close_stops<M>(x: Stop, esc: Running<M, Io> → Type, saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), spans: Spans,
    Pass: Valuation() → Now → Now → Type, PassStops: Valuation() → Nat → Now → Type, values: Valuation(), w: Nat, s0: MachineState<M>, prog: Prog, file: File, inputs, parameters: List<Typed>,
    exit: Nat, next, outputs: List<Typed>, names: Nat, short: List<Nat>, registers: List<Gpr>, entry: PlainEntry,
    entry_ok: MovesInto<M>(saves, values, file, typed_ids(inputs), registers, entry.code) ∧
        ((v: Valuation()) → (g: Gprs) → ArgsIn(words_of(v, typed_ids(parameters)), registers, g) → entry.head.Represents(v, g)),
    pass: Emitted,
    pass_emits: (v: Valuation()) → (from, to: Now) →
        EmitsNow<M>(saves, site, stack, spans, x.ceiling(esc), v, w, s0, plain_head(prog, entry.code, names), entry.head, Pass(v, from, to), from, to, pass),
    cap: Nat, pass_stops: (v: Valuation()) → (k: Nat) → k <= cap → (from: Now) →
        StopsHeap<M>(x, esc, saves, site, stack, spans, v, w, s0, plain_head(prog, entry.code, names), entry.head, PassStops(v, k, from), from, x.least(k), pass),
    grows: (v: Valuation()) → (from, to: Now) → Pass(v, from, to) → Extends(to.io.past, from.io.past),
    stops_ext: (v: Valuation()) → (k: Nat) → (from: Now) → PassStops(v, k, from) → Extends(x.world().past, from.io.past),
    before: Now, fuel: Nat, capped: fuel <= cap):
    MayStopHeap<M>(x, esc, saves, site, stack, spans, values, w, s0, prog, file,
        PassesStop(Pass, PassStops, parameters, exit, next, x.ZeroAt(), fuel, words_of(values, typed_ids(inputs)), before), before, x.least(fuel),
        pass.plain_close(saves, registers, exit, typed_ids(next), typed_ids(outputs), names, short)) {
    let facts: Type = PassesStop(Pass, PassStops, parameters, exit, next, x.ZeroAt(), fuel, words_of(values, typed_ids(inputs)), before);
    let nexts = word_ports(typed_ids(next));
    let outs = word_ports(typed_ids(outputs));
    (match pass.file.move_outputs(nexts, registers) as λ o => ((v: Valuation()) → MayKeep<M>(v, pass.file, True, o)) →
        MayStopHeap<M>(x, esc, saves, site, stack, spans, values, w, s0, prog, file, facts, before, x.least(fuel), match o {
            None => None,
            Some(moves) => match moves.file.outputs_check(nexts, registers) && leaves_all(moves.code, body_kept(saves)) {
                False => None,
                True => match moves.file.branch_test(exit) {
                    None => None,
                    Some(tested) => match input_file(outs, registers) { None => None, Some(out) => Some(Emitted(plain_done(pass.prog, tested.test, moves.code, names, short), out, pass.placement, pass.names)) },
                },
            },
        }) {
        None => λ _ => trivial,
        Some(moves) => λ keeps => match checked: moves.file.outputs_check(nexts, registers) && leaves_all(moves.code, body_kept(saves)) {
            False => trivial,
            True => {
                let parts = Bool::is_true_and(moves.file.outputs_check(nexts, registers), leaves_all(moves.code, body_kept(saves)),
                    is_true_of_eq(moves.file.outputs_check(nexts, registers) && leaves_all(moves.code, body_kept(saves)), checked));
                match moves.file.branch_test(exit) as λ t => MayStopHeap<M>(x, esc, saves, site, stack, spans, values, w, s0, prog, file, facts, before, x.least(fuel), match t {
                        None => None,
                        Some(tested) => match input_file(outs, registers) { None => None, Some(out) => Some(Emitted(plain_done(pass.prog, tested.test, moves.code, names, short), out, pass.placement, pass.names)) },
                    }) {
                    None => trivial,
                    Some(tested) => (match input_file(outs, registers) as λ o =>
                        ((g: Gprs) → PortsAt(values, outs, registers, g) → o.All(λ (f: File) => f.Represents(values, g))) →
                        MayStopHeap<M>(x, esc, saves, site, stack, spans, values, w, s0, prog, file, facts, before, x.least(fuel), match o { None => None, Some(out) => Some(Emitted(plain_done(pass.prog, tested.test, moves.code, names, short), out, pass.placement, pass.names)) }) {
                        None => λ _ => trivial,
                        Some(out) => λ out_ok => plain_loop_stops<M>(x, esc, saves, site, laid, stack, spans, Pass, PassStops, values, w, s0, prog, file, inputs, parameters,
                            exit, next, names, short, registers, entry, entry_ok.left, entry_ok.right, pass, pass_emits, cap, pass_stops, grows, stops_ext, moves.code, moves.file,
                            λ v u rep => keeps(v)(u, rep, trivial), tested,
                            λ v => moves_into<M>(saves, v, pass.file, typed_ids(next), registers, moves, keeps(v), parts.left, parts.right), out,
                            before, fuel, capped),
                    })(λ g placed => input_file_represents(values, g, outs, registers, placed)),
                }
            },
        },
    })(λ v => move_outputs_keeps<M>(v, nexts, pass.file, registers))
}

// The loop's code stopped, as `Body::emit` checks it.
theorem loop_heap_stops<M>(x: Stop, esc: Running<M, Io> → Type, saves, slots: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data),
    spans: Spans, g: CallGuards, blocks: Blocks, answers: RoutineAnswers(), grows: AnswersExtend(answers), goes: RoutineStops(), going: GoesExtend(x, goes),
    values: Valuation(), spare, w: Nat, s0: MachineState<M>, short: List<Nat>, bound: Nat,
    inputs, parameters: List<Typed>, inner: Body, exit: Nat, next, outputs: List<Typed>, prog: Prog, file: File, placement: List<Place>, names: Nat,
    before: Now, cap: Nat, fuel: Nat, capped: fuel <= cap,
    inner_emits: (start: Prog) → (head: File) → (rest: List<Place>) → (v: Valuation()) → (from, to: Now) →
        MayEmitNow<M>(saves, site, stack, spans, x.ceiling(esc), v, w, s0, start, head, inner.Holds(spans, blocks, v, answers, spare, from, to), from, to,
            inner.emit_by(g, saves, slots, short, bound, spare, start, head, rest, names + 4)),
    inner_goes: (start: Prog) → (head: File) → (rest: List<Place>) → (v: Valuation()) → (k: Nat) → k <= cap → (from: Now) →
        MayStopHeap<M>(x, esc, saves, site, stack, spans, v, w, s0, start, head, inner.Stops(spans, blocks, v, answers, goes, x, spare, k, from), from, x.least(k),
            inner.emit_by(g, saves, slots, short, bound, spare, start, head, rest, names + 4))):
    MayStopHeap<M>(x, esc, saves, site, stack, spans, values, w, s0, prog, file,
        Body::Loop(inputs, parameters, inner, exit, next, outputs).Stops(spans, blocks, values, answers, goes, x, spare, fuel, before), before, x.least(fuel),
        match state_registers(placement, typed_ids(parameters).len()) {
            None => None,
            Some(taken) => match file.plain_entry(saves, typed_ids(inputs), typed_ids(parameters), taken.registers) {
                None => None,
                Some(entry) => match inner.emit_by(g, saves, slots, short, bound, spare, plain_head(prog, entry.code, names), entry.head, taken.rest, names + 4) {
                    None => None,
                    Some(pass) => pass.plain_close(saves, taken.registers, exit, typed_ids(next), typed_ids(outputs), names, short),
                },
            },
        }) {
    let Pass = λ (v: Valuation()) (from: Now) (to: Now) => inner.Holds(spans, blocks, v, answers, spare, from, to);
    let PassStops = λ (v: Valuation()) (k: Nat) (from: Now) => inner.Stops(spans, blocks, v, answers, goes, x, spare, k, from);
    let facts = Body::Loop(inputs, parameters, inner, exit, next, outputs).Stops(spans, blocks, values, answers, goes, x, spare, fuel, before);
    match state_registers(placement, typed_ids(parameters).len()) as λ o => MayStopHeap<M>(x, esc, saves, site, stack, spans, values, w, s0, prog, file, facts,
            before, x.least(fuel), match o {
                None => None,
                Some(taken) => match file.plain_entry(saves, typed_ids(inputs), typed_ids(parameters), taken.registers) {
                    None => None,
                    Some(entry) => match inner.emit_by(g, saves, slots, short, bound, spare, plain_head(prog, entry.code, names), entry.head, taken.rest, names + 4) {
                        None => None,
                        Some(pass) => pass.plain_close(saves, taken.registers, exit, typed_ids(next), typed_ids(outputs), names, short),
                    },
                },
            }) {
        None => trivial,
        Some(taken) => (match file.plain_entry(saves, typed_ids(inputs), typed_ids(parameters), taken.registers) as λ e =>
            MayPlainEntry<M>(saves, values, file, typed_ids(inputs), typed_ids(parameters), taken.registers, e) →
            MayStopHeap<M>(x, esc, saves, site, stack, spans, values, w, s0, prog, file, facts, before, x.least(fuel), match e {
                None => None,
                Some(entry) => match inner.emit_by(g, saves, slots, short, bound, spare, plain_head(prog, entry.code, names), entry.head, taken.rest, names + 4) {
                    None => None,
                    Some(pass) => pass.plain_close(saves, taken.registers, exit, typed_ids(next), typed_ids(outputs), names, short),
                },
            }) {
            None => λ _ => trivial,
            Some(entry) => λ entry_ok => (match inner.emit_by(g, saves, slots, short, bound, spare, plain_head(prog, entry.code, names), entry.head, taken.rest,
                    names + 4) as λ e =>
                ((v: Valuation()) → (from, to: Now) → MayEmitNow<M>(saves, site, stack, spans, x.ceiling(esc), v, w, s0, plain_head(prog, entry.code, names), entry.head,
                    Pass(v, from, to), from, to, e)) →
                ((v: Valuation()) → (k: Nat) → k <= cap → (from: Now) → MayStopHeap<M>(x, esc, saves, site, stack, spans, v, w, s0, plain_head(prog, entry.code, names),
                    entry.head, PassStops(v, k, from), from, x.least(k), e)) →
                MayStopHeap<M>(x, esc, saves, site, stack, spans, values, w, s0, prog, file, facts, before, x.least(fuel), match e {
                    None => None,
                    Some(pass) => pass.plain_close(saves, taken.registers, exit, typed_ids(next), typed_ids(outputs), names, short),
                }) {
                None => λ _ _ => trivial,
                Some(pass) => λ pass_emits pass_stops => plain_close_stops<M>(x, esc, saves, site, laid, stack, spans, Pass, PassStops, values, w, s0, prog, file, inputs,
                    parameters, exit, next, outputs, names, short, taken.registers, entry, entry_ok, pass, pass_emits, cap, pass_stops,
                    λ v from to h => inner.holds_extends(spans, blocks, answers, grows, spare, v, from, to, h),
                    λ v k from h => inner.stops_extends(spans, blocks, answers, grows, goes, x, going, spare, v, k, from, h), before, fuel, capped),
            })(λ v from to => inner_emits(plain_head(prog, entry.code, names), entry.head, taken.rest, v, from, to),
                λ v k le from => inner_goes(plain_head(prog, entry.code, names), entry.head, taken.rest, v, k, le, from)),
        })(plain_entry_sound<M>(saves, values, file, typed_ids(inputs), typed_ids(parameters), taken.registers)),
    }
}

// Code whose facts say it cannot be going: only its extent.
theorem stops_of_absurd<M>(x: Stop, esc: Running<M, Io> → Type, saves: Nat, site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, values: Valuation(), d: Nat,
    s0: MachineState<M>, prog: Prog, file: File, Facts: Type, before, after: Now, least: Nat, out: Option<Emitted>,
    emits: MayEmitLinux<M>(saves, site, stack, spans, values, d, s0, prog, file, Facts, before, after, out)):
    MayStopHeap<M>(x, esc, saves, site, stack, spans, values, d, s0, prog, file, False, before, least, out) {
    (match out as λ o => MayEmitLinux<M>(saves, site, stack, spans, values, d, s0, prog, file, Facts, before, after, o) →
        MayStopHeap<M>(x, esc, saves, site, stack, spans, values, d, s0, prog, file, False, before, least, o) {
        None => λ _ => trivial,
        Some(emitted) => λ em => ⟨em.left, λ within r here resident held => false_elim(held.left.left.right)⟩,
    })(emits)
}

// A sequence stopped: its first part stopped, or done and its rest stopped
// from where the first left it, the count read off the worlds.
theorem may_stop_seq<M>(x: Stop, esc: Running<M, Io> → Type, saves: Nat, site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, values: Valuation(), d: Nat,
    s0: MachineState<M>, prog: Prog, file: File, First: Type, Held, Rest: Now → Type, before: Now, least: Nat, done: Emitted,
    first_emits: (mid: Now) → EmitsNow<M>(saves, site, stack, spans, x.ceiling(esc), values, d, s0, prog, file, Held(mid), before, mid, done),
    grows: (mid: Now) → Rest(mid) → Extends(x.world().past, mid.io.past),
    first_goes: StopsHeap<M>(x, esc, saves, site, stack, spans, values, d, s0, prog, file, First, before, least, done), out: Option<Emitted>,
    rest_goes: (mid: Now) → MayStopHeap<M>(x, esc, saves, site, stack, spans, values, d, s0, done.prog, done.file, Rest(mid), mid, least, out)):
    MayStopHeap<M>(x, esc, saves, site, stack, spans, values, d, s0, prog, file, First ∨ Exists<Now>(λ (mid: Now) => Held(mid) ∧ Rest(mid)), before, least, out) {
    let linux = site.ceiling(stack, x.ceiling(esc));
    (match out as λ o => ((mid: Now) → MayStopHeap<M>(x, esc, saves, site, stack, spans, values, d, s0, done.prog, done.file, Rest(mid), mid, least, o)) →
        MayStopHeap<M>(x, esc, saves, site, stack, spans, values, d, s0, prog, file, First ∨ Exists<Now>(λ (mid: Now) => Held(mid) ∧ Rest(mid)), before, least, o) {
        None => λ _ => trivial,
        Some(emitted) => λ rest => {
            let tail: done.prog.Within(emitted.prog) = rest(before).left;
            ⟨Prog::within_trans(first_goes.left, tail), λ within r here resident held =>
                match held.left.left.right as λ _ => site.Performs(stack.writes, linux, x.Reached(site, stack), x.ceiling(esc).count(), least, r) {
                    Inl(going) => first_goes.right(Prog::within_trans(tail, within))(r, here, resident,
                        ⟨⟨⟨held.left.left.left, going⟩, held.left.right⟩, held.right⟩),
                    Inr(ex) => {
                        let mid = ex.witness;
                        let pre = NowPre<M>(saves, site, stack, spans, values, d, s0, file, Held(mid) ∧ x.ceiling(esc).Under(mid), before);
                        let both = site.claims_trans(stack.writes, linux, x.ceiling(esc).count(), 0, x.ceiling(esc).count(), least, prog_len(prog),
                            prog_len(done.prog), pre, NowPre<M>(saves, site, stack, spans, values, d, s0, done.file, Rest(mid), mid), x.Reached(site, stack),
                            site.claims_weaken(stack.writes, linux, x.ceiling(esc).count(), 0, prog_len(prog), pre,
                                NowPost<M>(saves, site, stack, spans, values, d, s0, prog_len(done.prog), done.file, mid), pre,
                                site.Arrived(prog_len(done.prog), NowPre<M>(saves, site, stack, spans, values, d, s0, done.file, Rest(mid), mid)),
                                first_emits(mid).right(Prog::within_trans(tail, within)), λ u h => h,
                                λ t arrived => ⟨arrived.left, ⟨⟨⟨arrived.right.left.left, ex.proof.right⟩, arrived.right.left.right⟩, arrived.right.right⟩⟩),
                            rest(mid).right(within));
                        site.claims_stop_exact(stack, x, esc, (x.ceiling(esc).count() + x.ceiling(esc).count()) + 0, least, prog_len(prog), pre, before,
                            λ u h => h.right.left, site.claims_loosen(stack.writes, linux, x.ceiling(esc).count() + x.ceiling(esc).count(), 0 + least, 0, least,
                                prog_len(prog), pre, x.Reached(site, stack), { omega }, both))(r, here, resident,
                            ⟨⟨⟨held.left.left.left, ⟨ex.proof.left, grows(mid, ex.proof.right)⟩⟩, held.left.right⟩, held.right⟩)
                    },
                }⟩
        },
    })(rest_goes)
}

// Fewer steps claimed.
theorem may_stop_loosen<M>(x: Stop, esc: Running<M, Io> → Type, saves: Nat, site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, values: Valuation(), d: Nat,
    s0: MachineState<M>, prog: Prog, file: File, Facts: Type, before: Now, least, fewer: Nat, le: fewer <= least, out: Option<Emitted>,
    goes: MayStopHeap<M>(x, esc, saves, site, stack, spans, values, d, s0, prog, file, Facts, before, least, out)):
    MayStopHeap<M>(x, esc, saves, site, stack, spans, values, d, s0, prog, file, Facts, before, fewer, out) {
    (match out as λ o => MayStopHeap<M>(x, esc, saves, site, stack, spans, values, d, s0, prog, file, Facts, before, least, o) →
        MayStopHeap<M>(x, esc, saves, site, stack, spans, values, d, s0, prog, file, Facts, before, fewer, o) {
        None => λ _ => trivial,
        Some(emitted) => λ g => ⟨g.left, λ within => site.claims_loosen(stack.writes, site.ceiling(stack, x.ceiling(esc)), x.ceiling(esc).count(), least, 0, fewer,
            prog_len(prog), NowPre<M>(saves, site, stack, spans, values, d, s0, file, Facts, before), x.Reached(site, stack), le, g.right(within))⟩,
    })(goes)
}

// An exit, at the stop: exited with its status in the world it is in, the
// code reaches the SYSCALL with sixty in RAX and the status in RDI,
// counting nothing; going, an exit is never reached.
theorem exit_stops<M>(x: Stop, esc: Running<M, Io> → Type, saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data),
    spans: Spans, values: Valuation(), d: Nat, s0: MachineState<M>, prog: Prog, file: File, status: Nat, placement: List<Place>, names: Nat,
    before: Now, fuel: Nat):
    MayStopHeap<M>(x, esc, saves, site, stack, spans, values, d, s0, prog, file, x.Exits(values(64, status), before.io), before, x.least(fuel),
        emit_exit(prog, file, status, placement, names)) {
    match file.find(Held(status, Word)) as λ o => MayStopHeap<M>(x, esc, saves, site, stack, spans, values, d, s0, prog, file,
        x.Exits(values(64, status), before.io), before, x.least(fuel), match o {
            None => None,
            Some(found) => Some(Emitted(At(At(prog, 0, Block(exit_code(found.register))), 0, Syscall), file, placement, names)),
        }) {
        None => trivial,
        Some(found) => {
            let code = exit_code(found.register);
            let block = At(prog, 0, Block(code));
            let fits = site.program.laid_out_fits(laid);
            let linux = site.ceiling(stack, x.ceiling(esc));
            ⟨Exists(2, refl), λ within => site.claims_stop_exact(stack, x, esc, 0, x.least(fuel), prog_len(prog),
                NowPre<M>(saves, site, stack, spans, values, d, s0, file, x.Exits(values(64, status), before.io), before), before, λ r held => held.right.left,
                (match x as λ y => site.Claims(stack.writes, linux, 0, y.least(fuel), prog_len(prog),
                        NowPre<M>(saves, site, stack, spans, values, d, s0, file, y.Exits(values(64, status), before.io), before), y.Reached(site, stack)) {
                    StopGoing(_) => λ r here resident held => false_elim(held.left.left.right),
                    StopExited(st, o) => λ r here resident held => {
                        let block_in: block.Within(site.program) = Prog::within_trans(Exists(1, refl), within);
                        let moved = site.moves_block(stack.writes, fits, block_in.witness, prog, 0, code, block_in.proof,
                            site.program.block_reads_at(laid, block_in.witness, prog, 0, code, block_in.proof),
                            λ (g: Gprs) (_: M) => file.Represents(values, g) ∧ (values(64, status) = st),
                            λ (g: Gprs) (_: M) => (read_gpr(Rax, g) = BitVec::ofNat(60)) ∧ (read_gpr(Rdi, g) = st),
                            λ s memory held_s => ⟨refl, trans(sym(found.at.rep(values, s.gprs, held_s.left)), held_s.right)⟩);
                        let got = moved(r.state, here, resident, ⟨held.left.left.left, held.left.left.right.left⟩);
                        let t = got.witness;
                        site.performs_steps(stack.writes, linux, StopExited(st, o).Reached(site, stack), r, t, got.proof.left,
                            ⟨⟨site.item_fetched(fits, t, got.proof.right.right.left, within.witness, block, 0, Syscall, within.proof, got.proof.right.left),
                             got.proof.right.right.right⟩, trans(held.right.left, held.left.left.right.right)⟩)
                    },
                }))⟩
        },
    }
}

// A system call never stops a run short: there are no facts to claim from.
theorem sys_stops<M>(x: Stop, esc: Running<M, Io> → Type, saves: Nat, site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, values: Valuation(), d: Nat,
    s0: MachineState<M>, prog: Prog, file: File, call: SysCall, placement: List<Place>, names: Nat, before: Now, least: Nat):
    MayStopHeap<M>(x, esc, saves, site, stack, spans, values, d, s0, prog, file, False, before, least, emit_sys(saves, prog, file, call, placement, names)) {
    match file.move_outputs(sys_entries(file, call), sys_targets(file, call)) as λ o =>
        MayStopHeap<M>(x, esc, saves, site, stack, spans, values, d, s0, prog, file, False, before, least, match o {
            None => None,
            Some(moves) => match moves.file.outputs_check(word_ports(call.words()), sys_registers()) &&
                (leaves_all(moves.code, body_kept(saves)) && sys_clear(saves)) {
                False => None,
                True => Some(Emitted(sys_prog(prog, moves.code, call), sys_after(moves.file.write(Rax, None), call.result()), placement, names)),
            },
        }) {
        None => trivial,
        Some(moves) => match moves.file.outputs_check(word_ports(call.words()), sys_registers()) &&
            (leaves_all(moves.code, body_kept(saves)) && sys_clear(saves)) as λ v =>
            MayStopHeap<M>(x, esc, saves, site, stack, spans, values, d, s0, prog, file, False, before, least, match v {
                False => None,
                True => Some(Emitted(sys_prog(prog, moves.code, call), sys_after(moves.file.write(Rax, None), call.result()), placement, names)),
            }) {
            False => trivial,
            True => ⟨Exists(3, refl), λ within r here resident held => false_elim(held.left.left.right)⟩,
        },
    }
}

// A region's code stopped at `x`: from its start, at the stop's ceiling,
// the stop's state with at least `x.least` of the fuel its run was given,
// at most `cap`, the routines it calls stopping with at least
// `callee_least` from their entries, a CALL being one step more, or spent;
// an exit by `exit_stops`. Its done parts are `Body::emit_emits` at the
// same ceiling, their worlds under the stop's (`Body::stops_extends`).
theorem Body::emit_stops<M>(self body: Body, x: Stop, esc: Running<M, Io> → Type, g: CallGuards, saves, slots: Nat, site: Site<M>,
    laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), top: Nat, spans: Spans,
    loan: Loan<M>(site.fetch, site.data, stack, top, spans), blocks: Blocks, lent: blocks.Lent(spans), bound, avail: Nat, deep: Nat → Nat, deep_avail: Nat, answers: RoutineAnswers(),
    grows: AnswersExtend(answers), goes: RoutineStops(), going: GoesExtend(x, goes), floored: Bool, spends: Nat → Nat → Running<M, Io> → Type,
    callees: CalleesReturn<M>(site, stack, spans, g.rooms, floored, top, bound, answers, spends), callee_least: Nat,
    callees_stop: CalleesStop<M>(x, site, stack, spans, g.rooms, floored, top, bound, goes, callee_least, spends), cap: Nat,
    covered: x.least(cap) <= 1 + callee_least, spare: Nat, d, w: Nat, s0: MachineState<M>,
    framing: body.calls().IsTrue() → stack.BodyFrame(top, avail, d, slots, w, s0),
    floor: floored.IsTrue() → (gp: Gprs) → Kept(body_kept(saves), s0.gprs, gp) → read_gpr(Rbp, gp) = stack.low,
    guarding: (callee: Nat) → g.guards(callee) = True → floored.IsTrue(),
    stopping: (callee: Nat) → g.guards(callee) = True → StopLaid<M>(site, g.stop),
    spent: (callee: Nat) → g.guards(callee) = True → (args: List<Value>) → (heap: Heap) → (io: Io) → (a: Answer) → answers(callee, args, heap, io, a) →
        callee + 1 <= bound → deep(callee) + 24 <= deep_avail → d < 24 + g.rooms(callee) → (t: Running<M, Io>) → site.SpentExit(stack)(t) → esc(t),
    spent_stop: (callee: Nat) → g.guards(callee) = True → (args: List<Value>) → (heap: Heap) → (io: Io) → goes(callee, args, heap, io) →
        callee + 1 <= bound → deep(callee) + 24 <= deep_avail → d < 24 + g.rooms(callee) → (t: Running<M, Io>) → site.SpentExit(stack)(t) → esc(t),
    carries: (callee: Nat) → callee + 1 <= bound → deep(callee) + 24 <= deep_avail → (count: Nat) → count <= 2 → (t: Running<M, Io>) → spends(callee, (d - 8 * count) - 8)(t) → esc(t),
    short: List<Nat>):
    body.FitsBy(g.at, g.rooms, bound, avail) → body.Fits(deep, bound, deep_avail) → (values: Valuation()) → (prog: Prog) → (file: File) → (placement: List<Place>) → (names: Nat) →
    (fuel: Nat) → fuel <= cap → (before: Now) →
    MayStopHeap<M>(x, esc, saves, site, stack, spans, values, w, s0, prog, file, body.Stops(spans, blocks, values, answers, goes, x, spare, fuel, before),
        before, x.least(fuel), body.emit_by(g, saves, slots, short, bound, spare, prog, file, placement, names)) {
    let c = x.ceiling(esc);
    match body {
        Leaf(instrs) => λ shallow deeply values prog file placement names fuel capped before =>
            stops_of_absurd<M>(x, esc, saves, site, stack, spans, values, w, s0, prog, file,
                InstrsHold(spans, blocks, values, instrs, before.heap, before.heap) ∧ (before.io = before.io), before, before, x.least(fuel),
                emit_instrs(saves, prog, file, instrs, placement, names),
                may_emit_linux_of_heap<M>(saves, site, stack, spans, values, w, s0, prog, file, InstrsHold(spans, blocks, values, instrs, before.heap, before.heap),
                    before, before, emit_instrs(saves, prog, file, instrs, placement, names),
                    emit_instrs_emits<M>(saves, site, laid, stack, top, spans, loan, blocks, lent, values, w, s0, instrs, prog, file, placement, names,
                        before.heap, before.heap))),
        Seq(first, rest) => λ shallow deeply values prog file placement names fuel capped before => {
            let first_framing = λ (y: first.calls().IsTrue()) => framing(Bool::is_true_or_l(first.calls(), rest.calls(), y));
            (match first.emit_by(g, saves, slots, short, bound, spare, prog, file, placement, names) as λ o =>
                ((mid: Now) → MayEmitNow<M>(saves, site, stack, spans, c, values, w, s0, prog, file,
                    first.Holds(spans, blocks, values, answers, spare, before, mid), before, mid, o)) →
                MayStopHeap<M>(x, esc, saves, site, stack, spans, values, w, s0, prog, file,
                    first.Stops(spans, blocks, values, answers, goes, x, spare, fuel, before), before, x.least(fuel), o) →
                MayStopHeap<M>(x, esc, saves, site, stack, spans, values, w, s0, prog, file,
                    Body::Seq(first, rest).Stops(spans, blocks, values, answers, goes, x, spare, fuel, before), before, x.least(fuel),
                    match o { None => None, Some(done) => rest.emit_by(g, saves, slots, short, bound, spare, done.prog, done.file, done.placement, done.names) }) {
                None => λ _ _ => trivial,
                Some(done) => λ first_emits first_goes => may_stop_seq<M>(x, esc, saves, site, stack, spans, values, w, s0, prog, file,
                    first.Stops(spans, blocks, values, answers, goes, x, spare, fuel, before),
                    λ (mid: Now) => first.Holds(spans, blocks, values, answers, spare, before, mid),
                    λ (mid: Now) => rest.Stops(spans, blocks, values, answers, goes, x, spare, fuel, mid), before, x.least(fuel), done, first_emits,
                    λ mid h => rest.stops_extends(spans, blocks, answers, grows, goes, x, going, spare, values, fuel, mid, h), first_goes,
                    rest.emit_by(g, saves, slots, short, bound, spare, done.prog, done.file, done.placement, done.names),
                    λ mid => Body::emit_stops<M>(rest, x, esc, g, saves, slots, site, laid, stack, top, spans, loan, blocks, lent, bound, avail, deep, deep_avail, answers,
                        grows, goes, going, floored, spends, callees, callee_least, callees_stop, cap, covered, spare, d, w, s0,
                        λ y => framing(Bool::is_true_or_r(first.calls(), rest.calls(), y)), floor, guarding, stopping, spent, spent_stop, carries, short, shallow.right, deeply.right,
                        values, done.prog, done.file, done.placement, done.names, fuel, capped, mid)),
            })(λ mid => Body::emit_emits<M>(first, g, saves, slots, site, laid, stack, top, spans, loan, blocks, lent, bound, avail, deep, deep_avail, answers, grows, floored, spends,
                    callees, c, spare, d, w, s0, first_framing, floor, guarding, stopping, spent, carries, short, shallow.left, deeply.left, values, prog, file, placement, names,
                    before, mid),
                Body::emit_stops<M>(first, x, esc, g, saves, slots, site, laid, stack, top, spans, loan, blocks, lent, bound, avail, deep, deep_avail, answers, grows, goes,
                    going, floored, spends, callees, callee_least, callees_stop, cap, covered, spare, d, w, s0, first_framing, floor, guarding, stopping, spent, spent_stop,
                    carries, short, shallow.left, deeply.left, values, prog, file, placement, names, fuel, capped, before))
        },
        Branch(condition, yes, no) => λ shallow deeply values prog file placement names fuel capped before =>
            (match file.branch_test(condition) as λ o => MayStopHeap<M>(x, esc, saves, site, stack, spans, values, w, s0, prog, file,
                    Body::Branch(condition, yes, no).Stops(spans, blocks, values, answers, goes, x, spare, fuel, before), before, x.least(fuel), match o {
                        None => None,
                        Some(tested) => match yes.emit_by(g, saves, slots, short, bound, spare, prog.branched_by(tested.test, names + 1, shorts(short, names + 1)),
                            file.know(Truth(condition)), placement, names + 2) {
                            None => None,
                            Some(left) => match no.emit_by(g, saves, slots, short, bound, spare,
                                left.prog.else_label_by(names + 1, names + 2, shorts(short, names + 2)), file.know(Falsity(condition)), left.placement,
                                left.names) {
                                None => None,
                                Some(right) => Some(Emitted(right.prog.join_label(names + 2), left.file.meet(right.file, file.known), right.placement,
                                    right.names)),
                            },
                        },
                    }) {
                None => trivial,
                Some(tested) => {
                    let yes_prog = prog.branched_by(tested.test, names + 1, shorts(short, names + 1));
                    (match yes.emit_by(g, saves, slots, short, bound, spare, yes_prog, file.know(Truth(condition)), placement, names + 2) as λ o =>
                        MayStopHeap<M>(x, esc, saves, site, stack, spans, values, w, s0, yes_prog, file.know(Truth(condition)),
                            yes.Stops(spans, blocks, values, answers, goes, x, spare, fuel, before), before, x.least(fuel), o) →
                        MayStopHeap<M>(x, esc, saves, site, stack, spans, values, w, s0, prog, file,
                            Body::Branch(condition, yes, no).Stops(spans, blocks, values, answers, goes, x, spare, fuel, before), before, x.least(fuel), match o {
                                None => None,
                                Some(left) => match no.emit_by(g, saves, slots, short, bound, spare,
                                    left.prog.else_label_by(names + 1, names + 2, shorts(short, names + 2)), file.know(Falsity(condition)), left.placement,
                                    left.names) {
                                    None => None,
                                    Some(right) => Some(Emitted(right.prog.join_label(names + 2), left.file.meet(right.file, file.known), right.placement,
                                        right.names)),
                                },
                            }) {
                        None => λ _ => trivial,
                        Some(left) => λ yes_goes => {
                            let no_prog = left.prog.else_label_by(names + 1, names + 2, shorts(short, names + 2));
                            (match no.emit_by(g, saves, slots, short, bound, spare, no_prog, file.know(Falsity(condition)), left.placement, left.names) as λ o =>
                                MayStopHeap<M>(x, esc, saves, site, stack, spans, values, w, s0, no_prog, file.know(Falsity(condition)),
                                    no.Stops(spans, blocks, values, answers, goes, x, spare, fuel, before), before, x.least(fuel), o) →
                                MayStopHeap<M>(x, esc, saves, site, stack, spans, values, w, s0, prog, file,
                                    Body::Branch(condition, yes, no).Stops(spans, blocks, values, answers, goes, x, spare, fuel, before), before, x.least(fuel),
                                    match o {
                                        None => None,
                                        Some(right) => Some(Emitted(right.prog.join_label(names + 2), left.file.meet(right.file, file.known),
                                            right.placement, right.names)),
                                    }) {
                                None => λ _ => trivial,
                                Some(right) => λ no_goes => branch_heap_stops<M>(x, esc, saves, site, laid, stack, spans, values, w, s0, prog, file, condition,
                                    yes.Stops(spans, blocks, values, answers, goes, x, spare, fuel, before),
                                    no.Stops(spans, blocks, values, answers, goes, x, spare, fuel, before), before, x.least(fuel), tested, names, short, left,
                                    right, yes_goes, no_goes, yes_goes.left, no_goes.left),
                            })(Body::emit_stops<M>(no, x, esc, g, saves, slots, site, laid, stack, top, spans, loan, blocks, lent, bound, avail, deep, deep_avail, answers, grows,
                                goes, going, floored, spends, callees, callee_least, callees_stop, cap, covered, spare, d, w, s0,
                                λ y => framing(Bool::is_true_or_r(yes.calls(), no.calls(), y)), floor, guarding, stopping, spent, spent_stop, carries, short,
                                shallow.right, deeply.right, values, no_prog, file.know(Falsity(condition)), left.placement, left.names, fuel, capped, before))
                        },
                    })(Body::emit_stops<M>(yes, x, esc, g, saves, slots, site, laid, stack, top, spans, loan, blocks, lent, bound, avail, deep, deep_avail, answers, grows,
                        goes, going, floored, spends, callees, callee_least, callees_stop, cap, covered, spare, d, w, s0,
                        λ y => framing(Bool::is_true_or_l(yes.calls(), no.calls(), y)), floor, guarding, stopping, spent, spent_stop, carries, short, shallow.left, deeply.left,
                        values, yes_prog, file.know(Truth(condition)), placement, names + 2, fuel, capped, before))
                },
            }),
        Call(callee, arguments, results) => λ shallow deeply values prog file placement names fuel capped before => {
            let frame = framing(trivial);
            let out = Body::Call(callee, arguments, results).emit_by(g, saves, slots, short, bound, spare, prog, file, placement, names);
            let unguarded = file.emit_call(slots, prog, callee, typed_ids(arguments), call_result(results, spare), call_also(results), placement, names,
                bound, [], []);
            let Facts: Type = Body::Call(callee, arguments, results).Stops(spans, blocks, values, answers, goes, x, spare, fuel, before);
            may_stop_loosen<M>(x, esc, saves, site, stack, spans, values, w, s0, prog, file, Facts, before, 1 + callee_least, x.least(fuel),
                { let mono = x.least_mono(fuel, cap, capped); omega }, out,
                j(frame.right.right.left, λ y _ => MayStopHeap<M>(x, esc, saves, site, stack, spans, values, y, s0, prog, file, Facts, before,
                        1 + callee_least, out),
                    (match among(g.at, callee) as λ b => among(g.at, callee) = b →
                        (match b as λ _ => Type { True => True, False => g.rooms(callee) + 24 <= avail }) →
                        MayStopHeap<M>(x, esc, saves, site, stack, spans, values, d + 8 * slots, s0, prog, file, Facts, before, 1 + callee_least,
                            match b as λ _ => Option<Emitted> {
                                False => unguarded,
                                True => match g.need(callee).leb(guard_most()) {
                                    False => None,
                                    True => file.emit_call(slots, prog.guarded(g.need(callee), g.stop), callee, typed_ids(arguments),
                                        call_result(results, spare), call_also(results), placement, names, bound, [], []),
                                },
                            }) {
                        False => λ _ fit => call_heap_stops<M>(x, esc, saves, slots, site, laid, stack, top, spans, loan, g.rooms, bound, avail, goes,
                            callee_least, floored, spends, callees_stop, blocks, values, spare, d, s0, frame.left, floor, frame.right.left, frame.right.right.right.left,
                            frame.right.right.right.right, prog, file, callee, arguments, results, fit, λ below2 => carries(callee, below2, deeply(below2)), placement, names, before),
                        True => λ guarded _ => match ok: g.need(callee).leb(guard_most()) {
                            False => trivial,
                            True => {
                                let laid_stop = stopping(callee, guarded);
                                j(sym(laid_stop.named), λ st _ => MayStopHeap<M>(x, esc, saves, site, stack, spans, values, d + 8 * slots, s0, prog, file, Facts,
                                        before, 1 + callee_least, file.emit_call(slots, prog.guarded(g.need(callee), st), callee, typed_ids(arguments),
                                            call_result(results, spare), call_also(results), placement, names, bound, [], [])),
                                    guarded_call_stops<M>(x, esc, saves, slots, site, laid, stack, top, spans, loan, g.rooms, bound, goes, going, callee_least,
                                        floored, spends, callees_stop, blocks, values, spare, d, s0, frame.left, floor(guarding(callee, guarded)), frame.right.right.right.left,
                                        frame.right.right.right.right, prog, file, callee, arguments, results, laid_stop.name, laid_stop.before,
                                        j(laid_stop.named, λ st _ => laid_stop.before.stopped_at(st).Within(site.program), laid_stop.within),
                                        g.need(callee).leb_sound(guard_most(), is_true_of_eq(g.need(callee).leb(guard_most()), ok)), before,
                                        λ below args h short2 => spent_stop(callee, guarded, args, before.heap, before.io, h, below, deeply(below), short2), λ below2 => carries(callee, below2, deeply(below2)), placement,
                                        names))
                            },
                        },
                    })(refl, shallow)))
        },
        Loop(inputs, parameters, inner, exit, next, outputs) => λ shallow deeply values prog file placement names fuel capped before =>
            loop_heap_stops<M>(x, esc, saves, slots, site, laid, stack, spans, g, blocks, answers, grows, goes, going, values, spare, w, s0, short, bound,
                inputs, parameters, inner, exit, next, outputs, prog, file, placement, names, before, cap, fuel, capped,
                λ start head rest v from to => Body::emit_emits<M>(inner, g, saves, slots, site, laid, stack, top, spans, loan, blocks, lent, bound, avail, deep, deep_avail,
                    answers, grows, floored, spends, callees, c, spare, d, w, s0, framing, floor, guarding, stopping, spent, carries, short, shallow, deeply, v, start, head, rest,
                    names + 4, from, to),
                λ start head rest v k le from => Body::emit_stops<M>(inner, x, esc, g, saves, slots, site, laid, stack, top, spans, loan, blocks, lent,
                    bound, avail, deep, deep_avail, answers, grows, goes, going, floored, spends, callees, callee_least, callees_stop, cap, covered, spare, d, w, s0, framing, floor, guarding,
                    stopping, spent, spent_stop, carries, short, shallow, deeply, v, start, head, rest, names + 4, k, le, from)),
        Sys(call) => λ shallow deeply values prog file placement names fuel capped before =>
            sys_stops<M>(x, esc, saves, site, stack, spans, values, w, s0, prog, file, call, placement, names, before, x.least(fuel)),
        Exit(status) => λ shallow deeply values prog file placement names fuel capped before =>
            exit_stops<M>(x, esc, saves, site, laid, stack, spans, values, w, s0, prog, file, status, placement, names, before, fuel),
    }
}

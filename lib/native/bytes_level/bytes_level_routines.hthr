// The bytes level's routines and programs lowered
// (issues/bytes-level-lowering-routines.md): a routine's code is
// FunctionIR's function frame around its body's (`function_runs_by`, cited
// at the heap's clause), a program's routines laid out at their labels, and
// `Site::Tracks` proved for each by induction on the fuel: a call answered
// at fuel `n` is the callee's run at one less, met by the callee's code by
// the induction's hypothesis.
//
// - The scope: a routine's parameters and body bind no id twice
//   (`Routine::scope`, bytes_level_scope's `Body::fresh`), so its run
//   determines one valuation (its final locals lowered) at which its body's
//   facts hold.
// - The answer: its results' words in RAX and `answer_registers()`; a
//   routine with none answers zero in RAX, from an id the scope never binds
//   (`spare`), so a call always has a word to land.
// - The stack: a routine may call any routine of the program, itself
//   included. Its room below its return address is a table by routine and
//   by the depth of the deepest chain of calls its run enters (`run_peak`,
//   beside the meaning): at depth `p` its frame fits, a call's 24 bytes
//   below it, and its callees' rooms at depth `p - 1` (`RoomLaw`). The
//   theorem holds under every lawful table; `depth_rooms` is one, for every
//   program (`depth_rooms_lawful`).
// - The clause: `Site::Tracks` (docs/language/ownership-design.md §17.7),
//   by two inductions on fuel: a run done is returned (`program_returns`);
//   one stopped short (`Stop`: still going, or exited) performs the stop's
//   state (`program_stops`, from the regions' `Body::emit_stops`): going, at
//   least `n - 1` machine steps; exited, at the exit call with its status.
//   A stuck one asks nothing. No system call is lowered yet, so the world
//   is the entry's (`program_quiet`, `program_stop_quiet`).
import bytes_memory;
import bytes_level;
import bytes_level_lower;
import bytes_level_scope;
import x86_64_memory_contract;
import x86_64_call_contract;
import function_ir;
import function_ir_eval;
import function_ir_state;
import function_ir_lower;
import function_ir_lower_structured;
import function_ir_lower_reads;
import function_ir_lower_calls;
import x86_64;
import x86_64_block;
import x86_64_fetch;
import x86_64_data_read;
import x86_64_layout;
import x86_64_store;
import x86_64_stack;
import x86_64_kept;
import x86_64_asm;
import x86_64_asm_runs;
import x86_64_stack_runs;
import linux_world;
import bitvec;
import bool;
import list;
import logic;
import nat;
import option;
import omega;

// ---------------------------------------------------------------------------
// A routine's scope and answer

// One past every id listed.
fn ids_past(ids: List<Nat>) → Nat { match ids { Nil => 0, Cons(x, rest) => (x + 1).max(ids_past(rest)) } }

theorem unlisted_above(ids: List<Nat>, q: Nat): ids_past(ids) <= q → listed(ids, q) = False {
    match ids {
        Nil => λ _ => refl,
        Cons(x, rest) => λ above => {
            let low: (x + 1 <= q) = Nat::le_trans(x + 1, (x + 1).max(ids_past(rest)), q, (x + 1).le_max_l(ids_past(rest)), above);
            let rest_low: (ids_past(rest) <= q) = Nat::le_trans(ids_past(rest), (x + 1).max(ids_past(rest)), q, (x + 1).le_max_r(ids_past(rest)), above);
            j(sym(x.same_false_of(q, λ e => false_elim(omega(low, e)))), λ b _ => (match b { True => True, False => listed(rest, q) }) = False,
                unlisted_above(rest, q, rest_low))
        },
    }
}

// The ids a routine's scope binds: its parameters, then its body's.
fn Routine::scope(self r: Routine) → Option<List<Nat>> {
    match fresh_ids([], typed_ids(r.parameters)) { None => None, Some(start) => r.body.fresh(start) }
}

// Where a routine with no results makes its zero answer.
fn answer_instrs(results: List<Typed>, spare: Nat) → List<Instr> { match results { Nil => [Compute(Const(64, spare, 0))], Cons(_, _) => [] } }

// The body the routine's code is of: its own, then its zero answer if any.
fn Routine::whole(self r: Routine, spare: Nat) → Body { Seq(r.body, Leaf(answer_instrs(r.results, spare))) }

// The words its code answers, by id.
fn Routine::outs(self r: Routine, spare: Nat) → List<Port> {
    Cons(Port(id := call_result(r.results, spare), width := 64), word_ports(call_also(r.results)))
}

// Its parameters past the sixth, loaded from above its return address.
fn Routine::loads(self r: Routine) → Nat { typed_ids(r.parameters).drop(6).len() }

// Its frame: the call slots it asks where it calls, and its saves.
fn Routine::slots(self r: Routine, asked: Nat) → Nat { match r.body.calls() { False => 0, True => asked.min(8) } }

fn Routine::frame(self r: Routine, asked, saves: Nat) → Nat { frame_size(r.slots(asked), saves) }

theorem Routine::slots_few(self r: Routine, asked: Nat): r.slots(asked) <= 8 {
    match r.body.calls() as λ b => (match b { False => 0, True => asked.min(8) }) <= 8 { False => trivial, True => asked.min_le_r(8) }
}

// Routine `k`'s room, `own` below its return address: its frame fits, so
// do a call's 24 bytes below it where it calls, and what is left holds each
// callee's room in `rooms`.
fn Routine::Roomy(self r: Routine, rooms: Nat → Nat, own, bound, asked, saves: Nat) → Type {
    (r.frame(asked, saves) <= own) ∧ ((r.body.calls().IsTrue() → r.frame(asked, saves) + 24 <= own) ∧
        r.body.Fits(rooms, bound, own - r.frame(asked, saves)))
}

// The largest frame a placement can give it: eight call slots and six
// saves.
theorem Routine::frame_most(self r: Routine, asked, saves: Nat): r.frame(asked, saves) <= r.frame(8, 6) {
    let six = saves_len(saves);
    let all: (function_saves(6).len() = 6) = refl;
    let fewer: (r.slots(asked) <= r.slots(8)) = match r.body.calls() as λ b =>
            (match b { False => 0, True => asked.min(8) }) <= (match b { False => 0, True => 8.min(8) }) {
        False => trivial,
        True => asked.min_le_r(8),
    };
    let here: (r.frame(asked, saves) = 8 * (r.slots(asked) + function_saves(saves).len())) = refl;
    let most: (r.frame(8, 6) = 8 * (r.slots(8) + function_saves(6).len())) = refl;
    { omega }
}

// More room than a region asks.
theorem Body::fits_more(self body: Body, rooms: Nat → Nat, bound, avail, more: Nat, le: avail <= more):
    body.Fits(rooms, bound, avail) → body.Fits(rooms, bound, more) {
    match body {
        Leaf(_) => λ f => f,
        Seq(first, rest) => λ f => ⟨first.fits_more(rooms, bound, avail, more, le, f.left), rest.fits_more(rooms, bound, avail, more, le, f.right)⟩,
        Branch(_, yes, no) => λ f => ⟨yes.fits_more(rooms, bound, avail, more, le, f.left), no.fits_more(rooms, bound, avail, more, le, f.right)⟩,
        Call(callee, _, _) => λ f below => { let fit = f(below); omega },
        Loop(_, _, inner, _, _, _) => λ f => inner.fits_more(rooms, bound, avail, more, le, f),
        Sys(_) => λ f => f,
        Exit(_) => λ f => f,
    }
}

// The room at the largest frame is room at the frame a placement gives.
theorem Routine::roomy_at(self r: Routine, rooms: Nat → Nat, own, bound, asked, saves: Nat, most: r.Roomy(rooms, own, bound, 8, 6)):
    r.Roomy(rooms, own, bound, asked, saves) {
    let le = r.frame_most(asked, saves);
    let frame = r.frame(asked, saves);
    let largest = r.frame(8, 6);
    let fewer: (own - largest <= own - frame) = { omega };
    ⟨Nat::le_trans(frame, largest, own, le, most.left), ⟨λ c => { let fit = most.right.left(c); omega },
        r.body.fits_more(rooms, bound, own - largest, own - frame, fewer, most.right.right)⟩⟩
}

// ---------------------------------------------------------------------------
// Room by call depth (docs/language/ownership-design.md §17.7)
//
// The room below a routine's return address is a table by routine and by
// the depth of the deepest chain of calls its run enters (`Body::peak`,
// beside the meaning): at depth `p` its callees, entered at depth below
// `p`, have their room at `p - 1`, and at depth zero it enters none. A
// table is lawful where every routine fits at every depth; the lowering is
// proved for every lawful table. A routine that calls itself needs more room
// the deeper it goes; one whose callees are all below it has a table
// constant from its depth on.

// The callees' room table at depth `p`: the table at `p - 1`, or none.
fn rooms_below(room: Nat → Nat → Nat, p: Nat) → Nat → Nat { match p { Zero => λ (g: Nat) => 0, Succ(q) => λ (g: Nat) => room(g, q) } }

fn RoomLaw(routines: List<Routine>, room: Nat → Nat → Nat) → Type {
    (f: Nat) → (r: Routine) → routines.nth(f) = Some(r) → (p: Nat) → r.Roomy(rooms_below(room, p), room(f, p), routines.len(), 8, 6)
}

// The callees' rooms and a call's 24 bytes fit in what a region asks.
theorem Body::callee_fits(self body: Body, rooms: Nat → Nat, bound: Nat): body.Fits(rooms, bound, body.callee_room(rooms)) {
    match body {
        Leaf(_) => trivial,
        Seq(first, rest) => ⟨first.fits_more(rooms, bound, first.callee_room(rooms), first.callee_room(rooms).max(rest.callee_room(rooms)),
                first.callee_room(rooms).le_max_l(rest.callee_room(rooms)), first.callee_fits(rooms, bound)),
            rest.fits_more(rooms, bound, rest.callee_room(rooms), first.callee_room(rooms).max(rest.callee_room(rooms)),
                first.callee_room(rooms).le_max_r(rest.callee_room(rooms)), rest.callee_fits(rooms, bound))⟩,
        Branch(_, yes, no) => ⟨yes.fits_more(rooms, bound, yes.callee_room(rooms), yes.callee_room(rooms).max(no.callee_room(rooms)),
                yes.callee_room(rooms).le_max_l(no.callee_room(rooms)), yes.callee_fits(rooms, bound)),
            no.fits_more(rooms, bound, no.callee_room(rooms), yes.callee_room(rooms).max(no.callee_room(rooms)),
                yes.callee_room(rooms).le_max_r(no.callee_room(rooms)), no.callee_fits(rooms, bound))⟩,
        Call(callee, _, _) => λ _ => (rooms(callee) + 24).le_refl(),
        Loop(_, _, inner, _, _, _) => inner.callee_fits(rooms, bound),
        Sys(_) => trivial,
        Exit(_) => trivial,
    }
}

// A region that calls asks a call's 24 bytes at least.
theorem Body::callee_room_calls(self body: Body, rooms: Nat → Nat): body.calls().IsTrue() → 24 <= body.callee_room(rooms) {
    match body {
        Leaf(_) => λ never => false_elim(never),
        Seq(first, rest) => λ c => (match first.calls() as λ b => (first.calls() = b) → (b || rest.calls()).IsTrue() →
            24 <= first.callee_room(rooms).max(rest.callee_room(rooms)) {
            True => λ e _ => Nat::le_trans(24, first.callee_room(rooms), first.callee_room(rooms).max(rest.callee_room(rooms)),
                first.callee_room_calls(rooms, j(sym(e), λ x _ => x.IsTrue(), trivial)), first.callee_room(rooms).le_max_l(rest.callee_room(rooms))),
            False => λ _ later => Nat::le_trans(24, rest.callee_room(rooms), first.callee_room(rooms).max(rest.callee_room(rooms)),
                rest.callee_room_calls(rooms, later), first.callee_room(rooms).le_max_r(rest.callee_room(rooms))),
        })(refl, c),
        Branch(_, yes, no) => λ c => (match yes.calls() as λ b => (yes.calls() = b) → (b || no.calls()).IsTrue() →
            24 <= yes.callee_room(rooms).max(no.callee_room(rooms)) {
            True => λ e _ => Nat::le_trans(24, yes.callee_room(rooms), yes.callee_room(rooms).max(no.callee_room(rooms)),
                yes.callee_room_calls(rooms, j(sym(e), λ x _ => x.IsTrue(), trivial)), yes.callee_room(rooms).le_max_l(no.callee_room(rooms))),
            False => λ _ later => Nat::le_trans(24, no.callee_room(rooms), yes.callee_room(rooms).max(no.callee_room(rooms)),
                no.callee_room_calls(rooms, later), yes.callee_room(rooms).le_max_r(no.callee_room(rooms))),
        })(refl, c),
        Call(callee, _, _) => λ _ => { let x = rooms(callee); let enough: (24 <= x + 24) = { omega }; enough },
        Loop(_, _, inner, _, _, _) => λ c => inner.callee_room_calls(rooms, c),
        Sys(_) => λ never => false_elim(never),
        Exit(_) => λ never => false_elim(never),
    }
}

// The table by depth: each routine's largest frame, and below it its
// callees' rooms at one depth less with a call's 24 bytes.
fn depth_room(routines: List<Routine>, rooms: Nat → Nat, f: Nat) → Nat {
    match routines.nth(f) { None => 0, Some(r) => r.frame(8, 6) + r.body.callee_room(rooms) }
}

fn depth_rooms_at(routines: List<Routine>, p: Nat) → Nat → Nat {
    match p {
        Zero => λ (f: Nat) => depth_room(routines, λ (g: Nat) => 0, f),
        Succ(q) => λ (f: Nat) => depth_room(routines, depth_rooms_at(routines, q), f),
    }
}

fn depth_rooms(routines: List<Routine>) → Nat → Nat → Nat { λ (f: Nat) (p: Nat) => depth_rooms_at(routines, p)(f) }

theorem depth_rooms_unfold(routines: List<Routine>, f, p: Nat):
    depth_rooms(routines)(f, p) = depth_room(routines, rooms_below(depth_rooms(routines), p), f) {
    match p { Zero => refl, Succ(q) => refl }
}

theorem depth_room_nth(routines: List<Routine>, rooms: Nat → Nat, f: Nat, r: Routine, nth: routines.nth(f) = Some(r)):
    depth_room(routines, rooms, f) = r.frame(8, 6) + r.body.callee_room(rooms) {
    j(sym(nth), λ o _ => (match o { None => 0, Some(x) => x.frame(8, 6) + x.body.callee_room(rooms) }) = r.frame(8, 6) + r.body.callee_room(rooms), refl)
}

// The table by depth is lawful, for every program.
theorem depth_rooms_lawful(routines: List<Routine>): RoomLaw(routines, depth_rooms(routines)) {
    λ f r nth p => {
        let rooms = rooms_below(depth_rooms(routines), p);
        let frame = r.frame(8, 6);
        let asks = r.body.callee_room(rooms);
        let own: (depth_rooms(routines)(f, p) = frame + asks) =
            trans(depth_rooms_unfold(routines, f, p), depth_room_nth(routines, rooms, f, r, nth));
        let left: (asks = (frame + asks) - frame) = { omega };
        j(sym(own), λ x _ => r.Roomy(rooms, x, routines.len(), 8, 6),
            ⟨{ omega }, ⟨λ c => { let enough = r.body.callee_room_calls(rooms, c); omega },
                j(left, λ x _ => r.body.Fits(rooms, routines.len(), x), r.body.callee_fits(rooms, routines.len()))⟩⟩)
    }
}

// ---------------------------------------------------------------------------
// A routine's code

// Its answer's words into their registers, refused where the moves lose
// one or touch a register the body keeps; then the frame closed and RET.
fn Routine::closing(self r: Routine, asked, saves, spare: Nat, body: Emitted) → Option<Emitted> {
    match body.file.move_results(r.outs(spare), result_registers()) {
        None => None,
        Some(moves) => match moves.file.outputs_check(r.outs(spare), result_registers()) && leaves_all(moves.code, body_kept(saves)) {
            False => None,
            True => Some(Emitted(At(function_closed(body.prog, moves.code, r.slots(asked), saves), 0, Ret), File::empty(), body.placement, body.names)),
        },
    }
}

fn Routine::emit_body(self r: Routine, asked, saves: Nat, short: List<Nat>, prog: Prog, k, bound, spare: Nat, file: File, placement: List<Place>,
    names: Nat) → Option<Emitted> {
    match r.whole(spare).emit(saves, r.slots(asked), short, bound, spare, function_opened(prog, k, r.loads(), r.slots(asked), saves), file, placement,
        names) {
        None => None,
        Some(body) => r.closing(asked, saves, spare, body),
    }
}

// Routine `k`'s code after `prog`: its label, its frame and saves as its
// placement asks, its body calling any of the program's `bound` routines,
// its answer, RET. Refused where its scope binds an id twice. Its room is
// not emission's to check: the theorem holds under every lawful table
// (`RoomLaw`).
fn Routine::emit_in(self r: Routine, used: List<Nat>, prog: Prog, k, bound: Nat, placement: List<Place>, names: Nat) → Option<Emitted> {
    match input_file(word_ports(typed_ids(r.parameters)), parameter_registers()) {
        None => None,
        Some(file) => r.emit_body(placement_slots(placement), placement_saves(placement), placement_short(placement), prog, k, bound, ids_past(used), file,
            placement_body(placement), names),
    }
}

fn Routine::emit(self r: Routine, prog: Prog, k, bound: Nat, placement: List<Place>, names: Nat) → Option<Emitted> {
    match r.scope() { None => None, Some(used) => r.emit_in(used, prog, k, bound, placement, names) }
}

// ---------------------------------------------------------------------------
// What a routine's run gives its code

record RoutineRan(r: Routine, blocks: Blocks, calls: Calls(), fuel: Nat, args: List<Value>, heap: Heap, io: Io, a: Answer) {
    start: Locals,
    bound: bind_values(r.parameters, args, Locals::empty()) = Some(start),
    after: Config,
    ran: r.body.run(blocks, calls, fuel, Config(start, heap, io)) = Done(after),
    read: read_values(r.results, after.locals) = Some(a.words),
    heaped: a.heap = after.memory,
    world: a.io = after.io,
}

theorem routine_ran(r: Routine, blocks: Blocks, calls: Calls(), fuel: Nat, args: List<Value>, heap: Heap, io: Io, a: Answer,
    ran: r.call(blocks, calls, fuel, args, heap, io) = Done(a)): RoutineRan(r, blocks, calls, fuel, args, heap, io, a) {
    let one = Ran::then_done<Locals, Answer>(Ran::of(bind_values(r.parameters, args, Locals::empty()), io), λ (l: Locals) =>
        r.body.run(blocks, calls, fuel, Config(l, heap, io)).then(λ (after: Config) =>
            Ran::of(read_values(r.results, after.locals), after.io).then(λ (words: List<Value>) => Done(Answer(words, after.memory, after.io)))), a, ran);
    let start = one.witness;
    let two = Ran::then_done<Config, Answer>(r.body.run(blocks, calls, fuel, Config(start, heap, io)), λ (after: Config) =>
        Ran::of(read_values(r.results, after.locals), after.io).then(λ (words: List<Value>) => Done(Answer(words, after.memory, after.io))), a,
        one.proof.right);
    let after = two.witness;
    let three = Ran::then_done<List<Value>, Answer>(Ran::of(read_values(r.results, after.locals), after.io),
        λ (words: List<Value>) => Done(Answer(words, after.memory, after.io)), a, two.proof.right);
    let e: (Answer(three.witness, after.memory, after.io) = a) = Ran::done_inj<Answer>(Answer(three.witness, after.memory, after.io), a, three.proof.right);
    RoutineRan(start := start, bound := Ran::of_done<Locals>(bind_values(r.parameters, args, Locals::empty()), io, start, one.proof.left),
        after := after, ran := two.proof.left,
        read := j(e, λ x _ => read_values(r.results, after.locals) = Some(x.words),
            Ran::of_done<List<Value>>(read_values(r.results, after.locals), after.io, three.witness, three.proof.left)),
        heaped := sym(cong_fn<Answer, Heap>(λ x => x.heap, e)), world := sym(cong_fn<Answer, Io>(λ x => x.io, e)))
}

// A valid routine's checks, taken apart.
record RoutineChecked(r: Routine, sigs: Nat → Option<Signature>) {
    start: List<Typed>,
    params: bind_kinds([], r.parameters) = Some(start),
    end: List<Typed>,
    body: r.body.check(sigs, start) = Some(end),
    answers: has_kinds(end, r.results) = True,
}

theorem routine_checked(r: Routine, sigs: Nat → Option<Signature>, valid: r.valid(sigs) = True): RoutineChecked(r, sigs) {
    (match bind_kinds([], r.parameters) as λ o => bind_kinds([], r.parameters) = o →
        (match o { None => False, Some(start) => match r.body.check(sigs, start) { None => False, Some(after) => has_kinds(after, r.results) } }) = True →
        RoutineChecked(r, sigs) {
        None => λ _ never => absurd(never),
        Some(start) => λ params => (match r.body.check(sigs, start) as λ o => r.body.check(sigs, start) = o →
            (match o { None => False, Some(after) => has_kinds(after, r.results) }) = True → RoutineChecked(r, sigs) {
            None => λ _ never => absurd(never),
            Some(end) => λ body answers => RoutineChecked(start := start, params := params, end := end, body := body, answers := answers),
        })(refl),
    })(refl, valid)
}

// The facts its code is proved under, at the valuation its run determines.
record RoutineFacts(r: Routine, blocks: Blocks, answers: RoutineAnswers(), spans: Spans, spare: Nat, args: List<Value>, heap: Heap, a: Answer) {
    values: Valuation(),
    holds: r.whole(spare).Holds(spans, blocks, values, answers, spare, heap, a.heap),
    passed: lower_values(spans, args) = words_of(values, typed_ids(r.parameters)),
    head: answer_head(lower_values(spans, a.words)) = values(64, call_result(r.results, spare)),
    tail: answer_tail(lower_values(spans, a.words)) = words_of(values, call_also(r.results)),
}

theorem answer_holds(results: List<Typed>, spans: Spans, blocks: Blocks, values: Valuation(), spare: Nat, zero: values(64, spare) = BitVec::zero(),
    heap: Heap): InstrsHold(spans, blocks, values, answer_instrs(results, spare), heap, heap) {
    match results { Nil => Exists(heap, ⟨⟨zero, refl⟩, refl⟩), Cons(_, _) => refl }
}

theorem Routine::facts(self r: Routine, blocks: Blocks, calls: Calls(), fuel: Nat, sigs: Nat → Option<Signature>, spans: Spans, args: List<Value>,
    heap: Heap, io: Io, a: Answer, used: List<Nat>, valid: r.valid(sigs) = True, scope: r.scope() = Some(used),
    peaks: Peaks(), cap: Nat, ran: r.call(blocks, calls, fuel, args, heap, io) = Done(a), peaked: r.peak(blocks, calls, peaks, fuel, args, heap, io) <= cap):
    RoutineFacts(r, blocks, peak_answers(calls, peaks, cap), spans, ids_past(used), args, heap, a) {
    let spare = ids_past(used);
    let absent: (Mem(spare, used) → False) = unlisted_absent(used, spare, unlisted_above(used, spare, spare.le_refl()));
    let run = routine_ran(r, blocks, calls, fuel, args, heap, io, a, ran);
    let checked = routine_checked(r, sigs, valid);
    let fresh = Option::and_then_some(fresh_ids([], typed_ids(r.parameters)), λ (u: List<Nat>) => r.body.fresh(u), used, scope);
    let u0 = fresh.witness;
    let c0 = Config(run.start, heap, io);
    let entered = bind_values_scopes(r.parameters, args, Locals::empty(), run.start, [], u0, [], checked.start, run.bound, fresh.proof.left, checked.params,
        empty_scoped());
    let body = r.body.scopes(blocks, calls, fuel, sigs, checked.start, checked.end, u0, used, c0, run.after, checked.body, fresh.proof.right, run.ran,
        entered.left.left);
    let values = run.after.locals.lower(spans);
    let shows = λ (id: Nat) (_: Mem(id, used)) => run.after.locals.lower_shows(spans, id);
    let zero = spare_zero(run.start, run.after.locals, spans, u0, used, spare, absent, entered.left.right, body.right);
    let body_peaked: (r.body.peak(blocks, calls, peaks, fuel, c0) <= cap) =
        j(run.bound, λ x _ => (match x { None => 0, Some(l) => r.body.peak(blocks, calls, peaks, fuel, Config(l, heap, io)) }) <= cap, peaked);
    let held = r.body.holds_of(blocks, calls, fuel, sigs, spans, values, spare, zero, peaks, cap, checked.start, checked.end, u0, used, c0, run.after,
        checked.body, fresh.proof.right, run.ran, body_peaked, entered.left.left, shows, absent);
    let start_agrees = run.start.agrees_of(spans, values, u0, shows_back(run.start, run.after.locals, spans, values, u0, used, body.right, shows),
        checked.start, entered.left.left.left);
    let end_agrees = run.after.locals.agrees_of(spans, values, used, shows, checked.end, body.left.left);
    let words = read_values_lower(spans, values, run.after.locals, checked.end, end_agrees, r.results, checked.answers, a.words, run.read);
    let lands = lands_words(r.results, spare, values, zero);
    RoutineFacts(values := values,
        holds := Exists(run.after.memory, ⟨held, j(sym(run.heaped), λ h _ => InstrsHold(spans, blocks, values, answer_instrs(r.results, spare),
            run.after.memory, h), answer_holds(r.results, spans, blocks, values, spare, zero, run.after.memory))⟩),
        passed := read_values_lower(spans, values, run.start, checked.start, start_agrees, r.parameters,
            bind_kinds_has(r.parameters, [], checked.start, checked.params), args, entered.right),
        head := trans(cong_fn<List<BitVec(64)>, BitVec(64)>(λ ws => answer_head(ws), words), lands.left),
        tail := trans(cong_fn<List<BitVec(64)>, List<BitVec(64)>>(λ ws => answer_tail(ws), words), lands.right))
}

// ---------------------------------------------------------------------------
// A routine's code meets its contract

theorem or_false_true(b: Bool, set: (b || False).IsTrue()): b.IsTrue() { match b { True => trivial, False => false_elim(set) } }

// The frame and the body: `function_runs_by` at the heap's clause, its
// body's emission `Body::emit_emits`.
theorem routine_runs<M>(r: Routine, spare, asked, saves: Nat, short: List<Nat>, site: Site<M>, laid: site.program.laid_out().IsTrue(),
    stack: Stack<M>(site.fetch, site.data), top: Nat, spans: Spans, loan: Loan<M>(site.fetch, site.data, stack, top, spans), blocks: Blocks,
    lent: blocks.Lent(spans), rooms: Nat → Nat, k, bound, avail: Nat, answers: RoutineAnswers(),
    callees: CalleesReturn<M>(site, stack, spans, rooms, top, bound, answers),
    prog: Prog, file: File, placement: List<Place>, names: Nat, body: Emitted,
    emitted: r.whole(spare).emit(saves, r.slots(asked), short, bound, spare, function_opened(prog, k, r.loads(), r.slots(asked), saves), file, placement,
        names) = Some(body),
    moves: Lowered, keeps: (values: Valuation()) → Keeps<M>(values, body.file, True, moves),
    placed: moves.file.outputs_check(r.outs(spare), result_registers()).IsTrue(), leaves: leaves_all(moves.code, body_kept(saves)).IsTrue(),
    entered: (values: Valuation()) → (g: Gprs) → PortsAt(values, word_ports(typed_ids(r.parameters)), parameter_registers(), g) → file.Represents(values, g),
    few: r.loads() <= 2, shallow: r.body.Fits(rooms, bound, avail), within: function_closed(body.prog, moves.code, r.slots(asked), saves).Within(site.program),
    values: Valuation(), s0: MachineState<M>, d: Nat, rsp: read_gpr(Rsp, s0.gprs) = stack.at(d + r.frame(asked, saves)), room: avail <= d,
    deep: r.body.calls().IsTrue() → 24 <= d, fits: d + r.frame(asked, saves) <= stack.size, under: (d + r.frame(asked, saves)) + 8 <= top,
    before, after: Heap, in_memory: Injected<M>(site.data, spans, before, s0.memory),
    passed: stack.Passes(words_of(values, typed_ids(r.parameters)), argument_registers(), (d + r.frame(asked, saves)) + 8, s0.gprs, s0.memory),
    holds: r.whole(spare).Holds(spans, blocks, values, answers, spare, before, after)):
    site.Moves(stack.writes, prog_len(prog), prog_len(function_closed(body.prog, moves.code, r.slots(asked), saves)),
        λ (x: MachineState<M>) => (x.gprs = s0.gprs) ∧ (x.memory = s0.memory),
        λ (t: MachineState<M>) => stack.ClosedBy(spans, heap_in<M>(site.data, spans), d + r.frame(asked, saves), s0, after,
            values(64, call_result(r.results, spare)), words_of(values, call_also(r.results)), t)) {
    let slots = r.slots(asked);
    let opened = function_opened(prog, k, r.loads(), slots, saves);
    let facts = r.whole(spare).Holds(spans, blocks, values, answers, spare, before, after);
    let unfold: (r.frame(asked, saves) = 8 * (slots + function_saves(saves).len())) = refl;
    let fits_body: (d + 8 * slots <= stack.size) = { omega };
    let under_slots: ((d + 8 * slots) + 8 <= top) = { omega };
    function_runs_by<M, Heap>(slots, saves, r.slots_few(asked), site, laid, stack, top, spans, heap_in<M>(site.data, spans), loan,
        heap_in_stable<M>(stack, top, spans, loan), k, prog, file, typed_ids(r.parameters), call_result(r.results, spare), call_also(r.results), body, facts,
        values, d, before, after,
        λ x1 rsp_x1 => r.whole(spare).emit(saves, slots, short, bound, spare, opened, file, placement, names).all_some(
            λ (e: Emitted) => EmitsHeap<M>(saves, site, stack, spans, values, d + 8 * slots, x1, opened, file, facts, before, after, e), body, emitted,
            r.whole(spare).emit_emits<M>(saves, slots, site, laid, stack, top, spans, loan, blocks, lent, rooms, bound, avail, answers, callees, values, spare, d,
                d + 8 * slots, x1, λ c => ⟨rsp_x1, ⟨room, ⟨deep(or_false_true(r.body.calls(), c)), ⟨refl, ⟨fits_body, under_slots⟩⟩⟩⟩⟩, short,
                ⟨shallow, trivial⟩, opened, file, placement, names, before, after)),
        moves, keeps(values), placed, leaves, entered(values), few, within, s0, rsp, fits, under, in_memory, passed, holds)
}

// What the code's close leaves, after the RET: the stack pointer at the
// return address, still in place, and the answer as the contract says.
theorem routine_closes<M>(site: Site<M>, stack: Stack<M>(site.fetch, site.data), top: Nat, spans: Spans,
    loan: Loan<M>(site.fetch, site.data, stack, top, spans), a: Answer, values: Valuation(), result: Nat, also: List<Nat>, s0, t: MachineState<M>,
    d, size, i: Nat, ret: BitVec(64), back: d + size = i, under: (d + size) + 8 <= top,
    saved: read_word(site.data, s0.memory, stack.at(i)) = Some(ret),
    head: answer_head(lower_values(spans, a.words)) = values(64, result), tail: answer_tail(lower_values(spans, a.words)) = words_of(values, also),
    done: stack.ClosedBy(spans, heap_in<M>(site.data, spans), d + size, s0, a.heap, values(64, result), words_of(values, also), t)):
    (read_gpr(Rsp, t.gprs) = stack.at(i)) ∧ ((read_word(site.data, t.memory, stack.at(i)) = Some(ret)) ∧
        RoutinePost<M>(site, stack, spans, a)(i, s0, return_near_after(ret, t))) {
    let popped = read_gpr(Rsp, t.gprs).add(BitVec::ofNat(8));
    let trail: stack.TrailBy(spans, heap_in<M>(site.data, spans), d + size, s0.memory, a.heap, t.memory) = done.right.right.right;
    let at_back: (stack.at(d + size) = stack.at(i)) = cong_fn<Nat, BitVec(64)>(λ n => stack.at(n), back);
    let unchanged_top: (read_word(site.data, t.memory, stack.at(d + size)) = read_word(site.data, s0.memory, stack.at(d + size))) =
        loan.unchanged(d + size, s0.memory, t.memory, trail.left)(d + size, (d + size).le_refl(), under);
    ⟨trans(done.right.right.left, at_back),
     ⟨trans(j(back, λ n _ => read_word(site.data, t.memory, stack.at(n)) = read_word(site.data, s0.memory, stack.at(n)), unchanged_top), saved),
      ⟨⟨trans(done.left.left, sym(head)),
        args_after_write(answer_tail(lower_values(spans, a.words)), answer_registers(), t.gprs, Rsp, popped, trivial,
            j(sym(tail), λ ws _ => ArgsIn(ws, answer_registers(), t.gprs), done.left.right))⟩,
       ⟨kept_trans(callee_kept(), s0.gprs, t.gprs, write_gpr(Rsp, popped, t.gprs), done.right.left, kept_past_rsp(t.gprs, popped)),
        ⟨j(back, λ n _ => stack.WroteIn(n, spans, s0.memory, t.memory), trail.left), trail.right⟩⟩⟩⟩⟩
}

// Routine `k` entered at stack offset `i` as its contract says, at the
// facts a run answering `a` determines: from its label to its RET, the
// stack pointer back at its return address, which its stores and the
// lending's left in place, and its answer as the contract's post says
// after the RET.
theorem routine_body<M>(r: Routine, spare, asked, saves: Nat, short: List<Nat>, site: Site<M>, laid: site.program.laid_out().IsTrue(),
    stack: Stack<M>(site.fetch, site.data), top: Nat, spans: Spans, loan: Loan<M>(site.fetch, site.data, stack, top, spans), blocks: Blocks,
    lent: blocks.Lent(spans), rooms, own: Nat → Nat, k, bound: Nat, roomy: r.Roomy(rooms, own(k), bound, asked, saves), prog: Prog, file: File,
    placement: List<Place>, names: Nat, body: Emitted,
    emitted: r.whole(spare).emit(saves, r.slots(asked), short, bound, spare, function_opened(prog, k, r.loads(), r.slots(asked), saves), file, placement,
        names) = Some(body),
    moves: Lowered, keeps: (values: Valuation()) → Keeps<M>(values, body.file, True, moves),
    placed: moves.file.outputs_check(r.outs(spare), result_registers()).IsTrue(), leaves: leaves_all(moves.code, body_kept(saves)).IsTrue(),
    entered: (values: Valuation()) → (g: Gprs) → PortsAt(values, word_ports(typed_ids(r.parameters)), parameter_registers(), g) → file.Represents(values, g),
    few: r.loads() <= 2, within: function_closed(body.prog, moves.code, r.slots(asked), saves).Within(site.program),
    answers: RoutineAnswers(), callees: CalleesReturn<M>(site, stack, spans, rooms, top, bound, answers), args: List<Value>, heap: Heap, a: Answer,
    facts: RoutineFacts(r, blocks, answers, spans, spare, args, heap, a), s0: MachineState<M>, i: Nat, ret: BitVec(64)):
    site.Moves(stack.writes, prog_len(prog), prog_len(function_closed(body.prog, moves.code, r.slots(asked), saves)),
        λ (s: MachineState<M>) => (s = s0) ∧ ((read_gpr(Rsp, s0.gprs) = stack.at(i)) ∧ ((i + 8 <= stack.size) ∧
            (RoutinePre<M>(site, stack, spans, own, top, k, args, heap)(i, s0) ∧ read_word(site.data, s0.memory, stack.at(i)) = Some(ret)))),
        λ (t: MachineState<M>) => (read_gpr(Rsp, t.gprs) = stack.at(i)) ∧ ((read_word(site.data, t.memory, stack.at(i)) = Some(ret)) ∧
            RoutinePost<M>(site, stack, spans, a)(i, s0, return_near_after(ret, t)))) {
    λ s here resident held => {
        let pre = held.right.right.right.left;
        let size = r.frame(asked, saves);
        let d = i - size;
        let entry: (own(k) <= i) = pre.left.right;
        let back: (d + size = i) = Nat::sub_add_cancel(size, i, Nat::le_trans(size, own(k), i, roomy.left, entry));
        let inside: (i + 8 <= stack.size) = held.right.right.left;
        let below: (i + 8 <= top) = pre.right.left;
        let room: (own(k) - size <= d) = { omega };
        let fits: (d + size <= stack.size) = { omega };
        let under: ((d + size) + 8 <= top) = { omega };
        let at_back: (stack.at(d + size) = stack.at(i)) = cong_fn<Nat, BitVec(64)>(λ n => stack.at(n), back);
        let above: (i + 8 = (d + size) + 8) = { omega };
        let ran_code = routine_runs<M>(r, spare, asked, saves, short, site, laid, stack, top, spans, loan, blocks, lent, rooms, k, bound, own(k) - size,
            answers, callees, prog, file, placement, names, body, emitted, moves, keeps, placed, leaves, entered, few, roomy.right.right, within,
            facts.values, s0, d, trans(held.right.left, sym(at_back)), room, λ c => { let enough = roomy.right.left(c); omega }, fits, under, heap, a.heap,
            pre.right.right,
            j(facts.passed, λ w _ => stack.Passes(w, argument_registers(), (d + size) + 8, s0.gprs, s0.memory),
                j(above, λ n _ => stack.Passes(lower_values(spans, args), argument_registers(), n, s0.gprs, s0.memory), pre.left.left)),
            facts.holds);
        let got = ran_code(s, here, resident, ⟨cong_fn<MachineState<M>, Gprs>(λ x => x.gprs, held.left), cong_fn<MachineState<M>, M>(λ x => x.memory, held.left)⟩);
        Exists(got.witness, ⟨got.proof.left, ⟨got.proof.right.left, ⟨got.proof.right.right.left,
            routine_closes<M>(site, stack, top, spans, loan, a, facts.values, call_result(r.results, spare), call_also(r.results), s0, got.witness, d, size, i,
                ret, back, under, held.right.right.right.right, facts.head, facts.tail, got.proof.right.right.right)⟩⟩⟩)
    }
}

// What routine `k`'s code meets at its entry: on every run of it that
// answers, at a depth its chain of calls stays within, with the routines it
// calls meeting theirs one depth below on the runs the answer's calls made,
// it returns that answer.
fn RoutineAt<M>(site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, room: Nat → Nat → Nat, top: Nat, blocks: Blocks, bound, k: Nat,
    r: Routine, entry: Nat) → Type {
    (calls: Calls()) → (peaks: Peaks()) → (fuel: Nat) → (cap: Nat) →
        CalleesReturn<M>(site, stack, spans, rooms_below(room, cap), top, bound, peak_answers(calls, peaks, cap)) → (args: List<Value>) → (heap: Heap) →
        (io: Io) → (a: Answer) → r.call(blocks, calls, fuel, args, heap, io) = Done(a) → r.peak(blocks, calls, peaks, fuel, args, heap, io) <= cap →
        site.Returns(stack, entry, RoutinePre<M>(site, stack, spans, λ (g: Nat) => room(g, cap), top, k, args, heap), RoutinePost<M>(site, stack, spans, a))
}

theorem routine_returns<M>(r: Routine, sigs: Nat → Option<Signature>, used: List<Nat>, valid: r.valid(sigs) = True, scope: r.scope() = Some(used),
    asked, saves: Nat, short: List<Nat>, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), top: Nat,
    spans: Spans, loan: Loan<M>(site.fetch, site.data, stack, top, spans), blocks: Blocks, lent: blocks.Lent(spans), room: Nat → Nat → Nat, k, bound: Nat,
    roomy: (cap: Nat) → r.Roomy(rooms_below(room, cap), room(k, cap), bound, asked, saves), prog: Prog, file: File, placement: List<Place>, names: Nat,
    body: Emitted,
    emitted: r.whole(ids_past(used)).emit(saves, r.slots(asked), short, bound, ids_past(used), function_opened(prog, k, r.loads(), r.slots(asked), saves), file,
        placement, names) = Some(body),
    moves: Lowered, keeps: (values: Valuation()) → Keeps<M>(values, body.file, True, moves),
    placed: moves.file.outputs_check(r.outs(ids_past(used)), result_registers()).IsTrue(), leaves: leaves_all(moves.code, body_kept(saves)).IsTrue(),
    entered: (values: Valuation()) → (g: Gprs) → PortsAt(values, word_ports(typed_ids(r.parameters)), parameter_registers(), g) → file.Represents(values, g),
    few: r.loads() <= 2, within: At(function_closed(body.prog, moves.code, r.slots(asked), saves), 0, Ret).Within(site.program)):
    RoutineAt<M>(site, stack, spans, room, top, blocks, bound, k, r, prog_len(prog)) {
    let closed = function_closed(body.prog, moves.code, r.slots(asked), saves);
    λ calls peaks fuel cap callees args heap io a ran peaked => site.returns_by(stack, site.program.laid_out_fits(laid), prog_len(prog), within.witness,
        closed, 0, within.proof, RoutinePre<M>(site, stack, spans, λ (g: Nat) => room(g, cap), top, k, args, heap), RoutinePost<M>(site, stack, spans, a),
        λ s0 i ret => routine_body<M>(r, ids_past(used), asked, saves, short, site, laid, stack, top, spans, loan, blocks, lent, rooms_below(room, cap),
            λ (g: Nat) => room(g, cap), k, bound, roomy(cap), prog, file, placement, names, body, emitted, moves, keeps, placed, leaves, entered, few,
            closed.within_before(0, Ret, site.program, within), peak_answers(calls, peaks, cap), callees, args, heap, a,
            r.facts(blocks, calls, fuel, sigs, spans, args, heap, io, a, used, valid, scope, peaks, cap, ran, peaked), s0, i, ret))
}

// What is read off a value and then done is never going.
theorem Ran::done_not_going<T, U>(x: Option<T>, io: Io, k: T → U, w: Io, going: Ran::of(x, io).then(λ (v: T) => Done(k(v))) = Going(w)): False {
    match Ran::then_going<T, U>(Ran::of(x, io), λ (v: T) => Done(k(v)), w, going) {
        Inl(never) => Ran::of_going<T>(x, io, w, never),
        Inr(done) => absurd(done.proof.right),
    }
}

// A routine's run still going: the locals its parameters bind, and its body
// going from them.
theorem routine_stopped(r: Routine, blocks: Blocks, calls: Calls(), fuel: Nat, args: List<Value>, heap: Heap, io: Io, x: Stop,
    ran: r.call(blocks, calls, fuel, args, heap, io).stopped() = Some(x)):
    Exists<Locals>(λ start => (bind_values(r.parameters, args, Locals::empty()) = Some(start)) ∧
        (r.body.run(blocks, calls, fuel, Config(start, heap, io)).stopped() = Some(x))) {
    match Ran::then_stopped<Locals, Answer>(Ran::of(bind_values(r.parameters, args, Locals::empty()), io), λ (l: Locals) =>
        r.body.run(blocks, calls, fuel, Config(l, heap, io)).then(λ (after: Config) =>
            Ran::of(read_values(r.results, after.locals), after.io).then(λ (words: List<Value>) => Done(Answer(words, after.memory, after.io)))), x, ran) {
        Inl(never) => false_elim(Ran::of_stopped<Locals>(bind_values(r.parameters, args, Locals::empty()), io, x, never)),
        Inr(bound) => match Ran::then_stopped<Config, Answer>(r.body.run(blocks, calls, fuel, Config(bound.witness, heap, io)), λ (after: Config) =>
            Ran::of(read_values(r.results, after.locals), after.io).then(λ (words: List<Value>) => Done(Answer(words, after.memory, after.io))), x,
            bound.proof.right) {
            Inl(going) => Exists(bound.witness, ⟨Ran::of_done<Locals>(bind_values(r.parameters, args, Locals::empty()), io, bound.witness, bound.proof.left),
                going⟩),
            Inr(done) => false_elim(Ran::done_not_stopped<List<Value>, Answer>(read_values(r.results, done.witness.locals), done.witness.io,
                λ (words: List<Value>) => Answer(words, done.witness.memory, done.witness.io), x, done.proof.right)),
        },
    }
}

// The going facts its code is proved under, at the valuation its locals
// show where its body went on.
theorem Routine::stops_facts(self r: Routine, blocks: Blocks, calls: Calls(), fuel: Nat, sigs: Nat → Option<Signature>, spans: Spans, args: List<Value>,
    heap: Heap, io: Io, x: Stop, used: List<Nat>, valid: r.valid(sigs) = True, scope: r.scope() = Some(used), peaks: Peaks(), cap: Nat,
    ran: r.call(blocks, calls, fuel, args, heap, io).stopped() = Some(x), peaked: r.peak(blocks, calls, peaks, fuel, args, heap, io) <= cap):
    Exists<Valuation()>(λ v => (lower_values(spans, args) = words_of(v, typed_ids(r.parameters))) ∧
        r.whole(ids_past(used)).Stops(spans, blocks, v, peak_answers(calls, peaks, cap), peak_stops(x, calls, peaks, cap), x, ids_past(used), fuel, heap)) {
    let spare = ids_past(used);
    let absent: (Mem(spare, used) → False) = unlisted_absent(used, spare, unlisted_above(used, spare, spare.le_refl()));
    let going = routine_stopped(r, blocks, calls, fuel, args, heap, io, x, ran);
    let start = going.witness;
    let checked = routine_checked(r, sigs, valid);
    let fresh = Option::and_then_some(fresh_ids([], typed_ids(r.parameters)), λ (u: List<Nat>) => r.body.fresh(u), used, scope);
    let u0 = fresh.witness;
    let entered = bind_values_scopes(r.parameters, args, Locals::empty(), start, [], u0, [], checked.start, going.proof.left, fresh.proof.left,
        checked.params, empty_scoped());
    let body_peaked: (r.body.peak(blocks, calls, peaks, fuel, Config(start, heap, io)) <= cap) =
        j(going.proof.left, λ x _ => (match x { None => 0, Some(l) => r.body.peak(blocks, calls, peaks, fuel, Config(l, heap, io)) }) <= cap, peaked);
    let got = r.body.stops_of(blocks, calls, fuel, sigs, spans, spare, peaks, cap, checked.start, checked.end, u0, used, Config(start, heap, io), x,
        checked.body, fresh.proof.right, going.proof.right, body_peaked, entered.left.left, entered.left.right, absent);
    let v = got.witness;
    let start_agrees = start.agrees_of(spans, v, u0, got.proof.left, checked.start, entered.left.left.left);
    Exists(v, ⟨read_values_lower(spans, v, start, checked.start, start_agrees, r.parameters, bind_kinds_has(r.parameters, [], checked.start, checked.params),
        args, entered.right), Inl(got.proof.right.right)⟩)
}

// Routine `k` entered as its contract says, its run still going at the
// facts it went on at: from its label, at least the run's fuel in machine
// steps, at no system call (the entry's loads and frame, then the body's
// code going, `Body::emit_stops`).
theorem routine_stops<M>(x: Stop, r: Routine, spare, asked, saves: Nat, short: List<Nat>, site: Site<M>, laid: site.program.laid_out().IsTrue(),
    stack: Stack<M>(site.fetch, site.data), top: Nat, spans: Spans, loan: Loan<M>(site.fetch, site.data, stack, top, spans), blocks: Blocks,
    lent: blocks.Lent(spans), rooms, own: Nat → Nat, k, bound: Nat, roomy: r.Roomy(rooms, own(k), bound, asked, saves), prog: Prog, file: File,
    placement: List<Place>, names: Nat, body: Emitted,
    emitted: r.whole(spare).emit(saves, r.slots(asked), short, bound, spare, function_opened(prog, k, r.loads(), r.slots(asked), saves), file, placement,
        names) = Some(body),
    grew: function_opened(prog, k, r.loads(), r.slots(asked), saves).Within(body.prog), moves: Lowered,
    entered: (values: Valuation()) → (g: Gprs) → PortsAt(values, word_ports(typed_ids(r.parameters)), parameter_registers(), g) → file.Represents(values, g),
    few: r.loads() <= 2, within: function_closed(body.prog, moves.code, r.slots(asked), saves).Within(site.program),
    answers: RoutineAnswers(), callees: CalleesReturn<M>(site, stack, spans, rooms, top, bound, answers), goes: RoutineStops(), least: Nat,
    callees_stop: CalleesStop<M>(x, site, stack, spans, rooms, top, bound, goes, least), fuel: Nat, covered: x.least(fuel) <= 1 + least, args: List<Value>, heap: Heap,
    values: Valuation(), passed: lower_values(spans, args) = words_of(values, typed_ids(r.parameters)),
    going: r.whole(spare).Stops(spans, blocks, values, answers, goes, x, spare, fuel, heap)):
    site.EntersClaim(stack, Kernel::none<M, True>(), 0, x.least(fuel), prog_len(prog),
        λ (i: Nat) (s: Running<M, True>) => RoutinePre<M>(site, stack, spans, own, top, k, args, heap)(i, s.state) ∧ True,
        λ (_: Nat) (_: Running<M, True>) (_: BitVec(64)) (t: Running<M, True>) => x.Reached(site, stack)(t)) {
    let slots = r.slots(asked);
    let size = r.frame(asked, saves);
    let opened = function_opened(prog, k, r.loads(), slots, saves);
    let returned = At(body.prog, 0, Block(moves.code));
    let restored = function_saves(saves).reloads(returned, slots);
    let restored_in = restored.within_before(0, Block(frame_closing(frame_size(slots, saves))), site.program, within);
    let returned_in = Prog::within_trans(Prog::within_reloads(function_saves(saves), returned, slots), restored_in);
    let body_in = body.prog.within_before(0, Block(moves.code), site.program, returned_in);
    let facts = r.whole(spare).Stops(spans, blocks, values, answers, goes, x, spare, fuel, heap);
    λ s here resident i rsp inside held ret saved => {
        let pre = held.left;
        let d = i - size;
        let entry: (own(k) <= i) = pre.left.right;
        let back: (d + size = i) = Nat::sub_add_cancel(size, i, Nat::le_trans(size, own(k), i, roomy.left, entry));
        let below: (i + 8 <= top) = pre.right.left;
        let room: (own(k) - size <= d) = { omega };
        let fits: (d + size <= stack.size) = { omega };
        let under: (d + size <= top) = { omega };
        let unfold: (size = 8 * (slots + function_saves(saves).len())) = refl;
        let fits_body: (d + 8 * slots <= stack.size) = { omega };
        let under_slots: ((d + 8 * slots) + 8 <= top) = { omega };
        let at_back: (stack.at(d + size) = stack.at(i)) = cong_fn<Nat, BitVec(64)>(λ n => stack.at(n), back);
        let above: (i + 8 = (d + size) + 8) = { omega };
        let deep: (r.body.calls().IsTrue() → 24 <= d) = λ c => { let enough = roomy.right.left(c); omega };
        let body_claims = λ (x1: MachineState<M>) (rsp_x1: read_gpr(Rsp, x1.gprs) = stack.at(d)) =>
            r.whole(spare).emit(saves, slots, short, bound, spare, opened, file, placement, names).all_some(
                λ (e: Emitted) => StopsHeap<M>(x, saves, site, stack, spans, values, d + 8 * slots, x1, opened, file, facts, heap, x.least(fuel), e), body, emitted,
                r.whole(spare).emit_stops<M>(x, saves, slots, site, laid, stack, top, spans, loan, blocks, lent, rooms, bound, own(k) - size, answers, callees,
                    goes, least, callees_stop, fuel, covered, values, spare, d, d + 8 * slots, x1,
                    λ c => ⟨rsp_x1, ⟨room, ⟨deep(or_false_true(r.body.calls(), c)), ⟨refl, ⟨fits_body, under_slots⟩⟩⟩⟩⟩, short,
                    ⟨roomy.right.right, trivial⟩, opened, file, placement, names, fuel, fuel.le_refl(), heap)).right(body_in);
        function_enters_claim<M, Heap, True>(slots, saves, r.slots_few(asked), site, laid, stack, top, spans, heap_in<M>(site.data, spans),
            λ (_: Heap) (_: True) => True, Kernel::none<M, True>(), 0, x.least(fuel), heap_in_stable<M>(stack, top, spans, loan), k, prog, file,
            typed_ids(r.parameters), facts, values, d, heap, x.Reached(site, stack), body_claims, Prog::within_trans(grew, body_in),
            entered(values), few, s.state, trans(rsp, sym(at_back)), fits, under, pre.right.right,
            j(passed, λ w _ => stack.Passes(w, argument_registers(), (d + size) + 8, s.state.gprs, s.state.memory),
                j(above, λ n _ => stack.Passes(lower_values(spans, args), argument_registers(), n, s.state.gprs, s.state.memory), pre.left.left)),
            going)(s, here, resident, ⟨⟨refl, refl⟩, trivial⟩)
    }
}

// What routine `k`'s code does at its entry on every run of it still
// going, its callees returning and going on as theirs say: at least the
// run's fuel in machine steps, at no system call.
fn RoutineStopsAt<M>(site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, room: Nat → Nat → Nat, top: Nat, blocks: Blocks, bound, k: Nat,
    r: Routine, entry: Nat) → Type {
    (calls: Calls()) → (peaks: Peaks()) → (fuel: Nat) → (cap: Nat) →
        CalleesReturn<M>(site, stack, spans, rooms_below(room, cap), top, bound, peak_answers(calls, peaks, cap)) → (x: Stop) → (least: Nat) →
        CalleesStop<M>(x, site, stack, spans, rooms_below(room, cap), top, bound, peak_stops(x, calls, peaks, cap), least) → x.least(fuel) <= 1 + least →
        (args: List<Value>) → (heap: Heap) → (io: Io) → r.call(blocks, calls, fuel, args, heap, io).stopped() = Some(x) →
        r.peak(blocks, calls, peaks, fuel, args, heap, io) <= cap →
        site.EntersClaim(stack, Kernel::none<M, True>(), 0, x.least(fuel), entry,
            λ (i: Nat) (s: Running<M, True>) => RoutinePre<M>(site, stack, spans, λ (g: Nat) => room(g, cap), top, k, args, heap)(i, s.state) ∧ True,
            λ (_: Nat) (_: Running<M, True>) (_: BitVec(64)) (t: Running<M, True>) => x.Reached(site, stack)(t))
}

theorem routine_stops_at<M>(r: Routine, sigs: Nat → Option<Signature>, used: List<Nat>, valid: r.valid(sigs) = True, scope: r.scope() = Some(used),
    asked, saves: Nat, short: List<Nat>, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), top: Nat,
    spans: Spans, loan: Loan<M>(site.fetch, site.data, stack, top, spans), blocks: Blocks, lent: blocks.Lent(spans), room: Nat → Nat → Nat, k, bound: Nat,
    roomy: (cap: Nat) → r.Roomy(rooms_below(room, cap), room(k, cap), bound, asked, saves), prog: Prog, file: File, placement: List<Place>, names: Nat,
    body: Emitted,
    emitted: r.whole(ids_past(used)).emit(saves, r.slots(asked), short, bound, ids_past(used), function_opened(prog, k, r.loads(), r.slots(asked), saves),
        file, placement, names) = Some(body),
    grew: function_opened(prog, k, r.loads(), r.slots(asked), saves).Within(body.prog), moves: Lowered,
    entered: (values: Valuation()) → (g: Gprs) → PortsAt(values, word_ports(typed_ids(r.parameters)), parameter_registers(), g) → file.Represents(values, g),
    few: r.loads() <= 2, within: At(function_closed(body.prog, moves.code, r.slots(asked), saves), 0, Ret).Within(site.program)):
    RoutineStopsAt<M>(site, stack, spans, room, top, blocks, bound, k, r, prog_len(prog)) {
    let closed = function_closed(body.prog, moves.code, r.slots(asked), saves);
    λ calls peaks fuel cap callees x least callees_stop covered args heap io ran peaked => {
        let got = r.stops_facts(blocks, calls, fuel, sigs, spans, args, heap, io, x, used, valid, scope, peaks, cap, ran, peaked);
        routine_stops<M>(x, r, ids_past(used), asked, saves, short, site, laid, stack, top, spans, loan, blocks, lent, rooms_below(room, cap),
            λ (g: Nat) => room(g, cap), k, bound, roomy(cap), prog, file, placement, names, body, emitted, grew, moves, entered, few,
            closed.within_before(0, Ret, site.program, within), peak_answers(calls, peaks, cap), callees, peak_stops(x, calls, peaks, cap), least, callees_stop,
            fuel, covered, args, heap, got.witness, got.proof.left, got.proof.right)
    }
}

// ---------------------------------------------------------------------------
// A region's code holds the code before it

theorem emit_load_grows(prog: Prog, file: File, output, place: Nat, destination, base: Gpr, bytes: Nat, later: List<Place>, names: Nat):
    Grows(prog, emit_load(prog, file, output, place, destination, base, bytes, later, names)) {
    match bytes.same(1) {
        True => prog.within_then(0, LoadByte(ByteLoad(destination, base))),
        False => match bytes.same(4) {
            True => prog.within_then(0, asm_dword_load(DwordLoad(destination, base))),
            False => match bytes.same(8) { True => prog.within_then(0, Load(WordLoad(destination, base))), False => trivial },
        },
    }
}

theorem emit_store_grows(prog: Prog, file: File, base, source: Gpr, bytes: Nat, later: List<Place>, names: Nat):
    Grows(prog, emit_store(prog, file, base, source, bytes, later, names)) {
    match store_base_plain(base) {
        False => trivial,
        True => match bytes.same(1) {
            True => prog.within_then(0, StoreByte(ByteStore(base, source))),
            False => match bytes.same(4) {
                True => prog.within_then(0, asm_dword_store(DwordStore(base, source))),
                False => match bytes.same(8) { True => prog.within_then(0, asm_word_store(WordStore(base, source))), False => trivial },
            },
        },
    }
}

theorem emit_word_nodes_grows(saves: Nat, prog: Prog, file: File, nodes: List<Node>, placement: List<Place>, names: Nat):
    Grows(prog, emit_word_nodes(saves, prog, file, nodes, placement, names)) {
    match lower_nodes(nodes, placement, file) {
        None => trivial,
        Some(lowered) => match leaves_all(lowered.code, body_kept(saves)) { False => trivial, True => prog.within_then(0, Asm::of_code(lowered.code)) },
    }
}

theorem Instr::emit_grows(self instr: Instr, saves: Nat, prog: Prog, file: File, placement: List<Place>, names: Nat):
    Grows(prog, instr.emit(saves, prog, file, placement, names)) {
    match instr {
        Compute(node) => emit_word_nodes_grows(saves, prog, file, [node], placement, names),
        Load(bytes, output, place) => match placement {
            Nil => trivial,
            Cons(p, later) => match p.destination(saves) {
                None => trivial,
                Some(destination) => match file.find(Held(place, Word)) {
                    None => trivial,
                    Some(found) => emit_load_grows(prog, file, output, place, destination, found.register, bytes, later, names),
                },
            },
        },
        Store(bytes, place, value) => match placement {
            Nil => trivial,
            Cons(skipped, later) => match file.find(Held(place, Word)) {
                None => trivial,
                Some(base) => match file.find(Held(value, Word)) {
                    None => trivial,
                    Some(source) => emit_store_grows(prog, file, base.register, source.register, bytes, later, names),
                },
            },
        },
        LoadRef(output, place) => match placement {
            Nil => trivial,
            Cons(p, later) => match p.destination(saves) {
                None => trivial,
                Some(destination) => match file.find(Held(place, Word)) {
                    None => trivial,
                    Some(found) => prog.within_then(0, Load(WordLoad(destination, found.register))),
                },
            },
        },
        StoreRef(place, value) => match placement {
            Nil => trivial,
            Cons(skipped, later) => match file.find(Held(place, Word)) {
                None => trivial,
                Some(base) => match file.find(Held(value, Word)) {
                    None => trivial,
                    Some(source) => match store_base_plain(base.register) {
                        False => trivial,
                        True => prog.within_then(0, asm_word_store(WordStore(base.register, source.register))),
                    },
                },
            },
        },
        Offset(output, place, amount) => emit_word_nodes_grows(saves, prog, file, [Add(64, output, place, amount)], placement, names),
        Copy(_, _, _) => trivial,
    }
}

theorem emit_instrs_grows(saves: Nat, instrs: List<Instr>): (prog: Prog) → (file: File) → (placement: List<Place>) → (names: Nat) →
    Grows(prog, emit_instrs(saves, prog, file, instrs, placement, names)) {
    match instrs {
        Nil => λ prog file placement names => prog.within_self(),
        Cons(instr, rest) => λ prog file placement names =>
            (match instr.emit(saves, prog, file, placement, names) as λ e => Grows(prog, e) → Grows(prog, match e {
                None => None,
                Some(first) => emit_instrs(saves, first.prog, first.file, rest, first.placement, first.names),
            }) {
                None => λ _ => trivial,
                Some(first) => λ grown => grows_trans(prog, first, grown, emit_instrs(saves, first.prog, first.file, rest, first.placement, first.names),
                    emit_instrs_grows(saves, rest, first.prog, first.file, first.placement, first.names)),
            })(instr.emit_grows(saves, prog, file, placement, names)),
    }
}

theorem plain_close_grows(pass: Emitted, saves: Nat, registers: List<Gpr>, exit: Nat, next, outputs: List<Nat>, names: Nat, short: List<Nat>, start: Prog,
    grown: start.Within(pass.prog)): Grows(start, pass.plain_close(saves, registers, exit, next, outputs, names, short)) {
    match pass.file.branch_test(exit) as λ t => Grows(start, match t {
            None => None,
            Some(tested) => match pass.file.move_outputs(word_ports(next), registers) {
                None => None,
                Some(moves) => match moves.file.outputs_check(word_ports(next), registers) && leaves_all(moves.code, body_kept(saves)) {
                    False => None,
                    True => match input_file(word_ports(outputs), registers) {
                        None => None,
                        Some(out) => Some(Emitted(plain_done(pass.prog, tested.test, moves.code, names, short), out, pass.placement, pass.names)),
                    },
                },
            },
        }) {
        None => trivial,
        Some(tested) => match pass.file.move_outputs(word_ports(next), registers) {
            None => trivial,
            Some(moves) => match moves.file.outputs_check(word_ports(next), registers) && leaves_all(moves.code, body_kept(saves)) {
                False => trivial,
                True => match input_file(word_ports(outputs), registers) {
                    None => trivial,
                    Some(out) => {
                        let closed: pass.prog.Within(plain_done(pass.prog, tested.test, moves.code, names, short)) = Exists(8, refl);
                        Prog::within_trans(grown, closed)
                    },
                },
            },
        },
    }
}

theorem Body::emit_grows(self body: Body, saves, slots: Nat, short: List<Nat>, bound, spare: Nat): (prog: Prog) → (file: File) →
    (placement: List<Place>) → (names: Nat) → Grows(prog, body.emit(saves, slots, short, bound, spare, prog, file, placement, names)) {
    match body {
        Leaf(instrs) => λ prog file placement names => emit_instrs_grows(saves, instrs, prog, file, placement, names),
        Seq(first, rest) => λ prog file placement names =>
            (match first.emit(saves, slots, short, bound, spare, prog, file, placement, names) as λ e => Grows(prog, e) → Grows(prog, match e {
                None => None,
                Some(done) => rest.emit(saves, slots, short, bound, spare, done.prog, done.file, done.placement, done.names),
            }) {
                None => λ _ => trivial,
                Some(done) => λ grown => grows_trans(prog, done, grown, rest.emit(saves, slots, short, bound, spare, done.prog, done.file, done.placement,
                    done.names), rest.emit_grows(saves, slots, short, bound, spare, done.prog, done.file, done.placement, done.names)),
            })(first.emit_grows(saves, slots, short, bound, spare, prog, file, placement, names)),
        Branch(condition, yes, no) => λ prog file placement names =>
            match file.branch_test(condition) as λ t => Grows(prog, match t {
                    None => None,
                    Some(tested) => match yes.emit(saves, slots, short, bound, spare, prog.branched_by(tested.test, names + 1, shorts(short, names + 1)),
                        file.know(Truth(condition)), placement, names + 2) {
                        None => None,
                        Some(left) => match no.emit(saves, slots, short, bound, spare, left.prog.else_label_by(names + 1, names + 2, shorts(short, names + 2)),
                            file.know(Falsity(condition)), left.placement, left.names) {
                            None => None,
                            Some(right) => Some(Emitted(right.prog.join_label(names + 2), left.file.meet(right.file, file.known), right.placement, right.names)),
                        },
                    },
                }) {
                None => trivial,
                Some(tested) => {
                    let test = tested.test;
                    let branched = prog.branched_by(test, names + 1, shorts(short, names + 1));
                    (match yes.emit(saves, slots, short, bound, spare, branched, file.know(Truth(condition)), placement, names + 2) as λ y =>
                        Grows(branched, y) → Grows(prog, match y {
                            None => None,
                            Some(left) => match no.emit(saves, slots, short, bound, spare, left.prog.else_label_by(names + 1, names + 2, shorts(short, names + 2)),
                                file.know(Falsity(condition)), left.placement, left.names) {
                                None => None,
                                Some(right) => Some(Emitted(right.prog.join_label(names + 2), left.file.meet(right.file, file.known), right.placement,
                                    right.names)),
                            },
                        }) {
                        None => λ _ => trivial,
                        Some(left) => λ yes_grown => {
                            let second = left.prog.else_label_by(names + 1, names + 2, shorts(short, names + 2));
                            (match no.emit(saves, slots, short, bound, spare, second, file.know(Falsity(condition)), left.placement, left.names) as λ n =>
                                Grows(second, n) → Grows(prog, match n {
                                    None => None,
                                    Some(right) => Some(Emitted(right.prog.join_label(names + 2), left.file.meet(right.file, file.known), right.placement,
                                        right.names)),
                                }) {
                                None => λ _ => trivial,
                                Some(right) => λ no_grown => {
                                    let to_branch = prog.within_step(prog.tested(test), 0, jcc_item(shorts(short, names + 1), test.cc(), names + 1),
                                        prog.within_then(0, Block([test.instruction()])));
                                    let to_second = prog.within_step(At(left.prog, 0, jmp_item(shorts(short, names + 2), names + 2)), names + 1, Block([]),
                                        prog.within_step(left.prog, 0, jmp_item(shorts(short, names + 2), names + 2), Prog::within_trans(to_branch, yes_grown)));
                                    prog.within_step(right.prog, names + 2, Block([]), Prog::within_trans(to_second, no_grown))
                                },
                            })(no.emit_grows(saves, slots, short, bound, spare, second, file.know(Falsity(condition)), left.placement, left.names))
                        },
                    })(yes.emit_grows(saves, slots, short, bound, spare, branched, file.know(Truth(condition)), placement, names + 2))
                },
            },
        Call(callee, arguments, results) => λ prog file placement names =>
            file.emit_call_grows(slots, prog, callee, typed_ids(arguments), call_result(results, spare), call_also(results), placement, names, bound, [], []),
        Loop(inputs, parameters, inner, exit, next, outputs) => λ prog file placement names =>
            match state_registers(placement, typed_ids(parameters).len()) {
                None => trivial,
                Some(taken) => match file.plain_entry(saves, typed_ids(inputs), typed_ids(parameters), taken.registers) {
                    None => trivial,
                    Some(entry) => (match inner.emit(saves, slots, short, bound, spare, plain_head(prog, entry.code, names), entry.head, taken.rest, names + 4) as
                        λ e => Grows(plain_head(prog, entry.code, names), e) → Grows(prog, match e {
                            None => None,
                            Some(pass) => pass.plain_close(saves, taken.registers, exit, typed_ids(next), typed_ids(outputs), names, short),
                        }) {
                        None => λ _ => trivial,
                        Some(pass) => λ grown => {
                            let into_head: prog.Within(plain_head(prog, entry.code, names)) = Exists(2, refl);
                            plain_close_grows(pass, saves, taken.registers, exit, typed_ids(next), typed_ids(outputs), names, short, prog,
                                Prog::within_trans(into_head, grown))
                        },
                    })(inner.emit_grows(saves, slots, short, bound, spare, plain_head(prog, entry.code, names), entry.head, taken.rest, names + 4)),
                },
            },
        Sys(_) => λ prog file placement names => trivial,
        Exit(status) => λ prog file placement names => match file.find(Held(status, Word)) as λ o => Grows(prog, match o {
                None => None,
                Some(found) => Some(Emitted(At(At(prog, 0, Block(exit_code(found.register))), 0, Syscall), file, placement, names)),
            }) {
            None => trivial,
            Some(found) => Exists(2, refl),
        },
    }
}

// ---------------------------------------------------------------------------
// The theorem for one routine, proved once

theorem Routine::loads_few(self r: Routine, fits: word_ports(typed_ids(r.parameters)).len() <= parameter_registers().len()): r.loads() <= 2 {
    let ports = word_ports_len(typed_ids(r.parameters));
    let dropped: (typed_ids(r.parameters).drop(6).len() = typed_ids(r.parameters).len() - 6) = typed_ids(r.parameters).len_drop(6);
    let eight: (parameter_registers().len() = 8) = refl;
    let unfolded: (r.loads() = typed_ids(r.parameters).drop(6).len()) = refl;
    { omega }
}

// What emitting routine `k` proves: the code holds its label, and resident,
// the routine valid and with its room at every depth, it meets its contract
// at the label, returning and going on.
fn MayRoutineReturn<M>(site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, room: Nat → Nat → Nat, top: Nat, blocks: Blocks,
    sigs: Nat → Option<Signature>, k, bound: Nat, r: Routine, prog: Prog, out: Option<Emitted>) → Type {
    out.All(λ (emitted: Emitted) => At(prog, k + 1, Block([])).Within(emitted.prog) ∧
        (emitted.prog.Within(site.program) → r.valid(sigs) = True → ((cap: Nat) → r.Roomy(rooms_below(room, cap), room(k, cap), bound, 8, 6)) →
            RoutineAt<M>(site, stack, spans, room, top, blocks, bound, k, r, prog_len(prog)) ∧
            RoutineStopsAt<M>(site, stack, spans, room, top, blocks, bound, k, r, prog_len(prog))))
}

theorem Routine::closing_returns<M>(self r: Routine, sigs: Nat → Option<Signature>, used: List<Nat>, scope: r.scope() = Some(used), asked, saves: Nat,
    short: List<Nat>, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), top: Nat, spans: Spans,
    loan: Loan<M>(site.fetch, site.data, stack, top, spans), blocks: Blocks, lent: blocks.Lent(spans), room: Nat → Nat → Nat, k, bound: Nat, prog: Prog,
    file: File, placement: List<Place>, names: Nat, body: Emitted,
    emitted: r.whole(ids_past(used)).emit(saves, r.slots(asked), short, bound, ids_past(used), function_opened(prog, k, r.loads(), r.slots(asked), saves),
        file, placement, names) = Some(body),
    grew: function_opened(prog, k, r.loads(), r.slots(asked), saves).Within(body.prog),
    entered: (values: Valuation()) → (g: Gprs) → PortsAt(values, word_ports(typed_ids(r.parameters)), parameter_registers(), g) → file.Represents(values, g),
    few: r.loads() <= 2):
    MayRoutineReturn<M>(site, stack, spans, room, top, blocks, sigs, k, bound, r, prog, r.closing(asked, saves, ids_past(used), body)) {
    let outs = r.outs(ids_past(used));
    let grown: At(prog, k + 1, Block([])).Within(body.prog) = Prog::within_trans(label_opened(prog, k, r.loads(), r.slots(asked), saves), grew);
    (match body.file.move_results(outs, result_registers()) as λ moved => ((values: Valuation()) → MayKeep<M>(values, body.file, True, moved)) →
        MayRoutineReturn<M>(site, stack, spans, room, top, blocks, sigs, k, bound, r, prog, match moved {
            None => None,
            Some(moves) => match moves.file.outputs_check(outs, result_registers()) && leaves_all(moves.code, body_kept(saves)) {
                False => None,
                True => Some(Emitted(At(function_closed(body.prog, moves.code, r.slots(asked), saves), 0, Ret), File::empty(), body.placement, body.names)),
            },
        }) {
        None => λ _ => trivial,
        Some(moves) => λ keeps =>
            (match moves.file.outputs_check(outs, result_registers()) && leaves_all(moves.code, body_kept(saves)) as λ c =>
                (c.IsTrue() → moves.file.outputs_check(outs, result_registers()).IsTrue() ∧ leaves_all(moves.code, body_kept(saves)).IsTrue()) →
                MayRoutineReturn<M>(site, stack, spans, room, top, blocks, sigs, k, bound, r, prog, match c {
                    False => None,
                    True => Some(Emitted(At(function_closed(body.prog, moves.code, r.slots(asked), saves), 0, Ret), File::empty(), body.placement, body.names)),
                }) {
                False => λ _ => trivial,
                True => λ parts => {
                    let checked = parts(trivial);
                    ⟨Prog::within_trans(grown, closed_within(body.prog, moves.code, r.slots(asked), saves)),
                     λ within valid most => {
                        let roomy = λ (cap: Nat) => r.roomy_at(rooms_below(room, cap), room(k, cap), bound, asked, saves, most(cap));
                        ⟨routine_returns<M>(r, sigs, used, valid, scope, asked, saves, short, site, laid, stack, top, spans, loan, blocks, lent, room, k, bound,
                            roomy, prog, file, placement, names, body, emitted, moves, keeps, checked.left, checked.right, entered, few, within),
                         routine_stops_at<M>(r, sigs, used, valid, scope, asked, saves, short, site, laid, stack, top, spans, loan, blocks, lent, room, k, bound,
                            roomy, prog, file, placement, names, body, emitted, grew, moves, entered, few, within)⟩
                     }⟩
                },
            })(λ ok => Bool::is_true_and(moves.file.outputs_check(outs, result_registers()), leaves_all(moves.code, body_kept(saves)), ok)),
    })(λ values => move_results_keeps<M>(values, outs, body.file, result_registers()))
}

theorem Routine::emit_body_returns<M>(self r: Routine, sigs: Nat → Option<Signature>, used: List<Nat>, scope: r.scope() = Some(used), asked, saves: Nat,
    short: List<Nat>, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), top: Nat, spans: Spans,
    loan: Loan<M>(site.fetch, site.data, stack, top, spans), blocks: Blocks, lent: blocks.Lent(spans), room: Nat → Nat → Nat, k, bound: Nat, prog: Prog,
    file: File, placement: List<Place>, names: Nat,
    entered: (values: Valuation()) → (g: Gprs) → PortsAt(values, word_ports(typed_ids(r.parameters)), parameter_registers(), g) → file.Represents(values, g),
    few: r.loads() <= 2):
    MayRoutineReturn<M>(site, stack, spans, room, top, blocks, sigs, k, bound, r, prog, r.emit_body(asked, saves, short, prog, k, bound, ids_past(used), file,
        placement, names)) {
    let spare = ids_past(used);
    let opened = function_opened(prog, k, r.loads(), r.slots(asked), saves);
    (match r.whole(spare).emit(saves, r.slots(asked), short, bound, spare, opened, file, placement, names) as λ e =>
        (r.whole(spare).emit(saves, r.slots(asked), short, bound, spare, opened, file, placement, names) = e) → Grows(opened, e) →
        MayRoutineReturn<M>(site, stack, spans, room, top, blocks, sigs, k, bound, r, prog,
            match e { None => None, Some(body) => r.closing(asked, saves, spare, body) }) {
        None => λ _ _ => trivial,
        Some(body) => λ emitted grown => r.closing_returns<M>(sigs, used, scope, asked, saves, short, site, laid, stack, top, spans, loan, blocks, lent, room,
            k, bound, prog, file, placement, names, body, emitted, grown, entered, few),
    })(refl, r.whole(spare).emit_grows(saves, r.slots(asked), short, bound, spare, opened, file, placement, names))
}

// The theorem for one routine: whatever the placement, code `Routine::emit`
// returns, resident anywhere, meets the routine's contract at its label,
// given the routines it calls meet theirs.
theorem Routine::emit_returns<M>(self r: Routine, sigs: Nat → Option<Signature>, site: Site<M>, laid: site.program.laid_out().IsTrue(),
    stack: Stack<M>(site.fetch, site.data), top: Nat, spans: Spans, loan: Loan<M>(site.fetch, site.data, stack, top, spans), blocks: Blocks,
    lent: blocks.Lent(spans), room: Nat → Nat → Nat, k, bound: Nat, prog: Prog, placement: List<Place>, names: Nat):
    MayRoutineReturn<M>(site, stack, spans, room, top, blocks, sigs, k, bound, r, prog, r.emit(prog, k, bound, placement, names)) {
    let saves = placement_saves(placement);
    let asked = placement_slots(placement);
    let short = placement_short(placement);
    let ins = word_ports(typed_ids(r.parameters));
    match scope: r.scope() {
        None => trivial,
        Some(used) => (match input_file(ins, parameter_registers()) as λ entry =>
            ((values: Valuation()) → (g: Gprs) → PortsAt(values, ins, parameter_registers(), g) → entry.All(λ (file: File) => file.Represents(values, g))) →
            entry.All(λ (_: File) => ins.len() <= parameter_registers().len()) →
            MayRoutineReturn<M>(site, stack, spans, room, top, blocks, sigs, k, bound, r, prog, match entry {
                None => None,
                Some(file) => r.emit_body(asked, saves, short, prog, k, bound, ids_past(used), file, placement_body(placement), names),
            }) {
            None => λ _ _ => trivial,
            Some(file) => λ entered fits => r.emit_body_returns<M>(sigs, used, scope, asked, saves, short, site, laid, stack, top, spans, loan, blocks, lent,
                room, k, bound, prog, file, placement_body(placement), names, entered, r.loads_few(fits)),
        })(λ values g placed => input_file_represents(values, g, ins, parameter_registers(), placed), input_file_fits(ins, parameter_registers())),
    }
}

// ---------------------------------------------------------------------------
// A run that makes no system call leaves the world as it found it

theorem Instr::step_io(self instr: Instr, blocks: Blocks, c, after: Config, stepped: instr.step(blocks, c) = Some(after)): after.io = c.io {
    match instr {
        Compute(node) => {
            let made = Some(Config(Locals(node.step(c.locals.words), c.locals.refs), c.memory, c.io));
            match def: node.pure() && node.defined(c.locals.words) {
                False => absurd(j(def, λ v _ => (match v { False => None, True => made }) = Some(after), stepped)),
                True => sym(cong_fn<Config, Io>(λ y => y.io, Option::some_inj(Config(Locals(node.step(c.locals.words), c.locals.refs), c.memory, c.io), after,
                    j(def, λ v _ => (match v { False => None, True => made }) = Some(after), stepped)))),
            }
        },
        Load(bytes, output, place) => {
            let first = Option::and_then_some(c.locals.refs(place), λ (loc: Loc) =>
                c.memory.load(loc, bytes).and_then(λ (x: BitVec(64)) => Some(Config(c.locals.set_word(output, word_value(x)), c.memory, c.io))), after,
                stepped);
            let second = Option::and_then_some(c.memory.load(first.witness, bytes), λ (x: BitVec(64)) =>
                Some(Config(c.locals.set_word(output, word_value(x)), c.memory, c.io)), after, first.proof.right);
            sym(cong_fn<Config, Io>(λ y => y.io, Option::some_inj(Config(c.locals.set_word(output, word_value(second.witness)), c.memory, c.io), after,
                second.proof.right)))
        },
        Store(bytes, place, value) => {
            let piece = λ (w: BitVec(64)) => Piece::plain(low_bytes(bytes, w));
            let first = Option::and_then_some(c.locals.refs(place), λ (loc: Loc) =>
                c.memory.put(blocks.written, loc, piece(c.locals.word(value))).and_then(λ (m: Heap) => Some(Config(c.locals, m, c.io))), after, stepped);
            let second = Option::and_then_some(c.memory.put(blocks.written, first.witness, piece(c.locals.word(value))),
                λ (m: Heap) => Some(Config(c.locals, m, c.io)), after, first.proof.right);
            sym(cong_fn<Config, Io>(λ y => y.io, Option::some_inj(Config(c.locals, second.witness, c.io), after, second.proof.right)))
        },
        LoadRef(output, place) => {
            let first = Option::and_then_some(c.locals.refs(place), λ (loc: Loc) =>
                c.memory.load_ref(loc).and_then(λ (target: Loc) => Some(Config(c.locals.set_ref(output, target), c.memory, c.io))), after, stepped);
            let second = Option::and_then_some(c.memory.load_ref(first.witness), λ (target: Loc) =>
                Some(Config(c.locals.set_ref(output, target), c.memory, c.io)), after, first.proof.right);
            sym(cong_fn<Config, Io>(λ y => y.io, Option::some_inj(Config(c.locals.set_ref(output, second.witness), c.memory, c.io), after, second.proof.right)))
        },
        StoreRef(place, value) => {
            let first = Option::and_then_some(c.locals.refs(place), λ (loc: Loc) => c.locals.refs(value).and_then(λ (target: Loc) =>
                c.memory.put(blocks.written, loc, Piece::reference(target)).and_then(λ (m: Heap) => Some(Config(c.locals, m, c.io)))), after, stepped);
            let second = Option::and_then_some(c.locals.refs(value), λ (target: Loc) =>
                c.memory.put(blocks.written, first.witness, Piece::reference(target)).and_then(λ (m: Heap) => Some(Config(c.locals, m, c.io))), after,
                first.proof.right);
            let third = Option::and_then_some(c.memory.put(blocks.written, first.witness, Piece::reference(second.witness)),
                λ (m: Heap) => Some(Config(c.locals, m, c.io)), after, second.proof.right);
            sym(cong_fn<Config, Io>(λ y => y.io, Option::some_inj(Config(c.locals, third.witness, c.io), after, third.proof.right)))
        },
        Offset(output, place, amount) => {
            let moved = λ (loc: Loc) => Loc(loc.block, loc.offset + c.locals.word(amount).toNat());
            let first = Option::and_then_some(c.locals.refs(place), λ (loc: Loc) =>
                Some(Config(c.locals.set_ref(output, moved(loc)), c.memory, c.io)), after, stepped);
            sym(cong_fn<Config, Io>(λ y => y.io, Option::some_inj(Config(c.locals.set_ref(output, moved(first.witness)), c.memory, c.io), after,
                first.proof.right)))
        },
        Copy(target, source, length) => {
            let n = c.locals.word(length).toNat();
            let first = Option::and_then_some(c.locals.refs(target), λ (to: Loc) => c.locals.refs(source).and_then(λ (from: Loc) =>
                c.memory.copy(blocks.written, to, from, n).and_then(λ (m: Heap) => Some(Config(c.locals, m, c.io)))), after, stepped);
            let second = Option::and_then_some(c.locals.refs(source), λ (from: Loc) =>
                c.memory.copy(blocks.written, first.witness, from, n).and_then(λ (m: Heap) => Some(Config(c.locals, m, c.io))), after, first.proof.right);
            let third = Option::and_then_some(c.memory.copy(blocks.written, first.witness, second.witness, n),
                λ (m: Heap) => Some(Config(c.locals, m, c.io)), after, second.proof.right);
            sym(cong_fn<Config, Io>(λ y => y.io, Option::some_inj(Config(c.locals, third.witness, c.io), after, third.proof.right)))
        },
    }
}

theorem run_instrs_io(blocks: Blocks, instrs: List<Instr>): (c, after: Config) → run_instrs(blocks, instrs, c) = Some(after) → after.io = c.io {
    match instrs {
        Nil => λ c after ran => cong_fn<Config, Io>(λ y => y.io, sym(Option::some_inj(c, after, ran))),
        Cons(instr, rest) => λ c after ran => {
            let first = Option::and_then_some(instr.step(blocks, c), λ (m: Config) => run_instrs(blocks, rest, m), after, ran);
            trans(run_instrs_io(blocks, rest, first.witness, after, first.proof.right), instr.step_io(blocks, c, first.witness, first.proof.left))
        },
    }
}

// Calls that leave the world as they found it.
fn Quiet(calls: Calls()) → Type { (f: Nat) → (args: List<Value>) → (heap: Heap) → (io: Io) → (a: Answer) → calls(f, args, heap, io) = Done(a) → a.io = io }

theorem loop_pass_io(blocks: Blocks, calls: Calls(), inner: Body, parameters: List<Typed>, exit: Nat, next: List<Typed>,
    passes: (rest: Nat) → (state: List<Value>) → (m: Heap) → (io: Io) → (l: Locals) → (after: Config) → pass_locals(parameters, state) = Some(l) →
        inner.run(blocks, calls, rest, Config(l, m, io)) = Done(after) → after.io = io,
    fuel: Nat, later: List<Value> → Heap → Io → Ran<Ended>,
    each: (state: List<Value>) → (m: Heap) → (io: Io) → (end: Ended) → later(state, m, io) = Done(end) → end.io = io):
    (state: List<Value>) → (m: Heap) → (io: Io) → (end: Ended) →
    bytes_level::loop_pass(λ (n: Nat) (pass: Config) => inner.run(blocks, calls, n, pass), parameters, exit, next, fuel, later, state, m, io) = Done(end) → end.io = io {
    λ state m io end ran => {
        let after_pass = λ (after: Config) => Ran::of(read_values(next, after.locals), after.io).then(λ (more: List<Value>) =>
            match after.locals.words(1, exit).head_bit() {
                False => later(more, after.memory, after.io),
                True => Done(Ended(more, after.memory, after.io)),
            });
        let one = Ran::then_done<Locals, Ended>(Ran::of(pass_locals(parameters, state), io), λ (l: Locals) =>
            inner.run(blocks, calls, fuel, Config(l, m, io)).then(after_pass), end, ran);
        let l = one.witness;
        let two = Ran::then_done<Config, Ended>(inner.run(blocks, calls, fuel, Config(l, m, io)), after_pass, end, one.proof.right);
        let after = two.witness;
        let three = Ran::then_done<List<Value>, Ended>(Ran::of(read_values(next, after.locals), after.io), λ (more: List<Value>) =>
            match after.locals.words(1, exit).head_bit() {
                False => later(more, after.memory, after.io),
                True => Done(Ended(more, after.memory, after.io)),
            }, end, two.proof.right);
        let more = three.witness;
        let pass_io: (after.io = io) = passes(fuel, state, m, io, l, after, Ran::of_done<Locals>(pass_locals(parameters, state), io, l, one.proof.left),
            two.proof.left);
        trans((match after.locals.words(1, exit).head_bit() as λ b => (match b {
                False => later(more, after.memory, after.io),
                True => Done(Ended(more, after.memory, after.io)),
            }) = Done(end) → end.io = after.io {
            True => λ e => cong_fn<Ended, Io>(λ x => x.io, sym(Ran::done_inj<Ended>(Ended(more, after.memory, after.io), end, e))),
            False => λ e => each(more, after.memory, after.io, end, e),
        })(three.proof.right), pass_io)
    }
}

theorem loop_later_io(blocks: Blocks, calls: Calls(), inner: Body, parameters: List<Typed>, exit: Nat, next: List<Typed>,
    passes: (rest: Nat) → (state: List<Value>) → (m: Heap) → (io: Io) → (l: Locals) → (after: Config) → pass_locals(parameters, state) = Some(l) →
        inner.run(blocks, calls, rest, Config(l, m, io)) = Done(after) → after.io = io,
    fuel: Nat):
    (state: List<Value>) → (m: Heap) → (io: Io) → (end: Ended) →
    bytes_level::loop_later(λ (n: Nat) (pass: Config) => inner.run(blocks, calls, n, pass), parameters, exit, next, fuel, state, m, io) = Done(end) → end.io = io {
    match fuel {
        Zero => λ state m io end never => absurd(never),
        Succ(rest) => loop_pass_io(blocks, calls, inner, parameters, exit, next, passes, rest,
            bytes_level::loop_later(λ (n: Nat) (pass: Config) => inner.run(blocks, calls, n, pass), parameters, exit, next, rest), loop_later_io(blocks, calls, inner, parameters, exit, next, passes, rest)),
    }
}

theorem loop_run_io(blocks: Blocks, calls: Calls(), inner: Body, parameters: List<Typed>, exit: Nat, next: List<Typed>,
    passes: (rest: Nat) → (state: List<Value>) → (m: Heap) → (io: Io) → (l: Locals) → (after: Config) → pass_locals(parameters, state) = Some(l) →
        inner.run(blocks, calls, rest, Config(l, m, io)) = Done(after) → after.io = io,
    fuel: Nat):
    (state: List<Value>) → (m: Heap) → (io: Io) → (end: Ended) →
    bytes_level::loop_run(λ (n: Nat) (pass: Config) => inner.run(blocks, calls, n, pass), parameters, exit, next, fuel, state, m, io) = Done(end) → end.io = io {
    loop_pass_io(blocks, calls, inner, parameters, exit, next, passes, fuel,
        bytes_level::loop_later(λ (n: Nat) (pass: Config) => inner.run(blocks, calls, n, pass), parameters, exit, next, fuel), loop_later_io(blocks, calls, inner, parameters, exit, next, passes, fuel))
}

theorem Body::run_io(self body: Body, blocks: Blocks, calls: Calls(), quiet: Quiet(calls), fuel: Nat): (used, used2: List<Nat>) → (c, after: Config) →
    body.fresh(used) = Some(used2) → body.run(blocks, calls, fuel, c) = Done(after) → after.io = c.io {
    match body {
        Leaf(instrs) => λ used used2 c after fresh ran =>
            run_instrs_io(blocks, instrs, c, after, Ran::of_done<Config>(run_instrs(blocks, instrs, c), c.io, after, ran)),
        Seq(first, rest) => λ used used2 c after fresh ran => {
            let fresh_first = Option::and_then_some(first.fresh(used), λ (u: List<Nat>) => rest.fresh(u), used2, fresh);
            let ran_first = Ran::then_done<Config, Config>(first.run(blocks, calls, fuel, c), λ (mid: Config) => rest.run(blocks, calls, fuel, mid), after, ran);
            trans(rest.run_io(blocks, calls, quiet, fuel, fresh_first.witness, used2, ran_first.witness, after, fresh_first.proof.right, ran_first.proof.right),
                first.run_io(blocks, calls, quiet, fuel, used, fresh_first.witness, c, ran_first.witness, fresh_first.proof.left, ran_first.proof.left))
        },
        Branch(condition, yes, no) => λ used used2 c after fresh ran => {
            let fresh_yes = Option::and_then_some(yes.fresh(used), λ (uy: List<Nat>) => no.fresh(used).and_then(λ (un: List<Nat>) => Some(uy ++ un)),
                used2, fresh);
            let fresh_no = Option::and_then_some(no.fresh(used), λ (un: List<Nat>) => Some(fresh_yes.witness ++ un), used2, fresh_yes.proof.right);
            (match c.locals.words(1, condition).head_bit() as λ bit =>
                (match bit { True => yes.run(blocks, calls, fuel, c), False => no.run(blocks, calls, fuel, c) }) = Done(after) → after.io = c.io {
                True => λ r => yes.run_io(blocks, calls, quiet, fuel, used, fresh_yes.witness, c, after, fresh_yes.proof.left, r),
                False => λ r => no.run_io(blocks, calls, quiet, fuel, used, fresh_no.witness, c, after, fresh_no.proof.left, r),
            })(ran)
        },
        Call(callee, arguments, results) => λ used used2 c after fresh ran => {
            let r = call_ran(blocks, calls, fuel, callee, arguments, results, c, after, ran);
            trans(cong_fn<Config, Io>(λ y => y.io, r.lands), quiet(callee, r.args, c.memory, c.io, r.answer, r.answered))
        },
        Loop(inputs, parameters, inner, exit, next, outputs) => λ used used2 c after fresh ran => {
            let r = loop_ran(blocks, calls, fuel, inputs, parameters, inner, exit, next, outputs, c, after, ran);
            let fr = loop_fresh(used, used2, inputs, parameters, inner, exit, next, outputs, fresh);
            trans(cong_fn<Config, Io>(λ y => y.io, r.lands), loop_run_io(blocks, calls, inner, parameters, exit, next,
                λ rest st m io l aft _ rn => inner.run_io(blocks, calls, quiet, rest, fr.start, fr.inside, Config(l, m, io), aft, fr.body, rn),
                fuel, r.state, c.memory, c.io, r.end, r.looped))
        },
        Sys(_) => λ used used2 c after never => absurd(never),
        Exit(_) => λ used used2 c after fresh never => absurd(never),
    }
}

theorem Routine::call_io(self r: Routine, used: List<Nat>, scope: r.scope() = Some(used), blocks: Blocks, calls: Calls(), quiet: Quiet(calls), fuel: Nat,
    args: List<Value>, heap: Heap, io: Io, a: Answer, ran: r.call(blocks, calls, fuel, args, heap, io) = Done(a)): a.io = io {
    let run = routine_ran(r, blocks, calls, fuel, args, heap, io, a, ran);
    let fresh = Option::and_then_some(fresh_ids([], typed_ids(r.parameters)), λ (u: List<Nat>) => r.body.fresh(u), used, scope);
    trans(run.world, r.body.run_io(blocks, calls, quiet, fuel, fresh.witness, used, Config(run.start, heap, io), run.after, fresh.proof.right, run.ran))
}

// Every routine of the list scoped.
fn Scoped::all(routines: List<Routine>) → Type {
    match routines { Nil => True, Cons(r, rest) => Exists<List<Nat>>(λ used => r.scope() = Some(used)) ∧ Scoped::all(rest) }
}

theorem scoped_nth(routines: List<Routine>): (f: Nat) → (r: Routine) → routines.nth(f) = Some(r) → Scoped::all(routines) →
    Exists<List<Nat>>(λ used => r.scope() = Some(used)) {
    match routines {
        Nil => λ f r never _ => absurd(never),
        Cons(first, rest) => λ f => match f {
            Zero => λ r e all => j(Option::some_inj(first, r, e), λ x _ => Exists<List<Nat>>(λ used => x.scope() = Some(used)), all.left),
            Succ(g) => λ r e all => scoped_nth(rest, g, r, e, all.right),
        },
    }
}

// The program's runs leave the world alone, fuel by fuel.
theorem program_quiet(routines: List<Routine>, blocks: Blocks, scoped: Scoped::all(routines), fuel: Nat): Quiet(program_calls(routines, blocks, fuel)) {
    match fuel {
        Zero => λ f args heap io a never => absurd(never),
        Succ(n) => λ f args heap io a => (match routines.nth(f) as λ o => routines.nth(f) = o →
            (match o { None => Stuck(io), Some(r) => r.call(blocks, program_calls(routines, blocks, n), n, args, heap, io) }) = Done(a) → a.io = io {
            None => λ _ never => absurd(never),
            Some(r) => λ nth ran => {
                let s = scoped_nth(routines, f, r, nth, scoped);
                r.call_io(s.witness, s.proof, blocks, program_calls(routines, blocks, n), program_quiet(routines, blocks, scoped, n), n, args, heap, io, a, ran)
            },
        })(refl),
    }
}

// Calls stopped short leave the world as they found it.
fn QuietStop(calls: Calls()) → Type {
    (f: Nat) → (args: List<Value>) → (heap: Heap) → (io: Io) → (x: Stop) → calls(f, args, heap, io).stopped() = Some(x) → x.world() = io
}

theorem loop_pass_stopped_io(blocks: Blocks, calls: Calls(), inner: Body, parameters: List<Typed>, exit: Nat, next: List<Typed>,
    passes: (rest: Nat) → (state: List<Value>) → (m: Heap) → (io: Io) → (l: Locals) → (after: Config) → pass_locals(parameters, state) = Some(l) →
        inner.run(blocks, calls, rest, Config(l, m, io)) = Done(after) → after.io = io,
    goes: (rest: Nat) → (state: List<Value>) → (m: Heap) → (io: Io) → (l: Locals) → (x: Stop) → pass_locals(parameters, state) = Some(l) →
        inner.run(blocks, calls, rest, Config(l, m, io)).stopped() = Some(x) → x.world() = io,
    fuel: Nat, later: List<Value> → Heap → Io → Ran<Ended>,
    each: (state: List<Value>) → (m: Heap) → (io: Io) → (x: Stop) → later(state, m, io).stopped() = Some(x) → x.world() = io):
    (state: List<Value>) → (m: Heap) → (io: Io) → (x: Stop) →
    bytes_level::loop_pass(λ (n: Nat) (pass: Config) => inner.run(blocks, calls, n, pass), parameters, exit, next, fuel, later, state, m, io).stopped() = Some(x) →
    x.world() = io {
    λ state m io x ran => {
        let after_pass = λ (after: Config) => Ran::of(read_values(next, after.locals), after.io).then(λ (more: List<Value>) =>
            match after.locals.words(1, exit).head_bit() {
                False => later(more, after.memory, after.io),
                True => Done(Ended(more, after.memory, after.io)),
            });
        match Ran::then_stopped<Locals, Ended>(Ran::of(pass_locals(parameters, state), io), λ (l: Locals) =>
            inner.run(blocks, calls, fuel, Config(l, m, io)).then(after_pass), x, ran) {
            Inl(never) => false_elim(Ran::of_stopped<Locals>(pass_locals(parameters, state), io, x, never)),
            Inr(bound) => {
                let l = bound.witness;
                let locals = Ran::of_done<Locals>(pass_locals(parameters, state), io, l, bound.proof.left);
                match Ran::then_stopped<Config, Ended>(inner.run(blocks, calls, fuel, Config(l, m, io)), after_pass, x, bound.proof.right) {
                    Inl(going) => goes(fuel, state, m, io, l, x, locals, going),
                    Inr(passed) => {
                        let after = passed.witness;
                        let pass_io: (after.io = io) = passes(fuel, state, m, io, l, after, locals, passed.proof.left);
                        match Ran::then_stopped<List<Value>, Ended>(Ran::of(read_values(next, after.locals), after.io), λ (more: List<Value>) =>
                            match after.locals.words(1, exit).head_bit() {
                                False => later(more, after.memory, after.io),
                                True => Done(Ended(more, after.memory, after.io)),
                            }, x, passed.proof.right) {
                            Inl(never) => false_elim(Ran::of_stopped<List<Value>>(read_values(next, after.locals), after.io, x, never)),
                            Inr(read) => {
                                let more = read.witness;
                                trans((match after.locals.words(1, exit).head_bit() as λ b => (match b {
                                        False => later(more, after.memory, after.io),
                                        True => Done(Ended(more, after.memory, after.io)),
                                    }).stopped() = Some(x) → x.world() = after.io {
                                    True => λ never => absurd(never),
                                    False => λ e => each(more, after.memory, after.io, x, e),
                                })(read.proof.right), pass_io)
                            },
                        }
                    },
                }
            },
        }
    }
}

theorem loop_later_stopped_io(blocks: Blocks, calls: Calls(), inner: Body, parameters: List<Typed>, exit: Nat, next: List<Typed>,
    passes: (rest: Nat) → (state: List<Value>) → (m: Heap) → (io: Io) → (l: Locals) → (after: Config) → pass_locals(parameters, state) = Some(l) →
        inner.run(blocks, calls, rest, Config(l, m, io)) = Done(after) → after.io = io,
    goes: (rest: Nat) → (state: List<Value>) → (m: Heap) → (io: Io) → (l: Locals) → (x: Stop) → pass_locals(parameters, state) = Some(l) →
        inner.run(blocks, calls, rest, Config(l, m, io)).stopped() = Some(x) → x.world() = io,
    fuel: Nat):
    (state: List<Value>) → (m: Heap) → (io: Io) → (x: Stop) →
    bytes_level::loop_later(λ (n: Nat) (pass: Config) => inner.run(blocks, calls, n, pass), parameters, exit, next, fuel, state, m, io).stopped() = Some(x) →
    x.world() = io {
    match fuel {
        Zero => λ state m io x e => j(Option::some_inj(StopGoing(io), x, e), λ y _ => y.world() = io, refl),
        Succ(rest) => loop_pass_stopped_io(blocks, calls, inner, parameters, exit, next, passes, goes, rest,
            bytes_level::loop_later(λ (n: Nat) (pass: Config) => inner.run(blocks, calls, n, pass), parameters, exit, next, rest),
            loop_later_stopped_io(blocks, calls, inner, parameters, exit, next, passes, goes, rest)),
    }
}

theorem loop_run_stopped_io(blocks: Blocks, calls: Calls(), inner: Body, parameters: List<Typed>, exit: Nat, next: List<Typed>,
    passes: (rest: Nat) → (state: List<Value>) → (m: Heap) → (io: Io) → (l: Locals) → (after: Config) → pass_locals(parameters, state) = Some(l) →
        inner.run(blocks, calls, rest, Config(l, m, io)) = Done(after) → after.io = io,
    goes: (rest: Nat) → (state: List<Value>) → (m: Heap) → (io: Io) → (l: Locals) → (x: Stop) → pass_locals(parameters, state) = Some(l) →
        inner.run(blocks, calls, rest, Config(l, m, io)).stopped() = Some(x) → x.world() = io,
    fuel: Nat):
    (state: List<Value>) → (m: Heap) → (io: Io) → (x: Stop) →
    bytes_level::loop_run(λ (n: Nat) (pass: Config) => inner.run(blocks, calls, n, pass), parameters, exit, next, fuel, state, m, io).stopped() = Some(x) →
    x.world() = io {
    loop_pass_stopped_io(blocks, calls, inner, parameters, exit, next, passes, goes, fuel,
        bytes_level::loop_later(λ (n: Nat) (pass: Config) => inner.run(blocks, calls, n, pass), parameters, exit, next, fuel),
        loop_later_stopped_io(blocks, calls, inner, parameters, exit, next, passes, goes, fuel))
}

theorem Body::stopped_io(self body: Body, blocks: Blocks, calls: Calls(), quiet: Quiet(calls), quiet_stop: QuietStop(calls), fuel: Nat):
    (used, used2: List<Nat>) → (c: Config) → (x: Stop) → body.fresh(used) = Some(used2) → body.run(blocks, calls, fuel, c).stopped() = Some(x) → x.world() = c.io {
    match body {
        Leaf(instrs) => λ used used2 c x fresh ran => false_elim(Ran::of_stopped<Config>(run_instrs(blocks, instrs, c), c.io, x, ran)),
        Seq(first, rest) => λ used used2 c x fresh ran => {
            let fresh_first = Option::and_then_some(first.fresh(used), λ (u: List<Nat>) => rest.fresh(u), used2, fresh);
            match Ran::then_stopped<Config, Config>(first.run(blocks, calls, fuel, c), λ (mid: Config) => rest.run(blocks, calls, fuel, mid), x, ran) {
                Inl(going) => first.stopped_io(blocks, calls, quiet, quiet_stop, fuel, used, fresh_first.witness, c, x, fresh_first.proof.left, going),
                Inr(done) => trans(rest.stopped_io(blocks, calls, quiet, quiet_stop, fuel, fresh_first.witness, used2, done.witness, x, fresh_first.proof.right,
                        done.proof.right),
                    first.run_io(blocks, calls, quiet, fuel, used, fresh_first.witness, c, done.witness, fresh_first.proof.left, done.proof.left)),
            }
        },
        Branch(condition, yes, no) => λ used used2 c x fresh ran => {
            let fresh_yes = Option::and_then_some(yes.fresh(used), λ (uy: List<Nat>) => no.fresh(used).and_then(λ (un: List<Nat>) => Some(uy ++ un)),
                used2, fresh);
            let fresh_no = Option::and_then_some(no.fresh(used), λ (un: List<Nat>) => Some(fresh_yes.witness ++ un), used2, fresh_yes.proof.right);
            (match c.locals.words(1, condition).head_bit() as λ bit =>
                (match bit { True => yes.run(blocks, calls, fuel, c), False => no.run(blocks, calls, fuel, c) }).stopped() = Some(x) → x.world() = c.io {
                True => λ r => yes.stopped_io(blocks, calls, quiet, quiet_stop, fuel, used, fresh_yes.witness, c, x, fresh_yes.proof.left, r),
                False => λ r => no.stopped_io(blocks, calls, quiet, quiet_stop, fuel, used, fresh_no.witness, c, x, fresh_no.proof.left, r),
            })(ran)
        },
        Call(callee, arguments, results) => λ used used2 c x fresh ran =>
            match Ran::then_stopped<List<Value>, Config>(Ran::of(read_values(arguments, c.locals), c.io), λ (args: List<Value>) =>
                calls(callee, args, c.memory, c.io).then(λ (answer: Answer) =>
                    Ran::of(bind_values(results, answer.words, c.locals), answer.io).then(λ (l: Locals) => Done(Config(l, answer.heap, answer.io)))), x, ran) {
                Inl(never) => false_elim(Ran::of_stopped<List<Value>>(read_values(arguments, c.locals), c.io, x, never)),
                Inr(read) => match Ran::then_stopped<Answer, Config>(calls(callee, read.witness, c.memory, c.io), λ (answer: Answer) =>
                    Ran::of(bind_values(results, answer.words, c.locals), answer.io).then(λ (l: Locals) => Done(Config(l, answer.heap, answer.io))), x,
                    read.proof.right) {
                    Inl(going) => quiet_stop(callee, read.witness, c.memory, c.io, x, going),
                    Inr(answered) => false_elim(Ran::done_not_stopped<Locals, Config>(bind_values(results, answered.witness.words, c.locals),
                        answered.witness.io, λ (l: Locals) => Config(l, answered.witness.heap, answered.witness.io), x, answered.proof.right)),
                },
            },
        Loop(inputs, parameters, inner, exit, next, outputs) => λ used used2 c x fresh ran => {
            let fr = loop_fresh(used, used2, inputs, parameters, inner, exit, next, outputs, fresh);
            let step = λ (n: Nat) (pass: Config) => inner.run(blocks, calls, n, pass);
            match Ran::then_stopped<List<Value>, Config>(Ran::of(read_values(inputs, c.locals), c.io), λ (state: List<Value>) =>
                bytes_level::loop_run(step, parameters, exit, next, fuel, state, c.memory, c.io).then(λ (end: Ended) =>
                    Ran::of(bind_values(outputs, end.state, c.locals), end.io).then(λ (l: Locals) => Done(Config(l, end.memory, end.io)))), x, ran) {
                Inl(never) => false_elim(Ran::of_stopped<List<Value>>(read_values(inputs, c.locals), c.io, x, never)),
                Inr(read) => match Ran::then_stopped<Ended, Config>(bytes_level::loop_run(step, parameters, exit, next, fuel, read.witness, c.memory, c.io),
                    λ (end: Ended) => Ran::of(bind_values(outputs, end.state, c.locals), end.io).then(λ (l: Locals) => Done(Config(l, end.memory, end.io))), x,
                    read.proof.right) {
                    Inl(going) => loop_run_stopped_io(blocks, calls, inner, parameters, exit, next,
                        λ rest st m io l aft _ rn => inner.run_io(blocks, calls, quiet, rest, fr.start, fr.inside, Config(l, m, io), aft, fr.body, rn),
                        λ rest st m io l w _ rn => inner.stopped_io(blocks, calls, quiet, quiet_stop, rest, fr.start, fr.inside, Config(l, m, io), w, fr.body, rn),
                        fuel, read.witness, c.memory, c.io, x, going),
                    Inr(ended) => false_elim(Ran::done_not_stopped<Locals, Config>(bind_values(outputs, ended.witness.state, c.locals), ended.witness.io,
                        λ (l: Locals) => Config(l, ended.witness.memory, ended.witness.io), x, ended.proof.right)),
                },
            }
        },
        Sys(_) => λ used used2 c x never => absurd(never),
        Exit(status) => λ used used2 c x fresh ran =>
            j(Option::some_inj(StopExited(c.locals.word(status), c.io), x, ran), λ y _ => y.world() = c.io, refl),
    }
}

theorem Routine::call_stopped_io(self r: Routine, used: List<Nat>, scope: r.scope() = Some(used), blocks: Blocks, calls: Calls(), quiet: Quiet(calls),
    quiet_stop: QuietStop(calls), fuel: Nat, args: List<Value>, heap: Heap, io: Io, x: Stop, ran: r.call(blocks, calls, fuel, args, heap, io).stopped() = Some(x)): x.world() = io {
    let fresh = Option::and_then_some(fresh_ids([], typed_ids(r.parameters)), λ (u: List<Nat>) => r.body.fresh(u), used, scope);
    match Ran::then_stopped<Locals, Answer>(Ran::of(bind_values(r.parameters, args, Locals::empty()), io), λ (l: Locals) =>
        r.body.run(blocks, calls, fuel, Config(l, heap, io)).then(λ (after: Config) =>
            Ran::of(read_values(r.results, after.locals), after.io).then(λ (words: List<Value>) => Done(Answer(words, after.memory, after.io)))), x, ran) {
        Inl(never) => false_elim(Ran::of_stopped<Locals>(bind_values(r.parameters, args, Locals::empty()), io, x, never)),
        Inr(bound) => match Ran::then_stopped<Config, Answer>(r.body.run(blocks, calls, fuel, Config(bound.witness, heap, io)), λ (after: Config) =>
            Ran::of(read_values(r.results, after.locals), after.io).then(λ (words: List<Value>) => Done(Answer(words, after.memory, after.io))), x,
            bound.proof.right) {
            Inl(going) => r.body.stopped_io(blocks, calls, quiet, quiet_stop, fuel, fresh.witness, used, Config(bound.witness, heap, io), x, fresh.proof.right,
                going),
            Inr(done) => false_elim(Ran::done_not_stopped<List<Value>, Answer>(read_values(r.results, done.witness.locals), done.witness.io,
                λ (words: List<Value>) => Answer(words, done.witness.memory, done.witness.io), x, done.proof.right)),
        },
    }
}

theorem program_stop_quiet(routines: List<Routine>, blocks: Blocks, scoped: Scoped::all(routines), fuel: Nat): QuietStop(program_calls(routines, blocks, fuel)) {
    match fuel {
        Zero => λ f args heap io x e => j(Option::some_inj(StopGoing(io), x, e), λ y _ => y.world() = io, refl),
        Succ(n) => λ f args heap io x => (match routines.nth(f) as λ y => routines.nth(f) = y →
            (match y { None => Stuck(io), Some(r) => r.call(blocks, program_calls(routines, blocks, n), n, args, heap, io) }).stopped() = Some(x) → x.world() = io {
            None => λ _ never => absurd(never),
            Some(r) => λ nth ran => {
                let s = scoped_nth(routines, f, r, nth, scoped);
                r.call_stopped_io(s.witness, s.proof, blocks, program_calls(routines, blocks, n), program_quiet(routines, blocks, scoped, n),
                    program_stop_quiet(routines, blocks, scoped, n), n, args, heap, io, x, ran)
            },
        })(refl),
    }
}

// ---------------------------------------------------------------------------
// Programs

// The routines from number `k` on, after `prog`, each at its label, each
// calling any of the program's `bound` routines.
fn emit_routines(prog: Prog, routines: List<Routine>, k, bound: Nat, placement: List<Place>, names: Nat) → Option<Emitted> {
    match routines {
        Nil => Some(Emitted(prog, File::empty(), placement, names)),
        Cons(r, rest) => match r.emit(prog, k, bound, placement, names) {
            None => None,
            Some(out) => emit_routines(out.prog, rest, k + 1, bound, out.placement, out.names),
        },
    }
}

// A program's code: its routines at labels `1` on, the branches' labels
// past them. Refused where the program is not valid, a routine is refused,
// or the code is not laid out.
fn Program::lower(self p: Program, placement: List<Place>) → Option<Prog> {
    match p.valid() {
        False => None,
        True => match emit_routines(Start, p.routines, 0, p.routines.len(), placement, p.routines.len()) {
            None => None,
            Some(out) => match out.prog.laid_out() { False => None, True => Some(out.prog) },
        },
    }
}

// Each routine of the list, numbered from `k`, valid and with its room at
// every depth, meets its contract at its label, returning and going on.
fn RoutinesAt<M>(site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, room: Nat → Nat → Nat, top: Nat, blocks: Blocks,
    sigs: Nat → Option<Signature>, bound: Nat, routines: List<Routine>, k: Nat) → Type {
    match routines {
        Nil => True,
        Cons(r, rest) => (r.valid(sigs) = True → ((cap: Nat) → r.Roomy(rooms_below(room, cap), room(k, cap), bound, 8, 6)) →
                RoutineAt<M>(site, stack, spans, room, top, blocks, bound, k, r, asm_labels(site.program)(k + 1)) ∧
                RoutineStopsAt<M>(site, stack, spans, room, top, blocks, bound, k, r, asm_labels(site.program)(k + 1))) ∧
            RoutinesAt<M>(site, stack, spans, room, top, blocks, sigs, bound, rest, k + 1),
    }
}

fn MayRoutinesReturn<M>(site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, room: Nat → Nat → Nat, top: Nat, blocks: Blocks,
    sigs: Nat → Option<Signature>, bound: Nat, routines: List<Routine>, k: Nat, prog: Prog, out: Option<Emitted>) → Type {
    out.All(λ (emitted: Emitted) => prog.Within(emitted.prog) ∧ Scoped::all(routines) ∧
        (emitted.prog.Within(site.program) → RoutinesAt<M>(site, stack, spans, room, top, blocks, sigs, bound, routines, k)))
}

theorem Routine::emit_scoped(self r: Routine, prog: Prog, k, bound: Nat, placement: List<Place>, names: Nat, out: Emitted):
    r.emit(prog, k, bound, placement, names) = Some(out) → Exists<List<Nat>>(λ used => r.scope() = Some(used)) {
    (match r.scope() as λ o => r.scope() = o → (match o { None => None, Some(used) => r.emit_in(used, prog, k, bound, placement, names) }) = Some(out) →
        Exists<List<Nat>>(λ used => r.scope() = Some(used)) {
        None => λ _ never => absurd(never),
        Some(used) => λ s _ => Exists(used, s),
    })(refl)
}

theorem emit_routines_returns<M>(site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), top: Nat, spans: Spans,
    loan: Loan<M>(site.fetch, site.data, stack, top, spans), blocks: Blocks, lent: blocks.Lent(spans), room: Nat → Nat → Nat,
    sigs: Nat → Option<Signature>, bound: Nat, routines: List<Routine>): (prog: Prog) → (k: Nat) → (placement: List<Place>) → (names: Nat) →
    MayRoutinesReturn<M>(site, stack, spans, room, top, blocks, sigs, bound, routines, k, prog, emit_routines(prog, routines, k, bound, placement, names)) {
    match routines {
        Nil => λ prog k placement names => ⟨prog.within_self(), ⟨trivial, λ _ => trivial⟩⟩,
        Cons(r, rest) => λ prog k placement names =>
            (match r.emit(prog, k, bound, placement, names) as λ e =>
                MayRoutineReturn<M>(site, stack, spans, room, top, blocks, sigs, k, bound, r, prog, e) →
                (r.emit(prog, k, bound, placement, names) = e) →
                MayRoutinesReturn<M>(site, stack, spans, room, top, blocks, sigs, bound, Cons(r, rest), k, prog, match e {
                    None => None,
                    Some(out) => emit_routines(out.prog, rest, k + 1, bound, out.placement, out.names),
                }) {
                None => λ _ _ => trivial,
                Some(out) => λ one emitted => (match emit_routines(out.prog, rest, k + 1, bound, out.placement, out.names) as λ e =>
                    MayRoutinesReturn<M>(site, stack, spans, room, top, blocks, sigs, bound, rest, k + 1, out.prog, e) →
                    MayRoutinesReturn<M>(site, stack, spans, room, top, blocks, sigs, bound, Cons(r, rest), k, prog, e) {
                    None => λ _ => trivial,
                    Some(all) => λ more => {
                        let grown: prog.Within(out.prog) = Prog::within_trans(prog.within_then(k + 1, Block([])), one.left);
                        ⟨Prog::within_trans(grown, more.left), ⟨⟨r.emit_scoped(prog, k, bound, placement, names, out, emitted), more.right.left⟩,
                         λ within => {
                            let out_in = Prog::within_trans(more.left, within);
                            let label_in = Prog::within_trans(one.left, out_in);
                            let label: (asm_labels(site.program)(k + 1) = prog_len(prog)) = label_target(label_in.witness, site.program, prog, k, Block([]),
                                site.program.laid_out_unique(laid), label_in.proof);
                            ⟨λ valid most => j(sym(label), λ e _ => RoutineAt<M>(site, stack, spans, room, top, blocks, bound, k, r, e) ∧
                                    RoutineStopsAt<M>(site, stack, spans, room, top, blocks, bound, k, r, e), one.right(out_in, valid, most)),
                             more.right.right(within)⟩
                         }⟩⟩
                    },
                })(emit_routines_returns<M>(site, laid, stack, top, spans, loan, blocks, lent, room, sigs, bound, rest, out.prog, k + 1, out.placement,
                    out.names)),
            })(r.emit_returns<M>(sigs, site, laid, stack, top, spans, loan, blocks, lent, room, k, bound, prog, placement, names), refl),
    }
}

theorem routines_at_nth<M>(site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, room: Nat → Nat → Nat, top: Nat, blocks: Blocks,
    sigs: Nat → Option<Signature>, bound: Nat, routines: List<Routine>): (k, f: Nat) → (r: Routine) → routines.nth(f) = Some(r) →
    RoutinesAt<M>(site, stack, spans, room, top, blocks, sigs, bound, routines, k) → r.valid(sigs) = True →
    ((cap: Nat) → r.Roomy(rooms_below(room, cap), room(k + f, cap), bound, 8, 6)) →
    RoutineAt<M>(site, stack, spans, room, top, blocks, bound, k + f, r, asm_labels(site.program)((k + f) + 1)) ∧
        RoutineStopsAt<M>(site, stack, spans, room, top, blocks, bound, k + f, r, asm_labels(site.program)((k + f) + 1)) {
    match routines {
        Nil => λ k f r never _ _ _ => absurd(never),
        Cons(first, rest) => λ k f => match f {
            Zero => λ r e at valid most => j(Option::some_inj(first, r, e), λ x _ => x.valid(sigs) = True →
                    ((cap: Nat) → x.Roomy(rooms_below(room, cap), room(k, cap), bound, 8, 6)) →
                    RoutineAt<M>(site, stack, spans, room, top, blocks, bound, k, x, asm_labels(site.program)(k + 1)) ∧
                    RoutineStopsAt<M>(site, stack, spans, room, top, blocks, bound, k, x, asm_labels(site.program)(k + 1)), at.left)(valid, most),
            Succ(g) => λ r e at valid most => {
                let shift: ((k + 1) + g = k + (g + 1)) = { omega };
                j(shift, λ n _ => ((cap: Nat) → r.Roomy(rooms_below(room, cap), room(n, cap), bound, 8, 6)) →
                        RoutineAt<M>(site, stack, spans, room, top, blocks, bound, n, r, asm_labels(site.program)(n + 1)) ∧
                        RoutineStopsAt<M>(site, stack, spans, room, top, blocks, bound, n, r, asm_labels(site.program)(n + 1)),
                    λ most2 => routines_at_nth<M>(site, stack, spans, room, top, blocks, sigs, bound, rest, k + 1, g, r, e, at.right, valid, most2))(most)
            },
        },
    }
}

theorem routines_valid_nth(sigs: Nat → Option<Signature>, routines: List<Routine>): (f: Nat) → (r: Routine) → routines.nth(f) = Some(r) →
    routines_valid(sigs, routines) = True → r.valid(sigs) = True {
    match routines {
        Nil => λ f r never _ => absurd(never),
        Cons(first, rest) => λ f => {
            match f {
                Zero => λ r e valid => j(Option::some_inj(first, r, e), λ x _ => x.valid(sigs) = True,
                    Bool::and_true_parts(first.valid(sigs), routines_valid(sigs, rest), valid).left),
                Succ(g) => λ r e valid => routines_valid_nth(sigs, rest, g, r, e, Bool::and_true_parts(first.valid(sigs), routines_valid(sigs, rest), valid).right),
            }
        },
    }
}

// Routine `f` of the program, as `RoutinesAt` says, with its room by the
// law.
theorem routine_of_program<M>(site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, room: Nat → Nat → Nat, top: Nat, blocks: Blocks,
    routines: List<Routine>, valid: routines_valid(program_signatures(routines), routines) = True, law: RoomLaw(routines, room),
    at: RoutinesAt<M>(site, stack, spans, room, top, blocks, program_signatures(routines), routines.len(), routines, 0), f: Nat, r: Routine,
    nth: routines.nth(f) = Some(r)):
    RoutineAt<M>(site, stack, spans, room, top, blocks, routines.len(), f, r, asm_labels(site.program)(f + 1)) ∧
        RoutineStopsAt<M>(site, stack, spans, room, top, blocks, routines.len(), f, r, asm_labels(site.program)(f + 1)) {
    let zero: (0 + f = f) = { omega };
    j(zero, λ x _ => ((cap: Nat) → r.Roomy(rooms_below(room, cap), room(x, cap), routines.len(), 8, 6)) →
            RoutineAt<M>(site, stack, spans, room, top, blocks, routines.len(), x, r, asm_labels(site.program)(x + 1)) ∧
            RoutineStopsAt<M>(site, stack, spans, room, top, blocks, routines.len(), x, r, asm_labels(site.program)(x + 1)),
        λ most => routines_at_nth<M>(site, stack, spans, room, top, blocks, program_signatures(routines), routines.len(), routines, 0, f, r, nth, at,
            routines_valid_nth(program_signatures(routines), routines, f, r, nth, valid), most))(law(f, r, nth))
}

// The induction on fuel, once: at fuel `n + 1` a routine's calls are
// answered at `n`, each entered at a depth below the caller's, so at the
// room table's depth below; the hypothesis gives their return there.
theorem program_returns<M>(site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, room: Nat → Nat → Nat, top: Nat, blocks: Blocks,
    routines: List<Routine>, valid: routines_valid(program_signatures(routines), routines) = True, law: RoomLaw(routines, room),
    at: RoutinesAt<M>(site, stack, spans, room, top, blocks, program_signatures(routines), routines.len(), routines, 0), fuel: Nat):
    (cap: Nat) → CalleesReturn<M>(site, stack, spans, λ (g: Nat) => room(g, cap), top, routines.len(),
        peak_answers(program_calls(routines, blocks, fuel), program_peaks(routines, blocks, fuel), cap + 1)) {
    match fuel {
        Zero => λ cap f below args heap a answered => absurd(answered.proof.left),
        Succ(n) => λ cap f below args heap a answered => {
            let io = answered.witness;
            let calls = program_calls(routines, blocks, n);
            let peaks = program_peaks(routines, blocks, n);
            let callees = (match cap as λ c => CalleesReturn<M>(site, stack, spans, rooms_below(room, c), top, routines.len(), peak_answers(calls, peaks, c)) {
                Zero => λ g lower args2 heap2 a2 answered2 => false_elim(Nat::not_succ_le_zero(peaks(g, args2, heap2, answered2.witness), answered2.proof.right)),
                Succ(c) => program_returns<M>(site, stack, spans, room, top, blocks, routines, valid, law, at, n, c),
            });
            (match routines.nth(f) as λ o => routines.nth(f) = o →
                (match o { None => Stuck(io), Some(r) => r.call(blocks, calls, n, args, heap, io) }) = Done(a) →
                (match o { None => 0, Some(r) => r.peak(blocks, calls, peaks, n, args, heap, io) }) + 1 <= cap + 1 →
                site.Returns(stack, asm_labels(site.program)(f + 1), RoutinePre<M>(site, stack, spans, λ (g: Nat) => room(g, cap), top, f, args, heap),
                    RoutinePost<M>(site, stack, spans, a)) {
                None => λ _ never _ => absurd(never),
                Some(r) => λ nth ran peaked => {
                    let q = r.peak(blocks, calls, peaks, n, args, heap, io);
                    let within: (q <= cap) = Nat::le_of_succ_succ(q, cap, peaked);
                    routine_of_program<M>(site, stack, spans, room, top, blocks, routines, valid, law, at, f, r, nth).left(calls, peaks, n, cap, callees, args,
                        heap, io, a, ran, within)
                },
            })(refl, answered.proof.left, answered.proof.right)
        },
    }
}

theorem pred_sub(n: Nat): n.pred() = n - 1 { match n { Zero => refl, Succ(m) => { omega } } }

// And going: at fuel `n + 1` a routine's run still going makes at least
// `n` machine steps from its entry, its calls still going at least `n - 1`
// each from theirs and the CALL one.
theorem program_stops<M>(site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, room: Nat → Nat → Nat, top: Nat, blocks: Blocks,
    routines: List<Routine>, valid: routines_valid(program_signatures(routines), routines) = True, law: RoomLaw(routines, room),
    at: RoutinesAt<M>(site, stack, spans, room, top, blocks, program_signatures(routines), routines.len(), routines, 0), x: Stop, fuel: Nat):
    (cap: Nat) → CalleesStop<M>(x, site, stack, spans, λ (g: Nat) => room(g, cap), top, routines.len(),
        peak_stops(x, program_calls(routines, blocks, fuel), program_peaks(routines, blocks, fuel), cap + 1), x.least(fuel.pred())) {
    match fuel {
        Zero => λ cap f below args heap stopped s here resident i rsp inside held ret saved =>
            Exists(s.state, Exists(0, ⟨refl, ⟨x.least_le(0), x.reached_zero(site, stack, x.zero_of(stopped.witness, stopped.proof.left),
                Running<M, True>(s.state, s.io))⟩⟩)),
        Succ(n) => λ cap f below args heap stopped => {
            let io = stopped.witness;
            let calls = program_calls(routines, blocks, n);
            let peaks = program_peaks(routines, blocks, n);
            let callees = (match cap as λ c => CalleesReturn<M>(site, stack, spans, rooms_below(room, c), top, routines.len(), peak_answers(calls, peaks, c)) {
                Zero => λ g lower args2 heap2 a2 answered2 => false_elim(Nat::not_succ_le_zero(peaks(g, args2, heap2, answered2.witness), answered2.proof.right)),
                Succ(c) => program_returns<M>(site, stack, spans, room, top, blocks, routines, valid, law, at, n, c),
            });
            let callees_stop = (match cap as λ c => CalleesStop<M>(x, site, stack, spans, rooms_below(room, c), top, routines.len(), peak_stops(x, calls, peaks, c),
                x.least(n.pred())) {
                Zero => λ g lower args2 heap2 stopped2 => false_elim(Nat::not_succ_le_zero(peaks(g, args2, heap2, stopped2.witness), stopped2.proof.right)),
                Succ(c) => program_stops<M>(site, stack, spans, room, top, blocks, routines, valid, law, at, x, n, c),
            });
            (match routines.nth(f) as λ y => routines.nth(f) = y →
                (match y { None => Stuck(io), Some(r) => r.call(blocks, calls, n, args, heap, io) }).stopped() = Some(x) →
                (match y { None => 0, Some(r) => r.peak(blocks, calls, peaks, n, args, heap, io) }) + 1 <= cap + 1 →
                site.EntersClaim(stack, Kernel::none<M, True>(), 0, x.least(n), asm_labels(site.program)(f + 1),
                    λ (i: Nat) (s: Running<M, True>) => RoutinePre<M>(site, stack, spans, λ (g: Nat) => room(g, cap), top, f, args, heap)(i, s.state) ∧ True,
                    λ (_: Nat) (_: Running<M, True>) (_: BitVec(64)) (t: Running<M, True>) => x.Reached(site, stack)(t)) {
                None => λ _ never _ => absurd(never),
                Some(r) => λ nth ran peaked => {
                    let q = r.peak(blocks, calls, peaks, n, args, heap, io);
                    let within: (q <= cap) = Nat::le_of_succ_succ(q, cap, peaked);
                    routine_of_program<M>(site, stack, spans, room, top, blocks, routines, valid, law, at, f, r, nth).right(calls, peaks, n, cap, callees, x,
                        x.least(n.pred()), callees_stop, x.least_pred(n), args, heap, io, ran, within)
                },
            })(refl, stopped.proof.left, stopped.proof.right)
        },
    }
}

theorem answered_args(words: List<BitVec(64)>, gprs: Gprs, held: Answered(answer_head(words), answer_tail(words), gprs)):
    ArgsIn(words, Cons(Rax, answer_registers()), gprs) {
    match words { Nil => trivial, Cons(_, _) => held }
}

// The one clause, from the two inductions: entered as the contract says,
// at a depth with its room, the code of routine `f` returns where the run
// at fuel `n` is done, at no system call, in the world it was entered in;
// makes at least `n - 1` machine steps where the run is still going, its
// world the run's; and the run never exits.
theorem program_tracks<M>(site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, room: Nat → Nat → Nat, top: Nat, blocks: Blocks,
    p: Program, valid: p.valid() = True, scoped: Scoped::all(p.routines), law: RoomLaw(p.routines, room),
    at: Loan<M>(site.fetch, site.data, stack, top, spans) → blocks.Lent(spans) →
        RoutinesAt<M>(site, stack, spans, room, top, blocks, program_signatures(p.routines), p.routines.len(), p.routines, 0)):
    site.Tracks(stack, spans, top, blocks.Lent(spans), room,
        λ (n: Nat) (f: Nat) (args: List<Value>) (heap: Heap) (io: Io) => run_peak(p, blocks, n, f, args, heap, io), p.routines.len(),
        λ (n: Nat) (f: Nat) (args: List<Value>) (heap: Heap) (io: Io) => run(p, blocks, n, f, args, heap, io)) {
    λ loan lent f below args heap io s here resident i rsp inside passed high injected ret saved n roomy answerable => {
        let all = at(loan, lent);
        let peak = run_peak(p, blocks, n, f, args, heap, io);
        let pre: RoutinePre<M>(site, stack, spans, λ (g: Nat) => room(g, peak), top, f, args, heap)(i, s) = ⟨⟨passed, roomy⟩, ⟨high, injected⟩⟩;
        (match run(p, blocks, n, f, args, heap, io) as λ x => run(p, blocks, n, f, args, heap, io) = x → site.Tracked(stack, spans, s, i, ret, io, n, x) {
            Done(a) => λ ran => {
                let returns = program_returns<M>(site, stack, spans, room, top, blocks, p.routines, valid, law, all, n, peak, f, below, args, heap, a,
                    Exists(io, ⟨ran, (peak + 1).le_refl()⟩));
                let got = returns(s, here, resident, i, rsp, inside, pre, ret, saved);
                let post = got.proof.right.right.right.right;
                let world: (a.io = io) = program_quiet(p.routines, blocks, scoped, n, f, args, heap, io, a, ran);
                Exists(0, site.performs_steps(stack.writes, site.linux_kernel(stack), λ r => site.Returned(stack, spans, s, i, ret, a, r), Running(s, io),
                    got.witness, got.proof.left, ⟨⟨got.proof.right.left, ⟨got.proof.right.right.left, got.proof.right.right.right.left⟩⟩,
                        ⟨⟨answered_args(lower_values(spans, a.words), got.witness.gprs, post.left), post.right.left⟩,
                         ⟨⟨post.right.right.left, post.right.right.right⟩, sym(world)⟩⟩⟩))
            },
            Exited(status, o) => λ ran => {
                let x = StopExited(status, o);
                let stopped: (run(p, blocks, n, f, args, heap, io).stopped() = Some(x)) = cong_fn<Ran<Answer>, Option<Stop>>(λ r => r.stopped(), ran);
                let went = program_stops<M>(site, stack, spans, room, top, blocks, p.routines, valid, law, all, x, n, peak, f, below, args, heap,
                    Exists(io, ⟨stopped, (peak + 1).le_refl()⟩))(Running<M, True>(s, trivial), here, resident, i, rsp, inside, ⟨pre, trivial⟩, ret, saved);
                let quiet: (o = io) = program_stop_quiet(p.routines, blocks, scoped, n, f, args, heap, io, x, stopped);
                Exists(0, Exists(went.witness, Exists(went.proof.witness, ⟨went.proof.proof.left, ⟨trivial, ⟨went.proof.proof.right.right, sym(quiet)⟩⟩⟩)))
            },
            Going(o) => λ ran => {
                let x = StopGoing(o);
                let stopped: (run(p, blocks, n, f, args, heap, io).stopped() = Some(x)) = cong_fn<Ran<Answer>, Option<Stop>>(λ r => r.stopped(), ran);
                let went = program_stops<M>(site, stack, spans, room, top, blocks, p.routines, valid, law, all, x, n, peak, f, below, args, heap,
                    Exists(io, ⟨stopped, (peak + 1).le_refl()⟩))(Running<M, True>(s, trivial), here, resident, i, rsp, inside, ⟨pre, trivial⟩, ret, saved);
                let quiet: (o = io) = program_stop_quiet(p.routines, blocks, scoped, n, f, args, heap, io, x, stopped);
                let steps = went.proof.witness;
                let counted: (n - 1 <= steps) = j(pred_sub(n), λ k _ => k <= steps, went.proof.proof.right.left);
                Exists(0, Exists(went.witness, Exists(steps, ⟨went.proof.proof.left, ⟨counted, sym(quiet)⟩⟩)))
            },
            Stuck(_) => λ ran => Exists(0, Exists(s, Exists(0, ⟨refl, ⟨trivial, trivial⟩⟩))),
        })(refl)
    }
}

theorem emit_routines_scoped(routines: List<Routine>, bound: Nat): (prog: Prog) → (k: Nat) → (placement: List<Place>) → (names: Nat) →
    emit_routines(prog, routines, k, bound, placement, names).All(λ (_: Emitted) => Scoped::all(routines)) {
    match routines {
        Nil => λ prog k placement names => trivial,
        Cons(r, rest) => λ prog k placement names =>
            (match r.emit(prog, k, bound, placement, names) as λ e => (r.emit(prog, k, bound, placement, names) = e) →
                (match e { None => None, Some(out) => emit_routines(out.prog, rest, k + 1, bound, out.placement, out.names) }).All(λ (_: Emitted) =>
                    Scoped::all(Cons(r, rest))) {
                None => λ _ => trivial,
                Some(out) => λ emitted => (match emit_routines(out.prog, rest, k + 1, bound, out.placement, out.names) as λ e =>
                    e.All(λ (_: Emitted) => Scoped::all(rest)) → e.All(λ (_: Emitted) => Scoped::all(Cons(r, rest))) {
                    None => λ _ => trivial,
                    Some(_) => λ more => ⟨r.emit_scoped(prog, k, bound, placement, names, out, emitted), more⟩,
                })(emit_routines_scoped(rest, bound, out.prog, k + 1, out.placement, out.names)),
            })(refl),
    }
}

theorem Program::lower_scoped(self p: Program, placement: List<Place>, program: Prog, lowered: p.lower(placement) = Some(program)): Scoped::all(p.routines) {
    let bound = p.routines.len();
    (match p.valid() as λ b => (match b { False => None, True => match emit_routines(Start, p.routines, 0, bound, placement, bound) {
            None => None,
            Some(out) => match out.prog.laid_out() { False => None, True => Some(out.prog) },
        } }) = Some(program) → Scoped::all(p.routines) {
        False => λ never => absurd(never),
        True => λ e => (match emit_routines(Start, p.routines, 0, bound, placement, bound) as λ o =>
            o.All(λ (_: Emitted) => Scoped::all(p.routines)) →
            (match o { None => None, Some(out) => match out.prog.laid_out() { False => None, True => Some(out.prog) } }) = Some(program) →
            Scoped::all(p.routines) {
            None => λ _ never => absurd(never),
            Some(out) => λ scoped _ => scoped,
        })(emit_routines_scoped(p.routines, bound, Start, 0, placement, bound), e),
    })(lowered)
}

// ---------------------------------------------------------------------------
// The theorem

// Proved once: whatever the placement, a program `Program::lower` returns,
// resident at any origin, with any stack meeting the stack laws and its
// blocks lent under the lending laws, the blocks it may write among those
// lent, tracks its meaning (`Site::Tracks`) for each of its routines at
// every fuel, under every lawful room table.
theorem lower_program_tracks<M>(p: Program, placement: List<Place>, program: Prog, lowered: p.lower(placement) = Some(program),
    fetch: FetchAccess<M>, data: ByteReadAccess<M>, last: List<BitVec(8)>, origin: BitVec(64), stack: Stack<M>(fetch, data), top: Nat, spans: Spans,
    blocks: Blocks, room: Nat → Nat → Nat, law: RoomLaw(p.routines, room)):
    Site<M>(fetch, data, program, last, origin).Tracks(stack, spans, top, blocks.Lent(spans), room,
        λ (n: Nat) (f: Nat) (args: List<Value>) (heap: Heap) (io: Io) => run_peak(p, blocks, n, f, args, heap, io), p.routines.len(),
        λ (n: Nat) (f: Nat) (args: List<Value>) (heap: Heap) (io: Io) => run(p, blocks, n, f, args, heap, io)) {
    let bound = p.routines.len();
    let sigs = program_signatures(p.routines);
    let scoped = p.lower_scoped(placement, program, lowered);
    let Goal = λ (q: Prog) => Site<M>(fetch, data, q, last, origin).Tracks(stack, spans, top, blocks.Lent(spans), room,
        λ (n: Nat) (f: Nat) (args: List<Value>) (heap: Heap) (io: Io) => run_peak(p, blocks, n, f, args, heap, io), bound,
        λ (n: Nat) (f: Nat) (args: List<Value>) (heap: Heap) (io: Io) => run(p, blocks, n, f, args, heap, io));
    (match v: p.valid() as λ b => (match b { False => None, True => match emit_routines(Start, p.routines, 0, bound, placement, bound) {
            None => None,
            Some(out) => match out.prog.laid_out() { False => None, True => Some(out.prog) },
        } }) = Some(program) → Goal(program) {
        False => λ never => absurd(never),
        True => λ e => (match emit_routines(Start, p.routines, 0, bound, placement, bound) as λ o =>
            ((site: Site<M>) → site.program.laid_out().IsTrue() → (st: Stack<M>(site.fetch, site.data)) → Loan<M>(site.fetch, site.data, st, top, spans) →
                blocks.Lent(spans) → MayRoutinesReturn<M>(site, st, spans, room, top, blocks, sigs, bound, p.routines, 0, Start, o)) →
            (match o { None => None, Some(out) => match out.prog.laid_out() { False => None, True => Some(out.prog) } }) = Some(program) → Goal(program) {
            None => λ _ never => absurd(never),
            Some(out) => λ emitted => (match l: out.prog.laid_out() as λ b => (match b { False => None, True => Some(out.prog) }) = Some(program) →
                Goal(program) {
                False => λ never => absurd(never),
                True => λ found => j(Option::some_inj(out.prog, program, found), λ q _ => Goal(q), {
                    let site = Site<M>(fetch, data, out.prog, last, origin);
                    let laid = is_true_of_eq(out.prog.laid_out(), l);
                    program_tracks<M>(site, stack, spans, room, top, blocks, p, v, scoped, law,
                        λ loan lent => emitted(site, laid, stack, loan, lent).right.right(out.prog.within_self()))
                }),
            }),
        })(λ site laid st ln lt => emit_routines_returns<M>(site, laid, st, top, spans, ln, blocks, lt, room, sigs, bound, p.routines, Start, 0, placement,
            bound), e),
    })(lowered)
}

// The done and exited clauses, `Tracks` read where the meaning is done and
// where it exits, at the table by depth.
theorem lower_program_meets_done<M>(p: Program, placement: List<Place>, program: Prog, lowered: p.lower(placement) = Some(program),
    fetch: FetchAccess<M>, data: ByteReadAccess<M>, last: List<BitVec(8)>, origin: BitVec(64), stack: Stack<M>(fetch, data), top: Nat, spans: Spans,
    blocks: Blocks):
    Site<M>(fetch, data, program, last, origin).MeetsDone(stack, spans, top, blocks.Lent(spans), depth_rooms(p.routines),
        λ (n: Nat) (f: Nat) (args: List<Value>) (heap: Heap) (io: Io) => run_peak(p, blocks, n, f, args, heap, io), p.routines.len(),
        λ (n: Nat) (f: Nat) (args: List<Value>) (heap: Heap) (io: Io) => run(p, blocks, n, f, args, heap, io)) {
    Site<M>(fetch, data, program, last, origin).tracks_done(stack, spans, top, blocks.Lent(spans), depth_rooms(p.routines),
        λ (n: Nat) (f: Nat) (args: List<Value>) (heap: Heap) (io: Io) => run_peak(p, blocks, n, f, args, heap, io), p.routines.len(),
        λ (n: Nat) (f: Nat) (args: List<Value>) (heap: Heap) (io: Io) => run(p, blocks, n, f, args, heap, io),
        lower_program_tracks<M>(p, placement, program, lowered, fetch, data, last, origin, stack, top, spans, blocks, depth_rooms(p.routines),
            depth_rooms_lawful(p.routines)))
}

theorem lower_program_meets_exited<M>(p: Program, placement: List<Place>, program: Prog, lowered: p.lower(placement) = Some(program),
    fetch: FetchAccess<M>, data: ByteReadAccess<M>, last: List<BitVec(8)>, origin: BitVec(64), stack: Stack<M>(fetch, data), top: Nat, spans: Spans,
    blocks: Blocks):
    Site<M>(fetch, data, program, last, origin).MeetsExited(stack, spans, top, blocks.Lent(spans), depth_rooms(p.routines),
        λ (n: Nat) (f: Nat) (args: List<Value>) (heap: Heap) (io: Io) => run_peak(p, blocks, n, f, args, heap, io), p.routines.len(),
        λ (n: Nat) (f: Nat) (args: List<Value>) (heap: Heap) (io: Io) => run(p, blocks, n, f, args, heap, io)) {
    Site<M>(fetch, data, program, last, origin).tracks_exited(stack, spans, top, blocks.Lent(spans), depth_rooms(p.routines),
        λ (n: Nat) (f: Nat) (args: List<Value>) (heap: Heap) (io: Io) => run_peak(p, blocks, n, f, args, heap, io), p.routines.len(),
        λ (n: Nat) (f: Nat) (args: List<Value>) (heap: Heap) (io: Io) => run(p, blocks, n, f, args, heap, io),
        lower_program_tracks<M>(p, placement, program, lowered, fetch, data, last, origin, stack, top, spans, blocks, depth_rooms(p.routines),
            depth_rooms_lawful(p.routines)))
}

// The contract, all three clauses (`Site::tracks_meets`), at the table by
// depth.
theorem lower_program_meets<M>(p: Program, placement: List<Place>, program: Prog, lowered: p.lower(placement) = Some(program), fetch: FetchAccess<M>,
    data: ByteReadAccess<M>, last: List<BitVec(8)>, origin: BitVec(64), stack: Stack<M>(fetch, data), top: Nat, spans: Spans, blocks: Blocks):
    Site<M>(fetch, data, program, last, origin).Meets(stack, spans, top, blocks.Lent(spans), depth_rooms(p.routines),
        λ (n: Nat) (f: Nat) (args: List<Value>) (heap: Heap) (io: Io) => run_peak(p, blocks, n, f, args, heap, io), p.routines.len(),
        λ (n: Nat) (f: Nat) (args: List<Value>) (heap: Heap) (io: Io) => run(p, blocks, n, f, args, heap, io)) {
    Site<M>(fetch, data, program, last, origin).tracks_meets(stack, spans, top, blocks.Lent(spans), depth_rooms(p.routines),
        λ (n: Nat) (f: Nat) (args: List<Value>) (heap: Heap) (io: Io) => run_peak(p, blocks, n, f, args, heap, io), p.routines.len(),
        λ (n: Nat) (f: Nat) (args: List<Value>) (heap: Heap) (io: Io) => run(p, blocks, n, f, args, heap, io),
        lower_program_tracks<M>(p, placement, program, lowered, fetch, data, last, origin, stack, top, spans, blocks, depth_rooms(p.routines),
            depth_rooms_lawful(p.routines)))
}

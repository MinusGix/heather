// What the translation of FunctionIR programs to the bytes level
// preserves (issues/bytes-level-translation.md, item 3;
// docs/language/ownership-design.md §17.8): every `Done` of the translation
// is the old run, with the buffers read back from the answer's heap.
//
// The heap is the buffers: each block is its buffer (`HomesHeld`), and a
// scope's homes are references to their blocks from 0. The old valuation
// and the bytes level's words agree on every old id that holds no
// reference (`Agree`), except ids pending: those whose write the translation
// dropped because a later node of the leaf writes them again first.
// - The memory nodes, stage by stage: a byte load's `Offset` and `Load(1)`
//   (`byte_load_runs`), a byte store's `Offset`, `Store(1)` and the byte
//   loaded back (`byte_store_runs`).
// - A node, any form but a wide access: the relation kept, the old node's
//   run (`node_agrees`; `pure_agrees`, `load_agrees`, `store_agrees`).
// - A leaf of such nodes, translated to one leaf (no guard): its run
//   (`leaf_runs_as_old`).
// - Bodies the translation joins split into their parts' runs
//   (`seq_bodies_done`).
// - A call of one result: its arguments agree with the old words, a lent
//   callee given its homes' references and lengths (`read_lent`,
//   `ArgsAgree`), and where the callees agree with the old ones
//   (`CallsAgree`), the call does (`call_agrees`). A branch
//   (`branch_agrees`).
// - A region of leaves, sequences, compositions, conditionals and calls
//   (`region_owes`), under premises that mirror its translation
//   (`RegionFits`): no loop, no lend, no guarded load, no wide access, one
//   result per call, and each part's ids old words where it reads them.
// - A routine's entry: its parameters bound to arguments that agree with the
//   old words (`entry_binds`), and its `Done` the old function's run
//   (`function_owes`), for a function of no levels, no fixed span and one
//   result (`FunctionFits`).
// - The program: every `Done` of `translate_program(functions)`, at any
//   fuel and any function, is `program_run(functions)`'s, its words the old
//   words and its heap the buffers the old run left
//   (`translated_runs_as_old`), where every function fits
//   (`ProgramFits`). The induction is over the program's functions, not
//   over fuel: a routine's calls go only below it, so the last function's
//   are answered by the theorem for the rest (`program_calls_agree`).
// What this does not cover yet is the issue's log.
import bytes_level;
import bytes_memory;
import bytes_level_scope;
import bytes_level_lower;
import bytes_level_from_function_ir;
import x86_64_memory_contract;
import x86_64_call_contract;
import x86_64_store;
import function_ir;
import function_ir_eval;
import function_ir_state;
import function_ir_pass;
import function_ir_lower::{Known};
import function_ir_lower_reads;
import function_ir_lower_calls;
import function_ir_run;
import linux_world;
import list;
import list_window;
import bitvec;
import bool;
import logic;
import nat;
import option;
import omega;

// ---------------------------------------------------------------------------
// A byte read from a block that is a buffer

// The byte a load reads at offset `i` of block `k` is the buffer's byte
// `i`, as `BufferLoad` reads it, whatever the buffer's length: a read that
// answers lies inside the block.
theorem byte_read_is(heap: Heap, buffers: Buffers(), k, i: Nat, same: heap.bytes(k) = buffer_bytes(buffers, k), bytes: List<BitVec(8)>,
    read: heap.read_bytes(Loc(k, i), 1) = Some(bytes)): word_of_bytes(bytes) = byte_word(buffer_byte(buffers, k, i)) {
    let facts = heap.read_bytes_some(Loc(k, i), 1, bytes, read);
    let one = word_of_one(bytes, heap.read_bytes_len(Loc(k, i), 1, bytes, read));
    let window: (heap.bytes(k).window(i, i + 1).nth(0) = heap.bytes(k).nth(0 + i)) = heap.bytes(k).nth_window(i, i + 1, 0, omega());
    let first: (bytes.nth(0) = buffer_bytes(buffers, k).nth(i)) =
        trans(cong_fn<List<BitVec(8)>, Option<BitVec(8)>>(λ l => l.nth(0), sym(facts.right.right.right)),
            trans(window, trans(cong_fn<Nat, Option<BitVec(8)>>(λ x => heap.bytes(k).nth(x), omega()),
                cong_fn<List<BitVec(8)>, Option<BitVec(8)>>(λ l => l.nth(i), same))));
    let unwrap = λ (o: Option<BitVec(8)>) => match o { None => BitVec::zero(), Some(b) => b };
    let byte: (byte_at(bytes, 0) = buffer_byte(buffers, k, i)) =
        trans(cong_fn<Option<BitVec(8)>, BitVec(8)>(unwrap, first), sym(buffer_byte_entry(buffers, k, i)));
    trans(one, cong_fn<BitVec(8), BitVec(64)>(λ b => b.zero_extend(56), byte))
}

// ---------------------------------------------------------------------------
// The translated byte load

// The reference `amount` past `place`'s, as `Offset` sets it.
theorem offset_ref(c: Config, output, place, amount: Nat, loc: Loc, at: c.locals.refs(place) = Some(loc), blocks: Blocks):
    bytes_level::Offset(output, place, amount).step(blocks, c) =
        Some(Config(c.locals.set_ref(output, Loc(loc.block, loc.offset + c.locals.word(amount).toNat())), c.memory, c.io)) {
    j(sym(at), λ o _ => o.and_then(λ (l: Loc) => Some(Config(c.locals.set_ref(output, Loc(l.block, l.offset + c.locals.word(amount).toNat())), c.memory, c.io))) =
        Some(Config(c.locals.set_ref(output, Loc(loc.block, loc.offset + c.locals.word(amount).toNat())), c.memory, c.io)), refl)
}

// The translation of `BufferLoad(output, k, index)` at the home whose
// reference is block `k` from 0, run to an end: the reference `t` set, the
// output what the old node gives it, nothing else changed.
fn load_end(c: Config, buffers: Buffers(), k, index, output, t: Nat) → Config {
    Config(c.locals.set_ref(t, Loc(k, 0 + c.locals.word(index).toNat())).set_word(output, load_value(buffers, k, index, c.locals.words)), c.memory, c.io)
}

theorem byte_load_runs(blocks: Blocks, c: Config, buffers: Buffers(), k, base, index, output, t: Nat, at: c.locals.refs(base) = Some(Loc(k, 0)),
    same: c.memory.bytes(k) = buffer_bytes(buffers, k), after: Config,
    ran: run_instrs(blocks, [bytes_level::Offset(t, base, index), bytes_level::Load(1, 64, output, t)], c) = Some(after)): after = load_end(c, buffers, k, index, output, t) {
    let loc = Loc(k, 0 + c.locals.word(index).toNat());
    let mid = Config(c.locals.set_ref(t, loc), c.memory, c.io);
    let first = offset_ref(c, t, base, index, Loc(k, 0), at, blocks);
    let here: (mid.locals.refs(t) = Some(loc)) = j(sym(t.same_self()), λ b _ => (match b { True => Some(loc), False => c.locals.refs(t) }) = Some(loc), refl);
    let rest: (run_instrs(blocks, [bytes_level::Load(1, 64, output, t)], mid) = Some(after)) =
        j(first, λ o _ => o.and_then(λ (m: Config) => run_instrs(blocks, [bytes_level::Load(1, 64, output, t)], m)) = Some(after), ran);
    let loaded = λ (m: Heap) (x: Option<BitVec(64)>) => x.and_then(λ (y: BitVec(64)) =>
        Some(Config(mid.locals.set_word(output, word_value(y)), m, mid.io)));
    let step: (loaded(c.memory, c.memory.load(loc, 1)).and_then(λ (m: Config) => run_instrs(blocks, [], m)) = Some(after)) =
        j(here, λ o _ => o.and_then(λ (l: Loc) => loaded(c.memory, c.memory.load(l, 1))).and_then(λ (m: Config) => run_instrs(blocks, [], m)) =
            Some(after), rest);
    (match c.memory.load(loc, 1) as λ o => c.memory.load(loc, 1) = o → loaded(c.memory, o).and_then(λ (m: Config) => run_instrs(blocks, [], m)) = Some(after) →
            after = load_end(c, buffers, k, index, output, t) {
        None => λ _ never => absurd(never),
        Some(x) => λ found done => {
            let end = Option::some_inj(Config(mid.locals.set_word(output, word_value(x)), c.memory, c.io), after, done);
            let read = c.memory.load_some(loc, 1, x, found);
            let zero: (0 + c.locals.word(index).toNat() = c.locals.word(index).toNat()) = omega();
            let byte: (x = byte_word(buffer_byte(buffers, k, c.locals.words(64, index).toNat()))) =
                trans(sym(read.proof.right), byte_read_is(c.memory, buffers, k, c.locals.word(index).toNat(), same, read.witness,
                    j(cong_fn<Nat, Loc>(λ o => Loc(k, o), zero), λ l _ => c.memory.read_bytes(l, 1) = Some(read.witness), read.proof.left)));
            trans(sym(end), cong_fn<BitVec(64), Config>(λ y => Config(mid.locals.set_word(output, word_value(y)), c.memory, c.io), byte))
        },
    })(refl, step)
}

// ---------------------------------------------------------------------------
// A byte written into a block that is a buffer

// One byte placed at offset `i` of block `k` leaves the block the buffer
// with its byte `i` stored (`store_byte`), and every other block as it was.
theorem byte_placed_is(heap: Heap, buffers: Buffers(), k, i: Nat, b: BitVec(8), same: heap.bytes(k) = buffer_bytes(buffers, k),
    fits: i + 1 <= heap.bytes(k).len()): heap.placed(Loc(k, i), Piece::plain([b])).bytes(k) = buffer_bytes(store_byte(buffers, k, i, b), k) {
    let inside: (i < heap.bytes(k).len()) = omega(fits);
    trans(heap.placed_bytes(Loc(k, i), Piece::plain([b]), fits, k),
        trans(set_block_here(λ (d: Nat) => heap.bytes(d), k, heap.bytes(k).put_window(i, [b])),
            trans(heap.bytes(k).put_window_cons(i, b, Nil, inside),
                trans(heap.bytes(k).update(i, λ (_: BitVec(8)) => b).put_window_nil(i + 1),
                    trans(cong_fn<List<BitVec(8)>, List<BitVec(8)>>(λ l => l.update(i, λ (_: BitVec(8)) => b), same),
                        sym(buffer_bytes_stored(buffers, k, i, b)))))))
}

theorem byte_placed_other(heap: Heap, k, i: Nat, b: BitVec(8), fits: i + 1 <= heap.bytes(k).len(), other: Nat, differs: other ≠ k):
    heap.placed(Loc(k, i), Piece::plain([b])).bytes(other) = heap.bytes(other) {
    trans(heap.placed_bytes(Loc(k, i), Piece::plain([b]), fits, other),
        set_block_other(λ (d: Nat) => heap.bytes(d), k, heap.bytes(k).put_window(i, [b]), other, differs))
}

// ---------------------------------------------------------------------------
// The translated byte store

// What a store's run leaves, where it answers: the heap with its byte
// placed, inside its block.
theorem store_step(blocks: Blocks, c: Config, place, value: Nat, loc: Loc, at: c.locals.refs(place) = Some(loc), after: Config,
    stepped: bytes_level::Store(1, 64, place, value).step(blocks, c) = Some(after)):
    (after.locals = c.locals) ∧ ((after.memory = c.memory.placed(loc, Piece::plain(low_bytes(1, c.locals.word(value))))) ∧
        (loc.offset + 1 <= c.memory.bytes(loc.block).len())) {
    let piece = Piece::plain(low_bytes(1, c.locals.word(value)));
    let put = λ (l: Loc) => c.memory.put(blocks.written, l, piece).and_then(λ (m: Heap) => Some(Config(c.locals, m, c.io)));
    let stepped2: (put(loc) = Some(after)) = j(at, λ o _ => o.and_then(put) = Some(after), stepped);
    (match c.memory.put(blocks.written, loc, piece) as λ o => c.memory.put(blocks.written, loc, piece) = o →
            o.and_then(λ (m: Heap) => Some(Config(c.locals, m, c.io))) = Some(after) →
            (after.locals = c.locals) ∧ ((after.memory = c.memory.placed(loc, piece)) ∧ (loc.offset + 1 <= c.memory.bytes(loc.block).len())) {
        None => λ _ never => absurd(never),
        Some(m) => λ found done => {
            let end = Option::some_inj(Config(c.locals, m, c.io), after, done);
            let facts = c.memory.put_some(blocks.written, loc, piece, m, found);
            ⟨cong_fn<Config, Locals>(λ x => x.locals, sym(end)),
                ⟨trans(cong_fn<Config, Heap>(λ x => x.memory, sym(end)), sym(facts.right.right)), c.memory.fits_parts(loc, 1, facts.right.left).left⟩⟩
        },
    })(refl, stepped2)
}

// The translation of `BufferStore(output, k, index, value)` at the home
// whose reference is block `k` from 0, run to an end: block `k` is the old
// buffer after the store, every other block as it was, and the output is
// what the old node gives it, at every width.
theorem byte_store_runs(blocks: Blocks, c: Config, buffers: Buffers(), k, base, index, value, output, t: Nat, at: c.locals.refs(base) = Some(Loc(k, 0)),
    same: c.memory.bytes(k) = buffer_bytes(buffers, k), after: Config,
    ran: run_instrs(blocks, [bytes_level::Offset(t, base, index), bytes_level::Store(1, 64, t, value), bytes_level::Load(1, 64, output, t)], c) = Some(after)):
    (after.memory.bytes(k) = buffer_bytes(store_byte(buffers, k, c.locals.words(64, index).toNat(), low_byte(c.locals.words(64, value))), k)) ∧
        (((other: Nat) → other ≠ k → after.memory.bytes(other) = c.memory.bytes(other)) ∧
            (after.locals = c.locals.set_ref(t, Loc(k, 0 + c.locals.word(index).toNat())).set_word(output,
                load_value(store_byte(buffers, k, c.locals.words(64, index).toNat(), low_byte(c.locals.words(64, value))), k, index, c.locals.words)))) {
    let i = c.locals.word(index).toNat();
    let loc = Loc(k, 0 + i);
    let mid = Config(c.locals.set_ref(t, loc), c.memory, c.io);
    let first = offset_ref(c, t, base, index, Loc(k, 0), at, blocks);
    let here: (mid.locals.refs(t) = Some(loc)) = j(sym(t.same_self()), λ b _ => (match b { True => Some(loc), False => c.locals.refs(t) }) = Some(loc), refl);
    let rest: (run_instrs(blocks, [bytes_level::Store(1, 64, t, value), bytes_level::Load(1, 64, output, t)], mid) = Some(after)) =
        j(first, λ o _ => o.and_then(λ (m: Config) => run_instrs(blocks, [bytes_level::Store(1, 64, t, value), bytes_level::Load(1, 64, output, t)], m)) = Some(after), ran);
    (match bytes_level::Store(1, 64, t, value).step(blocks, mid) as λ o => bytes_level::Store(1, 64, t, value).step(blocks, mid) = o →
            o.and_then(λ (m: Config) => run_instrs(blocks, [bytes_level::Load(1, 64, output, t)], m)) = Some(after) →
            (after.memory.bytes(k) = buffer_bytes(store_byte(buffers, k, c.locals.words(64, index).toNat(), low_byte(c.locals.words(64, value))), k)) ∧
            (((other: Nat) → other ≠ k → after.memory.bytes(other) = c.memory.bytes(other)) ∧
                (after.locals = c.locals.set_ref(t, Loc(k, 0 + c.locals.word(index).toNat())).set_word(output,
                    load_value(store_byte(buffers, k, c.locals.words(64, index).toNat(), low_byte(c.locals.words(64, value))), k, index, c.locals.words)))) {
        None => λ _ never => absurd(never),
        Some(stored) => λ stepped done => {
            let facts = store_step(blocks, mid, t, value, loc, here, stored, stepped);
            let zero: (0 + i = i) = omega();
            let byte = low_byte(c.locals.words(64, value));
            let after_buffers = store_byte(buffers, k, i, byte);
            let fits: (i + 1 <= c.memory.bytes(k).len()) = j(zero, λ x _ => x + 1 <= c.memory.bytes(k).len(), facts.right.right);
            let placed: (stored.memory = c.memory.placed(Loc(k, i), Piece::plain([byte]))) =
                j(cong_fn<Nat, Loc>(λ o => Loc(k, o), zero), λ l _ => stored.memory = c.memory.placed(l, Piece::plain([byte])), facts.right.left);
            let block: (stored.memory.bytes(k) = buffer_bytes(after_buffers, k)) =
                trans(cong_fn<Heap, List<BitVec(8)>>(λ m => m.bytes(k), placed), byte_placed_is(c.memory, buffers, k, i, byte, same, fits));
            // The load back, from the stored heap: the byte as the old node's
            // output reads it.
            let loaded = λ (x: Option<BitVec(64)>) => x.and_then(λ (y: BitVec(64)) => Some(Config(stored.locals.set_word(output, word_value(y)), stored.memory, stored.io)));
            let ref_t: (stored.locals.refs(t) = Some(loc)) = trans(cong_fn<Locals, Option<Loc>>(λ l => l.refs(t), facts.left), here);
            let step: (loaded(stored.memory.load(loc, 1)).and_then(λ (m: Config) => run_instrs(blocks, [], m)) = Some(after)) =
                j(ref_t, λ o _ => o.and_then(λ (l: Loc) => loaded(stored.memory.load(l, 1))).and_then(λ (m: Config) => run_instrs(blocks, [], m)) = Some(after), done);
            (match stored.memory.load(loc, 1) as λ o => stored.memory.load(loc, 1) = o → loaded(o).and_then(λ (m: Config) => run_instrs(blocks, [], m)) = Some(after) →
                    (after.memory.bytes(k) = buffer_bytes(after_buffers, k)) ∧
                    (((other: Nat) → other ≠ k → after.memory.bytes(other) = c.memory.bytes(other)) ∧
                        (after.locals = c.locals.set_ref(t, loc).set_word(output, load_value(after_buffers, k, index, c.locals.words)))) {
                None => λ _ never => absurd(never),
                Some(x) => λ found finished => {
                    let end = Option::some_inj(Config(stored.locals.set_word(output, word_value(x)), stored.memory, stored.io), after, finished);
                    let read = stored.memory.load_some(loc, 1, x, found);
                    let value_is: (x = byte_word(buffer_byte(after_buffers, k, i))) =
                        trans(sym(read.proof.right), byte_read_is(stored.memory, after_buffers, k, i, block, read.witness,
                            j(cong_fn<Nat, Loc>(λ o => Loc(k, o), zero), λ l _ => stored.memory.read_bytes(l, 1) = Some(read.witness), read.proof.left)));
                    let memory: (after.memory = stored.memory) = cong_fn<Config, Heap>(λ m => m.memory, sym(end));
                    ⟨trans(cong_fn<Heap, List<BitVec(8)>>(λ m => m.bytes(k), memory), block),
                        ⟨λ other differs => trans(cong_fn<Heap, List<BitVec(8)>>(λ m => m.bytes(other), memory),
                                trans(cong_fn<Heap, List<BitVec(8)>>(λ m => m.bytes(other), placed), byte_placed_other(c.memory, k, i, byte, fits, other, differs))),
                            trans(cong_fn<Config, Locals>(λ m => m.locals, sym(end)),
                                trans(cong_fn<Locals, Locals>(λ l => l.set_word(output, word_value(x)), facts.left),
                                    cong_fn<BitVec(64), Locals>(λ y => mid.locals.set_word(output, word_value(y)), value_is)))⟩⟩
                },
            })(refl, step)
        },
    })(refl, rest)
}

// ---------------------------------------------------------------------------
// The relation

// Every id below `bound` that holds no reference and is not pending holds,
// at every width, what the old valuation gives it. An id is pending where
// the translation dropped a write a later node of the leaf makes again
// before anything reads it (`rebound`).
fn Agree(bound: Nat, refs, pending: List<Nat>, words, values: Valuation()) → Type {
    (x: Nat) → x < bound → mem_nat(x, refs) = False → mem_nat(x, pending) = False → (w: Nat) → words(w, x) = values(w, x)
}

// Each home's reference is its block from 0, and each block is its buffer.
fn HomesHeld(homes: List<Lent>, c: Config, buffers: Buffers()) → Type {
    ((h: Lent) → Mem(h, homes) → c.locals.refs(h.base) = Some(Loc(h.buffer, 0))) ∧ ((b: Nat) → c.memory.bytes(b) = buffer_bytes(buffers, b))
}

// What a node asks of the ids around it: what it reads is an old word that
// agrees, its output an old word, and the translation's own id `t` past
// every old id.
fn Fits(bound: Nat, refs, pending: List<Nat>, node: Node, t: Nat) → Type {
    ((id: Nat) → Mem(id, function_ir_eval::Node::reads(node)) → (id < bound) ∧ ((mem_nat(id, refs) = False) ∧ (mem_nat(id, pending) = False))) ∧
        ((node_output(node).id < bound) ∧ (bound <= t))
}

fn unpend(pending: List<Nat>, id: Nat) → List<Nat> {
    match pending { Nil => Nil, Cons(x, rest) => match x.same(id) { True => unpend(rest, id), False => Cons(x, unpend(rest, id)) } }
}

theorem unpend_other(pending: List<Nat>, id, x: Nat, differs: x ≠ id): mem_nat(x, unpend(pending, id)) = False → mem_nat(x, pending) = False {
    match pending {
        Nil => λ _ => refl,
        Cons(y, rest) => match same: y.same(id) {
            True => λ absent => {
                let y_is: (y = id) = y.same_sound(id, same);
                let not_y: (y.same(x) = False) = match yx: y.same(x) { True => false_elim(differs(trans(sym(y.same_sound(x, yx)), y_is))), False => refl };
                j(sym(not_y), λ b _ => (b || mem_nat(x, rest)) = False, unpend_other(rest, id, x, differs, absent))
            },
            False => λ absent => {
                let parts = Bool::or_false_parts(y.same(x), mem_nat(x, unpend(rest, id)), absent);
                j(sym(parts.left), λ b _ => (b || mem_nat(x, rest)) = False, unpend_other(rest, id, x, differs, parts.right))
            },
        },
    }
}

theorem home_of_found(homes: List<Lent>, buffer: Nat, h: Lent): home_of(homes, buffer) = Some(h) → (h.buffer = buffer) ∧ Mem(h, homes) {
    match homes {
        Nil => λ never => absurd(never),
        Cons(g, rest) => match same: g.buffer.same(buffer) {
            True => λ found => {
                let is: (g = h) = Option::some_inj(g, h, found);
                ⟨j(is, λ x _ => x.buffer = buffer, g.buffer.same_sound(buffer, same)), Inl(sym(is))⟩
            },
            False => λ found => {
                let inner = home_of_found(rest, buffer, h, found);
                ⟨inner.left, Inr(inner.right)⟩
            },
        },
    }
}

// ---------------------------------------------------------------------------
// A word node

// A node that touches no buffer is its own `Compute`.
theorem pure_form(s: Scope, node: Node, t: Nat, reads: List<Nat>, words: (id: Nat) → Mem(id, function_ir_eval::Node::reads(node)) → mem_nat(id, s.refs) = False):
    node.pure() = True → s.memory(node, t, reads) = Plain([Compute(node)]) {
    (match node as λ n => ((id: Nat) → Mem(id, function_ir_eval::Node::reads(n)) → mem_nat(id, s.refs) = False) → n.pure() = True → s.memory(n, t, reads) = Plain([Compute(n)]) {
        BufferLoad(_, _, _) => λ _ no => absurd(no),
        BufferStore(_, _, _, _) => λ _ no => absurd(no),
        WideLoad(_, _, _, _) => λ _ no => absurd(no),
        WideStore(_, _, _, _, _) => λ _ no => absurd(no),
        Const(_, _, _) => λ _ _ => refl,
        Move(w, o, source) => λ ws _ => j(sym(ws(source, Inl(refl))), λ b _ =>
            (match (match b { True => RefKind, False => WordKind }) { WordKind => Plain([Compute(Move(w, o, source))]),
                RefKind => Plain([Compute(Const(64, t, 0)), bytes_level::Offset(o, source, t)]) }) = Plain([Compute(Move(w, o, source))]), refl),
        Add(_, _, _, _) => λ _ _ => refl,
        Sub(_, _, _, _) => λ _ _ => refl,
        BitAnd(_, _, _, _) => λ _ _ => refl,
        BitOr(_, _, _, _) => λ _ _ => refl,
        BitXor(_, _, _, _) => λ _ _ => refl,
        ShiftLeft(_, _, _, _) => λ _ _ => refl,
        LogicalShiftRight(_, _, _, _) => λ _ _ => refl,
        ArithmeticShiftRight(_, _, _, _) => λ _ _ => refl,
        UnsignedLessThan(_, _, _, _) => λ _ _ => refl,
        SignedLessThan(_, _, _, _) => λ _ _ => refl,
        Equal(_, _, _, _) => λ _ _ => refl,
        Resize(_, _, _, _) => λ _ _ => refl,
        SignResize(_, _, _, _) => λ _ _ => refl,
        TableRead(_, _, _, _, _) => λ _ _ => refl,
        ByteSwap(_, _, _) => λ _ _ => refl,
        RotateRight(_, _, _, _) => λ _ _ => refl,
        Apply(_, _, _, _, _) => λ _ _ => refl,
    })(words)
}

// The output set at every width to the old step's, every other id as it
// was: the relation kept, the output no longer pending.
theorem agree_set(bound: Nat, refs, pending: List<Nat>, words, values: Valuation(), agree: Agree(bound, refs, pending, words, values), o: Nat,
    new, old: (w: Nat) → BitVec(w), same: (w: Nat) → new(w) = old(w)):
    Agree(bound, refs, unpend(pending, o), Valuation::set(words, o, new), Valuation::set(values, o, old)) {
    λ x below plain unpended w => match x.eq_dec(o) as λ _ => Valuation::set(words, o, new, w, x) = Valuation::set(values, o, old, w, x) {
        Inl(here) => j(sym(here), λ y _ => Valuation::set(words, o, new, w, y) = Valuation::set(values, o, old, w, y),
            trans(Valuation::set_here(words, o, new, w), trans(same(w), sym(Valuation::set_here(values, o, old, w))))),
        Inr(differs) => trans(Valuation::set_other(words, o, new, w, x, differs),
            trans(agree(x, below, plain, unpend_other(pending, o, x, differs, unpended), w), sym(Valuation::set_other(values, o, old, w, x, differs)))),
    }
}

// The old output set where the translation dropped the write: the output
// pending, every other id as it was.
theorem agree_pend(bound: Nat, refs, pending: List<Nat>, words, values: Valuation(), agree: Agree(bound, refs, pending, words, values), o: Nat,
    old: (w: Nat) → BitVec(w)): Agree(bound, refs, Cons(o, pending), words, Valuation::set(values, o, old)) {
    λ x below plain absent w => {
        let parts = Bool::or_false_parts(o.same(x), mem_nat(x, pending), absent);
        let differs: (x ≠ o) = λ e => absurd(trans(sym(j(sym(e), λ y _ => o.same(y) = True, o.same_self())), parts.left));
        trans(agree(x, below, plain, parts.right, w), sym(Valuation::set_other(values, o, old, w, x, differs)))
    }
}

// The words a node reads agree.
theorem reads_agree(bound: Nat, refs, pending: List<Nat>, node: Node, t: Nat, fits: Fits(bound, refs, pending, node, t), words, values: Valuation(),
    agree: Agree(bound, refs, pending, words, values)): node.ReadsAgree(values, words) {
    λ id m w => {
        let f = fits.left(id, m);
        agree(id, f.left, f.right.left, f.right.right, w)
    }
}

theorem memory_plain_inj(a, b: List<Instr>, e: Plain(a) = Plain(b)): a = b {
    cong_fn<Memory, List<Instr>>(λ m => match m { Plain(is) => is, Guarded(_, is) => is, Refused => [] }, e)
}

// What is pending after a node: its output where its write was dropped, and
// otherwise no longer.
fn pending_after(node: Node, rest: List<Node>, pending: List<Nat>) → List<Nat> {
    match node.pure() && rebound(node_output(node).id, rest) { True => Cons(node_output(node).id, pending), False => unpend(pending, node_output(node).id) }
}

// A `Compute` run to an end is the node's step.
theorem compute_end(blocks: Blocks, c: Config, node: Node, after: Config, ran: run_instrs(blocks, [Compute(node)], c) = Some(after)):
    after = Config(Locals(node.step(c.locals.words), c.locals.refs), c.memory, c.io) {
    let ran_on = Config(Locals(node.step(c.locals.words), c.locals.refs), c.memory, c.io);
    (match node.pure() && node.defined(c.locals.words) as λ b => (node.pure() && node.defined(c.locals.words)) = b →
            (match b { False => None, True => Some(ran_on) }).and_then(λ (m: Config) => run_instrs(blocks, [], m)) = Some(after) → after = ran_on {
        False => λ _ never => absurd(never),
        True => λ _ done => sym(Option::some_inj(ran_on, after, done)),
    })(refl, ran)
}

// The relation after a word node, kept or dropped.
theorem pure_agrees(blocks: Blocks, s: Scope, node: Node, rest: List<Node>, t: Nat, reads: List<Nat>, bound: Nat, pending: List<Nat>, values: Valuation(),
    buffers: Buffers(), c: Config, agree: Agree(bound, s.refs, pending, c.locals.words, values), held: HomesHeld(s.homes, c, buffers),
    fits: Fits(bound, s.refs, pending, node, t), pure: node.pure() = True, instrs: List<Instr>, form: s.node_form(node, rest, t, reads) = Plain(instrs),
    after: Config, ran: run_instrs(blocks, instrs, c) = Some(after)):
    Agree(bound, s.refs, pending_after(node, rest, pending), after.locals.words, node.run(values, buffers).values) ∧
        HomesHeld(s.homes, after, node.run(values, buffers).buffers) {
    let o = node_output(node).id;
    let run = node.run_pure(values, buffers, Bool::is_true_of_eq(pure));
    let form2: ((match rebound(o, rest) { True => Plain([]), False => s.memory(node, t, reads) }) = Plain(instrs)) =
        j(pure, λ b _ => (match b && rebound(o, rest) { True => Plain([]), False => s.memory(node, t, reads) }) = Plain(instrs), form);
    let goal = λ (pend: List<Nat>) => Agree(bound, s.refs, pend, after.locals.words, node.run(values, buffers).values) ∧
        HomesHeld(s.homes, after, node.run(values, buffers).buffers);
    let pend_is = λ (b: Bool) (e: rebound(o, rest) = b) => j(e, λ x _ => pending_after(node, rest, pending) = (match x { True => Cons(o, pending), False => unpend(pending, o) }),
        j(pure, λ y _ => pending_after(node, rest, pending) = (match y && rebound(o, rest) { True => Cons(o, pending), False => unpend(pending, o) }), refl));
    (match rebound(o, rest) as λ b => rebound(o, rest) = b → (match b { True => Plain([]), False => s.memory(node, t, reads) }) = Plain(instrs) →
            goal(pending_after(node, rest, pending)) {
        True => λ e dropped => {
            let none: (instrs = []) = sym(memory_plain_inj([], instrs, dropped));
            let same: (after = c) = sym(Option::some_inj(c, after, j(none, λ is _ => run_instrs(blocks, is, c) = Some(after), ran)));
            j(sym(pend_is(True, e)), λ p _ => goal(p), j(sym(run), λ st _ => Agree(bound, s.refs, Cons(o, pending), after.locals.words, st.values) ∧
                    HomesHeld(s.homes, after, st.buffers),
                j(sym(same), λ a _ => Agree(bound, s.refs, Cons(o, pending), a.locals.words, node.step(values)) ∧ HomesHeld(s.homes, a, buffers),
                    ⟨agree_pend(bound, s.refs, pending, c.locals.words, values, agree, o, node.value(values)), held⟩)))
        },
        False => λ e kept => {
            let one: (instrs = [Compute(node)]) = sym(memory_plain_inj([Compute(node)], instrs, trans(sym(pure_form(s, node, t, reads,
                λ id m => fits.left(id, m).right.left, pure)), kept)));
            let end = compute_end(blocks, c, node, after, j(one, λ is _ => run_instrs(blocks, is, c) = Some(after), ran));
            let words = agree_set(bound, s.refs, pending, c.locals.words, values, agree, o, node.value(c.locals.words), node.value(values),
                node.value_agree(values, c.locals.words, reads_agree(bound, s.refs, pending, node, t, fits, c.locals.words, values, agree)));
            j(sym(pend_is(False, e)), λ p _ => goal(p), j(sym(run), λ st _ => Agree(bound, s.refs, unpend(pending, o), after.locals.words, st.values) ∧
                    HomesHeld(s.homes, after, st.buffers),
                j(sym(end), λ a _ => Agree(bound, s.refs, unpend(pending, o), a.locals.words, node.step(values)) ∧ HomesHeld(s.homes, a, buffers),
                    ⟨words, held⟩)))
        },
    })(refl, form2)
}

// ---------------------------------------------------------------------------
// The byte load and the byte store

theorem set_ref_other(l: Locals, id: Nat, loc: Loc, y: Nat, differs: y ≠ id): l.set_ref(id, loc).refs(y) = l.refs(y) {
    j(sym(y.same_false_of(id, differs)), λ b _ => (match b { True => Some(loc), False => l.refs(y) }) = l.refs(y), refl)
}

// The homes' references are none of the translation's own ids.
theorem homes_apart(homes: List<Lent>, bound, t: Nat, bases: (h: Lent) → Mem(h, homes) → h.base < bound, past: bound <= t, h: Lent, m: Mem(h, homes)):
    h.base ≠ t {
    let below = bases(h, m);
    λ e => Nat::lt_irrefl(t, omega(j(e, λ x _ => x < bound, below), past))
}

theorem load_agrees(blocks: Blocks, s: Scope, output, k, index: Nat, rest: List<Node>, t: Nat, reads: List<Nat>, bound: Nat, pending: List<Nat>,
    values: Valuation(), buffers: Buffers(), c: Config, agree: Agree(bound, s.refs, pending, c.locals.words, values), held: HomesHeld(s.homes, c, buffers),
    bases: (h: Lent) → Mem(h, s.homes) → h.base < bound, fits: Fits(bound, s.refs, pending, BufferLoad(output, k, index), t), instrs: List<Instr>,
    form: s.node_form(BufferLoad(output, k, index), rest, t, reads) = Plain(instrs), after: Config, ran: run_instrs(blocks, instrs, c) = Some(after)):
    Agree(bound, s.refs, pending_after(BufferLoad(output, k, index), rest, pending), after.locals.words, BufferLoad(output, k, index).run(values, buffers).values) ∧
        HomesHeld(s.homes, after, BufferLoad(output, k, index).run(values, buffers).buffers) {
    let goal = Agree(bound, s.refs, unpend(pending, output), after.locals.words, Valuation::set(values, output, load_value(buffers, k, index, values))) ∧
        HomesHeld(s.homes, after, buffers);
    let index_same: (c.locals.words(64, index) = values(64, index)) = {
        let f = fits.left(index, Inl(refl));
        agree(index, f.left, f.right.left, f.right.right, 64)
    };
    (match home_of(s.homes, k) as λ o => home_of(s.homes, k) = o →
            (match o {
                None => Refused,
                Some(h) => match s.inside(index, h, 0) {
                    True => Plain([bytes_level::Offset(t, h.base, index), bytes_level::Load(1, 64, output, t)]),
                    False => Guarded(t + 1, [bytes_level::Offset(t, h.base, index), bytes_level::Load(1, 64, output, t)]),
                },
            }) = Plain(instrs) → goal {
        None => λ _ never => absurd(never),
        Some(h) => λ found shaped => (match s.inside(index, h, 0) as λ b =>
                (match b { True => Plain([bytes_level::Offset(t, h.base, index), bytes_level::Load(1, 64, output, t)]), False => Guarded(t + 1, [bytes_level::Offset(t, h.base, index), bytes_level::Load(1, 64, output, t)]) }) =
                    Plain(instrs) → goal {
            False => λ never => absurd(never),
            True => λ plain => {
                let is: (instrs = [bytes_level::Offset(t, h.base, index), bytes_level::Load(1, 64, output, t)]) = sym(memory_plain_inj([bytes_level::Offset(t, h.base, index), bytes_level::Load(1, 64, output, t)], instrs, plain));
                let where = home_of_found(s.homes, k, h, found);
                let at: (c.locals.refs(h.base) = Some(Loc(k, 0))) = j(where.left, λ b _ => c.locals.refs(h.base) = Some(Loc(b, 0)), held.left(h, where.right));
                let same: (c.memory.bytes(k) = buffer_bytes(buffers, k)) = held.right(k);
                let end = byte_load_runs(blocks, c, buffers, k, h.base, index, output, t, at, same, after,
                    j(is, λ l _ => run_instrs(blocks, l, c) = Some(after), ran));
                let new = load_value(buffers, k, index, c.locals.words);
                let old = load_value(buffers, k, index, values);
                let words = agree_set(bound, s.refs, pending, c.locals.words, values, agree, output, new, old,
                    λ w => cong_fn<BitVec(64), BitVec(w)>(λ x => word_value(byte_word(buffer_byte(buffers, k, x.toNat())), w), index_same));
                let loc = Loc(k, 0 + c.locals.word(index).toNat());
                j(sym(end), λ a _ => Agree(bound, s.refs, unpend(pending, output), a.locals.words, Valuation::set(values, output, old)) ∧ HomesHeld(s.homes, a, buffers),
                    ⟨words, ⟨λ g m => trans(set_ref_other(c.locals, t, loc, g.base, homes_apart(s.homes, bound, t, bases, fits.right.right, g, m)), held.left(g, m)),
                        held.right⟩⟩)
            },
        })(shaped),
    })(refl, form)
}

theorem store_agrees(blocks: Blocks, s: Scope, output, k, index, value: Nat, rest: List<Node>, t: Nat, reads: List<Nat>, bound: Nat, pending: List<Nat>,
    values: Valuation(), buffers: Buffers(), c: Config, agree: Agree(bound, s.refs, pending, c.locals.words, values), held: HomesHeld(s.homes, c, buffers),
    bases: (h: Lent) → Mem(h, s.homes) → h.base < bound, fits: Fits(bound, s.refs, pending, BufferStore(output, k, index, value), t), instrs: List<Instr>,
    form: s.node_form(BufferStore(output, k, index, value), rest, t, reads) = Plain(instrs), after: Config, ran: run_instrs(blocks, instrs, c) = Some(after)):
    Agree(bound, s.refs, pending_after(BufferStore(output, k, index, value), rest, pending), after.locals.words,
        BufferStore(output, k, index, value).run(values, buffers).values) ∧
        HomesHeld(s.homes, after, BufferStore(output, k, index, value).run(values, buffers).buffers) {
    let vi = values(64, index).toNat();
    let vb = low_byte(values(64, value));
    let stored = store_byte(buffers, k, vi, vb);
    let goal = Agree(bound, s.refs, unpend(pending, output), after.locals.words, Valuation::set(values, output, load_value(stored, k, index, values))) ∧
        HomesHeld(s.homes, after, stored);
    let index_same: (c.locals.words(64, index) = values(64, index)) = {
        let f = fits.left(index, Inl(refl));
        agree(index, f.left, f.right.left, f.right.right, 64)
    };
    let value_same: (c.locals.words(64, value) = values(64, value)) = {
        let f = fits.left(value, Inr(Inl(refl)));
        agree(value, f.left, f.right.left, f.right.right, 64)
    };
    let ci = c.locals.words(64, index).toNat();
    let cb = low_byte(c.locals.words(64, value));
    let i_same: (ci = vi) = cong_fn<BitVec(64), Nat>(λ x => x.toNat(), index_same);
    let stores_same: (store_byte(buffers, k, ci, cb) = stored) =
        eq2(λ (i: Nat) (b: BitVec(8)) => store_byte(buffers, k, i, b), i_same, cong_fn<BitVec(64), BitVec(8)>(λ x => low_byte(x), value_same));
    (match home_of(s.homes, k) as λ o => home_of(s.homes, k) = o →
            (match o {
                None => Refused,
                Some(h) => match s.inside(index, h, 0) {
                    False => Refused,
                    True => Plain([bytes_level::Offset(t, h.base, index), bytes_level::Store(1, 64, t, value), bytes_level::Load(1, 64, output, t)]),
                },
            }) = Plain(instrs) → goal {
        None => λ _ never => absurd(never),
        Some(h) => λ found shaped => (match s.inside(index, h, 0) as λ b =>
                (match b { False => Refused, True => Plain([bytes_level::Offset(t, h.base, index), bytes_level::Store(1, 64, t, value), bytes_level::Load(1, 64, output, t)]) }) = Plain(instrs) → goal {
            False => λ never => absurd(never),
            True => λ plain => {
                let is: (instrs = [bytes_level::Offset(t, h.base, index), bytes_level::Store(1, 64, t, value), bytes_level::Load(1, 64, output, t)]) =
                    sym(memory_plain_inj([bytes_level::Offset(t, h.base, index), bytes_level::Store(1, 64, t, value), bytes_level::Load(1, 64, output, t)], instrs, plain));
                let where = home_of_found(s.homes, k, h, found);
                let at: (c.locals.refs(h.base) = Some(Loc(k, 0))) = j(where.left, λ b _ => c.locals.refs(h.base) = Some(Loc(b, 0)), held.left(h, where.right));
                let same: (c.memory.bytes(k) = buffer_bytes(buffers, k)) = held.right(k);
                let facts = byte_store_runs(blocks, c, buffers, k, h.base, index, value, output, t, at, same, after,
                    j(is, λ l _ => run_instrs(blocks, l, c) = Some(after), ran));
                let loc = Loc(k, 0 + c.locals.word(index).toNat());
                let new = load_value(store_byte(buffers, k, ci, cb), k, index, c.locals.words);
                let old = load_value(stored, k, index, values);
                let words_are: (after.locals.words = Valuation::set(c.locals.words, output, new)) =
                    cong_fn<Locals, Valuation()>(λ l => l.words, facts.right.right);
                let refs_are: (after.locals.refs = c.locals.set_ref(t, loc).refs) = cong_fn<Locals, Nat → Option<Loc>>(λ l => l.refs, facts.right.right);
                let words = agree_set(bound, s.refs, pending, c.locals.words, values, agree, output, new, old,
                    λ w => eq2(λ (bs: Buffers()) (x: BitVec(64)) => word_value(byte_word(buffer_byte(bs, k, x.toNat())), w), stores_same, index_same));
                ⟨j(sym(words_are), λ v _ => Agree(bound, s.refs, unpend(pending, output), v, Valuation::set(values, output, old)), words),
                    ⟨λ g m => trans(cong_fn<Nat → Option<Loc>, Option<Loc>>(λ r => r(g.base), refs_are),
                            trans(set_ref_other(c.locals, t, loc, g.base, homes_apart(s.homes, bound, t, bases, fits.right.right, g, m)), held.left(g, m))),
                        λ b => match b.eq_dec(k) as λ _ => after.memory.bytes(b) = buffer_bytes(stored, b) {
                            Inl(here) => j(sym(here), λ x _ => after.memory.bytes(x) = buffer_bytes(stored, x),
                                trans(facts.left, cong_fn<Buffers(), List<BitVec(8)>>(λ bs => buffer_bytes(bs, k), stores_same))),
                            Inr(differs) => trans(facts.right.left(b, differs),
                                trans(held.right(b), sym(buffer_bytes_store_other(buffers, k, vi, vb, b, λ e => differs(sym(e)))))),
                        }⟩⟩
            },
        })(shaped),
    })(refl, form)
}

// ---------------------------------------------------------------------------
// A node, any form but a wide access

fn is_wide(node: Node) → Bool { match node { WideLoad(_, _, _, _) => True, WideStore(_, _, _, _, _) => True, _ => False } }

theorem node_agrees(blocks: Blocks, s: Scope, node: Node, rest: List<Node>, t: Nat, reads: List<Nat>, bound: Nat, pending: List<Nat>,
    values: Valuation(), buffers: Buffers(), c: Config, agree: Agree(bound, s.refs, pending, c.locals.words, values), held: HomesHeld(s.homes, c, buffers),
    bases: (h: Lent) → Mem(h, s.homes) → h.base < bound, fits: Fits(bound, s.refs, pending, node, t), narrow: is_wide(node) = False, instrs: List<Instr>,
    form: s.node_form(node, rest, t, reads) = Plain(instrs), after: Config, ran: run_instrs(blocks, instrs, c) = Some(after)):
    Agree(bound, s.refs, pending_after(node, rest, pending), after.locals.words, node.run(values, buffers).values) ∧
        HomesHeld(s.homes, after, node.run(values, buffers).buffers) {
    let pure = λ (n: Node) (p: n.pure() = True) (f: Fits(bound, s.refs, pending, n, t)) (e: s.node_form(n, rest, t, reads) = Plain(instrs)) =>
        pure_agrees(blocks, s, n, rest, t, reads, bound, pending, values, buffers, c, agree, held, f, p, instrs, e, after, ran);
    (match node as λ n => Fits(bound, s.refs, pending, n, t) → is_wide(n) = False → s.node_form(n, rest, t, reads) = Plain(instrs) →
            Agree(bound, s.refs, pending_after(n, rest, pending), after.locals.words, n.run(values, buffers).values) ∧
                HomesHeld(s.homes, after, n.run(values, buffers).buffers) {
        BufferLoad(output, k, index) => λ f _ e => load_agrees(blocks, s, output, k, index, rest, t, reads, bound, pending, values, buffers, c, agree, held, bases, f,
            instrs, e, after, ran),
        BufferStore(output, k, index, value) => λ f _ e => store_agrees(blocks, s, output, k, index, value, rest, t, reads, bound, pending, values, buffers, c, agree,
            held, bases, f, instrs, e, after, ran),
        WideLoad(_, _, _, _) => λ _ no _ => absurd(no),
        WideStore(_, _, _, _, _) => λ _ no _ => absurd(no),
        Const(a, b, d) => λ f _ e => pure(Const(a, b, d), refl, f, e),
        Move(a, b, d) => λ f _ e => pure(Move(a, b, d), refl, f, e),
        Add(a, b, d, g) => λ f _ e => pure(Add(a, b, d, g), refl, f, e),
        Sub(a, b, d, g) => λ f _ e => pure(Sub(a, b, d, g), refl, f, e),
        BitAnd(a, b, d, g) => λ f _ e => pure(BitAnd(a, b, d, g), refl, f, e),
        BitOr(a, b, d, g) => λ f _ e => pure(BitOr(a, b, d, g), refl, f, e),
        BitXor(a, b, d, g) => λ f _ e => pure(BitXor(a, b, d, g), refl, f, e),
        ShiftLeft(a, b, d, g) => λ f _ e => pure(ShiftLeft(a, b, d, g), refl, f, e),
        LogicalShiftRight(a, b, d, g) => λ f _ e => pure(LogicalShiftRight(a, b, d, g), refl, f, e),
        ArithmeticShiftRight(a, b, d, g) => λ f _ e => pure(ArithmeticShiftRight(a, b, d, g), refl, f, e),
        UnsignedLessThan(a, b, d, g) => λ f _ e => pure(UnsignedLessThan(a, b, d, g), refl, f, e),
        SignedLessThan(a, b, d, g) => λ f _ e => pure(SignedLessThan(a, b, d, g), refl, f, e),
        Equal(a, b, d, g) => λ f _ e => pure(Equal(a, b, d, g), refl, f, e),
        Resize(a, b, d, g) => λ f _ e => pure(Resize(a, b, d, g), refl, f, e),
        SignResize(a, b, d, g) => λ f _ e => pure(SignResize(a, b, d, g), refl, f, e),
        TableRead(a, b, d, g, h) => λ f _ e => pure(TableRead(a, b, d, g, h), refl, f, e),
        ByteSwap(a, b, d) => λ f _ e => pure(ByteSwap(a, b, d), refl, f, e),
        RotateRight(a, b, d, g) => λ f _ e => pure(RotateRight(a, b, d, g), refl, f, e),
        Apply(a, b, d, g, h) => λ f _ e => pure(Apply(a, b, d, g, h), refl, f, e),
    })(fits, narrow, form)
}

// ---------------------------------------------------------------------------
// A leaf

theorem run_instrs_append(blocks: Blocks, xs: List<Instr>): (ys: List<Instr>) → (c: Config) →
    run_instrs(blocks, xs ++ ys, c) = run_instrs(blocks, xs, c).and_then(λ (m: Config) => run_instrs(blocks, ys, m)) {
    match xs {
        Nil => λ ys c => refl,
        Cons(x, rest) => λ ys c => (match x.step(blocks, c) as λ o => o.and_then(λ (m: Config) => run_instrs(blocks, rest ++ ys, m)) =
                o.and_then(λ (m: Config) => run_instrs(blocks, rest, m)).and_then(λ (m: Config) => run_instrs(blocks, ys, m)) {
            None => refl,
            Some(m) => run_instrs_append(blocks, rest, ys, m),
        }),
    }
}

// What each node of a leaf asks, with what is pending where it runs.
fn NodesFit(bound: Nat, refs, pending: List<Nat>, nodes: List<Node>, t: Nat) → Type {
    match nodes {
        Nil => True,
        Cons(n, rest) => Fits(bound, refs, pending, n, t) ∧ ((is_wide(n) = False) ∧ NodesFit(bound, refs, pending_after(n, rest, pending), rest, t + 2)),
    }
}

// What is pending after a leaf.
fn leaf_pending(nodes: List<Node>, pending: List<Nat>) → List<Nat> {
    match nodes { Nil => pending, Cons(n, rest) => leaf_pending(rest, pending_after(n, rest, pending)) }
}

// A scope's homes and references as a leaf leaves them: only what is known
// changes.
fn Scope::Same(self s: Scope, other: Scope) → Type { (other.homes = s.homes) ∧ (other.refs = s.refs) }

theorem join_leaf_leaf(instrs: List<Instr>, rest: Body, all: List<Instr>, e: join_leaf(instrs, rest) = Leaf(all)):
    Exists<List<Instr>>(λ more => (rest = Leaf(more)) ∧ (all = instrs ++ more)) {
    (match rest as λ r => join_leaf(instrs, r) = Leaf(all) → Exists<List<Instr>>(λ more => (r = Leaf(more)) ∧ (all = instrs ++ more)) {
        Leaf(more) => λ same => Exists(more, ⟨refl, sym(cong_fn<Body, List<Instr>>(λ b => match b { Leaf(is) => is, _ => [] }, same))⟩),
        Seq(_, _) => λ no => absurd(no),
        Branch(_, _, _) => λ no => absurd(no),
        Call(_, _, _) => λ no => absurd(no),
        Loop(_, _, _, _, _, _) => λ no => absurd(no),
        Sys(_) => λ no => absurd(no),
        Exit(_) => λ no => absurd(no),
    })(e)
}

// A node reading no reference adds none to its scope.
theorem node_refs_words(s: Scope, node: Node, words: (id: Nat) → Mem(id, function_ir_eval::Node::reads(node)) → mem_nat(id, s.refs) = False): s.node_refs(node) = s.refs {
    (match node as λ n => ((id: Nat) → Mem(id, function_ir_eval::Node::reads(n)) → mem_nat(id, s.refs) = False) → s.node_refs(n) = s.refs {
        Move(w, o, source) => λ ws => j(sym(ws(source, Inl(refl))), λ b _ =>
            (match (match b { True => RefKind, False => WordKind }) { WordKind => s.refs, RefKind => Cons(o, s.refs) }) = s.refs, refl),
        Const(_, _, _) => λ _ => refl,
        Add(_, _, _, _) => λ _ => refl,
        Sub(_, _, _, _) => λ _ => refl,
        BitAnd(_, _, _, _) => λ _ => refl,
        BitOr(_, _, _, _) => λ _ => refl,
        BitXor(_, _, _, _) => λ _ => refl,
        ShiftLeft(_, _, _, _) => λ _ => refl,
        LogicalShiftRight(_, _, _, _) => λ _ => refl,
        ArithmeticShiftRight(_, _, _, _) => λ _ => refl,
        UnsignedLessThan(_, _, _, _) => λ _ => refl,
        SignedLessThan(_, _, _, _) => λ _ => refl,
        Equal(_, _, _, _) => λ _ => refl,
        BufferLoad(_, _, _) => λ _ => refl,
        BufferStore(_, _, _, _) => λ _ => refl,
        Resize(_, _, _, _) => λ _ => refl,
        SignResize(_, _, _, _) => λ _ => refl,
        TableRead(_, _, _, _, _) => λ _ => refl,
        WideLoad(_, _, _, _) => λ _ => refl,
        WideStore(_, _, _, _, _) => λ _ => refl,
        ByteSwap(_, _, _) => λ _ => refl,
        RotateRight(_, _, _, _) => λ _ => refl,
        Apply(_, _, _, _, _) => λ _ => refl,
    })(words)
}

// A guarded load's body is no leaf, whatever follows it.
theorem guarded_not_leaf(test, index, length, output: Nat, instrs: List<Instr>, rest: Body, all: List<Instr>):
    seq_bodies(guarded(test, index, length, output, instrs), rest) = Leaf(all) → False {
    (match rest as λ r => seq_bodies(guarded(test, index, length, output, instrs), r) = Leaf(all) → False {
        Leaf(more) => match more as λ m => seq_bodies(guarded(test, index, length, output, instrs), Leaf(m)) = Leaf(all) → False {
            Nil => λ no => absurd(no),
            Cons(_, _) => λ no => absurd(no),
        },
        Seq(_, _) => λ no => absurd(no),
        Branch(_, _, _) => λ no => absurd(no),
        Call(_, _, _) => λ no => absurd(no),
        Loop(_, _, _, _, _, _) => λ no => absurd(no),
        Sys(_) => λ no => absurd(no),
        Exit(_) => λ no => absurd(no),
    })
}

// A leaf of nodes, none wide, translated to one leaf (no guard): every
// run of it to an end agrees with the old run of the nodes.
theorem leaf_runs_as_old(blocks: Blocks, bound: Nat, nodes: List<Node>): (s: Scope) → (next: Nat) → (reads: List<Nat>) → (made: Made) →
    translate_nodes(s, nodes, next, reads) = Some(made) → (all: List<Instr>) → made.body = Leaf(all) →
    (c, after: Config) → run_instrs(blocks, all, c) = Some(after) → (pending: List<Nat>) → (values: Valuation()) → (buffers: Buffers()) →
    Agree(bound, s.refs, pending, c.locals.words, values) → HomesHeld(s.homes, c, buffers) → ((h: Lent) → Mem(h, s.homes) → h.base < bound) →
    NodesFit(bound, s.refs, pending, nodes, next) →
    (Agree(bound, s.refs, leaf_pending(nodes, pending), after.locals.words, run_nodes(nodes, values, buffers).values) ∧
        HomesHeld(s.homes, after, run_nodes(nodes, values, buffers).buffers)) ∧ s.Same(made.scope) {
    match nodes {
        Nil => λ s next reads made translated all body c after ran pending values buffers agree held bases fits => {
            let is: (Made(Leaf([]), next, s) = made) = Option::some_inj(Made(Leaf([]), next, s), made, translated);
            let none: (all = []) = sym(cong_fn<Body, List<Instr>>(λ b => match b { Leaf(xs) => xs, _ => [] }, trans(cong_fn<Made, Body>(λ m => m.body, is), body)));
            let same: (after = c) = sym(Option::some_inj(c, after, j(none, λ xs _ => run_instrs(blocks, xs, c) = Some(after), ran)));
            ⟨j(sym(same), λ a _ => Agree(bound, s.refs, pending, a.locals.words, values) ∧ HomesHeld(s.homes, a, buffers), ⟨agree, held⟩),
                j(is, λ m _ => s.Same(m.scope), ⟨refl, refl⟩)⟩
        },
        Cons(node, rest) => λ s next reads made translated all body c after ran pending values buffers agree held bases fits => {
            let then_s = Scope(s.homes, s.node_refs(node), node_known(node, s.known));
            let same_refs: (s.node_refs(node) = s.refs) = node_refs_words(s, node, λ id m => fits.left.left(id, m).right.left);
            let old = node.run(values, buffers);
            let goal = (Agree(bound, s.refs, leaf_pending(rest, pending_after(node, rest, pending)), after.locals.words, run_nodes(rest, old.values, old.buffers).values) ∧
                HomesHeld(s.homes, after, run_nodes(rest, old.values, old.buffers).buffers)) ∧ s.Same(made.scope);
            (match s.node_form(node, rest, next, reads) as λ f => s.node_form(node, rest, next, reads) = f →
                    (match f {
                        Refused => None,
                        Plain(instrs) => match translate_nodes(then_s, rest, next + 2, reads) {
                            None => None,
                            Some(more) => Some(Made(join_leaf(instrs, more.body), more.next, more.scope)),
                        },
                        Guarded(test, instrs) => match translate_nodes(then_s, rest, next + 2, reads) {
                            None => None,
                            Some(more) => Some(Made(seq_bodies(guarded(test, load_index(node), s.length_of(load_buffer(node)), load_output(node), instrs), more.body),
                                more.next, more.scope)),
                        },
                    }) = Some(made) → goal {
                Refused => λ _ never => absurd(never),
                Guarded(test, instrs) => λ _ found => (match translate_nodes(then_s, rest, next + 2, reads) as λ o =>
                        (match o {
                            None => None,
                            Some(more) => Some(Made(seq_bodies(guarded(test, load_index(node), s.length_of(load_buffer(node)), load_output(node), instrs), more.body),
                                more.next, more.scope)),
                        }) = Some(made) → goal {
                    None => λ never => absurd(never),
                    Some(more) => λ some => {
                        let is = Option::some_inj(Made(seq_bodies(guarded(test, load_index(node), s.length_of(load_buffer(node)), load_output(node), instrs), more.body),
                            more.next, more.scope), made, some);
                        false_elim(guarded_not_leaf(test, load_index(node), s.length_of(load_buffer(node)), load_output(node), instrs, more.body, all,
                            trans(cong_fn<Made, Body>(λ m => m.body, is), body)))
                    },
                })(found),
                Plain(instrs) => λ form found => (match translate_nodes(then_s, rest, next + 2, reads) as λ o => translate_nodes(then_s, rest, next + 2, reads) = o →
                        (match o { None => None, Some(more) => Some(Made(join_leaf(instrs, more.body), more.next, more.scope)) }) = Some(made) → goal {
                    None => λ _ never => absurd(never),
                    Some(more) => λ inner some => {
                        let is = Option::some_inj(Made(join_leaf(instrs, more.body), more.next, more.scope), made, some);
                        let parts = join_leaf_leaf(instrs, more.body, all, trans(cong_fn<Made, Body>(λ m => m.body, is), body));
                        let ran2: (run_instrs(blocks, instrs, c).and_then(λ (m: Config) => run_instrs(blocks, parts.witness, m)) = Some(after)) =
                            trans(sym(run_instrs_append(blocks, instrs, parts.witness, c)),
                                j(parts.proof.right, λ xs _ => run_instrs(blocks, xs, c) = Some(after), ran));
                        (match run_instrs(blocks, instrs, c) as λ o => run_instrs(blocks, instrs, c) = o →
                                o.and_then(λ (m: Config) => run_instrs(blocks, parts.witness, m)) = Some(after) → goal {
                            None => λ _ never => absurd(never),
                            Some(mid) => λ first second => {
                                let step = node_agrees(blocks, s, node, rest, next, reads, bound, pending, values, buffers, c, agree, held, bases, fits.left,
                                    fits.right.left, instrs, form, mid, first);
                                let more_ih = leaf_runs_as_old(blocks, bound, rest, then_s, next + 2, reads, more, inner, parts.witness, parts.proof.left, mid, after, second,
                                    pending_after(node, rest, pending), old.values, old.buffers,
                                    j(sym(same_refs), λ r _ => Agree(bound, r, pending_after(node, rest, pending), mid.locals.words, old.values), step.left), step.right, bases,
                                    j(sym(same_refs), λ r _ => NodesFit(bound, r, pending_after(node, rest, pending), rest, next + 2), fits.right.right));
                                let left = j(same_refs, λ r _ => Agree(bound, r, leaf_pending(rest, pending_after(node, rest, pending)), after.locals.words,
                                    run_nodes(rest, old.values, old.buffers).values), more_ih.left.left);
                                ⟨⟨left, more_ih.left.right⟩, j(is, λ m _ => s.Same(m.scope),
                                    ⟨more_ih.right.left, trans(more_ih.right.right, same_refs)⟩)⟩
                            },
                        })(refl, ran2)
                    },
                })(refl, found),
            })(refl, translated)
        },
    }
}

// ---------------------------------------------------------------------------
// Bodies joined: a run of the join is a run of the first, then of the rest

fn SplitDone(first, rest: Body, blocks: Blocks, calls: Calls(), fuel: Nat, c, after: Config) → Type {
    Exists<Config>(λ mid => (first.run(blocks, calls, fuel, c) = Done(mid)) ∧ (rest.run(blocks, calls, fuel, mid) = Done(after)))
}

theorem seq_done(first, rest: Body, blocks: Blocks, calls: Calls(), fuel: Nat, c, after: Config,
    ran: Seq(first, rest).run(blocks, calls, fuel, c) = Done(after)): SplitDone(first, rest, blocks, calls, fuel, c, after) {
    Ran::then_done<Config, Config>(first.run(blocks, calls, fuel, c), λ (mid: Config) => rest.run(blocks, calls, fuel, mid), after, ran)
}

theorem leaves_done(xs, ys: List<Instr>, blocks: Blocks, calls: Calls(), fuel: Nat, c, after: Config,
    ran: Leaf(xs ++ ys).run(blocks, calls, fuel, c) = Done(after)): SplitDone(Leaf(xs), Leaf(ys), blocks, calls, fuel, c, after) {
    let whole: (run_instrs(blocks, xs ++ ys, c) = Some(after)) = Ran::of_done<Config>(run_instrs(blocks, xs ++ ys, c), c.io, after, ran);
    let both: (run_instrs(blocks, xs, c).and_then(λ (m: Config) => run_instrs(blocks, ys, m)) = Some(after)) =
        trans(sym(run_instrs_append(blocks, xs, ys, c)), whole);
    (match run_instrs(blocks, xs, c) as λ o => run_instrs(blocks, xs, c) = o → o.and_then(λ (m: Config) => run_instrs(blocks, ys, m)) = Some(after) →
            SplitDone(Leaf(xs), Leaf(ys), blocks, calls, fuel, c, after) {
        None => λ _ never => absurd(never),
        Some(mid) => λ first second => Exists(mid, ⟨j(sym(first), λ o _ => Ran::of(o, c.io) = Done(mid), refl),
            j(sym(second), λ o _ => Ran::of(o, mid.io) = Done(after), refl)⟩),
    })(refl, both)
}

// The first not a leaf: the join is the first alone where the rest is an
// empty leaf, the sequence otherwise.
theorem nonleaf_done(first, rest: Body, blocks: Blocks, calls: Calls(), fuel: Nat, c, after: Config,
    ran: (match rest { Leaf(more) => match more { Nil => first, Cons(_, _) => Seq(first, rest) }, _ => Seq(first, rest) }).run(blocks, calls, fuel, c) =
        Done(after)): SplitDone(first, rest, blocks, calls, fuel, c, after) {
    (match rest as λ r => (match r { Leaf(more) => match more { Nil => first, Cons(_, _) => Seq(first, r) }, _ => Seq(first, r) }).run(blocks, calls, fuel, c) =
            Done(after) → SplitDone(first, r, blocks, calls, fuel, c, after) {
        Leaf(more) => match more as λ m => (match m { Nil => first, Cons(_, _) => Seq(first, Leaf(m)) }).run(blocks, calls, fuel, c) = Done(after) →
                SplitDone(first, Leaf(m), blocks, calls, fuel, c, after) {
            Nil => λ h => Exists(after, ⟨h, refl⟩),
            Cons(x, xs) => λ h => seq_done(first, Leaf(Cons(x, xs)), blocks, calls, fuel, c, after, h),
        },
        Seq(a, b) => λ h => seq_done(first, Seq(a, b), blocks, calls, fuel, c, after, h),
        Branch(a, b, d) => λ h => seq_done(first, Branch(a, b, d), blocks, calls, fuel, c, after, h),
        Call(a, b, d) => λ h => seq_done(first, Call(a, b, d), blocks, calls, fuel, c, after, h),
        Loop(a, b, d, e, f, g) => λ h => seq_done(first, Loop(a, b, d, e, f, g), blocks, calls, fuel, c, after, h),
        Sys(a) => λ h => seq_done(first, Sys(a), blocks, calls, fuel, c, after, h),
        Exit(a) => λ h => seq_done(first, Exit(a), blocks, calls, fuel, c, after, h),
    })(ran)
}

theorem join_leaf_done(xs: List<Instr>, rest: Body, blocks: Blocks, calls: Calls(), fuel: Nat, c, after: Config,
    ran: join_leaf(xs, rest).run(blocks, calls, fuel, c) = Done(after)): SplitDone(Leaf(xs), rest, blocks, calls, fuel, c, after) {
    (match rest as λ r => join_leaf(xs, r).run(blocks, calls, fuel, c) = Done(after) → SplitDone(Leaf(xs), r, blocks, calls, fuel, c, after) {
        Leaf(ys) => λ h => leaves_done(xs, ys, blocks, calls, fuel, c, after, h),
        Seq(a, b) => λ h => seq_done(Leaf(xs), Seq(a, b), blocks, calls, fuel, c, after, h),
        Branch(a, b, d) => λ h => seq_done(Leaf(xs), Branch(a, b, d), blocks, calls, fuel, c, after, h),
        Call(a, b, d) => λ h => seq_done(Leaf(xs), Call(a, b, d), blocks, calls, fuel, c, after, h),
        Loop(a, b, d, e, f, g) => λ h => seq_done(Leaf(xs), Loop(a, b, d, e, f, g), blocks, calls, fuel, c, after, h),
        Sys(a) => λ h => seq_done(Leaf(xs), Sys(a), blocks, calls, fuel, c, after, h),
        Exit(a) => λ h => seq_done(Leaf(xs), Exit(a), blocks, calls, fuel, c, after, h),
    })(ran)
}

theorem seq_bodies_done(first, rest: Body, blocks: Blocks, calls: Calls(), fuel: Nat, c, after: Config,
    ran: seq_bodies(first, rest).run(blocks, calls, fuel, c) = Done(after)): SplitDone(first, rest, blocks, calls, fuel, c, after) {
    (match first as λ f => seq_bodies(f, rest).run(blocks, calls, fuel, c) = Done(after) → SplitDone(f, rest, blocks, calls, fuel, c, after) {
        Leaf(xs) => λ h => join_leaf_done(xs, rest, blocks, calls, fuel, c, after, h),
        Seq(a, b) => λ h => nonleaf_done(Seq(a, b), rest, blocks, calls, fuel, c, after, h),
        Branch(a, b, d) => λ h => nonleaf_done(Branch(a, b, d), rest, blocks, calls, fuel, c, after, h),
        Call(a, b, d) => λ h => nonleaf_done(Call(a, b, d), rest, blocks, calls, fuel, c, after, h),
        Loop(a, b, d, e, f, g) => λ h => nonleaf_done(Loop(a, b, d, e, f, g), rest, blocks, calls, fuel, c, after, h),
        Sys(a) => λ h => nonleaf_done(Sys(a), rest, blocks, calls, fuel, c, after, h),
        Exit(a) => λ h => nonleaf_done(Exit(a), rest, blocks, calls, fuel, c, after, h),
    })(ran)
}

// ---------------------------------------------------------------------------
// What a call passes, and what it answers

// The values a call passes against the old words: for a callee lent
// `count` buffers from `buffer` on, each one's reference to its block from
// 0 and its length first, then words.
fn ArgsAgree(count, buffer: Nat, args: List<Value>, words: List<BitVec(64)>) → Type {
    match count {
        Zero => args = words.map(λ (w: BitVec(64)) => x86_64_call_contract::Word(w)),
        Succ(m) => match args {
            Nil => False,
            Cons(a, more) => match more {
                Nil => False,
                Cons(l, rest) => match words {
                    Nil => False,
                    Cons(_, ws) => match ws {
                        Nil => False,
                        Cons(lw, wrest) => (a = Ref(Loc(buffer, 0))) ∧ ((l = x86_64_call_contract::Word(lw)) ∧ ArgsAgree(m, buffer + 1, rest, wrest)),
                    },
                },
            },
        },
    }
}

// The callees agree with the old ones: every `Done` of a call on values
// that agree with the old words, over a heap that is the buffers, answers
// the old words and leaves the heap that is the old buffers after.
fn CallsAgree(calls: Calls(), old: Writers(), lents: List<Nat>, below: Nat) → Type {
    (f: Nat) → f < below → (args: List<Value>) → (words: List<BitVec(64)>) → (heap: Heap) → (buffers: Buffers()) → (io: Io) → (answer: Answer) →
        ArgsAgree(lent_count(lents, f), 0, args, words) → ((b: Nat) → heap.bytes(b) = buffer_bytes(buffers, b)) → calls(f, args, heap, io) = Done(answer) →
        (answer.words = Cons(x86_64_call_contract::Word(old(buffers, f, words).word), old(buffers, f, words).rest.map(λ (w: BitVec(64)) => x86_64_call_contract::Word(w)))) ∧
            ((b: Nat) → answer.heap.bytes(b) = buffer_bytes(old(buffers, f, words).buffers, b))
}

// Word ids read as words.
fn AllWords(bound: Nat, refs: List<Nat>, ids: List<Nat>) → Type {
    match ids { Nil => True, Cons(id, rest) => ((id < bound) ∧ (mem_nat(id, refs) = False)) ∧ AllWords(bound, refs, rest) }
}

theorem read_words(bound: Nat, refs: List<Nat>, l: Locals, values: Valuation(), agree: Agree(bound, refs, [], l.words, values), ids: List<Nat>):
    AllWords(bound, refs, ids) → (vs: List<Value>) → read_values(Scope([], refs, []).typed_all(ids), l) = Some(vs) →
    vs = words_of(values, ids).map(λ (w: BitVec(64)) => x86_64_call_contract::Word(w)) {
    match ids {
        Nil => λ _ vs read => sym(Option::some_inj([], vs, read)),
        Cons(id, rest) => λ ok vs read => {
            let s = Scope([], refs, []);
            let later = λ (x: Value) => read_values(s.typed_all(rest), l).and_then(λ (xs: List<Value>) => Some(Cons(x, xs)));
            let first: (Typed(id, match mem_nat(id, refs) { True => RefKind, False => WordKind }) = word_id(id)) =
                j(sym(ok.left.right), λ b _ => Typed(id, match b { True => RefKind, False => WordKind }) = word_id(id), refl);
            let read2: (later(x86_64_call_contract::Word(l.word(id))) = Some(vs)) =
                j(first, λ v _ => l.read(v).and_then(later) = Some(vs), read);
            (match read_values(s.typed_all(rest), l) as λ o => read_values(s.typed_all(rest), l) = o →
                    o.and_then(λ (xs: List<Value>) => Some(Cons(x86_64_call_contract::Word(l.word(id)), xs))) = Some(vs) →
                    vs = words_of(values, Cons(id, rest)).map(λ (w: BitVec(64)) => x86_64_call_contract::Word(w)) {
                None => λ _ never => absurd(never),
                Some(xs) => λ more done => {
                    let is: (Cons(x86_64_call_contract::Word(l.word(id)), xs) = vs) = Option::some_inj(Cons(x86_64_call_contract::Word(l.word(id)), xs), vs, done);
                    let tail = read_words(bound, refs, l, values, agree, rest, ok.right, xs, more);
                    let head: (l.word(id) = values(64, id)) = agree(id, ok.left.left, ok.left.right, refl, 64);
                    trans(sym(is), eq2(λ (w: BitVec(64)) (ws: List<Value>) => Cons(x86_64_call_contract::Word(w), ws), head, tail))
                },
            })(refl, read2)
        },
    }
}

theorem homes_have_found(homes: List<Lent>, buffer, base, length: Nat): homes_have(homes, buffer, base, length) = True →
    Exists<Lent>(λ h => Mem(h, homes) ∧ ((h.buffer = buffer) ∧ ((h.base = base) ∧ (h.length = length)))) {
    match homes {
        Nil => λ never => absurd(never),
        Cons(h, rest) => match here: h.is(buffer, base, length) {
            True => λ _ => {
                let p = Bool::and_true_parts(h.buffer.same(buffer), h.base.same(base) && h.length.same(length), here);
                let q = Bool::and_true_parts(h.base.same(base), h.length.same(length), p.right);
                Exists(h, ⟨Inl(refl), ⟨h.buffer.same_sound(buffer, p.left), ⟨h.base.same_sound(base, q.left), h.length.same_sound(length, q.right)⟩⟩⟩)
            },
            False => λ found => {
                let inner = homes_have_found(rest, buffer, base, length, found);
                Exists(inner.witness, ⟨Inr(inner.proof.left), inner.proof.right⟩)
            },
        },
    }
}

// What the scope promises of its homes: each reference is one, each length
// an old word.
fn HomesTyped(bound: Nat, s: Scope) → Type {
    (h: Lent) → Mem(h, s.homes) → (mem_nat(h.base, s.refs) = True) ∧ ((h.length < bound) ∧ (mem_nat(h.length, s.refs) = False))
}

// Twice a count, by its own recursion, so that a list two longer drops it
// one step further.
fn pairs(count: Nat) → Nat { match count { Zero => 0, Succ(m) => Succ(Succ(pairs(m))) } }

theorem read_lent(bound: Nat, s: Scope, l: Locals, values: Valuation(), agree: Agree(bound, s.refs, [], l.words, values),
    refs: (h: Lent) → Mem(h, s.homes) → l.refs(h.base) = Some(Loc(h.buffer, 0)), typed: HomesTyped(bound, s), count: Nat):
    (buffer: Nat) → (args: List<Nat>) → args_lend(s.homes, count, buffer, args) = True → AllWords(bound, s.refs, args.drop(pairs(count))) →
    (vs: List<Value>) → read_values(s.typed_all(args), l) = Some(vs) → ArgsAgree(count, buffer, vs, words_of(values, args)) {
    match count {
        Zero => λ buffer args _ words vs read => read_words(bound, s.refs, l, values, agree, args, j(args.drop_zero(), λ x _ => AllWords(bound, s.refs, x), words), vs, read),
        Succ(m) => λ buffer args => match args {
            Nil => λ never => absurd(never),
            Cons(base, more) => match more {
                Nil => λ never => absurd(never),
                Cons(length, rest) => λ lends words vs read => {
                    let parts = Bool::and_true_parts(homes_have(s.homes, buffer, base, length), args_lend(s.homes, m, buffer + 1, rest), lends);
                    let found = homes_have_found(s.homes, buffer, base, length, parts.left);
                    let h = found.witness;
                    let kinds = typed(h, found.proof.left);
                    let base_ref: (mem_nat(base, s.refs) = True) = j(found.proof.right.right.left, λ x _ => mem_nat(x, s.refs) = True, kinds.left);
                    let length_word: (mem_nat(length, s.refs) = False) = j(found.proof.right.right.right, λ x _ => mem_nat(x, s.refs) = False, kinds.right.right);
                    let length_below: (length < bound) = j(found.proof.right.right.right, λ x _ => x < bound, kinds.right.left);
                    let at: (l.refs(base) = Some(Loc(buffer, 0))) = j(found.proof.right.left, λ x _ => l.refs(base) = Some(Loc(x, 0)),
                        j(found.proof.right.right.left, λ x _ => l.refs(x) = Some(Loc(h.buffer, 0)), refs(h, found.proof.left)));
                    let base_typed: (s.typed(base) = ref_id(base)) = j(sym(base_ref), λ b _ => Typed(base, match b { True => RefKind, False => WordKind }) = ref_id(base), refl);
                    let length_typed: (s.typed(length) = word_id(length)) =
                        j(sym(length_word), λ b _ => Typed(length, match b { True => RefKind, False => WordKind }) = word_id(length), refl);
                    let tail = λ (x: Value) => read_values(s.typed_all(rest), l).and_then(λ (xs: List<Value>) => Some(Cons(x, xs)));
                    let after_base = λ (x: Value) => l.read(word_id(length)).and_then(tail).and_then(λ (xs: List<Value>) => Some(Cons(x, xs)));
                    let read2: (after_base(Ref(Loc(buffer, 0))) = Some(vs)) =
                        j(at, λ o _ => o.map(λ (loc: Loc) => Ref(loc)).and_then(after_base) = Some(vs),
                            j(length_typed, λ v _ => l.read(ref_id(base)).and_then(λ (x: Value) => l.read(v).and_then(tail).and_then(λ (xs: List<Value>) => Some(Cons(x, xs)))) = Some(vs),
                                j(base_typed, λ v _ => l.read(v).and_then(λ (x: Value) => l.read(s.typed(length)).and_then(tail).and_then(λ (xs: List<Value>) => Some(Cons(x, xs)))) = Some(vs),
                                    read)));
                    (match read_values(s.typed_all(rest), l) as λ o => read_values(s.typed_all(rest), l) = o →
                            o.and_then(λ (xs: List<Value>) => Some(Cons(x86_64_call_contract::Word(l.word(length)), xs))).and_then(λ (xs: List<Value>) => Some(Cons(Ref(Loc(buffer, 0)), xs))) = Some(vs) →
                            ArgsAgree(Succ(m), buffer, vs, words_of(values, Cons(base, Cons(length, rest)))) {
                        None => λ _ never => absurd(never),
                        Some(xs) => λ more_read done => {
                            let is: (Cons(Ref(Loc(buffer, 0)), Cons(x86_64_call_contract::Word(l.word(length)), xs)) = vs) =
                                Option::some_inj(Cons(Ref(Loc(buffer, 0)), Cons(x86_64_call_contract::Word(l.word(length)), xs)), vs, done);
                            let inner = read_lent(bound, s, l, values, agree, refs, typed, m, buffer + 1, rest, parts.right, words, xs, more_read);
                            let len_same: (l.word(length) = values(64, length)) = agree(length, length_below, length_word, refl, 64);
                            j(is, λ v _ => ArgsAgree(Succ(m), buffer, v, words_of(values, Cons(base, Cons(length, rest)))),
                                ⟨refl, ⟨cong_fn<BitVec(64), Value>(λ w => x86_64_call_contract::Word(w), len_same), inner⟩⟩)
                        },
                    })(refl, read2)
                },
            },
        },
    }
}

// A call of one result, translated: every `Done` agrees with the old call,
// the callees agreeing with the old ones.
theorem call_agrees(blocks: Blocks, calls: Calls(), old: Writers(), lents: List<Nat>, fuel, bound: Nat, s: Scope, callee: Nat, arguments: List<Nat>,
    result: Nat, c, after: Config, values: Valuation(), buffers: Buffers(), agree: Agree(bound, s.refs, [], c.locals.words, values),
    held: HomesHeld(s.homes, c, buffers), typed: HomesTyped(bound, s), lends: args_lend(s.homes, lent_count(lents, callee), 0, arguments) = True,
    words: AllWords(bound, s.refs, arguments.drop(pairs(lent_count(lents, callee)))), result_word: (result < bound) ∧ (mem_nat(result, s.refs) = False),
    below: Nat, answers: CallsAgree(calls, old, lents, below), callee_below: callee < below, ran: bytes_level::Call(callee, s.typed_all(arguments), words_typed([result])).run(blocks, calls, fuel, c) = Done(after)):
    Agree(bound, s.refs, [], after.locals.words, function_ir::Call(callee, arguments, result, []).run(old, values, buffers).values) ∧
        HomesHeld(s.homes, after, function_ir::Call(callee, arguments, result, []).run(old, values, buffers).buffers) {
    let results: List<Typed> = [word_id(result)];
    let answered = λ (vs: List<Value>) => calls(callee, vs, c.memory, c.io).then(λ (answer: Answer) =>
        Ran::of(bind_values(results, answer.words, c.locals), answer.io).then(λ (l: Locals) => Done(Config(l, answer.heap, answer.io))));
    let first = Ran::then_done<List<Value>, Config>(Ran::of(read_values(s.typed_all(arguments), c.locals), c.io), answered, after, ran);
    let vs = first.witness;
    let read: (read_values(s.typed_all(arguments), c.locals) = Some(vs)) = Ran::of_done<List<Value>>(read_values(s.typed_all(arguments), c.locals), c.io, vs, first.proof.left);
    let landed = λ (answer: Answer) => Ran::of(bind_values(results, answer.words, c.locals), answer.io).then(λ (l: Locals) => Done(Config(l, answer.heap, answer.io)));
    let second = Ran::then_done<Answer, Config>(calls(callee, vs, c.memory, c.io), landed, after, first.proof.right);
    let answer = second.witness;
    let e = old(buffers, callee, words_of(values, arguments));
    let args = read_lent(bound, s, c.locals, values, agree, held.left, typed, lent_count(lents, callee), 0, arguments, lends, words, vs, read);
    let got = answers(callee, callee_below, vs, words_of(values, arguments), c.memory, buffers, c.io, answer, args, held.right, second.proof.left);
    let third = Ran::then_done<Locals, Config>(Ran::of(bind_values(results, answer.words, c.locals), answer.io),
        λ (l: Locals) => Done(Config(l, answer.heap, answer.io)), after, second.proof.right);
    let bound_l: (bind_values(results, answer.words, c.locals) = Some(third.witness)) =
        Ran::of_done<Locals>(bind_values(results, answer.words, c.locals), answer.io, third.witness, third.proof.left);
    let end: (after = Config(third.witness, answer.heap, answer.io)) = sym(Ran::done_inj<Config>(Config(third.witness, answer.heap, answer.io), after, third.proof.right));
    let bound2: (bind_values(results, Cons(x86_64_call_contract::Word(e.word), e.rest.map(λ (w: BitVec(64)) => x86_64_call_contract::Word(w))), c.locals) = Some(third.witness)) =
        j(got.left, λ ws _ => bind_values(results, ws, c.locals) = Some(third.witness), bound_l);
    let locals: (third.witness = c.locals.set_word(result, word_value(e.word))) =
        (match e.rest.map(λ (w: BitVec(64)) => x86_64_call_contract::Word(w)) as λ r => bind_values(results, Cons(x86_64_call_contract::Word(e.word), r), c.locals) = Some(third.witness) →
                third.witness = c.locals.set_word(result, word_value(e.word)) {
            Nil => λ h => sym(Option::some_inj(c.locals.set_word(result, word_value(e.word)), third.witness, h)),
            Cons(_, _) => λ never => absurd(never),
        })(bound2);
    let words_are: (after.locals.words = Valuation::set(c.locals.words, result, word_value(e.word))) =
        trans(cong_fn<Config, Valuation()>(λ m => m.locals.words, end), cong_fn<Locals, Valuation()>(λ l => l.words, locals));
    let refs_are: (after.locals.refs = c.locals.refs) = trans(cong_fn<Config, Nat → Option<Loc>>(λ m => m.locals.refs, end), cong_fn<Locals, Nat → Option<Loc>>(λ l => l.refs, locals));
    let heap_is: (after.memory = answer.heap) = cong_fn<Config, Heap>(λ m => m.memory, end);
    ⟨j(sym(words_are), λ v _ => Agree(bound, s.refs, [], v, Valuation::set(values, result, word_value(e.word))),
            agree_set(bound, s.refs, [], c.locals.words, values, agree, result, word_value(e.word), word_value(e.word), λ w => refl)),
        ⟨λ h m => trans(cong_fn<Nat → Option<Loc>, Option<Loc>>(λ r => r(h.base), refs_are), held.left(h, m)),
            λ b => trans(cong_fn<Heap, List<BitVec(8)>>(λ m => m.bytes(b), heap_is), got.right(b))⟩⟩
}

// ---------------------------------------------------------------------------
// A branch

// What a region's translation owes the old run where its body is done.
fn Owes(bound: Nat, s: Scope, after: Config, state: State) → Type {
    Agree(bound, s.refs, [], after.locals.words, state.values) ∧ HomesHeld(s.homes, after, state.buffers)
}

// A conditional, translated as a branch on its bit: each arm's agreement
// is the conditional's where the bit picks it.
theorem branch_agrees(blocks: Blocks, calls: Calls(), old: Writers(), fuel, bound: Nat, s: Scope, condition: Nat, yes, no: Body, inputs: Ports,
    arguments, outputs: Ports, yes_r, no_r: StructuredRegion, c, after: Config, values: Valuation(), buffers: Buffers(),
    agree: Agree(bound, s.refs, [], c.locals.words, values), bit: (condition < bound) ∧ (mem_nat(condition, s.refs) = False),
    yes_ih: yes.run(blocks, calls, fuel, c) = Done(after) → Owes(bound, s, after, yes_r.run(old, values, buffers)),
    no_ih: no.run(blocks, calls, fuel, c) = Done(after) → Owes(bound, s, after, no_r.run(old, values, buffers)),
    ran: Branch(condition, yes, no).run(blocks, calls, fuel, c) = Done(after)):
    Owes(bound, s, after, Conditional(inputs, condition, arguments, outputs, yes_r, no_r).run(old, values, buffers)) {
    let same: (c.locals.words(1, condition).head_bit() = values(1, condition).head_bit()) =
        cong_fn<BitVec(1), Bool>(λ x => x.head_bit(), agree(condition, bit.left, bit.right, refl, 1));
    let picked = λ (b: Bool) => Owes(bound, s, after, State(λ w id => match b {
            False => no_r.run(old, values, buffers).values(w, id),
            True => yes_r.run(old, values, buffers).values(w, id),
        }, match b { False => no_r.run(old, values, buffers).buffers, True => yes_r.run(old, values, buffers).buffers }));
    let ran2: ((match values(1, condition).head_bit() { True => yes.run(blocks, calls, fuel, c), False => no.run(blocks, calls, fuel, c) }) = Done(after)) =
        j(same, λ b _ => (match b { True => yes.run(blocks, calls, fuel, c), False => no.run(blocks, calls, fuel, c) }) = Done(after), ran);
    (match values(1, condition).head_bit() as λ b =>
            (match b { True => yes.run(blocks, calls, fuel, c), False => no.run(blocks, calls, fuel, c) }) = Done(after) → picked(b) {
        True => λ h => yes_ih(h),
        False => λ h => no_ih(h),
    })(ran2)
}

// ---------------------------------------------------------------------------
// No offset

theorem shift_node_zero(node: Node): shift_node(node, 0) = node {
    match node {
        Const(_, _, _) => refl, Move(_, _, _) => refl, Add(_, _, _, _) => refl, Sub(_, _, _, _) => refl, BitAnd(_, _, _, _) => refl,
        BitOr(_, _, _, _) => refl, BitXor(_, _, _, _) => refl, ShiftLeft(_, _, _, _) => refl, LogicalShiftRight(_, _, _, _) => refl,
        ArithmeticShiftRight(_, _, _, _) => refl, UnsignedLessThan(_, _, _, _) => refl, SignedLessThan(_, _, _, _) => refl, Equal(_, _, _, _) => refl,
        BufferLoad(_, _, _) => refl, BufferStore(_, _, _, _) => refl, Resize(_, _, _, _) => refl, SignResize(_, _, _, _) => refl,
        TableRead(_, _, _, _, _) => refl, WideLoad(_, _, _, _) => refl, WideStore(_, _, _, _, _) => refl, ByteSwap(_, _, _) => refl,
        RotateRight(_, _, _, _) => refl, Apply(_, _, _, _, _) => refl,
    }
}

theorem shift_nodes_zero(nodes: List<Node>): shift_nodes(nodes, 0) = nodes {
    match nodes { Nil => refl, Cons(n, rest) => eq2(λ (x: Node) (xs: List<Node>) => Cons(x, xs), shift_node_zero(n), shift_nodes_zero(rest)) }
}

theorem shift_ids_zero(ids: List<Nat>): shift_ids(ids, 0) = ids {
    match ids { Nil => refl, Cons(x, rest) => cong_fn<List<Nat>, List<Nat>>(λ xs => Cons(x, xs), shift_ids_zero(rest)) }
}

// ---------------------------------------------------------------------------
// What a region asks, mirroring its translation

fn LeafOk(bound: Nat, refs: List<Nat>, s: Scope, nodes: List<Node>, next: Nat, reads: List<Nat>) → Type {
    ((made: Made) → translate_nodes(s, nodes, next, reads) = Some(made) → Exists<List<Instr>>(λ all => made.body = Leaf(all))) ∧
        (NodesFit(bound, refs, [], nodes, next) ∧ (leaf_pending(nodes, []) = []))
}

// A region of leaves, sequences, conditionals and calls of one result (no
// loop, no lend), each part's ids old words where it reads them.
fn RegionFits(bound: Nat, refs: List<Nat>, s: Scope, region: StructuredRegion, next: Nat, reads: List<Nat>, at: Nat, lents: List<Nat>) → Type {
    match region {
        Dataflow(body) => LeafOk(bound, refs, s, body.nodes, next, reads),
        Sequence(prefix, rest) => LeafOk(bound, refs, s, prefix.nodes, next, reads) ∧
            ((first: Made) → translate_nodes(s, prefix.nodes, next, reads) = Some(first) → RegionFits(bound, refs, first.scope, rest, first.next, reads, at, lents)),
        Compose(a, b) => RegionFits(bound, refs, s, a, next, reads, at, lents) ∧
            ((first: Made) → translate_region(s, a, next, reads, at, lents, 0) = Some(first) → RegionFits(bound, refs, first.scope, b, first.next, reads, at, lents)),
        Conditional(_, condition, _, _, yes, no) => ((condition < bound) ∧ (mem_nat(condition, refs) = False)) ∧
            (RegionFits(bound, refs, s.know(Truth(condition)), yes, next, reads, at, lents) ∧
                ((left: Made) → translate_region(s.know(Truth(condition)), yes, next, reads, at, lents, 0) = Some(left) →
                    RegionFits(bound, refs, s.know(Falsity(condition)), no, left.next, reads, at, lents))),
        Call(callee, arguments, result, also) => (also = []) ∧
            (AllWords(bound, refs, arguments.drop(pairs(lent_count(lents, callee)))) ∧ ((result < bound) ∧ (mem_nat(result, refs) = False))),
        Loop(_, _, _, _, _, _, _, _, _) => False,
        Lend(_, _, _, _) => False,
    }
}

// What a scope's homes promise, for homes and references as given.
fn ScopeOk(bound: Nat, homes: List<Lent>, refs: List<Nat>) → Type {
    ((h: Lent) → Mem(h, homes) → h.base < bound) ∧ HomesTyped(bound, Scope(homes, refs, []))
}

// ---------------------------------------------------------------------------
// The region theorem

theorem leaf_owes(blocks: Blocks, calls: Calls(), fuel, bound: Nat, homes: List<Lent>, refs: List<Nat>, s: Scope, hs: s.homes = homes, rs: s.refs = refs,
    nodes: List<Node>, next: Nat, reads: List<Nat>, made: Made, translated: translate_nodes(s, nodes, next, reads) = Some(made), ok: LeafOk(bound, refs, s, nodes, next, reads),
    c, after: Config, ran: made.body.run(blocks, calls, fuel, c) = Done(after), values: Valuation(), buffers: Buffers(),
    agree: Agree(bound, refs, [], c.locals.words, values), held: HomesHeld(homes, c, buffers), scope_ok: ScopeOk(bound, homes, refs)):
    (Agree(bound, refs, [], after.locals.words, run_nodes(nodes, values, buffers).values) ∧ HomesHeld(homes, after, run_nodes(nodes, values, buffers).buffers)) ∧
        ((made.scope.homes = homes) ∧ (made.scope.refs = refs)) {
    let leaf = ok.left(made, translated);
    let ran2: (Leaf(leaf.witness).run(blocks, calls, fuel, c) = Done(after)) = j(leaf.proof, λ b _ => b.run(blocks, calls, fuel, c) = Done(after), ran);
    let instrs: (run_instrs(blocks, leaf.witness, c) = Some(after)) = Ran::of_done<Config>(run_instrs(blocks, leaf.witness, c), c.io, after, ran2);
    let got = leaf_runs_as_old(blocks, bound, nodes, s, next, reads, made, translated, leaf.witness, leaf.proof, c, after, instrs, [], values, buffers,
        j(sym(rs), λ r _ => Agree(bound, r, [], c.locals.words, values), agree), j(sym(hs), λ h _ => HomesHeld(h, c, buffers), held),
        j(sym(hs), λ h _ => (g: Lent) → Mem(g, h) → g.base < bound, scope_ok.left),
        j(sym(rs), λ r _ => NodesFit(bound, r, [], nodes, next), ok.right.left));
    let pending_none = ok.right.right;
    ⟨⟨j(pending_none, λ p _ => Agree(bound, refs, p, after.locals.words, run_nodes(nodes, values, buffers).values),
            j(rs, λ r _ => Agree(bound, r, leaf_pending(nodes, []), after.locals.words, run_nodes(nodes, values, buffers).values), got.left.left)),
        j(hs, λ h _ => HomesHeld(h, after, run_nodes(nodes, values, buffers).buffers), got.left.right)⟩,
        ⟨trans(got.right.left, hs), trans(got.right.right, rs)⟩⟩
}

// What a region owes, at homes and references as given.
fn RegionOwes(bound: Nat, homes: List<Lent>, refs: List<Nat>, after: Config, state: State) → Type {
    Agree(bound, refs, [], after.locals.words, state.values) ∧ HomesHeld(homes, after, state.buffers)
}

theorem region_owes(blocks: Blocks, calls: Calls(), old: Writers(), fuel, bound: Nat, homes: List<Lent>, refs: List<Nat>, at: Nat, lents: List<Nat>,
    answers: CallsAgree(calls, old, lents, at), scope_ok: ScopeOk(bound, homes, refs), region: StructuredRegion):
    (s: Scope) → s.homes = homes → s.refs = refs → (next: Nat) → (reads: List<Nat>) → (made: Made) → translate_region(s, region, next, reads, at, lents, 0) = Some(made) →
    RegionFits(bound, refs, s, region, next, reads, at, lents) → (c, after: Config) → made.body.run(blocks, calls, fuel, c) = Done(after) →
    (values: Valuation()) → (buffers: Buffers()) → Agree(bound, refs, [], c.locals.words, values) → HomesHeld(homes, c, buffers) →
    RegionOwes(bound, homes, refs, after, region.run(old, values, buffers)) ∧ ((made.scope.homes = homes) ∧ (made.scope.refs = refs)) {
    match region {
        Dataflow(body) => λ s hs rs next reads made translated fits c after ran values buffers agree held =>
            leaf_owes(blocks, calls, fuel, bound, homes, refs, s, hs, rs, body.nodes, next, reads, made,
                j(shift_nodes_zero(body.nodes), λ ns _ => translate_nodes(s, ns, next, reads) = Some(made), translated), fits, c, after, ran, values, buffers, agree, held,
                scope_ok),
        Sequence(prefix, rest) => λ s hs rs next reads made translated fits c after ran values buffers agree held => {
            let goal = RegionOwes(bound, homes, refs, after, Sequence(prefix, rest).run(old, values, buffers)) ∧ ((made.scope.homes = homes) ∧ (made.scope.refs = refs));
            let shaped = λ (o: Option<Made>) => match o as λ _ => Option<Made> {
                None => None,
                Some(first) => match translate_region(first.scope, rest, first.next, reads, at, lents, 0) {
                    None => None,
                    Some(second) => Some(Made(seq_bodies(first.body, second.body), second.next, second.scope)),
                },
            };
            let translated2: (shaped(translate_nodes(s, prefix.nodes, next, reads)) = Some(made)) =
                j(shift_nodes_zero(prefix.nodes), λ ns _ => shaped(translate_nodes(s, ns, next, reads)) = Some(made), translated);
            (match translate_nodes(s, prefix.nodes, next, reads) as λ o => translate_nodes(s, prefix.nodes, next, reads) = o → shaped(o) = Some(made) → goal {
                None => λ _ never => absurd(never),
                Some(first) => λ e1 inner => (match translate_region(first.scope, rest, first.next, reads, at, lents, 0) as λ o =>
                        translate_region(first.scope, rest, first.next, reads, at, lents, 0) = o →
                        (match o { None => None, Some(second) => Some(Made(seq_bodies(first.body, second.body), second.next, second.scope)) }) = Some(made) → goal {
                    None => λ _ never => absurd(never),
                    Some(second) => λ e2 some => {
                        let is = Option::some_inj(Made(seq_bodies(first.body, second.body), second.next, second.scope), made, some);
                        let ran2: (seq_bodies(first.body, second.body).run(blocks, calls, fuel, c) = Done(after)) =
                            j(sym(is), λ m _ => m.body.run(blocks, calls, fuel, c) = Done(after), ran);
                        let parts = seq_bodies_done(first.body, second.body, blocks, calls, fuel, c, after, ran2);
                        let mid = parts.witness;
                        let one = leaf_owes(blocks, calls, fuel, bound, homes, refs, s, hs, rs, prefix.nodes, next, reads, first, e1, fits.left, c, mid,
                            parts.proof.left, values, buffers, agree, held, scope_ok);
                        let state = run_nodes(prefix.nodes, values, buffers);
                        let two = region_owes(blocks, calls, old, fuel, bound, homes, refs, at, lents, answers, scope_ok, rest, first.scope, one.right.left, one.right.right,
                            first.next, reads, second, e2, fits.right(first, e1), mid, after, parts.proof.right, state.values, state.buffers, one.left.left, one.left.right);
                        ⟨two.left, j(is, λ m _ => (m.scope.homes = homes) ∧ (m.scope.refs = refs), two.right)⟩
                    },
                })(refl, inner),
            })(refl, translated2)
        },
        Compose(a, b) => λ s hs rs next reads made translated fits c after ran values buffers agree held => {
            let goal = RegionOwes(bound, homes, refs, after, Compose(a, b).run(old, values, buffers)) ∧ ((made.scope.homes = homes) ∧ (made.scope.refs = refs));
            (match translate_region(s, a, next, reads, at, lents, 0) as λ o => translate_region(s, a, next, reads, at, lents, 0) = o →
                    (match o {
                        None => None,
                        Some(first) => match translate_region(first.scope, b, first.next, reads, at, lents, 0) {
                            None => None,
                            Some(second) => Some(Made(seq_bodies(first.body, second.body), second.next, second.scope)),
                        },
                    }) = Some(made) → goal {
                None => λ _ never => absurd(never),
                Some(first) => λ e1 inner => (match translate_region(first.scope, b, first.next, reads, at, lents, 0) as λ o =>
                        translate_region(first.scope, b, first.next, reads, at, lents, 0) = o →
                        (match o { None => None, Some(second) => Some(Made(seq_bodies(first.body, second.body), second.next, second.scope)) }) = Some(made) → goal {
                    None => λ _ never => absurd(never),
                    Some(second) => λ e2 some => {
                        let is = Option::some_inj(Made(seq_bodies(first.body, second.body), second.next, second.scope), made, some);
                        let ran2: (seq_bodies(first.body, second.body).run(blocks, calls, fuel, c) = Done(after)) =
                            j(sym(is), λ m _ => m.body.run(blocks, calls, fuel, c) = Done(after), ran);
                        let parts = seq_bodies_done(first.body, second.body, blocks, calls, fuel, c, after, ran2);
                        let mid = parts.witness;
                        let one = region_owes(blocks, calls, old, fuel, bound, homes, refs, at, lents, answers, scope_ok, a, s, hs, rs, next, reads, first, e1, fits.left,
                            c, mid, parts.proof.left, values, buffers, agree, held);
                        let state = a.run(old, values, buffers);
                        let two = region_owes(blocks, calls, old, fuel, bound, homes, refs, at, lents, answers, scope_ok, b, first.scope, one.right.left, one.right.right,
                            first.next, reads, second, e2, fits.right(first, e1), mid, after, parts.proof.right, state.values, state.buffers, one.left.left, one.left.right);
                        ⟨two.left, j(is, λ m _ => (m.scope.homes = homes) ∧ (m.scope.refs = refs), two.right)⟩
                    },
                })(refl, inner),
            })(refl, translated)
        },
        Conditional(inputs, condition, arguments, outputs, yes, no) => λ s hs rs next reads made translated fits c after ran values buffers agree held => {
            let goal = RegionOwes(bound, homes, refs, after, Conditional(inputs, condition, arguments, outputs, yes, no).run(old, values, buffers)) ∧
                ((made.scope.homes = homes) ∧ (made.scope.refs = refs));
            (match translate_region(s.know(Truth(condition)), yes, next, reads, at, lents, 0) as λ o =>
                    translate_region(s.know(Truth(condition)), yes, next, reads, at, lents, 0) = o →
                    (match o {
                        None => None,
                        Some(left) => match translate_region(s.know(Falsity(condition)), no, left.next, reads, at, lents, 0) {
                            None => None,
                            Some(right) => Some(Made(Branch(condition, left.body, right.body), right.next, s)),
                        },
                    }) = Some(made) → goal {
                None => λ _ never => absurd(never),
                Some(left) => λ e1 inner => (match translate_region(s.know(Falsity(condition)), no, left.next, reads, at, lents, 0) as λ o =>
                        translate_region(s.know(Falsity(condition)), no, left.next, reads, at, lents, 0) = o →
                        (match o { None => None, Some(right) => Some(Made(Branch(condition, left.body, right.body), right.next, s)) }) = Some(made) → goal {
                    None => λ _ never => absurd(never),
                    Some(right) => λ e2 some => {
                        let is = Option::some_inj(Made(Branch(condition, left.body, right.body), right.next, s), made, some);
                        let ran2: (Branch(condition, left.body, right.body).run(blocks, calls, fuel, c) = Done(after)) =
                            j(sym(is), λ m _ => m.body.run(blocks, calls, fuel, c) = Done(after), ran);
                        let flat = Scope(homes, refs, []);
                        let owed = branch_agrees(blocks, calls, old, fuel, bound, flat, condition, left.body, right.body, inputs, arguments, outputs, yes, no, c, after,
                            values, buffers, agree, fits.left,
                            λ h => region_owes(blocks, calls, old, fuel, bound, homes, refs, at, lents, answers, scope_ok, yes, s.know(Truth(condition)), hs, rs,
                                next, reads, left, e1, fits.right.left, c, after, h, values, buffers, agree, held).left,
                            λ h => region_owes(blocks, calls, old, fuel, bound, homes, refs, at, lents, answers, scope_ok, no, s.know(Falsity(condition)), hs, rs,
                                left.next, reads, right, e2, fits.right.right(left, e1), c, after, h, values, buffers, agree, held).left,
                            ran2);
                        ⟨owed, j(is, λ m _ => (m.scope.homes = homes) ∧ (m.scope.refs = refs), ⟨hs, rs⟩)⟩
                    },
                })(refl, inner),
            })(refl, translated)
        },
        Call(callee, arguments, result, also) => λ s hs rs next reads made translated fits c after ran values buffers agree held => {
            let goal = RegionOwes(bound, homes, refs, after, StructuredRegion::Call(callee, arguments, result, also).run(old, values, buffers)) ∧
                ((made.scope.homes = homes) ∧ (made.scope.refs = refs));
            let shaped = λ (ids: List<Nat>) => match calls_below(at, callee, lents, s, ids) as λ _ => Option<Made> {
                False => None,
                True => Some(Made(bytes_level::Call(callee, s.typed_all(ids), words_typed(shift_ids(Cons(result, also), 0))), next, s)),
            };
            let translated2: (shaped(arguments) = Some(made)) = j(shift_ids_zero(arguments), λ ids _ => shaped(ids) = Some(made), translated);
            j(sym(fits.left), λ x _ => RegionOwes(bound, homes, refs, after, StructuredRegion::Call(callee, arguments, result, x).run(old, values, buffers)) ∧
                    ((made.scope.homes = homes) ∧ (made.scope.refs = refs)),
                (match calls_below(at, callee, lents, s, arguments) as λ b => calls_below(at, callee, lents, s, arguments) = b →
                        (match b { False => None, True => Some(Made(bytes_level::Call(callee, s.typed_all(arguments), words_typed(shift_ids(Cons(result, also), 0))), next, s)) }) =
                            Some(made) →
                        RegionOwes(bound, homes, refs, after, StructuredRegion::Call(callee, arguments, result, []).run(old, values, buffers)) ∧
                            ((made.scope.homes = homes) ∧ (made.scope.refs = refs)) {
                    False => λ _ never => absurd(never),
                    True => λ checked some => {
                        let is = Option::some_inj(Made(bytes_level::Call(callee, s.typed_all(arguments), words_typed(shift_ids(Cons(result, also), 0))), next, s), made, some);
                        let parts = Bool::and_true_parts((callee + 1).leb(at), args_lend(s.homes, lent_count(lents, callee), 0, arguments), checked);
                        let ran2: (bytes_level::Call(callee, s.typed_all(arguments), words_typed([result])).run(blocks, calls, fuel, c) = Done(after)) =
                            j(fits.left, λ x _ => bytes_level::Call(callee, s.typed_all(arguments), words_typed(shift_ids(Cons(result, x), 0))).run(blocks, calls, fuel, c) =
                                Done(after), j(sym(is), λ m _ => m.body.run(blocks, calls, fuel, c) = Done(after), ran));
                        let callee_below: (callee < at) = Nat::le_of_leb_eq(callee + 1, at, parts.left);
                        let got = call_agrees(blocks, calls, old, lents, fuel, bound, s, callee, arguments, result, c, after, values, buffers,
                            j(sym(rs), λ r _ => Agree(bound, r, [], c.locals.words, values), agree), j(sym(hs), λ h _ => HomesHeld(h, c, buffers), held),
                            j(sym(rs), λ r _ => HomesTyped(bound, Scope(s.homes, r, s.known)), j(sym(hs), λ h _ => HomesTyped(bound, Scope(h, refs, s.known)), scope_ok.right)),
                            parts.right, j(sym(rs), λ r _ => AllWords(bound, r, arguments.drop(pairs(lent_count(lents, callee)))), fits.right.left),
                            j(sym(rs), λ r _ => (result < bound) ∧ (mem_nat(result, r) = False), fits.right.right), at, answers, callee_below, ran2);
                        ⟨⟨j(rs, λ r _ => Agree(bound, r, [], after.locals.words, StructuredRegion::Call(callee, arguments, result, []).run(old, values, buffers).values), got.left),
                                j(hs, λ h _ => HomesHeld(h, after, StructuredRegion::Call(callee, arguments, result, []).run(old, values, buffers).buffers), got.right)⟩,
                            j(is, λ m _ => (m.scope.homes = homes) ∧ (m.scope.refs = refs), ⟨hs, rs⟩)⟩
                    },
                })(refl, translated2))
        },
        Loop(_, _, _, _, _, _, _, _, _) => λ s hs rs next reads made translated fits => false_elim(fits),
        Lend(_, _, _, _) => λ s hs rs next reads made translated fits => false_elim(fits),
    }
}

// ---------------------------------------------------------------------------
// A routine's entry

fn Distinct(ids: List<Nat>) → Type { match ids { Nil => True, Cons(x, rest) => (mem_nat(x, rest) = False) ∧ Distinct(rest) } }

// Words that agree on every id holding no reference.
fn Plain(refs: List<Nat>, words, values: Valuation()) → Type { (x: Nat) → mem_nat(x, refs) = False → (w: Nat) → words(w, x) = values(w, x) }

theorem mem_nat_cons_false(p, q: Nat, rest: List<Nat>, absent: mem_nat(p, Cons(q, rest)) = False): (q ≠ p) ∧ (mem_nat(p, rest) = False) {
    let parts = Bool::or_false_parts(q.same(p), mem_nat(p, rest), absent);
    ⟨λ e => absurd(trans(sym(j(e, λ y _ => q.same(y) = True, q.same_self())), parts.left)), parts.right⟩
}

// Setting `p` before binding ids it is none of is setting it after.
theorem bind_set_swap(v0: Valuation(), p: Nat, value: (w: Nat) → BitVec(w), rest: List<Nat>): (ws: List<BitVec(64)>) → mem_nat(p, rest) = False →
    (w, x: Nat) → Valuation::bind(Valuation::set(v0, p, value), rest, ws)(w, x) = Valuation::set(Valuation::bind(v0, rest, ws), p, value)(w, x) {
    match rest {
        Nil => λ ws _ w x => refl,
        Cons(q, more) => λ ws => match ws {
            Nil => λ _ w x => refl,
            Cons(u, us) => λ absent w x => {
                let parts = mem_nat_cons_false(p, q, more, absent);
                let inner = Valuation::bind(Valuation::set(v0, p, value), more, us);
                let base = Valuation::bind(v0, more, us);
                match x.eq_dec(q) as λ _ => Valuation::set(inner, q, word_value(u))(w, x) = Valuation::set(Valuation::set(base, q, word_value(u)), p, value)(w, x) {
                    Inl(here) => j(sym(here), λ y _ => Valuation::set(inner, q, word_value(u))(w, y) = Valuation::set(Valuation::set(base, q, word_value(u)), p, value)(w, y),
                        trans(Valuation::set_here(inner, q, word_value(u), w),
                            trans(sym(Valuation::set_here(base, q, word_value(u), w)),
                                sym(Valuation::set_other(Valuation::set(base, q, word_value(u)), p, value, w, q, parts.left))))),
                    Inr(not_q) => trans(Valuation::set_other(inner, q, word_value(u), w, x, not_q),
                        trans(bind_set_swap(v0, p, value, more, us, parts.right, w, x),
                            match x.eq_dec(p) as λ _ => Valuation::set(base, p, value)(w, x) = Valuation::set(Valuation::set(base, q, word_value(u)), p, value)(w, x) {
                                Inl(at_p) => j(sym(at_p), λ y _ => Valuation::set(base, p, value)(w, y) = Valuation::set(Valuation::set(base, q, word_value(u)), p, value)(w, y),
                                    trans(Valuation::set_here(base, p, value, w), sym(Valuation::set_here(Valuation::set(base, q, word_value(u)), p, value, w)))),
                                Inr(not_p) => trans(Valuation::set_other(base, p, value, w, x, not_p),
                                    trans(sym(Valuation::set_other(base, q, word_value(u), w, x, not_q)),
                                        sym(Valuation::set_other(Valuation::set(base, q, word_value(u)), p, value, w, x, not_p)))),
                            })),
                }
            },
        },
    }
}

fn AllPlain(refs: List<Nat>, ids: List<Nat>) → Type { match ids { Nil => True, Cons(x, rest) => (mem_nat(x, refs) = False) ∧ AllPlain(refs, rest) } }

// The parameters as the translation types them: for each buffer lent, a
// reference then a length, then words.
fn ParamKinds(refs: List<Nat>, count: Nat, params: List<Nat>) → Type {
    match count {
        Zero => AllPlain(refs, params),
        Succ(m) => match params {
            Nil => False,
            Cons(b, more) => match more { Nil => False, Cons(len, rest) => ((mem_nat(b, refs) = True) ∧ (mem_nat(len, refs) = False)) ∧ ParamKinds(refs, m, rest) },
        },
    }
}

// A bind of ids none of which is `y` leaves `y`'s reference.
theorem bind_keeps_ref(refs: List<Nat>, y: Nat, ids: List<Nat>): (args: List<Value>) → (l0, l: Locals) → mem_nat(y, ids) = False →
    bind_values(Scope([], refs, []).typed_all(ids), args, l0) = Some(l) → l.refs(y) = l0.refs(y) {
    match ids {
        Nil => λ args l0 l _ bound => match args as λ a => bind_values([], a, l0) = Some(l) → l.refs(y) = l0.refs(y) {
            Nil => λ h => cong_fn<Locals, Option<Loc>>(λ m => m.refs(y), sym(Option::some_inj(l0, l, h))),
            Cons(_, _) => λ never => absurd(never),
        }(bound),
        Cons(p, rest) => λ args l0 l absent bound => {
            let parts = mem_nat_cons_false(y, p, rest, absent);
            let v = Scope([], refs, []).typed(p);
            (match args as λ a => bind_values(Cons(v, Scope([], refs, []).typed_all(rest)), a, l0) = Some(l) → l.refs(y) = l0.refs(y) {
                Nil => λ never => absurd(never),
                Cons(x, xs) => λ h => (match l0.bind(v, x) as λ o => l0.bind(v, x) = o →
                        o.and_then(λ (b: Locals) => bind_values(Scope([], refs, []).typed_all(rest), xs, b)) = Some(l) → l.refs(y) = l0.refs(y) {
                    None => λ _ never => absurd(never),
                    Some(l1) => λ one more => {
                        let later = bind_keeps_ref(refs, y, rest, xs, l1, l, parts.right, more);
                        let first: (l1.refs(y) = l0.refs(y)) = (match v.kind as λ k => (match k {
                                    WordKind => match x { Word(w) => Some(l0.set_word(p, word_value(w))), Ref(_) => None },
                                    RefKind => match x { Word(_) => None, Ref(loc) => Some(l0.set_ref(p, loc)) },
                                }) = Some(l1) → l1.refs(y) = l0.refs(y) {
                            WordKind => match x as λ z => (match z { Word(w) => Some(l0.set_word(p, word_value(w))), Ref(_) => None }) = Some(l1) →
                                    l1.refs(y) = l0.refs(y) {
                                Word(w) => λ e => cong_fn<Locals, Option<Loc>>(λ m => m.refs(y), sym(Option::some_inj(l0.set_word(p, word_value(w)), l1, e))),
                                Ref(_) => λ never => absurd(never),
                            },
                            RefKind => match x as λ z => (match z { Word(_) => None, Ref(loc) => Some(l0.set_ref(p, loc)) }) = Some(l1) →
                                    l1.refs(y) = l0.refs(y) {
                                Word(_) => λ never => absurd(never),
                                Ref(loc) => λ e => trans(cong_fn<Locals, Option<Loc>>(λ m => m.refs(y), sym(Option::some_inj(l0.set_ref(p, loc), l1, e))),
                                    set_ref_other(l0, p, loc, y, λ same => parts.left(sym(same)))),
                            },
                        })(one);
                        trans(later, first)
                    },
                })(refl, h),
            })(bound)
        },
    }
}

// Words bound to ids holding no reference: the words agree with the old
// valuation's bind of them.
theorem bind_words(refs: List<Nat>, ids: List<Nat>): (words: List<BitVec(64)>) → (l0, l: Locals) → (v0: Valuation()) → Distinct(ids) → AllPlain(refs, ids) →
    bind_values(Scope([], refs, []).typed_all(ids), words.map(λ (w: BitVec(64)) => x86_64_call_contract::Word(w)), l0) = Some(l) → Plain(refs, l0.words, v0) →
    Plain(refs, l.words, Valuation::bind(v0, ids, words)) {
    match ids {
        Nil => λ words l0 l v0 _ _ bound plain => (match words as λ ws => bind_values([], ws.map(λ (w: BitVec(64)) => x86_64_call_contract::Word(w)), l0) = Some(l) →
                Plain(refs, l.words, Valuation::bind(v0, [], ws)) {
            Nil => λ h => j(Option::some_inj(l0, l, h), λ m _ => Plain(refs, m.words, v0), plain),
            Cons(_, _) => λ never => absurd(never),
        })(bound),
        Cons(p, rest) => λ words l0 l v0 distinct kinds bound plain => (match words as λ ws =>
                bind_values(Scope([], refs, []).typed_all(Cons(p, rest)), ws.map(λ (w: BitVec(64)) => x86_64_call_contract::Word(w)), l0) = Some(l) →
                Plain(refs, l.words, Valuation::bind(v0, Cons(p, rest), ws)) {
            Nil => λ never => absurd(never),
            Cons(w, ws) => λ h => {
                let typed: (Scope([], refs, []).typed(p) = word_id(p)) =
                    j(sym(kinds.left), λ b _ => Typed(p, match b { True => RefKind, False => WordKind }) = word_id(p), refl);
                let l1 = l0.set_word(p, word_value(w));
                let rest_bound: (bind_values(Scope([], refs, []).typed_all(rest), ws.map(λ (x: BitVec(64)) => x86_64_call_contract::Word(x)), l1) = Some(l)) =
                    j(typed, λ v _ => l0.bind(v, x86_64_call_contract::Word(w)).and_then(λ (b: Locals) => bind_values(Scope([], refs, []).typed_all(rest),
                        ws.map(λ (x: BitVec(64)) => x86_64_call_contract::Word(x)), b)) = Some(l), h);
                let v1 = Valuation::set(v0, p, word_value(w));
                let plain1: Plain(refs, l1.words, v1) = λ x px wd => match x.eq_dec(p) as λ _ => l1.words(wd, x) = v1(wd, x) {
                    Inl(here) => j(sym(here), λ y _ => l1.words(wd, y) = v1(wd, y),
                        trans(Valuation::set_here(l0.words, p, word_value(w), wd), sym(Valuation::set_here(v0, p, word_value(w), wd)))),
                    Inr(differs) => trans(Valuation::set_other(l0.words, p, word_value(w), wd, x, differs),
                        trans(plain(x, px, wd), sym(Valuation::set_other(v0, p, word_value(w), wd, x, differs)))),
                };
                let inner = bind_words(refs, rest, ws, l1, l, v1, distinct.right, kinds.right, rest_bound, plain1);
                λ x px wd => trans(inner(x, px, wd), bind_set_swap(v0, p, word_value(w), rest, ws, distinct.left, wd, x))
            },
        })(bound),
    }
}

// The entry: parameters bound to arguments that agree with the old words,
// each lent buffer a reference to its block from 0 and its length, then
// words. The words agree with the old bind, and each home's reference is
// its block's.
fn Entered(refs: List<Nat>, homes: List<Lent>, l: Locals, values: Valuation()) → Type {
    Plain(refs, l.words, values) ∧ ((h: Lent) → Mem(h, homes) → l.refs(h.base) = Some(Loc(h.buffer, 0)))
}

theorem entry_binds(refs: List<Nat>, count: Nat): (k: Nat) → (params: List<Nat>) → (args: List<Value>) → (words: List<BitVec(64)>) → (l0, l: Locals) →
    (v0: Valuation()) → ArgsAgree(count, k, args, words) → Distinct(params) → ParamKinds(refs, count, params) →
    bind_values(Scope([], refs, []).typed_all(params), args, l0) = Some(l) → Plain(refs, l0.words, v0) →
    Entered(refs, lent_homes(params, count, k), l, Valuation::bind(v0, params, words)) {
    match count {
        Zero => λ k params args words l0 l v0 agree distinct kinds bound plain =>
            ⟨bind_words(refs, params, words, l0, l, v0, distinct, kinds, j(agree, λ a _ => bind_values(Scope([], refs, []).typed_all(params), a, l0) = Some(l), bound),
                plain), λ h never => false_elim(never)⟩,
        Succ(m) => λ k params => match params {
            Nil => λ args words l0 l v0 agree distinct kinds => false_elim(kinds),
            Cons(b, more) => match more {
                Nil => λ args words l0 l v0 agree distinct kinds => false_elim(kinds),
                Cons(len, rest) => λ args => match args {
                    Nil => λ words l0 l v0 agree => false_elim(agree),
                    Cons(a, after_a) => match after_a {
                        Nil => λ words l0 l v0 agree => false_elim(agree),
                        Cons(lv, as) => λ words => match words {
                            Nil => λ l0 l v0 agree => false_elim(agree),
                            Cons(wb, after_wb) => match after_wb {
                                Nil => λ l0 l v0 agree => false_elim(agree),
                                Cons(lw, ws) => λ l0 l v0 agree distinct kinds bound plain => {
                                    let s0 = Scope([], refs, []);
                                    let base_typed: (s0.typed(b) = ref_id(b)) =
                                        j(sym(kinds.left.left), λ x _ => Typed(b, match x { True => RefKind, False => WordKind }) = ref_id(b), refl);
                                    let length_typed: (s0.typed(len) = word_id(len)) =
                                        j(sym(kinds.left.right), λ x _ => Typed(len, match x { True => RefKind, False => WordKind }) = word_id(len), refl);
                                    let l1 = l0.set_ref(b, Loc(k, 0));
                                    let l2 = l1.set_word(len, word_value(lw));
                                    let tail = λ (x: Value) (y: Value) (m0: Locals) => m0.bind(word_id(len), y).and_then(λ (m1: Locals) => bind_values(s0.typed_all(rest), as, m1));
                                    let bound2: (bind_values(s0.typed_all(rest), as, l2) = Some(l)) =
                                        j(agree.right.left, λ y _ => l1.bind(word_id(len), y).and_then(λ (m1: Locals) => bind_values(s0.typed_all(rest), as, m1)) = Some(l),
                                            j(agree.left, λ x _ => l0.bind(ref_id(b), x).and_then(λ (m0: Locals) => m0.bind(word_id(len), lv).and_then(λ (m1: Locals) =>
                                                    bind_values(s0.typed_all(rest), as, m1))) = Some(l),
                                                j(length_typed, λ v _ => l0.bind(ref_id(b), a).and_then(λ (m0: Locals) => m0.bind(v, lv).and_then(λ (m1: Locals) =>
                                                        bind_values(s0.typed_all(rest), as, m1))) = Some(l),
                                                    j(base_typed, λ v _ => l0.bind(v, a).and_then(λ (m0: Locals) => m0.bind(s0.typed(len), lv).and_then(λ (m1: Locals) =>
                                                            bind_values(s0.typed_all(rest), as, m1))) = Some(l), bound))));
                                    let v2 = Valuation::set(Valuation::set(v0, b, word_value(wb)), len, word_value(lw));
                                    let b_ref = kinds.left.left;
                                    let plain2: Plain(refs, l2.words, v2) = λ x px wd => {
                                        let not_b: (x ≠ b) = λ e => absurd(trans(sym(px), j(sym(e), λ y _ => mem_nat(y, refs) = True, b_ref)));
                                        match x.eq_dec(len) as λ _ => l2.words(wd, x) = v2(wd, x) {
                                            Inl(here) => j(sym(here), λ y _ => l2.words(wd, y) = v2(wd, y),
                                                trans(Valuation::set_here(l1.words, len, word_value(lw), wd),
                                                    sym(Valuation::set_here(Valuation::set(v0, b, word_value(wb)), len, word_value(lw), wd)))),
                                            Inr(not_len) => trans(Valuation::set_other(l1.words, len, word_value(lw), wd, x, not_len),
                                                trans(plain(x, px, wd), trans(sym(Valuation::set_other(v0, b, word_value(wb), wd, x, not_b)),
                                                    sym(Valuation::set_other(Valuation::set(v0, b, word_value(wb)), len, word_value(lw), wd, x, not_len))))),
                                        }
                                    };
                                    let b_out = mem_nat_cons_false(b, len, rest, distinct.left);
                                    let len_out = distinct.right.left;
                                    let inner = entry_binds(refs, m, k + 1, rest, as, ws, l2, l, v2, agree.right.right, distinct.right.right, kinds.right, bound2, plain2);
                                    let base0 = Valuation::bind(v0, rest, ws);
                                    ⟨λ x px wd => {
                                        let not_b: (x ≠ b) = λ e => absurd(trans(sym(px), j(sym(e), λ y _ => mem_nat(y, refs) = True, b_ref)));
                                        trans(inner.left(x, px, wd),
                                            trans(bind_set_swap(Valuation::set(v0, b, word_value(wb)), len, word_value(lw), rest, ws, len_out, wd, x),
                                                match x.eq_dec(len) as λ _ => Valuation::set(Valuation::bind(Valuation::set(v0, b, word_value(wb)), rest, ws), len, word_value(lw))(wd, x) =
                                                        Valuation::set(Valuation::set(base0, len, word_value(lw)), b, word_value(wb))(wd, x) {
                                                    Inl(here) => j(sym(here), λ y _ => Valuation::set(Valuation::bind(Valuation::set(v0, b, word_value(wb)), rest, ws), len, word_value(lw))(wd, y) =
                                                            Valuation::set(Valuation::set(base0, len, word_value(lw)), b, word_value(wb))(wd, y),
                                                        trans(Valuation::set_here(Valuation::bind(Valuation::set(v0, b, word_value(wb)), rest, ws), len, word_value(lw), wd),
                                                            trans(sym(Valuation::set_here(base0, len, word_value(lw), wd)),
                                                                sym(Valuation::set_other(Valuation::set(base0, len, word_value(lw)), b, word_value(wb), wd, len,
                                                                    λ e => b_out.left(e)))))),
                                                    Inr(not_len) => trans(Valuation::set_other(Valuation::bind(Valuation::set(v0, b, word_value(wb)), rest, ws), len, word_value(lw), wd, x, not_len),
                                                        trans(bind_set_swap(v0, b, word_value(wb), rest, ws, b_out.right, wd, x),
                                                            trans(Valuation::set_other(base0, b, word_value(wb), wd, x, not_b),
                                                                trans(sym(Valuation::set_other(base0, len, word_value(lw), wd, x, not_len)),
                                                                    sym(Valuation::set_other(Valuation::set(base0, len, word_value(lw)), b, word_value(wb), wd, x, not_b)))))),
                                                }))
                                    },
                                    λ h m => match m {
                                        Inl(is) => {
                                            let kept = bind_keeps_ref(refs, b, rest, as, l2, l, b_out.right, bound2);
                                            let here: (l2.refs(b) = Some(Loc(k, 0))) = j(sym(b.same_self()), λ x _ => (match x { True => Some(Loc(k, 0)), False => l0.refs(b) }) = Some(Loc(k, 0)), refl);
                                            j(sym(is), λ g _ => l.refs(g.base) = Some(Loc(g.buffer, 0)), trans(kept, here))
                                        },
                                        Inr(later) => inner.right(h, later),
                                    }⟩
                                },
                            },
                        },
                    },
                },
            },
        },
    }
}

// ---------------------------------------------------------------------------
// A function

// What a function asks: no levels, no fixed span, one result, its lent
// count the program's, its parameters distinct and typed as the
// translation types them, its scope's homes sound, its result an old word,
// and its body of the forms the region theorem covers.
fn FunctionFits(f: Function, k: Nat, lents: List<Nat>) → Type {
    let homes = f.buffer_homes();
    let refs = homes_bases(homes);
    let bound = f.fresh_from();
    ((f.levels = 0) ∧ ((f.fixed = None) ∧ ((f.also = []) ∧ (lent_count(lents, k) = f.lent)))) ∧
        ((Distinct(f.parameters) ∧ ParamKinds(refs, f.lent, f.parameters)) ∧
            (ScopeOk(bound, homes, refs) ∧ (((f.result < bound) ∧ (mem_nat(f.result, refs) = False)) ∧
                RegionFits(bound, refs, Scope(homes, refs, []), f.body, bound, f.reads(), k, lents))))
}

// The words an old function answers, as values.
fn Ending::values(self e: Ending) → List<Value> { Cons(x86_64_call_contract::Word(e.word), e.rest.map(λ (w: BitVec(64)) => x86_64_call_contract::Word(w))) }

theorem function_owes(blocks: Blocks, calls: Calls(), old: Writers(), lents: List<Nat>, k: Nat, f: Function, fits: FunctionFits(f, k, lents),
    answers: CallsAgree(calls, old, lents, k), r: Routine, translated: f.translate(k, lents) = Some(r), fuel: Nat, args: List<Value>, words: List<BitVec(64)>,
    heap: Heap, buffers: Buffers(), io: Io, answer: Answer, agree: ArgsAgree(f.lent, 0, args, words), heap_is: (b: Nat) → heap.bytes(b) = buffer_bytes(buffers, b),
    ran: r.call(blocks, calls, fuel, args, heap, io) = Done(answer)):
    (answer.words = f.run(old, words, buffers).values()) ∧ ((b: Nat) → answer.heap.bytes(b) = buffer_bytes(f.run(old, words, buffers).buffers, b)) {
    let homes = f.buffer_homes();
    let refs = homes_bases(homes);
    let bound = f.fresh_from();
    let s = Scope(homes, refs, []);
    let goal = (answer.words = f.run(old, words, buffers).values()) ∧ ((b: Nat) → answer.heap.bytes(b) = buffer_bytes(f.run(old, words, buffers).buffers, b));
    let body_made = λ (o: Option<Made>) => match o as λ _ => Option<Routine> {
        None => None,
        Some(made) => Some(Routine(s.typed_all(f.parameters), made.body, made.scope.typed_all(Cons(f.result, f.also)))),
    };
    let translated2: (body_made(translate_region(s, f.body, bound, f.reads(), k, lents, 0)) = Some(r)) =
        j(fits.left.left, λ n _ => (match n { Succ(_) => None, Zero => body_made(translate_region(s, f.body, bound, f.reads(), k, lents, 0)) }) = Some(r), translated);
    (match translate_region(s, f.body, bound, f.reads(), k, lents, 0) as λ o => translate_region(s, f.body, bound, f.reads(), k, lents, 0) = o →
            body_made(o) = Some(r) → goal {
        None => λ _ never => absurd(never),
        Some(made) => λ e_made some => {
            let is = Option::some_inj(Routine(s.typed_all(f.parameters), made.body, made.scope.typed_all(Cons(f.result, f.also))), r, some);
            let ran2: (Routine(s.typed_all(f.parameters), made.body, made.scope.typed_all(Cons(f.result, f.also))).call(blocks, calls, fuel, args, heap, io) = Done(answer)) =
                j(sym(is), λ x _ => x.call(blocks, calls, fuel, args, heap, io) = Done(answer), ran);
            let results = made.scope.typed_all(Cons(f.result, f.also));
            let after_body = λ (l: Locals) => made.body.run(blocks, calls, fuel, Config(l, heap, io)).then(λ (after: Config) =>
                Ran::of(read_values(results, after.locals), after.io).then(λ (ws: List<Value>) => Done(Answer(ws, after.memory, after.io))));
            let first = Ran::then_done<Locals, Answer>(Ran::of(bind_values(s.typed_all(f.parameters), args, Locals::empty()), io), after_body, answer, ran2);
            let l = first.witness;
            let bound_l: (bind_values(s.typed_all(f.parameters), args, Locals::empty()) = Some(l)) =
                Ran::of_done<Locals>(bind_values(s.typed_all(f.parameters), args, Locals::empty()), io, l, first.proof.left);
            let read_back = λ (after: Config) => Ran::of(read_values(results, after.locals), after.io).then(λ (ws: List<Value>) => Done(Answer(ws, after.memory, after.io)));
            let second = Ran::then_done<Config, Answer>(made.body.run(blocks, calls, fuel, Config(l, heap, io)), read_back, answer, first.proof.right);
            let after = second.witness;
            let third = Ran::then_done<List<Value>, Answer>(Ran::of(read_values(results, after.locals), after.io),
                λ (ws: List<Value>) => Done(Answer(ws, after.memory, after.io)), answer, second.proof.right);
            let ws = third.witness;
            let read: (read_values(results, after.locals) = Some(ws)) = Ran::of_done<List<Value>>(read_values(results, after.locals), after.io, ws, third.proof.left);
            let end: (Answer(ws, after.memory, after.io) = answer) = Ran::done_inj<Answer>(Answer(ws, after.memory, after.io), answer, third.proof.right);
            // The entry.
            let homes_are: (lent_homes(f.parameters, f.lent, 0) = homes) =
                sym(j(sym(fits.left.right.left), λ x _ => (match x { None => lent_homes(f.parameters, f.lent, 0),
                    Some(y) => match f.parameters { Nil => [], Cons(b, _) => [Lent(0, b, y.length)] } }) = lent_homes(f.parameters, f.lent, 0), refl));
            let entered = entry_binds(refs, f.lent, 0, f.parameters, args, words, Locals::empty(), l, Valuation::zero(), agree, fits.right.left.left, fits.right.left.right,
                bound_l, λ x px w => refl);
            let values0 = Valuation::bind(Valuation::zero(), f.parameters, words);
            let agree0: Agree(bound, refs, [], l.words, values0) = λ x below px pend w => entered.left(x, px, w);
            let held0: HomesHeld(homes, Config(l, heap, io), buffers) = ⟨j(homes_are, λ hs _ => (h: Lent) → Mem(h, hs) → l.refs(h.base) = Some(Loc(h.buffer, 0)), entered.right),
                heap_is⟩;
            let owed = region_owes(blocks, calls, old, fuel, bound, homes, refs, k, lents, answers, fits.right.right.left, f.body, s, refl, refl, bound, f.reads(), made, e_made,
                fits.right.right.right.right, Config(l, heap, io), after, second.proof.left, values0, buffers, agree0, held0);
            let state = f.body.run(old, values0, buffers);
            // The result read back.
            let result_word = fits.right.right.right.left;
            let kind: (made.scope.typed(f.result) = word_id(f.result)) =
                j(sym(j(sym(owed.right.right), λ rs _ => mem_nat(f.result, rs) = False, result_word.right)),
                    λ b _ => Typed(f.result, match b { True => RefKind, False => WordKind }) = word_id(f.result), refl);
            let read2: (read_values(Cons(word_id(f.result), made.scope.typed_all(f.also)), after.locals) = Some(ws)) =
                j(kind, λ v _ => read_values(Cons(v, made.scope.typed_all(f.also)), after.locals) = Some(ws), read);
            let read3: (read_values([word_id(f.result)], after.locals) = Some(ws)) =
                j(fits.left.right.right.left, λ a _ => read_values(Cons(word_id(f.result), made.scope.typed_all(a)), after.locals) = Some(ws), read2);
            let ws_is: (ws = [x86_64_call_contract::Word(after.locals.word(f.result))]) = sym(Option::some_inj([x86_64_call_contract::Word(after.locals.word(f.result))], ws, read3));
            let result_same: (after.locals.word(f.result) = state.values(64, f.result)) = owed.left.left(f.result, result_word.left, result_word.right, refl, 64);
            let rest_none: (words_of(state.values, f.also).map(λ (w: BitVec(64)) => x86_64_call_contract::Word(w)) = []) =
                j(sym(fits.left.right.right.left), λ a _ => words_of(state.values, a).map(λ (w: BitVec(64)) => x86_64_call_contract::Word(w)) = [], refl);
            ⟨trans(cong_fn<Answer, List<Value>>(λ a => a.words, sym(end)), trans(ws_is,
                    eq2(λ (x: BitVec(64)) (xs: List<Value>) => Cons(x86_64_call_contract::Word(x), xs), result_same, sym(rest_none)))),
                λ b => trans(cong_fn<Answer, List<BitVec(8)>>(λ a => a.heap.bytes(b), sym(end)), owed.left.right.right(b))⟩
        },
    })(refl, translated2)
}

// ---------------------------------------------------------------------------
// The program

// The translation of a program, split at its last function.
theorem translate_cons(last: Function, earlier: List<Function>, lents: List<Nat>, rs: List<Routine>, t: translate_last_first(Cons(last, earlier), lents) = Some(rs)):
    Exists<List<Routine>>(λ re => (translate_last_first(earlier, lents) = Some(re)) ∧
        Exists<Routine>(λ r => (last.translate(earlier.len(), lents) = Some(r)) ∧ (rs = re ++ [r]))) {
    (match translate_last_first(earlier, lents) as λ o => translate_last_first(earlier, lents) = o →
            (match o as λ _ => Option<List<Routine>> {
                None => None,
                Some(routines) => match last.translate(earlier.len(), lents) { None => None, Some(r) => Some(routines ++ [r]) },
            }) = Some(rs) →
            Exists<List<Routine>>(λ re => (translate_last_first(earlier, lents) = Some(re)) ∧
                Exists<Routine>(λ r => (last.translate(earlier.len(), lents) = Some(r)) ∧ (rs = re ++ [r]))) {
        None => λ _ h => absurd(h),
        Some(re) => λ e h => (match last.translate(earlier.len(), lents) as λ o2 => last.translate(earlier.len(), lents) = o2 →
                (match o2 as λ _ => Option<List<Routine>> { None => None, Some(r) => Some(re ++ [r]) }) = Some(rs) →
                Exists<List<Routine>>(λ re2 => (translate_last_first(earlier, lents) = Some(re2)) ∧
                    Exists<Routine>(λ r => (last.translate(earlier.len(), lents) = Some(r)) ∧ (rs = re2 ++ [r]))) {
            None => λ _ h2 => absurd(h2),
            Some(r) => λ e2 h2 => Exists(re, ⟨e, Exists(r, ⟨e2, sym(Option::some_inj(re ++ [r], rs, h2))⟩)⟩),
        })(refl, h),
    })(refl, t)
}

// One routine for each function.
theorem translate_len(functions: List<Function>, lents: List<Nat>): (rs: List<Routine>) → translate_last_first(functions, lents) = Some(rs) →
    rs.len() = functions.len() {
    match functions {
        Nil => λ rs h => j(Option::some_inj([], rs, h), λ x _ => x.len() = 0, refl),
        Cons(last, earlier) => λ rs h => {
            let parts = translate_cons(last, earlier, lents, rs, h);
            let re = parts.witness;
            let r = parts.proof.right.witness;
            let ih = translate_len(earlier, lents, re, parts.proof.left);
            j(sym(parts.proof.right.proof.right), λ x _ => x.len() = earlier.len() + 1,
                trans(List::len_append(re, [r]), cong_fn<Nat, Nat>(λ n => n + 1, ih)))
        },
    }
}

// Every function of the program fits the theorem, at its number.
fn ProgramFits(functions: List<Function>, lents: List<Nat>) → Type {
    match functions { Nil => True, Cons(last, earlier) => FunctionFits(last, earlier.len(), lents) ∧ ProgramFits(earlier, lents) }
}

// The routines `all` begin with the translation of `functions`: each of
// them, its calls answered by `all` at any fuel, does what the old program
// does.
theorem program_calls_agree(blocks: Blocks, lents: List<Nat>, functions: List<Function>): (all: List<Routine>) → (rs: List<Routine>) →
    translate_last_first(functions, lents) = Some(rs) → ProgramFits(functions, lents) → ((i: Nat) → i < rs.len() → all.nth(i) = rs.nth(i)) →
    (fuel: Nat) → CallsAgree(program_calls(all, blocks, fuel), program_run(functions), lents, functions.len()) {
    match functions {
        Nil => λ all rs t fits prefix fuel f below => false_elim(below),
        Cons(last, earlier) => λ all rs t fits prefix fuel => {
            let parts = translate_cons(last, earlier, lents, rs, t);
            let re = parts.witness;
            let r = parts.proof.right.witness;
            let rs_is: (rs = re ++ [r]) = parts.proof.right.proof.right;
            let re_len: (re.len() = earlier.len()) = translate_len(earlier, lents, re, parts.proof.left);
            let rs_len: (rs.len() = earlier.len() + 1) = translate_len(Cons(last, earlier), lents, rs, t);
            let prefix_e: ((i: Nat) → i < re.len() → (all.nth(i) = re.nth(i))) = λ i below =>
                trans(prefix(i, j(sym(rs_len), λ n _ => (i < n), Nat::lt_trans(i, earlier.len(), earlier.len() + 1, j(re_len, λ n _ => (i < n), below), Nat::lt_succ_self(earlier.len())))),
                    trans(cong_fn<List<Routine>, Option<Routine>>(λ xs => xs.nth(i), rs_is), List::nth_append_below(re, [r], i, below)));
            let ih = program_calls_agree(blocks, lents, earlier, all, re, parts.proof.left, fits.right, prefix_e);
            let last_fits: FunctionFits(last, earlier.len(), lents) = fits.left;
            let levels0: (last.levels = 0) = last_fits.left.left;
            let r_at: (all.nth(earlier.len()) = Some(r)) =
                trans(prefix(earlier.len(), j(sym(rs_len), λ n _ => (earlier.len() < n), Nat::lt_succ_self(earlier.len()))),
                    trans(cong_fn<List<Routine>, Option<Routine>>(λ xs => xs.nth(earlier.len()), rs_is), List::nth_append_at(re, [r], earlier.len(), re_len)));
            λ f below args words heap buffers io answer agree heap_is ran =>
                (match f.eq_dec(earlier.len()) as λ d =>
                    (answer.words = Cons(x86_64_call_contract::Word((match d as λ _ => Ending {
                            Inl(_) => last.run(last.writers_at(program_run(earlier), earlier.len(), last.levels), words, buffers),
                            Inr(_) => program_run(earlier, buffers, f, words) }).word),
                        (match d as λ _ => Ending {
                            Inl(_) => last.run(last.writers_at(program_run(earlier), earlier.len(), last.levels), words, buffers),
                            Inr(_) => program_run(earlier, buffers, f, words) }).rest.map(λ (w: BitVec(64)) => x86_64_call_contract::Word(w)))) ∧
                    ((b: Nat) → answer.heap.bytes(b) = buffer_bytes((match d as λ _ => Ending {
                            Inl(_) => last.run(last.writers_at(program_run(earlier), earlier.len(), last.levels), words, buffers),
                            Inr(_) => program_run(earlier, buffers, f, words) }).buffers, b)) {
                    Inl(at) => {
                        let at_agree: ArgsAgree(lent_count(lents, earlier.len()), 0, args, words) = j(at, λ x _ => ArgsAgree(lent_count(lents, x), 0, args, words), agree);
                        let own_agree: ArgsAgree(last.lent, 0, args, words) = j(last_fits.left.right.right.right, λ c _ => ArgsAgree(c, 0, args, words), at_agree);
                        let ran_at: (program_calls(all, blocks, fuel, earlier.len(), args, heap, io) = Done(answer)) = j(at, λ x _ => program_calls(all, blocks, fuel, x, args, heap, io) = Done(answer), ran);
                        let goal0 = (answer.words = last.run(program_run(earlier), words, buffers).values()) ∧
                            ((b: Nat) → answer.heap.bytes(b) = buffer_bytes(last.run(program_run(earlier), words, buffers).buffers, b));
                        let at0: goal0 = (match fuel as λ n => program_calls(all, blocks, n, earlier.len(), args, heap, io) = Done(answer) → goal0 {
                            Zero => λ never => absurd(never),
                            Succ(m) => λ ran_m => {
                                let ran_r: (r.call(blocks, program_calls(all, blocks, m), m, args, heap, io) = Done(answer)) =
                                    j(r_at, λ o _ => (match o as λ _ => Ran<Answer> { None => Stuck(io), Some(routine) => routine.call(blocks, program_calls(all, blocks, m), m, args, heap, io) }) = Done(answer),
                                        ran_m);
                                function_owes(blocks, program_calls(all, blocks, m), program_run(earlier), lents, earlier.len(), last, last_fits, ih(m), r,
                                    parts.proof.right.proof.left, m, args, words, heap, buffers, io, answer, own_agree, heap_is, ran_r)
                            },
                        })(ran_at);
                        j(sym(levels0), λ lv _ => (answer.words = last.run(last.writers_at(program_run(earlier), earlier.len(), lv), words, buffers).values()) ∧
                            ((b: Nat) → answer.heap.bytes(b) = buffer_bytes(last.run(last.writers_at(program_run(earlier), earlier.len(), lv), words, buffers).buffers, b)), at0)
                    },
                    Inr(ne) => ih(fuel, f, Nat::lt_of_le_of_ne(f, earlier.len(), below, ne), args, words, heap, buffers, io, answer, agree, heap_is, ran),
                })
        },
    }
}

// The theorem over programs: every `Done` of a translated program, at any
// fuel, is the old program's run, its words the old words and its heap the
// buffers the old run left, read back.
theorem translated_runs_as_old(functions: List<Function>, p: Program, translated: translate_program(functions) = Some(p),
    fits: ProgramFits(functions, program_counts(functions)), blocks: Blocks, fuel, f: Nat, below: f < functions.len(), args: List<Value>,
    words: List<BitVec(64)>, heap: Heap, buffers: Buffers(), io: Io, answer: Answer,
    agree: ArgsAgree(lent_count(program_counts(functions), f), 0, args, words), heap_is: (b: Nat) → heap.bytes(b) = buffer_bytes(buffers, b),
    ran: run(p, blocks, fuel, f, args, heap, io) = Done(answer)):
    (answer.words = Cons(x86_64_call_contract::Word(program_run(functions, buffers, f, words).word),
        program_run(functions, buffers, f, words).rest.map(λ (w: BitVec(64)) => x86_64_call_contract::Word(w)))) ∧
    ((b: Nat) → answer.heap.bytes(b) = buffer_bytes(program_run(functions, buffers, f, words).buffers, b)) {
    let lents = program_counts(functions);
    (match translate_last_first(functions, lents) as λ o => translate_last_first(functions, lents) = o →
            (match o as λ _ => Option<Program> { None => None, Some(routines) => Some(Program(routines)) }) = Some(p) →
            (answer.words = Cons(x86_64_call_contract::Word(program_run(functions, buffers, f, words).word),
                program_run(functions, buffers, f, words).rest.map(λ (w: BitVec(64)) => x86_64_call_contract::Word(w)))) ∧
            ((b: Nat) → answer.heap.bytes(b) = buffer_bytes(program_run(functions, buffers, f, words).buffers, b)) {
        None => λ _ never => absurd(never),
        Some(rs) => λ t some => {
            let p_is: (Program(rs) = p) = Option::some_inj(Program(rs), p, some);
            let ran_rs: (program_calls(rs, blocks, fuel, f, args, heap, io) = Done(answer)) =
                j(sym(p_is), λ q _ => run(q, blocks, fuel, f, args, heap, io) = Done(answer), ran);
            program_calls_agree(blocks, lents, functions, rs, rs, t, fits, λ i _ => refl, fuel, f, below, args, words, heap, buffers, io, answer, agree, heap_is, ran_rs)
        },
    })(refl, translated)
}

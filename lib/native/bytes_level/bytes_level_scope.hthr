// One valuation per scope (issues/bytes-level-lowering-routines.md): the
// lowering's theorems are over one FunctionIR valuation for a routine's
// body (`Locals::Agrees` at every node, bytes_level_lower), while the bytes
// level's locals change as a run goes. Such a valuation exists exactly where
// no id is bound twice in a scope, which the lowering checks
// (`Body::fresh`, over every path: both arms of a branch may bind an id,
// but nothing after the branch may bind it again).
//
// - The frame: a node, a region and a call's results change only the ids
//   they bind (`Frames`), and a checked region binds only ids it was not
//   given (`Scoped`: the kinds bound so far are held as validity says, a
//   word with no reference beside it and a reference with one, and the
//   locals hold references only at ids the scope has bound).
// - The witness: the run's final locals, lowered (`Locals::lower`: a
//   reference's address, a word itself). Every id bound on the way holds at
//   the end what it held when bound, so the valuation agrees with the locals
//   at every node (`Locals::Shows`, `agrees_of`).
// - The bridge: a checked region's run, at that valuation, is its facts
//   (`Body::holds_of`), the ones `Body::emit_emits` takes; a call's facts
//   are the callee's answer at the fuel the run gave it (`run_answers`).
import bytes_memory;
import bytes_level;
import bytes_level_lower;
import x86_64_memory_contract;
import x86_64_call_contract;
import function_ir;
import function_ir_eval;
import linux_world;
import linux_calls;
import bitvec;
import bool;
import list;
import logic;
import nat;
import option;

// ---------------------------------------------------------------------------
// Outcomes

theorem Ran::then_done<T, U>(r: Ran<T>, k: T → Ran<U>, x: U): r.then(k) = Done(x) → Exists<T>(λ a => (r = Done(a)) ∧ (k(a) = Done(x))) {
    match r {
        Done(a) => λ h => Exists(a, ⟨refl, h⟩),
        Exited(_, _) => λ h => absurd(h),
        Going(_) => λ h => absurd(h),
        Stuck(_) => λ h => absurd(h),
    }
}

theorem Ran::done_inj<T>(a, b: T, same: Done<T>(a) = Done<T>(b)): a = b {
    cong_fn<Ran<T>, T>(λ r => match r { Done(x) => x, Exited(_, _) => a, Going(_) => a, Stuck(_) => a }, same)
}

theorem Ran::of_done<T>(o: Option<T>, io: Io, x: T): Ran::of(o, io) = Done(x) → o = Some(x) {
    match o {
        None => λ h => absurd(h),
        Some(v) => λ h => cong_fn<T, Option<T>>(λ y => Some(y), Ran::done_inj<T>(v, x, h)),
    }
}

// ---------------------------------------------------------------------------
// Ids bound in a scope

fn listed(ids: List<Nat>, id: Nat) → Bool {
    match ids { Nil => False, Cons(x, rest) => match x.same(id) { True => True, False => listed(rest, id) } }
}

theorem unlisted_absent(ids: List<Nat>, id: Nat): listed(ids, id) = False → Mem(id, ids) → False {
    match ids {
        Nil => λ _ m => m,
        Cons(x, rest) => match s: x.same(id) {
            True => λ never _ => absurd(never),
            False => λ un m => match m {
                Inl(here) => absurd(trans(sym(j(here, λ y _ => y.same(id) = True, id.same_self())), s)),
                Inr(later) => unlisted_absent(rest, id, un, later),
            },
        },
    }
}

// The id a node binds, at its kind.
fn Instr::binds(self instr: Instr) → Option<Typed> {
    match instr {
        Compute(node) => Some(word_id(node_output(node).id)),
        Load(_, _, output, _) => Some(word_id(output)),
        Store(_, _, _, _) => None,
        LoadRef(output, _) => Some(ref_id(output)),
        StoreRef(_, _) => None,
        Offset(output, _, _) => Some(ref_id(output)),
        Copy(_, _, _) => None,
    }
}

// An id bound where the scope has not bound it yet.
fn fresh_id(used: List<Nat>, id: Nat) → Option<List<Nat>> { match listed(used, id) { True => None, False => Some(Cons(id, used)) } }

fn fresh_ids(used: List<Nat>, ids: List<Nat>) → Option<List<Nat>> {
    match ids { Nil => Some(used), Cons(id, rest) => match fresh_id(used, id) { None => None, Some(more) => fresh_ids(more, rest) } }
}

fn fresh_bind(used: List<Nat>, b: Option<Typed>) → Option<List<Nat>> { match b { None => Some(used), Some(v) => fresh_id(used, v.id) } }

fn fresh_instrs(instrs: List<Instr>, used: List<Nat>) → Option<List<Nat>> {
    match instrs {
        Nil => Some(used),
        Cons(instr, rest) => match fresh_bind(used, instr.binds()) { None => None, Some(more) => fresh_instrs(rest, more) },
    }
}

// The lowering's check: no id is bound twice along any path of a scope.
// Both arms of a branch are checked from what was bound before it, and
// what follows it from what either bound. A loop's pass is a scope of its
// own, from its parameters; the ids it binds are counted bound in the scope
// the loop is in too, so that no later id is one a pass bound.
fn Body::fresh(self body: Body, used: List<Nat>) → Option<List<Nat>> {
    match body {
        Leaf(instrs) => fresh_instrs(instrs, used),
        Seq(first, rest) => match first.fresh(used) { None => None, Some(mid) => rest.fresh(mid) },
        Branch(_, yes, no) => match yes.fresh(used) {
            None => None,
            Some(after_yes) => match no.fresh(used) { None => None, Some(after_no) => Some(after_yes ++ after_no) },
        },
        Call(_, _, results) => fresh_ids(used, typed_ids(results)),
        Loop(_, parameters, inner, _, _, outputs) => match fresh_ids([], typed_ids(parameters)) {
            None => None,
            Some(start) => match inner.fresh(start) { None => None, Some(inside) => fresh_ids(used ++ inside, typed_ids(outputs)) },
        },
        // A system call binds its result word.
        Sys(call) => fresh_id(used, call.result()),
        // An exit binds nothing.
        Exit(_) => Some(used),
    }
}

theorem fresh_id_some(used: List<Nat>, id: Nat, out: List<Nat>, e: fresh_id(used, id) = Some(out)):
    (listed(used, id) = False) ∧ (Cons(id, used) = out) {
    (match listed(used, id) as λ b => listed(used, id) = b → (match b { True => None, False => Some(Cons(id, used)) }) = Some(out) →
        (listed(used, id) = False) ∧ (Cons(id, used) = out) {
        True => λ _ never => absurd(never),
        False => λ s some => ⟨s, Option::some_inj(Cons(id, used), out, some)⟩,
    })(refl, e)
}

// ---------------------------------------------------------------------------
// Locals alike at an id

fn Locals::Same(self a: Locals, b: Locals, id: Nat) → Type { ((w: Nat) → a.words(w, id) = b.words(w, id)) ∧ (a.refs(id) = b.refs(id)) }

theorem Locals::same_refl(self a: Locals, id: Nat): a.Same(a, id) { ⟨λ w => refl, refl⟩ }

theorem Locals::same_trans(self a: Locals, b, c: Locals, id: Nat, ab: a.Same(b, id), bc: b.Same(c, id)): a.Same(c, id) {
    ⟨λ w => trans(ab.left(w), bc.left(w)), trans(ab.right, bc.right)⟩
}

theorem Locals::set_word_other(self l: Locals, out: Nat, value: (w: Nat) → BitVec(w), id: Nat, ne: id ≠ out): l.Same(l.set_word(out, value), id) {
    ⟨λ w => sym(Valuation::set_other(l.words, out, value, w, id, ne)), refl⟩
}

theorem Locals::set_ref_other(self l: Locals, out: Nat, loc: Loc, id: Nat, ne: id ≠ out): l.Same(l.set_ref(out, loc), id) {
    ⟨λ w => refl, sym(j(sym(id.same_false_of(out, ne)), λ b _ => (match b { True => Some(loc), False => l.refs(id) }) = l.refs(id), refl))⟩
}

theorem Locals::set_ref_here(self l: Locals, out: Nat, loc: Loc): l.set_ref(out, loc).refs(out) = Some(loc) {
    j(sym(out.same_self()), λ b _ => (match b { True => Some(loc), False => l.refs(out) }) = Some(loc), refl)
}

// What binding an id did to the locals: set its word, or its reference.
fn Binds(id: Nat, kind: ValueKind, before, after: Locals) → Type {
    match kind {
        WordKind => Exists<(w: Nat) → BitVec(w)>(λ value => after = before.set_word(id, value)),
        RefKind => Exists<Loc>(λ loc => after = before.set_ref(id, loc)),
    }
}

theorem binds_other(id: Nat, kind: ValueKind, before, after: Locals, other: Nat, ne: other ≠ id): Binds(id, kind, before, after) →
    before.Same(after, other) {
    match kind {
        WordKind => λ b => j(sym(b.proof), λ l _ => before.Same(l, other), before.set_word_other(id, b.witness, other, ne)),
        RefKind => λ b => j(sym(b.proof), λ l _ => before.Same(l, other), before.set_ref_other(id, b.witness, other, ne)),
    }
}

// ---------------------------------------------------------------------------
// A scope's invariant

// Validity's kind of an id, as the locals hold it: a word with no
// reference at its id, a reference with one.
fn KindHeld(l: Locals, v: Typed) → Type {
    match v.kind { WordKind => l.refs(v.id) = None, RefKind => Exists<Loc>(λ loc => l.refs(v.id) = Some(loc)) }
}

// Every kind bound so far is of an id the scope bound, and held so.
fn Locals::Kinded(self l: Locals, used: List<Nat>, kinds: List<Typed>) → Type {
    match kinds { Nil => True, Cons(v, rest) => (Mem(v.id, used) ∧ KindHeld(l, v)) ∧ l.Kinded(used, rest) }
}

// References only at ids the scope bound.
fn Locals::Fresh(self l: Locals, used: List<Nat>) → Type { (id: Nat) → (loc: Loc) → l.refs(id) = Some(loc) → Mem(id, used) }

fn Scoped(l: Locals, used: List<Nat>, kinds: List<Typed>) → Type { l.Kinded(used, kinds) ∧ l.Fresh(used) }

// From `before` to `after`, binding `used2` past `used`: every id the scope
// had not newly bound is alike, and what was bound stays bound.
fn Frames(before, after: Locals, used, used2: List<Nat>) → Type {
    ((id: Nat) → (Mem(id, used2) → Mem(id, used)) → before.Same(after, id)) ∧ ((id: Nat) → Mem(id, used) → Mem(id, used2))
}

fn Scopes(before, after: Locals, used, used2: List<Nat>, bound: List<Typed>) → Type { Scoped(after, used2, bound) ∧ Frames(before, after, used, used2) }

theorem frames_refl(l: Locals, used: List<Nat>): Frames(l, l, used, used) { ⟨λ id _ => l.same_refl(id), λ id m => m⟩ }

theorem frames_trans(a, b, c: Locals, u1, u2, u3: List<Nat>, ab: Frames(a, b, u1, u2), bc: Frames(b, c, u2, u3)): Frames(a, c, u1, u3) {
    ⟨λ id back => a.same_trans(b, c, id, ab.left(id, λ m2 => back(bc.right(id, m2))), bc.left(id, λ m3 => ab.right(id, back(m3)))),
     λ id m => bc.right(id, ab.right(id, m))⟩
}

theorem kind_held_same(id: Nat, kind: ValueKind, a, b: Locals, same: a.Same(b, id)): KindHeld(a, Typed(id, kind)) → KindHeld(b, Typed(id, kind)) {
    match kind {
        WordKind => λ h => trans(sym(same.right), h),
        RefKind => λ h => Exists(h.witness, trans(sym(same.right), h.proof)),
    }
}

theorem Locals::kinded_same(self a: Locals, b: Locals, used: List<Nat>, same: (id: Nat) → Mem(id, used) → a.Same(b, id), kinds: List<Typed>):
    a.Kinded(used, kinds) → b.Kinded(used, kinds) {
    match kinds {
        Nil => λ _ => trivial,
        Cons(v, rest) => λ k => ⟨⟨k.left.left, kind_held_same(v.id, v.kind, a, b, same(v.id, k.left.left), k.left.right)⟩,
            a.kinded_same(b, used, same, rest, k.right)⟩,
    }
}

theorem Locals::kinded_widen(self l: Locals, used, wider: List<Nat>, grow: (id: Nat) → Mem(id, used) → Mem(id, wider), kinds: List<Typed>):
    l.Kinded(used, kinds) → l.Kinded(wider, kinds) {
    match kinds {
        Nil => λ _ => trivial,
        Cons(v, rest) => λ k => ⟨⟨grow(v.id, k.left.left), k.left.right⟩, l.kinded_widen(used, wider, grow, rest, k.right)⟩,
    }
}

theorem Locals::fresh_widen(self l: Locals, used, wider: List<Nat>, grow: (id: Nat) → Mem(id, used) → Mem(id, wider), fresh: l.Fresh(used)):
    l.Fresh(wider) {
    λ id loc held => grow(id, fresh(id, loc, held))
}

// What both arms bound alike is among what the one that ran bound.
theorem Locals::kinded_meet(self l: Locals, used: List<Nat>, no: List<Typed>, yes: List<Typed>): l.Kinded(used, yes) →
    l.Kinded(used, yes.filter(λ (v: Typed) => has_kind(no, v.id, v.kind))) {
    match yes {
        Nil => λ _ => trivial,
        Cons(v, rest) => λ k => (match has_kind(no, v.id, v.kind) as λ b =>
            l.Kinded(used, match b { True => Cons(v, rest.filter(λ (x: Typed) => has_kind(no, x.id, x.kind))),
                False => rest.filter(λ (x: Typed) => has_kind(no, x.id, x.kind)) }) {
            True => ⟨k.left, l.kinded_meet(used, no, rest, k.right)⟩,
            False => l.kinded_meet(used, no, rest, k.right),
        }),
    }
}

// An id the scope has not bound has no reference, and no kind.
theorem Locals::fresh_none(self l: Locals, used: List<Nat>, fresh: l.Fresh(used), id: Nat, absent: Mem(id, used) → False): l.refs(id) = None {
    (match l.refs(id) as λ o => l.refs(id) = o → o = None {
        None => λ _ => refl,
        Some(loc) => λ e => false_elim(absent(fresh(id, loc, e))),
    })(refl)
}

theorem Locals::kind_absent(self l: Locals, used: List<Nat>, id: Nat, absent: Mem(id, used) → False, kinds: List<Typed>):
    l.Kinded(used, kinds) → kind_of(kinds, id) = None {
    match kinds {
        Nil => λ _ => refl,
        Cons(v, rest) => λ k => match s: v.id.same(id) {
            True => false_elim(absent(j(v.id.same_sound(id, s), λ x _ => Mem(x, used), k.left.left))),
            False => l.kind_absent(used, id, absent, rest, k.right),
        },
    }
}

theorem bind_kind_fresh(kinds: List<Typed>, v: Typed, bound: List<Typed>, none: kind_of(kinds, v.id) = None, bind: bind_kind(kinds, v) = Some(bound)):
    Cons(v, kinds) = bound {
    Option::some_inj(Cons(v, kinds), bound,
        j(none, λ o _ => (match o { None => Some(Cons(v, kinds)), Some(k) => match k.same(v.kind) { True => Some(kinds), False => None } }) = Some(bound),
            bind))
}

// One id bound where the scope had not bound it: the invariant holds of
// the locals after, over the kinds validity binds, and nothing else moved.
theorem scoped_bind(id: Nat, kind: ValueKind, before, after: Locals, used: List<Nat>, kinds, bound: List<Typed>, absent: listed(used, id) = False,
    binds: Binds(id, kind, before, after), bind: bind_kind(kinds, Typed(id, kind)) = Some(bound), scoped: Scoped(before, used, kinds)):
    Scopes(before, after, used, Cons(id, used), bound) {
    let gone: (Mem(id, used) → False) = unlisted_absent(used, id, absent);
    let others = λ (x: Nat) (m: Mem(x, used)) => binds_other(id, kind, before, after, x, λ e => gone(j(e, λ y _ => Mem(y, used), m)), binds);
    let e: (Cons(Typed(id, kind), kinds) = bound) = bind_kind_fresh(kinds, Typed(id, kind), bound,
        before.kind_absent(used, id, gone, kinds, scoped.left), bind);
    let none: (before.refs(id) = None) = before.fresh_none(used, scoped.right, id, gone);
    let held: KindHeld(after, Typed(id, kind)) = (match kind as λ k => Binds(id, k, before, after) → KindHeld(after, Typed(id, k)) {
        WordKind => λ b => j(sym(b.proof), λ l _ => l.refs(id) = None, none),
        RefKind => λ b => Exists(b.witness, j(sym(b.proof), λ l _ => l.refs(id) = Some(b.witness), before.set_ref_here(id, b.witness))),
    })(binds);
    let fresh: after.Fresh(Cons(id, used)) = λ x loc some => match x.eq_dec(id) {
        Inl(here) => Inl(here),
        Inr(ne) => Inr(scoped.right(x, loc, trans((binds_other(id, kind, before, after, x, ne, binds)).right, some))),
    };
    let kinded: after.Kinded(Cons(id, used), kinds) = after.kinded_widen(used, Cons(id, used), λ x m => Inr(m), kinds,
        before.kinded_same(after, used, others, kinds, scoped.left));
    ⟨j(e, λ b _ => Scoped(after, Cons(id, used), b), ⟨⟨⟨Inl(refl), held⟩, kinded⟩, fresh⟩),
     ⟨λ x back => match x.eq_dec(id) {
         Inl(here) => false_elim(gone(j(here, λ y _ => Mem(y, used), back(Inl(here))))),
         Inr(ne) => binds_other(id, kind, before, after, x, ne, binds),
      },
      λ x m => Inr(m)⟩⟩
}

// ---------------------------------------------------------------------------
// A node binds what `Instr::binds` says, and nothing else

fn StepShape(b: Option<Typed>, before, after: Locals) → Type { match b { None => after = before, Some(v) => Binds(v.id, v.kind, before, after) } }

fn CheckShape(b: Option<Typed>, kinds, bound: List<Typed>) → Type { match b { None => bound = kinds, Some(v) => bind_kind(kinds, v) = Some(bound) } }

theorem Instr::step_shape(self instr: Instr, blocks: Blocks, c, after: Config, stepped: instr.step(blocks, c) = Some(after)):
    StepShape(instr.binds(), c.locals, after.locals) {
    match instr {
        Compute(node) => {
            let made = Some(Config(Locals(node.step(c.locals.words), c.locals.refs), c.memory, c.io));
            match def: node.pure() && node.defined(c.locals.words) {
                False => absurd(j(def, λ v _ => (match v { False => None, True => made }) = Some(after), stepped)),
                True => {
                    let e = Option::some_inj(Config(Locals(node.step(c.locals.words), c.locals.refs), c.memory, c.io), after,
                        j(def, λ v _ => (match v { False => None, True => made }) = Some(after), stepped));
                    Exists(node.value(c.locals.words), sym(cong_fn<Config, Locals>(λ y => y.locals, e)))
                },
            }
        },
        Load(bytes, _, output, place) => {
            let first = Option::and_then_some(c.locals.refs(place), λ (loc: Loc) =>
                c.memory.load(loc, bytes).and_then(λ (x: BitVec(64)) => Some(Config(c.locals.set_word(output, word_value(x)), c.memory, c.io))), after,
                stepped);
            let second = Option::and_then_some(c.memory.load(first.witness, bytes), λ (x: BitVec(64)) =>
                Some(Config(c.locals.set_word(output, word_value(x)), c.memory, c.io)), after, first.proof.right);
            Exists(word_value(second.witness), sym(cong_fn<Config, Locals>(λ y => y.locals,
                Option::some_inj(Config(c.locals.set_word(output, word_value(second.witness)), c.memory, c.io), after, second.proof.right))))
        },
        Store(bytes, view, place, value) => {
            let piece = λ (w: BitVec(64)) => Piece::plain(low_bytes(bytes, w));
            let first = Option::and_then_some(c.locals.refs(place), λ (loc: Loc) =>
                c.memory.put(blocks.written, loc, piece(c.locals.view(view, value))).and_then(λ (m: Heap) => Some(Config(c.locals, m, c.io))), after, stepped);
            let second = Option::and_then_some(c.memory.put(blocks.written, first.witness, piece(c.locals.view(view, value))),
                λ (m: Heap) => Some(Config(c.locals, m, c.io)), after, first.proof.right);
            sym(cong_fn<Config, Locals>(λ y => y.locals, Option::some_inj(Config(c.locals, second.witness, c.io), after, second.proof.right)))
        },
        LoadRef(output, place) => {
            let first = Option::and_then_some(c.locals.refs(place), λ (loc: Loc) =>
                c.memory.load_ref(loc).and_then(λ (target: Loc) => Some(Config(c.locals.set_ref(output, target), c.memory, c.io))), after, stepped);
            let second = Option::and_then_some(c.memory.load_ref(first.witness), λ (target: Loc) =>
                Some(Config(c.locals.set_ref(output, target), c.memory, c.io)), after, first.proof.right);
            Exists(second.witness, sym(cong_fn<Config, Locals>(λ y => y.locals,
                Option::some_inj(Config(c.locals.set_ref(output, second.witness), c.memory, c.io), after, second.proof.right))))
        },
        StoreRef(place, value) => {
            let first = Option::and_then_some(c.locals.refs(place), λ (loc: Loc) => c.locals.refs(value).and_then(λ (target: Loc) =>
                c.memory.put(blocks.written, loc, Piece::reference(target)).and_then(λ (m: Heap) => Some(Config(c.locals, m, c.io)))), after, stepped);
            let second = Option::and_then_some(c.locals.refs(value), λ (target: Loc) =>
                c.memory.put(blocks.written, first.witness, Piece::reference(target)).and_then(λ (m: Heap) => Some(Config(c.locals, m, c.io))), after,
                first.proof.right);
            let third = Option::and_then_some(c.memory.put(blocks.written, first.witness, Piece::reference(second.witness)),
                λ (m: Heap) => Some(Config(c.locals, m, c.io)), after, second.proof.right);
            sym(cong_fn<Config, Locals>(λ y => y.locals, Option::some_inj(Config(c.locals, third.witness, c.io), after, third.proof.right)))
        },
        Offset(output, place, amount) => {
            let moved = λ (loc: Loc) => Loc(loc.block, loc.offset + c.locals.word(amount).toNat());
            let first = Option::and_then_some(c.locals.refs(place), λ (loc: Loc) =>
                Some(Config(c.locals.set_ref(output, moved(loc)), c.memory, c.io)), after, stepped);
            Exists(moved(first.witness), sym(cong_fn<Config, Locals>(λ y => y.locals,
                Option::some_inj(Config(c.locals.set_ref(output, moved(first.witness)), c.memory, c.io), after, first.proof.right))))
        },
        Copy(target, source, length) => {
            let n = c.locals.word(length).toNat();
            let first = Option::and_then_some(c.locals.refs(target), λ (to: Loc) => c.locals.refs(source).and_then(λ (from: Loc) =>
                c.memory.copy(blocks.written, to, from, n).and_then(λ (m: Heap) => Some(Config(c.locals, m, c.io)))), after, stepped);
            let second = Option::and_then_some(c.locals.refs(source), λ (from: Loc) =>
                c.memory.copy(blocks.written, first.witness, from, n).and_then(λ (m: Heap) => Some(Config(c.locals, m, c.io))), after, first.proof.right);
            let third = Option::and_then_some(c.memory.copy(blocks.written, first.witness, second.witness, n),
                λ (m: Heap) => Some(Config(c.locals, m, c.io)), after, second.proof.right);
            sym(cong_fn<Config, Locals>(λ y => y.locals, Option::some_inj(Config(c.locals, third.witness, c.io), after, third.proof.right)))
        },
    }
}

theorem when_ok_some(ok: Bool, kinds, bound: List<Typed>): when_ok(ok, kinds) = Some(bound) → bound = kinds {
    match ok { False => λ never => absurd(never), True => λ e => sym(Option::some_inj(kinds, bound, e)) }
}

theorem bind_when(ok: Bool, kinds, bound: List<Typed>, v: Typed): (match ok { False => None, True => bind_kind(kinds, v) }) = Some(bound) →
    bind_kind(kinds, v) = Some(bound) {
    match ok { False => λ never => absurd(never), True => λ e => e }
}

theorem Instr::check_shape(self instr: Instr, kinds, bound: List<Typed>, checked: instr.check(kinds) = Some(bound)): CheckShape(instr.binds(), kinds, bound) {
    match instr {
        Compute(node) => bind_when(node.pure() && words_bound(kinds, function_ir_eval::Node::reads(node)), kinds, bound, word_id(node_output(node).id),
            checked),
        Load(bytes, view, output, place) => bind_when(access_ok(bytes, view) && has_kind(kinds, place, RefKind), kinds, bound, word_id(output), checked),
        Store(bytes, view, place, value) => when_ok_some(access_ok(bytes, view) && (has_kind(kinds, place, RefKind) && has_kind(kinds, value, WordKind)), kinds, bound,
            checked),
        LoadRef(output, place) => bind_when(has_kind(kinds, place, RefKind), kinds, bound, ref_id(output), checked),
        StoreRef(place, value) => when_ok_some(has_kind(kinds, place, RefKind) && has_kind(kinds, value, RefKind), kinds, bound, checked),
        Offset(output, place, amount) => bind_when(has_kind(kinds, place, RefKind) && has_kind(kinds, amount, WordKind), kinds, bound, ref_id(output),
            checked),
        Copy(target, source, length) =>
            when_ok_some(has_kind(kinds, target, RefKind) && (has_kind(kinds, source, RefKind) && has_kind(kinds, length, WordKind)), kinds, bound, checked),
    }
}

// A node's binding keeps the scope's invariant and frames the rest.
theorem bind_scopes(b: Option<Typed>, before, after: Locals, used, used2: List<Nat>, kinds, bound: List<Typed>, scoped: Scoped(before, used, kinds)):
    fresh_bind(used, b) = Some(used2) → StepShape(b, before, after) → CheckShape(b, kinds, bound) → Scopes(before, after, used, used2, bound) {
    match b {
        None => λ fresh shape checked => {
            let u: (used = used2) = Option::some_inj(used, used2, fresh);
            j(u, λ x _ => Scopes(before, after, used, x, bound),
                j(sym(shape), λ l _ => Scopes(before, l, used, used, bound),
                    ⟨j(sym(checked), λ k _ => Scoped(before, used, k), scoped), frames_refl(before, used)⟩))
        },
        Some(v) => λ fresh shape checked => {
            let parts = fresh_id_some(used, v.id, used2, fresh);
            j(parts.right, λ x _ => Scopes(before, after, used, x, bound),
                scoped_bind(v.id, v.kind, before, after, used, kinds, bound, parts.left, shape, checked, scoped))
        },
    }
}

// ---------------------------------------------------------------------------
// A leaf

theorem leaf_scopes(blocks: Blocks, instrs: List<Instr>): (kinds, bound: List<Typed>) → (used, used2: List<Nat>) → (c, after: Config) →
    check_instrs(instrs, kinds) = Some(bound) → fresh_instrs(instrs, used) = Some(used2) → run_instrs(blocks, instrs, c) = Some(after) →
    Scoped(c.locals, used, kinds) → Scopes(c.locals, after.locals, used, used2, bound) {
    match instrs {
        Nil => λ kinds bound used used2 c after checked fresh ran scoped => {
            let e: (c = after) = Option::some_inj(c, after, ran);
            let k: (kinds = bound) = Option::some_inj(kinds, bound, checked);
            let u: (used = used2) = Option::some_inj(used, used2, fresh);
            j(e, λ x _ => Scopes(c.locals, x.locals, used, used2, bound), j(k, λ x _ => Scopes(c.locals, c.locals, used, used2, x),
                j(u, λ x _ => Scopes(c.locals, c.locals, used, x, kinds), ⟨scoped, frames_refl(c.locals, used)⟩)))
        },
        Cons(instr, rest) => λ kinds bound used used2 c after checked fresh ran scoped => {
            let checked_first = Option::and_then_some(instr.check(kinds), λ (k: List<Typed>) => check_instrs(rest, k), bound, checked);
            let fresh_first = Option::and_then_some(fresh_bind(used, instr.binds()), λ (u: List<Nat>) => fresh_instrs(rest, u), used2, fresh);
            let ran_first = Option::and_then_some(instr.step(blocks, c), λ (m: Config) => run_instrs(blocks, rest, m), after, ran);
            let mid = ran_first.witness;
            let one = bind_scopes(instr.binds(), c.locals, mid.locals, used, fresh_first.witness, kinds, checked_first.witness, scoped,
                fresh_first.proof.left, instr.step_shape(blocks, c, mid, ran_first.proof.left), instr.check_shape(kinds, checked_first.witness,
                    checked_first.proof.left));
            let more = leaf_scopes(blocks, rest, checked_first.witness, bound, fresh_first.witness, used2, mid, after, checked_first.proof.right,
                fresh_first.proof.right, ran_first.proof.right, one.left);
            ⟨more.left, frames_trans(c.locals, mid.locals, after.locals, used, fresh_first.witness, used2, one.right, more.right)⟩
        },
    }
}

// ---------------------------------------------------------------------------
// The witness

// What the valuation says of an id, as the locals hold it: a reference's
// address, or the word at every width.
fn ShowsAt(o: Option<Loc>, l: Locals, spans: Spans, values: Valuation(), id: Nat) → Type {
    match o { Some(loc) => values(64, id) = loc.address(spans), None => (w: Nat) → values(w, id) = l.words(w, id) }
}

fn Locals::Shows(self l: Locals, spans: Spans, values: Valuation(), id: Nat) → Type { ShowsAt(l.refs(id), l, spans, values, id) }

// The locals lowered: what the routine's valuation is.
fn Locals::lower(self l: Locals, spans: Spans) → Valuation() {
    λ w id => match l.refs(id) { Some(loc) => word_value(loc.address(spans), w), None => l.words(w, id) }
}

theorem shows_at_lower(o: Option<Loc>, l: Locals, spans: Spans, id: Nat, held: l.refs(id) = o):
    ShowsAt(o, l, spans, l.lower(spans), id) {
    (match o as λ x => l.refs(id) = x → ShowsAt(x, l, spans, l.lower(spans), id) {
        Some(loc) => λ e => j(sym(e), λ r _ => (match r { Some(a) => word_value(a.address(spans), 64), None => l.words(64, id) }) = loc.address(spans), refl),
        None => λ e w => j(sym(e), λ r _ => (match r { Some(a) => word_value(a.address(spans), w), None => l.words(w, id) }) = l.words(w, id), refl),
    })(held)
}

// The lowered locals show every id.
theorem Locals::lower_shows(self l: Locals, spans: Spans, id: Nat): l.Shows(spans, l.lower(spans), id) { shows_at_lower(l.refs(id), l, spans, id, refl) }

theorem shows_words(o: Option<Loc>, a, b: Locals, spans: Spans, values: Valuation(), id: Nat, words: (w: Nat) → a.words(w, id) = b.words(w, id)):
    ShowsAt(o, b, spans, values, id) → ShowsAt(o, a, spans, values, id) {
    match o { Some(_) => λ h => h, None => λ h w => trans(h(w), sym(words(w))) }
}

// What a later state shows of an id alike in an earlier one, the earlier
// shows.
theorem Locals::shows_same(self a: Locals, b: Locals, spans: Spans, values: Valuation(), id: Nat, same: a.Same(b, id), shown: b.Shows(spans, values, id)):
    a.Shows(spans, values, id) {
    j(sym(same.right), λ o _ => ShowsAt(o, a, spans, values, id), shows_words(b.refs(id), a, b, spans, values, id, same.left, shown))
}

theorem lowers_of(id: Nat, kind: ValueKind, l: Locals, spans: Spans, values: Valuation(), shown: l.Shows(spans, values, id)):
    KindHeld(l, Typed(id, kind)) → Typed(id, kind).Lowers(spans, values, l) {
    match kind {
        WordKind => λ held => j(held, λ o _ => ShowsAt(o, l, spans, values, id), shown),
        RefKind => λ held => Exists(held.witness, ⟨held.proof, j(held.proof, λ o _ => ShowsAt(o, l, spans, values, id), shown)⟩),
    }
}

// Where the valuation shows every id the scope bound, it agrees with the
// locals at the kinds bound.
theorem Locals::agrees_of(self l: Locals, spans: Spans, values: Valuation(), used: List<Nat>,
    shows: (id: Nat) → Mem(id, used) → l.Shows(spans, values, id), kinds: List<Typed>): l.Kinded(used, kinds) → l.Agrees(spans, values, kinds) {
    match kinds {
        Nil => λ _ => trivial,
        Cons(v, rest) => λ k => ⟨lowers_of(v.id, v.kind, l, spans, values, shows(v.id, k.left.left), k.left.right),
            l.agrees_of(spans, values, used, shows, rest, k.right)⟩,
    }
}

// What a state shows over the ids it bound, an earlier state of its scope
// shows over the ids that one had bound.
theorem shows_back(a, b: Locals, spans: Spans, values: Valuation(), used, used2: List<Nat>, frames: Frames(a, b, used, used2),
    shows: (id: Nat) → Mem(id, used2) → b.Shows(spans, values, id)): (id: Nat) → Mem(id, used) → a.Shows(spans, values, id) {
    λ id m => a.shows_same(b, spans, values, id, frames.left(id, λ _ => m), shows(id, frames.right(id, m)))
}

// A leaf's run agrees with the valuation at every node.
theorem leaf_agrees(blocks: Blocks, spans: Spans, values: Valuation(), instrs: List<Instr>): (kinds, bound: List<Typed>) → (used, used2: List<Nat>) →
    (c, after: Config) → check_instrs(instrs, kinds) = Some(bound) → fresh_instrs(instrs, used) = Some(used2) →
    run_instrs(blocks, instrs, c) = Some(after) → Scoped(c.locals, used, kinds) → ((id: Nat) → Mem(id, used2) → after.locals.Shows(spans, values, id)) →
    RunAgrees(spans, values, blocks, instrs, kinds, c) {
    match instrs {
        Nil => λ kinds bound used used2 c after checked fresh ran scoped shows => {
            let e: (c = after) = Option::some_inj(c, after, ran);
            let u: (used = used2) = Option::some_inj(used, used2, fresh);
            c.locals.agrees_of(spans, values, used, λ id m => j(sym(e), λ x _ => x.locals.Shows(spans, values, id),
                shows(id, j(u, λ x _ => Mem(id, x), m))), kinds, scoped.left)
        },
        Cons(instr, rest) => λ kinds bound used used2 c after checked fresh ran scoped shows => {
            let whole = leaf_scopes(blocks, Cons(instr, rest), kinds, bound, used, used2, c, after, checked, fresh, ran, scoped);
            let checked_first = Option::and_then_some(instr.check(kinds), λ (k: List<Typed>) => check_instrs(rest, k), bound, checked);
            let fresh_first = Option::and_then_some(fresh_bind(used, instr.binds()), λ (u: List<Nat>) => fresh_instrs(rest, u), used2, fresh);
            let ran_first = Option::and_then_some(instr.step(blocks, c), λ (m: Config) => run_instrs(blocks, rest, m), after, ran);
            ⟨c.locals.agrees_of(spans, values, used, shows_back(c.locals, after.locals, spans, values, used, used2, whole.right, shows), kinds, scoped.left),
             λ k checked_k mid stepped => {
                let same_mid: (ran_first.witness = mid) = Option::some_inj(ran_first.witness, mid, trans(sym(ran_first.proof.left), stepped));
                let same_k: (checked_first.witness = k) = Option::some_inj(checked_first.witness, k, trans(sym(checked_first.proof.left), checked_k));
                let one = bind_scopes(instr.binds(), c.locals, mid.locals, used, fresh_first.witness, kinds, k, scoped, fresh_first.proof.left,
                    instr.step_shape(blocks, c, mid, stepped), instr.check_shape(kinds, k, checked_k));
                leaf_agrees(blocks, spans, values, rest, k, bound, fresh_first.witness, used2, mid, after,
                    j(same_k, λ x _ => check_instrs(rest, x) = Some(bound), checked_first.proof.right), fresh_first.proof.right,
                    j(same_mid, λ x _ => run_instrs(blocks, rest, x) = Some(after), ran_first.proof.right), one.left, shows)
             }⟩
        },
    }
}

// ---------------------------------------------------------------------------
// A call's results

theorem Locals::bind_binds(self l: Locals, id: Nat, kind: ValueKind, x: Value, after: Locals):
    l.bind(Typed(id, kind), x) = Some(after) → Binds(id, kind, l, after) ∧ (after.read(Typed(id, kind)) = Some(x)) {
    match kind {
        WordKind => match x {
            Word(w) => λ e => {
                let s: (l.set_word(id, word_value(w)) = after) = Option::some_inj(l.set_word(id, word_value(w)), after, e);
                ⟨Exists(word_value(w), sym(s)), j(s, λ a _ => a.read(Typed(id, WordKind)) = Some(Word(w)),
                    cong_fn<BitVec(64), Option<Value>>(λ y => Some(Word(y)), Valuation::set_here(l.words, id, word_value(w), 64)))⟩
            },
            Ref(_) => λ never => absurd(never),
        },
        RefKind => match x {
            Word(_) => λ never => absurd(never),
            Ref(loc) => λ e => {
                let s: (l.set_ref(id, loc) = after) = Option::some_inj(l.set_ref(id, loc), after, e);
                ⟨Exists(loc, sym(s)), j(s, λ a _ => a.read(Typed(id, RefKind)) = Some(Ref(loc)),
                    cong_fn<Option<Loc>, Option<Value>>(λ o => o.map(λ (t: Loc) => Ref(t)), l.set_ref_here(id, loc)))⟩
            },
        },
    }
}

theorem Locals::read_same(self a: Locals, b: Locals, id: Nat, kind: ValueKind, same: a.Same(b, id)): a.read(Typed(id, kind)) = b.read(Typed(id, kind)) {
    match kind {
        WordKind => cong_fn<BitVec(64), Option<Value>>(λ y => Some(Word(y)), same.left(64)),
        RefKind => cong_fn<Option<Loc>, Option<Value>>(λ o => o.map(λ (t: Loc) => Ref(t)), same.right),
    }
}

// A call's results bound where the scope had not bound them: the invariant
// kept, nothing else moved, and each result reads back as its value.
theorem bind_values_scopes(results: List<Typed>): (ws: List<Value>) → (l, after: Locals) → (used, used2: List<Nat>) → (kinds, bound: List<Typed>) →
    bind_values(results, ws, l) = Some(after) → fresh_ids(used, typed_ids(results)) = Some(used2) → bind_kinds(kinds, results) = Some(bound) →
    Scoped(l, used, kinds) → Scopes(l, after, used, used2, bound) ∧ (read_values(results, after) = Some(ws)) {
    match results {
        Nil => λ ws l after used used2 kinds bound => match ws {
            Nil => λ e fresh checked scoped => {
                let s: (l = after) = Option::some_inj(l, after, e);
                let u: (used = used2) = Option::some_inj(used, used2, fresh);
                let k: (kinds = bound) = Option::some_inj(kinds, bound, checked);
                ⟨j(s, λ x _ => Scopes(l, x, used, used2, bound), j(u, λ x _ => Scopes(l, l, used, x, bound),
                    j(k, λ x _ => Scopes(l, l, used, used, x), ⟨scoped, frames_refl(l, used)⟩))), refl⟩
            },
            Cons(_, _) => λ never _ _ _ => absurd(never),
        },
        Cons(v, rest) => λ ws l after used used2 kinds bound => match ws {
            Nil => λ never _ _ _ => absurd(never),
            Cons(x, xs) => λ e fresh checked scoped => {
                let bind_first = Option::and_then_some(l.bind(v, x), λ (b: Locals) => bind_values(rest, xs, b), after, e);
                let fresh_first = Option::and_then_some(fresh_id(used, v.id), λ (u: List<Nat>) => fresh_ids(u, typed_ids(rest)), used2, fresh);
                let checked_first = Option::and_then_some(bind_kind(kinds, v), λ (k: List<Typed>) => bind_kinds(k, rest), bound, checked);
                let lb = bind_first.witness;
                let first = l.bind_binds(v.id, v.kind, x, lb, bind_first.proof.left);
                let parts = fresh_id_some(used, v.id, fresh_first.witness, fresh_first.proof.left);
                let one = j(parts.right, λ u _ => Scopes(l, lb, used, u, checked_first.witness),
                    scoped_bind(v.id, v.kind, l, lb, used, kinds, checked_first.witness, parts.left, first.left, checked_first.proof.left, scoped));
                let more = bind_values_scopes(rest, xs, lb, after, fresh_first.witness, used2, checked_first.witness, bound, bind_first.proof.right,
                    fresh_first.proof.right, checked_first.proof.right, one.left);
                let here: Mem(v.id, fresh_first.witness) = j(parts.right, λ u _ => Mem(v.id, u), Inl(refl));
                let kept: (after.read(v) = Some(x)) = trans(sym(lb.read_same(after, v.id, v.kind, more.left.right.left(v.id, λ _ => here))), first.right);
                ⟨⟨more.left.left, frames_trans(l, lb, after, used, fresh_first.witness, used2, one.right, more.left.right)⟩,
                 j(sym(kept), λ o _ => o.and_then(λ (y: Value) => read_values(rest, after).and_then(λ (ys: List<Value>) => Some(Cons(y, ys)))) =
                        Some(Cons(x, xs)),
                    j(sym(more.right), λ o _ => o.and_then(λ (ys: List<Value>) => Some(Cons(x, ys))) = Some(Cons(x, xs)), refl))⟩
            },
        },
    }
}

// ---------------------------------------------------------------------------
// A region

theorem true_of_some<T>(ok: Bool, x: Option<T>, y: T): (match ok { False => None, True => x }) = Some(y) → ok = True {
    match ok { False => λ never => absurd(never), True => λ _ => refl }
}

theorem true_some<T>(ok: Bool, x: Option<T>, y: T): (match ok { False => None, True => x }) = Some(y) → x = Some(y) {
    match ok { False => λ never => absurd(never), True => λ e => e }
}

theorem Locals::kinded_has(self l: Locals, used: List<Nat>, id: Nat, kind: ValueKind, kinds: List<Typed>):
    has_kind(kinds, id, kind) = True → l.Kinded(used, kinds) → Mem(id, used) ∧ KindHeld(l, Typed(id, kind)) {
    match kinds {
        Nil => λ never _ => absurd(never),
        Cons(v, rest) => λ has k => match s: v.id.same(id) {
            True => {
                let same_id: (v.id = id) = v.id.same_sound(id, s);
                let same_kind: (v.kind = kind) = v.kind.same_sound(kind, has);
                j(same_id, λ y _ => Mem(y, used) ∧ KindHeld(l, Typed(y, kind)),
                    j(same_kind, λ q _ => Mem(v.id, used) ∧ KindHeld(l, Typed(v.id, q)), k.left))
            },
            False => l.kinded_has(used, id, kind, rest, has, k.right),
        },
    }
}

// What both arms bound alike is among what the other arm bound.
theorem Locals::kinded_meet_other(self l: Locals, used: List<Nat>, no: List<Typed>, k: l.Kinded(used, no), yes: List<Typed>):
    l.Kinded(used, yes.filter(λ (v: Typed) => has_kind(no, v.id, v.kind))) {
    match yes {
        Nil => trivial,
        Cons(v, rest) => (match t: has_kind(no, v.id, v.kind) as λ b =>
            l.Kinded(used, match b { True => Cons(v, rest.filter(λ (x: Typed) => has_kind(no, x.id, x.kind))),
                False => rest.filter(λ (x: Typed) => has_kind(no, x.id, x.kind)) }) {
            True => ⟨l.kinded_has(used, v.id, v.kind, no, t, k), l.kinded_meet_other(used, no, k, rest)⟩,
            False => l.kinded_meet_other(used, no, k, rest),
        }),
    }
}

theorem frames_left(a, b: Locals, used, uy, un: List<Nat>, f: Frames(a, b, used, uy)): Frames(a, b, used, uy ++ un) {
    ⟨λ id back => f.left(id, λ m => back(uy.mem_append_l(un, id, m))), λ id m => uy.mem_append_l(un, id, f.right(id, m))⟩
}

theorem frames_right(a, b: Locals, used, uy, un: List<Nat>, f: Frames(a, b, used, un)): Frames(a, b, used, uy ++ un) {
    ⟨λ id back => f.left(id, λ m => back(uy.mem_append_r(un, id, m))), λ id m => uy.mem_append_r(un, id, f.right(id, m))⟩
}

// The arm that ran, its scope widened to both arms' and its kinds met.
theorem branch_scopes_yes(a, b: Locals, used, uy, un: List<Nat>, ay, an: List<Typed>, s: Scopes(a, b, used, uy, ay)):
    Scopes(a, b, used, uy ++ un, meet_kinds(ay, an)) {
    let grow = λ (id: Nat) (m: Mem(id, uy)) => uy.mem_append_l(un, id, m);
    ⟨⟨b.kinded_meet(uy ++ un, an, ay, b.kinded_widen(uy, uy ++ un, grow, ay, s.left.left)), b.fresh_widen(uy, uy ++ un, grow, s.left.right)⟩,
     frames_left(a, b, used, uy, un, s.right)⟩
}

theorem branch_scopes_no(a, b: Locals, used, uy, un: List<Nat>, ay, an: List<Typed>, s: Scopes(a, b, used, un, an)):
    Scopes(a, b, used, uy ++ un, meet_kinds(ay, an)) {
    let grow = λ (id: Nat) (m: Mem(id, un)) => uy.mem_append_r(un, id, m);
    ⟨⟨b.kinded_widen(un, uy ++ un, grow, meet_kinds(ay, an), b.kinded_meet_other(un, an, s.left.left, ay)), b.fresh_widen(un, uy ++ un, grow, s.left.right)⟩,
     frames_right(a, b, used, uy, un, s.right)⟩
}

// A call's run, taken apart.
record CallRan(calls: Calls(), callee: Nat, arguments, results: List<Typed>, c, after: Config) {
    args: List<Value>,
    answer: Answer,
    read: read_values(arguments, c.locals) = Some(args),
    answered: calls(callee, args, c.memory, c.io) = Done(answer),
    locals: Locals,
    bound: bind_values(results, answer.words, c.locals) = Some(locals),
    lands: after = Config(locals, answer.heap, answer.io),
}

theorem call_ran(blocks: Blocks, calls: Calls(), fuel: Nat, callee: Nat, arguments, results: List<Typed>, c, after: Config,
    ran: Body::Call(callee, arguments, results).run(blocks, calls, fuel, c) = Done(after)): CallRan(calls, callee, arguments, results, c, after) {
    let one = Ran::then_done<List<Value>, Config>(Ran::of(read_values(arguments, c.locals), c.io), λ (args: List<Value>) =>
        calls(callee, args, c.memory, c.io).then(λ (answer: Answer) =>
            Ran::of(bind_values(results, answer.words, c.locals), answer.io).then(λ (l: Locals) => Done(Config(l, answer.heap, answer.io)))), after, ran);
    let args = one.witness;
    let two = Ran::then_done<Answer, Config>(calls(callee, args, c.memory, c.io), λ (answer: Answer) =>
        Ran::of(bind_values(results, answer.words, c.locals), answer.io).then(λ (l: Locals) => Done(Config(l, answer.heap, answer.io))), after,
        one.proof.right);
    let a = two.witness;
    let three = Ran::then_done<Locals, Config>(Ran::of(bind_values(results, a.words, c.locals), a.io), λ (l: Locals) => Done(Config(l, a.heap, a.io)), after,
        two.proof.right);
    CallRan(args := args, answer := a, read := Ran::of_done<List<Value>>(read_values(arguments, c.locals), c.io, args, one.proof.left),
        answered := two.proof.left, locals := three.witness,
        bound := Ran::of_done<Locals>(bind_values(results, a.words, c.locals), a.io, three.witness, three.proof.left),
        lands := sym(Ran::done_inj<Config>(Config(three.witness, a.heap, a.io), after, three.proof.right)))
}

// ---------------------------------------------------------------------------
// A plain loop: a pass is its own scope

// A loop's run, taken apart.
record LoopRan(blocks: Blocks, calls: Calls(), fuel: Nat, inputs, parameters: List<Typed>, inner: Body, exit: Nat, next, outputs: List<Typed>,
    c, after: Config) {
    state: List<Value>,
    read: read_values(inputs, c.locals) = Some(state),
    end: Ended,
    looped: loop_run(λ (n: Nat) (pass: Config) => inner.run(blocks, calls, n, pass), parameters, exit, next, fuel, state, c.memory, c.io) = Done(end),
    locals: Locals,
    bound: bind_values(outputs, end.state, c.locals) = Some(locals),
    lands: after = Config(locals, end.memory, end.io),
}

theorem loop_ran(blocks: Blocks, calls: Calls(), fuel: Nat, inputs, parameters: List<Typed>, inner: Body, exit: Nat, next, outputs: List<Typed>,
    c, after: Config, ran: Body::Loop(inputs, parameters, inner, exit, next, outputs).run(blocks, calls, fuel, c) = Done(after)):
    LoopRan(blocks, calls, fuel, inputs, parameters, inner, exit, next, outputs, c, after) {
    let step = λ (n: Nat) (pass: Config) => inner.run(blocks, calls, n, pass);
    let one = Ran::then_done<List<Value>, Config>(Ran::of(read_values(inputs, c.locals), c.io), λ (state: List<Value>) =>
        loop_run(step, parameters, exit, next, fuel, state, c.memory, c.io).then(λ (end: Ended) =>
            Ran::of(bind_values(outputs, end.state, c.locals), end.io).then(λ (l: Locals) => Done(Config(l, end.memory, end.io)))), after, ran);
    let state = one.witness;
    let two = Ran::then_done<Ended, Config>(loop_run(step, parameters, exit, next, fuel, state, c.memory, c.io), λ (end: Ended) =>
        Ran::of(bind_values(outputs, end.state, c.locals), end.io).then(λ (l: Locals) => Done(Config(l, end.memory, end.io))), after, one.proof.right);
    let end = two.witness;
    let three = Ran::then_done<Locals, Config>(Ran::of(bind_values(outputs, end.state, c.locals), end.io), λ (l: Locals) =>
        Done(Config(l, end.memory, end.io)), after, two.proof.right);
    LoopRan(state := state, read := Ran::of_done<List<Value>>(read_values(inputs, c.locals), c.io, state, one.proof.left), end := end,
        looped := two.proof.left, locals := three.witness,
        bound := Ran::of_done<Locals>(bind_values(outputs, end.state, c.locals), end.io, three.witness, three.proof.left),
        lands := sym(Ran::done_inj<Config>(Config(three.witness, end.memory, end.io), after, three.proof.right)))
}

// A loop's checks, taken apart.
record LoopChecked(sigs: Nat → Option<Signature>, kinds, bound: List<Typed>, inputs, parameters: List<Typed>, inner: Body, exit: Nat,
    next, outputs: List<Typed>) {
    inputs_had: has_kinds(kinds, inputs) = True,
    start: List<Typed>,
    params: bind_kinds([], parameters) = Some(start),
    end: List<Typed>,
    body: inner.check(sigs, start) = Some(end),
    nexts: has_kinds(end, next) = True,
    exits: has_kind(end, exit, WordKind) = True,
    outs: bind_kinds(kinds, outputs) = Some(bound),
}

theorem loop_checked(sigs: Nat → Option<Signature>, kinds, bound: List<Typed>, inputs, parameters: List<Typed>, inner: Body, exit: Nat,
    next, outputs: List<Typed>, checked: Body::Loop(inputs, parameters, inner, exit, next, outputs).check(sigs, kinds) = Some(bound)):
    LoopChecked(sigs, kinds, bound, inputs, parameters, inner, exit, next, outputs) {
    let ok = has_kinds(kinds, inputs) && (same_kinds(kinds_of(inputs), kinds_of(parameters)) &&
        (same_kinds(kinds_of(next), kinds_of(parameters)) && same_kinds(kinds_of(outputs), kinds_of(parameters))));
    let rest: Option<List<Typed>> = match bind_kinds([], parameters) {
        None => None,
        Some(start) => match inner.check(sigs, start) {
            None => None,
            Some(after) => match has_kinds(after, next) && has_kind(after, exit, WordKind) { False => None, True => bind_kinds(kinds, outputs) },
        },
    };
    let had = Bool::and_true_parts(has_kinds(kinds, inputs), same_kinds(kinds_of(inputs), kinds_of(parameters)) &&
        (same_kinds(kinds_of(next), kinds_of(parameters)) && same_kinds(kinds_of(outputs), kinds_of(parameters))),
        true_of_some<List<Typed>>(ok, rest, bound, checked)).left;
    let first = Option::and_then_some(bind_kinds([], parameters), λ (start: List<Typed>) => match inner.check(sigs, start) {
            None => None,
            Some(after) => match has_kinds(after, next) && has_kind(after, exit, WordKind) { False => None, True => bind_kinds(kinds, outputs) },
        }, bound, true_some<List<Typed>>(ok, rest, bound, checked));
    let second = Option::and_then_some(inner.check(sigs, first.witness), λ (after: List<Typed>) =>
        match has_kinds(after, next) && has_kind(after, exit, WordKind) { False => None, True => bind_kinds(kinds, outputs) }, bound, first.proof.right);
    let last = has_kinds(second.witness, next) && has_kind(second.witness, exit, WordKind);
    let parts = Bool::and_true_parts(has_kinds(second.witness, next), has_kind(second.witness, exit, WordKind),
        true_of_some<List<Typed>>(last, bind_kinds(kinds, outputs), bound, second.proof.right));
    LoopChecked(inputs_had := had, start := first.witness, params := first.proof.left, end := second.witness, body := second.proof.left,
        nexts := parts.left, exits := parts.right, outs := true_some<List<Typed>>(last, bind_kinds(kinds, outputs), bound, second.proof.right))
}

// A loop's scopes, taken apart.
record LoopFresh(used, used2: List<Nat>, parameters: List<Typed>, inner: Body, outputs: List<Typed>) {
    start: List<Nat>,
    params: fresh_ids([], typed_ids(parameters)) = Some(start),
    inside: List<Nat>,
    body: inner.fresh(start) = Some(inside),
    outs: fresh_ids(used ++ inside, typed_ids(outputs)) = Some(used2),
}

theorem loop_fresh(used, used2: List<Nat>, inputs, parameters: List<Typed>, inner: Body, exit: Nat, next, outputs: List<Typed>,
    fresh: Body::Loop(inputs, parameters, inner, exit, next, outputs).fresh(used) = Some(used2)): LoopFresh(used, used2, parameters, inner, outputs) {
    let first = Option::and_then_some(fresh_ids([], typed_ids(parameters)), λ (start: List<Nat>) =>
        inner.fresh(start).and_then(λ (inside: List<Nat>) => fresh_ids(used ++ inside, typed_ids(outputs))), used2, fresh);
    let second = Option::and_then_some(inner.fresh(first.witness), λ (inside: List<Nat>) => fresh_ids(used ++ inside, typed_ids(outputs)), used2,
        first.proof.right);
    LoopFresh(start := first.witness, params := first.proof.left, inside := second.witness, body := second.proof.left, outs := second.proof.right)
}

// The loop binds its outputs in the scope it is in; its passes' ids are
// counted bound there too, so no id after it is one a pass bound.
theorem loop_scopes(c, after: Config, used, used2: List<Nat>, kinds, bound: List<Typed>, outputs: List<Typed>, inside: List<Nat>, words: List<Value>,
    l: Locals, bind: bind_values(outputs, words, c.locals) = Some(l), fresh: fresh_ids(used ++ inside, typed_ids(outputs)) = Some(used2),
    checked: bind_kinds(kinds, outputs) = Some(bound), scoped: Scoped(c.locals, used, kinds), lands: after.locals = l):
    (Scopes(c.locals, after.locals, used, used2, bound) ∧ (read_values(outputs, after.locals) = Some(words))) ∧
        ((id: Nat) → Mem(id, inside) → Mem(id, used2)) {
    let grow = λ (id: Nat) (m: Mem(id, used)) => used.mem_append_l(inside, id, m);
    let wide: Scoped(c.locals, used ++ inside, kinds) = ⟨c.locals.kinded_widen(used, used ++ inside, grow, kinds, scoped.left),
        c.locals.fresh_widen(used, used ++ inside, grow, scoped.right)⟩;
    let bs = bind_values_scopes(outputs, words, c.locals, l, used ++ inside, used2, kinds, bound, bind, fresh, checked, wide);
    ⟨j(sym(lands), λ x _ => Scopes(c.locals, x, used, used2, bound) ∧ (read_values(outputs, x) = Some(words)),
        ⟨⟨bs.left.left, ⟨λ id back => bs.left.right.left(id, λ m => grow(id, back(m))), λ id m => bs.left.right.right(id, grow(id, m))⟩⟩, bs.right⟩),
     λ id m => bs.left.right.right(id, used.mem_append_r(inside, id, m))⟩
}

// What a pass that ran gives: its valuation (its final locals lowered), at
// which its parameters are the state's words, its body's facts hold, the
// next words are its words at `next`, and its exit bit is the run's.
fn PassFacts(Pass: Valuation() → Now → Now → Type, spans: Spans, parameters: List<Typed>, exit: Nat, next: List<Typed>, state: List<Value>, from: Now,
    after: Config, later: List<Value>) → Type {
    Exists<Valuation()>(λ v => ((words_of(v, typed_ids(parameters)) = lower_values(spans, state)) ∧ Pass(v, from, Now(after.memory, after.io))) ∧
        ((words_of(v, typed_ids(next)) = lower_values(spans, later)) ∧ (v(1, exit).head_bit() = after.locals.words(1, exit).head_bit())))
}

// One pass and what follows it: `n` passes left after it. What follows
// is within its bound where it runs (`peaked`).
theorem loop_holds_step(spans: Spans, Pass: Valuation() → Now → Now → Type, parameters: List<Typed>,
    exit: Nat, next: List<Typed>, n: Nat, later: List<Value> → Heap → Io → Ran<Ended>, later_peak: List<Value> → Heap → Io → Nat, cap: Nat,
    state: List<Value>, m: Heap, io: Io, end: Ended, after: Config, more: List<Value>, v: Valuation(),
    params: words_of(v, typed_ids(parameters)) = lower_values(spans, state), passed: Pass(v, Now(m, io), Now(after.memory, after.io)),
    nexts: words_of(v, typed_ids(next)) = lower_values(spans, more), bit: v(1, exit).head_bit() = after.locals.words(1, exit).head_bit(),
    ih: (state: List<Value>) → (m: Heap) → (io: Io) → (end: Ended) → later_peak(state, m, io) <= cap → later(state, m, io) = Done(end) →
        PassesHold(Pass, parameters, exit, next, n, lower_values(spans, state), Now(m, io), lower_values(spans, end.state), Now(end.memory, end.io)),
    peaked: (match after.locals.words(1, exit).head_bit() { False => later_peak(more, after.memory, after.io), True => 0 }) <= cap,
    last: (match after.locals.words(1, exit).head_bit() {
        False => later(more, after.memory, after.io),
        True => Done(Ended(more, after.memory, after.io)),
    }) = Done(end)):
    PassesHold(Pass, parameters, exit, next, Succ(n), lower_values(spans, state), Now(m, io), lower_values(spans, end.state), Now(end.memory, end.io)) {
    let P = λ (b: Bool) => match b {
        True => (lower_values(spans, end.state) = words_of(v, typed_ids(next))) ∧ (Now(end.memory, end.io) = Now(after.memory, after.io)),
        False => PassesHold(Pass, parameters, exit, next, n, words_of(v, typed_ids(next)), Now(after.memory, after.io), lower_values(spans, end.state), Now(end.memory, end.io)),
    };
    Exists(v, ⟨params, Exists(Now(after.memory, after.io), ⟨passed, j(sym(bit), λ b _ => P(b),
        (match after.locals.words(1, exit).head_bit() as λ b => (match b { False => later_peak(more, after.memory, after.io), True => 0 }) <= cap →
            (match b {
                False => later(more, after.memory, after.io),
                True => Done(Ended(more, after.memory, after.io)),
            }) = Done(end) → P(b) {
            True => λ _ e => {
                let s: (Ended(more, after.memory, after.io) = end) = Ran::done_inj<Ended>(Ended(more, after.memory, after.io), end, e);
                ⟨trans(cong_fn<Ended, List<BitVec(64)>>(λ x => lower_values(spans, x.state), sym(s)), sym(nexts)),
                 cong_fn<Ended, Now>(λ x => Now(x.memory, x.io), sym(s))⟩
            },
            False => λ low e => j(sym(nexts), λ x _ => PassesHold(Pass, parameters, exit, next, n, x, Now(after.memory, after.io), lower_values(spans, end.state), Now(end.memory, end.io)),
                ih(more, after.memory, after.io, end, low, e)),
        })(peaked, last))⟩)⟩)
}

// Each pass's facts, at whatever fuel it ran, its chain of calls within
// `cap`.
fn PassesFacts(blocks: Blocks, calls: Calls(), inner: Body, spans: Spans, Pass: Valuation() → Now → Now → Type, parameters: List<Typed>, exit: Nat,
    next: List<Typed>, peak: Nat → Config → Nat, cap: Nat) → Type {
    (rest: Nat) → (state: List<Value>) → (m: Heap) → (io: Io) → (l: Locals) → (after: Config) → (more: List<Value>) →
        pass_locals(parameters, state) = Some(l) → peak(rest, Config(l, m, io)) <= cap → inner.run(blocks, calls, rest, Config(l, m, io)) = Done(after) →
        read_values(next, after.locals) = Some(more) → PassFacts(Pass, spans, parameters, exit, next, state, Now(m, io), after, more)
}

// A pass that ran, then `later` with `n` passes left.
theorem loop_pass_holds(blocks: Blocks, calls: Calls(), inner: Body, spans: Spans, Pass: Valuation() → Now → Now → Type, parameters: List<Typed>,
    exit: Nat, next: List<Typed>, peak: Nat → Config → Nat, cap: Nat, passes: PassesFacts(blocks, calls, inner, spans, Pass, parameters, exit, next, peak, cap),
    fuel, n: Nat, later: List<Value> → Heap → Io → Ran<Ended>, later_peak: List<Value> → Heap → Io → Nat,
    ih: (state: List<Value>) → (m: Heap) → (io: Io) → (end: Ended) → later_peak(state, m, io) <= cap → later(state, m, io) = Done(end) →
        PassesHold(Pass, parameters, exit, next, n, lower_values(spans, state), Now(m, io), lower_values(spans, end.state), Now(end.memory, end.io))):
    (state: List<Value>) → (m: Heap) → (io: Io) → (end: Ended) →
    loop_pass_peak(λ (k: Nat) (pass: Config) => inner.run(blocks, calls, k, pass), peak, parameters, exit, next, fuel, later_peak, state, m, io) <= cap →
    loop_pass(λ (k: Nat) (pass: Config) => inner.run(blocks, calls, k, pass), parameters, exit, next, fuel, later, state, m, io) = Done(end) →
    PassesHold(Pass, parameters, exit, next, Succ(n), lower_values(spans, state), Now(m, io), lower_values(spans, end.state), Now(end.memory, end.io)) {
    λ state m io end peaked ran => {
        let after_pass = λ (after: Config) => Ran::of(read_values(next, after.locals), after.io).then(λ (more: List<Value>) =>
            match after.locals.words(1, exit).head_bit() {
                False => later(more, after.memory, after.io),
                True => Done(Ended(more, after.memory, after.io)),
            });
        let after_peak = λ (after: Config) => match read_values(next, after.locals) {
            None => 0,
            Some(more) => match after.locals.words(1, exit).head_bit() { False => later_peak(more, after.memory, after.io), True => 0 },
        };
        let one = Ran::then_done<Locals, Ended>(Ran::of(pass_locals(parameters, state), io), λ (l: Locals) =>
            inner.run(blocks, calls, fuel, Config(l, m, io)).then(after_pass), end, ran);
        let l = one.witness;
        let bound_l = Ran::of_done<Locals>(pass_locals(parameters, state), io, l, one.proof.left);
        let two = Ran::then_done<Config, Ended>(inner.run(blocks, calls, fuel, Config(l, m, io)), after_pass, end, one.proof.right);
        let after = two.witness;
        let three = Ran::then_done<List<Value>, Ended>(Ran::of(read_values(next, after.locals), after.io), λ (more: List<Value>) =>
            match after.locals.words(1, exit).head_bit() {
                False => later(more, after.memory, after.io),
                True => Done(Ended(more, after.memory, after.io)),
            }, end, two.proof.right);
        let more = three.witness;
        let read_more = Ran::of_done<List<Value>>(read_values(next, after.locals), after.io, more, three.proof.left);
        let at_l: (peak(fuel, Config(l, m, io)).max(inner.run(blocks, calls, fuel, Config(l, m, io)).deeper(after_peak)) <= cap) =
            j(bound_l, λ o _ => (match o {
                None => 0,
                Some(l2) => peak(fuel, Config(l2, m, io)).max(inner.run(blocks, calls, fuel, Config(l2, m, io)).deeper(after_peak)),
            }) <= cap, peaked);
        let pass_peak: (peak(fuel, Config(l, m, io)) <= cap) =
            Nat::le_trans(peak(fuel, Config(l, m, io)), peak(fuel, Config(l, m, io)).max(inner.run(blocks, calls, fuel, Config(l, m, io)).deeper(after_peak)),
                cap, peak(fuel, Config(l, m, io)).le_max_l(inner.run(blocks, calls, fuel, Config(l, m, io)).deeper(after_peak)), at_l);
        let rest_peak: (inner.run(blocks, calls, fuel, Config(l, m, io)).deeper(after_peak) <= cap) =
            Nat::le_trans(inner.run(blocks, calls, fuel, Config(l, m, io)).deeper(after_peak),
                peak(fuel, Config(l, m, io)).max(inner.run(blocks, calls, fuel, Config(l, m, io)).deeper(after_peak)),
                cap, peak(fuel, Config(l, m, io)).le_max_r(inner.run(blocks, calls, fuel, Config(l, m, io)).deeper(after_peak)), at_l);
        let after_peaked: (after_peak(after) <= cap) = j(two.proof.left, λ x _ => x.deeper(after_peak) <= cap, rest_peak);
        let later_peaked: ((match after.locals.words(1, exit).head_bit() { False => later_peak(more, after.memory, after.io), True => 0 }) <= cap) =
            j(read_more, λ o _ => (match o {
                None => 0,
                Some(more2) => match after.locals.words(1, exit).head_bit() { False => later_peak(more2, after.memory, after.io), True => 0 },
            }) <= cap, after_peaked);
        let facts = passes(fuel, state, m, io, l, after, more, bound_l, pass_peak, two.proof.left, read_more);
        loop_holds_step(spans, Pass, parameters, exit, next, n, later, later_peak, cap, state, m, io, end, after, more, facts.witness,
            facts.proof.left.left, facts.proof.left.right, facts.proof.right.left, facts.proof.right.right, ih, later_peaked, three.proof.right)
    }
}

// The passes after the first, by induction on the fuel: at most `fuel`.
theorem loop_later_holds(blocks: Blocks, calls: Calls(), inner: Body, spans: Spans, Pass: Valuation() → Now → Now → Type, parameters: List<Typed>,
    exit: Nat, next: List<Typed>, peak: Nat → Config → Nat, cap: Nat, passes: PassesFacts(blocks, calls, inner, spans, Pass, parameters, exit, next, peak, cap),
    fuel: Nat): (state: List<Value>) → (m: Heap) → (io: Io) → (end: Ended) →
    loop_later_peak(λ (n: Nat) (pass: Config) => inner.run(blocks, calls, n, pass), peak, parameters, exit, next, fuel, state, m, io) <= cap →
    loop_later(λ (n: Nat) (pass: Config) => inner.run(blocks, calls, n, pass), parameters, exit, next, fuel, state, m, io) = Done(end) →
    PassesHold(Pass, parameters, exit, next, fuel, lower_values(spans, state), Now(m, io), lower_values(spans, end.state), Now(end.memory, end.io)) {
    match fuel {
        Zero => λ state m io end _ never => absurd(never),
        Succ(rest) => loop_pass_holds(blocks, calls, inner, spans, Pass, parameters, exit, next, peak, cap, passes, rest, rest,
            loop_later(λ (n: Nat) (pass: Config) => inner.run(blocks, calls, n, pass), parameters, exit, next, rest),
            loop_later_peak(λ (n: Nat) (pass: Config) => inner.run(blocks, calls, n, pass), peak, parameters, exit, next, rest),
            loop_later_holds(blocks, calls, inner, spans, Pass, parameters, exit, next, peak, cap, passes, rest)),
    }
}

// The passes: each pass's facts give the loop's, at most one more pass
// than the fuel.
theorem loop_holds_of(blocks: Blocks, calls: Calls(), inner: Body, spans: Spans, Pass: Valuation() → Now → Now → Type, parameters: List<Typed>, exit: Nat,
    next: List<Typed>, peak: Nat → Config → Nat, cap: Nat, passes: PassesFacts(blocks, calls, inner, spans, Pass, parameters, exit, next, peak, cap),
    fuel: Nat): (state: List<Value>) → (m: Heap) → (io: Io) → (end: Ended) →
    loop_run_peak(λ (n: Nat) (pass: Config) => inner.run(blocks, calls, n, pass), peak, parameters, exit, next, fuel, state, m, io) <= cap →
    loop_run(λ (n: Nat) (pass: Config) => inner.run(blocks, calls, n, pass), parameters, exit, next, fuel, state, m, io) = Done(end) →
    PassesHold(Pass, parameters, exit, next, Succ(fuel), lower_values(spans, state), Now(m, io), lower_values(spans, end.state), Now(end.memory, end.io)) {
    loop_pass_holds(blocks, calls, inner, spans, Pass, parameters, exit, next, peak, cap, passes, fuel, fuel,
        loop_later(λ (n: Nat) (pass: Config) => inner.run(blocks, calls, n, pass), parameters, exit, next, fuel),
        loop_later_peak(λ (n: Nat) (pass: Config) => inner.run(blocks, calls, n, pass), peak, parameters, exit, next, fuel),
        loop_later_holds(blocks, calls, inner, spans, Pass, parameters, exit, next, peak, cap, passes, fuel))
}

theorem empty_scoped(): Scoped(Locals::empty(), [], []) { ⟨trivial, λ id loc never => absurd(never)⟩ }

// An id the scope never binds is zero in the valuation.
theorem spare_zero(start, end: Locals, spans: Spans, u0, used: List<Nat>, spare: Nat, absent: Mem(spare, used) → False,
    first: Frames(Locals::empty(), start, [], u0), second: Frames(start, end, u0, used)): end.lower(spans)(64, spare) = BitVec::zero() {
    let all = frames_trans(Locals::empty(), start, end, [], u0, used, first, second);
    let same = all.left(spare, λ m => false_elim(absent(m)));
    j(same.right, λ o _ => (match o { Some(loc) => word_value(loc.address(spans), 64), None => end.words(64, spare) }) = BitVec::zero(), sym(same.left(64)))
}

// ---------------------------------------------------------------------------
// System calls: what a run done through one says (§17.7)

// A system call done: the reference's location, the window open or the
// bytes read, the result word bound, the answer landed and the exchange
// recorded, at the locals' words.
fn SysRan(call: SysCall, blocks: Blocks, c, after: Config) → Type {
    match call {
        Read(fd, buf, len, result) => Exists<Loc>(λ loc => (c.locals.refs(buf) = Some(loc)) ∧
            ((c.memory.open(blocks, loc, c.locals.word(len).toNat()) = True) ∧ Exists<BitVec(64)>(λ w =>
                (after.locals = c.locals.set_word(result, word_value(w))) ∧
                (ReadLands(blocks, c.memory, after.memory, loc, c.locals.word(len).toNat(), w,
                    c.io.answer(ReadCmd(c.locals.word(fd), c.locals.word(len).toNat()))) ∧
                 (after.io = c.io.exchanged(ReadCmd(c.locals.word(fd), c.locals.word(len).toNat()),
                    c.io.answer(ReadCmd(c.locals.word(fd), c.locals.word(len).toNat())))))))),
        Write(fd, buf, len, result) => Exists<Loc>(λ loc => (c.locals.refs(buf) = Some(loc)) ∧ Exists<List<BitVec(8)>>(λ bytes =>
            (c.memory.read_bytes(loc, c.locals.word(len).toNat()) = Some(bytes)) ∧ Exists<BitVec(64)>(λ w =>
                (after.locals = c.locals.set_word(result, word_value(w))) ∧
                ((WriteLands(w, c.io.answer(WriteCmd(c.locals.word(fd), bytes))) ∧ (after.memory = c.memory)) ∧
                 (after.io = c.io.exchanged(WriteCmd(c.locals.word(fd), bytes), c.io.answer(WriteCmd(c.locals.word(fd), bytes)))))))),
    }
}

theorem read_landed_done(blocks: Blocks, c: Config, fd: BitVec(64), loc: Loc, n, result: Nat, after: Config): (a: ReadResult) →
    read_landed(blocks, c, fd, loc, n, result, a) = Done(after) →
    Exists<BitVec(64)>(λ w => (after.locals = c.locals.set_word(result, word_value(w))) ∧
        (ReadLands(blocks, c.memory, after.memory, loc, n, w, a) ∧ (after.io = c.io.exchanged(ReadCmd(fd, n), a)))) {
    λ a => match a {
        ReadBytes(bytes) => λ e => {
            let w = count_word(bytes.take(n).len());
            let io = c.io.exchanged(ReadCmd(fd, n), ReadBytes(bytes));
            let s = Ran::then_done<Heap, Config>(Ran::of(c.memory.put(blocks.written, loc, Piece::plain(bytes.take(n))), c.io), λ (m: Heap) =>
                Done(Config(c.locals.set_word(result, word_value(w)), m, io)), after, e);
            let put = Ran::of_done<Heap>(c.memory.put(blocks.written, loc, Piece::plain(bytes.take(n))), c.io, s.witness, s.proof.left);
            let fin = Ran::done_inj<Config>(Config(c.locals.set_word(result, word_value(w)), s.witness, io), after, s.proof.right);
            Exists(w, ⟨sym(cong_fn<Config, Locals>(λ y => y.locals, fin)),
                ⟨⟨trans(put, cong_fn<Config, Option<Heap>>(λ y => Some(y.memory), fin)), refl⟩, sym(cong_fn<Config, Io>(λ y => y.io, fin))⟩⟩)
        },
        ReadFailed(errno) => λ e => {
            let w = bytes_level::errno_word(errno);
            let io = c.io.exchanged(ReadCmd(fd, n), ReadFailed(errno));
            let s = Ran::then_done<Heap, Config>(Ran::of(c.memory.put(blocks.written, loc, Piece::undefined(n)), c.io), λ (m: Heap) =>
                Done(Config(c.locals.set_word(result, word_value(w)), m, io)), after, e);
            let put = Ran::of_done<Heap>(c.memory.put(blocks.written, loc, Piece::undefined(n)), c.io, s.witness, s.proof.left);
            let fin = Ran::done_inj<Config>(Config(c.locals.set_word(result, word_value(w)), s.witness, io), after, s.proof.right);
            Exists(w, ⟨sym(cong_fn<Config, Locals>(λ y => y.locals, fin)),
                ⟨⟨trans(put, cong_fn<Config, Option<Heap>>(λ y => Some(y.memory), fin)), refl⟩, sym(cong_fn<Config, Io>(λ y => y.io, fin))⟩⟩)
        },
    }
}

theorem write_landed_done(c: Config, fd: BitVec(64), bytes: List<BitVec(8)>, result: Nat, after: Config): (a: WriteResult) →
    write_landed(c, fd, bytes, result, a) = Done(after) →
    Exists<BitVec(64)>(λ w => (after.locals = c.locals.set_word(result, word_value(w))) ∧
        ((WriteLands(w, a) ∧ (after.memory = c.memory)) ∧ (after.io = c.io.exchanged(WriteCmd(fd, bytes), a)))) {
    λ a => match a {
        Wrote(count) => λ e => {
            let fin = Ran::done_inj<Config>(Config(c.locals.set_word(result, word_value(count_word(count))), c.memory,
                c.io.exchanged(WriteCmd(fd, bytes), Wrote(count))), after, e);
            Exists(count_word(count), ⟨sym(cong_fn<Config, Locals>(λ y => y.locals, fin)),
                ⟨⟨refl, sym(cong_fn<Config, Heap>(λ y => y.memory, fin))⟩, sym(cong_fn<Config, Io>(λ y => y.io, fin))⟩⟩)
        },
        WriteFailed(errno) => λ e => {
            let fin = Ran::done_inj<Config>(Config(c.locals.set_word(result, word_value(bytes_level::errno_word(errno))), c.memory,
                c.io.exchanged(WriteCmd(fd, bytes), WriteFailed(errno))), after, e);
            Exists(bytes_level::errno_word(errno), ⟨sym(cong_fn<Config, Locals>(λ y => y.locals, fin)),
                ⟨⟨refl, sym(cong_fn<Config, Heap>(λ y => y.memory, fin))⟩, sym(cong_fn<Config, Io>(λ y => y.io, fin))⟩⟩)
        },
    }
}

theorem SysCall::ran(self call: SysCall, blocks: Blocks, c, after: Config): call.run(blocks, c) = Done(after) → SysRan(call, blocks, c, after) {
    match call {
        Read(fd, buf, len, result) => λ ran => {
            let n = c.locals.word(len).toNat();
            let fdw = c.locals.word(fd);
            let one = Ran::then_done<Loc, Config>(Ran::of(c.locals.refs(buf), c.io), λ (loc: Loc) => read_into(blocks, c, fdw, loc, n, result), after, ran);
            let loc = one.witness;
            let refs = Ran::of_done<Loc>(c.locals.refs(buf), c.io, loc, one.proof.left);
            (match c.memory.open(blocks, loc, n) as λ v => c.memory.open(blocks, loc, n) = v →
                (match v { False => Stuck(c.io), True => read_landed(blocks, c, fdw, loc, n, result, c.io.world(c.io.past, ReadCmd(fdw, n))) }) = Done(after) →
                SysRan(Read(fd, buf, len, result), blocks, c, after) {
                False => λ _ never => absurd(never),
                True => λ opened landed => Exists(loc, ⟨refs, ⟨opened,
                    read_landed_done(blocks, c, fdw, loc, n, result, after, c.io.world(c.io.past, ReadCmd(fdw, n)), landed)⟩⟩),
            })(refl, one.proof.right)
        },
        Write(fd, buf, len, result) => λ ran => {
            let n = c.locals.word(len).toNat();
            let fdw = c.locals.word(fd);
            let one = Ran::then_done<Loc, Config>(Ran::of(c.locals.refs(buf), c.io), λ (loc: Loc) =>
                Ran::of(c.memory.read_bytes(loc, n), c.io).then(λ (bytes: List<BitVec(8)>) =>
                    write_landed(c, fdw, bytes, result, c.io.world(c.io.past, WriteCmd(fdw, bytes)))), after, ran);
            let loc = one.witness;
            let refs = Ran::of_done<Loc>(c.locals.refs(buf), c.io, loc, one.proof.left);
            let two = Ran::then_done<List<BitVec(8)>, Config>(Ran::of(c.memory.read_bytes(loc, n), c.io), λ (bytes: List<BitVec(8)>) =>
                write_landed(c, fdw, bytes, result, c.io.world(c.io.past, WriteCmd(fdw, bytes))), after, one.proof.right);
            let bytes = two.witness;
            Exists(loc, ⟨refs, Exists(bytes, ⟨Ran::of_done<List<BitVec(8)>>(c.memory.read_bytes(loc, n), c.io, bytes, two.proof.left),
                write_landed_done(c, fdw, bytes, result, after, c.io.world(c.io.past, WriteCmd(fdw, bytes)), two.proof.right)⟩)⟩)
        },
    }
}

// What a system call checks: its words and reference are bound at their
// kinds, and it binds its result word.
fn SysChecked(call: SysCall, kinds, bound: List<Typed>) → Type {
    match call {
        Read(fd, buf, len, result) => ((has_kind(kinds, fd, WordKind) = True) ∧ ((has_kind(kinds, buf, RefKind) = True) ∧ (has_kind(kinds, len, WordKind) = True))) ∧
            (bind_kind(kinds, word_id(result)) = Some(bound)),
        Write(fd, buf, len, result) => ((has_kind(kinds, fd, WordKind) = True) ∧ ((has_kind(kinds, buf, RefKind) = True) ∧ (has_kind(kinds, len, WordKind) = True))) ∧
            (bind_kind(kinds, word_id(result)) = Some(bound)),
    }
}

theorem SysCall::checked(self call: SysCall, kinds, bound: List<Typed>): call.check(kinds) = Some(bound) → SysChecked(call, kinds, bound) {
    match call {
        Read(fd, buf, len, result) => λ checked => {
            let ok = true_of_some<List<Typed>>(has_kind(kinds, fd, WordKind) && (has_kind(kinds, buf, RefKind) && has_kind(kinds, len, WordKind)),
                bind_kind(kinds, word_id(result)), bound, checked);
            let first = Bool::and_true_parts(has_kind(kinds, fd, WordKind), has_kind(kinds, buf, RefKind) && has_kind(kinds, len, WordKind), ok);
            let second = Bool::and_true_parts(has_kind(kinds, buf, RefKind), has_kind(kinds, len, WordKind), first.right);
            ⟨⟨first.left, second⟩, true_some<List<Typed>>(has_kind(kinds, fd, WordKind) && (has_kind(kinds, buf, RefKind) && has_kind(kinds, len, WordKind)),
                bind_kind(kinds, word_id(result)), bound, checked)⟩
        },
        Write(fd, buf, len, result) => λ checked => {
            let ok = true_of_some<List<Typed>>(has_kind(kinds, fd, WordKind) && (has_kind(kinds, buf, RefKind) && has_kind(kinds, len, WordKind)),
                bind_kind(kinds, word_id(result)), bound, checked);
            let first = Bool::and_true_parts(has_kind(kinds, fd, WordKind), has_kind(kinds, buf, RefKind) && has_kind(kinds, len, WordKind), ok);
            let second = Bool::and_true_parts(has_kind(kinds, buf, RefKind), has_kind(kinds, len, WordKind), first.right);
            ⟨⟨first.left, second⟩, true_some<List<Typed>>(has_kind(kinds, fd, WordKind) && (has_kind(kinds, buf, RefKind) && has_kind(kinds, len, WordKind)),
                bind_kind(kinds, word_id(result)), bound, checked)⟩
        },
    }
}

theorem SysCall::checked_bind(self call: SysCall, kinds, bound: List<Typed>, checked: call.check(kinds) = Some(bound)):
    bind_kind(kinds, word_id(call.result())) = Some(bound) {
    (match call as λ k => SysChecked(k, kinds, bound) → bind_kind(kinds, word_id(k.result())) = Some(bound) {
        Read(_, _, _, _) => λ ok => ok.right,
        Write(_, _, _, _) => λ ok => ok.right,
    })(call.checked(kinds, bound, checked))
}

// A system call binds its result word and nothing else.
theorem SysCall::ran_binds(self call: SysCall, blocks: Blocks, c, after: Config, ran: call.run(blocks, c) = Done(after)):
    Binds(call.result(), WordKind, c.locals, after.locals) {
    (match call as λ k => SysRan(k, blocks, c, after) → Binds(k.result(), WordKind, c.locals, after.locals) {
        Read(_, _, _, result) => λ r => Exists(word_value(r.proof.right.right.witness), r.proof.right.right.proof.left),
        Write(_, _, _, result) => λ r => Exists(word_value(r.proof.right.proof.right.witness), r.proof.right.proof.right.proof.left),
    })(call.ran(blocks, c, after, ran))
}

// Its world after: one exchange more, the world's function the same.
theorem SysCall::ran_io(self call: SysCall, blocks: Blocks, c, after: Config, ran: call.run(blocks, c) = Done(after)):
    (c.io.past.len() + 1 = after.io.past.len()) ∧ (after.io.world = c.io.world) {
    (match call as λ k => SysRan(k, blocks, c, after) → (c.io.past.len() + 1 = after.io.past.len()) ∧ (after.io.world = c.io.world) {
        Read(fd, _, len, _) => λ r => {
            let e = r.proof.right.right.proof.right.right;
            ⟨sym(cong_fn<Io, Nat>(λ w => w.past.len(), e)), cong_fn<Io, World()>(λ w => w.world, e)⟩
        },
        Write(fd, _, _, _) => λ r => {
            let e = r.proof.right.proof.right.proof.right.right;
            ⟨sym(cong_fn<Io, Nat>(λ w => w.past.len(), e)), cong_fn<Io, World()>(λ w => w.world, e)⟩
        },
    })(call.ran(blocks, c, after, ran))
}

// A system call's meaning with its descriptor word `x` and length word `y`
// as given: `SysCall::Lands` where they are the valuation's.
fn ReadLandsWith(spans: Spans, blocks: Blocks, values: Valuation(), buf, result: Nat, before, after: Now, x, y: BitVec(64)) → Type {
    Exists<Loc>(λ (l: Loc) => (values(64, buf) = l.address(spans)) ∧
        ((before.heap.open(blocks, l, y.toNat()) = True) ∧
            (ReadLands(blocks, before.heap, after.heap, l, y.toNat(), values(64, result), before.io.answer(ReadCmd(x, y.toNat()))) ∧
             (after.io = before.io.exchanged(ReadCmd(x, y.toNat()), before.io.answer(ReadCmd(x, y.toNat())))))))
}

fn WriteLandsWith(spans: Spans, blocks: Blocks, values: Valuation(), buf, result: Nat, before, after: Now, x, y: BitVec(64)) → Type {
    Exists<Loc>(λ (l: Loc) => (values(64, buf) = l.address(spans)) ∧ Exists<List<BitVec(8)>>(λ (bs: List<BitVec(8)>) =>
        (before.heap.read_bytes(l, y.toNat()) = Some(bs)) ∧
            ((WriteLands(values(64, result), before.io.answer(WriteCmd(x, bs))) ∧ (after.heap = before.heap)) ∧
             (after.io = before.io.exchanged(WriteCmd(x, bs), before.io.answer(WriteCmd(x, bs)))))))
}

// A system call done, at a valuation that agrees with the locals before it
// and after: its meaning (`SysCall::Lands`), the words read off the
// valuation.
theorem SysCall::lands_of(self call: SysCall, blocks: Blocks, spans: Spans, values: Valuation(), kinds, bound: List<Typed>, c, after: Config,
    checked: call.check(kinds) = Some(bound), ran: call.run(blocks, c) = Done(after),
    agrees: c.locals.Agrees(spans, values, kinds), later: after.locals.Agrees(spans, values, bound)):
    call.Lands(spans, blocks, values, Now(c.memory, c.io), Now(after.memory, after.io)) {
    let result_word = λ (result: Nat) (w: BitVec(64)) (bound_result: bind_kind(kinds, word_id(result)) = Some(bound))
        (set: after.locals = c.locals.set_word(result, word_value(w))) =>
        trans(after.locals.agrees_word(spans, values, bound, result, bind_kind_has(word_id(result), kinds, bound, bound_result), later, 64),
            trans(cong_fn<Locals, BitVec(64)>(λ l => l.words(64, result), set),
                Valuation::set_here(c.locals.words, result, word_value(w), 64)));
    (match call as λ k => k.check(kinds) = Some(bound) → SysRan(k, blocks, c, after) → k.Lands(spans, blocks, values, Now(c.memory, c.io), Now(after.memory, after.io)) {
        Read(fd, buf, len, result) => λ checked2 r => {
            let ok = SysCall::Read(fd, buf, len, result).checked(kinds, bound, checked2);
            let fdq: (values(64, fd) = c.locals.word(fd)) = c.locals.agrees_word(spans, values, kinds, fd, ok.left.left, agrees, 64);
            let lenq: (values(64, len) = c.locals.word(len)) = c.locals.agrees_word(spans, values, kinds, len, ok.left.right.right, agrees, 64);
            let shown = c.locals.agrees_ref(spans, values, kinds, buf, ok.left.right.left, agrees);
            let loc = r.witness;
            let same: (shown.witness = loc) = Option::some_inj(shown.witness, loc, trans(sym(shown.proof.left), r.proof.left));
            let addressed: (values(64, buf) = loc.address(spans)) = trans(shown.proof.right, cong_fn<Loc, BitVec(64)>(λ l => l.address(spans), same));
            let got = r.proof.right.right;
            let named = result_word(result, got.witness, ok.right, got.proof.left);
            let P = λ (x: BitVec(64)) (y: BitVec(64)) => ReadLandsWith(spans, blocks, values, buf, result, Now(c.memory, c.io), Now(after.memory, after.io), x, y);
            let here: P(c.locals.word(fd), c.locals.word(len)) = Exists(loc, ⟨addressed, ⟨r.proof.right.left,
                ⟨j(sym(named), λ w _ => ReadLands(blocks, c.memory, after.memory, loc, c.locals.word(len).toNat(), w,
                        c.io.answer(ReadCmd(c.locals.word(fd), c.locals.word(len).toNat()))), got.proof.right.left),
                 got.proof.right.right⟩⟩⟩);
            j(sym(lenq), λ y _ => P(values(64, fd), y), j(sym(fdq), λ x _ => P(x, c.locals.word(len)), here))
        },
        Write(fd, buf, len, result) => λ checked2 r => {
            let ok = SysCall::Write(fd, buf, len, result).checked(kinds, bound, checked2);
            let fdq: (values(64, fd) = c.locals.word(fd)) = c.locals.agrees_word(spans, values, kinds, fd, ok.left.left, agrees, 64);
            let lenq: (values(64, len) = c.locals.word(len)) = c.locals.agrees_word(spans, values, kinds, len, ok.left.right.right, agrees, 64);
            let shown = c.locals.agrees_ref(spans, values, kinds, buf, ok.left.right.left, agrees);
            let loc = r.witness;
            let same: (shown.witness = loc) = Option::some_inj(shown.witness, loc, trans(sym(shown.proof.left), r.proof.left));
            let addressed: (values(64, buf) = loc.address(spans)) = trans(shown.proof.right, cong_fn<Loc, BitVec(64)>(λ l => l.address(spans), same));
            let bytes = r.proof.right.witness;
            let got = r.proof.right.proof.right;
            let named = result_word(result, got.witness, ok.right, got.proof.left);
            let P = λ (x: BitVec(64)) (y: BitVec(64)) => WriteLandsWith(spans, blocks, values, buf, result, Now(c.memory, c.io), Now(after.memory, after.io), x, y);
            let here: P(c.locals.word(fd), c.locals.word(len)) = Exists(loc, ⟨addressed, Exists(bytes, ⟨r.proof.right.proof.left,
                ⟨⟨j(sym(named), λ w _ => WriteLands(w, c.io.answer(WriteCmd(c.locals.word(fd), bytes))), got.proof.right.left.left),
                    got.proof.right.left.right⟩, got.proof.right.right⟩⟩)⟩);
            j(sym(lenq), λ y _ => P(values(64, fd), y), j(sym(fdq), λ x _ => P(x, c.locals.word(len)), here))
        },
    })(checked, call.ran(blocks, c, after, ran))
}

// A system call never stops a run short: it is done or stuck.
theorem SysCall::stopped_none(self call: SysCall, blocks: Blocks, c: Config): call.run(blocks, c).stopped() = None {
    match call {
        Read(fd, buf, len, result) => {
            let n = c.locals.word(len).toNat();
            let fdw = c.locals.word(fd);
            match c.locals.refs(buf) as λ o => Ran::of(o, c.io).then(λ (loc: Loc) => read_into(blocks, c, fdw, loc, n, result)).stopped() = None {
                None => refl,
                Some(loc) => match c.memory.open(blocks, loc, n) as λ v =>
                    (match v { False => Stuck(c.io), True => read_landed(blocks, c, fdw, loc, n, result, c.io.world(c.io.past, ReadCmd(fdw, n))) }).stopped() = None {
                    False => refl,
                    True => match c.io.world(c.io.past, ReadCmd(fdw, n)) as λ a => read_landed(blocks, c, fdw, loc, n, result, a).stopped() = None {
                        ReadBytes(bytes) => match c.memory.put(blocks.written, loc, Piece::plain(bytes.take(n))) as λ o2 =>
                            Ran::of(o2, c.io).then(λ (m: Heap) => Done(Config(c.locals.set_word(result, word_value(count_word(bytes.take(n).len()))), m,
                                c.io.exchanged(ReadCmd(fdw, n), ReadBytes(bytes))))).stopped() = None {
                            None => refl,
                            Some(_) => refl,
                        },
                        ReadFailed(errno) => match c.memory.put(blocks.written, loc, Piece::undefined(n)) as λ o2 =>
                            Ran::of(o2, c.io).then(λ (m: Heap) => Done(Config(c.locals.set_word(result, word_value(bytes_level::errno_word(errno))), m,
                                c.io.exchanged(ReadCmd(fdw, n), ReadFailed(errno))))).stopped() = None {
                            None => refl,
                            Some(_) => refl,
                        },
                    },
                },
            }
        },
        Write(fd, buf, len, result) => {
            let n = c.locals.word(len).toNat();
            let fdw = c.locals.word(fd);
            match c.locals.refs(buf) as λ o => Ran::of(o, c.io).then(λ (loc: Loc) => Ran::of(c.memory.read_bytes(loc, n), c.io).then(λ (bytes: List<BitVec(8)>) =>
                write_landed(c, fdw, bytes, result, c.io.world(c.io.past, WriteCmd(fdw, bytes))))).stopped() = None {
                None => refl,
                Some(loc) => match c.memory.read_bytes(loc, n) as λ o2 => Ran::of(o2, c.io).then(λ (bytes: List<BitVec(8)>) =>
                    write_landed(c, fdw, bytes, result, c.io.world(c.io.past, WriteCmd(fdw, bytes)))).stopped() = None {
                    None => refl,
                    Some(bytes) => match c.io.world(c.io.past, WriteCmd(fdw, bytes)) as λ a => write_landed(c, fdw, bytes, result, a).stopped() = None {
                        Wrote(_) => refl,
                        WriteFailed(_) => refl,
                    },
                },
            }
        },
    }
}

// A checked region's run keeps the scope's invariant and frames the rest.
theorem Body::scopes(self body: Body, blocks: Blocks, calls: Calls(), fuel: Nat, sigs: Nat → Option<Signature>): (kinds, bound: List<Typed>) →
    (used, used2: List<Nat>) → (c, after: Config) → body.check(sigs, kinds) = Some(bound) → body.fresh(used) = Some(used2) →
    body.run(blocks, calls, fuel, c) = Done(after) → Scoped(c.locals, used, kinds) → Scopes(c.locals, after.locals, used, used2, bound) {
    match body {
        Leaf(instrs) => λ kinds bound used used2 c after checked fresh ran scoped =>
            leaf_scopes(blocks, instrs, kinds, bound, used, used2, c, after, checked, fresh, Ran::of_done<Config>(run_instrs(blocks, instrs, c), c.io, after, ran),
                scoped),
        Seq(first, rest) => λ kinds bound used used2 c after checked fresh ran scoped => {
            let checked_first = Option::and_then_some(first.check(sigs, kinds), λ (k: List<Typed>) => rest.check(sigs, k), bound, checked);
            let fresh_first = Option::and_then_some(first.fresh(used), λ (u: List<Nat>) => rest.fresh(u), used2, fresh);
            let ran_first = Ran::then_done<Config, Config>(first.run(blocks, calls, fuel, c), λ (mid: Config) => rest.run(blocks, calls, fuel, mid), after, ran);
            let mid = ran_first.witness;
            let one = first.scopes(blocks, calls, fuel, sigs, kinds, checked_first.witness, used, fresh_first.witness, c, mid, checked_first.proof.left,
                fresh_first.proof.left, ran_first.proof.left, scoped);
            let two = rest.scopes(blocks, calls, fuel, sigs, checked_first.witness, bound, fresh_first.witness, used2, mid, after, checked_first.proof.right,
                fresh_first.proof.right, ran_first.proof.right, one.left);
            ⟨two.left, frames_trans(c.locals, mid.locals, after.locals, used, fresh_first.witness, used2, one.right, two.right)⟩
        },
        Branch(condition, yes, no) => λ kinds bound used used2 c after checked fresh ran scoped => {
            let checks = true_some<List<Typed>>(has_kind(kinds, condition, WordKind), match yes.check(sigs, kinds) {
                None => None,
                Some(after_yes) => match no.check(sigs, kinds) { None => None, Some(after_no) => Some(meet_kinds(after_yes, after_no)) },
            }, bound, checked);
            let checked_yes = Option::and_then_some(yes.check(sigs, kinds), λ (ay: List<Typed>) =>
                no.check(sigs, kinds).and_then(λ (an: List<Typed>) => Some(meet_kinds(ay, an))), bound, checks);
            let checked_no = Option::and_then_some(no.check(sigs, kinds), λ (an: List<Typed>) => Some(meet_kinds(checked_yes.witness, an)), bound,
                checked_yes.proof.right);
            let fresh_yes = Option::and_then_some(yes.fresh(used), λ (uy: List<Nat>) => no.fresh(used).and_then(λ (un: List<Nat>) => Some(uy ++ un)),
                used2, fresh);
            let fresh_no = Option::and_then_some(no.fresh(used), λ (un: List<Nat>) => Some(fresh_yes.witness ++ un), used2, fresh_yes.proof.right);
            let ay = checked_yes.witness;
            let an = checked_no.witness;
            let uy = fresh_yes.witness;
            let un = fresh_no.witness;
            let k: (meet_kinds(ay, an) = bound) = Option::some_inj(meet_kinds(ay, an), bound, checked_no.proof.right);
            let u: (uy ++ un = used2) = Option::some_inj(uy ++ un, used2, fresh_no.proof.right);
            j(k, λ x _ => Scopes(c.locals, after.locals, used, used2, x), j(u, λ x _ => Scopes(c.locals, after.locals, used, x, meet_kinds(ay, an)),
                (match c.locals.words(1, condition).head_bit() as λ bit =>
                    (match bit { True => yes.run(blocks, calls, fuel, c), False => no.run(blocks, calls, fuel, c) }) = Done(after) →
                    Scopes(c.locals, after.locals, used, uy ++ un, meet_kinds(ay, an)) {
                    True => λ r => branch_scopes_yes(c.locals, after.locals, used, uy, un, ay, an,
                        yes.scopes(blocks, calls, fuel, sigs, kinds, ay, used, uy, c, after, checked_yes.proof.left, fresh_yes.proof.left, r, scoped)),
                    False => λ r => branch_scopes_no(c.locals, after.locals, used, uy, un, ay, an,
                        no.scopes(blocks, calls, fuel, sigs, kinds, an, used, un, c, after, checked_no.proof.left, fresh_no.proof.left, r, scoped)),
                })(ran)))
        },
        Call(callee, arguments, results) => λ kinds bound used used2 c after checked fresh ran scoped => {
            let r = call_ran(blocks, calls, fuel, callee, arguments, results, c, after, ran);
            let binds = true_some<List<Typed>>(has_kinds(kinds, arguments) && fits_signature(sigs, callee, arguments, results), bind_kinds(kinds, results),
                bound, checked);
            j(sym(cong_fn<Config, Locals>(λ y => y.locals, r.lands)), λ l _ => Scopes(c.locals, l, used, used2, bound),
                (bind_values_scopes(results, r.answer.words, c.locals, r.locals, used, used2, kinds, bound, r.bound, fresh, binds, scoped)).left)
        },
        Loop(inputs, parameters, inner, exit, next, outputs) => λ kinds bound used used2 c after checked fresh ran scoped => {
            let r = loop_ran(blocks, calls, fuel, inputs, parameters, inner, exit, next, outputs, c, after, ran);
            let ck = loop_checked(sigs, kinds, bound, inputs, parameters, inner, exit, next, outputs, checked);
            let fr = loop_fresh(used, used2, inputs, parameters, inner, exit, next, outputs, fresh);
            (loop_scopes(c, after, used, used2, kinds, bound, outputs, fr.inside, r.end.state, r.locals, r.bound, fr.outs, ck.outs, scoped,
                cong_fn<Config, Locals>(λ y => y.locals, r.lands))).left.left
        },
        Sys(call) => λ kinds bound used used2 c after checked fresh ran scoped =>
            bind_scopes(Some(word_id(call.result())), c.locals, after.locals, used, used2, kinds, bound, scoped, fresh,
                call.ran_binds(blocks, c, after, ran), call.checked_bind(kinds, bound, checked)),
        Exit(_) => λ kinds bound used used2 c after checked fresh never => absurd(never),
    }
}

theorem Instr::step_io(self instr: Instr, blocks: Blocks, c, after: Config, stepped: instr.step(blocks, c) = Some(after)): after.io = c.io {
    match instr {
        Compute(node) => {
            let made = Some(Config(Locals(node.step(c.locals.words), c.locals.refs), c.memory, c.io));
            match def: node.pure() && node.defined(c.locals.words) {
                False => absurd(j(def, λ v _ => (match v { False => None, True => made }) = Some(after), stepped)),
                True => sym(cong_fn<Config, Io>(λ y => y.io, Option::some_inj(Config(Locals(node.step(c.locals.words), c.locals.refs), c.memory, c.io), after,
                    j(def, λ v _ => (match v { False => None, True => made }) = Some(after), stepped)))),
            }
        },
        Load(bytes, _, output, place) => {
            let first = Option::and_then_some(c.locals.refs(place), λ (loc: Loc) =>
                c.memory.load(loc, bytes).and_then(λ (x: BitVec(64)) => Some(Config(c.locals.set_word(output, word_value(x)), c.memory, c.io))), after,
                stepped);
            let second = Option::and_then_some(c.memory.load(first.witness, bytes), λ (x: BitVec(64)) =>
                Some(Config(c.locals.set_word(output, word_value(x)), c.memory, c.io)), after, first.proof.right);
            sym(cong_fn<Config, Io>(λ y => y.io, Option::some_inj(Config(c.locals.set_word(output, word_value(second.witness)), c.memory, c.io), after,
                second.proof.right)))
        },
        Store(bytes, view, place, value) => {
            let piece = λ (w: BitVec(64)) => Piece::plain(low_bytes(bytes, w));
            let first = Option::and_then_some(c.locals.refs(place), λ (loc: Loc) =>
                c.memory.put(blocks.written, loc, piece(c.locals.view(view, value))).and_then(λ (m: Heap) => Some(Config(c.locals, m, c.io))), after, stepped);
            let second = Option::and_then_some(c.memory.put(blocks.written, first.witness, piece(c.locals.view(view, value))),
                λ (m: Heap) => Some(Config(c.locals, m, c.io)), after, first.proof.right);
            sym(cong_fn<Config, Io>(λ y => y.io, Option::some_inj(Config(c.locals, second.witness, c.io), after, second.proof.right)))
        },
        LoadRef(output, place) => {
            let first = Option::and_then_some(c.locals.refs(place), λ (loc: Loc) =>
                c.memory.load_ref(loc).and_then(λ (target: Loc) => Some(Config(c.locals.set_ref(output, target), c.memory, c.io))), after, stepped);
            let second = Option::and_then_some(c.memory.load_ref(first.witness), λ (target: Loc) =>
                Some(Config(c.locals.set_ref(output, target), c.memory, c.io)), after, first.proof.right);
            sym(cong_fn<Config, Io>(λ y => y.io, Option::some_inj(Config(c.locals.set_ref(output, second.witness), c.memory, c.io), after, second.proof.right)))
        },
        StoreRef(place, value) => {
            let first = Option::and_then_some(c.locals.refs(place), λ (loc: Loc) => c.locals.refs(value).and_then(λ (target: Loc) =>
                c.memory.put(blocks.written, loc, Piece::reference(target)).and_then(λ (m: Heap) => Some(Config(c.locals, m, c.io)))), after, stepped);
            let second = Option::and_then_some(c.locals.refs(value), λ (target: Loc) =>
                c.memory.put(blocks.written, first.witness, Piece::reference(target)).and_then(λ (m: Heap) => Some(Config(c.locals, m, c.io))), after,
                first.proof.right);
            let third = Option::and_then_some(c.memory.put(blocks.written, first.witness, Piece::reference(second.witness)),
                λ (m: Heap) => Some(Config(c.locals, m, c.io)), after, second.proof.right);
            sym(cong_fn<Config, Io>(λ y => y.io, Option::some_inj(Config(c.locals, third.witness, c.io), after, third.proof.right)))
        },
        Offset(output, place, amount) => {
            let moved = λ (loc: Loc) => Loc(loc.block, loc.offset + c.locals.word(amount).toNat());
            let first = Option::and_then_some(c.locals.refs(place), λ (loc: Loc) =>
                Some(Config(c.locals.set_ref(output, moved(loc)), c.memory, c.io)), after, stepped);
            sym(cong_fn<Config, Io>(λ y => y.io, Option::some_inj(Config(c.locals.set_ref(output, moved(first.witness)), c.memory, c.io), after,
                first.proof.right)))
        },
        Copy(target, source, length) => {
            let n = c.locals.word(length).toNat();
            let first = Option::and_then_some(c.locals.refs(target), λ (to: Loc) => c.locals.refs(source).and_then(λ (from: Loc) =>
                c.memory.copy(blocks.written, to, from, n).and_then(λ (m: Heap) => Some(Config(c.locals, m, c.io)))), after, stepped);
            let second = Option::and_then_some(c.locals.refs(source), λ (from: Loc) =>
                c.memory.copy(blocks.written, first.witness, from, n).and_then(λ (m: Heap) => Some(Config(c.locals, m, c.io))), after, first.proof.right);
            let third = Option::and_then_some(c.memory.copy(blocks.written, first.witness, second.witness, n),
                λ (m: Heap) => Some(Config(c.locals, m, c.io)), after, second.proof.right);
            sym(cong_fn<Config, Io>(λ y => y.io, Option::some_inj(Config(c.locals, third.witness, c.io), after, third.proof.right)))
        },
    }
}

theorem run_instrs_io(blocks: Blocks, instrs: List<Instr>): (c, after: Config) → run_instrs(blocks, instrs, c) = Some(after) → after.io = c.io {
    match instrs {
        Nil => λ c after ran => cong_fn<Config, Io>(λ y => y.io, sym(Option::some_inj(c, after, ran))),
        Cons(instr, rest) => λ c after ran => {
            let first = Option::and_then_some(instr.step(blocks, c), λ (m: Config) => run_instrs(blocks, rest, m), after, ran);
            trans(run_instrs_io(blocks, rest, first.witness, after, first.proof.right), instr.step_io(blocks, c, first.witness, first.proof.left))
        },
    }
}

// Calls whose history only grows.
fn HistoryGrows(calls: Calls()) → Type {
    (f: Nat) → (args: List<Value>) → (heap: Heap) → (io: Io) → (a: Answer) → calls(f, args, heap, io) = Done(a) → io.past.len() <= a.io.past.len()
}

// One world as another: as long.
theorem io_len_same(a, b: Io, e: b = a): a.past.len() <= b.past.len() { j(sym(e), λ w _ => a.past.len() <= w.past.len(), a.past.len().le_refl()) }

theorem loop_pass_grows(blocks: Blocks, calls: Calls(), inner: Body, parameters: List<Typed>, exit: Nat, next: List<Typed>,
    passes: (rest: Nat) → (state: List<Value>) → (m: Heap) → (io: Io) → (l: Locals) → (after: Config) → pass_locals(parameters, state) = Some(l) →
        inner.run(blocks, calls, rest, Config(l, m, io)) = Done(after) → io.past.len() <= after.io.past.len(),
    fuel: Nat, later: List<Value> → Heap → Io → Ran<Ended>,
    each: (state: List<Value>) → (m: Heap) → (io: Io) → (end: Ended) → later(state, m, io) = Done(end) → io.past.len() <= end.io.past.len()):
    (state: List<Value>) → (m: Heap) → (io: Io) → (end: Ended) →
    bytes_level::loop_pass(λ (n: Nat) (pass: Config) => inner.run(blocks, calls, n, pass), parameters, exit, next, fuel, later, state, m, io) = Done(end) →
    io.past.len() <= end.io.past.len() {
    λ state m io end ran => {
        let after_pass = λ (after: Config) => Ran::of(read_values(next, after.locals), after.io).then(λ (more: List<Value>) =>
            match after.locals.words(1, exit).head_bit() {
                False => later(more, after.memory, after.io),
                True => Done(Ended(more, after.memory, after.io)),
            });
        let one = Ran::then_done<Locals, Ended>(Ran::of(pass_locals(parameters, state), io), λ (l: Locals) =>
            inner.run(blocks, calls, fuel, Config(l, m, io)).then(after_pass), end, ran);
        let l = one.witness;
        let two = Ran::then_done<Config, Ended>(inner.run(blocks, calls, fuel, Config(l, m, io)), after_pass, end, one.proof.right);
        let after = two.witness;
        let three = Ran::then_done<List<Value>, Ended>(Ran::of(read_values(next, after.locals), after.io), λ (more: List<Value>) =>
            match after.locals.words(1, exit).head_bit() {
                False => later(more, after.memory, after.io),
                True => Done(Ended(more, after.memory, after.io)),
            }, end, two.proof.right);
        let more = three.witness;
        let pass_grows: (io.past.len() <= after.io.past.len()) = passes(fuel, state, m, io, l, after,
            Ran::of_done<Locals>(pass_locals(parameters, state), io, l, one.proof.left), two.proof.left);
        Nat::le_trans(io.past.len(), after.io.past.len(), end.io.past.len(), pass_grows, (match after.locals.words(1, exit).head_bit() as λ b => (match b {
                False => later(more, after.memory, after.io),
                True => Done(Ended(more, after.memory, after.io)),
            }) = Done(end) → after.io.past.len() <= end.io.past.len() {
            True => λ e => io_len_same(after.io, end.io, cong_fn<Ended, Io>(λ y => y.io, sym(Ran::done_inj<Ended>(Ended(more, after.memory, after.io), end, e)))),
            False => λ e => each(more, after.memory, after.io, end, e),
        })(three.proof.right))
    }
}

theorem loop_later_grows(blocks: Blocks, calls: Calls(), inner: Body, parameters: List<Typed>, exit: Nat, next: List<Typed>,
    passes: (rest: Nat) → (state: List<Value>) → (m: Heap) → (io: Io) → (l: Locals) → (after: Config) → pass_locals(parameters, state) = Some(l) →
        inner.run(blocks, calls, rest, Config(l, m, io)) = Done(after) → io.past.len() <= after.io.past.len(),
    fuel: Nat):
    (state: List<Value>) → (m: Heap) → (io: Io) → (end: Ended) →
    bytes_level::loop_later(λ (n: Nat) (pass: Config) => inner.run(blocks, calls, n, pass), parameters, exit, next, fuel, state, m, io) = Done(end) →
    io.past.len() <= end.io.past.len() {
    match fuel {
        Zero => λ state m io end never => absurd(never),
        Succ(rest) => loop_pass_grows(blocks, calls, inner, parameters, exit, next, passes, rest,
            bytes_level::loop_later(λ (n: Nat) (pass: Config) => inner.run(blocks, calls, n, pass), parameters, exit, next, rest),
            loop_later_grows(blocks, calls, inner, parameters, exit, next, passes, rest)),
    }
}

theorem loop_run_grows(blocks: Blocks, calls: Calls(), inner: Body, parameters: List<Typed>, exit: Nat, next: List<Typed>,
    passes: (rest: Nat) → (state: List<Value>) → (m: Heap) → (io: Io) → (l: Locals) → (after: Config) → pass_locals(parameters, state) = Some(l) →
        inner.run(blocks, calls, rest, Config(l, m, io)) = Done(after) → io.past.len() <= after.io.past.len(),
    fuel: Nat):
    (state: List<Value>) → (m: Heap) → (io: Io) → (end: Ended) →
    bytes_level::loop_run(λ (n: Nat) (pass: Config) => inner.run(blocks, calls, n, pass), parameters, exit, next, fuel, state, m, io) = Done(end) →
    io.past.len() <= end.io.past.len() {
    loop_pass_grows(blocks, calls, inner, parameters, exit, next, passes, fuel,
        bytes_level::loop_later(λ (n: Nat) (pass: Config) => inner.run(blocks, calls, n, pass), parameters, exit, next, fuel),
        loop_later_grows(blocks, calls, inner, parameters, exit, next, passes, fuel))
}

// A run's history only grows: each system call records one exchange, and
// nothing else changes it.
theorem Body::run_grows(self body: Body, blocks: Blocks, calls: Calls(), grows: HistoryGrows(calls), fuel: Nat): (used, used2: List<Nat>) → (c, after: Config) →
    body.fresh(used) = Some(used2) → body.run(blocks, calls, fuel, c) = Done(after) → c.io.past.len() <= after.io.past.len() {
    match body {
        Leaf(instrs) => λ used used2 c after fresh ran =>
            io_len_same(c.io, after.io, run_instrs_io(blocks, instrs, c, after, Ran::of_done<Config>(run_instrs(blocks, instrs, c), c.io, after, ran))),
        Seq(first, rest) => λ used used2 c after fresh ran => {
            let fresh_first = Option::and_then_some(first.fresh(used), λ (u: List<Nat>) => rest.fresh(u), used2, fresh);
            let ran_first = Ran::then_done<Config, Config>(first.run(blocks, calls, fuel, c), λ (mid: Config) => rest.run(blocks, calls, fuel, mid), after, ran);
            Nat::le_trans(c.io.past.len(), ran_first.witness.io.past.len(), after.io.past.len(),
                first.run_grows(blocks, calls, grows, fuel, used, fresh_first.witness, c, ran_first.witness, fresh_first.proof.left, ran_first.proof.left),
                rest.run_grows(blocks, calls, grows, fuel, fresh_first.witness, used2, ran_first.witness, after, fresh_first.proof.right, ran_first.proof.right))
        },
        Branch(condition, yes, no) => λ used used2 c after fresh ran => {
            let fresh_yes = Option::and_then_some(yes.fresh(used), λ (uy: List<Nat>) => no.fresh(used).and_then(λ (un: List<Nat>) => Some(uy ++ un)),
                used2, fresh);
            let fresh_no = Option::and_then_some(no.fresh(used), λ (un: List<Nat>) => Some(fresh_yes.witness ++ un), used2, fresh_yes.proof.right);
            (match c.locals.words(1, condition).head_bit() as λ bit =>
                (match bit { True => yes.run(blocks, calls, fuel, c), False => no.run(blocks, calls, fuel, c) }) = Done(after) →
                c.io.past.len() <= after.io.past.len() {
                True => λ r => yes.run_grows(blocks, calls, grows, fuel, used, fresh_yes.witness, c, after, fresh_yes.proof.left, r),
                False => λ r => no.run_grows(blocks, calls, grows, fuel, used, fresh_no.witness, c, after, fresh_no.proof.left, r),
            })(ran)
        },
        Call(callee, arguments, results) => λ used used2 c after fresh ran => {
            let r = call_ran(blocks, calls, fuel, callee, arguments, results, c, after, ran);
            Nat::le_trans(c.io.past.len(), r.answer.io.past.len(), after.io.past.len(), grows(callee, r.args, c.memory, c.io, r.answer, r.answered),
                io_len_same(r.answer.io, after.io, cong_fn<Config, Io>(λ y => y.io, r.lands)))
        },
        Loop(inputs, parameters, inner, exit, next, outputs) => λ used used2 c after fresh ran => {
            let r = loop_ran(blocks, calls, fuel, inputs, parameters, inner, exit, next, outputs, c, after, ran);
            let fr = loop_fresh(used, used2, inputs, parameters, inner, exit, next, outputs, fresh);
            Nat::le_trans(c.io.past.len(), r.end.io.past.len(), after.io.past.len(), loop_run_grows(blocks, calls, inner, parameters, exit, next,
                    λ rest st m io l aft _ rn => inner.run_grows(blocks, calls, grows, rest, fr.start, fr.inside, Config(l, m, io), aft, fr.body, rn),
                    fuel, r.state, c.memory, c.io, r.end, r.looped),
                io_len_same(r.end.io, after.io, cong_fn<Config, Io>(λ y => y.io, r.lands)))
        },
        Sys(call) => λ used used2 c after fresh ran => { let e = call.ran_io(blocks, c, after, ran).left; { omega } },
        Exit(_) => λ used used2 c after fresh never => absurd(never),
    }
}

// ---------------------------------------------------------------------------
// The bridge: a run is its facts at the valuation

// What a call's callee answers at the fuel the run gave it, in some world.
fn run_answers(calls: Calls()) → RoutineAnswers() { λ f args heap io a => calls(f, args, heap, io) = Done(a) }

// And those whose chain of calls, with the call into them, is within `cap`.
fn peak_answers(calls: Calls(), peaks: Peaks(), cap: Nat) → RoutineAnswers() {
    λ f args heap io a => (calls(f, args, heap, io) = Done(a)) ∧ (peaks(f, args, heap, io) + 1 <= cap)
}

theorem read_lower(id: Nat, kind: ValueKind, l: Locals, spans: Spans, values: Valuation(), x: Value): l.read(Typed(id, kind)) = Some(x) →
    Typed(id, kind).Lowers(spans, values, l) → x.lower(spans) = values(64, id) {
    match kind {
        WordKind => λ read low => j(Option::some_inj(Word(l.words(64, id)), x, read), λ y _ => y.lower(spans) = values(64, id), sym(low(64))),
        RefKind => λ read low => j(Option::some_inj(Ref(low.witness), x, j(low.proof.left, λ o _ => o.map(λ (t: Loc) => Ref(t)) = Some(x), read)),
            λ y _ => y.lower(spans) = values(64, id), sym(low.proof.right)),
    }
}

// Values read at ids of their kinds, lowered, are the valuation's words.
theorem read_values_lower(spans: Spans, values: Valuation(), l: Locals, kinds: List<Typed>, agrees: l.Agrees(spans, values, kinds), vs: List<Typed>):
    has_kinds(kinds, vs) = True → (xs: List<Value>) → read_values(vs, l) = Some(xs) → lower_values(spans, xs) = words_of(values, typed_ids(vs)) {
    match vs {
        Nil => λ _ xs read => j(Option::some_inj(Nil, xs, read), λ y _ => lower_values(spans, y) = Nil, refl),
        Cons(v, rest) => λ has xs read => {
            let parts = Bool::and_true_parts(has_kind(kinds, v.id, v.kind), has_kinds(kinds, rest), has);
            let first = Option::and_then_some(l.read(v), λ (x: Value) => read_values(rest, l).and_then(λ (ys: List<Value>) => Some(Cons(x, ys))), xs, read);
            let second = Option::and_then_some(read_values(rest, l), λ (ys: List<Value>) => Some(Cons(first.witness, ys)), xs, first.proof.right);
            let low = read_lower(v.id, v.kind, l, spans, values, first.witness, first.proof.left,
                l.agrees_at(spans, values, v.id, v.kind, kinds, parts.left, agrees));
            j(Option::some_inj(Cons(first.witness, second.witness), xs, second.proof.right),
                λ y _ => lower_values(spans, y) = words_of(values, typed_ids(Cons(v, rest))),
                trans(cong_fn<BitVec(64), List<BitVec(64)>>(λ h => Cons(h, lower_values(spans, second.witness)), low),
                    cong_fn<List<BitVec(64)>, List<BitVec(64)>>(λ t => Cons(values(64, v.id), t),
                        read_values_lower(spans, values, l, kinds, agrees, rest, parts.right, second.witness, second.proof.left))))
        },
    }
}

// Binding keeps what was had.
theorem bind_kind_keeps(kinds: List<Typed>, v: Typed, after: List<Typed>, id: Nat, kind: ValueKind, has: has_kind(kinds, id, kind) = True,
    bound: bind_kind(kinds, v) = Some(after)): has_kind(after, id, kind) = True {
    (match kind_of(kinds, v.id) as λ o => kind_of(kinds, v.id) = o →
        (match o { None => Some(Cons(v, kinds)), Some(k) => match k.same(v.kind) { True => Some(kinds), False => None } }) = Some(after) →
        has_kind(after, id, kind) = True {
        None => λ none e => j(Option::some_inj(Cons(v, kinds), after, e), λ a _ => has_kind(a, id, kind) = True,
            (match v.id.same(id) as λ b => v.id.same(id) = b →
                (match (match b { True => Some(v.kind), False => kind_of(kinds, id) }) { None => False, Some(k) => k.same(kind) }) = True {
                True => λ t => absurd(j(j(v.id.same_sound(id, t), λ x _ => kind_of(kinds, x) = None, none),
                    λ o _ => (match o { None => False, Some(k) => k.same(kind) }) = True, has)),
                False => λ _ => has,
            })(refl)),
        Some(k) => λ _ => match k.same(v.kind) {
            True => λ e => j(Option::some_inj(kinds, after, e), λ a _ => has_kind(a, id, kind) = True, has),
            False => λ never => absurd(never),
        },
    })(refl, bound)
}

theorem bind_kinds_keeps(vs: List<Typed>): (kinds, after: List<Typed>) → (id: Nat) → (kind: ValueKind) → has_kind(kinds, id, kind) = True →
    bind_kinds(kinds, vs) = Some(after) → has_kind(after, id, kind) = True {
    match vs {
        Nil => λ kinds after id kind has e => j(Option::some_inj(kinds, after, e), λ a _ => has_kind(a, id, kind) = True, has),
        Cons(v, rest) => λ kinds after id kind has e => {
            let first = Option::and_then_some(bind_kind(kinds, v), λ (k: List<Typed>) => bind_kinds(k, rest), after, e);
            bind_kinds_keeps(rest, first.witness, after, id, kind, bind_kind_keeps(kinds, v, first.witness, id, kind, has, first.proof.left),
                first.proof.right)
        },
    }
}

theorem bind_kinds_has(vs: List<Typed>): (kinds, after: List<Typed>) → bind_kinds(kinds, vs) = Some(after) → has_kinds(after, vs) = True {
    match vs {
        Nil => λ kinds after _ => refl,
        Cons(v, rest) => λ kinds after e => {
            let first = Option::and_then_some(bind_kind(kinds, v), λ (k: List<Typed>) => bind_kinds(k, rest), after, e);
            let here = bind_kinds_keeps(rest, first.witness, after, v.id, v.kind, bind_kind_has(v, kinds, first.witness, first.proof.left),
                first.proof.right);
            j(sym(here), λ b _ => (b && has_kinds(after, rest)) = True, bind_kinds_has(rest, first.witness, after, first.proof.right))
        },
    }
}

// Where a call's answer lands, from its words at the results' ids.
theorem lands_words(results: List<Typed>, spare: Nat, values: Valuation(), zero: values(64, spare) = BitVec::zero()):
    (answer_head(words_of(values, typed_ids(results))) = values(64, call_result(results, spare))) ∧
        (answer_tail(words_of(values, typed_ids(results))) = words_of(values, call_also(results))) {
    match results { Nil => ⟨sym(zero), refl⟩, Cons(_, _) => ⟨refl, refl⟩ }
}

// A call's run is its facts.
theorem call_holds_of(blocks: Blocks, calls: Calls(), fuel: Nat, sigs: Nat → Option<Signature>, spans: Spans, values: Valuation(), spare: Nat,
    zero: values(64, spare) = BitVec::zero(), peaks: Peaks(), cap: Nat, callee: Nat, arguments, results: List<Typed>, kinds, bound: List<Typed>, used, used2: List<Nat>,
    c, after: Config, checked: Body::Call(callee, arguments, results).check(sigs, kinds) = Some(bound),
    fresh: fresh_ids(used, typed_ids(results)) = Some(used2), r: CallRan(calls, callee, arguments, results, c, after),
    agrees: c.locals.Agrees(spans, values, kinds), scoped: Scoped(c.locals, used, kinds),
    shows: (id: Nat) → Mem(id, used2) → after.locals.Shows(spans, values, id),
    peaked: Body::Call(callee, arguments, results).peak(blocks, calls, peaks, fuel, c) <= cap):
    Body::Call(callee, arguments, results).Holds(spans, blocks, values, peak_answers(calls, peaks, cap), spare, Now(c.memory, c.io),
        Now(after.memory, after.io)) {
    let ok = has_kinds(kinds, arguments) && fits_signature(sigs, callee, arguments, results);
    let binds = true_some<List<Typed>>(ok, bind_kinds(kinds, results), bound, checked);
    let has_args = Bool::and_true_parts(has_kinds(kinds, arguments), fits_signature(sigs, callee, arguments, results),
        true_of_some<List<Typed>>(ok, bind_kinds(kinds, results), bound, checked)).left;
    let landed = bind_values_scopes(results, r.answer.words, c.locals, r.locals, used, used2, kinds, bound, r.bound, fresh, binds, scoped);
    let at = cong_fn<Config, Locals>(λ y => y.locals, r.lands);
    let shown = λ (id: Nat) (m: Mem(id, used2)) => j(at, λ l _ => l.Shows(spans, values, id), shows(id, m));
    let after_agrees = r.locals.agrees_of(spans, values, used2, shown, bound, landed.left.left.left);
    let words = read_values_lower(spans, values, r.locals, bound, after_agrees, results, bind_kinds_has(results, kinds, bound, binds), r.answer.words,
        landed.right);
    let lands = lands_words(results, spare, values, zero);
    let low: (peaks(callee, r.args, c.memory, c.io) + 1 <= cap) = j(r.read, λ o _ => (match o {
        None => 0,
        Some(args) => peaks(callee, args, c.memory, c.io) + 1,
    }) <= cap, peaked);
    Exists(r.args, Exists(r.answer, ⟨⟨r.answered, low⟩,
        ⟨⟨read_values_lower(spans, values, c.locals, kinds, agrees, arguments, has_args, r.args, r.read),
         ⟨⟨trans(cong_fn<List<BitVec(64)>, BitVec(64)>(λ ws => answer_head(ws), words), lands.left),
           trans(cong_fn<List<BitVec(64)>, List<BitVec(64)>>(λ ws => answer_tail(ws), words), lands.right)⟩,
          sym(cong_fn<Config, Heap>(λ y => y.memory, r.lands))⟩⟩, sym(cong_fn<Config, Io>(λ y => y.io, r.lands))⟩⟩))
}

// A pass's facts: its valuation is its final locals lowered.
theorem pass_close(blocks: Blocks, calls: Calls(), answers: RoutineAnswers(), spans: Spans, spare: Nat, parameters: List<Typed>, inner: Body, exit: Nat, next: List<Typed>,
    start, end: List<Typed>, params: bind_kinds([], parameters) = Some(start), nexts: has_kinds(end, next) = True, exits: has_kind(end, exit, WordKind) = True,
    p0, inside: List<Nat>, state: List<Value>, m: Now, l: Locals, after: Config, later: List<Value>,
    entered: Scopes(Locals::empty(), l, [], p0, start) ∧ (read_values(parameters, l) = Some(state)), scoped: Scopes(l, after.locals, p0, inside, end),
    held: inner.Holds(spans, blocks, after.locals.lower(spans), answers, spare, m, Now(after.memory, after.io)),
    read: read_values(next, after.locals) = Some(later)):
    PassFacts(λ (v: Valuation()) (from: Now) (to: Now) => inner.Holds(spans, blocks, v, answers, spare, from, to), spans, parameters, exit, next,
        state, m, after, later) {
    let v = after.locals.lower(spans);
    let shows = λ (id: Nat) (_: Mem(id, inside)) => after.locals.lower_shows(spans, id);
    let start_agrees = l.agrees_of(spans, v, p0, shows_back(l, after.locals, spans, v, p0, inside, scoped.right, shows), start, entered.left.left.left);
    let end_agrees = after.locals.agrees_of(spans, v, inside, shows, end, scoped.left.left);
    Exists(v, ⟨⟨sym(read_values_lower(spans, v, l, start, start_agrees, parameters, bind_kinds_has(parameters, [], start, params), state, entered.right)),
            held⟩,
        ⟨sym(read_values_lower(spans, v, after.locals, end, end_agrees, next, nexts, later, read)),
         cong_fn<BitVec(1), Bool>(λ x => x.head_bit(), after.locals.agrees_word(spans, v, end, exit, exits, end_agrees, 1))⟩⟩)
}

// A loop's run is its facts: the passes', by induction on the fuel, and
// its inputs and outputs the valuation's words.
theorem loop_holds_close(blocks: Blocks, calls: Calls(), fuel: Nat, sigs: Nat → Option<Signature>, spans: Spans, values: Valuation(), spare: Nat,
    peaks: Peaks(), cap: Nat,
    inputs, parameters: List<Typed>, inner: Body, exit: Nat, next, outputs: List<Typed>, kinds, bound: List<Typed>, c, after: Config,
    r: LoopRan(blocks, calls, fuel, inputs, parameters, inner, exit, next, outputs, c, after),
    ck: LoopChecked(sigs, kinds, bound, inputs, parameters, inner, exit, next, outputs),
    agrees: c.locals.Agrees(spans, values, kinds), after_agrees: after.locals.Agrees(spans, values, bound),
    outs_read: read_values(outputs, after.locals) = Some(r.end.state),
    peaked: loop_run_peak(λ (n: Nat) (pass: Config) => inner.run(blocks, calls, n, pass), λ (n: Nat) (pass: Config) => inner.peak(blocks, calls, peaks, n, pass),
        parameters, exit, next, fuel, r.state, c.memory, c.io) <= cap,
    passes: (rest: Nat) → (state: List<Value>) → (m: Heap) → (io: Io) → (l: Locals) → (aft: Config) → (later: List<Value>) →
        pass_locals(parameters, state) = Some(l) → inner.peak(blocks, calls, peaks, rest, Config(l, m, io)) <= cap →
        inner.run(blocks, calls, rest, Config(l, m, io)) = Done(aft) → read_values(next, aft.locals) = Some(later) →
        PassFacts(λ (v: Valuation()) (from: Now) (to: Now) => inner.Holds(spans, blocks, v, peak_answers(calls, peaks, cap), spare, from, to), spans, parameters, exit,
            next, state, Now(m, io), aft, later)):
    Body::Loop(inputs, parameters, inner, exit, next, outputs).Holds(spans, blocks, values, peak_answers(calls, peaks, cap), spare, Now(c.memory, c.io),
        Now(after.memory, after.io)) {
    let Pass = λ (v: Valuation()) (from: Now) (to: Now) => inner.Holds(spans, blocks, v, peak_answers(calls, peaks, cap), spare, from, to);
    let held = loop_holds_of(blocks, calls, inner, spans, Pass, parameters, exit, next, λ (n: Nat) (pass: Config) => inner.peak(blocks, calls, peaks, n, pass), cap,
        passes, fuel, r.state, c.memory, c.io, r.end, peaked, r.looped);
    let ins = read_values_lower(spans, values, c.locals, kinds, agrees, inputs, ck.inputs_had, r.state, r.read);
    let outs = read_values_lower(spans, values, after.locals, bound, after_agrees, outputs, bind_kinds_has(outputs, kinds, bound, ck.outs), r.end.state,
        outs_read);
    let heap: (Now(r.end.memory, r.end.io) = Now(after.memory, after.io)) = sym(cong_fn<Config, Now>(λ y => Now(y.memory, y.io), r.lands));
    Exists(Succ(fuel), j(heap, λ h _ => PassesHold(Pass, parameters, exit, next, Succ(fuel), words_of(values, typed_ids(inputs)), Now(c.memory, c.io),
            words_of(values, typed_ids(outputs)), h),
        j(outs, λ ws _ => PassesHold(Pass, parameters, exit, next, Succ(fuel), words_of(values, typed_ids(inputs)), Now(c.memory, c.io), ws,
            Now(r.end.memory, r.end.io)),
            j(ins, λ ws _ => PassesHold(Pass, parameters, exit, next, Succ(fuel), ws, Now(c.memory, c.io), lower_values(spans, r.end.state),
                Now(r.end.memory, r.end.io)), held))))
}

// A checked region's run, at a valuation that shows every id the scope has
// bound by its end, is its facts: the ones its code is proved under.
theorem Body::holds_of(self body: Body, blocks: Blocks, calls: Calls(), fuel: Nat, sigs: Nat → Option<Signature>, spans: Spans, values: Valuation(),
    spare: Nat, zero: values(64, spare) = BitVec::zero(), peaks: Peaks(), cap: Nat, grows: HistoryGrows(calls)): (kinds, bound: List<Typed>) → (used, used2: List<Nat>) →
    (c, after: Config) → body.check(sigs, kinds) = Some(bound) → body.fresh(used) = Some(used2) → body.run(blocks, calls, fuel, c) = Done(after) →
    body.peak(blocks, calls, peaks, fuel, c) <= cap →
    Scoped(c.locals, used, kinds) → ((id: Nat) → Mem(id, used2) → after.locals.Shows(spans, values, id)) → (Mem(spare, used2) → False) →
    body.Holds(spans, blocks, values, peak_answers(calls, peaks, cap), spare, Now(c.memory, c.io), Now(after.memory, after.io)) {
    match body {
        Leaf(instrs) => λ kinds bound used used2 c after checked fresh ran peaked scoped shows absent => {
            let ran_leaf = Ran::of_done<Config>(run_instrs(blocks, instrs, c), c.io, after, ran);
            ⟨run_instrs_holds(blocks, spans, values, instrs, kinds, bound, c, after, checked, ran_leaf,
                leaf_agrees(blocks, spans, values, instrs, kinds, bound, used, used2, c, after, checked, fresh, ran_leaf, scoped, shows)),
             run_instrs_io(blocks, instrs, c, after, ran_leaf)⟩
        },
        Seq(first, rest) => λ kinds bound used used2 c after checked fresh ran peaked scoped shows absent => {
            let checked_first = Option::and_then_some(first.check(sigs, kinds), λ (k: List<Typed>) => rest.check(sigs, k), bound, checked);
            let fresh_first = Option::and_then_some(first.fresh(used), λ (u: List<Nat>) => rest.fresh(u), used2, fresh);
            let ran_first = Ran::then_done<Config, Config>(first.run(blocks, calls, fuel, c), λ (mid: Config) => rest.run(blocks, calls, fuel, mid), after, ran);
            let mid = ran_first.witness;
            let one = first.scopes(blocks, calls, fuel, sigs, kinds, checked_first.witness, used, fresh_first.witness, c, mid, checked_first.proof.left,
                fresh_first.proof.left, ran_first.proof.left, scoped);
            let two = rest.scopes(blocks, calls, fuel, sigs, checked_first.witness, bound, fresh_first.witness, used2, mid, after, checked_first.proof.right,
                fresh_first.proof.right, ran_first.proof.right, one.left);
            let low = first.run_grows(blocks, calls, grows, fuel, used, fresh_first.witness, c, mid, fresh_first.proof.left, ran_first.proof.left);
            let high = rest.run_grows(blocks, calls, grows, fuel, fresh_first.witness, used2, mid, after, fresh_first.proof.right, ran_first.proof.right);
            Exists(Now(mid.memory, mid.io), ⟨⟨first.holds_of(blocks, calls, fuel, sigs, spans, values, spare, zero, peaks, cap, grows, kinds, checked_first.witness, used, fresh_first.witness,
                    c, mid, checked_first.proof.left, fresh_first.proof.left, ran_first.proof.left,
                    Nat::le_trans(first.peak(blocks, calls, peaks, fuel, c), Body::Seq(first, rest).peak(blocks, calls, peaks, fuel, c), cap,
                        first.peak(blocks, calls, peaks, fuel, c).le_max_l(first.run(blocks, calls, fuel, c).deeper(λ (m2: Config) =>
                            rest.peak(blocks, calls, peaks, fuel, m2))), peaked), scoped,
                    shows_back(mid.locals, after.locals, spans, values, fresh_first.witness, used2, two.right, shows),
                    λ m => absent(two.right.right(spare, m))),
                rest.holds_of(blocks, calls, fuel, sigs, spans, values, spare, zero, peaks, cap, grows, checked_first.witness, bound, fresh_first.witness, used2, mid, after,
                    checked_first.proof.right, fresh_first.proof.right, ran_first.proof.right,
                    j(ran_first.proof.left, λ x _ => x.deeper(λ (m2: Config) => rest.peak(blocks, calls, peaks, fuel, m2)) <= cap,
                        Nat::le_trans(first.run(blocks, calls, fuel, c).deeper(λ (m2: Config) => rest.peak(blocks, calls, peaks, fuel, m2)),
                            Body::Seq(first, rest).peak(blocks, calls, peaks, fuel, c), cap,
                            first.peak(blocks, calls, peaks, fuel, c).le_max_r(first.run(blocks, calls, fuel, c).deeper(λ (m2: Config) =>
                                rest.peak(blocks, calls, peaks, fuel, m2))), peaked)),
                    one.left, shows, absent)⟩, ⟨low, high⟩⟩)
        },
        Branch(condition, yes, no) => λ kinds bound used used2 c after checked fresh ran peaked scoped shows absent => {
            let inner: Option<List<Typed>> = match yes.check(sigs, kinds) {
                None => None,
                Some(after_yes) => match no.check(sigs, kinds) { None => None, Some(after_no) => Some(meet_kinds(after_yes, after_no)) },
            };
            let has = true_of_some<List<Typed>>(has_kind(kinds, condition, WordKind), inner, bound, checked);
            let checks = true_some<List<Typed>>(has_kind(kinds, condition, WordKind), inner, bound, checked);
            let checked_yes = Option::and_then_some(yes.check(sigs, kinds), λ (ay: List<Typed>) =>
                no.check(sigs, kinds).and_then(λ (an: List<Typed>) => Some(meet_kinds(ay, an))), bound, checks);
            let checked_no = Option::and_then_some(no.check(sigs, kinds), λ (an: List<Typed>) => Some(meet_kinds(checked_yes.witness, an)), bound,
                checked_yes.proof.right);
            let fresh_yes = Option::and_then_some(yes.fresh(used), λ (uy: List<Nat>) => no.fresh(used).and_then(λ (un: List<Nat>) => Some(uy ++ un)),
                used2, fresh);
            let fresh_no = Option::and_then_some(no.fresh(used), λ (un: List<Nat>) => Some(fresh_yes.witness ++ un), used2, fresh_yes.proof.right);
            let uy = fresh_yes.witness;
            let un = fresh_no.witness;
            let u: (uy ++ un = used2) = Option::some_inj(uy ++ un, used2, fresh_no.proof.right);
            let whole = Body::Branch(condition, yes, no).scopes(blocks, calls, fuel, sigs, kinds, bound, used, used2, c, after, checked, fresh, ran, scoped);
            let agrees = c.locals.agrees_of(spans, values, used, shows_back(c.locals, after.locals, spans, values, used, used2, whole.right, shows), kinds,
                scoped.left);
            let word: (values(1, condition) = c.locals.words(1, condition)) = c.locals.agrees_word(spans, values, kinds, condition, has, agrees, 1);
            let picked = λ (bit: Bool) => match bit {
                True => yes.Holds(spans, blocks, values, peak_answers(calls, peaks, cap), spare, Now(c.memory, c.io), Now(after.memory, after.io)),
                False => no.Holds(spans, blocks, values, peak_answers(calls, peaks, cap), spare, Now(c.memory, c.io), Now(after.memory, after.io)),
            };
            j(sym(cong_fn<BitVec(1), Bool>(λ x => x.head_bit(), word)), λ b _ => picked(b),
                (match c.locals.words(1, condition).head_bit() as λ bit =>
                    (match bit { True => yes.run(blocks, calls, fuel, c), False => no.run(blocks, calls, fuel, c) }) = Done(after) →
                    (match bit { True => yes.peak(blocks, calls, peaks, fuel, c), False => no.peak(blocks, calls, peaks, fuel, c) }) <= cap → picked(bit) {
                    True => λ r low => yes.holds_of(blocks, calls, fuel, sigs, spans, values, spare, zero, peaks, cap, grows, kinds, checked_yes.witness, used, uy, c, after,
                        checked_yes.proof.left, fresh_yes.proof.left, r, low, scoped, λ id m => shows(id, j(u, λ x _ => Mem(id, x), uy.mem_append_l(un, id, m))),
                        λ m => absent(j(u, λ x _ => Mem(spare, x), uy.mem_append_l(un, spare, m)))),
                    False => λ r low => no.holds_of(blocks, calls, fuel, sigs, spans, values, spare, zero, peaks, cap, grows, kinds, checked_no.witness, used, un, c, after,
                        checked_no.proof.left, fresh_no.proof.left, r, low, scoped, λ id m => shows(id, j(u, λ x _ => Mem(id, x), uy.mem_append_r(un, id, m))),
                        λ m => absent(j(u, λ x _ => Mem(spare, x), uy.mem_append_r(un, spare, m)))),
                })(ran, peaked))
        },
        Call(callee, arguments, results) => λ kinds bound used used2 c after checked fresh ran peaked scoped shows absent => {
            let whole = Body::Call(callee, arguments, results).scopes(blocks, calls, fuel, sigs, kinds, bound, used, used2, c, after, checked, fresh, ran,
                scoped);
            call_holds_of(blocks, calls, fuel, sigs, spans, values, spare, zero, peaks, cap, callee, arguments, results, kinds, bound, used, used2, c, after, checked, fresh,
                call_ran(blocks, calls, fuel, callee, arguments, results, c, after, ran),
                c.locals.agrees_of(spans, values, used, shows_back(c.locals, after.locals, spans, values, used, used2, whole.right, shows), kinds, scoped.left),
                scoped, shows, peaked)
        },
        Loop(inputs, parameters, inner, exit, next, outputs) => λ kinds bound used used2 c after checked fresh ran peaked scoped shows absent => {
            let r = loop_ran(blocks, calls, fuel, inputs, parameters, inner, exit, next, outputs, c, after, ran);
            let ck = loop_checked(sigs, kinds, bound, inputs, parameters, inner, exit, next, outputs, checked);
            let fr = loop_fresh(used, used2, inputs, parameters, inner, exit, next, outputs, fresh);
            let landed = loop_scopes(c, after, used, used2, kinds, bound, outputs, fr.inside, r.end.state, r.locals, r.bound, fr.outs, ck.outs, scoped,
                cong_fn<Config, Locals>(λ y => y.locals, r.lands));
            let absent_inside = λ (m: Mem(spare, fr.inside)) => absent(landed.right(spare, m));
            loop_holds_close(blocks, calls, fuel, sigs, spans, values, spare, peaks, cap, inputs, parameters, inner, exit, next, outputs, kinds, bound, c, after, r, ck,
                c.locals.agrees_of(spans, values, used, shows_back(c.locals, after.locals, spans, values, used, used2, landed.left.left.right, shows), kinds,
                    scoped.left),
                after.locals.agrees_of(spans, values, used2, shows, bound, landed.left.left.left.left), landed.left.right,
                j(r.read, λ o _ => (match o {
                    None => 0,
                    Some(state) => loop_run_peak(λ (n: Nat) (pass: Config) => inner.run(blocks, calls, n, pass),
                        λ (n: Nat) (pass: Config) => inner.peak(blocks, calls, peaks, n, pass), parameters, exit, next, fuel, state, c.memory, c.io),
                }) <= cap, peaked),
                λ rest st m io l aft later bound_l peaked_inner ran_inner read_next => {
                    let entered = bind_values_scopes(parameters, st, Locals::empty(), l, [], fr.start, [], ck.start, bound_l, fr.params, ck.params,
                        empty_scoped());
                    let c0 = Config(l, m, io);
                    let inside = inner.scopes(blocks, calls, rest, sigs, ck.start, ck.end, fr.start, fr.inside, c0, aft, ck.body, fr.body, ran_inner,
                        entered.left.left);
                    let zero = spare_zero(l, aft.locals, spans, fr.start, fr.inside, spare, absent_inside, entered.left.right, inside.right);
                    pass_close(blocks, calls, peak_answers(calls, peaks, cap), spans, spare, parameters, inner, exit, next, ck.start, ck.end, ck.params, ck.nexts, ck.exits, fr.start, fr.inside,
                        st, Now(m, io), l, aft, later, entered, inside,
                        inner.holds_of(blocks, calls, rest, sigs, spans, aft.locals.lower(spans), spare, zero, peaks, cap, grows, ck.start, ck.end, fr.start, fr.inside, c0, aft,
                            ck.body, fr.body, ran_inner, peaked_inner, entered.left.left, λ id _ => aft.locals.lower_shows(spans, id), absent_inside),
                        read_next)
                })
        },
        Sys(call) => λ kinds bound used used2 c after checked fresh ran peaked scoped shows absent => {
            let whole = Body::Sys(call).scopes(blocks, calls, fuel, sigs, kinds, bound, used, used2, c, after, checked, fresh, ran, scoped);
            call.lands_of(blocks, spans, values, kinds, bound, c, after, checked, ran,
                c.locals.agrees_of(spans, values, used, shows_back(c.locals, after.locals, spans, values, used, used2, whole.right, shows), kinds, scoped.left),
                after.locals.agrees_of(spans, values, used2, shows, bound, whole.left.left))
        },
        Exit(_) => λ kinds bound used used2 c after checked fresh never => absurd(never),
    }
}

// ---------------------------------------------------------------------------
// A run still going (docs/language/ownership-design.md §17.7)
//
// Going has no final locals, so the valuation is the locals where the run
// went on: a call or a loop binds nothing before it goes on, so there it is
// the locals the node was reached with, lowered; a sequence's is its rest's
// where its first part was done, at which that part's facts hold by
// `holds_of`; a loop's passes each have their own, as done passes do.

theorem Ran::of_going<T>(o: Option<T>, io, w: Io): Ran::of(o, io) = Going(w) → False {
    match o { None => λ h => absurd(h), Some(_) => λ h => absurd(h) }
}

theorem Ran::then_going<T, U>(r: Ran<T>, k: T → Ran<U>, w: Io): r.then(k) = Going(w) → (r = Going(w)) ∨ Exists<T>(λ a => (r = Done(a)) ∧ (k(a) = Going(w))) {
    match r {
        Done(a) => λ h => Inr(Exists(a, ⟨refl, h⟩)),
        Exited(_, _) => λ h => absurd(h),
        Going(o2) => λ h => {
            let eo = cong_fn<Ran<U>, Io>(λ x => match x { Done(_) => o2, Exited(_, _) => o2, Going(v) => v, Stuck(_) => o2 }, h);
            Inl(j(eo, λ v _ => Going<T>(o2) = Going<T>(v), refl))
        },
        Stuck(_) => λ h => absurd(h),
    }
}

// The routines that are still going, where the chain of calls with the
// call into them is within `cap`.
fn peak_stops(x: Stop, calls: Calls(), peaks: Peaks(), cap: Nat) → RoutineStops() {
    λ f args heap io => (calls(f, args, heap, io).stopped() = Some(x)) ∧ (peaks(f, args, heap, io) + 1 <= cap)
}

// A scope only grows.
theorem fresh_id_grows(used: List<Nat>, id: Nat, more: List<Nat>, e: fresh_id(used, id) = Some(more)): (x: Nat) → Mem(x, used) → Mem(x, more) {
    (match listed(used, id) as λ b => (match b { True => None, False => Some(Cons(id, used)) }) = Some(more) → (x: Nat) → Mem(x, used) → Mem(x, more) {
        True => λ never => absurd(never),
        False => λ found x m => j(Option::some_inj(Cons(id, used), more, found), λ l _ => Mem(x, l), Inr(m)),
    })(e)
}

theorem fresh_ids_grows(ids: List<Nat>): (used, more: List<Nat>) → fresh_ids(used, ids) = Some(more) → (x: Nat) → Mem(x, used) → Mem(x, more) {
    match ids {
        Nil => λ used more e x m => j(Option::some_inj(used, more, e), λ l _ => Mem(x, l), m),
        Cons(id, rest) => λ used more e x m => {
            let one = Option::and_then_some(fresh_id(used, id), λ (u: List<Nat>) => fresh_ids(u, rest), more, e);
            fresh_ids_grows(rest, one.witness, more, one.proof.right, x, fresh_id_grows(used, id, one.witness, one.proof.left, x, m))
        },
    }
}

theorem fresh_bind_grows(used: List<Nat>, b: Option<Typed>, more: List<Nat>, e: fresh_bind(used, b) = Some(more)): (x: Nat) → Mem(x, used) → Mem(x, more) {
    (match b as λ o => fresh_bind(used, o) = Some(more) → (x: Nat) → Mem(x, used) → Mem(x, more) {
        None => λ found x m => j(Option::some_inj(used, more, found), λ l _ => Mem(x, l), m),
        Some(v) => λ found => fresh_id_grows(used, v.id, more, found),
    })(e)
}

theorem fresh_instrs_grows(instrs: List<Instr>): (used, more: List<Nat>) → fresh_instrs(instrs, used) = Some(more) → (x: Nat) → Mem(x, used) → Mem(x, more) {
    match instrs {
        Nil => λ used more e x m => j(Option::some_inj(used, more, e), λ l _ => Mem(x, l), m),
        Cons(instr, rest) => λ used more e x m => {
            let one = Option::and_then_some(fresh_bind(used, instr.binds()), λ (u: List<Nat>) => fresh_instrs(rest, u), more, e);
            fresh_instrs_grows(rest, one.witness, more, one.proof.right, x, fresh_bind_grows(used, instr.binds(), one.witness, one.proof.left, x, m))
        },
    }
}

theorem Body::fresh_grows(self body: Body): (used, used2: List<Nat>) → body.fresh(used) = Some(used2) → (x: Nat) → Mem(x, used) → Mem(x, used2) {
    match body {
        Leaf(instrs) => λ used used2 e => fresh_instrs_grows(instrs, used, used2, e),
        Seq(first, rest) => λ used used2 e x m => {
            let one = Option::and_then_some(first.fresh(used), λ (u: List<Nat>) => rest.fresh(u), used2, e);
            rest.fresh_grows(one.witness, used2, one.proof.right, x, first.fresh_grows(used, one.witness, one.proof.left, x, m))
        },
        Branch(_, yes, no) => λ used used2 e x m => {
            let fy = Option::and_then_some(yes.fresh(used), λ (uy: List<Nat>) => no.fresh(used).and_then(λ (un: List<Nat>) => Some(uy ++ un)), used2, e);
            let fn_ = Option::and_then_some(no.fresh(used), λ (un: List<Nat>) => Some(fy.witness ++ un), used2, fy.proof.right);
            j(Option::some_inj(fy.witness ++ fn_.witness, used2, fn_.proof.right), λ l _ => Mem(x, l),
                fy.witness.mem_append_l(fn_.witness, x, yes.fresh_grows(used, fy.witness, fy.proof.left, x, m)))
        },
        Call(_, _, results) => λ used used2 e => fresh_ids_grows(typed_ids(results), used, used2, e),
        Loop(_, parameters, inner, _, _, outputs) => λ used used2 e x m => {
            let start = Option::and_then_some(fresh_ids([], typed_ids(parameters)), λ (st: List<Nat>) =>
                inner.fresh(st).and_then(λ (inside: List<Nat>) => fresh_ids(used ++ inside, typed_ids(outputs))), used2, e);
            let inside = Option::and_then_some(inner.fresh(start.witness), λ (ins: List<Nat>) => fresh_ids(used ++ ins, typed_ids(outputs)), used2,
                start.proof.right);
            fresh_ids_grows(typed_ids(outputs), used ++ inside.witness, used2, inside.proof.right, x, used.mem_append_l(inside.witness, x, m))
        },
        Sys(call) => λ used used2 e => fresh_id_grows(used, call.result(), used2, e),
        Exit(_) => λ used used2 e x m => j(Option::some_inj(used, used2, e), λ l _ => Mem(x, l), m),
    }
}

// What a going pass gives: its valuation, at which its parameters are the
// state's words and its body's going facts hold.
fn PassStopFacts(PassStops: Valuation() → Nat → Now → Type, spans: Spans, parameters: List<Typed>, state: List<Value>, fuel: Nat, from: Now) → Type {
    Exists<Valuation()>(λ v => (words_of(v, typed_ids(parameters)) = lower_values(spans, state)) ∧ PassStops(v, fuel, from))
}

fn PassesStopFacts(x: Stop, blocks: Blocks, calls: Calls(), inner: Body, spans: Spans, PassStops: Valuation() → Nat → Now → Type, parameters: List<Typed>,
    peak: Nat → Config → Nat, cap: Nat) → Type {
    (rest: Nat) → (state: List<Value>) → (m: Heap) → (io: Io) → (l: Locals) →
        pass_locals(parameters, state) = Some(l) → peak(rest, Config(l, m, io)) <= cap → inner.run(blocks, calls, rest, Config(l, m, io)).stopped() = Some(x) →
        PassStopFacts(PassStops, spans, parameters, state, rest, Now(m, io))
}

// A pass, then `later`, still going: the pass itself, or done and `later`.
theorem loop_pass_stops(x: Stop, blocks: Blocks, calls: Calls(), inner: Body, spans: Spans, Pass: Valuation() → Now → Now → Type,
    PassStops: Valuation() → Nat → Now → Type, parameters: List<Typed>, exit: Nat, next: List<Typed>, peak: Nat → Config → Nat, cap: Nat,
    passes: PassesFacts(blocks, calls, inner, spans, Pass, parameters, exit, next, peak, cap),
    goes: PassesStopFacts(x, blocks, calls, inner, spans, PassStops, parameters, peak, cap), fuel: Nat,
    later: List<Value> → Heap → Io → Ran<Ended>, later_peak: List<Value> → Heap → Io → Nat, Later: List<BitVec(64)> → Now → Type,
    ih: (state: List<Value>) → (m: Heap) → (io: Io) → later_peak(state, m, io) <= cap → later(state, m, io).stopped() = Some(x) →
        Later(lower_values(spans, state), Now(m, io))):
    (state: List<Value>) → (m: Heap) → (io: Io) →
    loop_pass_peak(λ (k: Nat) (pass: Config) => inner.run(blocks, calls, k, pass), peak, parameters, exit, next, fuel, later_peak, state, m, io) <= cap →
    loop_pass(λ (k: Nat) (pass: Config) => inner.run(blocks, calls, k, pass), parameters, exit, next, fuel, later, state, m, io).stopped() = Some(x) →
    PassStop(Pass, PassStops, parameters, exit, next, fuel, Later, lower_values(spans, state), Now(m, io)) {
    λ state m io peaked ran => {
        let after_pass = λ (after: Config) => Ran::of(read_values(next, after.locals), after.io).then(λ (more: List<Value>) =>
            match after.locals.words(1, exit).head_bit() {
                False => later(more, after.memory, after.io),
                True => Done(Ended(more, after.memory, after.io)),
            });
        let after_peak = λ (after: Config) => match read_values(next, after.locals) {
            None => 0,
            Some(more) => match after.locals.words(1, exit).head_bit() { False => later_peak(more, after.memory, after.io), True => 0 },
        };
        match Ran::then_stopped<Locals, Ended>(Ran::of(pass_locals(parameters, state), io), λ (l: Locals) =>
            inner.run(blocks, calls, fuel, Config(l, m, io)).then(after_pass), x, ran) {
            Inl(bad) => false_elim(Ran::of_stopped<Locals>(pass_locals(parameters, state), io, x, bad)),
            Inr(one) => {
                let l = one.witness;
                let bound_l = Ran::of_done<Locals>(pass_locals(parameters, state), io, l, one.proof.left);
                let at_l: (peak(fuel, Config(l, m, io)).max(inner.run(blocks, calls, fuel, Config(l, m, io)).deeper(after_peak)) <= cap) =
                    j(bound_l, λ x _ => (match x {
                        None => 0,
                        Some(l2) => peak(fuel, Config(l2, m, io)).max(inner.run(blocks, calls, fuel, Config(l2, m, io)).deeper(after_peak)),
                    }) <= cap, peaked);
                let pass_peak: (peak(fuel, Config(l, m, io)) <= cap) =
                    Nat::le_trans(peak(fuel, Config(l, m, io)), peak(fuel, Config(l, m, io)).max(inner.run(blocks, calls, fuel, Config(l, m, io)).deeper(after_peak)),
                        cap, peak(fuel, Config(l, m, io)).le_max_l(inner.run(blocks, calls, fuel, Config(l, m, io)).deeper(after_peak)), at_l);
                match Ran::then_stopped<Config, Ended>(inner.run(blocks, calls, fuel, Config(l, m, io)), after_pass, x, one.proof.right) {
                    Inl(going) => {
                        let facts = goes(fuel, state, m, io, l, bound_l, pass_peak, going);
                        Exists(facts.witness, ⟨facts.proof.left, Inl(facts.proof.right)⟩)
                    },
                    Inr(two) => {
                        let after = two.witness;
                        let rest_peak: (inner.run(blocks, calls, fuel, Config(l, m, io)).deeper(after_peak) <= cap) =
                            Nat::le_trans(inner.run(blocks, calls, fuel, Config(l, m, io)).deeper(after_peak),
                                peak(fuel, Config(l, m, io)).max(inner.run(blocks, calls, fuel, Config(l, m, io)).deeper(after_peak)),
                                cap, peak(fuel, Config(l, m, io)).le_max_r(inner.run(blocks, calls, fuel, Config(l, m, io)).deeper(after_peak)), at_l);
                        let after_peaked: (after_peak(after) <= cap) = j(two.proof.left, λ x _ => x.deeper(after_peak) <= cap, rest_peak);
                        match Ran::then_stopped<List<Value>, Ended>(Ran::of(read_values(next, after.locals), after.io), λ (more: List<Value>) =>
                            match after.locals.words(1, exit).head_bit() {
                                False => later(more, after.memory, after.io),
                                True => Done(Ended(more, after.memory, after.io)),
                            }, x, two.proof.right) {
                            Inl(bad) => false_elim(Ran::of_stopped<List<Value>>(read_values(next, after.locals), after.io, x, bad)),
                            Inr(three) => {
                                let more = three.witness;
                                let read_more = Ran::of_done<List<Value>>(read_values(next, after.locals), after.io, more, three.proof.left);
                                let later_peaked: ((match after.locals.words(1, exit).head_bit() { False => later_peak(more, after.memory, after.io), True => 0 })
                                        <= cap) =
                                    j(read_more, λ x _ => (match x {
                                        None => 0,
                                        Some(more2) => match after.locals.words(1, exit).head_bit() { False => later_peak(more2, after.memory, after.io), True => 0 },
                                    }) <= cap, after_peaked);
                                let facts = passes(fuel, state, m, io, l, after, more, bound_l, pass_peak, two.proof.left, read_more);
                                let v = facts.witness;
                                let bit: (v(1, exit).head_bit() = after.locals.words(1, exit).head_bit()) = facts.proof.right.right;
                                let rest = (match after.locals.words(1, exit).head_bit() as λ b =>
                                    (match b { False => later_peak(more, after.memory, after.io), True => 0 }) <= cap →
                                    (match b { False => later(more, after.memory, after.io), True => Done(Ended(more, after.memory, after.io)) }).stopped() = Some(x) →
                                    (b = False) ∧ Later(lower_values(spans, more), Now(after.memory, after.io)) {
                                    False => λ low e => ⟨refl, ih(more, after.memory, after.io, low, e)⟩,
                                    True => λ _ never => absurd(never),
                                })(later_peaked, three.proof.right);
                                Exists(v, ⟨facts.proof.left.left, Inr(Exists(Now(after.memory, after.io), ⟨facts.proof.left.right, ⟨trans(bit, rest.left),
                                    j(sym(facts.proof.right.left), λ ws _ => Later(ws, Now(after.memory, after.io)), rest.right)⟩⟩))⟩)
                            },
                        }
                    },
                }
            },
        }
    }
}

theorem loop_later_stops(x: Stop, blocks: Blocks, calls: Calls(), inner: Body, spans: Spans, Pass: Valuation() → Now → Now → Type,
    PassStops: Valuation() → Nat → Now → Type, parameters: List<Typed>, exit: Nat, next: List<Typed>, peak: Nat → Config → Nat, cap: Nat,
    passes: PassesFacts(blocks, calls, inner, spans, Pass, parameters, exit, next, peak, cap),
    goes: PassesStopFacts(x, blocks, calls, inner, spans, PassStops, parameters, peak, cap), fuel: Nat):
    (state: List<Value>) → (m: Heap) → (io: Io) →
    loop_later_peak(λ (n: Nat) (pass: Config) => inner.run(blocks, calls, n, pass), peak, parameters, exit, next, fuel, state, m, io) <= cap →
    loop_later(λ (n: Nat) (pass: Config) => inner.run(blocks, calls, n, pass), parameters, exit, next, fuel, state, m, io).stopped() = Some(x) →
    LaterStop(Pass, PassStops, parameters, exit, next, x.ZeroAt(), fuel, lower_values(spans, state), Now(m, io)) {
    match fuel {
        Zero => λ state m io _ e => x.zero_of(io, e),
        Succ(rest) => loop_pass_stops(x, blocks, calls, inner, spans, Pass, PassStops, parameters, exit, next, peak, cap, passes, goes, rest,
            loop_later(λ (n: Nat) (pass: Config) => inner.run(blocks, calls, n, pass), parameters, exit, next, rest),
            loop_later_peak(λ (n: Nat) (pass: Config) => inner.run(blocks, calls, n, pass), peak, parameters, exit, next, rest),
            LaterStop(Pass, PassStops, parameters, exit, next, x.ZeroAt(), rest),
            loop_later_stops(x, blocks, calls, inner, spans, Pass, PassStops, parameters, exit, next, peak, cap, passes, goes, rest)),
    }
}

theorem loop_run_stops(x: Stop, blocks: Blocks, calls: Calls(), inner: Body, spans: Spans, Pass: Valuation() → Now → Now → Type,
    PassStops: Valuation() → Nat → Now → Type, parameters: List<Typed>, exit: Nat, next: List<Typed>, peak: Nat → Config → Nat, cap: Nat,
    passes: PassesFacts(blocks, calls, inner, spans, Pass, parameters, exit, next, peak, cap),
    goes: PassesStopFacts(x, blocks, calls, inner, spans, PassStops, parameters, peak, cap), fuel: Nat):
    (state: List<Value>) → (m: Heap) → (io: Io) →
    loop_run_peak(λ (n: Nat) (pass: Config) => inner.run(blocks, calls, n, pass), peak, parameters, exit, next, fuel, state, m, io) <= cap →
    loop_run(λ (n: Nat) (pass: Config) => inner.run(blocks, calls, n, pass), parameters, exit, next, fuel, state, m, io).stopped() = Some(x) →
    PassesStop(Pass, PassStops, parameters, exit, next, x.ZeroAt(), fuel, lower_values(spans, state), Now(m, io)) {
    loop_pass_stops(x, blocks, calls, inner, spans, Pass, PassStops, parameters, exit, next, peak, cap, passes, goes, fuel,
        loop_later(λ (n: Nat) (pass: Config) => inner.run(blocks, calls, n, pass), parameters, exit, next, fuel),
        loop_later_peak(λ (n: Nat) (pass: Config) => inner.run(blocks, calls, n, pass), peak, parameters, exit, next, fuel),
        LaterStop(Pass, PassStops, parameters, exit, next, x.ZeroAt(), fuel),
        loop_later_stops(x, blocks, calls, inner, spans, Pass, PassStops, parameters, exit, next, peak, cap, passes, goes, fuel))
}

// Where a call or a loop goes on, the valuation is the locals it was
// reached with, lowered: it shows them, and an id the scope never binds is
// zero in it.
theorem here_valuation(c: Config, spans: Spans, used, used2: List<Nat>, spare: Nat, blank: Frames(Locals::empty(), c.locals, [], used),
    grows: (x: Nat) → Mem(x, used) → Mem(x, used2), absent: Mem(spare, used2) → False):
    ((id: Nat) → Mem(id, used) → c.locals.Shows(spans, c.locals.lower(spans), id)) ∧ (c.locals.lower(spans)(64, spare) = BitVec::zero()) {
    ⟨λ id _ => c.locals.lower_shows(spans, id),
     spare_zero(c.locals, c.locals, spans, used, used, spare, λ m => absent(grows(spare, m)), blank, frames_refl(c.locals, used))⟩
}

// A checked region's run still going is its going facts, at a valuation
// that shows the ids bound before the region and the locals where it went
// on.
theorem Body::stops_of(self body: Body, blocks: Blocks, calls: Calls(), fuel: Nat, sigs: Nat → Option<Signature>, spans: Spans, spare: Nat,
    peaks: Peaks(), cap: Nat, grows: HistoryGrows(calls)): (kinds, bound: List<Typed>) → (used, used2: List<Nat>) → (c: Config) → (x: Stop) →
    body.check(sigs, kinds) = Some(bound) → body.fresh(used) = Some(used2) → body.run(blocks, calls, fuel, c).stopped() = Some(x) →
    body.peak(blocks, calls, peaks, fuel, c) <= cap → Scoped(c.locals, used, kinds) → Frames(Locals::empty(), c.locals, [], used) →
    (Mem(spare, used2) → False) →
    Exists<Valuation()>(λ v => ((id: Nat) → Mem(id, used) → c.locals.Shows(spans, v, id)) ∧ ((v(64, spare) = BitVec::zero()) ∧
        body.Stops(spans, blocks, v, peak_answers(calls, peaks, cap), peak_stops(x, calls, peaks, cap), x, spare, fuel, Now(c.memory, c.io)))) {
    match body {
        Leaf(instrs) => λ kinds bound used used2 c x checked fresh ran peaked scoped blank absent =>
            false_elim(Ran::of_stopped<Config>(run_instrs(blocks, instrs, c), c.io, x, ran)),
        Seq(first, rest) => λ kinds bound used used2 c x checked fresh ran peaked scoped blank absent => {
            let ck = Option::and_then_some(first.check(sigs, kinds), λ (k: List<Typed>) => rest.check(sigs, k), bound, checked);
            let fr = Option::and_then_some(first.fresh(used), λ (u: List<Nat>) => rest.fresh(u), used2, fresh);
            let tail = λ (m2: Config) => rest.peak(blocks, calls, peaks, fuel, m2);
            let peaked_first: (first.peak(blocks, calls, peaks, fuel, c) <= cap) =
                Nat::le_trans(first.peak(blocks, calls, peaks, fuel, c), Body::Seq(first, rest).peak(blocks, calls, peaks, fuel, c), cap,
                    first.peak(blocks, calls, peaks, fuel, c).le_max_l(first.run(blocks, calls, fuel, c).deeper(tail)), peaked);
            let absent_first = λ (m: Mem(spare, fr.witness)) => absent(rest.fresh_grows(fr.witness, used2, fr.proof.right, spare, m));
            match Ran::then_stopped<Config, Config>(first.run(blocks, calls, fuel, c), λ (mid: Config) => rest.run(blocks, calls, fuel, mid), x, ran) {
                Inl(going) => {
                    let got = first.stops_of(blocks, calls, fuel, sigs, spans, spare, peaks, cap, grows, kinds, ck.witness, used, fr.witness, c, x, ck.proof.left,
                        fr.proof.left, going, peaked_first, scoped, blank, absent_first);
                    Exists(got.witness, ⟨got.proof.left, ⟨got.proof.right.left, Inl(got.proof.right.right)⟩⟩)
                },
                Inr(one) => {
                    let mid = one.witness;
                    let sc = first.scopes(blocks, calls, fuel, sigs, kinds, ck.witness, used, fr.witness, c, mid, ck.proof.left, fr.proof.left, one.proof.left,
                        scoped);
                    let peaked_rest: (rest.peak(blocks, calls, peaks, fuel, mid) <= cap) = j(one.proof.left, λ x _ => x.deeper(tail) <= cap,
                        Nat::le_trans(first.run(blocks, calls, fuel, c).deeper(tail), Body::Seq(first, rest).peak(blocks, calls, peaks, fuel, c), cap,
                            first.peak(blocks, calls, peaks, fuel, c).le_max_r(first.run(blocks, calls, fuel, c).deeper(tail)), peaked));
                    let got = rest.stops_of(blocks, calls, fuel, sigs, spans, spare, peaks, cap, grows, ck.witness, bound, fr.witness, used2, mid, x, ck.proof.right,
                        fr.proof.right, one.proof.right, peaked_rest, sc.left, frames_trans(Locals::empty(), c.locals, mid.locals, [], used, fr.witness, blank,
                            sc.right), absent);
                    let v = got.witness;
                    let held = first.holds_of(blocks, calls, fuel, sigs, spans, v, spare, got.proof.right.left, peaks, cap, grows, kinds, ck.witness, used, fr.witness,
                        c, mid, ck.proof.left, fr.proof.left, one.proof.left, peaked_first, scoped, got.proof.left, absent_first);
                    Exists(v, ⟨shows_back(c.locals, mid.locals, spans, v, used, fr.witness, sc.right, got.proof.left),
                        ⟨got.proof.right.left, Inr(Exists(Now(mid.memory, mid.io), ⟨held, got.proof.right.right⟩))⟩⟩)
                },
            }
        },
        Branch(condition, yes, no) => λ kinds bound used used2 c x checked fresh ran peaked scoped blank absent => {
            let inner: Option<List<Typed>> = match yes.check(sigs, kinds) {
                None => None,
                Some(after_yes) => match no.check(sigs, kinds) { None => None, Some(after_no) => Some(meet_kinds(after_yes, after_no)) },
            };
            let has = true_of_some<List<Typed>>(has_kind(kinds, condition, WordKind), inner, bound, checked);
            let checks = true_some<List<Typed>>(has_kind(kinds, condition, WordKind), inner, bound, checked);
            let checked_yes = Option::and_then_some(yes.check(sigs, kinds), λ (ay: List<Typed>) =>
                no.check(sigs, kinds).and_then(λ (an: List<Typed>) => Some(meet_kinds(ay, an))), bound, checks);
            let checked_no = Option::and_then_some(no.check(sigs, kinds), λ (an: List<Typed>) => Some(meet_kinds(checked_yes.witness, an)), bound,
                checked_yes.proof.right);
            let fresh_yes = Option::and_then_some(yes.fresh(used), λ (uy: List<Nat>) => no.fresh(used).and_then(λ (un: List<Nat>) => Some(uy ++ un)),
                used2, fresh);
            let fresh_no = Option::and_then_some(no.fresh(used), λ (un: List<Nat>) => Some(fresh_yes.witness ++ un), used2, fresh_yes.proof.right);
            let uy = fresh_yes.witness;
            let un = fresh_no.witness;
            let u: (uy ++ un = used2) = Option::some_inj(uy ++ un, used2, fresh_no.proof.right);
            let picked = λ (v: Valuation()) (b: Bool) => match b {
                True => yes.Stops(spans, blocks, v, peak_answers(calls, peaks, cap), peak_stops(x, calls, peaks, cap), x, spare, fuel, Now(c.memory, c.io)),
                False => no.Stops(spans, blocks, v, peak_answers(calls, peaks, cap), peak_stops(x, calls, peaks, cap), x, spare, fuel, Now(c.memory, c.io)),
            };
            let word = λ (v: Valuation()) (shows: (id: Nat) → Mem(id, used) → c.locals.Shows(spans, v, id)) =>
                cong_fn<BitVec(1), Bool>(λ x => x.head_bit(), c.locals.agrees_word(spans, v, kinds, condition, has, c.locals.agrees_of(spans, v, used, shows, kinds,
                    scoped.left), 1));
            (match c.locals.words(1, condition).head_bit() as λ bit => c.locals.words(1, condition).head_bit() = bit →
                (match bit { True => yes.run(blocks, calls, fuel, c), False => no.run(blocks, calls, fuel, c) }).stopped() = Some(x) →
                (match bit { True => yes.peak(blocks, calls, peaks, fuel, c), False => no.peak(blocks, calls, peaks, fuel, c) }) <= cap →
                Exists<Valuation()>(λ v => ((id: Nat) → Mem(id, used) → c.locals.Shows(spans, v, id)) ∧ ((v(64, spare) = BitVec::zero()) ∧
                    Body::Branch(condition, yes, no).Stops(spans, blocks, v, peak_answers(calls, peaks, cap), peak_stops(x, calls, peaks, cap), x, spare, fuel,
                        Now(c.memory, c.io)))) {
                True => λ e r low => {
                    let got = yes.stops_of(blocks, calls, fuel, sigs, spans, spare, peaks, cap, grows, kinds, checked_yes.witness, used, uy, c, x, checked_yes.proof.left,
                        fresh_yes.proof.left, r, low, scoped, blank, λ m => absent(j(u, λ x _ => Mem(spare, x), uy.mem_append_l(un, spare, m))));
                    let v = got.witness;
                    Exists(v, ⟨got.proof.left, ⟨got.proof.right.left, j(sym(trans(word(v, got.proof.left), e)), λ b _ => picked(v, b), got.proof.right.right)⟩⟩)
                },
                False => λ e r low => {
                    let got = no.stops_of(blocks, calls, fuel, sigs, spans, spare, peaks, cap, grows, kinds, checked_no.witness, used, un, c, x, checked_no.proof.left,
                        fresh_no.proof.left, r, low, scoped, blank, λ m => absent(j(u, λ x _ => Mem(spare, x), uy.mem_append_r(un, spare, m))));
                    let v = got.witness;
                    Exists(v, ⟨got.proof.left, ⟨got.proof.right.left, j(sym(trans(word(v, got.proof.left), e)), λ b _ => picked(v, b), got.proof.right.right)⟩⟩)
                },
            })(refl, ran, peaked)
        },
        Call(callee, arguments, results) => λ kinds bound used used2 c x checked fresh ran peaked scoped blank absent => {
            let rest_k = λ (args: List<Value>) => calls(callee, args, c.memory, c.io).then(λ (answer: Answer) =>
                Ran::of(bind_values(results, answer.words, c.locals), answer.io).then(λ (l: Locals) => Done(Config(l, answer.heap, answer.io))));
            match Ran::then_stopped<List<Value>, Config>(Ran::of(read_values(arguments, c.locals), c.io), rest_k, x, ran) {
                Inl(bad) => false_elim(Ran::of_stopped<List<Value>>(read_values(arguments, c.locals), c.io, x, bad)),
                Inr(one) => {
                    let args = one.witness;
                    let read = Ran::of_done<List<Value>>(read_values(arguments, c.locals), c.io, args, one.proof.left);
                    match Ran::then_stopped<Answer, Config>(calls(callee, args, c.memory, c.io), λ (answer: Answer) =>
                        Ran::of(bind_values(results, answer.words, c.locals), answer.io).then(λ (l: Locals) => Done(Config(l, answer.heap, answer.io))), x,
                        one.proof.right) {
                        Inl(going) => {
                            let here = here_valuation(c, spans, used, used2, spare, blank, fresh_ids_grows(typed_ids(results), used, used2, fresh), absent);
                            let v = c.locals.lower(spans);
                            let ok = has_kinds(kinds, arguments) && fits_signature(sigs, callee, arguments, results);
                            let has_args = Bool::and_true_parts(has_kinds(kinds, arguments), fits_signature(sigs, callee, arguments, results),
                                true_of_some<List<Typed>>(ok, bind_kinds(kinds, results), bound, checked)).left;
                            let agrees = c.locals.agrees_of(spans, v, used, here.left, kinds, scoped.left);
                            let low: (peaks(callee, args, c.memory, c.io) + 1 <= cap) = j(read, λ x _ => (match x {
                                None => 0,
                                Some(a2) => peaks(callee, a2, c.memory, c.io) + 1,
                            }) <= cap, peaked);
                            Exists(v, ⟨here.left, ⟨here.right, Exists(args, ⟨read_values_lower(spans, v, c.locals, kinds, agrees, arguments, has_args, args, read),
                                ⟨going, low⟩⟩)⟩⟩)
                        },
                        Inr(two) => match Ran::then_stopped<Locals, Config>(Ran::of(bind_values(results, two.witness.words, c.locals), two.witness.io),
                            λ (l: Locals) => Done(Config(l, two.witness.heap, two.witness.io)), x, two.proof.right) {
                            Inl(bad) => false_elim(Ran::of_stopped<Locals>(bind_values(results, two.witness.words, c.locals), two.witness.io, x, bad)),
                            Inr(three) => absurd(three.proof.right),
                        },
                    }
                },
            }
        },
        Loop(inputs, parameters, inner, exit, next, outputs) => λ kinds bound used used2 c x checked fresh ran peaked scoped blank absent => {
            let ck = loop_checked(sigs, kinds, bound, inputs, parameters, inner, exit, next, outputs, checked);
            let fr = loop_fresh(used, used2, inputs, parameters, inner, exit, next, outputs, fresh);
            let step = λ (n: Nat) (pass: Config) => inner.run(blocks, calls, n, pass);
            let peak = λ (n: Nat) (pass: Config) => inner.peak(blocks, calls, peaks, n, pass);
            let absent_inside = λ (m: Mem(spare, fr.inside)) => absent(fresh_ids_grows(typed_ids(outputs), used ++ fr.inside, used2, fr.outs, spare,
                used.mem_append_r(fr.inside, spare, m)));
            let Pass = λ (v: Valuation()) (from: Now) (to: Now) => inner.Holds(spans, blocks, v, peak_answers(calls, peaks, cap), spare, from, to);
            let PassStops = λ (v: Valuation()) (k: Nat) (from: Now) =>
                inner.Stops(spans, blocks, v, peak_answers(calls, peaks, cap), peak_stops(x, calls, peaks, cap), x, spare, k, from);
            let out_k = λ (end: Ended) => Ran::of(bind_values(outputs, end.state, c.locals), end.io).then(λ (l: Locals) => Done(Config(l, end.memory, end.io)));
            match Ran::then_stopped<List<Value>, Config>(Ran::of(read_values(inputs, c.locals), c.io), λ (state: List<Value>) =>
                loop_run(step, parameters, exit, next, fuel, state, c.memory, c.io).then(out_k), x, ran) {
                Inl(bad) => false_elim(Ran::of_stopped<List<Value>>(read_values(inputs, c.locals), c.io, x, bad)),
                Inr(one) => {
                    let state = one.witness;
                    let read = Ran::of_done<List<Value>>(read_values(inputs, c.locals), c.io, state, one.proof.left);
                    match Ran::then_stopped<Ended, Config>(loop_run(step, parameters, exit, next, fuel, state, c.memory, c.io), out_k, x, one.proof.right) {
                        Inl(looping) => {
                            let here = here_valuation(c, spans, used, used2, spare, blank,
                                Body::Loop(inputs, parameters, inner, exit, next, outputs).fresh_grows(used, used2, fresh), absent);
                            let v = c.locals.lower(spans);
                            let agrees = c.locals.agrees_of(spans, v, used, here.left, kinds, scoped.left);
                            let peaked_loop: (loop_run_peak(step, peak, parameters, exit, next, fuel, state, c.memory, c.io) <= cap) =
                                j(read, λ x _ => (match x {
                                    None => 0,
                                    Some(st) => loop_run_peak(step, peak, parameters, exit, next, fuel, st, c.memory, c.io),
                                }) <= cap, peaked);
                            let passes: PassesFacts(blocks, calls, inner, spans, Pass, parameters, exit, next, peak, cap) =
                                λ rest st m io l aft later bound_l peaked_inner ran_inner read_next => {
                                    let entered = bind_values_scopes(parameters, st, Locals::empty(), l, [], fr.start, [], ck.start, bound_l, fr.params, ck.params,
                                        empty_scoped());
                                    let c0 = Config(l, m, io);
                                    let inside = inner.scopes(blocks, calls, rest, sigs, ck.start, ck.end, fr.start, fr.inside, c0, aft, ck.body, fr.body,
                                        ran_inner, entered.left.left);
                                    let zero = spare_zero(l, aft.locals, spans, fr.start, fr.inside, spare, absent_inside, entered.left.right, inside.right);
                                    pass_close(blocks, calls, peak_answers(calls, peaks, cap), spans, spare, parameters, inner, exit, next, ck.start, ck.end,
                                        ck.params, ck.nexts, ck.exits, fr.start, fr.inside, st, Now(m, io), l, aft, later, entered, inside,
                                        inner.holds_of(blocks, calls, rest, sigs, spans, aft.locals.lower(spans), spare, zero, peaks, cap, grows, ck.start, ck.end,
                                            fr.start, fr.inside, c0, aft, ck.body, fr.body, ran_inner, peaked_inner, entered.left.left,
                                            λ id _ => aft.locals.lower_shows(spans, id), absent_inside),
                                        read_next)
                                };
                            let goes: PassesStopFacts(x, blocks, calls, inner, spans, PassStops, parameters, peak, cap) =
                                λ rest st m io l bound_l peaked_inner going_inner => {
                                    let entered = bind_values_scopes(parameters, st, Locals::empty(), l, [], fr.start, [], ck.start, bound_l, fr.params, ck.params,
                                        empty_scoped());
                                    let got = inner.stops_of(blocks, calls, rest, sigs, spans, spare, peaks, cap, grows, ck.start, ck.end, fr.start, fr.inside,
                                        Config(l, m, io), x, ck.body, fr.body, going_inner, peaked_inner, entered.left.left, entered.left.right, absent_inside);
                                    let v2 = got.witness;
                                    let agrees2 = l.agrees_of(spans, v2, fr.start, got.proof.left, ck.start, entered.left.left.left);
                                    Exists(v2, ⟨sym(read_values_lower(spans, v2, l, ck.start, agrees2, parameters, bind_kinds_has(parameters, [], ck.start, ck.params),
                                        st, entered.right)), got.proof.right.right⟩)
                                };
                            let pg = loop_run_stops(x, blocks, calls, inner, spans, Pass, PassStops, parameters, exit, next, peak, cap, passes, goes, fuel, state,
                                c.memory, c.io, peaked_loop, looping);
                            Exists(v, ⟨here.left, ⟨here.right, j(read_values_lower(spans, v, c.locals, kinds, agrees, inputs, ck.inputs_had, state, read),
                                λ ws _ => PassesStop(Pass, PassStops, parameters, exit, next, x.ZeroAt(), fuel, ws, Now(c.memory, c.io)), pg)⟩⟩)
                        },
                        Inr(two) => match Ran::then_stopped<Locals, Config>(Ran::of(bind_values(outputs, two.witness.state, c.locals), two.witness.io),
                            λ (l: Locals) => Done(Config(l, two.witness.memory, two.witness.io)), x, two.proof.right) {
                            Inl(bad) => false_elim(Ran::of_stopped<Locals>(bind_values(outputs, two.witness.state, c.locals), two.witness.io, x, bad)),
                            Inr(three) => absurd(three.proof.right),
                        },
                    }
                },
            }
        },
        Sys(call) => λ kinds bound used used2 c x checked fresh stopped => absurd(trans(sym(call.stopped_none(blocks, c)), stopped)),
        Exit(status) => λ kinds bound used used2 c x checked fresh ran peaked scoped blank absent => {
            let here = here_valuation(c, spans, used, used2, spare, blank, Body::Exit(status).fresh_grows(used, used2, fresh), absent);
            let v = c.locals.lower(spans);
            let has = true_of_some<List<Typed>>(has_kind(kinds, status, WordKind), Some(kinds), bound, checked);
            let word: (v(64, status) = c.locals.word(status)) =
                c.locals.agrees_word(spans, v, kinds, status, has, c.locals.agrees_of(spans, v, used, here.left, kinds, scoped.left), 64);
            Exists(v, ⟨here.left, ⟨here.right, j(Option::some_inj(StopExited(c.locals.word(status), c.io), x, ran), λ y _ => y.Exits(v(64, status), c.io), ⟨word, refl⟩)⟩⟩)
        },
    }
}

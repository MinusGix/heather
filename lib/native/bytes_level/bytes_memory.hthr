// The bytes level's memory (docs/language/ownership-design.md §17.3;
// issues/bytes-level-language.md): blocks of bytes with a shadow of the
// references held among them, and which blocks a run may write.
//
// - A memory is what a run changes: the experiment's heap (reference_cells:
//   `Heap`, its bytes per block and its shadow of `Entry`s) and which bytes
//   are undefined (a fresh block's, a window a failed read left). What is
//   fixed for a run is apart from it (`Blocks`: which blocks the run may
//   store into); nothing here makes a block, and no operation changes a
//   block's length. A byte is plain, part of a reference, or undefined.
// - Every operation is one of two: `take` reads a piece of memory, its
//   bytes, the references wholly among them (`Piece`, the references at
//   offsets of their own) and which of its bytes are undefined, and `put`
//   writes one. A load of a word is a
//   take with no reference in it; a load of a reference, a take of eight
//   bytes holding one at its start; a store of a word, a put of its bytes;
//   a store of a reference, a put of eight zero bytes holding it; a typed
//   range copy, a take and a put. So a reference is never seen as bytes
//   nor bytes as a reference, and nothing else is said twice.
// - Each is partial, and where it answers is its site fact (§17.3): a take
//   where the range lies in its block and cuts no reference (`fits`,
//   `whole`); a put where the block may be written as well. A store that
//   cuts a reference has no meaning (the experiment's `cut_refused`): the
//   bytes it left would hold part of an address the meaning cannot name.
//   `Memory::take_some`/`take_of` and `put_some`/`put_of` state each fact
//   both ways, and the operations' own facts follow from them, so a
//   lowering takes them as hypotheses and a comparison on the path is one
//   prover.
// - Canonical: a reference's eight bytes are zero, and so is an undefined
//   byte (a put of a reference or of an undefined window writes zeros, and
//   a take carries them), so what a heap reads is its bytes, its entries
//   and its undefined bytes.
// - Renaming blocks (`MemoryRenamed`): a take of a renamed memory is the
//   renamed take, a put the renamed put (`Memory::take_renames`,
//   `put_renames`). Nothing here reads which block a reference names
//   beyond following it.
import reference_cells;
import x86_64_store;
import bitvec;
import bitvec_bytes;
import vector;
import bool;
import list;
import list_window;
import logic;
import nat;
import option;
import omega;

// ---------------------------------------------------------------------------
// Pieces: bytes and the references among them

// A reference held at byte `at` of a piece: its eight bytes from there.
record Pointer { at: Nat, target: Loc }

// What a range of memory holds, wherever it lies: its bytes, the
// references wholly inside it, each at its offset in the range, and which
// of its bytes are undefined (`flag`: a byte past the flags is defined).
record Piece { bytes: List<BitVec(8)>, pointers: List<Pointer>, undefined: List<Bool> }

fn flag(flags: List<Bool>, i: Nat) → Bool { flags.nth(i).unwrap_or(False) }

// No flag set.
fn none_set(flags: List<Bool>) → Bool { match flags { Nil => True, Cons(f, rest) => !f && none_set(rest) } }

// Bytes holding no reference, all defined.
fn Piece::plain(bytes: List<BitVec(8)>) → Piece { Piece(bytes, [], []) }

// Eight zero bytes holding `target` (zero under a reference: canonical).
fn Piece::reference(target: Loc) → Piece { Piece(word_bytes(BitVec::zero()), [Pointer(0, target)], []) }

// `n` undefined bytes, zero (canonical): what a failed read leaves.
fn Piece::undefined(n: Nat) → Piece { Piece(List::replicate(BitVec::zero(), n), [], List::replicate(True, n)) }

// The `n` bytes from the first as a number, the first the least
// significant: what a load of `n` bytes reads (FunctionIR's `buffer_word`).
fn little_endian(bytes: List<BitVec(8)>, n: Nat) → Nat { BitVec::of_bytes_le(bytes.vector_of(n, BitVec::zero())).toNat() }

// The `n` low bytes of a word of `8 * n` bits, the least significant first:
// what a store of `n` bytes writes (FunctionIR's `store_word`).
fn word_piece(n: Nat, word: BitVec(8 * n)) → List<BitVec(8)> { vector_entries(word.bytes_le(n)) }

// The reference a piece is: one, at its start.
fn Piece::referent(self piece: Piece) → Option<Loc> {
    match piece.pointers {
        Nil => None,
        Cons(p, rest) => match rest {
            Nil => match p.at { Zero => Some(p.target), Succ(_) => None },
            Cons(_, _) => None,
        },
    }
}

// ---------------------------------------------------------------------------
// The shadow over a range

// The entry shares a byte with the `n` bytes of block `b` from `k`.
fn Entry::meets_range(self e: Entry, b, k, n: Nat) → Bool { e.block.same(b) && ((e.at + 1).leb(k + n) && (k + 1).leb(e.at + 8)) }

// The entry's eight bytes lie among them.
fn Entry::within_range(self e: Entry, b, k, n: Nat) → Bool { e.block.same(b) && (k.leb(e.at) && (e.at + 8).leb(k + n)) }

// It shares a byte with them and does not lie among them: a write there
// would leave part of a reference, a read would take part of one.
fn Entry::cuts_range(self e: Entry, b, k, n: Nat) → Bool { e.meets_range(b, k, n) && !e.within_range(b, k, n) }

fn range_cut(shadow: List<Entry>, b, k, n: Nat) → Bool {
    match shadow { Nil => False, Cons(e, rest) => e.cuts_range(b, k, n) || range_cut(rest, b, k, n) }
}

// The shadow without the entries the range meets.
fn range_cleared(shadow: List<Entry>, b, k, n: Nat) → List<Entry> {
    match shadow {
        Nil => Nil,
        Cons(e, rest) => match e.meets_range(b, k, n) {
            True => range_cleared(rest, b, k, n),
            False => Cons(e, range_cleared(rest, b, k, n)),
        },
    }
}

// The references among the range, at their offsets in it.
fn range_pointers(shadow: List<Entry>, b, k, n: Nat) → List<Pointer> {
    match shadow {
        Nil => Nil,
        Cons(e, rest) => match e.within_range(b, k, n) {
            True => Cons(Pointer(e.at - k, e.target), range_pointers(rest, b, k, n)),
            False => range_pointers(rest, b, k, n),
        },
    }
}

// A piece's references as entries, the piece put at byte `k` of block `b`.
fn placed(pointers: List<Pointer>, b, k: Nat) → List<Entry> {
    match pointers { Nil => Nil, Cons(p, rest) => Cons(Entry(b, k + p.at, p.target), placed(rest, b, k)) }
}

// ---------------------------------------------------------------------------
// Memory

// What a run changes: the heap, and which bytes are undefined.
record Memory { heap: Heap, undefined: Nat → Nat → Bool }

// What is fixed for a run about its blocks: which it may store into. (A
// block's length is its bytes', which no operation changes.)
record Blocks { written: Nat → Bool }

// The flags of the `n` bytes of block `b` from `k`.
fn flags(undefined: Nat → Nat → Bool, b, k, n: Nat) → List<Bool> {
    match n { Zero => Nil, Succ(j) => Cons(undefined(b, k), flags(undefined, b, k + 1, j)) }
}

// The `n` bytes at `loc` lie in its block.
fn Memory::fits(self m: Memory, loc: Loc, n: Nat) → Bool { (loc.offset + n).leb(m.heap.bytes(loc.block).len()) }

// They cut no reference.
fn Memory::whole(self m: Memory, loc: Loc, n: Nat) → Bool { !range_cut(m.heap.shadow, loc.block, loc.offset, n) }

// What they hold.
fn Memory::piece_at(self m: Memory, loc: Loc, n: Nat) → Piece {
    Piece(m.heap.bytes(loc.block).window(loc.offset, loc.offset + n), range_pointers(m.heap.shadow, loc.block, loc.offset, n),
        flags(m.undefined, loc.block, loc.offset, n))
}

// Byte `j` of block `c` is among the `n` from byte `k` of block `b`.
fn in_window(b, k, n, c, j: Nat) → Bool { c.same(b) && (k.leb(j) && (j + 1).leb(k + n)) }

// Memory with `piece` written at `loc`: its bytes over the block's, its
// references for every entry the range met, its flags over the window's.
fn Memory::placed_at(self m: Memory, loc: Loc, piece: Piece) → Memory {
    Memory(Heap(set_block(m.heap.bytes, loc.block, m.heap.bytes(loc.block).put_window(loc.offset, piece.bytes)),
            placed(piece.pointers, loc.block, loc.offset) ++ range_cleared(m.heap.shadow, loc.block, loc.offset, piece.bytes.len())),
        λ (c: Nat) (j: Nat) => match in_window(loc.block, loc.offset, piece.bytes.len(), c, j) {
            True => flag(piece.undefined, j - loc.offset),
            False => m.undefined(c, j),
        })
}

// The two operations. A take answers where the range lies in its block and
// cuts no reference; a put, where besides that its block may be written.
fn Memory::take(self m: Memory, loc: Loc, n: Nat) → Option<Piece> {
    match m.fits(loc, n) && m.whole(loc, n) { False => None, True => Some(m.piece_at(loc, n)) }
}

fn Memory::put(self m: Memory, blocks: Blocks, loc: Loc, piece: Piece) → Option<Memory> {
    match blocks.written(loc.block) && (m.fits(loc, piece.bytes.len()) && m.whole(loc, piece.bytes.len())) {
        False => None,
        True => Some(m.placed_at(loc, piece)),
    }
}

// What the nodes do, each a take or a put.

// `n` bytes holding no reference and none undefined.
fn Piece::plain_bytes(self piece: Piece) → Option<List<BitVec(8)>> {
    match piece.pointers { Nil => match none_set(piece.undefined) { True => Some(piece.bytes), False => None }, Cons(_, _) => None }
}

fn Memory::read_bytes(self m: Memory, loc: Loc, n: Nat) → Option<List<BitVec(8)>> {
    match m.take(loc, n) { None => None, Some(piece) => piece.plain_bytes() }
}

// As a number.
fn Memory::load(self m: Memory, loc: Loc, n: Nat) → Option<Nat> {
    match m.read_bytes(loc, n) { None => None, Some(bytes) => Some(little_endian(bytes, n)) }
}

// The reference held at `loc`.
fn Memory::load_ref(self m: Memory, loc: Loc) → Option<Loc> {
    match m.take(loc, 8) { None => None, Some(piece) => piece.referent() }
}

fn Memory::store(self m: Memory, blocks: Blocks, loc: Loc, bytes: List<BitVec(8)>) → Option<Memory> { m.put(blocks, loc, Piece::plain(bytes)) }

fn Memory::store_ref(self m: Memory, blocks: Blocks, loc, target: Loc) → Option<Memory> { m.put(blocks, loc, Piece::reference(target)) }

// The `n` bytes at `source`, references and all, written at `target`. The
// piece is taken before anything is written, so the two may overlap.
fn Memory::copy(self m: Memory, blocks: Blocks, target, source: Loc, n: Nat) → Option<Memory> {
    match m.take(source, n) { None => None, Some(piece) => m.put(blocks, target, piece) }
}

// ---------------------------------------------------------------------------
// Site facts: where each operation answers, both ways

theorem Memory::take_some(self m: Memory, loc: Loc, n: Nat, piece: Piece, taken: m.take(loc, n) = Some(piece)):
    (m.fits(loc, n) = True) ∧ ((m.whole(loc, n) = True) ∧ (m.piece_at(loc, n) = piece)) {
    (match m.fits(loc, n) && m.whole(loc, n) as λ v => (m.fits(loc, n) && m.whole(loc, n)) = v →
            (match v { False => None, True => Some(m.piece_at(loc, n)) }) = Some(piece) →
            (m.fits(loc, n) = True) ∧ ((m.whole(loc, n) = True) ∧ (m.piece_at(loc, n) = piece)) {
        False => λ _ none => absurd(none),
        True => λ both some => {
            let parts = Bool::and_true_parts(m.fits(loc, n), m.whole(loc, n), both);
            ⟨parts.left, ⟨parts.right, Option::some_inj(m.piece_at(loc, n), piece, some)⟩⟩
        },
    })(refl, taken)
}

theorem Memory::take_of(self m: Memory, loc: Loc, n: Nat, fits: m.fits(loc, n) = True, whole: m.whole(loc, n) = True):
    m.take(loc, n) = Some(m.piece_at(loc, n)) {
    j(sym(Bool::and_cong(fits, whole)), λ v _ => (match v { False => None, True => Some(m.piece_at(loc, n)) }) = Some(m.piece_at(loc, n)), refl)
}

theorem Memory::put_some(self m: Memory, blocks: Blocks, loc: Loc, piece: Piece, after: Memory, put: m.put(blocks, loc, piece) = Some(after)):
    (blocks.written(loc.block) = True) ∧ ((m.fits(loc, piece.bytes.len()) = True) ∧ ((m.whole(loc, piece.bytes.len()) = True) ∧
        (m.placed_at(loc, piece) = after))) {
    let n = piece.bytes.len();
    (match blocks.written(loc.block) && (m.fits(loc, n) && m.whole(loc, n)) as λ v =>
            (blocks.written(loc.block) && (m.fits(loc, n) && m.whole(loc, n))) = v →
            (match v { False => None, True => Some(m.placed_at(loc, piece)) }) = Some(after) →
            (blocks.written(loc.block) = True) ∧ ((m.fits(loc, n) = True) ∧ ((m.whole(loc, n) = True) ∧ (m.placed_at(loc, piece) = after))) {
        False => λ _ none => absurd(none),
        True => λ all some => {
            let outer = Bool::and_true_parts(blocks.written(loc.block), m.fits(loc, n) && m.whole(loc, n), all);
            let inner = Bool::and_true_parts(m.fits(loc, n), m.whole(loc, n), outer.right);
            ⟨outer.left, ⟨inner.left, ⟨inner.right, Option::some_inj(m.placed_at(loc, piece), after, some)⟩⟩⟩
        },
    })(refl, put)
}

theorem Memory::put_of(self m: Memory, blocks: Blocks, loc: Loc, piece: Piece, written: blocks.written(loc.block) = True,
    fits: m.fits(loc, piece.bytes.len()) = True, whole: m.whole(loc, piece.bytes.len()) = True):
    m.put(blocks, loc, piece) = Some(m.placed_at(loc, piece)) {
    j(sym(Bool::and_cong(written, Bool::and_cong(fits, whole))), λ v _ =>
        (match v { False => None, True => Some(m.placed_at(loc, piece)) }) = Some(m.placed_at(loc, piece)), refl)
}

// Plain bytes are a piece's bytes where it holds no reference and none of
// them is undefined.
theorem Piece::plain_bytes_some(self piece: Piece, bytes: List<BitVec(8)>, plain: piece.plain_bytes() = Some(bytes)):
    (piece.pointers = Nil) ∧ ((none_set(piece.undefined) = True) ∧ (piece.bytes = bytes)) {
    (match piece.pointers as λ ps => piece.pointers = ps →
            (match ps { Nil => match none_set(piece.undefined) { True => Some(piece.bytes), False => None }, Cons(_, _) => None }) = Some(bytes) →
            (piece.pointers = Nil) ∧ ((none_set(piece.undefined) = True) ∧ (piece.bytes = bytes)) {
        Nil => λ none => (match none_set(piece.undefined) as λ v => none_set(piece.undefined) = v →
                (match v { True => Some(piece.bytes), False => None }) = Some(bytes) →
                (piece.pointers = Nil) ∧ ((none_set(piece.undefined) = True) ∧ (piece.bytes = bytes)) {
            True => λ set some => ⟨none, ⟨set, Option::some_inj(piece.bytes, bytes, some)⟩⟩,
            False => λ _ never => absurd(never),
        })(refl),
        Cons(_, _) => λ _ never => absurd(never),
    })(refl, plain)
}

// A read of plain bytes answers where its bytes lie in their block, cut
// no reference, hold none, and none is undefined; it answers them.
theorem Memory::read_bytes_some(self m: Memory, loc: Loc, n: Nat, bytes: List<BitVec(8)>, read: m.read_bytes(loc, n) = Some(bytes)):
    (m.take(loc, n) = Some(m.piece_at(loc, n))) ∧ ((range_pointers(m.heap.shadow, loc.block, loc.offset, n) = Nil) ∧
        ((none_set(flags(m.undefined, loc.block, loc.offset, n)) = True) ∧ (m.heap.bytes(loc.block).window(loc.offset, loc.offset + n) = bytes))) {
    (match m.take(loc, n) as λ o => m.take(loc, n) = o → (match o { None => None, Some(piece) => piece.plain_bytes() }) = Some(bytes) →
            (m.take(loc, n) = Some(m.piece_at(loc, n))) ∧ ((range_pointers(m.heap.shadow, loc.block, loc.offset, n) = Nil) ∧
                ((none_set(flags(m.undefined, loc.block, loc.offset, n)) = True) ∧ (m.heap.bytes(loc.block).window(loc.offset, loc.offset + n) = bytes))) {
        None => λ _ none => absurd(none),
        Some(piece) => λ taken plain => {
            let facts = m.take_some(loc, n, piece, taken);
            let at: (m.piece_at(loc, n).plain_bytes() = Some(bytes)) = j(sym(facts.right.right), λ p _ => p.plain_bytes() = Some(bytes), plain);
            ⟨m.take_of(loc, n, facts.left, facts.right.left), m.piece_at(loc, n).plain_bytes_some(bytes, at)⟩
        },
    })(refl, read)
}

theorem Memory::load_some(self m: Memory, loc: Loc, n, x: Nat, loaded: m.load(loc, n) = Some(x)):
    Exists<List<BitVec(8)>>(λ bytes => (m.read_bytes(loc, n) = Some(bytes)) ∧ (little_endian(bytes, n) = x)) {
    (match m.read_bytes(loc, n) as λ o => m.read_bytes(loc, n) = o → (match o { None => None, Some(bytes) => Some(little_endian(bytes, n)) }) = Some(x) →
            Exists<List<BitVec(8)>>(λ bytes => (m.read_bytes(loc, n) = Some(bytes)) ∧ (little_endian(bytes, n) = x)) {
        None => λ _ none => absurd(none),
        Some(bytes) => λ read some => Exists(bytes, ⟨read, Option::some_inj(little_endian(bytes, n), x, some)⟩),
    })(refl, loaded)
}

// A store answers where its block may be written and its bytes lie in it
// and cut no reference.
theorem Memory::store_some(self m: Memory, blocks: Blocks, loc: Loc, bytes: List<BitVec(8)>, after: Memory,
    stored: m.store(blocks, loc, bytes) = Some(after)):
    (blocks.written(loc.block) = True) ∧ ((m.fits(loc, bytes.len()) = True) ∧ ((m.whole(loc, bytes.len()) = True) ∧
        (m.placed_at(loc, Piece::plain(bytes)) = after))) {
    m.put_some(blocks, loc, Piece::plain(bytes), after, stored)
}

theorem Memory::store_ref_some(self m: Memory, blocks: Blocks, loc, target: Loc, after: Memory, stored: m.store_ref(blocks, loc, target) = Some(after)):
    (blocks.written(loc.block) = True) ∧ ((m.fits(loc, 8) = True) ∧ ((m.whole(loc, 8) = True) ∧ (m.placed_at(loc, Piece::reference(target)) = after))) {
    m.put_some(blocks, loc, Piece::reference(target), after, stored)
}

// A copy answers where its source may be taken and its target put.
theorem Memory::copy_some(self m: Memory, blocks: Blocks, target, source: Loc, n: Nat, after: Memory,
    copied: m.copy(blocks, target, source, n) = Some(after)):
    (m.take(source, n) = Some(m.piece_at(source, n))) ∧ (m.put(blocks, target, m.piece_at(source, n)) = Some(after)) {
    (match m.take(source, n) as λ o => m.take(source, n) = o → (match o { None => None, Some(piece) => m.put(blocks, target, piece) }) = Some(after) →
            (m.take(source, n) = Some(m.piece_at(source, n))) ∧ (m.put(blocks, target, m.piece_at(source, n)) = Some(after)) {
        None => λ _ none => absurd(none),
        Some(piece) => λ taken put => {
            let facts = m.take_some(source, n, piece, taken);
            ⟨m.take_of(source, n, facts.left, facts.right.left), rewrite(facts.right.right, put)⟩
        },
    })(refl, copied)
}

// ---------------------------------------------------------------------------
// Renaming blocks

fn Pointer::rename(self p: Pointer, r: Renaming) → Pointer { Pointer(p.at, p.target.rename(r)) }

fn rename_pointers(r: Renaming, pointers: List<Pointer>) → List<Pointer> {
    match pointers { Nil => Nil, Cons(p, rest) => Cons(p.rename(r), rename_pointers(r, rest)) }
}

fn Piece::rename(self piece: Piece, r: Renaming) → Piece { Piece(piece.bytes, rename_pointers(r, piece.pointers), piece.undefined) }

// `renamed` is `m` with every block `b` called `r.there(b)`.
record MemoryRenamed(r: Renaming, m, renamed: Memory) {
    bytes: (c: Nat) → renamed.heap.bytes(c) = m.heap.bytes(r.back(c)),
    shadow: renamed.heap.shadow = rename_shadow(r, m.heap.shadow),
    undefined: (c, i: Nat) → renamed.undefined(c, i) = m.undefined(r.back(c), i),
}

// `renamed` is `blocks` with every block `b` called `r.there(b)`.
record BlocksRenamed(r: Renaming, blocks, renamed: Blocks) {
    written: (c: Nat) → renamed.written(c) = blocks.written(r.back(c)),
}

// Two answers related by `R`: both none, or both some and related.
fn Related<T>(R: T → T → Type, left, right: Option<T>) → Type {
    match left {
        None => match right { None => True, Some(_) => False },
        Some(a) => match right { None => False, Some(b) => R(a, b) },
    }
}

fn memory_renamed(r: Renaming) → Memory → Memory → Type { λ (a: Memory) (b: Memory) => MemoryRenamed(r, a, b) }

// Two memories alike: none both, or the second the first renamed.
fn MemoryAlike(r: Renaming, left, right: Option<Memory>) → Type { Related<Memory>(memory_renamed(r), left, right) }

// What follows from related answers is related, where it follows from
// related values: the three ways a run's steps are chained.
theorem related_then<A, T>(Ra: A → A → Type, R: T → T → Type, {o, o2: Option<A>}, rel: Related<A>(Ra, o, o2), {k, k2: A → Option<T>},
    each: (x, y: A) → Ra(x, y) → Related<T>(R, k(x), k2(y))): Related<T>(R, o.and_then(k), o2.and_then(k2)) {
    (match o as λ a => (b: Option<A>) → Related<A>(Ra, a, b) → Related<T>(R, a.and_then(k), b.and_then(k2)) {
        None => λ b => match b {
            None => λ _ => trivial,
            Some(_) => λ never => false_elim(never),
        },
        Some(x) => λ b => match b {
            None => λ never => false_elim(never),
            Some(y) => λ h => each(x, y, h),
        },
    })(o2, rel)
}

// The second the first renamed by `g`.
theorem related_map_then<A, T>(R: T → T → Type, g: A → A, {o, o2: Option<A>}, same: o2 = o.map(g), {k, k2: A → Option<T>},
    each: (x: A) → Related<T>(R, k(x), k2(g(x)))): Related<T>(R, o.and_then(k), o2.and_then(k2)) {
    rewrite(same, match o { None => trivial, Some(x) => each(x) })
}

// The second the first.
theorem related_same_then<A, T>(R: T → T → Type, {o, o2: Option<A>}, same: o2 = o, {k, k2: A → Option<T>},
    each: (x: A) → Related<T>(R, k(x), k2(x))): Related<T>(R, o.and_then(k), o2.and_then(k2)) {
    rewrite(same, match o { None => trivial, Some(x) => each(x) })
}

// Answers related by "the second is the first under `g`" are an equation.
theorem related_eq_map<A>(g: A → A, {o, o2: Option<A>}, rel: Related<A>(λ (a: A) (b: A) => b = g(a), o, o2)): o2 = o.map(g) {
    (match o as λ a => (b: Option<A>) → Related<A>(λ (x: A) (y: A) => y = g(x), a, b) → b = a.map(g) {
        None => λ b => match b { None => λ _ => refl, Some(_) => λ never => false_elim(never) },
        Some(_) => λ b => match b {
            None => λ never => false_elim(never),
            Some(_) => λ h => cong_fn<A, Option<A>>(λ v => Some(v), h),
        },
    })(o2, rel)
}

// What related answers say alike.
theorem related_map_eq<T, B>(R: T → T → Type, f: T → B, alike: (a, b: T) → R(a, b) → f(b) = f(a), {o, o2: Option<T>}, rel: Related<T>(R, o, o2)):
    o2.map(f) = o.map(f) {
    (match o as λ a => (b: Option<T>) → Related<T>(R, a, b) → b.map(f) = a.map(f) {
        None => λ b => match b { None => λ _ => refl, Some(_) => λ never => false_elim(never) },
        Some(x) => λ b => match b {
            None => λ never => false_elim(never),
            Some(y) => λ h => cong_fn<B, Option<B>>(λ v => Some(v), alike(x, y, h)),
        },
    })(o2, rel)
}

theorem MemoryRenamed::block({r: Renaming}, {m, renamed: Memory}, self rel: MemoryRenamed(r, m, renamed), b: Nat):
    renamed.heap.bytes(r.there(b)) = m.heap.bytes(b) {
    trans(rel.bytes(r.there(b)), cong_fn<Nat, List<BitVec(8)>>(λ x => m.heap.bytes(x), r.back_there(b)))
}

theorem BlocksRenamed::writes({r: Renaming}, {blocks, renamed: Blocks}, self rel: BlocksRenamed(r, blocks, renamed), b: Nat):
    renamed.written(r.there(b)) = blocks.written(b) {
    trans(rel.written(r.there(b)), cong_fn<Nat, Bool>(λ x => blocks.written(x), r.back_there(b)))
}

theorem MemoryRenamed::undefined_at({r: Renaming}, {m, renamed: Memory}, self rel: MemoryRenamed(r, m, renamed), b, i: Nat):
    renamed.undefined(r.there(b), i) = m.undefined(b, i) {
    trans(rel.undefined(r.there(b), i), cong_fn<Nat, Bool>(λ x => m.undefined(x, i), r.back_there(b)))
}

theorem MemoryRenamed::flags_at({r: Renaming}, {m, renamed: Memory}, self rel: MemoryRenamed(r, m, renamed), b: Nat, n: Nat):
    (k: Nat) → flags(renamed.undefined, r.there(b), k, n) = flags(m.undefined, b, k, n) {
    match n {
        Zero => λ k => refl,
        Succ(rest) => λ k => {
            let unfolded: (Cons(renamed.undefined(r.there(b), k), flags(renamed.undefined, r.there(b), k + 1, rest)) =
                    Cons(m.undefined(b, k), flags(m.undefined, b, k + 1, rest))) =
                rewrite(rel.undefined_at(b, k), rel.flags_at(b, rest, k + 1), refl);
            unfolded
        },
    }
}

theorem Entry::rename_meets_range(self e: Entry, r: Renaming, b, k, n: Nat): e.rename(r).meets_range(r.there(b), k, n) = e.meets_range(b, k, n) {
    cong_fn<Bool, Bool>(λ v => v && ((e.at + 1).leb(k + n) && (k + 1).leb(e.at + 8)), r.there_same(e.block, b))
}

theorem Entry::rename_within_range(self e: Entry, r: Renaming, b, k, n: Nat): e.rename(r).within_range(r.there(b), k, n) = e.within_range(b, k, n) {
    cong_fn<Bool, Bool>(λ v => v && (k.leb(e.at) && (e.at + 8).leb(k + n)), r.there_same(e.block, b))
}

theorem Entry::rename_cuts_range(self e: Entry, r: Renaming, b, k, n: Nat): e.rename(r).cuts_range(r.there(b), k, n) = e.cuts_range(b, k, n) {
    Bool::and_cong(e.rename_meets_range(r, b, k, n), cong_fn<Bool, Bool>(λ v => !v, e.rename_within_range(r, b, k, n)))
}

theorem rename_range_cut(r: Renaming, b, k, n: Nat, shadow: List<Entry>): range_cut(rename_shadow(r, shadow), r.there(b), k, n) = range_cut(shadow, b, k, n) {
    match shadow {
        Nil => refl,
        Cons(e, rest) => Bool::or_cong(e.rename_cuts_range(r, b, k, n), rename_range_cut(r, b, k, n, rest)),
    }
}

theorem rename_range_cleared(r: Renaming, b, k, n: Nat, shadow: List<Entry>):
    range_cleared(rename_shadow(r, shadow), r.there(b), k, n) = rename_shadow(r, range_cleared(shadow, b, k, n)) {
    match shadow {
        Nil => refl,
        Cons(e, rest) => j(sym(e.rename_meets_range(r, b, k, n)), λ v _ =>
                (match v { True => range_cleared(rename_shadow(r, rest), r.there(b), k, n),
                    False => Cons(e.rename(r), range_cleared(rename_shadow(r, rest), r.there(b), k, n)) }) =
                    rename_shadow(r, match e.meets_range(b, k, n) { True => range_cleared(rest, b, k, n), False => Cons(e, range_cleared(rest, b, k, n)) }),
            (match e.meets_range(b, k, n) {
                True => rename_range_cleared(r, b, k, n, rest),
                False => cong_fn<List<Entry>, List<Entry>>(λ l => Cons(e.rename(r), l), rename_range_cleared(r, b, k, n, rest)),
            })),
    }
}

theorem rename_range_pointers(r: Renaming, b, k, n: Nat, shadow: List<Entry>):
    range_pointers(rename_shadow(r, shadow), r.there(b), k, n) = rename_pointers(r, range_pointers(shadow, b, k, n)) {
    match shadow {
        Nil => refl,
        Cons(e, rest) => j(sym(e.rename_within_range(r, b, k, n)), λ v _ =>
                (match v { True => Cons(Pointer(e.at - k, e.target.rename(r)), range_pointers(rename_shadow(r, rest), r.there(b), k, n)),
                    False => range_pointers(rename_shadow(r, rest), r.there(b), k, n) }) =
                    rename_pointers(r, match e.within_range(b, k, n) { True => Cons(Pointer(e.at - k, e.target), range_pointers(rest, b, k, n)),
                        False => range_pointers(rest, b, k, n) }),
            (match e.within_range(b, k, n) {
                True => cong_fn<List<Pointer>, List<Pointer>>(λ l => Cons(Pointer(e.at - k, e.target.rename(r)), l), rename_range_pointers(r, b, k, n, rest)),
                False => rename_range_pointers(r, b, k, n, rest),
            })),
    }
}

theorem rename_placed(r: Renaming, b, k: Nat, pointers: List<Pointer>):
    placed(rename_pointers(r, pointers), r.there(b), k) = rename_shadow(r, placed(pointers, b, k)) {
    match pointers {
        Nil => refl,
        Cons(p, rest) => cong_fn<List<Entry>, List<Entry>>(λ l => Cons(Entry(r.there(b), k + p.at, p.target.rename(r)), l), rename_placed(r, b, k, rest)),
    }
}

theorem rename_shadow_append(r: Renaming, xs, ys: List<Entry>): rename_shadow(r, xs ++ ys) = rename_shadow(r, xs) ++ rename_shadow(r, ys) {
    match xs {
        Nil => refl,
        Cons(e, rest) => cong_fn<List<Entry>, List<Entry>>(λ l => Cons(e.rename(r), l), rename_shadow_append(r, rest, ys)),
    }
}

theorem MemoryRenamed::fits({r: Renaming}, {m, renamed: Memory}, self rel: MemoryRenamed(r, m, renamed), loc: Loc, n: Nat):
    renamed.fits(loc.rename(r), n) = m.fits(loc, n) {
    cong_fn<List<BitVec(8)>, Bool>(λ l => (loc.offset + n).leb(l.len()), rel.block(loc.block))
}

theorem MemoryRenamed::whole({r: Renaming}, {m, renamed: Memory}, self rel: MemoryRenamed(r, m, renamed), loc: Loc, n: Nat):
    renamed.whole(loc.rename(r), n) = m.whole(loc, n) {
    cong_fn<Bool, Bool>(λ v => !v, trans(cong_fn<List<Entry>, Bool>(λ sh => range_cut(sh, r.there(loc.block), loc.offset, n), rel.shadow),
        rename_range_cut(r, loc.block, loc.offset, n, m.heap.shadow)))
}

// A take of the renamed memory is the renamed take.
theorem Memory::take_renames(self m: Memory, r: Renaming, renamed: Memory, rel: MemoryRenamed(r, m, renamed), loc: Loc, n: Nat):
    renamed.take(loc.rename(r), n) = m.take(loc, n).map(λ (p: Piece) => p.rename(r)) {
    let window = λ (l: List<BitVec(8)>) => l.window(loc.offset, loc.offset + n);
    let piece: (Piece(window(renamed.heap.bytes(r.there(loc.block))), range_pointers(renamed.heap.shadow, r.there(loc.block), loc.offset, n),
                flags(renamed.undefined, r.there(loc.block), loc.offset, n)) =
            Piece(window(m.heap.bytes(loc.block)), rename_pointers(r, range_pointers(m.heap.shadow, loc.block, loc.offset, n)),
                flags(m.undefined, loc.block, loc.offset, n))) =
        rewrite(rel.block(loc.block), rel.shadow, rename_range_pointers(r, loc.block, loc.offset, n, m.heap.shadow), rel.flags_at(loc.block, n, loc.offset),
            refl);
    j(sym(Bool::and_cong(rel.fits(loc, n), rel.whole(loc, n))), λ v _ =>
            (match v { False => None, True => Some(renamed.piece_at(loc.rename(r), n)) }) = m.take(loc, n).map(λ (p: Piece) => p.rename(r)),
        (match m.fits(loc, n) && m.whole(loc, n) as λ v =>
            (match v { False => None, True => Some(renamed.piece_at(loc.rename(r), n)) }) =
                (match v { False => None, True => Some(m.piece_at(loc, n)) }).map(λ (p: Piece) => p.rename(r)) {
            False => refl,
            True => cong_fn<Piece, Option<Piece>>(λ p => Some(p), piece),
        }))
}

// Memory with a piece placed, renamed alike.
theorem MemoryRenamed::put_at({r: Renaming}, {m, renamed: Memory}, self rel: MemoryRenamed(r, m, renamed), loc: Loc, piece: Piece):
    MemoryRenamed(r, m.placed_at(loc, piece), renamed.placed_at(loc.rename(r), piece.rename(r))) {
    let b = loc.block;
    let k = loc.offset;
    let now = m.heap.bytes(b).put_window(k, piece.bytes);
    let n = piece.bytes.len();
    let shadow: (placed(rename_pointers(r, piece.pointers), r.there(b), k) ++ range_cleared(renamed.heap.shadow, r.there(b), k, n) =
            rename_shadow(r, placed(piece.pointers, b, k) ++ range_cleared(m.heap.shadow, b, k, n))) =
        rewrite(rel.shadow, rename_range_cleared(r, b, k, n, m.heap.shadow), rename_placed(r, b, k, piece.pointers),
            sym(rename_shadow_append(r, placed(piece.pointers, b, k), range_cleared(m.heap.shadow, b, k, n))));
    MemoryRenamed(
        bytes := λ c => trans(cong_fn<List<BitVec(8)>, List<BitVec(8)>>(λ l => set_block(renamed.heap.bytes, r.there(b), l.put_window(k, piece.bytes), c),
                rel.block(b)),
            rename_set_block(r, m.heap.bytes, renamed.heap.bytes, rel.bytes, b, now, c)),
        shadow := shadow,
        undefined := λ c i => {
            let rest = k.leb(i) && (i + 1).leb(k + n);
            let same: (in_window(r.there(b), k, n, c, i) = in_window(b, k, n, r.back(c), i)) = cong_fn<Bool, Bool>(λ v => v && rest,
                trans(cong_fn<Nat, Bool>(λ x => x.same(r.there(b)), sym(r.there_back(c))), r.there_same(r.back(c), b)));
            j(sym(same), λ v _ => (match v { True => flag(piece.undefined, i - k), False => renamed.undefined(c, i) }) =
                    (match in_window(b, k, n, r.back(c), i) { True => flag(piece.undefined, i - k), False => m.undefined(r.back(c), i) }),
                match in_window(b, k, n, r.back(c), i) as λ v =>
                    (match v { True => flag(piece.undefined, i - k), False => renamed.undefined(c, i) }) =
                        (match v { True => flag(piece.undefined, i - k), False => m.undefined(r.back(c), i) }) {
                    True => refl,
                    False => rel.undefined(c, i),
                })
        },
    )
}

// A put into the renamed memory is the renamed put.
theorem Memory::put_renames(self m: Memory, blocks: Blocks, r: Renaming, renamed: Memory, renamed_blocks: Blocks, rel: MemoryRenamed(r, m, renamed),
    blocks_renamed: BlocksRenamed(r, blocks, renamed_blocks), loc: Loc, piece: Piece):
    MemoryAlike(r, m.put(blocks, loc, piece), renamed.put(renamed_blocks, loc.rename(r), piece.rename(r))) {
    let n = piece.bytes.len();
    j(sym(Bool::and_cong(blocks_renamed.writes(loc.block), Bool::and_cong(rel.fits(loc, n), rel.whole(loc, n)))), λ v _ =>
            MemoryAlike(r, m.put(blocks, loc, piece), match v { False => None, True => Some(renamed.placed_at(loc.rename(r), piece.rename(r))) }),
        (match blocks.written(loc.block) && (m.fits(loc, n) && m.whole(loc, n)) as λ v =>
            MemoryAlike(r, match v { False => None, True => Some(m.placed_at(loc, piece)) },
                match v { False => None, True => Some(renamed.placed_at(loc.rename(r), piece.rename(r))) }) {
            False => trivial,
            True => rel.put_at(loc, piece),
        }))
}

// So each operation, renamed. A read of plain bytes reads the same bytes.
theorem Piece::rename_plain_bytes(self piece: Piece, r: Renaming): piece.rename(r).plain_bytes() = piece.plain_bytes() {
    match piece.pointers { Nil => refl, Cons(_, _) => refl }
}

theorem Memory::read_bytes_renames(self m: Memory, r: Renaming, renamed: Memory, rel: MemoryRenamed(r, m, renamed), loc: Loc, n: Nat):
    renamed.read_bytes(loc.rename(r), n) = m.read_bytes(loc, n) {
    j(sym(m.take_renames(r, renamed, rel, loc, n)), λ o _ => (match o { None => None, Some(piece) => piece.plain_bytes() }) = m.read_bytes(loc, n),
        match m.take(loc, n) as λ o =>
            (match o.map(λ (p: Piece) => p.rename(r)) as λ _ => Option<List<BitVec(8)>> { None => None, Some(piece) => piece.plain_bytes() }) =
                (match o { None => None, Some(piece) => piece.plain_bytes() }) {
            None => refl,
            Some(piece) => piece.rename_plain_bytes(r),
        })
}

// A load reads the same number.
theorem Memory::load_renames(self m: Memory, r: Renaming, renamed: Memory, rel: MemoryRenamed(r, m, renamed), loc: Loc, n: Nat):
    renamed.load(loc.rename(r), n) = m.load(loc, n) {
    j(sym(m.read_bytes_renames(r, renamed, rel, loc, n)), λ o _ => (match o { None => None, Some(bytes) => Some(little_endian(bytes, n)) }) = m.load(loc, n),
        refl)
}

theorem Piece::rename_referent(self piece: Piece, r: Renaming): piece.rename(r).referent() = piece.referent().map(λ (t: Loc) => t.rename(r)) {
    match piece.pointers {
        Nil => refl,
        Cons(p, rest) => match rest {
            Nil => match p.at {
                Zero => refl,
                Succ(_) => refl,
            },
            Cons(_, _) => refl,
        },
    }
}

// A load of a reference reads the renamed reference.
theorem Memory::load_ref_renames(self m: Memory, r: Renaming, renamed: Memory, rel: MemoryRenamed(r, m, renamed), loc: Loc):
    renamed.load_ref(loc.rename(r)) = m.load_ref(loc).map(λ (t: Loc) => t.rename(r)) {
    j(sym(m.take_renames(r, renamed, rel, loc, 8)), λ o _ =>
            (match o { None => None, Some(piece) => piece.referent() }) = m.load_ref(loc).map(λ (t: Loc) => t.rename(r)),
        (match m.take(loc, 8) as λ o =>
            (match o.map(λ (p: Piece) => p.rename(r)) as λ _ => Option<Loc> { None => None, Some(piece) => piece.referent() }) =
                (match o { None => None, Some(piece) => piece.referent() }).map(λ (t: Loc) => t.rename(r)) {
            None => refl,
            Some(piece) => piece.rename_referent(r),
        }))
}

theorem Memory::store_renames(self m: Memory, blocks: Blocks, r: Renaming, renamed: Memory, renamed_blocks: Blocks, rel: MemoryRenamed(r, m, renamed),
    blocks_renamed: BlocksRenamed(r, blocks, renamed_blocks), loc: Loc, bytes: List<BitVec(8)>):
    MemoryAlike(r, m.store(blocks, loc, bytes), renamed.store(renamed_blocks, loc.rename(r), bytes)) {
    m.put_renames(blocks, r, renamed, renamed_blocks, rel, blocks_renamed, loc, Piece::plain(bytes))
}

theorem Memory::store_ref_renames(self m: Memory, blocks: Blocks, r: Renaming, renamed: Memory, renamed_blocks: Blocks, rel: MemoryRenamed(r, m, renamed),
    blocks_renamed: BlocksRenamed(r, blocks, renamed_blocks), loc, target: Loc):
    MemoryAlike(r, m.store_ref(blocks, loc, target), renamed.store_ref(renamed_blocks, loc.rename(r), target.rename(r))) {
    m.put_renames(blocks, r, renamed, renamed_blocks, rel, blocks_renamed, loc, Piece::reference(target))
}

theorem Memory::copy_renames(self m: Memory, blocks: Blocks, r: Renaming, renamed: Memory, renamed_blocks: Blocks, rel: MemoryRenamed(r, m, renamed),
    blocks_renamed: BlocksRenamed(r, blocks, renamed_blocks), target, source: Loc, n: Nat):
    MemoryAlike(r, m.copy(blocks, target, source, n), renamed.copy(renamed_blocks, target.rename(r), source.rename(r), n)) {
    j(sym(m.take_renames(r, renamed, rel, source, n)), λ o _ =>
            MemoryAlike(r, m.copy(blocks, target, source, n), match o { None => None, Some(piece) => renamed.put(renamed_blocks, target.rename(r), piece) }),
        (match m.take(source, n) as λ o =>
            MemoryAlike(r, match o { None => None, Some(piece) => m.put(blocks, target, piece) },
                match o.map(λ (p: Piece) => p.rename(r)) { None => None, Some(piece) => renamed.put(renamed_blocks, target.rename(r), piece) }) {
            None => trivial,
            Some(piece) => m.put_renames(blocks, r, renamed, renamed_blocks, rel, blocks_renamed, target, piece),
        }))
}

// ---------------------------------------------------------------------------
// Canonical: a reference's eight bytes are zero, and an undefined byte is

// Eight zero bytes lie in `bytes` from `at`.
fn ZeroAt(bytes: List<BitVec(8)>, at: Nat) → Type { (at + 8 <= bytes.len()) ∧ (bytes.window(at, at + 8) = word_bytes(BitVec::zero())) }

fn EveryPointer(pointers: List<Pointer>, P: Pointer → Type) → Type {
    match pointers { Nil => True, Cons(p, rest) => P(p) ∧ EveryPointer(rest, P) }
}

// Each reference of a piece sits on eight zero bytes of it.
// and each undefined byte of it is zero.
fn Piece::Canonical(self piece: Piece) → Type {
    EveryPointer(piece.pointers, λ (p: Pointer) => ZeroAt(piece.bytes, p.at)) ∧
        ((i: Nat) → flag(piece.undefined, i) = True → byte_at(piece.bytes, i) = BitVec::zero())
}

// Each entry of the shadow sits on eight zero bytes of its block, so what
// a heap reads is its bytes and its entries: two heaps that read alike are
// `Memory::Same`.
// So is each undefined byte.
fn Memory::Canonical(self m: Memory) → Type {
    Every(m.heap.shadow, λ (e: Entry) => ZeroAt(m.heap.bytes(e.block), e.at)) ∧
        ((c, i: Nat) → m.undefined(c, i) = True → byte_at(m.heap.bytes(c), i) = BitVec::zero())
}

theorem Piece::plain_canonical(bytes: List<BitVec(8)>): Piece::plain(bytes).Canonical() { ⟨trivial, λ i never => absurd(never)⟩ }

theorem Piece::reference_canonical(target: Loc): Piece::reference(target).Canonical() { ⟨⟨⟨omega, refl⟩, trivial⟩, λ i never => absurd(never)⟩ }

theorem byte_at_zeros(n: Nat): (i: Nat) → byte_at(List::replicate(BitVec::zero(), n), i) = BitVec::zero() {
    match n { Zero => λ i => refl, Succ(more) => λ i => match i { Zero => refl, Succ(after) => byte_at_zeros(more, after) } }
}

theorem Piece::undefined_canonical(n: Nat): Piece::undefined(n).Canonical() { ⟨trivial, λ i _ => byte_at_zeros(n, i)⟩ }

// A flag of a window set: a byte inside it, undefined.
theorem flags_set(undefined: Nat → Nat → Bool, b, n: Nat): (k, i: Nat) → flag(flags(undefined, b, k, n), i) = True →
    (i < n) ∧ (undefined(b, k + i) = True) {
    match n {
        Zero => λ k i never => absurd(never),
        Succ(rest) => λ k i => match i {
            Zero => λ here => {
                let at: (k + 0 = k) = omega;
                ⟨omega, rewrite(at, here)⟩
            },
            Succ(after) => λ later => {
                let deeper = flags_set(undefined, b, rest, k + 1, after, later);
                let at: ((k + 1) + after = k + (after + 1)) = omega;
                ⟨omega(deeper.left), rewrite(sym(at), deeper.right)⟩
            },
        },
    }
}

// An undefined byte of a canonical memory, read through a window.
theorem flags_zero(bytes: List<BitVec(8)>, undefined: Nat → Nat → Bool, b, k, n: Nat, fits: k + n <= bytes.len(),
    zero: (i: Nat) → undefined(b, i) = True → byte_at(bytes, i) = BitVec::zero()):
    (i: Nat) → flag(flags(undefined, b, k, n), i) = True → byte_at(bytes.window(k, k + n), i) = BitVec::zero() {
    λ i set => {
        let inside = flags_set(undefined, b, n, k, i, set);
        let at: (k + i = i + k) = omega;
        let read: (bytes.window(k, k + n).nth(i) = bytes.nth(i + k)) = bytes.nth_window(k, k + n, i, omega(inside.left));
        j(sym(read), λ o _ => (match o { None => BitVec::zero(), Some(byte) => byte }) = BitVec::zero(),
            zero(i + k, rewrite(sym(at), inside.right)))
    }
}

theorem every_append(P: Entry → Type, xs, ys: List<Entry>): Every(xs, P) → Every(ys, P) → Every(xs ++ ys, P) {
    match xs { Nil => λ _ all => all, Cons(_, rest) => λ here all => ⟨here.left, every_append(P, rest, ys, here.right, all)⟩ }
}

// An entry inside a range sits on zero bytes of the window it is taken
// with.
theorem zero_in_window(bytes: List<BitVec(8)>, k, n, at: Nat, fits: k + n <= bytes.len(), low: k <= at, high: at + 8 <= k + n,
    zero: ZeroAt(bytes, at)): ZeroAt(bytes.window(k, k + n), at - k) {
    let shifted: ((at - k) + k = at) = omega;
    let ended: (((at - k) + 8) + k = at + 8) = omega;
    ⟨omega(bytes.len_window(k, k + n, omega, fits)),
     rewrite(bytes.window_window(k, k + n, at - k, (at - k) + 8, omega), shifted, ended, zero.right)⟩
}

theorem pointers_canonical(bytes: Nat → List<BitVec(8)>, b, k, n: Nat, fits: k + n <= bytes(b).len(), shadow: List<Entry>):
    Every(shadow, λ (e: Entry) => ZeroAt(bytes(e.block), e.at)) →
    EveryPointer(range_pointers(shadow, b, k, n), λ (p: Pointer) => ZeroAt(bytes(b).window(k, k + n), p.at)) {
    match shadow {
        Nil => λ _ => trivial,
        Cons(e, rest) => λ all => (match e.within_range(b, k, n) as λ v => e.within_range(b, k, n) = v →
                EveryPointer(match v { True => Cons(Pointer(e.at - k, e.target), range_pointers(rest, b, k, n)), False => range_pointers(rest, b, k, n) },
                    λ (p: Pointer) => ZeroAt(bytes(b).window(k, k + n), p.at)) {
            True => λ within => {
                let parts = Bool::and_true_parts(e.block.same(b), k.leb(e.at) && (e.at + 8).leb(k + n), within);
                let block: (e.block = b) = e.block.same_sound(b, parts.left);
                let zero: ZeroAt(bytes(b), e.at) = j(block, λ x _ => ZeroAt(bytes(x), e.at), all.left);
                ⟨zero_in_window(bytes(b), k, n, e.at, fits, omega(parts.right), omega(parts.right), zero),
                 pointers_canonical(bytes, b, k, n, fits, rest, all.right)⟩
            },
            False => λ _ => pointers_canonical(bytes, b, k, n, fits, rest, all.right),
        })(refl),
    }
}

// A take of a canonical memory is a canonical piece.
theorem Memory::take_canonical(self m: Memory, loc: Loc, n: Nat, piece: Piece, taken: m.take(loc, n) = Some(piece), canonical: m.Canonical()):
    piece.Canonical() {
    let facts = m.take_some(loc, n, piece, taken);
    let fits: (loc.offset + n <= m.heap.bytes(loc.block).len()) = omega(facts.left);
    j(facts.right.right, λ p _ => p.Canonical(),
        ⟨pointers_canonical(m.heap.bytes, loc.block, loc.offset, n, fits, m.heap.shadow, canonical.left),
         flags_zero(m.heap.bytes(loc.block), m.undefined, loc.block, loc.offset, n, fits, λ i h => canonical.right(loc.block, i, h))⟩)
}

// A piece's references, put at `k`, sit on its zero bytes there.
theorem placed_canonical(bytes: Nat → List<BitVec(8)>, b, k: Nat, piece: Piece, fits: piece.bytes.len() + k <= bytes(b).len(),
    pointers: List<Pointer>): EveryPointer(pointers, λ (p: Pointer) => ZeroAt(piece.bytes, p.at)) →
    Every(placed(pointers, b, k), λ (e: Entry) => ZeroAt(set_block(bytes, b, bytes(b).put_window(k, piece.bytes), e.block), e.at)) {
    match pointers {
        Nil => λ _ => trivial,
        Cons(p, rest) => λ all => {
            let now = bytes(b).put_window(k, piece.bytes);
            let start: ((k + p.at) = p.at + k) = omega;
            let ended: ((p.at + k) + 8 = (p.at + 8) + k) = omega;
            let window: (now.window(p.at + k, (p.at + 8) + k) = piece.bytes.window(p.at, p.at + 8)) =
                trans(sym(now.window_window(k, piece.bytes.len() + k, p.at, p.at + 8, omega(all.left.left))),
                    cong_fn<List<BitVec(8)>, List<BitVec(8)>>(λ w => w.window(p.at, p.at + 8), bytes(b).window_put_window(k, piece.bytes, omega(fits))));
            let zero: ZeroAt(now, k + p.at) = ⟨omega(all.left.left, bytes(b).len_put_window(k, piece.bytes, fits), fits),
                rewrite(start, ended, trans(window, all.left.right))⟩;
            ⟨j(sym(set_block_here(bytes, b, now)), λ l _ => ZeroAt(l, k + p.at), zero), placed_canonical(bytes, b, k, piece, fits, rest, all.right)⟩
        },
    }
}

// An entry a put leaves met none of its bytes, so it sits on what it sat
// on.
theorem kept_zero(bytes: Nat → List<BitVec(8)>, b, k: Nat, ys: List<BitVec(8)>, fits: ys.len() + k <= bytes(b).len(), e: Entry,
    apart: e.meets_range(b, k, ys.len()) = False, zero: ZeroAt(bytes(e.block), e.at)):
    ZeroAt(set_block(bytes, b, bytes(b).put_window(k, ys), e.block), e.at) {
    match e.block.eq_dec(b) {
        Inl(same) => {
            let block: (set_block(bytes, b, bytes(b).put_window(k, ys), e.block) = bytes(b).put_window(k, ys)) =
                j(sym(same), λ x _ => set_block(bytes, b, bytes(b).put_window(k, ys), x) = bytes(b).put_window(k, ys), set_block_here(bytes, b, bytes(b).put_window(k, ys)));
            let old: ZeroAt(bytes(b), e.at) = j(same, λ x _ => ZeroAt(bytes(x), e.at), zero);
            let outside: (((e.at + 1).leb(k + ys.len()) && (k + 1).leb(e.at + 8)) = False) =
                trans(sym(cong_fn<Bool, Bool>(λ v => v && ((e.at + 1).leb(k + ys.len()) && (k + 1).leb(e.at + 8)), e.block.same_of_eq(b, same))), apart);
            let window: (bytes(b).put_window(k, ys).window(e.at, e.at + 8) = bytes(b).window(e.at, e.at + 8)) =
                match (e.at + 8).leb(k) as λ v => (e.at + 8).leb(k) = v → bytes(b).put_window(k, ys).window(e.at, e.at + 8) = bytes(b).window(e.at, e.at + 8) {
                    True => λ before => bytes(b).window_put_window_before(k, ys, e.at, e.at + 8, omega(before), omega(fits)),
                    False => λ after => bytes(b).window_put_window_after(k, ys, e.at, e.at + 8, omega(after, outside), omega(fits)),
                }(refl);
            rewrite(block, ⟨omega(old.left, bytes(b).len_put_window(k, ys, fits)), trans(window, old.right)⟩)
        },
        Inr(differs) => rewrite(set_block_other(bytes, b, bytes(b).put_window(k, ys), e.block, differs), zero),
    }
}

theorem cleared_canonical(bytes: Nat → List<BitVec(8)>, b, k: Nat, ys: List<BitVec(8)>, fits: ys.len() + k <= bytes(b).len(), shadow: List<Entry>):
    Every(shadow, λ (e: Entry) => ZeroAt(bytes(e.block), e.at)) →
    Every(range_cleared(shadow, b, k, ys.len()), λ (e: Entry) => ZeroAt(set_block(bytes, b, bytes(b).put_window(k, ys), e.block), e.at)) {
    match shadow {
        Nil => λ _ => trivial,
        Cons(e, rest) => λ all => (match e.meets_range(b, k, ys.len()) as λ v => e.meets_range(b, k, ys.len()) = v →
                Every(match v { True => range_cleared(rest, b, k, ys.len()), False => Cons(e, range_cleared(rest, b, k, ys.len())) },
                    λ (d: Entry) => ZeroAt(set_block(bytes, b, bytes(b).put_window(k, ys), d.block), d.at)) {
            True => λ _ => cleared_canonical(bytes, b, k, ys, fits, rest, all.right),
            False => λ apart => ⟨kept_zero(bytes, b, k, ys, fits, e, apart, all.left), cleared_canonical(bytes, b, k, ys, fits, rest, all.right)⟩,
        })(refl),
    }
}

// An undefined byte after a put: one of the piece's, or one that was.
theorem placed_undefined_zero(m: Memory, loc: Loc, piece: Piece, fits: piece.bytes.len() + loc.offset <= m.heap.bytes(loc.block).len(),
    zero: (c, i: Nat) → m.undefined(c, i) = True → byte_at(m.heap.bytes(c), i) = BitVec::zero(),
    piece_zero: (i: Nat) → flag(piece.undefined, i) = True → byte_at(piece.bytes, i) = BitVec::zero(), c, i: Nat):
    m.placed_at(loc, piece).undefined(c, i) = True → byte_at(m.placed_at(loc, piece).heap.bytes(c), i) = BitVec::zero() {
    let b = loc.block;
    let k = loc.offset;
    let n = piece.bytes.len();
    let now = m.heap.bytes(b).put_window(k, piece.bytes);
    (match in_window(b, k, n, c, i) as λ v => in_window(b, k, n, c, i) = v →
            (match v { True => flag(piece.undefined, i - k), False => m.undefined(c, i) }) = True →
            byte_at(set_block(m.heap.bytes, b, now, c), i) = BitVec::zero() {
        True => λ inside set => {
            let parts = Bool::and_true_parts(c.same(b), k.leb(i) && (i + 1).leb(k + n), inside);
            let block: (c = b) = c.same_sound(b, parts.left);
            let here: (set_block(m.heap.bytes, b, now, c) = now) =
                j(sym(block), λ x _ => set_block(m.heap.bytes, b, now, x) = now, set_block_here(m.heap.bytes, b, now));
            let at: ((i - k) + k = i) = omega(parts.right);
            let read: (now.nth(i) = piece.bytes.nth(i - k)) = trans(cong_fn<Nat, Option<BitVec(8)>>(λ x => now.nth(x), sym(at)),
                m.heap.bytes(b).nth_put_window_inside(k, piece.bytes, i - k, omega(parts.right), omega(fits)));
            rewrite(here, j(sym(read), λ o _ => (match o { None => BitVec::zero(), Some(byte) => byte }) = BitVec::zero(), piece_zero(i - k, set)))
        },
        False => λ outside was => match c.eq_dec(b) {
            Inl(same) => {
                let here: (set_block(m.heap.bytes, b, now, c) = now) =
                    j(sym(same), λ x _ => set_block(m.heap.bytes, b, now, x) = now, set_block_here(m.heap.bytes, b, now));
                let range: ((k.leb(i) && (i + 1).leb(k + n)) = False) =
                    trans(sym(cong_fn<Bool, Bool>(λ v => v && (k.leb(i) && (i + 1).leb(k + n)), c.same_of_eq(b, same))), outside);
                let old: (byte_at(m.heap.bytes(c), i) = BitVec::zero()) = zero(c, i, was);
                let old_b: (byte_at(m.heap.bytes(b), i) = BitVec::zero()) = j(same, λ x _ => byte_at(m.heap.bytes(x), i) = BitVec::zero(), old);
                let read: (now.nth(i) = m.heap.bytes(b).nth(i)) = match (i + 1).leb(k) as λ v => (i + 1).leb(k) = v → now.nth(i) = m.heap.bytes(b).nth(i) {
                    True => λ before => m.heap.bytes(b).nth_put_window_before(k, piece.bytes, i, omega(before), omega(fits)),
                    False => λ after => {
                        let at: ((i - (n + k)) + (n + k) = i) = omega(after, range);
                        trans(cong_fn<Nat, Option<BitVec(8)>>(λ x => now.nth(x), sym(at)),
                            trans(m.heap.bytes(b).nth_put_window_after(k, piece.bytes, i - (n + k), omega(fits)),
                                cong_fn<Nat, Option<BitVec(8)>>(λ x => m.heap.bytes(b).nth(x), at)))
                    },
                }(refl);
                rewrite(here, j(sym(read), λ o _ => (match o { None => BitVec::zero(), Some(byte) => byte }) = BitVec::zero(), old_b))
            },
            Inr(differs) => rewrite(set_block_other(m.heap.bytes, b, now, c, differs), zero(c, i, was)),
        },
    })(refl)
}

// A put of a canonical piece into a canonical memory leaves it canonical.
theorem Memory::put_canonical(self m: Memory, blocks: Blocks, loc: Loc, piece: Piece, after: Memory, put: m.put(blocks, loc, piece) = Some(after),
    canonical: m.Canonical(), piece_canonical: piece.Canonical()): after.Canonical() {
    let facts = m.put_some(blocks, loc, piece, after, put);
    let fits: (piece.bytes.len() + loc.offset <= m.heap.bytes(loc.block).len()) = omega(facts.right.left);
    j(facts.right.right.right, λ a _ => a.Canonical(),
        ⟨every_append(λ (e: Entry) => ZeroAt(set_block(m.heap.bytes, loc.block, m.heap.bytes(loc.block).put_window(loc.offset, piece.bytes), e.block), e.at),
            placed(piece.pointers, loc.block, loc.offset), range_cleared(m.heap.shadow, loc.block, loc.offset, piece.bytes.len()),
            placed_canonical(m.heap.bytes, loc.block, loc.offset, piece, fits, piece.pointers, piece_canonical.left),
            cleared_canonical(m.heap.bytes, loc.block, loc.offset, piece.bytes, fits, m.heap.shadow, canonical.left)),
         λ c i => placed_undefined_zero(m, loc, piece, fits, canonical.right, piece_canonical.right, c, i)⟩)
}

// So every store keeps a heap canonical, a copy among them: what it puts
// is a take's piece.
theorem Memory::copy_canonical(self m: Memory, blocks: Blocks, target, source: Loc, n: Nat, after: Memory,
    copied: m.copy(blocks, target, source, n) = Some(after), canonical: m.Canonical()): after.Canonical() {
    let facts = m.copy_some(blocks, target, source, n, after, copied);
    m.put_canonical(blocks, target, m.piece_at(source, n), after, facts.right, canonical,
        m.take_canonical(source, n, m.piece_at(source, n), facts.left, canonical))
}

theorem Memory::store_canonical(self m: Memory, blocks: Blocks, loc: Loc, bytes: List<BitVec(8)>, after: Memory,
    stored: m.store(blocks, loc, bytes) = Some(after), canonical: m.Canonical()): after.Canonical() {
    m.put_canonical(blocks, loc, Piece::plain(bytes), after, stored, canonical, Piece::plain_canonical(bytes))
}

theorem Memory::store_ref_canonical(self m: Memory, blocks: Blocks, loc, target: Loc, after: Memory,
    stored: m.store_ref(blocks, loc, target) = Some(after), canonical: m.Canonical()): after.Canonical() {
    m.put_canonical(blocks, loc, Piece::reference(target), after, stored, canonical, Piece::reference_canonical(target))
}

// cat compiled, end to end (issues/native-effect-source-compiler.md, round
// S3.2): `cat(1024)` compiled by `Source::compile` with its region at the
// I/O image's page, its code loaded past a 232-byte header, simulates cat's
// source (`native_compile_correct`), and so every run of the machine Linux
// can give it that exits 0 sends to stdout exactly what it read from stdin
// (`cat_sends`, from `cat_implements`). Only the compile, its layout and
// the code's length are evaluated; nothing about the run is.
import native_cat;
import native_cat_spec;
import native_source;
import native_compile;
import native_compile_region;
import native_compile_steps;
import native_compile_correct;
import function_ir_lower;
import stream_filter_spec;
import linux_calls;
import linux_trees;
import linux_x86_64_io;
import linux_x86_64_byte_memory;
import linux_x86_64_determinism;
import linux_x86_64_image;
import linux_x86_64_sim;
import itree;
import itree_trace;
import x86_64;
import x86_64_asm;
import x86_64_asm_runs;
import x86_64_byte_memory;
import x86_64_fetch;
import x86_64_fetched_code;
import bitvec;
import bool;
import list;
import logic;
import nat;
import option;

// cat's buffer, its environment and the scratch range all fit the page.
fn cat_capacity() → Nat { 1024 }

// The compile succeeds: evaluated once, as a `Bool`.
theorem cat_compiled(): cat(cat_capacity()).compile(DataRegion::io_page().low).is_some() = True { refl }
theorem cat_present(): cat(cat_capacity()).compile(DataRegion::io_page().low).is_some().IsTrue() {
    j(sym(cat_compiled()), λ b _ => b.IsTrue(), trivial)
}

fn cat_code() → Prog { cat(cat_capacity()).compile(DataRegion::io_page().low).get(cat_present()) }

theorem cat_compiles(): cat(cat_capacity()).compile(DataRegion::io_page().low) = Some(cat_code()) {
    cat(cat_capacity()).compile(DataRegion::io_page().low).some_get(cat_present())
}

theorem cat_fits(): Layout(DataRegion::io_page().low, cat(cat_capacity()).buffers).size() <= DataRegion::io_page().size {
    Nat::leb_sound(Layout(DataRegion::io_page().low, cat(cat_capacity()).buffers).size(), DataRegion::io_page().size, trivial)
}

// The bytes the program assembles to.
fn cat_bytes() → List<BitVec(8)> { assemble(no_fills(), cat_code(), Nil) }

theorem cat_short(): (232 + prog_len(cat_code())).leb(65536) = True { refl }

theorem cat_bytes_fit(): 232 + cat_bytes().len() <= 65536 {
    let long = asm_len_is(no_fills(), asm_labels(cat_code()), cat_code(), cat_code().laid_out_fits(cat(cat_capacity()).compile_laid(DataRegion::io_page().low, cat_code(), cat_compiles())),
        Nil, 0, refl);
    j(sym(long), λ n _ => 232 + n <= 65536, Nat::leb_sound(232 + prog_len(cat_code()), 65536, j(sym(cat_short()), λ b _ => b.IsTrue(), trivial)))
}

// The process Linux makes of a 232-byte header and cat's bytes, at its
// entry, simulates cat.
theorem cat_native_simulates(header: List<BitVec(8)>, long: header.len() = 232, s: MachineState<X86Memory(X86Profile::io())>,
    entry: s.rip = io_entry(), loaded: s.memory = X86Memory::io_load(header ++ cat_bytes())):
    SimProgram(X86Profile::io().linux(), cat(cat_capacity()).denote(), s) {
    let r = DataRegion::io_page();
    let start: (io_entry() = next_rip(io_entry(), 0)) = BitVec::eq_of_eq_bit(64, io_entry(), next_rip(io_entry(), 0), refl);
    let resident = j(start, λ y _ => CodeResident(X86Profile::io().fetch(), X86Memory::io_load(header ++ cat_bytes()), cat_bytes(), y),
        X86Memory::io_load_entry(header, cat_bytes(), long, cat_bytes_fit()));
    let at_s = j(sym(loaded), λ m _ => r.profile.linux().site(cat_code(), io_entry()).Resident(m), resident);
    let zero = j(sym(loaded), λ m _ => r.Holds(λ _ => zero_byte(), m), X86Memory::io_load_page(header ++ cat_bytes()));
    native_compile_correct(cat(cat_capacity()), r, cat_fits(), cat_code(), cat_compiles(), io_entry(), s,
        trans(entry, start), at_s, zero)
}

// So every run of that process that Linux can give cat's answers, along a
// trace cat produces that exits 0, sends to stdout what it read from stdin.
theorem cat_native_sends(header: List<BitVec(8)>, long: header.len() = 232, s: MachineState<X86Memory(X86Profile::io())>,
    entry: s.rip = io_entry(), loaded: s.memory = X86Memory::io_load(header ++ cat_bytes()),
    tr: Trace<BitVec(64)>(Events::linux()), produces: Program::Produces(Events::linux(), cat(cat_capacity()).denote(), tr),
    valid: Trace::LinuxValid(tr), returns: Trace::ReturnsWith(Events::linux(), tr, filter_ok()),
    run: List<LinuxEvent>, ran: LinuxRun(X86Profile::io().linux(), run, s), responses: SameResponses(Trace::linux_events(tr), run)):
    sent_to(BitVec::ofNat(1), run) = Trace::received<Nat, BitVec(64)>(BitVec::ofNat(0), tr) {
    let io = X86Profile::io().linux();
    let program = cat(cat_capacity()).denote();
    trans(sim_run_sends(io, program.at(produces.n), s, cat_native_simulates(header, long, s, entry, loaded, produces.n), tr, produces.h, valid,
            Trace::returns_of_with(Events::linux(), tr, filter_ok(), returns), run, ran, responses, BitVec::ofNat(1)),
        cat_sends(cat_capacity(), Nat::leb_sound(1, cat_capacity(), trivial), Nat::leb_sound(Succ(cat_capacity()), Nat::pow(2, 63), trivial),
            tr, produces, valid, returns))
}
